# Server
PORT=5002
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/leave-management

# OIDC Configuration
IDP_ISSUER_URL=http://localhost:4000
OIDC_CLIENT_ID=leave-management
OIDC_CLIENT_SECRET=leave-management-secret
OIDC_REDIRECT_URI=http://localhost:5002/api/auth/oidc/callback

# Session
SESSION_SECRET=your-session-secret-change-in-production

# Hub Integration
HUB_TOKEN_SECRET=hub-token-secret-from-idp

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5003

# Leave Management URL (for audience validation)
LEAVE_MANAGEMENT_URL=http://localhost:5002

# Payroll -> Leave approved-unpaid-leave verification (HMAC v2)
# Generate once (for example: openssl rand -hex 32), store it in the secret
# manager, and configure the identical value in payroll/backend. Never reuse an
# OIDC, session, webhook, or generic internal API secret here.
PAYROLL_LEAVE_SHARED_SECRET=
PAYROLL_LEAVE_SERVICE_ID=payroll

# Webhook Secret (must match IDP_WEBHOOK_SECRET in Identity Provider)
IDP_WEBHOOK_SECRET=development-only-change-me-webhook-key-1234567890

# Authenticated organization roster lookup (must match the Identity Provider)
IDP_INTERNAL_API_URL=http://localhost:4000
LEAVE_IDP_SERVICE_SECRET=replace-with-idp-internal-service-secret
IDP_RECONCILIATION_TIMEOUT_MS=30000

# Durable leave integration deliveries
TIME_ATTENDANCE_LEAVE_WEBHOOK_URL=http://localhost:5010/api/webhooks/leave
LEAVE_WEBHOOK_SECRET=replace-with-time-attendance-shared-secret
PERFORMANCE_MANAGEMENT_WEBHOOK_URL=http://localhost:5004/api/webhooks/suite
# Must match PERFORMANCE_MANAGEMENT_WEBHOOK_SECRET (or INTERNAL_SERVICE_SECRET)
# in the Performance Management backend. Production fails closed when absent.
PERFORMANCE_MANAGEMENT_WEBHOOK_SECRET=replace-with-performance-shared-secret

# Email/Brevo Configuration
MAIL_API_BASE_URL=http://127.0.0.1:5020
MAIL_API_TOKEN=
MAIL_FROM_EMAIL=no-reply@seemplifyai.com
MAIL_FROM_NAME=Seemplify Leave Management
