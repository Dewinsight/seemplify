// digilog-recruiter — PostgreSQL schema (migration from MongoDB/Mongoose).
//
// Conventions (see plan §2):
//   - PKs are Mongo ObjectId 24-hex strings: `id String @id @db.Char(24)`.
//     New ids are generated in JS (db/objectId.js) and injected by db/client.js.
//   - Mongoose `ref` ObjectId -> scalar `xId @db.Char(24)` + relation.
//   - "Dynamic enums" and other open sets stay `String`; flexible blobs stay `Json`.
//
// This file is built up slice-by-slice. Slice 1 covers the foundation models
// (User, Organization, OrganizationMember, Department, Admin). Later slices
// normalize subscription/credits, candidates, jobs, interviews, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @db.Char(24)
  email    String  @unique
  password String?

  // Nested Mongoose objects kept as JSONB for now (normalized later as needed).
  profile           Json?
  company           Json?
  preferences       Json?
  profileCompletion Json?
  features          Json?
  security          Json?
  subscription      Json?
  emailCapabilities Json?

  role        String? // top-level role enum kept as String
  permissions String[]
  isActive    Boolean  @default(true)

  lastLoginAt DateTime?
  loginCount  Int       @default(0)

  // Auth / security
  twoFactorEnabled     Boolean?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  lastPasswordChange   DateTime?

  // Org context / onboarding
  hasCompletedOrganizationSetup Boolean?
  defaultOrganizationId         String? @db.Char(24)
  legacyOrganizations           Json? // old embedded `organizations` array

  // Calendar / Nylas
  calendarConnected      Boolean?
  calendarConnectedEmail String?
  calendarEmail          String?
  calendarProvider       String?
  nylasAccountId         String?   @db.Char(24)
  nylasGrantId           String?
  nylasGrantStatus       String?
  grantConnectedAt       DateTime?
  lastGrantRefresh       DateTime?
  lastGrantRevocation    DateTime?

  // IdP / SSO
  idpAccessToken     String?
  idpTokenExpiry     DateTime?
  idpTeams           Json?
  idpTeamPermissions Json?

  // Current organization (multi-tenant context)
  currentOrganizationId String?       @db.Char(24)
  currentOrganization   Organization? @relation("UserCurrentOrg", fields: [currentOrganizationId], references: [id])

  // Reverse relations
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[]
  createdDepartments Department[]         @relation("DeptCreatedBy")
  userSessions       UserSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentOrganizationId])
  @@index([role])
  @@index([isActive])
  @@index([resetPasswordToken])
  @@index([nylasGrantId])
}

model Organization {
  id          String  @id @db.Char(24)
  name        String  @db.VarChar(100)
  description String?
  industry    String?
  size        String?
  website     String?
  logo        String?

  // Sparse-unique in Mongo -> nullable here; partial unique index added later (plan §5).
  idpOrganizationId String?

  // Kept whole for slice 1; normalized into columns + child tables in slice 3.
  settings     Json?
  subscription Json?
  legacyUsers  Json? // old embedded `users` array (members are in OrganizationMember)

  // Nullable for ETL robustness (owner may point at a since-deleted user).
  ownerId String? @db.Char(24)
  owner   User?   @relation("OrgOwner", fields: [ownerId], references: [id])

  members        OrganizationMember[]
  departments    Department[]
  currentForUsers User[]              @relation("UserCurrentOrg")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([isActive])
}

// Collapses Mongo's dual membership model (Organization.members[] AND
// User.organizationMemberships[]) into a single source of truth.
model OrganizationMember {
  id String @id @db.Char(24)

  organizationId String       @db.Char(24)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @db.Char(24)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        String  @default("member")
  status      String  @default("active")
  invitedById String? @db.Char(24) // soft ref (no FK)

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

model Department {
  id          String  @id @db.Char(24)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true)

  organizationId String       @db.Char(24)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Nullable for ETL robustness (creator may point at a since-deleted user).
  createdById String? @db.Char(24)
  createdBy   User?   @relation("DeptCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Admin {
  id          String  @id @db.Char(24)
  email       String  @unique
  password    String?
  name        String
  role        String  @default("admin")
  permissions Json?
  authSource  String  @default("local")

  // Sparse-unique in Mongo -> nullable; partial unique index added later.
  idpAccountId String?

  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  lastSsoLoginAt DateTime?
  lastIdpSyncAt DateTime?
  loginAttempts Int       @default(0)
  lockUntil     DateTime?

  resetPasswordOTP        String?
  resetPasswordOTPExpires DateTime?
  resetPasswordAttempts   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// JWT access/refresh session (the real auth session mechanism). The HTTP-tracking
// `Session` model is effectively dead code (its middleware no-ops), so it is not
// modeled until/if revived. `expiresAt` TTL becomes a scheduled cleanup (plan §5).
model UserSession {
  id String @id @db.Char(24)

  userId String @db.Char(24)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fingerprint      String
  userAgent        String?
  ip               String?
  refreshTokenHash String
  accessTokenId    String
  expiresAt        DateTime
  revoked          Boolean   @default(false)
  revokedAt        DateTime?
  reason           String?
  riskSignals      String[]  @default([])
  createdAt        DateTime  @default(now())
  lastActivityAt   DateTime?

  @@index([userId, revoked])
  @@index([accessTokenId])
  @@index([fingerprint])
  @@index([expiresAt])
}

// Tracks which idempotent startup seeders have run, so a fresh production deploy
// self-bootstraps (migrations + seeds) with no manual steps and never re-seeds.
model SeedHistory {
  id        String   @id @db.Char(24)
  name      String   @unique
  appliedAt DateTime @default(now())
}


