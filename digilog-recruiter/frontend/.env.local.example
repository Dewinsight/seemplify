# Copy this file to .env.local and update the values

# NEXT_PUBLIC_API_BASE_URL=https://api.seemplifyai.com
# NEXT_PUBLIC_WS_BASE_URL=wss://api.seemplifyai.com

NEXT_PUBLIC_API_BASE_URL=http://localhost:5001
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:5001

# Theme Control Settings
NEXT_PUBLIC_THEME_LIGHT_ENABLED=true
NEXT_PUBLIC_THEME_DARK_ENABLED=false
NEXT_PUBLIC_THEME_SYSTEM_ENABLED=false
NEXT_PUBLIC_DEFAULT_THEME=light

# OIDC Login Configuration
# Note: OIDC settings are now managed in frontend/config/oidc.config.ts
# This provides better type safety and easier configuration management
# Identity Provider UI base URL (for managing orgs/invitations/teams)
NEXT_PUBLIC_IDP_URL=http://localhost:4000

# Hostinger production IdP URL
# NEXT_PUBLIC_IDP_URL=https://auth.seemplifyai.com

