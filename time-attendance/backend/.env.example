# Backend Environment Variables
PORT=5010
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/seemplify-time-attendance

# Session
SESSION_SECRET=your-session-secret-here

# OIDC Configuration (Identity Provider)
IDP_ISSUER_URL=http://localhost:4000
OIDC_CLIENT_ID=time-attendance
OIDC_CLIENT_SECRET=your-oidc-secret-here
OIDC_REDIRECT_URI=http://localhost:5011/api/auth/callback

# Frontend URL
FRONTEND_URL=http://localhost:5011

# Outbound transactional email — self-hosted Seemplify mail service.
# This is the only supported transport; the previous Brevo API and SMTP relay
# settings were removed. 127.0.0.1:5020 is the local development address only;
# deployed environments must set this explicitly. Missing URL, token or sender
# fails closed.
MAIL_API_BASE_URL=http://127.0.0.1:5020
# Format: <keyId>.<secret>. Inject from the secret store; never commit a value.
MAIL_API_TOKEN=
# Preferred for local/deployed secret mounts. MAIL_API_TOKEN wins when both exist.
MAIL_API_TOKEN_FILE=
MAIL_FROM_EMAIL=no-reply@seemplifyai.com
MAIL_FROM_NAME=seemplifyai
MAIL_TIMEOUT_MS=15000

# Auto Clock-Out (optional, defaults to policy setting)
DEFAULT_AUTO_CLOCKOUT_HOURS=10
DEFAULT_AUTO_CLOCKOUT_WARNING_MINUTES=30

# Manager Team Reports
# Frequency and schedule are configured per organization policy:
# notifications.managerReports = { enabled, frequency: daily|weekly|monthly, sendHourUtc, includeExcel }
