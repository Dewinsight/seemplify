# Environment template for the Dokploy production mail stack.
#
# Every value below is entered in the Dokploy compose application's protected
# environment configuration, NOT in this repository. This file exists so an
# operator can see the full required set and the safe defaults; it contains no
# real value and must never be filled in and committed.
#
# Validate before deploying, from the Dokploy host:
#   node platform/email/scripts/validate-compose-config.mjs --env <file>
# The validator reports variable names and problems, never values.

# ---------------------------------------------------------------- cutover gates
# Exactly 0 or 1. All three stay 0 until the local Windows stack is frozen, so
# no message can be sent twice and no second tunnel connector can answer for
# mail-control.seemplifyai.com. Flip to 1 only at cutover, in this order:
# Postal worker, Mail API, tunnel.
MAIL_API_REPLICAS=0
POSTAL_WORKER_REPLICAS=0
MAIL_TUNNEL_REPLICAS=0

# ------------------------------------------------------------------- database
MARIADB_DATABASE=postal
MARIADB_USER=postal
# Reuse the exact values the local stack uses. The migrated dump carries grants
# that refer to this user, and Postal's restored postal.yml carries this password.
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# ------------------------------------------------------------------ Mail API
MAIL_API_RELEASE=dokploy
MAIL_API_DOMAIN=seemplifyai.com
MAIL_API_BOUNCE_DOMAIN=bounce.seemplifyai.com
# Fail closed. Opening production sending is a separate, deliberate act that
# happens after the acceptance tests pass.
MAIL_API_SEND_ENABLED=false
# keyId:sha256hex:scope|scope, comma separated. Only the SHA-256 hash of each
# secret is ever stored, so this value cannot be turned back into a bearer
# token. Copy it verbatim from the local stack so existing application bearers
# keep working across the cutover.
MAIL_API_KEYS=
# Copy verbatim from the local stack. A different salt orphans every existing
# suppression record.
MAIL_API_ADDRESS_HASH_SALT=
MAIL_API_POSTAL_API_KEY=
MAIL_API_POSTAL_WEBHOOK_TOKEN=
MAIL_API_WEBHOOK_HMAC_SECRET=
# One hop: the cloudflared connector is the only proxy in front of the API.
MAIL_API_TRUSTED_PROXY_HOPS=1

# --------------------------------------------------------------- Google relay
RELAY_UPSTREAM_HOST=smtp.gmail.com
RELAY_UPSTREAM_PORT=587
RELAY_SMTP_USERNAME=michael.egbo@dewinsight.com
RELAY_SENDER_DOMAIN=dewinsight.com
# The Docker subnet of the relay-internal network on the Dokploy host. Read it
# with: docker network inspect seemplify-mail-prod_relay-internal
RELAY_ALLOWED_NETWORKS=
# The 16-letter Google Workspace app password, and the single most sensitive
# value in this file. It belongs only in Dokploy's protected environment
# configuration. The relay entrypoint writes it to a mode-0600 file on a tmpfs
# and unsets the variable before Postfix starts, so it is never in the Postfix
# process environment and never on a disk.
RELAY_SMTP_PASSWORD=

# ----------------------------------------------------------- Cloudflare tunnel
# Pin an exact cloudflared version or digest. A floating tag is rejected by the
# validator: an unattended image change is an unattended ingress change.
MAIL_TUNNEL_IMAGE=cloudflare/cloudflared:2026.7.2
# Required only once MAIL_TUNNEL_REPLICAS is 1. Create a second, separate
# tunnel for staging rather than reusing the connector the local stack runs.
MAIL_TUNNEL_TOKEN=
MAIL_TUNNEL_TRANSPORT=auto

# ------------------------------------------------- encrypted backups (opt-in)
# Nothing below is read unless the backup profile is run, and running it is what
# starts billable object storage. Leave empty until you intend to enable it.
#
# BACKUP_AGE_RECIPIENT is an age *public* key. The matching private key is held
# offline and never reaches this host, so a compromise of the Dokploy server
# cannot decrypt a single backup it wrote.
BACKUP_AGE_RECIPIENT=
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_PREFIX=seemplify-mail
BACKUP_RETENTION_DAYS=14
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
