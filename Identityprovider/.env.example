# Copy this file to .env and update the values

# MongoDB Connection (Required)
MONGO_URI=your_mongodb_connection_string_here

# Identity Provider Configuration (Required)
ISSUER_URL=http://localhost:4000
PORT=4000

# OIDC Cookie Secret (Required for session security)
OIDC_COOKIE_SECRET=dev-cookie-secret

# Clients Configuration File (Optional - defaults to ./clients.json)
# CLIENTS_CONFIG=./clients.json

# Email Configuration (Required for signup emails and password reset)
MAIL_API_BASE_URL=http://127.0.0.1:5020
MAIL_API_TOKEN=
MAIL_FROM_EMAIL=no-reply@seemplifyai.com
MAIL_FROM_NAME=Seemplify Identity

# Hub App URLs (Optional - defaults to localhost)
# For local development:
SMARTHR_URL=http://localhost:5000
SMARTHR_LOGIN_URL=http://localhost:5000/login
SMARTHR_API_URL=http://localhost:5001

# Workspace and Community share the same application deployment, but use
# separate OIDC clients and entry paths so the selected experience is explicit.
MESSAGING_URL=http://localhost:4200
MESSAGING_API_URL=http://localhost:3333
MESSAGING_OIDC_CLIENT_SECRET=replace_with_workspace_oidc_client_secret
MESSAGING_IDP_SERVICE_SECRET=replace_with_a_rotated_secret_of_at_least_32_characters
COMMUNITY_URL=http://localhost:4200
COMMUNITY_API_URL=http://localhost:3333
COMMUNITY_OIDC_CLIENT_SECRET=replace_with_community_oidc_client_secret
# Production only: leave false until Community DNS, frontend, API routes, and
# the protected client secret are all ready. Local development ignores it.
COMMUNITY_PRODUCTION_ENABLED=false

# Leave Management App
LEAVE_MANAGEMENT_URL=http://localhost:5003
LEAVE_MANAGEMENT_API_URL=http://localhost:5002

# Performance Management App
PERFORMANCE_MANAGEMENT_URL=http://localhost:5005
PERFORMANCE_MANAGEMENT_API_URL=http://localhost:5004

# Payroll Management App
PAYROLL_MANAGEMENT_URL=http://localhost:5007
PAYROLL_MANAGEMENT_API_URL=http://localhost:5006

# Hostinger production URLs:
# SMARTHR_URL=https://app.seemplifyai.com
# SMARTHR_LOGIN_URL=https://app.seemplifyai.com/login
# SMARTHR_API_URL=https://api.seemplifyai.com
# MESSAGING_URL=https://workspace.seemplifyai.com
# MESSAGING_API_URL=https://api-workspace.seemplifyai.com
# COMMUNITY_URL=https://community.seemplifyai.com
# COMMUNITY_API_URL=https://api-workspace.seemplifyai.com
# COMMUNITY_PRODUCTION_ENABLED=true
# RECRUITER_ADMIN_URL=https://app.seemplifyai.com
# LEAVE_MANAGEMENT_URL=https://leave.seemplifyai.com
# LEAVE_MANAGEMENT_API_URL=https://api-leave.seemplifyai.com
# PERFORMANCE_MANAGEMENT_URL=https://performance.seemplifyai.com
# PERFORMANCE_MANAGEMENT_API_URL=https://api-performance.seemplifyai.com
# PAYROLL_MANAGEMENT_URL=https://payroll.seemplifyai.com
# PAYROLL_MANAGEMENT_API_URL=https://api-payroll.seemplifyai.com

# Core
CLIENTS_CONFIG=./clients.json

# API audience for external calls (e.g., SmartHR creating orgs via API token)
API_AUDIENCE=http://localhost:4000

# Hostinger production API audience
# API_AUDIENCE=https://auth.seemplifyai.com

BREVO_FROM_EMAIL=your_sender_email@example.com
BREVO_FROM_NAME=AIIN Identity

# Webhook Configuration (for real-time membership change notifications)
IDP_WEBHOOK_SECRET=development-only-change-me-webhook-key-1234567890
# Production sets four independently derived target keys. Do not reuse one
# receiver's key for another receiver.
IDP_WEBHOOK_SECRET_RECRUITER=
IDP_WEBHOOK_SECRET_LEAVE_MANAGEMENT=
IDP_WEBHOOK_SECRET_PAYROLL=
IDP_WEBHOOK_SECRET_PERFORMANCE_MANAGEMENT=
SMARTHR_WEBHOOK_URL=http://localhost:3001/api/webhooks/idp
LEAVE_WEBHOOK_URL=http://localhost:5002/api/webhooks/idp
PAYROLL_WEBHOOK_URL=http://localhost:5006/api/webhooks/idp
PERFORMANCE_WEBHOOK_URL=http://localhost:5004/api/webhooks/idp
TIME_ATTENDANCE_WEBHOOK_URL=http://localhost:5010/api/webhooks/idp

# Production webhook URLs:
# SMARTHR_WEBHOOK_URL=https://api.seemplifyai.com/api/webhooks/idp
# LEAVE_WEBHOOK_URL=https://api-leave.seemplifyai.com/api/webhooks/idp
# PAYROLL_WEBHOOK_URL=https://api-payroll.seemplifyai.com/api/webhooks/idp
# PERFORMANCE_WEBHOOK_URL=https://api-performance.seemplifyai.com/api/webhooks/idp

# Recruiter Admin SSO Bridge
RECRUITER_ADMIN_URL=http://localhost:5000
RECRUITER_ADMIN_SSO_SECRET=replace_with_shared_secret_used_by_recruiter_backend
RECRUITER_ADMIN_SSO_ISSUER=aiin-idp-admin
RECRUITER_ADMIN_SSO_AUDIENCE=recruiter-admin
RECRUITER_ADMIN_SSO_TTL_SECONDS=60

# Cloudinary (Onboarding uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Read-only signed access to shared AI usage analytics in Recruiter backend.
SHARED_AI_ADMIN_BASE_URL=http://localhost:5001
AI_GATEWAY_ADMIN_ANALYTICS_SECRET=replace-with-at-least-32-random-characters

# IdP-owned platform integration credentials. Production mounts file-backed
# values as root-readable files; never place real values in source control.
IDP_PLATFORM_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/seemplify/platform-integration-credential-key
IDP_PLATFORM_INTEGRATION_HMAC_SECRET_FILE=/run/seemplify/platform-integration-experience-hmac
# Optional future pairwise input override. When empty, both services derive the
# protocol key from the existing messaging OIDC client secret.
IDP_WORKSPACE_PLATFORM_INTEGRATION_HMAC_SECRET_FILE=
IDP_WORKSPACE_PLATFORM_INTEGRATION_HMAC_DERIVATION_VERSION=v1

# Optional one-time bootstrap inputs. Identity imports these into encrypted admin configuration
# only when no corresponding record exists; admin-managed values are never overwritten.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TTS_ENDPOINT=
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_VOICE=en-US-AvaNeural

# DocuSign (E-sign)
