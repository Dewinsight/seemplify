<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Teams - <%= organization.name %> - AIIN Identity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
</head>

<body>
  <!-- Top Navigation -->
  <nav class="top-nav">
    <a href="https://seemplifyai.com" class="top-nav-brand">
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <linearGradient id="seemplifyNavGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#3b82f6" />
            <stop offset="50%" stop-color="#8b5cf6" />
            <stop offset="100%" stop-color="#ec4899" />
          </linearGradient>
        </defs>
        <path d="M 65 25 Q 75 25 75 35 Q 75 45 65 45 Q 50 50 35 55 Q 25 55 25 65 Q 25 75 35 75"
          stroke="url(#seemplifyNavGradient)" stroke-width="8" fill="none" stroke-linecap="round"
          stroke-linejoin="round" />
        <circle cx="65" cy="25" r="6" class="logo-dot" />
        <circle cx="50" cy="50" r="6" class="logo-dot" />
        <circle cx="35" cy="75" r="6" class="logo-dot" />
      </svg>
      <span>Seemplify</span>
    </a>
    <div class="top-nav-links">
      <a href="/" class="top-nav-link">Home</a>
      <a href="/organizations" class="top-nav-link active">Organizations</a>
      <a href="/invitations/pending" class="top-nav-link">My Invitations</a>
      <a href="/profile" class="top-nav-link">Profile</a>
      <a href="/logout" class="top-nav-link">Logout</a>
    </div>
    <div class="top-nav-user">
      <div class="theme-dropdown">
        <button onclick="window.ThemeManager.toggleDropdown(event)" class="theme-toggle" aria-label="Toggle theme">
          <svg class="theme-toggle-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5" />
            <path
              d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
          </svg>
          <svg class="theme-toggle-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            style="display:none;">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
        <div class="theme-menu" id="theme-menu">
          <button class="theme-option" data-value="light" onclick="window.ThemeManager.setTheme('light')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round">
              <circle cx="12" cy="12" r="5" />
              <path
                d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
            </svg>
            Light
          </button>
          <button class="theme-option" data-value="dark" onclick="window.ThemeManager.setTheme('dark')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            Dark
          </button>
          <button class="theme-option" data-value="system" onclick="window.ThemeManager.setTheme('system')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
              <line x1="8" y1="21" x2="16" y2="21" />
              <line x1="12" y1="17" x2="12" y2="21" />
            </svg>
            System
          </button>
        </div>
      </div>
      <div class="top-nav-user-info">
        <div class="top-nav-user-name">
          <%= user.profile?.firstName || user.profile?.name || user.email.split('@')[0] %>
        </div>
        <div class="top-nav-user-email">
          <%= user.email %>
        </div>
      </div>
      <a href="/logout" class="top-nav-logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <a href="/organizations" class="back-link">← Back to Organizations</a>

    <div class="header">
      <div>
        <h1>Teams</h1>
        <div class="header-subtitle">
          <%= organization.name %>
        </div>
      </div>
      <div class="header-actions">
        <% if (['owner', 'admin' ].includes(yourRole)) { %>
          <button class="btn btn-primary" onclick="showCreateModal()">
            + Create Team
          </button>
          <% } %>
      </div>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
      <% } %>

        <% if (typeof success !=='undefined' && success) { %>
          <div class="alert alert-success">
            <%= success %>
          </div>
          <% } %>

            <% if (teams && teams.length> 0) { %>
              <% teams.forEach(team=> { %>
                <div class="card team-card">
                  <div class="team-info">
                    <% if (team.parentTeam) { %>
                      <div class="hierarchy-path">
                        📁 Parent: <%= team.parentTeam.name %>
                      </div>
                      <% } %>
                        <div class="team-name">
                          <%= team.name %>
                            <% if (team.manager) { %>
                              <span class="manager-badge">👤 <%= team.manager.name || team.manager.email %></span>
                              <% } %>
                        </div>
                        <% if (team.description) { %>
                          <div class="team-description">
                            <%= team.description %>
                          </div>
                          <% } %>
                            <div class="team-meta">
                              <span>
                                <%= team.memberCount || 0 %> member<%= team.memberCount !==1 ? 's' : '' %>
                              </span>
                              <% if (team.manager) { %>
                                <span>Manager: <%= team.manager.name || team.manager.email %></span>
                                <% } else { %>
                                  <span style="color: var(--warning);">No manager assigned</span>
                                  <% } %>
                            </div>
                            <% if (team.members && team.members.length> 0) { %>
                              <div class="members-list">
                                <div
                                  style="font-size: 13px; color: var(--muted); margin-bottom: 8px; font-weight: 600;">
                                  Members:</div>
                                <% team.members.slice(0, 3).forEach(member=> { %>
                                  <div style="display: inline-block; margin-right: 12px; margin-bottom: 8px;">
                                    <span class="role-badge role-<%= member.role %>">
                                      <%= member.role.replace('_', ' ' ) %>
                                    </span>
                                    <span style="font-size: 12px; color: var(--muted); margin-left: 6px;">
                                      <%= member.name || member.email %>
                                    </span>
                                  </div>
                                  <% }) %>
                                    <% if (team.members.length> 3) { %>
                                      <span style="font-size: 12px; color: var(--muted);">+<%= team.members.length - 3
                                          %> more</span>
                                      <% } %>
                              </div>
                              <% } %>
                  </div>
                  <div class="team-actions">
                    <button class="btn btn-secondary btn-sm"
                      onclick="manageMembers('<%= team.id %>', '<%= team.name %>')">
                      👥 Members
                    </button>
                    <% if (['owner', 'admin' ].includes(yourRole)) { %>
                      <button class="btn btn-secondary btn-sm"
                        onclick="setManager('<%= team.id %>', '<%= team.name %>')">
                        👤 Manager
                      </button>
                      <button class="btn btn-secondary btn-sm"
                        onclick="editTeam('<%= team.id %>', <%- JSON.stringify(team.name) %>, <%- JSON.stringify(team.description || '') %>, '<%= team.parentTeam ? team.parentTeam.id : '' %>')">
                        ✏️ Edit
                      </button>
                      <button class="btn btn-danger btn-sm" onclick="deleteTeam('<%= team.id %>', '<%= team.name %>')">
                        🗑️ Delete
                      </button>
                      <% } %>
                  </div>
                </div>
                <% }) %>
                  <% } else { %>
                    <div class="card empty-state">
                      <h3>No teams yet</h3>
                      <p>Create teams to organize your organization structure.</p>
                      <% if (['owner', 'admin' ].includes(yourRole)) { %>
                        <button class="btn btn-primary" onclick="showCreateModal()">
                          + Create Team
                        </button>
                        <% } %>
                    </div>
                    <% } %>
  </div>

  <!-- Create Team Modal -->
  <div class="modal" id="createModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Create Team</h2>
        <button class="modal-close" onclick="hideCreateModal()">&times;</button>
      </div>
      <form id="createForm">
        <div class="form-group">
          <label for="teamName">Team Name *</label>
          <input type="text" id="teamName" name="name" required maxlength="100"
            placeholder="e.g., Engineering, Sales, Marketing">
        </div>
        <div class="form-group">
          <label for="teamDescription">Description</label>
          <textarea id="teamDescription" name="description" maxlength="500"
            placeholder="Brief description (optional)"></textarea>
        </div>
        <div class="form-group">
          <label for="parentTeam">Parent Team (optional)</label>
          <select id="parentTeam" name="parentTeamId">
            <option value="">No parent (root team)</option>
            <% teams.forEach(team=> { %>
              <option value="<%= team.id %>">
                <%= team.name %>
              </option>
              <% }) %>
          </select>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-secondary" onclick="hideCreateModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Team</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Team Modal -->
  <div class="modal" id="editModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Edit Team</h2>
        <button class="modal-close" onclick="hideEditModal()">&times;</button>
      </div>
      <form id="editForm">
        <input type="hidden" id="editTeamId">
        <div class="form-group">
          <label for="editTeamName">Team Name *</label>
          <input type="text" id="editTeamName" name="name" required maxlength="100">
        </div>
        <div class="form-group">
          <label for="editTeamDescription">Description</label>
          <textarea id="editTeamDescription" name="description" maxlength="500"></textarea>
        </div>
        <div class="form-group">
          <label for="editParentTeam">Parent Team (optional)</label>
          <select id="editParentTeam" name="parentTeamId">
            <option value="">No parent (root team)</option>
            <% teams.forEach(team=> { %>
              <option value="<%= team.id %>">
                <%= team.name %>
              </option>
              <% }) %>
          </select>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-secondary" onclick="hideEditModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Manage Members Modal -->
  <div class="modal" id="membersModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="membersModalTitle">Team Members</h2>
        <button class="modal-close" onclick="hideMembersModal()">&times;</button>
      </div>
      <div id="membersModalContent">
        <div style="text-align: center; padding: 20px;">
          <div class="spinner"
            style="border: 3px solid var(--line); border-top: 3px solid var(--brand); border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto;">
          </div>
          <p style="margin-top: 12px; color: var(--muted);">Loading...</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Set Manager Modal -->
  <div class="modal" id="managerModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="managerModalTitle">Set Team Manager</h2>
        <button class="modal-close" onclick="hideManagerModal()">&times;</button>
      </div>
      <div id="managerModalContent">
        <div style="text-align: center; padding: 20px;">
          <div class="spinner"
            style="border: 3px solid var(--line); border-top: 3px solid var(--brand); border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto;">
          </div>
          <p style="margin-top: 12px; color: var(--muted);">Loading...</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const orgId = '<%= organization._id %>';
    const orgMembers = <% - JSON.stringify(orgMembers) %>;
    const teams = <% - JSON.stringify(teams) %>;

    function showCreateModal() {
      document.getElementById('createModal').classList.add('active');
    }

    function hideCreateModal() {
      document.getElementById('createModal').classList.remove('active');
      document.getElementById('createForm').reset();
    }

    function showEditModal() {
      document.getElementById('editModal').classList.add('active');
    }

    function hideEditModal() {
      document.getElementById('editModal').classList.remove('active');
    }

    function editTeam(teamId, name, description, parentTeamId) {
      document.getElementById('editTeamId').value = teamId;
      document.getElementById('editTeamName').value = name;
      document.getElementById('editTeamDescription').value = description || '';
      document.getElementById('editParentTeam').value = parentTeamId || '';
      showEditModal();
    }

    async function manageMembers(teamId, teamName) {
      document.getElementById('membersModalTitle').textContent = `Manage Members - ${teamName}`;
      document.getElementById('membersModalContent').innerHTML = `
        <div style="text-align: center; padding: 20px;">
          <div class="spinner" style="border: 3px solid var(--line); border-top: 3px solid var(--brand); border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto;"></div>
          <p style="margin-top: 12px; color: var(--muted);">Loading...</p>
        </div>
      `;
      document.getElementById('membersModal').classList.add('active');

      try {
        const response = await fetch(`/api/teams/${teamId}`);
        const team = await response.json();

        const currentMemberIds = team.members.map(m => m.id);
        const availableMembers = orgMembers.filter(m => !currentMemberIds.includes(m.id));

        document.getElementById('membersModalContent').innerHTML = `
          <div class="members-list">
            <h3 style="font-size: 16px; margin-bottom: 16px; color: var(--text);">Current Members (${team.members.length})</h3>
            ${team.members.length > 0 ? team.members.map(m => `
              <div class="member-item">
                <div class="member-info">
                  <div class="member-name">
                    ${m.name || 'No name'}
                    ${team.manager && team.manager.id === m.id ? '<span class="is-manager">MANAGER</span>' : ''}
                  </div>
                  <div class="member-email">${m.email}</div>
                </div>
                <div class="member-actions">
                  <select onchange="updateMemberRole('${teamId}', '${m.id}', this.value)" style="padding: 6px 10px; border-radius: 6px; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-size: 13px; margin-right: 8px;">
                    <option value="member" ${m.role === 'member' ? 'selected' : ''}>Member</option>
                    <option value="line_manager" ${m.role === 'line_manager' ? 'selected' : ''}>Line Manager</option>
                    <option value="team_lead" ${m.role === 'team_lead' ? 'selected' : ''}>Team Lead</option>
                  </select>
                  <button class="btn btn-danger btn-sm" onclick="removeMember('${teamId}', '${m.id}', '${escapeHtml(m.name || m.email)}')">Remove</button>
                </div>
              </div>
            `).join('') : '<p style="color: var(--muted); padding: 12px 0;">No members yet</p>'}
          </div>
          <div style="margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line);">
            <h3 style="font-size: 16px; margin-bottom: 16px; color: var(--text);">Add Member</h3>
            <form id="addMemberForm" onsubmit="event.preventDefault(); addMember('${teamId}');">
              <div class="form-group">
                <label for="newMemberId">Select Member</label>
                <select id="newMemberId" required style="margin-bottom: 12px;">
                  <option value="">Choose a member...</option>
                  ${availableMembers.map(m => `
                    <option value="${m.id}">${escapeHtml(m.name || m.email)} (${m.email})</option>
                  `).join('')}
                </select>
              </div>
              <div class="form-group">
                <label for="newMemberRole">Role</label>
                <select id="newMemberRole" required>
                  <option value="member">Member</option>
                  <option value="line_manager">Line Manager</option>
                  <option value="team_lead">Team Lead</option>
                </select>
              </div>
              <div class="form-actions">
                <button type="submit" class="btn btn-primary">Add Member</button>
              </div>
            </form>
          </div>
        `;
      } catch (error) {
        console.error('Failed to load team:', error);
        document.getElementById('membersModalContent').innerHTML = `
          <div class="alert alert-error">Failed to load team members</div>
        `;
      }
    }

    function hideMembersModal() {
      document.getElementById('membersModal').classList.remove('active');
    }

    async function addMember(teamId) {
      const memberId = document.getElementById('newMemberId').value;
      const role = document.getElementById('newMemberRole').value;

      if (!memberId) {
        alert('Please select a member');
        return;
      }

      try {
        const response = await fetch(`/api/teams/${teamId}/members`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accountId: memberId, role })
        });

        if (response.ok) {
          const team = teams.find(t => t.id === teamId);
          manageMembers(teamId, team ? team.name : 'Team');
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to add member');
        }
      } catch (error) {
        console.error('Add member error:', error);
        alert('Failed to add member');
      }
    }

    async function removeMember(teamId, memberId, memberName) {
      if (!confirm(`Remove ${memberName} from this team?`)) return;

      try {
        const response = await fetch(`/api/teams/${teamId}/members/${memberId}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          const team = teams.find(t => t.id === teamId);
          manageMembers(teamId, team ? team.name : 'Team');
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to remove member');
        }
      } catch (error) {
        console.error('Remove member error:', error);
        alert('Failed to remove member');
      }
    }

    async function updateMemberRole(teamId, memberId, newRole) {
      try {
        const response = await fetch(`/api/teams/${teamId}/members/${memberId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: newRole })
        });

        if (response.ok) {
          const team = teams.find(t => t.id === teamId);
          manageMembers(teamId, team ? team.name : 'Team');
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to update role');
        }
      } catch (error) {
        console.error('Update role error:', error);
        alert('Failed to update role');
      }
    }

    async function setManager(teamId, teamName) {
      document.getElementById('managerModalTitle').textContent = `Set Manager - ${teamName}`;
      document.getElementById('managerModalContent').innerHTML = `
        <div style="text-align: center; padding: 20px;">
          <div class="spinner" style="border: 3px solid var(--line); border-top: 3px solid var(--brand); border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto;"></div>
          <p style="margin-top: 12px; color: var(--muted);">Loading...</p>
        </div>
      `;
      document.getElementById('managerModal').classList.add('active');

      try {
        const response = await fetch(`/api/teams/${teamId}`);
        const team = await response.json();

        // Only show members with line_manager role
        const lineManagers = team.members.filter(m => m.role === 'line_manager');

        document.getElementById('managerModalContent').innerHTML = `
          <p style="color: var(--muted); margin-bottom: 16px; font-size: 14px;">
            Only members with <strong>line_manager</strong> role can be set as team manager.
            ${team.manager ? `Current manager: <strong>${team.manager.name || team.manager.email}</strong>` : 'No manager currently assigned.'}
          </p>
          ${lineManagers.length > 0 ? `
            <form id="setManagerForm" onsubmit="event.preventDefault(); doSetManager('${teamId}');">
              <div class="form-group">
                <label for="managerAccountId">Select Manager</label>
                <select id="managerAccountId">
                  <option value="">Clear manager (no manager)</option>
                  ${lineManagers.map(m => `
                    <option value="${m.id}" ${team.manager && team.manager.id === m.id ? 'selected' : ''}>
                      ${escapeHtml(m.name || m.email)} (${m.email})
                    </option>
                  `).join('')}
                </select>
              </div>
              <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="hideManagerModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Set Manager</button>
              </div>
            </form>
          ` : `
            <div class="alert alert-error">
              No members with line_manager role found. Assign line_manager role to a team member first.
            </div>
            <div class="form-actions">
              <button type="button" class="btn btn-secondary" onclick="hideManagerModal()">Close</button>
              <button type="button" class="btn btn-primary" onclick="hideManagerModal(); manageMembers('${teamId}', '${teamName}');">Manage Members</button>
            </div>
          `}
        `;
      } catch (error) {
        console.error('Failed to load team:', error);
        document.getElementById('managerModalContent').innerHTML = `
          <div class="alert alert-error">Failed to load team</div>
        `;
      }
    }

    function hideManagerModal() {
      document.getElementById('managerModal').classList.remove('active');
    }

    async function doSetManager(teamId) {
      const accountId = document.getElementById('managerAccountId').value;

      try {
        const response = await fetch(`/api/teams/${teamId}/manager`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accountId: accountId || null })
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to set manager');
        }
      } catch (error) {
        console.error('Set manager error:', error);
        alert('Failed to set manager');
      }
    }

    document.getElementById('createForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('teamName').value;
      const description = document.getElementById('teamDescription').value;
      const parentTeamId = document.getElementById('parentTeam').value || null;

      try {
        const response = await fetch(`/api/organizations/${orgId}/teams`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, description, parentTeamId })
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to create team');
        }
      } catch (error) {
        alert('Failed to create team');
      }
    });

    document.getElementById('editForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const teamId = document.getElementById('editTeamId').value;
      const name = document.getElementById('editTeamName').value;
      const description = document.getElementById('editTeamDescription').value;
      const parentTeamId = document.getElementById('editParentTeam').value || null;

      try {
        const response = await fetch(`/api/teams/${teamId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, description, parentTeamId })
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to update team');
        }
      } catch (error) {
        alert('Failed to update team');
      }
    });

    async function deleteTeam(teamId, name) {
      if (!confirm(`Delete team "${name}"? This cannot be undone.`)) return;

      try {
        const response = await fetch(`/api/teams/${teamId}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to delete team');
        }
      } catch (error) {
        alert('Failed to delete team');
      }
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Close modals on outside click
    document.querySelectorAll('.modal').forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target.classList.contains('modal')) {
          modal.classList.remove('active');
        }
      });
    });
  </script>
</body>

</html>