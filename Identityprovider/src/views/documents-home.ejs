<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Documents - Seemplify</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=3"></script>
  <style>
    .documents-home-shell {
      display: grid;
      gap: 20px;
      --documents-personal-border: rgba(56, 189, 248, 0.22);
      --documents-personal-border-hover: rgba(56, 189, 248, 0.4);
      --documents-personal-background:
        radial-gradient(circle at top right, rgba(34, 211, 238, 0.18), transparent 42%),
        linear-gradient(160deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.88));
      --documents-personal-shadow: 0 22px 46px rgba(2, 132, 199, 0.16);
      --documents-workspace-border: rgba(249, 115, 22, 0.24);
      --documents-workspace-border-hover: rgba(249, 115, 22, 0.4);
      --documents-workspace-background:
        radial-gradient(circle at top right, rgba(249, 115, 22, 0.16), transparent 42%),
        linear-gradient(160deg, rgba(24, 24, 27, 0.98), rgba(28, 25, 23, 0.9));
      --documents-workspace-shadow: 0 22px 46px rgba(194, 65, 12, 0.16);
      --documents-entry-text: #e2e8f0;
      --documents-entry-copy: rgba(226, 232, 240, 0.82);
      --documents-entry-meta: rgba(226, 232, 240, 0.76);
      --documents-entry-badge-bg: rgba(255, 255, 255, 0.08);
      --documents-entry-badge-border: rgba(255, 255, 255, 0.08);
      --documents-entry-badge-text: inherit;
      --documents-entry-icon-bg: rgba(255, 255, 255, 0.08);
      --documents-entry-icon-border: rgba(255, 255, 255, 0.08);
      --documents-entry-arrow-bg: rgba(255, 255, 255, 0.08);
      --documents-entry-arrow-border: rgba(255, 255, 255, 0.08);
      --documents-disabled-border: var(--border);
      --documents-disabled-background:
        linear-gradient(160deg, rgba(30, 41, 59, 0.94), rgba(15, 23, 42, 0.9));
      --documents-disabled-text: var(--text);
      --documents-disabled-copy: var(--text-secondary);
      --documents-disabled-meta: var(--muted);
      --documents-disabled-chip-bg: rgba(148, 163, 184, 0.08);
      --documents-disabled-chip-border: rgba(148, 163, 184, 0.12);
    }

    [data-theme="light"] .documents-home-shell {
      --documents-personal-border: rgba(59, 130, 246, 0.18);
      --documents-personal-border-hover: rgba(59, 130, 246, 0.32);
      --documents-personal-background:
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.16), transparent 42%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(238, 246, 255, 0.94));
      --documents-personal-shadow: 0 28px 52px -34px rgba(37, 99, 235, 0.34);
      --documents-workspace-border: rgba(249, 115, 22, 0.2);
      --documents-workspace-border-hover: rgba(249, 115, 22, 0.34);
      --documents-workspace-background:
        radial-gradient(circle at top right, rgba(251, 146, 60, 0.18), transparent 42%),
        linear-gradient(180deg, rgba(255, 251, 245, 0.98), rgba(255, 244, 235, 0.94));
      --documents-workspace-shadow: 0 28px 52px -34px rgba(194, 65, 12, 0.28);
      --documents-entry-text: #0f172a;
      --documents-entry-copy: rgba(15, 23, 42, 0.76);
      --documents-entry-meta: rgba(51, 65, 85, 0.78);
      --documents-entry-badge-bg: rgba(255, 255, 255, 0.76);
      --documents-entry-badge-border: rgba(99, 102, 241, 0.12);
      --documents-entry-badge-text: #334155;
      --documents-entry-icon-bg: rgba(255, 255, 255, 0.78);
      --documents-entry-icon-border: rgba(99, 102, 241, 0.12);
      --documents-entry-arrow-bg: rgba(255, 255, 255, 0.76);
      --documents-entry-arrow-border: rgba(99, 102, 241, 0.12);
      --documents-disabled-border: rgba(99, 102, 241, 0.14);
      --documents-disabled-background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(244, 247, 255, 0.9));
      --documents-disabled-text: #101828;
      --documents-disabled-copy: #475467;
      --documents-disabled-meta: #667085;
      --documents-disabled-chip-bg: rgba(99, 102, 241, 0.06);
      --documents-disabled-chip-border: rgba(99, 102, 241, 0.12);
    }

    .documents-home-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .documents-entry {
      position: relative;
      display: grid;
      gap: 18px;
      min-height: 280px;
      padding: 24px;
      border-radius: 24px;
      border: 1px solid var(--documents-personal-border);
      background: var(--documents-personal-background);
      color: var(--documents-entry-text);
      text-decoration: none;
      overflow: hidden;
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .documents-entry:hover {
      transform: translateY(-3px);
      border-color: var(--documents-personal-border-hover);
      box-shadow: var(--documents-personal-shadow);
    }

    .documents-entry--workspace {
      border-color: var(--documents-workspace-border);
      background: var(--documents-workspace-background);
    }

    .documents-entry--workspace:hover {
      border-color: var(--documents-workspace-border-hover);
      box-shadow: var(--documents-workspace-shadow);
    }

    .documents-entry--disabled {
      cursor: not-allowed;
      border-color: var(--documents-disabled-border);
      background: var(--documents-disabled-background);
      color: var(--documents-disabled-text);
      box-shadow: none;
    }

    .documents-entry--disabled:hover {
      transform: none;
      border-color: var(--documents-disabled-border);
      box-shadow: none;
    }

    .documents-entry-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: fit-content;
      padding: 7px 12px;
      border-radius: 999px;
      background: var(--documents-entry-badge-bg);
      border: 1px solid var(--documents-entry-badge-border);
      color: var(--documents-entry-badge-text);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .documents-entry-icon {
      width: 58px;
      height: 58px;
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--documents-entry-icon-bg);
      border: 1px solid var(--documents-entry-icon-border);
      color: inherit;
    }

    .documents-entry-title {
      margin: 0;
      font-size: 28px;
      line-height: 1.05;
      letter-spacing: -0.03em;
      color: inherit;
    }

    .documents-entry-copy {
      margin: 0;
      max-width: 30rem;
      font-size: 15px;
      line-height: 1.65;
      color: var(--documents-entry-copy);
    }

    .documents-entry--disabled .documents-entry-copy {
      color: var(--documents-disabled-copy);
    }

    .documents-entry-footer {
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .documents-entry-meta {
      font-size: 13px;
      color: var(--documents-entry-meta);
    }

    .documents-entry--disabled .documents-entry-meta {
      color: var(--documents-disabled-meta);
    }

    .documents-entry-arrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 14px;
      background: var(--documents-entry-arrow-bg);
      border: 1px solid var(--documents-entry-arrow-border);
    }

    .documents-entry--disabled .documents-entry-arrow {
      background: var(--documents-disabled-chip-bg);
      border-color: var(--documents-disabled-chip-border);
    }

    .documents-entry--disabled .documents-entry-badge,
    .documents-entry--disabled .documents-entry-icon {
      background: var(--documents-disabled-chip-bg);
      border-color: var(--documents-disabled-chip-border);
    }

    @media (max-width: 860px) {
      .documents-home-grid {
        grid-template-columns: 1fr;
      }

      .documents-entry {
        min-height: 240px;
      }
    }
  </style>
</head>

<body>
  <%- include('partials/nav', { activePage: 'documents' }) %>

  <div class="container documents-home-shell">
    <a href="/" class="back-link">&larr; Back to Hub</a>

    <div class="header" style="margin-bottom: 0;">
      <div>
        <h1 style="margin-bottom: 6px;">Documents</h1>
        <div class="header-subtitle">Choose where you want to go next.</div>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="documents-home-grid">
      <a href="/documents/my" class="documents-entry">
        <div class="documents-entry-badge">Personal</div>
        <div class="documents-entry-icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <path d="M9 15h6"></path>
            <path d="M9 11h6"></path>
          </svg>
        </div>
        <div>
          <h2 class="documents-entry-title">My Documents</h2>
          <p class="documents-entry-copy">Review your assigned documents, complete onboarding steps, and jump straight into any pending signature flow.</p>
        </div>
        <div class="documents-entry-footer">
          <div class="documents-entry-meta">Open your personal document flow</div>
          <div class="documents-entry-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14"></path>
              <path d="M12 5l7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </a>

      <% if (canAccessWorkspace) { %>
        <a href="/documents/workspace" class="documents-entry documents-entry--workspace">
          <div class="documents-entry-badge">Admin</div>
          <div class="documents-entry-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 7h18"></path>
              <path d="M7 3v8"></path>
              <path d="M17 3v8"></path>
              <rect x="4" y="5" width="16" height="15" rx="2"></rect>
              <path d="M8 14h8"></path>
              <path d="M8 18h5"></path>
            </svg>
          </div>
          <div>
            <h2 class="documents-entry-title">Document Workspace</h2>
            <p class="documents-entry-copy">Create workflow templates, assign document journeys, manage signers, and track completion for <%= currentOrganizationName || 'your organization' %>.</p>
          </div>
          <div class="documents-entry-footer">
            <div class="documents-entry-meta">Manage workflow operations</div>
            <div class="documents-entry-arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
              </svg>
            </div>
          </div>
        </a>
      <% } else { %>
        <div class="documents-entry documents-entry--disabled" aria-disabled="true">
          <div class="documents-entry-badge">Admin</div>
          <div class="documents-entry-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="10" rx="2"></rect>
              <path d="M7 11V8a5 5 0 0 1 10 0v3"></path>
            </svg>
          </div>
          <div>
            <h2 class="documents-entry-title">Document Workspace</h2>
            <p class="documents-entry-copy">This area is reserved for owners, admins, and HR managers in <%= currentOrganizationName || 'the current organization' %>.</p>
          </div>
          <div class="documents-entry-footer">
            <div class="documents-entry-meta">You can still use My Documents</div>
            <div class="documents-entry-arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
              </svg>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</body>

</html>
