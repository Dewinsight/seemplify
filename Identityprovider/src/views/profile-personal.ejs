<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Personal Information - Seemplify</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style><%- include('../public/css/idp-theme.css') %></style>
    <link rel="stylesheet" href="/css/main.css?v=3">
    <link rel="stylesheet" href="/css/profile-dashboard.css?v=3">
    <link rel="stylesheet" href="/css/profile-personal.css?v=1">
    <script src="/js/theme.js?v=3"></script>
</head>
<body class="idp-workspace-page">
<%- include('partials/nav', { activePage: 'profile' }) %>
<% const personalStep = profileCompletion?.steps?.find(step => step.key === 'personal'); %>
<% const setupMode = profileSetupMode === true; %>
<div class="container">
    <div class="header">
        <div>
            <div class="profile-kicker"><%= setupMode ? 'Profile setup' : 'Seemplify Identity' %></div>
            <h1><%= setupMode ? 'Complete your personal profile' : 'Personal Information' %></h1>
            <div class="header-subtitle"><%= setupMode ? 'Add the details needed for your employee record.' : 'Keep your identity and emergency details accurate.' %></div>
        </div>
    </div>
    <%- include('partials/profile-nav', { activeProfileSection }) %>

    <section class="profile-setup-checklist" aria-labelledby="profileChecklistTitle">
        <div class="profile-setup-checklist__header">
            <div>
                <h2 id="profileChecklistTitle">Required information</h2>
                <p>Each item is checked when its required fields are ready. Saving confirms your profile with Seemplify Identity.</p>
            </div>
            <span id="profileChecklistCount" class="profile-setup-checklist__count" role="status" aria-live="polite"></span>
        </div>
        <div class="profile-setup-checklist__items">
            <% (personalStep?.requirements || []).forEach((requirement, index) => { %>
                <div class="profile-requirement <%= requirement.complete ? 'is-complete' : '' %>" data-requirement="<%= requirement.key %>">
                    <span class="profile-requirement__icon" aria-hidden="true"><%= requirement.complete ? '✓' : index + 1 %></span>
                    <span><%= requirement.label %></span>
                    <span class="profile-requirement__state"><%= requirement.complete ? 'Ready' : 'Required' %></span>
                </div>
            <% }) %>
        </div>
    </section>

    <div id="alertSuccess" class="alert alert-success" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></div>
    <div id="alertError" class="alert alert-error" role="alert" aria-live="assertive" aria-atomic="true" tabindex="-1">
        <span id="alertErrorMessage"></span>
        <a id="alertErrorAction" class="alert-action" href="/login" hidden>Sign in again</a>
    </div>

    <form id="personalForm" novalidate>
        <section class="card profile-form-section" id="identitySection" aria-labelledby="identitySectionTitle">
            <h2 id="identitySectionTitle">Core personal details</h2>
            <div class="form-group">
                <label for="dateOfBirth">Date of birth</label>
                <input required type="date" id="dateOfBirth" aria-describedby="dateOfBirthHint dateOfBirthError" value="<%= user.profile?.personalInfo?.dateOfBirth ? new Date(user.profile.personalInfo.dateOfBirth).toISOString().split('T')[0] : '' %>">
                <div id="dateOfBirthHint" class="form-hint">Required for payroll and HR records.</div>
                <div id="dateOfBirthError" class="field-error" data-error-for="dateOfBirth"></div>
            </div>
        </section>

        <section class="card profile-form-section" id="addressSection" aria-labelledby="addressSectionTitle">
            <h2 id="addressSectionTitle">Mailing address</h2>
            <div class="form-group">
                <label for="street">Street address</label>
                <input required type="text" autocomplete="street-address" id="street" aria-describedby="streetError" value="<%= user.profile?.personalInfo?.mailingAddress?.street || '' %>" placeholder="123 Main Street">
                <div id="streetError" class="field-error" data-error-for="street"></div>
            </div>
            <div class="form-group">
                <label for="street2">Apartment, suite, or unit <span class="form-hint">(optional)</span></label>
                <input type="text" autocomplete="address-line2" id="street2" value="<%= user.profile?.personalInfo?.mailingAddress?.street2 || '' %>" placeholder="Apt 4B">
            </div>
            <div class="form-grid">
                <div class="form-group"><label for="city">City</label><input required type="text" autocomplete="address-level2" id="city" aria-describedby="cityError" value="<%= user.profile?.personalInfo?.mailingAddress?.city || '' %>" placeholder="London"><div id="cityError" class="field-error" data-error-for="city"></div></div>
                <div class="form-group"><label for="state">State, province, or region</label><input type="text" autocomplete="address-level1" id="state" aria-describedby="stateError stateHint" value="<%= user.profile?.personalInfo?.mailingAddress?.state || '' %>" placeholder="Greater London"><div id="stateHint" class="form-hint">Required for US addresses.</div><div id="stateError" class="field-error" data-error-for="state"></div></div>
                <div class="form-group"><label for="zipCode">Postal or ZIP code</label><input required type="text" autocomplete="postal-code" id="zipCode" aria-describedby="zipCodeError" value="<%= user.profile?.personalInfo?.mailingAddress?.zipCode || '' %>" placeholder="SW1A 1AA"><div id="zipCodeError" class="field-error" data-error-for="zipCode"></div></div>
                <div class="form-group"><label for="country">Country</label><input required type="text" autocomplete="country-name" id="country" list="countrySuggestions" aria-describedby="countryError" value="<%= user.profile?.personalInfo?.mailingAddress?.country || '' %>" placeholder="United Kingdom"><datalist id="countrySuggestions"><option>United States</option><option>United Kingdom</option><option>Canada</option><option>Nigeria</option><option>Ghana</option><option>Kenya</option><option>South Africa</option><option>Mexico</option></datalist><div id="countryError" class="field-error" data-error-for="country"></div></div>
            </div>
        </section>

        <section class="card profile-form-section" id="phoneSection" aria-labelledby="phoneSectionTitle">
            <h2 id="phoneSectionTitle">Phone numbers</h2>
            <div class="form-group"><label for="mobile">Mobile phone</label><input required autocomplete="tel" type="tel" id="mobile" aria-describedby="mobileError" value="<%= user.profile?.personalInfo?.phoneNumbers?.mobile || '' %>" placeholder="+44 7700 900123"><div id="mobileError" class="field-error" data-error-for="mobile"></div></div>
            <div class="form-grid">
                <div class="form-group"><label for="home">Home phone <span class="form-hint">(optional)</span></label><input type="tel" autocomplete="tel" id="home" aria-describedby="homeError" value="<%= user.profile?.personalInfo?.phoneNumbers?.home || '' %>"><div id="homeError" class="field-error" data-error-for="home"></div></div>
                <div class="form-group"><label for="work">Work phone <span class="form-hint">(optional)</span></label><input type="tel" autocomplete="tel" id="work" aria-describedby="workError" value="<%= user.profile?.personalInfo?.phoneNumbers?.work || '' %>"><div id="workError" class="field-error" data-error-for="work"></div></div>
            </div>
        </section>

        <section class="card profile-form-section" id="emergencyContactSection" aria-labelledby="emergencyContactSectionTitle" aria-describedby="emergencyContactsError" tabindex="-1">
            <h2 id="emergencyContactSectionTitle">Emergency contact</h2>
            <p class="form-hint profile-section-copy">Add at least one contact, then save your personal information to finish.</p>
            <div id="contactSaved" class="contact-saved" role="status" aria-live="polite">Contact added to this form. Save your personal information to finish.</div>
            <div id="emergencyContactsList"></div>
            <div id="emergencyContactsError" class="field-error" data-error-for="emergencyContacts"></div>
            <hr>
            <h3>Add an emergency contact</h3>
            <div class="contact-grid">
                <div class="form-group"><label for="contactName">Full name</label><input type="text" id="contactName" autocomplete="name" aria-describedby="contactNameError"><div id="contactNameError" class="field-error" data-contact-error="name"></div></div>
                <div class="form-group"><label for="contactRelationship">Relationship</label><input type="text" id="contactRelationship" aria-describedby="contactRelationshipError" placeholder="Spouse, parent, friend"><div id="contactRelationshipError" class="field-error" data-contact-error="relationship"></div></div>
                <div class="form-group"><label for="contactPhone">Phone number</label><input id="contactPhone" type="tel" autocomplete="tel" aria-describedby="contactPhoneError"><div id="contactPhoneError" class="field-error" data-contact-error="phone"></div></div>
                <div class="form-group"><label for="contactEmail">Email <span class="form-hint">(optional)</span></label><input id="contactEmail" type="email" autocomplete="email" aria-describedby="contactEmailError"><div id="contactEmailError" class="field-error" data-contact-error="email"></div></div>
            </div>
            <button type="button" class="btn btn-secondary" id="saveContactBtn">Add contact</button>
        </section>

        <div class="card profile-save-card"><div class="form-actions">
            <button type="submit" class="btn btn-primary" id="saveBtn"><span id="btnText"><%= setupMode ? 'Save and continue' : 'Save personal information' %></span><span id="btnSpinner" hidden>Saving…</span></button>
            <% if (!setupMode) { %><a href="/profile" class="btn btn-secondary">Cancel</a><% } %>
        </div></div>
    </form>
</div>

<script id="profilePersonalConfig" type="application/json"><%- JSON.stringify({ setupMode, emergencyContacts: user.profile?.personalInfo?.emergencyContacts || [] }).replace(/</g, '\\u003c') %></script>
<script src="/js/profile-personal.js?v=1"></script>
<script src="/js/invitation-gatekeeper.js"></script>
</body>
</html>
