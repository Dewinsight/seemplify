<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8"><title>Personal Information - Seemplify</title><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style><%- include('../public/css/idp-theme.css') %></style>
    <link rel="stylesheet" href="/css/main.css?v=3"><link rel="stylesheet" href="/css/profile-dashboard.css?v=2"><script src="/js/theme.js?v=3"></script>
    <style>
        .setup-steps{display:flex;align-items:center;gap:10px;margin:20px 0 28px;color:var(--muted);font-size:13px}.setup-step{display:flex;align-items:center;gap:8px}.setup-step-number{display:inline-grid;place-items:center;width:26px;height:26px;border:1px solid var(--border);border-radius:50%;font-weight:700}.setup-step.is-active{color:var(--text);font-weight:700}.setup-step.is-active .setup-step-number{border-color:var(--brand);color:var(--brand)}.setup-divider{width:40px;height:1px;background:var(--border)}
        .field-error{display:none;margin-top:7px;color:var(--error);font-size:13px}.field-error.is-visible{display:block}input[aria-invalid="true"]{border-color:var(--error)!important;box-shadow:0 0 0 1px var(--error)}.form-grid,.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.contact-grid{gap:12px;margin-bottom:18px}.contact-card{display:flex;justify-content:space-between;gap:16px;padding:16px;border:1px solid var(--border);border-radius:10px;background:var(--hover-bg)}.contact-card+.contact-card{margin-top:10px}.contact-name{color:var(--text);font-weight:700}.contact-meta{margin-top:4px;color:var(--muted);font-size:13px}.empty-contacts{padding:18px;border:1px dashed var(--border);border-radius:10px;color:var(--muted);font-size:14px}.contact-saved{display:none;margin:0 0 14px;color:var(--brand);font-size:13px;font-weight:600}.contact-saved.is-visible{display:block}@media(max-width:700px){.form-grid,.contact-grid{grid-template-columns:1fr}.setup-divider{width:18px}}
    </style>
</head>
<body class="idp-workspace-page"><%- include('partials/nav', { activePage: 'profile' }) %>
<div class="container">
    <div class="header"><div><h1>Personal Information</h1><div class="header-subtitle">Keep your identity and emergency details accurate</div></div></div>
    <%- include('partials/profile-nav', { activeProfileSection }) %>
    <div class="setup-steps" aria-label="Employee setup progress"><div class="setup-step is-active"><span class="setup-step-number">1</span><span>Personal info</span></div><span class="setup-divider"></span><div class="setup-step"><span class="setup-step-number">2</span><span>Dependents</span></div><span class="setup-divider"></span><div class="setup-step"><span class="setup-step-number">3</span><span>Banking</span></div></div>
    <div id="alertSuccess" class="alert alert-success" role="status"></div><div id="alertError" class="alert alert-error" role="alert"></div>
    <form id="personalForm" novalidate>
        <div class="card"><h3 style="font-size:18px;margin-bottom:16px">Core Personal Details</h3><div class="form-group"><label for="dateOfBirth">Date of Birth</label><input required type="date" id="dateOfBirth" value="<%= user.profile?.personalInfo?.dateOfBirth ? new Date(user.profile.personalInfo.dateOfBirth).toISOString().split('T')[0] : '' %>"><div class="form-hint">Required for payroll and HR records.</div><div class="field-error" data-error-for="dateOfBirth"></div></div></div>
        <div class="card"><h3 style="font-size:18px;margin-bottom:16px">Mailing Address</h3>
            <div class="form-group"><label for="street">Street Address</label><input required autocomplete="street-address" id="street" value="<%= user.profile?.personalInfo?.mailingAddress?.street || '' %>" placeholder="123 Main Street"><div class="field-error" data-error-for="street"></div></div>
            <div class="form-group"><label for="street2">Apartment, Suite, Unit <span class="form-hint">(optional)</span></label><input id="street2" value="<%= user.profile?.personalInfo?.mailingAddress?.street2 || '' %>" placeholder="Apt 4B"></div>
            <div class="form-grid"><div class="form-group"><label for="city">City</label><input required autocomplete="address-level2" id="city" value="<%= user.profile?.personalInfo?.mailingAddress?.city || '' %>" placeholder="New York"><div class="field-error" data-error-for="city"></div></div><div class="form-group"><label for="state">State, Province, or Region</label><input autocomplete="address-level1" id="state" value="<%= user.profile?.personalInfo?.mailingAddress?.state || '' %>" placeholder="New York"><div class="field-error" data-error-for="state"></div></div><div class="form-group"><label for="zipCode">Postal or ZIP Code</label><input required autocomplete="postal-code" id="zipCode" value="<%= user.profile?.personalInfo?.mailingAddress?.zipCode || '' %>" placeholder="10001"><div class="field-error" data-error-for="zipCode"></div></div><div class="form-group"><label for="country">Country</label><input required autocomplete="country-name" id="country" list="countrySuggestions" value="<%= user.profile?.personalInfo?.mailingAddress?.country || '' %>" placeholder="United States"><datalist id="countrySuggestions"><option>United States</option><option>United Kingdom</option><option>Canada</option><option>Nigeria</option><option>Ghana</option><option>Kenya</option><option>South Africa</option><option>Mexico</option></datalist><div class="field-error" data-error-for="country"></div></div></div>
        </div>
        <div class="card"><h3 style="font-size:18px;margin-bottom:16px">Phone Numbers</h3><div class="form-group"><label for="mobile">Mobile Phone</label><input required autocomplete="tel" type="tel" id="mobile" value="<%= user.profile?.personalInfo?.phoneNumbers?.mobile || '' %>" placeholder="+1 555 123 4567"><div class="field-error" data-error-for="mobile"></div></div><div class="form-grid"><div class="form-group"><label for="home">Home Phone <span class="form-hint">(optional)</span></label><input type="tel" id="home" value="<%= user.profile?.personalInfo?.phoneNumbers?.home || '' %>"><div class="field-error" data-error-for="home"></div></div><div class="form-group"><label for="work">Work Phone <span class="form-hint">(optional)</span></label><input type="tel" id="work" value="<%= user.profile?.personalInfo?.phoneNumbers?.work || '' %>"><div class="field-error" data-error-for="work"></div></div></div></div>
        <div class="card"><h3 style="font-size:18px;margin-bottom:4px">Emergency Contacts</h3><p class="form-hint" style="margin-bottom:18px">Save a contact to create a card. Changes are committed when you continue.</p><div id="contactSaved" class="contact-saved" role="status">Contact saved to this form.</div><div id="emergencyContactsList"></div><div class="field-error" data-error-for="emergencyContacts"></div><hr style="margin:24px 0"><h4 style="margin-bottom:14px;color:var(--text)">Add emergency contact</h4><div class="contact-grid"><div class="form-group"><label for="contactName">Full Name</label><input id="contactName" autocomplete="name"><div class="field-error" data-contact-error="name"></div></div><div class="form-group"><label for="contactRelationship">Relationship</label><input id="contactRelationship" placeholder="Spouse, parent, friend"><div class="field-error" data-contact-error="relationship"></div></div><div class="form-group"><label for="contactPhone">Phone Number</label><input id="contactPhone" type="tel" autocomplete="tel"><div class="field-error" data-contact-error="phone"></div></div><div class="form-group"><label for="contactEmail">Email <span class="form-hint">(optional)</span></label><input id="contactEmail" type="email" autocomplete="email"><div class="field-error" data-contact-error="email"></div></div></div><button type="button" class="btn btn-secondary" id="saveContactBtn">Save contact</button></div>
        <div class="card"><div class="form-actions"><button type="submit" class="btn btn-primary" id="saveBtn"><span id="btnText">Save and continue to dependents</span><span id="btnSpinner" style="display:none">Saving…</span></button><a href="/profile" class="btn btn-secondary">Cancel</a></div></div>
    </form>
</div>
<script>
const payrollDependentsUrl=<%- JSON.stringify(`${payrollUrl}/dependents`) %>;let emergencyContacts=<%- JSON.stringify(user.profile?.personalInfo?.emergencyContacts || []).replace(/</g, '\\u003c') %>;const byId=id=>document.getElementById(id),clean=value=>String(value||'').trim().replace(/\s+/g,' '),validPhone=value=>{const phone=clean(value),digits=phone.replace(/\D/g,'');return /^\+?[0-9][0-9\s().-]{5,20}$/.test(phone)&&digits.length>=7&&digits.length<=15},validText=value=>/^[\p{L}][\p{L}\p{M}\s.'-]*$/u.test(clean(value));
function setError(key,message,contact=false){const node=document.querySelector(contact?`[data-contact-error="${key}"]`:`[data-error-for="${key}"]`);if(node){node.textContent=message||'';node.classList.toggle('is-visible',Boolean(message))}const input=contact?byId(`contact${key[0].toUpperCase()}${key.slice(1)}`):byId(key);if(input)input.setAttribute('aria-invalid',message?'true':'false')}
function clearErrors(){document.querySelectorAll('.field-error').forEach(node=>node.classList.remove('is-visible'));document.querySelectorAll('[aria-invalid="true"]').forEach(node=>node.setAttribute('aria-invalid','false'))}function escapeHtml(value){const node=document.createElement('div');node.textContent=value;return node.innerHTML}
function renderContacts(){const list=byId('emergencyContactsList');list.innerHTML=emergencyContacts.length?emergencyContacts.map((contact,index)=>`<article class="contact-card"><div><div class="contact-name">${escapeHtml(contact.name)}</div><div class="contact-meta">${escapeHtml(contact.relationship)} · ${escapeHtml(contact.phone)}</div>${contact.email?`<div class="contact-meta">${escapeHtml(contact.email)}</div>`:''}</div><button type="button" class="btn btn-secondary" data-remove-contact="${index}" aria-label="Remove ${escapeHtml(contact.name)}">Remove</button></article>`).join(''):'<div class="empty-contacts">No emergency contacts saved yet.</div>';list.querySelectorAll('[data-remove-contact]').forEach(button=>button.addEventListener('click',()=>{emergencyContacts.splice(Number(button.dataset.removeContact),1);renderContacts();setError('emergencyContacts',emergencyContacts.length?'':'Save at least one emergency contact.')}))}
function saveContact(){['name','relationship','phone','email'].forEach(key=>setError(key,'',true));const contact={name:clean(byId('contactName').value),relationship:clean(byId('contactRelationship').value),phone:clean(byId('contactPhone').value),email:clean(byId('contactEmail').value).toLowerCase()};let invalid=false;if(contact.name.length<2||!validText(contact.name)){setError('name','Enter the contact’s full name.',true);invalid=true}if(contact.relationship.length<2||!validText(contact.relationship)){setError('relationship','Enter a valid relationship.',true);invalid=true}if(!validPhone(contact.phone)){setError('phone','Enter a valid phone number with 7 to 15 digits.',true);invalid=true}if(contact.email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contact.email)){setError('email','Enter a valid email address.',true);invalid=true}if(invalid)return;emergencyContacts.push({...contact,isPrimary:emergencyContacts.length===0});['contactName','contactRelationship','contactPhone','contactEmail'].forEach(id=>byId(id).value='');setError('emergencyContacts','');renderContacts();byId('contactSaved').classList.add('is-visible');setTimeout(()=>byId('contactSaved').classList.remove('is-visible'),3000)}
function collectData(){return{dateOfBirth:byId('dateOfBirth').value,mailingAddress:{street:clean(byId('street').value),street2:clean(byId('street2').value),city:clean(byId('city').value),state:clean(byId('state').value),zipCode:clean(byId('zipCode').value),country:clean(byId('country').value)},phoneNumbers:{mobile:clean(byId('mobile').value),home:clean(byId('home').value),work:clean(byId('work').value)},emergencyContacts}}
function clientErrors(data){const errors={},country=data.mailingAddress.country.toLowerCase(),dob=new Date(`${data.dateOfBirth}T00:00:00Z`);if(!data.dateOfBirth||Number.isNaN(dob.getTime()))errors.dateOfBirth='Enter a valid date of birth.';else if(dob>new Date())errors.dateOfBirth='Date of birth cannot be in the future.';if(data.mailingAddress.street.length<5)errors.street='Enter a complete street address.';if(data.mailingAddress.city.length<2||!validText(data.mailingAddress.city))errors.city='Enter a valid city.';if(!data.mailingAddress.country||!validText(data.mailingAddress.country))errors.country='Enter a valid country name.';if(data.mailingAddress.state&&!validText(data.mailingAddress.state))errors.state='Enter a valid state, province, or region name.';if(['usa','us','united states','united states of america'].includes(country)&&!/^\d{5}(-\d{4})?$/.test(data.mailingAddress.zipCode))errors.zipCode='Enter a 5-digit US ZIP code, optionally followed by 4 digits.';else if(data.mailingAddress.zipCode.length<3)errors.zipCode='Enter a valid postal or ZIP code.';if(!validPhone(data.phoneNumbers.mobile))errors.mobile='Enter a valid mobile number with 7 to 15 digits.';['home','work'].forEach(key=>{if(data.phoneNumbers[key]&&!validPhone(data.phoneNumbers[key]))errors[key]=`Enter a valid ${key} phone number.`});if(!data.emergencyContacts.length)errors.emergencyContacts='Save at least one emergency contact.';return errors}
function showErrors(errors){Object.entries(errors||{}).forEach(([key,message])=>setError(key.startsWith('emergencyContacts.')?'emergencyContacts':key,message));document.querySelector('[aria-invalid="true"]')?.focus()}
async function submitPersonal(event){event.preventDefault();clearErrors();byId('alertSuccess').classList.remove('show');byId('alertError').classList.remove('show');const data=collectData(),errors=clientErrors(data);if(Object.keys(errors).length){showErrors(errors);byId('alertError').textContent='Check the highlighted fields and try again.';byId('alertError').classList.add('show');return}byId('saveBtn').disabled=true;byId('btnText').style.display='none';byId('btnSpinner').style.display='inline';try{const response=await fetch('/api/profile/personal',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}),result=await response.json();if(!response.ok){showErrors(result.fieldErrors);throw new Error(result.error||'Unable to save personal information.')}byId('alertSuccess').textContent='Personal information saved. Opening your Payroll dependents step…';byId('alertSuccess').classList.add('show');setTimeout(()=>{window.location.href=result?.nextStep?.route||payrollDependentsUrl},700)}catch(error){byId('alertError').textContent=error.message||'Unable to save personal information.';byId('alertError').classList.add('show');window.scrollTo({top:0,behavior:'smooth'})}finally{byId('saveBtn').disabled=false;byId('btnText').style.display='inline';byId('btnSpinner').style.display='none'}}
byId('saveContactBtn').addEventListener('click',saveContact);byId('personalForm').addEventListener('submit',submitPersonal);renderContacts();
</script><script src="/js/invitation-gatekeeper.js"></script></body></html>
