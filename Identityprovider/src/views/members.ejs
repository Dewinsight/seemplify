<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Members - <%= organization.name %> - AIIN Identity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
    .member-grid {
      display: grid;
      gap: 18px;
    }
    .toolbar {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }
    .member-fields {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-top: 16px;
    }
    .member-fields label {
      display: block;
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .app-access-box {
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }
    .app-access-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 8px;
      margin-top: 10px;
    }
    .app-access-item {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 8px 10px;
      background: rgba(15, 23, 42, 0.45);
    }
    .split-layout {
      display: grid;
      gap: 18px;
      margin-top: 28px;
    }
    .inline-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }
    .mini-meta {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 8px;
      color: var(--muted);
      font-size: 13px;
    }
    .structure-layout {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      min-height: 520px;
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      background: var(--panel);
    }
    .department-browser {
      border-right: 1px solid var(--border);
      background: color-mix(in srgb, var(--panel) 82%, var(--bg));
    }
    .department-browser__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 58px;
      padding: 0 16px;
      border-bottom: 1px solid var(--border);
    }
    .department-browser__header h2 {
      margin: 0;
      font-size: 14px;
    }
    .department-create {
      padding: 6px 8px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
    }
    .department-create:hover { color: var(--text); background: var(--hover-bg); }
    .department-list {
      display: grid;
      padding: 8px;
    }
    .department-list__item {
      width: 100%;
      padding: 11px 10px;
      border: 0;
      border-radius: 7px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      text-align: left;
    }
    .department-list__item:hover { background: var(--hover-bg); color: var(--text); }
    .department-list__item.active { background: var(--panel-strong); color: var(--text); }
    .department-list__name {
      display: block;
      overflow: hidden;
      font-size: 13px;
      font-weight: 650;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .department-list__meta {
      display: block;
      margin-top: 3px;
      font-size: 11px;
      color: var(--muted);
    }
    .department-detail { min-width: 0; padding: 24px; }
    .department-detail[hidden] { display: none; }
    .department-detail__header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }
    .department-detail__header h2 {
      margin: 0;
      font-size: 22px;
      letter-spacing: -.025em;
    }
    .department-detail__description {
      max-width: 620px;
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 13px;
    }
    .department-detail__actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .department-facts {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      margin: 20px 0 26px;
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .department-fact { min-width: 0; padding: 13px 14px; }
    .department-fact + .department-fact { border-left: 1px solid var(--border); }
    .department-fact__label { color: var(--muted); font-size: 11px; }
    .department-fact__value {
      overflow: hidden;
      margin-top: 3px;
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .department-teams__header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }
    .department-teams__header h3 { margin: 0; font-size: 15px; }
    .department-teams__header span { color: var(--muted); font-size: 12px; }
    .team-row {
      display: grid;
      grid-template-columns: minmax(180px, 1fr) minmax(250px, 1.25fr) auto;
      gap: 18px;
      align-items: center;
      min-height: 82px;
      padding: 14px 0;
      border-top: 1px solid var(--border);
    }
    .team-row__name { color: var(--text); font-size: 14px; font-weight: 650; }
    .team-row__path { margin-top: 3px; color: var(--muted); font-size: 11px; }
    .team-row__leaders {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .team-row__leader-label { color: var(--muted); font-size: 10px; }
    .team-row__leader-value { margin-top: 2px; color: var(--text-secondary); font-size: 12px; }
    .team-row__actions { display: flex; justify-content: flex-end; gap: 6px; }
    .structure-empty {
      padding: 28px 0;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 13px;
    }
    .members-section .stats { margin-top: 0; }
    .members-section__heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 12px;
    }
    .members-section__heading h2 { margin: 0; font-size: 20px; }
    .members-section__heading p { max-width: 640px; margin: 5px 0 0; font-size: 13px; }
    .members-overview {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px 18px;
      margin-bottom: 16px;
      color: var(--muted);
      font-size: 12px;
    }
    .members-overview__item strong { margin-right: 4px; color: var(--text); font-size: 12px; }
    .role-management-note {
      margin-bottom: 18px;
      padding: 10px 12px;
      border-left: 2px solid var(--brand-2);
      background: var(--panel-solid);
      color: var(--text-secondary);
      font-size: 12px;
    }
    .role-management-note strong { color: var(--text); }
    .member-directory-toolbar {
      display: grid;
      grid-template-columns: minmax(230px, 1.45fr) repeat(4, minmax(140px, .7fr));
      gap: 10px;
      margin-bottom: 14px;
    }
    .member-filter-field { min-width: 0; }
    .member-filter-field label {
      display: block;
      margin-bottom: 5px;
      color: var(--muted);
      font-size: 11px;
    }
    .member-filter-field input,
    .member-filter-field select { width: 100%; }
    .member-directory-status {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 32px;
      margin: -8px 0 8px;
      color: var(--muted);
      font-size: 12px;
    }
    .member-directory-empty {
      padding: 32px 20px;
      border: 1px dashed var(--border);
      border-radius: 10px;
      color: var(--muted);
      text-align: center;
    }
    .member-list-header {
      display: grid;
      grid-template-columns: minmax(220px, 1.2fr) minmax(150px, .7fr) minmax(190px, 1fr) minmax(130px, .65fr) 76px;
      gap: 18px;
      padding: 0 18px 8px;
      color: var(--muted);
      font-size: 11px;
    }
    .locations-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 18px;
    }
    .locations-header h2 { margin: 0; font-size: 20px; }
    .locations-header p { margin: 5px 0 0; color: var(--muted); font-size: 13px; }
    .locations-table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: var(--panel-solid);
    }
    .locations-table { width: 100%; min-width: 820px; border-collapse: collapse; }
    body.idp-workspace-page .locations-table th {
      padding: 11px 14px;
      background: var(--panel-solid);
      color: var(--muted);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0;
      text-align: left;
      text-transform: none;
    }
    .locations-table td { padding: 14px; border-top: 1px solid var(--border); vertical-align: middle; }
    .location-name { color: var(--text); font-size: 13px; font-weight: 650; }
    .location-code { margin-top: 3px; color: var(--muted); font-size: 11px; }
    .location-address { color: var(--text-secondary); font-size: 12px; }
    .location-actions { display: flex; justify-content: flex-end; gap: 6px; }
    .location-head-office {
      display: inline-block;
      margin-left: 7px;
      padding: 1px 5px;
      border: 1px solid var(--border);
      border-radius: 5px;
      color: var(--muted);
      font-size: 9px;
      font-weight: 600;
    }
    .branch-form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .branch-form-grid .form-group { margin: 0; }
    .branch-form-wide { grid-column: 1 / -1; }
    .branch-head-office-field {
      display: flex;
      align-items: center;
      gap: 8px;
      min-height: 40px;
      color: var(--text-secondary);
      font-size: 13px;
    }
    .branch-head-office-field input { width: auto; margin: 0; }
    .branch-head-office-field span { display: grid; gap: 2px; }
    .branch-head-office-field small { color: var(--muted); font-size: 12px; font-weight: 400; }
    .member-record {
      display: block;
      padding: 0;
      overflow: hidden;
    }
    .member-record__summary {
      display: grid;
      grid-template-columns: minmax(220px, 1.2fr) minmax(150px, .7fr) minmax(190px, 1fr) minmax(130px, .65fr) 76px;
      gap: 18px;
      align-items: center;
      min-height: 70px;
      padding: 12px 18px;
      cursor: pointer;
      list-style: none;
    }
    .member-record__summary::-webkit-details-marker { display: none; }
    .member-record__summary:hover { background: var(--hover-bg); }
    .member-record__identity { min-width: 0; }
    .member-record__identity .member-name { margin: 0; font-size: 14px; }
    .member-record__identity .member-email { margin-top: 2px; font-size: 12px; }
    .member-record__summary-value {
      overflow: hidden;
      margin-top: 2px;
      color: var(--text-secondary);
      font-size: 12px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .member-record__structure strong {
      display: block;
      overflow: hidden;
      color: var(--text-secondary);
      font-size: 12px;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .member-record__structure span {
      display: block;
      overflow: hidden;
      margin-top: 3px;
      color: var(--muted);
      font-size: 11px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .member-record__role-select { width: 100%; min-width: 0; height: 36px; font-size: 12px; }
    .member-record__manage {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      color: var(--text-secondary);
      font-size: 12px;
    }
    .member-record__chevron {
      width: 18px;
      height: 18px;
      color: var(--muted);
      transition: transform 150ms ease;
    }
    .member-record[open] .member-record__chevron { transform: rotate(90deg); }
    .member-record__body {
      padding: 16px 18px 18px;
      border-top: 1px solid var(--border);
      background: color-mix(in srgb, var(--panel-solid) 75%, var(--bg));
    }
    .member-record__body-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 14px;
    }
    .member-record__body-header strong { font-size: 13px; }
    .member-record__body-header .member-meta { margin: 0; }
    .member-record__body .member-fields { grid-template-columns: repeat(3, minmax(180px, 1fr)); margin-top: 0; }

    /* Solid, scalable management dialogs. This selector intentionally outranks main.css. */
    body.idp-workspace-page .modal .modal-content {
      background: var(--panel-solid);
      backdrop-filter: none;
    }
    body.idp-workspace-page #membersModal {
      padding: 16px;
      background: rgba(0, 0, 0, 0.82);
    }
    body.idp-workspace-page #membersModal .team-members-dialog {
      display: flex;
      flex-direction: column;
      width: min(940px, 100%);
      height: min(720px, calc(100vh - 32px));
      max-height: calc(100vh - 32px);
      padding: 0;
      overflow: hidden;
      border-radius: 10px;
      background: var(--panel-solid);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
    }
    #membersModal .modal-header {
      flex: 0 0 auto;
      min-height: 68px;
      margin: 0;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      background: var(--panel-solid);
    }
    #membersModal .modal-header h2 {
      margin: 0;
      font-size: 20px;
      letter-spacing: -0.02em;
    }
    #membersModal .modal-close {
      display: grid;
      width: 34px;
      height: 34px;
      padding: 0;
      place-items: center;
      border-radius: 7px;
      font-size: 22px;
      line-height: 1;
    }
    #membersModal .modal-close:hover { background: var(--hover-bg); color: var(--text); }
    #membersModalContent {
      display: flex;
      flex: 1 1 auto;
      min-height: 0;
    }
    .team-members-shell {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      min-height: 0;
      width: 100%;
      background: var(--panel-solid);
    }
    .team-members-summary {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 44px;
      padding: 10px 20px;
      border-bottom: 1px solid var(--border);
      color: var(--muted);
      font-size: 12px;
    }
    .team-members-summary strong { color: var(--text-secondary); font-weight: 600; }
    .team-members-toolbar {
      display: grid;
      flex: 0 0 auto;
      grid-template-columns: minmax(220px, 1fr) auto;
      gap: 10px;
      padding: 12px 20px;
      border-bottom: 1px solid var(--border);
      background: var(--panel-solid);
    }
    .team-member-search {
      position: relative;
      min-width: 0;
    }
    .team-member-search svg {
      position: absolute;
      top: 50%;
      left: 11px;
      width: 16px;
      height: 16px;
      color: var(--muted);
      pointer-events: none;
      transform: translateY(-50%);
    }
    .team-member-search input {
      width: 100%;
      height: 38px;
      padding: 0 12px 0 36px;
      border-radius: 7px;
      background: var(--bg);
      font-size: 13px;
    }
    .team-member-search input:focus {
      border-color: var(--brand);
      outline: 2px solid color-mix(in srgb, var(--brand) 28%, transparent);
      outline-offset: 0;
    }
    .team-member-add-toggle { min-height: 38px; }
    .team-member-add-panel {
      flex: 0 0 auto;
      padding: 12px 20px;
      border-bottom: 1px solid var(--border);
      background: var(--panel-strong);
    }
    .team-member-add-panel[hidden] { display: none; }
    .team-member-add-form {
      display: grid;
      grid-template-columns: minmax(240px, 1fr) minmax(190px, 240px) auto;
      gap: 10px;
      align-items: end;
    }
    .team-member-add-form .form-group { margin: 0; }
    .team-member-add-form label {
      display: block;
      margin-bottom: 5px;
      color: var(--muted);
      font-size: 11px;
    }
    .team-member-add-form select { height: 38px; }
    .team-members-table-wrap {
      flex: 1 1 auto;
      min-height: 0;
      overflow: auto;
      scrollbar-gutter: stable;
    }
    .team-members-table {
      width: 100%;
      min-width: 680px;
      border-collapse: collapse;
    }
    body.idp-workspace-page .team-members-table th {
      position: sticky;
      top: 0;
      z-index: 1;
      padding: 10px 20px;
      border-bottom: 1px solid var(--border);
      background: var(--panel-solid);
      color: var(--muted);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0;
      text-align: left;
      text-transform: none;
    }
    .team-members-table th:nth-child(2) { width: 250px; }
    .team-members-table th:last-child { width: 100px; text-align: right; }
    .team-members-table td {
      padding: 12px 20px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }
    .team-members-table tbody tr:hover { background: var(--hover-bg); }
    .team-member-name {
      color: var(--text);
      font-size: 13px;
      font-weight: 650;
    }
    .team-member-email {
      margin-top: 3px;
      color: var(--muted);
      font-size: 12px;
    }
    .team-member-id { color: var(--muted); font-weight: 500; }
    .team-member-role-select {
      width: 100%;
      height: 36px;
      font-size: 12px;
    }
    .team-member-action { text-align: right; }
    .team-members-empty {
      padding: 48px 20px;
      color: var(--muted);
      font-size: 13px;
      text-align: center;
    }
    .team-members-empty[hidden] { display: none; }
    @media (max-width: 900px) {
      .structure-layout { grid-template-columns: 220px minmax(0, 1fr); }
      .department-facts { grid-template-columns: 1fr; }
      .department-fact + .department-fact { border-left: 0; border-top: 1px solid var(--border); }
      .team-row { grid-template-columns: 1fr; gap: 10px; }
      .team-row__actions { justify-content: flex-start; }
      .member-directory-toolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .member-list-header,
      .member-record__summary { grid-template-columns: minmax(200px, 1.2fr) minmax(140px, .7fr) minmax(170px, 1fr) 76px; }
      .member-list-header__location,
      .member-record__location { display: none; }
      .member-record__body .member-fields { grid-template-columns: repeat(2, minmax(170px, 1fr)); }
    }
    @media (max-width: 680px) {
      .structure-layout { display: block; }
      .department-browser { border-right: 0; border-bottom: 1px solid var(--border); }
      .department-list { display: flex; overflow-x: auto; }
      .department-list__item { min-width: 150px; }
      .department-detail { padding: 18px; }
      .department-detail__header { display: block; }
      .department-detail__actions { margin-top: 16px; }
      .team-row__leaders { grid-template-columns: 1fr; gap: 8px; }
      .member-list-header { display: none; }
      .member-record__summary { grid-template-columns: minmax(0, 1fr) 124px 68px; gap: 10px; }
      .member-record__structure { display: none; }
      .member-record__manage { font-size: 0; }
      .member-record__manage .member-record__chevron { width: 18px; }
      .member-record__body-header { display: block; }
      .member-record__body-header .member-meta { margin-top: 8px; }
      .member-record__body .member-fields { grid-template-columns: 1fr; }
      .member-directory-toolbar { grid-template-columns: 1fr; }
      .member-directory-status span:last-child { display: none; }
      .locations-header { display: block; }
      .locations-header .btn { margin-top: 14px; }
      .branch-form-grid { grid-template-columns: 1fr; }
      .branch-form-wide { grid-column: auto; }
      body.idp-workspace-page #membersModal { padding: 0; }
      body.idp-workspace-page #membersModal .team-members-dialog {
        width: 100%;
        height: 100%;
        max-height: 100%;
        border: 0;
        border-radius: 0;
      }
      .team-members-toolbar { grid-template-columns: 1fr auto; padding: 10px 14px; }
      .team-members-summary { padding-inline: 14px; }
      .team-member-add-panel { padding: 12px 14px; }
      .team-member-add-form { grid-template-columns: 1fr; }
      #membersModal .modal-header { padding-inline: 14px; }
    }
  </style>
  <link rel="stylesheet" href="/css/main.css?v=4">
  <script src="/js/theme.js?v=3"></script>
</head>
<body class="idp-workspace-page">
  <%- include('partials/nav', { activePage: 'organizations' }) %>

  <div class="container">
    <a href="/organizations" class="back-link">← Back to Organizations</a>

    <div class="header">
      <div>
        <h1>People & Structure</h1>
        <div class="header-subtitle"><%= organization.name %> · Departments, teams, members, and role access</div>
      </div>
      <div class="header-actions">
        <% if (['owner', 'admin', 'hr_manager'].includes(yourRole)) { %>
          <a href="/organizations/<%= organization._id %>/invitations" class="btn btn-primary">+ Invite Member</a>
        <% } %>
        <% if (['owner', 'admin'].includes(yourRole)) { %>
          <button type="button" class="btn btn-secondary" onclick="sendProfileReminders(this)">Send Profile Reminders</button>
          <a href="/organizations/<%= organization._id %>/notifications" class="btn btn-secondary">Send Notification</a>
        <% } %>
      </div>
    </div>

    <%- include('partials/organization-tabs', { organization, yourRole, activeSection: activeView }) %>

    <section data-organization-panel="structure" <%= activeView === 'structure' ? '' : 'hidden' %>>
      <% if (departments && departments.length > 0) { %>
        <div class="structure-layout">
          <aside class="department-browser" aria-label="Departments">
            <div class="department-browser__header">
              <h2>Departments</h2>
              <% if (canManageTeams) { %>
                <button type="button" class="department-create" onclick="showDepartmentModal()">Add</button>
              <% } %>
            </div>
            <div class="department-list" role="tablist" aria-label="Select a department">
              <% departments.forEach((department, index) => { %>
                <% const departmentTeamCount = teams.filter(team => team.department?.id === department.id).length; %>
                <button
                  type="button"
                  class="department-list__item<%= index === 0 ? ' active' : '' %>"
                  role="tab"
                  aria-selected="<%= index === 0 ? 'true' : 'false' %>"
                  aria-controls="department-<%= department.id %>"
                  data-department-tab="<%= department.id %>"
                  onclick="selectDepartment('<%= department.id %>', true)"
                >
                  <span class="department-list__name"><%= department.name %></span>
                  <span class="department-list__meta"><%= departmentTeamCount %> team<%= departmentTeamCount === 1 ? '' : 's' %></span>
                </button>
              <% }) %>
            </div>
          </aside>

          <div>
            <% departments.forEach((department, index) => { %>
              <% const departmentTeams = teams.filter(team => team.department?.id === department.id); %>
              <% const departmentMemberCount = members.filter(member => member.departmentId === department.id).length; %>
              <% const parentDepartment = departments.find(item => item.id === department.parentDepartment); %>
              <section
                class="department-detail"
                id="department-<%= department.id %>"
                data-department-panel="<%= department.id %>"
                role="tabpanel"
                <%= index === 0 ? '' : 'hidden' %>
              >
                <header class="department-detail__header">
                  <div>
                    <h2><%= department.name %></h2>
                    <p class="department-detail__description"><%= department.description || 'Manage this department, its leadership, and the teams within it.' %></p>
                  </div>
                  <% if (canManageTeams) { %>
                    <div class="department-detail__actions">
                      <button type="button" class="btn btn-secondary btn-sm" onclick='editDepartment(<%- JSON.stringify(department) %>)'>Edit department</button>
                      <button type="button" class="btn btn-primary btn-sm" onclick="showCreateModal('<%= department.id %>')">Create team</button>
                    </div>
                  <% } %>
                </header>

                <div class="department-facts">
                  <div class="department-fact">
                    <div class="department-fact__label">Department head</div>
                    <div class="department-fact__value"><%= department.headName || 'Not assigned' %></div>
                  </div>
                  <div class="department-fact">
                    <div class="department-fact__label">Reports into</div>
                    <div class="department-fact__value"><%= parentDepartment?.name || 'Organization' %></div>
                  </div>
                  <div class="department-fact">
                    <div class="department-fact__label">People</div>
                    <div class="department-fact__value"><%= departmentMemberCount %> member<%= departmentMemberCount === 1 ? '' : 's' %></div>
                  </div>
                </div>

                <div class="department-teams">
                  <div class="department-teams__header">
                    <h3>Teams</h3>
                    <span><%= departmentTeams.length %> in this department</span>
                  </div>
                  <% if (departmentTeams.length > 0) { %>
                    <% departmentTeams.forEach(team => { %>
                      <% const teamLead = (team.members || []).find(teamMember => teamMember.role === 'team_lead'); %>
                      <article class="team-row" data-team-id="<%= team.id %>">
                        <div>
                          <div class="team-row__name"><%= team.name %></div>
                          <div class="team-row__path"><%= department.name %><%= team.parentTeam?.name ? ` / ${team.parentTeam.name}` : '' %> · <span id="team-member-count-<%= team.id %>"><%= team.memberCount || 0 %> member<%= team.memberCount === 1 ? '' : 's' %></span></div>
                        </div>
                        <div class="team-row__leaders">
                          <div>
                            <div class="team-row__leader-label">Team lead</div>
                            <div class="team-row__leader-value"><%= teamLead?.name || teamLead?.email || 'Not assigned' %></div>
                          </div>
                          <div>
                            <div class="team-row__leader-label">Line manager</div>
                            <div class="team-row__leader-value" id="team-manager-<%= team.id %>"><%= team.manager?.name || team.manager?.email || 'Not assigned' %></div>
                          </div>
                        </div>
                        <div class="team-row__actions">
                          <button type="button" class="btn btn-secondary btn-sm" onclick="manageMembers('<%= team.id %>', <%= JSON.stringify(team.name) %>)">Members</button>
                          <% if (canManageTeams) { %>
                            <button type="button" class="btn btn-secondary btn-sm" onclick='editTeam(<%- JSON.stringify(team) %>)'>Edit</button>
                            <button type="button" class="btn btn-danger btn-sm" onclick="deleteTeam('<%= team.id %>', <%= JSON.stringify(team.name) %>)">Delete</button>
                          <% } %>
                        </div>
                      </article>
                    <% }) %>
                  <% } else { %>
                    <div class="structure-empty">No teams in this department yet.<% if (canManageTeams) { %> Create the first team here to start assigning members.<% } %></div>
                  <% } %>
                </div>
              </section>
            <% }) %>
          </div>
        </div>
      <% } else { %>
        <div class="card empty-state">
          <h2>No departments yet</h2>
          <p>Create a department first, then add teams and assign people within it.</p>
          <% if (canManageTeams) { %><button type="button" class="btn btn-primary" onclick="showDepartmentModal()">Create department</button><% } %>
        </div>
      <% } %>
    </section>

    <section data-organization-panel="branches" <%= activeView === 'branches' ? '' : 'hidden' %>>
      <div class="locations-header">
        <div>
          <h2>Locations</h2>
          <p>Manage the branches and offices where members of this organization work.</p>
        </div>
        <% if (canManageMemberMetadata) { %>
          <button type="button" class="btn btn-primary" onclick="showBranchModal()">+ Add location</button>
        <% } %>
      </div>

      <% if (branches.length > 0) { %>
        <div class="locations-table-wrap">
          <table class="locations-table">
            <thead>
              <tr>
                <th scope="col">Branch</th>
                <th scope="col">Location</th>
                <th scope="col">Manager</th>
                <th scope="col">Members</th>
                <% if (canManageMemberMetadata) { %><th scope="col"><span class="sr-only">Actions</span></th><% } %>
              </tr>
            </thead>
            <tbody>
              <% branches.forEach(branch => { %>
                <% const locationParts = [branch.address, branch.city, branch.state, branch.country].filter(Boolean); %>
                <tr>
                  <td>
                    <div class="location-name">
                      <%= branch.name %>
                      <% if (branch.isHeadOffice) { %><span class="location-head-office">Head office</span><% } %>
                    </div>
                    <% if (branch.code) { %><div class="location-code"><%= branch.code %></div><% } %>
                  </td>
                  <td class="location-address"><%= locationParts.join(', ') || 'Location not set' %></td>
                  <td class="location-address"><%= branch.managerName || 'Not assigned' %></td>
                  <td class="location-address"><%= branch.memberCount %> member<%= branch.memberCount === 1 ? '' : 's' %></td>
                  <% if (canManageMemberMetadata) { %>
                    <td>
                      <div class="location-actions">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="editBranchById('<%= branch.id %>')">Edit</button>
                        <button type="button" class="btn btn-danger btn-sm" onclick="deleteBranch('<%= branch.id %>')">Delete</button>
                      </div>
                    </td>
                  <% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="card empty-state">
          <h2>No locations yet</h2>
          <p>Add a branch or office, then assign organization members to it from the Members tab.</p>
          <% if (canManageMemberMetadata) { %><button type="button" class="btn btn-primary" onclick="showBranchModal()">Add first location</button><% } %>
        </div>
      <% } %>
    </section>

    <section class="members-section" data-organization-panel="members" <%= activeView === 'members' ? '' : 'hidden' %>>
      <div class="members-section__heading">
        <div>
          <h2>Members & roles</h2>
          <p>Find people, manage organization roles, and control the profile and application access attached to each member.</p>
        </div>
      </div>

    <div class="members-overview" aria-label="Member directory summary">
      <span class="members-overview__item"><strong><%= members.length %></strong> people</span>
      <span class="members-overview__item"><strong><%= departments.length %></strong> departments</span>
      <span class="members-overview__item"><strong><%= branches.length %></strong> locations</span>
      <span class="members-overview__item">Your organization role: <strong><%= yourRole.replace('_', ' ') %></strong></span>
    </div>

    <div class="role-management-note">
      <strong>Organization roles control administrative access.</strong> Department placement comes from team membership; team leadership is managed inside Structure.
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <div class="member-directory-toolbar">
      <div class="member-filter-field">
        <label for="memberSearch">Search members</label>
        <input id="memberSearch" type="search" class="role-select" placeholder="Name, email, employee ID, designation">
      </div>
      <div class="member-filter-field">
        <label for="departmentFilter">Department</label>
        <select id="departmentFilter" class="role-select">
          <option value="all">All departments</option>
          <option value="unassigned">Unassigned</option>
          <% departments.forEach(department => { %>
            <option value="<%= department.id %>"><%= department.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="member-filter-field">
        <label for="teamFilter">Team</label>
        <select id="teamFilter" class="role-select">
          <option value="all">All teams</option>
          <% departments.forEach(department => { %>
            <% const departmentTeams = teams.filter(team => team.department?.id === department.id); %>
            <% if (departmentTeams.length > 0) { %>
              <optgroup label="<%= department.name %>">
                <% departmentTeams.forEach(team => { %>
                  <option value="<%= team.id %>" data-department-id="<%= department.id %>"><%= team.name %></option>
                <% }) %>
              </optgroup>
            <% } %>
          <% }) %>
        </select>
      </div>
      <div class="member-filter-field">
        <label for="branchFilter">Location</label>
        <select id="branchFilter" class="role-select">
          <option value="all">All locations</option>
          <option value="unassigned">Unassigned</option>
          <% branches.forEach(branch => { %>
            <option value="<%= branch.id %>"><%= branch.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="member-filter-field">
        <label for="roleFilter">Organization role</label>
        <select id="roleFilter" class="role-select">
          <option value="all">All roles</option>
          <option value="owner">Owner</option>
          <option value="admin">Admin</option>
          <option value="hr_manager">HR Manager</option>
          <option value="recruiter">Recruiter</option>
          <option value="interviewer">Interviewer</option>
          <option value="staff">Staff</option>
        </select>
      </div>
    </div>

    <div class="member-directory-status" aria-live="polite">
      <span id="memberDirectoryCount"><%= members.length %> member<%= members.length === 1 ? '' : 's' %></span>
      <span>Teams are grouped by department</span>
    </div>

    <div class="member-list-header" aria-hidden="true">
      <span>Member</span>
      <span>Organization role</span>
      <span>Department / team</span>
      <span class="member-list-header__location">Location</span>
      <span></span>
    </div>

    <div class="member-grid">
      <% members.forEach(member => { %>
        <details
          class="card member-card member-record"
          data-member-id="<%= member.id %>"
          data-member-name="<%= (member.name || '').toLowerCase() %>"
          data-member-email="<%= (member.email || '').toLowerCase() %>"
          data-member-employee-id="<%= (member.employeeId || '').toLowerCase() %>"
          data-member-designation="<%= (member.designation || '').toLowerCase() %>"
          data-member-department-id="<%= member.departmentId || 'unassigned' %>"
          data-member-team-ids="<%= (member.teamIds || []).join('||') %>"
          data-member-branch-id="<%= member.branchId || 'unassigned' %>"
          data-member-role="<%= member.role %>"
        >
          <summary class="member-record__summary">
            <div class="member-record__identity">
              <div class="member-name">
                <%= member.name || 'No name' %>
                <% if (member.isOwner) { %><span style="color: var(--brand-2); font-size: 12px;">(Primary Owner)</span><% } %>
                <% if (member.id.toString() === user._id.toString()) { %><span style="color: var(--muted); font-size: 12px;">(You)</span><% } %>
              </div>
              <div class="member-email"><%= member.email %></div>
            </div>
            <div class="member-record__role" onclick="event.stopPropagation()">
              <% if (canManageMemberRoles && member.id.toString() !== user._id.toString()) { %>
                <select
                  class="role-select member-record__role-select"
                  data-previous-role="<%= member.role %>"
                  aria-label="Organization role for <%= member.name || member.email %>"
                  onchange="updateRole('<%= member.id %>', this)"
                  <%= member.role === 'owner' && yourRole !== 'owner' ? 'disabled' : '' %>
                >
                  <option value="owner" <%= member.role === 'owner' ? 'selected' : '' %> <%= yourRole !== 'owner' ? 'disabled' : '' %>>Owner</option>
                  <option value="admin" <%= member.role === 'admin' ? 'selected' : '' %>>Admin</option>
                  <option value="hr_manager" <%= member.role === 'hr_manager' ? 'selected' : '' %>>HR Manager</option>
                  <option value="recruiter" <%= member.role === 'recruiter' ? 'selected' : '' %>>Recruiter</option>
                  <option value="interviewer" <%= member.role === 'interviewer' ? 'selected' : '' %>>Interviewer</option>
                  <option value="staff" <%= member.role === 'staff' ? 'selected' : '' %>>Staff</option>
                </select>
              <% } else { %>
                <span class="role-badge role-<%= member.role %>"><%= member.role.replace('_', ' ') %></span>
              <% } %>
            </div>
            <div class="member-record__structure">
              <strong id="member-department-<%= member.id %>"><%= member.departmentName || 'Unassigned' %></strong>
              <span id="member-teams-<%= member.id %>"><%= member.teamNames?.length ? member.teamNames.join(', ') : 'No team' %></span>
            </div>
            <div class="member-record__summary-value member-record__location" id="member-branch-<%= member.id %>"><%= member.branchName || 'Unassigned' %></div>
            <span class="member-record__manage">Manage <svg class="member-record__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          </summary>

          <div class="member-record__body">
            <div class="member-record__body-header">
              <strong>Member details & application access</strong>
              <div class="member-meta">
                <span>Onboarding: <%= member.onboardingStatus.replace('_', ' ') %></span>
                <span>Joined <%= new Date(member.joinedAt).toLocaleDateString() %></span>
              </div>
            </div>

          <div class="member-fields">
            <div>
              <label>Designation</label>
              <% if (canManageMemberMetadata) { %>
                <input
                  type="text"
                  class="role-select"
                  value="<%= member.designation || '' %>"
                  placeholder="Set designation"
                  onchange="updateDesignation('<%= member.id %>', this.value)"
                />
              <% } else { %>
                <div><strong><%= member.designation || 'Not set' %></strong></div>
              <% } %>
            </div>
            <div>
              <label>Employee ID</label>
              <% if (canManageMemberMetadata) { %>
                <input
                  type="text"
                  class="role-select"
                  value="<%= member.employeeId || '' %>"
                  placeholder="Set employee ID"
                  onchange="updateEmployeeId('<%= member.id %>', this.value)"
                />
              <% } else { %>
                <div><strong><%= member.employeeId || 'Not set' %></strong></div>
              <% } %>
            </div>
            <div>
              <label>Location</label>
              <% if (canManageMemberMetadata) { %>
                <select class="role-select" onchange="updateBranchAssignment('<%= member.id %>', this.value)">
                  <option value="" <%= !member.branchId ? 'selected' : '' %>>Unassigned</option>
                  <% branches.forEach(branch => { %>
                    <option value="<%= branch.id %>" <%= member.branchId === branch.id ? 'selected' : '' %>><%= branch.name %></option>
                  <% }) %>
                </select>
              <% } else { %>
                <div><strong><%= member.branchName || 'Unassigned' %></strong></div>
              <% } %>
            </div>
          </div>

          <div class="app-access-box">
            <label style="display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px;">App Access</label>
            <div style="margin-bottom: 8px;">
              <% if (canManageMemberMetadata) { %>
                <select class="role-select" onchange="toggleMemberAppMode('<%= member.id %>', this.value)">
                  <option value="all" <%= member.appAccess?.mode !== 'selected' ? 'selected' : '' %>>All apps</option>
                  <option value="selected" <%= member.appAccess?.mode === 'selected' ? 'selected' : '' %>>Selected apps only</option>
                </select>
              <% } else { %>
                <strong><%= member.appAccessLabel || 'All apps' %></strong>
              <% } %>
            </div>
            <% if (canManageMemberMetadata) { %>
              <div id="member-apps-<%= member.id %>" style="<%= member.appAccess?.mode === 'selected' ? '' : 'display:none;' %>">
                <div class="app-access-grid">
                  <% availableApps.forEach(app => { %>
                    <label class="app-access-item">
                      <input
                        type="checkbox"
                        data-member-app="<%= member.id %>"
                        value="<%= app.appId %>"
                        <%= member.appAccess?.appIds?.includes(app.appId) ? 'checked' : '' %>
                        onchange="saveMemberAppAccess('<%= member.id %>')"
                      >
                      <span><strong><%= app.name %></strong></span>
                    </label>
                  <% }) %>
                </div>
              </div>
            <% } else if (member.appAccessAppNames?.length) { %>
              <div><%= member.appAccessAppNames.join(', ') %></div>
            <% } %>
          </div>

          <% if (canManageMemberRoles && member.id.toString() !== user._id.toString()) { %>
            <div class="member-actions" style="margin-top: 16px;">
              <button class="btn btn-danger btn-sm" onclick="removeMember('<%= member.id %>', '<%= member.email %>')">Remove</button>
            </div>
          <% } %>
          </div>
        </details>
      <% }) %>
    </div>
    <div id="memberDirectoryEmpty" class="member-directory-empty" hidden>No members match these filters.</div>

    <% if (yourRole === 'owner') { %>
      <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line);">
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
          <button class="btn btn-primary" onclick="showTransferModal()">Transfer Ownership</button>
          <% if (ownerCount > 1) { %><button class="btn btn-danger" onclick="leaveOrganization()">Leave Organization</button><% } %>
        </div>
      </div>
    <% } else { %>
      <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line);">
        <button class="btn btn-danger" onclick="leaveOrganization()">Leave Organization</button>
      </div>
    <% } %>
    </section>
  </div>

  <div class="modal" id="transferModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Transfer Ownership</h2>
        <button class="modal-close" onclick="hideTransferModal()">&times;</button>
      </div>
      <p style="color: var(--muted); margin-bottom: 16px;">Select a member to transfer ownership to. You will become an admin after transfer.</p>
      <div class="form-group">
        <label for="newOwner">New Owner</label>
        <select id="newOwner">
          <% members.filter(m => m.role !== 'owner').forEach(member => { %>
            <option value="<%= member.id %>"><%= member.name || member.email %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-actions">
        <button class="btn btn-secondary" onclick="hideTransferModal()">Cancel</button>
        <button class="btn btn-primary" onclick="confirmTransfer()">Transfer Ownership</button>
      </div>
    </div>
  </div>

  <div class="modal" id="departmentModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="departmentModalTitle">Create Department</h2>
        <button class="modal-close" onclick="hideDepartmentModal()">&times;</button>
      </div>
      <form id="departmentForm">
        <input type="hidden" id="departmentId">
        <div class="form-group">
          <label for="departmentName">Department Name *</label>
          <input type="text" id="departmentName" required maxlength="120">
        </div>
        <div class="form-group">
          <label for="departmentDescription">Description</label>
          <textarea id="departmentDescription" maxlength="500"></textarea>
        </div>
        <div class="form-group">
          <label for="parentDepartment">Parent Department</label>
          <select id="parentDepartment"></select>
        </div>
        <div class="form-group">
          <label for="departmentHead">Head of Department</label>
          <select id="departmentHead"></select>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-secondary" onclick="hideDepartmentModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Department</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal" id="branchModal">
    <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="branchModalTitle">
      <div class="modal-header">
        <div>
          <h2 id="branchModalTitle">Add location</h2>
          <p style="margin: 5px 0 0; color: var(--muted); font-size: 13px;">Create a branch, office, or operating location.</p>
        </div>
        <button class="modal-close" type="button" onclick="hideBranchModal()" aria-label="Close location form">&times;</button>
      </div>
      <form id="branchForm">
        <input type="hidden" id="branchId">
        <div class="branch-form-grid">
          <div class="form-group">
            <label for="branchName">Location name *</label>
            <input type="text" id="branchName" required maxlength="120" placeholder="Lagos office">
          </div>
          <div class="form-group">
            <label for="branchCode">Code</label>
            <input type="text" id="branchCode" maxlength="30" placeholder="LOS">
          </div>
          <div class="form-group branch-form-wide">
            <label for="branchAddress">Street address</label>
            <input type="text" id="branchAddress" maxlength="240" autocomplete="street-address">
          </div>
          <div class="form-group">
            <label for="branchCity">City</label>
            <input type="text" id="branchCity" maxlength="100" autocomplete="address-level2">
          </div>
          <div class="form-group">
            <label for="branchState">State / region</label>
            <input type="text" id="branchState" maxlength="100" autocomplete="address-level1">
          </div>
          <div class="form-group">
            <label for="branchCountry">Country</label>
            <input type="text" id="branchCountry" maxlength="100" autocomplete="country-name">
          </div>
          <div class="form-group">
            <label for="branchManager">Location manager</label>
            <select id="branchManager">
              <option value="">Not assigned</option>
              <% orgMembers.forEach(member => { %>
                <option value="<%= member.id %>"><%= member.name || member.email %></option>
              <% }) %>
            </select>
          </div>
          <label class="branch-head-office-field branch-form-wide">
            <input type="checkbox" id="branchIsHeadOffice">
            <span><strong>Head office</strong><small>Mark this as the organization’s primary location.</small></span>
          </label>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-secondary" onclick="hideBranchModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Save location</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal" id="createModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Create Team</h2>
        <button class="modal-close" onclick="hideCreateModal()">&times;</button>
      </div>
      <form id="createForm">
        <div class="form-group">
          <label for="teamName">Team Name *</label>
          <input type="text" id="teamName" required maxlength="100">
        </div>
        <div class="form-group">
          <label for="teamDescription">Description</label>
          <textarea id="teamDescription" maxlength="500"></textarea>
        </div>
        <div class="form-group">
          <label for="teamDepartment">Department *</label>
          <select id="teamDepartment" required onchange="syncParentTeamOptions('teamDepartment', 'parentTeam', '')"></select>
        </div>
        <div class="form-group">
          <label for="parentTeam">Parent Team (optional)</label>
          <select id="parentTeam"></select>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-secondary" onclick="hideCreateModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Team</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal" id="editModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Edit Team</h2>
        <button class="modal-close" onclick="hideEditModal()">&times;</button>
      </div>
      <form id="editForm">
        <input type="hidden" id="editTeamId">
        <div class="form-group">
          <label for="editTeamName">Team Name *</label>
          <input type="text" id="editTeamName" required maxlength="100">
        </div>
        <div class="form-group">
          <label for="editTeamDescription">Description</label>
          <textarea id="editTeamDescription" maxlength="500"></textarea>
        </div>
        <div class="form-group">
          <label for="editTeamDepartment">Department *</label>
          <select id="editTeamDepartment" required onchange="syncParentTeamOptions('editTeamDepartment', 'editParentTeam', document.getElementById('editTeamId').value)"></select>
        </div>
        <div class="form-group">
          <label for="editParentTeam">Parent Team (optional)</label>
          <select id="editParentTeam"></select>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-secondary" onclick="hideEditModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal" id="membersModal">
    <div class="modal-content team-members-dialog" role="dialog" aria-modal="true" aria-labelledby="membersModalTitle">
      <div class="modal-header">
        <h2 id="membersModalTitle">Team Members</h2>
        <button class="modal-close" onclick="hideMembersModal()" aria-label="Close team members">&times;</button>
      </div>
      <div id="membersModalContent"></div>
    </div>
  </div>

  <script>
    const orgId = '<%= organization._id %>';
    const memberCards = Array.from(document.querySelectorAll('.member-card'));
    const departments = <%- JSON.stringify(departments || []) %>;
    const orgMembers = <%- JSON.stringify(orgMembers || []) %>;
    const teams = <%- JSON.stringify(teams || []) %>;
    const branches = <%- JSON.stringify(branches || []) %>;
    let activeMembersTeamId = '';

    function selectDepartment(departmentId, updateHistory = false) {
      const normalizedId = normalizeId(departmentId);
      const tabs = Array.from(document.querySelectorAll('[data-department-tab]'));
      const panels = Array.from(document.querySelectorAll('[data-department-panel]'));
      if (!tabs.some(tab => tab.dataset.departmentTab === normalizedId)) return;

      tabs.forEach((tab) => {
        const isActive = tab.dataset.departmentTab === normalizedId;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.tabIndex = isActive ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.departmentPanel !== normalizedId;
      });

      if (updateHistory) {
        const url = new URL(window.location.href);
        url.searchParams.set('view', 'structure');
        url.searchParams.set('department', normalizedId);
        window.history.pushState({ departmentId: normalizedId }, '', url);
      }
    }

    function selectDepartmentFromLocation() {
      const requestedId = new URLSearchParams(window.location.search).get('department');
      const fallbackId = document.querySelector('[data-department-tab]')?.dataset.departmentTab;
      if (requestedId || fallbackId) selectDepartment(requestedId || fallbackId, false);
    }

    function normalizeId(value) {
      return value == null ? '' : String(value);
    }

    function normalizeTeam(team) {
      if (!team) return null;
      return {
        ...team,
        id: normalizeId(team.id),
        department: team.department ? {
          ...team.department,
          id: normalizeId(team.department.id)
        } : null,
        parentTeam: team.parentTeam ? {
          ...team.parentTeam,
          id: normalizeId(team.parentTeam.id)
        } : null,
        manager: team.manager ? {
          ...team.manager,
          id: normalizeId(team.manager.id)
        } : null,
        members: Array.isArray(team.members) ? team.members.map((member) => ({
          ...member,
          id: normalizeId(member.id)
        })) : [],
        memberCount: Number(team.memberCount || (team.members || []).length || 0)
      };
    }

    function getTeamById(teamId) {
      return teams.find((team) => normalizeId(team.id) === normalizeId(teamId)) || null;
    }

    function getOrgMemberById(memberId) {
      return orgMembers.find((member) => normalizeId(member.id) === normalizeId(memberId)) || null;
    }

    function getMemberTeamAssignments(memberId) {
      const normalizedMemberId = normalizeId(memberId);
      return teams.filter((team) => (team.members || []).some((member) => normalizeId(member.id) === normalizedMemberId));
    }

    function deriveTeamManager(team) {
      const lineManager = (team.members || []).find((member) => member.role === 'line_manager');
      if (!lineManager) return null;

      return {
        id: normalizeId(lineManager.id),
        email: lineManager.email || '',
        name: lineManager.name || ''
      };
    }

    function upsertTeamState(teamData) {
      const normalizedTeam = normalizeTeam(teamData);
      if (!normalizedTeam) return null;

      const existingIndex = teams.findIndex((team) => normalizeId(team.id) === normalizedTeam.id);
      if (existingIndex === -1) {
        teams.push(normalizedTeam);
      } else {
        teams.splice(existingIndex, 1, {
          ...teams[existingIndex],
          ...normalizedTeam
        });
      }

      return getTeamById(normalizedTeam.id);
    }

    function syncTeamCard(teamId) {
      const team = getTeamById(teamId);
      if (!team) return null;

      team.manager = deriveTeamManager(team);
      team.memberCount = (team.members || []).length;

      const managerEl = document.getElementById(`team-manager-${team.id}`);
      if (managerEl) {
        managerEl.textContent = team.manager?.name || team.manager?.email || 'Not assigned';
      }

      const memberCountEl = document.getElementById(`team-member-count-${team.id}`);
      if (memberCountEl) {
        const memberCount = team.memberCount || 0;
        memberCountEl.textContent = `${memberCount} member${memberCount === 1 ? '' : 's'}`;
      }

      return team;
    }

    function syncMemberCard(memberId) {
      const member = getOrgMemberById(memberId);
      if (!member) return;

      const memberTeams = getMemberTeamAssignments(memberId);
      const primaryDepartment = memberTeams[0]?.department || null;

      member.teamNames = memberTeams.map((team) => team.name);
      member.teamIds = memberTeams.map((team) => team.id);
      member.departmentId = primaryDepartment?.id || '';
      member.departmentName = primaryDepartment?.name || '';

      const memberCard = memberCards.find((card) => normalizeId(card.dataset.memberId) === normalizeId(memberId));
      if (memberCard) {
        memberCard.dataset.memberEmployeeId = (member.employeeId || '').toLowerCase();
        memberCard.dataset.memberDesignation = (member.designation || '').toLowerCase();
        memberCard.dataset.memberDepartmentId = member.departmentId || 'unassigned';
        memberCard.dataset.memberTeamIds = (member.teamIds || []).join('||');
        memberCard.dataset.memberBranchId = member.branchId || 'unassigned';
      }

      const teamsEl = document.getElementById(`member-teams-${normalizeId(memberId)}`);
      if (teamsEl) {
        teamsEl.textContent = member.teamNames?.length ? member.teamNames.join(', ') : 'No team';
      }

      const departmentEl = document.getElementById(`member-department-${normalizeId(memberId)}`);
      if (departmentEl) {
        departmentEl.textContent = member.departmentName || 'Unassigned';
      }
    }

    function syncMemberState(memberId) {
      syncMemberCard(memberId);
      applyMemberFilters();
    }

    async function refreshTeamState(teamId) {
      const response = await fetch(`/api/teams/${teamId}`);
      if (!response.ok) {
        const data = await response.json().catch(() => ({}));
        throw new Error(data.error || 'Failed to load team');
      }

      const team = upsertTeamState(await response.json());
      return syncTeamCard(team?.id || teamId);
    }

    function renderMembersModal(team) {
      const currentTeam = upsertTeamState(team);
      if (!currentTeam) return;

      activeMembersTeamId = currentTeam.id;
      document.getElementById('membersModalTitle').textContent = `Team Members - ${currentTeam.name}`;
      document.getElementById('membersModal').classList.add('active');

      const availableMembers = orgMembers.filter((member) => {
        if ((currentTeam.members || []).some((current) => normalizeId(current.id) === normalizeId(member.id))) return false;
        return !member.departmentId || normalizeId(member.departmentId) === normalizeId(currentTeam.department?.id);
      });
      const teamMembers = currentTeam.members || [];

      document.getElementById('membersModalContent').innerHTML = `
        <div class="team-members-shell">
          <div class="team-members-summary">
            <span>Department: <strong>${escapeHtml(currentTeam.department?.name || 'General')}</strong></span>
            <span id="teamMembersResultCount">${teamMembers.length} ${teamMembers.length === 1 ? 'member' : 'members'}</span>
          </div>

          <div class="team-members-toolbar">
            <label class="team-member-search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
              <input type="search" placeholder="Search by name, email, or employee ID" aria-label="Search team members" oninput="filterTeamMemberRows(this.value)">
            </label>
            <button id="teamMemberAddToggle" class="btn btn-primary team-member-add-toggle" type="button" aria-expanded="false" onclick="toggleTeamMemberAddPanel()">+ Add member</button>
          </div>

          <div id="teamMemberAddPanel" class="team-member-add-panel" hidden>
            <form class="team-member-add-form" onsubmit="event.preventDefault(); addMemberToTeam('${currentTeam.id}');">
              <div class="form-group">
                <label for="newMemberId">Organization member</label>
                <select id="newMemberId" required>
                  <option value="">Choose a member...</option>
                  ${availableMembers.map(member => `<option value="${member.id}">${escapeHtml(member.name || member.email)}${member.employeeId ? ` [${escapeHtml(member.employeeId)}]` : ''} (${escapeHtml(member.departmentName || 'Unassigned')})</option>`).join('')}
                </select>
              </div>
              <div class="form-group">
                <label for="newMemberRole">Team role</label>
                <select id="newMemberRole">
                  <option value="member">Member</option>
                  <option value="line_manager">Line Manager</option>
                  <option value="team_lead">Team Lead</option>
                </select>
              </div>
              <button class="btn btn-primary" type="submit" ${availableMembers.length ? '' : 'disabled'}>Add to team</button>
            </form>
          </div>

          <div class="team-members-table-wrap">
            <table class="team-members-table">
              <thead>
                <tr>
                  <th scope="col">Member</th>
                  <th scope="col">Team role</th>
                  <th scope="col">Action</th>
                </tr>
              </thead>
              <tbody>
                ${teamMembers.map(member => {
                  const memberName = member.name || member.email;
                  const memberSearch = `${memberName} ${member.email || ''} ${member.employeeId || ''}`.toLowerCase();
                  return `
                    <tr data-team-member-row data-search="${escapeHtml(memberSearch)}">
                      <td>
                        <div class="team-member-name">${escapeHtml(memberName)}${member.employeeId ? ` <span class="team-member-id">[${escapeHtml(member.employeeId)}]</span>` : ''}</div>
                        <div class="team-member-email">${escapeHtml(member.email || '')}</div>
                      </td>
                      <td>
                        <select class="team-member-role-select" aria-label="Role for ${escapeHtml(memberName)}" onchange="updateTeamMemberRole('${currentTeam.id}', '${member.id}', this.value)">
                          <option value="member" ${member.role === 'member' ? 'selected' : ''}>Member</option>
                          <option value="line_manager" ${member.role === 'line_manager' ? 'selected' : ''}>Line Manager</option>
                          <option value="team_lead" ${member.role === 'team_lead' ? 'selected' : ''}>Team Lead</option>
                        </select>
                      </td>
                      <td class="team-member-action">
                        <button
                          type="button"
                          class="btn btn-danger btn-sm"
                          data-team-id="${escapeHtml(currentTeam.id)}"
                          data-member-id="${escapeHtml(member.id)}"
                          data-member-name="${escapeHtml(memberName)}"
                          onclick="removeMemberFromTeam(this.dataset.teamId, this.dataset.memberId, this.dataset.memberName)">Remove</button>
                      </td>
                    </tr>
                  `;
                }).join('')}
              </tbody>
            </table>
            <div id="teamMembersEmpty" class="team-members-empty" ${teamMembers.length ? 'hidden' : ''}>${teamMembers.length ? 'No members match your search.' : 'No members are assigned to this team yet.'}</div>
          </div>
        </div>
      `;
    }

    function filterTeamMemberRows(value) {
      const query = String(value || '').trim().toLowerCase();
      const rows = Array.from(document.querySelectorAll('[data-team-member-row]'));
      let visibleCount = 0;

      rows.forEach((row) => {
        const isVisible = !query || (row.dataset.search || '').includes(query);
        row.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      const resultCount = document.getElementById('teamMembersResultCount');
      if (resultCount) {
        resultCount.textContent = query
          ? `${visibleCount} of ${rows.length} members`
          : `${rows.length} ${rows.length === 1 ? 'member' : 'members'}`;
      }

      const emptyState = document.getElementById('teamMembersEmpty');
      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
        emptyState.textContent = rows.length ? 'No members match your search.' : 'No members are assigned to this team yet.';
      }
    }

    function toggleTeamMemberAddPanel() {
      const panel = document.getElementById('teamMemberAddPanel');
      const toggle = document.getElementById('teamMemberAddToggle');
      if (!panel || !toggle) return;

      panel.hidden = !panel.hidden;
      toggle.setAttribute('aria-expanded', panel.hidden ? 'false' : 'true');
      toggle.textContent = panel.hidden ? '+ Add member' : 'Cancel';
      if (!panel.hidden) document.getElementById('newMemberId')?.focus();
    }

    async function refreshMembersModal(teamId, affectedMemberIds = []) {
      const team = await refreshTeamState(teamId);
      affectedMemberIds.forEach((memberId) => syncMemberState(memberId));

      if (normalizeId(activeMembersTeamId) === normalizeId(teamId)) {
        renderMembersModal(team);
      }
    }

    async function updateMember(memberId, payload, errorMessage) {
      try {
        const response = await fetch(`/api/organizations/${orgId}/members/${memberId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const data = await response.json();
          alert(data.error || errorMessage);
          window.location.reload();
          return false;
        }

        const data = await response.json().catch(() => ({}));
        const member = getOrgMemberById(memberId);
        if (member) {
          if (Object.prototype.hasOwnProperty.call(payload, 'designation')) {
            member.designation = String(data.designation ?? payload.designation ?? '').trim();
          }
          if (Object.prototype.hasOwnProperty.call(payload, 'employeeId')) {
            member.employeeId = String(data.employeeId ?? payload.employeeId ?? '').trim();
          }
          if (Object.prototype.hasOwnProperty.call(payload, 'role')) {
            member.role = String(data.newRole ?? payload.role ?? member.role);
            const memberCard = memberCards.find((card) => normalizeId(card.dataset.memberId) === normalizeId(memberId));
            if (memberCard) memberCard.dataset.memberRole = member.role;
          }
          if (Object.prototype.hasOwnProperty.call(payload, 'branch')) {
            const branchId = normalizeId(data.branch ?? payload.branch ?? '');
            const branch = branches.find((candidate) => normalizeId(candidate.id) === branchId);
            member.branchId = branchId;
            member.branchName = branch?.name || '';
            const branchEl = document.getElementById(`member-branch-${normalizeId(memberId)}`);
            if (branchEl) branchEl.textContent = member.branchName || 'Unassigned';
          }
        }

        syncMemberState(memberId);
        return true;
      } catch (error) {
        alert(errorMessage);
        window.location.reload();
        return false;
      }
    }

    async function updateRole(memberId, select) {
      const newRole = select.value;
      const previousRole = select.dataset.previousRole || '';
      const roleLabel = select.options[select.selectedIndex]?.textContent || newRole;
      if (!confirm(`Change this member’s organization role to ${roleLabel}?`)) {
        select.value = previousRole;
        return;
      }
      const updated = await updateMember(memberId, { role: newRole }, 'Failed to update role');
      if (updated) select.dataset.previousRole = newRole;
    }

    async function updateDesignation(memberId, designation) {
      await updateMember(memberId, { designation }, 'Failed to update designation');
    }

    async function updateEmployeeId(memberId, employeeId) {
      await updateMember(memberId, { employeeId }, 'Failed to update employee ID');
    }

    async function updateBranchAssignment(memberId, branchId) {
      await updateMember(memberId, { branch: branchId || null }, 'Failed to update location');
    }

    async function updateAppAccess(memberId, appAccess) {
      await updateMember(memberId, { appAccess }, 'Failed to update app access');
    }

    function toggleMemberAppMode(memberId, mode) {
      const container = document.getElementById(`member-apps-${memberId}`);
      if (container) {
        container.style.display = mode === 'selected' ? '' : 'none';
      }

      if (mode === 'all') {
        updateAppAccess(memberId, { mode: 'all', appIds: [] });
        return;
      }

      saveMemberAppAccess(memberId);
    }

    function saveMemberAppAccess(memberId) {
      const selectedAppIds = Array.from(document.querySelectorAll(`input[data-member-app="${memberId}"]:checked`)).map((input) => input.value);
      if (selectedAppIds.length === 0) {
        alert('Select at least one app when using selected apps access.');
        return;
      }
      updateAppAccess(memberId, { mode: 'selected', appIds: selectedAppIds });
    }

    async function removeMember(memberId, email) {
      if (!confirm(`Remove ${email} from this organization?`)) return;
      try {
        const response = await fetch(`/api/organizations/${orgId}/members/${memberId}`, { method: 'DELETE' });
        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to remove member');
        }
      } catch (error) {
        alert('Failed to remove member');
      }
    }

    async function sendProfileReminders(button) {
      if (!confirm('Send profile reminders to all active members in this organization who still have incomplete profiles?')) return;

      const originalLabel = button ? button.textContent : '';
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }

      try {
        const response = await fetch(`/api/organizations/${orgId}/members/profile-reminders`, {
          method: 'POST'
        });
        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          alert(data.error || 'Failed to send profile reminders');
          return;
        }

        const successMessage = data.message || 'Profile reminders sent';
        window.location.href = `/organizations/${orgId}/members?view=members&success=${encodeURIComponent(successMessage)}`;
      } catch (error) {
        alert('Failed to send profile reminders');
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = originalLabel;
        }
      }
    }

    async function leaveOrganization() {
      if (!confirm('Are you sure you want to leave this organization?')) return;
      try {
        const response = await fetch(`/api/organizations/${orgId}/leave`, { method: 'POST' });
        if (response.ok) {
          window.location.href = '/organizations';
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to leave organization');
        }
      } catch (error) {
        alert('Failed to leave organization');
      }
    }

    function showTransferModal() {
      document.getElementById('transferModal').classList.add('active');
    }

    function hideTransferModal() {
      document.getElementById('transferModal').classList.remove('active');
    }

    async function confirmTransfer() {
      const newOwnerId = document.getElementById('newOwner').value;
      if (!newOwnerId) {
        alert('Please select a new owner');
        return;
      }
      if (!confirm('Are you sure you want to transfer ownership? This cannot be undone.')) return;
      try {
        const response = await fetch(`/api/organizations/${orgId}/transfer-ownership`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newOwnerId })
        });
        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to transfer ownership');
        }
      } catch (error) {
        alert('Failed to transfer ownership');
      }
    }

    function applyMemberFilters() {
      const searchValue = String(document.getElementById('memberSearch').value || '').trim().toLowerCase();
      const departmentValue = String(document.getElementById('departmentFilter').value || 'all');
      const teamValue = String(document.getElementById('teamFilter').value || 'all');
      const branchValue = String(document.getElementById('branchFilter').value || 'all');
      const roleValue = String(document.getElementById('roleFilter').value || 'all');

      let visibleCount = 0;
      memberCards.forEach((card) => {
        const haystack = [
          card.dataset.memberName || '',
          card.dataset.memberEmail || '',
          card.dataset.memberEmployeeId || '',
          card.dataset.memberDesignation || ''
        ].join(' ');

        const departmentId = card.dataset.memberDepartmentId || 'unassigned';
        const teamIds = (card.dataset.memberTeamIds || '').split('||').filter(Boolean);
        const branchId = card.dataset.memberBranchId || 'unassigned';
        const memberRole = card.dataset.memberRole || '';

        const matchesSearch = !searchValue || haystack.includes(searchValue);
        const matchesDepartment = departmentValue === 'all' ||
          (departmentValue === 'unassigned' ? departmentId === 'unassigned' : departmentId === departmentValue);
        const matchesTeam = teamValue === 'all' || teamIds.includes(teamValue);
        const matchesBranch = branchValue === 'all' ||
          (branchValue === 'unassigned' ? branchId === 'unassigned' : branchId === branchValue);
        const matchesRole = roleValue === 'all' || memberRole === roleValue;

        const isVisible = matchesSearch && matchesDepartment && matchesTeam && matchesBranch && matchesRole;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visibleCount += 1;
      });

      const count = document.getElementById('memberDirectoryCount');
      const empty = document.getElementById('memberDirectoryEmpty');
      if (count) count.textContent = `${visibleCount} member${visibleCount === 1 ? '' : 's'}`;
      if (empty) empty.hidden = visibleCount !== 0;
    }

    function syncTeamFilterOptions() {
      const departmentValue = String(document.getElementById('departmentFilter').value || 'all');
      const teamFilter = document.getElementById('teamFilter');

      Array.from(teamFilter.options).forEach((option) => {
        if (option.value === 'all') return;
        const isVisible = departmentValue === 'all' ||
          (departmentValue === 'unassigned'
            ? option.dataset.departmentId === 'unassigned'
            : option.dataset.departmentId === departmentValue);
        option.hidden = !isVisible;
        option.disabled = !isVisible;
      });

      Array.from(teamFilter.querySelectorAll('optgroup')).forEach((group) => {
        group.hidden = Array.from(group.querySelectorAll('option')).every((option) => option.hidden);
      });

      if (teamFilter.selectedOptions[0]?.disabled) teamFilter.value = 'all';
      applyMemberFilters();
    }

    document.getElementById('memberSearch').addEventListener('input', applyMemberFilters);
    document.getElementById('departmentFilter').addEventListener('change', syncTeamFilterOptions);
    document.getElementById('teamFilter').addEventListener('change', applyMemberFilters);
    document.getElementById('branchFilter').addEventListener('change', applyMemberFilters);
    document.getElementById('roleFilter').addEventListener('change', applyMemberFilters);

    function setOptions(selectId, options, placeholder, selectedValue = '') {
      const select = document.getElementById(selectId);
      select.innerHTML = placeholder ? `<option value="">${placeholder}</option>` : '';
      options.forEach(option => {
        const el = document.createElement('option');
        el.value = option.value;
        el.textContent = option.label;
        if (selectedValue && selectedValue === option.value) el.selected = true;
        select.appendChild(el);
      });
    }

    function hydrateDepartmentSelectors() {
      const departmentOptions = departments.map(department => ({ value: department.id, label: department.name }));
      setOptions('teamDepartment', departmentOptions, '');
      setOptions('editTeamDepartment', departmentOptions, '');
      setOptions('parentDepartment', departments.map(department => ({ value: department.id, label: department.name })), 'Root / no parent');
      setOptions('departmentHead', orgMembers.map(member => ({ value: member.id, label: `${member.name || member.email} (${member.departmentName || 'Unassigned'})` })), 'No head assigned');
    }

    function syncParentTeamOptions(departmentSelectId, teamSelectId, currentTeamId) {
      const departmentId = String(document.getElementById(departmentSelectId).value || '');
      const currentId = String(currentTeamId || '');
      const filteredTeams = teams.filter((team) => {
        const teamDepartmentId = String(team?.department?.id || '');
        const teamId = String(team?.id || '');
        return teamDepartmentId === departmentId && teamId !== currentId;
      });
      setOptions(teamSelectId, filteredTeams.map(team => ({ value: team.id, label: team.name })), 'No parent team');
    }

    function showDepartmentModal() {
      document.getElementById('departmentModalTitle').textContent = 'Create Department';
      document.getElementById('departmentForm').reset();
      document.getElementById('departmentId').value = '';
      hydrateDepartmentSelectors();
      document.getElementById('departmentModal').classList.add('active');
    }

    function editDepartment(department) {
      hydrateDepartmentSelectors();
      document.getElementById('departmentModalTitle').textContent = 'Edit Department';
      document.getElementById('departmentId').value = department.id;
      document.getElementById('departmentName').value = department.name || '';
      document.getElementById('departmentDescription').value = department.description || '';
      document.getElementById('parentDepartment').value = department.parentDepartment || '';
      document.getElementById('departmentHead').value = department.headAccount || '';
      document.getElementById('departmentModal').classList.add('active');
    }

    function hideDepartmentModal() {
      document.getElementById('departmentModal').classList.remove('active');
    }

    function showBranchModal() {
      document.getElementById('branchModalTitle').textContent = 'Add location';
      document.getElementById('branchForm').reset();
      document.getElementById('branchId').value = '';
      document.getElementById('branchModal').classList.add('active');
      document.getElementById('branchName').focus();
    }

    function editBranch(branch) {
      document.getElementById('branchModalTitle').textContent = 'Edit location';
      document.getElementById('branchForm').reset();
      document.getElementById('branchId').value = branch.id || '';
      document.getElementById('branchName').value = branch.name || '';
      document.getElementById('branchCode').value = branch.code || '';
      document.getElementById('branchAddress').value = branch.address || '';
      document.getElementById('branchCity').value = branch.city || '';
      document.getElementById('branchState').value = branch.state || '';
      document.getElementById('branchCountry').value = branch.country || '';
      document.getElementById('branchManager').value = branch.managerAccount || '';
      document.getElementById('branchIsHeadOffice').checked = !!branch.isHeadOffice;
      document.getElementById('branchModal').classList.add('active');
      document.getElementById('branchName').focus();
    }

    function editBranchById(branchId) {
      const branch = branches.find((candidate) => normalizeId(candidate.id) === normalizeId(branchId));
      if (branch) editBranch(branch);
    }

    function hideBranchModal() {
      document.getElementById('branchModal').classList.remove('active');
    }

    function showCreateModal(departmentId = '') {
      document.getElementById('createForm').reset();
      hydrateDepartmentSelectors();
      const selectedDepartmentId = departmentId || departments[0]?.id || '';
      if (selectedDepartmentId) document.getElementById('teamDepartment').value = selectedDepartmentId;
      syncParentTeamOptions('teamDepartment', 'parentTeam', '');
      document.getElementById('createModal').classList.add('active');
    }

    function hideCreateModal() {
      document.getElementById('createModal').classList.remove('active');
    }

    function editTeam(team) {
      hydrateDepartmentSelectors();
      document.getElementById('editTeamId').value = team.id;
      document.getElementById('editTeamName').value = team.name || '';
      document.getElementById('editTeamDescription').value = team.description || '';
      document.getElementById('editTeamDepartment').value = team.department?.id || '';
      syncParentTeamOptions('editTeamDepartment', 'editParentTeam', team.id);
      document.getElementById('editParentTeam').value = team.parentTeam?.id || '';
      document.getElementById('editModal').classList.add('active');
    }

    function hideEditModal() {
      document.getElementById('editModal').classList.remove('active');
    }

    async function manageMembers(teamId, teamName) {
      activeMembersTeamId = normalizeId(teamId);
      try {
        const team = await refreshTeamState(teamId);
        renderMembersModal(team);
      } catch (error) {
        activeMembersTeamId = '';
        alert(error.message || `Failed to load ${teamName || 'team'} members`);
      }
    }

    function hideMembersModal() {
      activeMembersTeamId = '';
      document.getElementById('membersModal').classList.remove('active');
    }

    async function addMemberToTeam(teamId) {
      const accountId = document.getElementById('newMemberId').value;
      const role = document.getElementById('newMemberRole').value;
      if (!accountId) return;
      const response = await fetch(`/api/teams/${teamId}/members`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accountId, role })
      });
      if (response.ok) {
        await refreshMembersModal(teamId, [accountId]);
      } else {
        const data = await response.json();
        alert(data.error || 'Failed to add member');
      }
    }

    async function removeMemberFromTeam(teamId, memberId, memberName) {
      if (!confirm(`Remove ${memberName} from this team?`)) return;
      const response = await fetch(`/api/teams/${teamId}/members/${memberId}`, { method: 'DELETE' });
      if (response.ok) {
        await refreshMembersModal(teamId, [memberId]);
      } else {
        const data = await response.json();
        alert(data.error || 'Failed to remove member');
      }
    }

    async function updateTeamMemberRole(teamId, memberId, role) {
      const response = await fetch(`/api/teams/${teamId}/members/${memberId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role })
      });
      if (response.ok) {
        await refreshMembersModal(teamId, [memberId]);
      } else {
        const data = await response.json();
        alert(data.error || 'Failed to update role');
      }
    }

    document.getElementById('departmentForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      const departmentId = document.getElementById('departmentId').value;
      const payload = {
        name: document.getElementById('departmentName').value,
        description: document.getElementById('departmentDescription').value,
        parentDepartment: document.getElementById('parentDepartment').value || null,
        headAccount: document.getElementById('departmentHead').value || null
      };
      const url = departmentId
        ? `/api/organizations/${orgId}/departments/${departmentId}`
        : `/api/organizations/${orgId}/departments`;
      const method = departmentId ? 'PUT' : 'POST';
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (response.ok) {
        window.location.reload();
      } else {
        const data = await response.json();
        alert(data.error || 'Failed to save department');
      }
    });

    document.getElementById('branchForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      const branchId = document.getElementById('branchId').value;
      const payload = {
        name: document.getElementById('branchName').value,
        code: document.getElementById('branchCode').value,
        address: document.getElementById('branchAddress').value,
        city: document.getElementById('branchCity').value,
        state: document.getElementById('branchState').value,
        country: document.getElementById('branchCountry').value,
        managerAccount: document.getElementById('branchManager').value || null,
        isHeadOffice: document.getElementById('branchIsHeadOffice').checked
      };
      const response = await fetch(
        branchId
          ? `/api/organizations/${orgId}/branches/${branchId}`
          : `/api/organizations/${orgId}/branches`,
        {
          method: branchId ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        }
      );
      const data = await response.json().catch(() => ({}));
      if (response.ok) {
        window.location.href = `/organizations/${orgId}/members?view=branches`;
      } else {
        alert(data.error || 'Failed to save location');
      }
    });

    async function deleteBranch(branchId) {
      const branchName = branches.find((candidate) => normalizeId(candidate.id) === normalizeId(branchId))?.name || 'this location';
      if (!confirm(`Delete location "${branchName}"? Members must be reassigned first.`)) return;
      const response = await fetch(`/api/organizations/${orgId}/branches/${branchId}`, { method: 'DELETE' });
      const data = await response.json().catch(() => ({}));
      if (response.ok) {
        window.location.href = `/organizations/${orgId}/members?view=branches`;
      } else {
        alert(data.error || 'Failed to delete location');
      }
    }

    document.getElementById('createForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      const response = await fetch(`/api/organizations/${orgId}/teams`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: document.getElementById('teamName').value,
          description: document.getElementById('teamDescription').value,
          departmentId: document.getElementById('teamDepartment').value,
          parentTeamId: document.getElementById('parentTeam').value || null
        })
      });
      if (response.ok) {
        window.location.reload();
      } else {
        const data = await response.json();
        alert(data.error || 'Failed to create team');
      }
    });

    document.getElementById('editForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      const teamId = document.getElementById('editTeamId').value;
      const response = await fetch(`/api/teams/${teamId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: document.getElementById('editTeamName').value,
          description: document.getElementById('editTeamDescription').value,
          departmentId: document.getElementById('editTeamDepartment').value,
          parentTeamId: document.getElementById('editParentTeam').value || null
        })
      });
      if (response.ok) {
        window.location.reload();
      } else {
        const data = await response.json();
        alert(data.error || 'Failed to update team');
      }
    });

    async function deleteTeam(teamId, name) {
      if (!confirm(`Delete team "${name}"? This cannot be undone.`)) return;
      const response = await fetch(`/api/teams/${teamId}`, { method: 'DELETE' });
      if (response.ok) {
        window.location.reload();
      } else {
        const data = await response.json();
        alert(data.error || 'Failed to delete team');
      }
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    document.querySelectorAll('.modal').forEach(modal => {
      modal.addEventListener('click', (event) => {
        if (event.target.classList.contains('modal')) {
          modal.classList.remove('active');
        }
      });
    });

    hydrateDepartmentSelectors();
    syncTeamFilterOptions();
    selectDepartmentFromLocation();
    window.addEventListener('popstate', selectDepartmentFromLocation);
    if (departments[0] && document.getElementById('teamDepartment')) {
      document.getElementById('teamDepartment').value = departments[0].id;
      syncParentTeamOptions('teamDepartment', 'parentTeam', '');
    }
  </script>
  <script src="/js/invitation-gatekeeper.js"></script>
</body>
</html>
