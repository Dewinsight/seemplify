<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Members - <%= organization.name %> - AIIN Identity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
</head>

<body>
  <%- include('partials/nav', { activePage: 'organizations' }) %>

  <div class="container">
    <a href="/organizations" class="back-link">← Back to Organizations</a>

    <div class="header">
      <div>
        <h1>Members</h1>
        <div class="header-subtitle">
          <%= organization.name %>
        </div>
      </div>
      <div class="header-actions">
        <% if (['owner', 'admin' ].includes(yourRole)) { %>
          <a href="/organizations/<%= organization._id %>/invitations" class="btn btn-primary">
            + Invite Member
          </a>
          <% } %>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat-value">
          <%= members.length %>
        </div>
        <div class="stat-label">Total Members</div>
      </div>
      <div class="stat">
        <div class="stat-value">
          <%= ownerCount %>
        </div>
        <div class="stat-label">Owners</div>
      </div>
      <div class="stat">
        <div class="stat-value role-badge role-<%= yourRole %>">
          <%= yourRole %>
        </div>
        <div class="stat-label">Your Role</div>
      </div>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
      <% } %>

        <% if (typeof success !=='undefined' && success) { %>
          <div class="alert alert-success">
            <%= success %>
          </div>
          <% } %>

            <% members.forEach(member=> { %>
              <div class="card member-card">
                <div class="member-info">
                  <div class="member-name">
                    <%= member.name || 'No name' %>
                      <% if (member.isOwner) { %>
                        <span style="color: var(--brand-2); font-size: 12px;">(Primary Owner)</span>
                        <% } %>
                  </div>
                  <div class="member-email">
                    <%= member.email %>
                  </div>
                  <div class="member-meta">
                    <span class="role-badge role-<%= member.role %>">
                      <%= member.role %>
                    </span>
                    <span>Joined <%= new Date(member.joinedAt).toLocaleDateString() %></span>
                  </div>
                </div>
                <div class="member-actions">
                  <% if (['owner', 'admin' ].includes(yourRole) && member.id.toString() !==user._id.toString()) { %>
                    <select class="role-select" onchange="updateRole('<%= member.id %>', this.value)"
                      <%=member.role==='owner' && yourRole !=='owner' ? 'disabled' : '' %>>
                      <option value="owner" <%=member.role==='owner' ? 'selected' : '' %>
                        <%= yourRole !=='owner' ? 'disabled' : '' %>>Owner
                      </option>
                      <option value="admin" <%=member.role==='admin' ? 'selected' : '' %>>Admin</option>
                      <option value="hr_manager" <%=member.role==='hr_manager' ? 'selected' : '' %>>HR Manager</option>
                      <option value="recruiter" <%=member.role==='recruiter' ? 'selected' : '' %>>Recruiter</option>
                      <option value="interviewer" <%=member.role==='interviewer' ? 'selected' : '' %>>Interviewer
                      </option>
                      <option value="staff" <%=member.role==='staff' ? 'selected' : '' %>>Staff
                      </option>
                    </select>
                    <button class="btn btn-danger btn-sm"
                      onclick="removeMember('<%= member.id %>', '<%= member.email %>')">
                      Remove
                    </button>
                    <% } else if (member.id.toString()===user._id.toString()) { %>
                      <span style="color: var(--muted); font-size: 13px;">(You)</span>
                      <% } %>
                </div>
              </div>
              <% }) %>

                <% if (yourRole==='owner' ) { %>
                  <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line);">
                    <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                      <button class="btn btn-primary" onclick="showTransferModal()">
                        Transfer Ownership
                      </button>
                      <% if (ownerCount> 1) { %>
                        <button class="btn btn-danger" onclick="leaveOrganization()">
                          Leave Organization
                        </button>
                        <% } %>
                    </div>
                  </div>
                  <% } else if (yourRole !=='owner' ) { %>
                    <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line);">
                      <button class="btn btn-danger" onclick="leaveOrganization()">
                        Leave Organization
                      </button>
                    </div>
                    <% } %>
  </div>

  <!-- Transfer Ownership Modal -->
  <div class="modal" id="transferModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Transfer Ownership</h2>
        <button class="modal-close" onclick="hideTransferModal()">&times;</button>
      </div>
      <p style="color: var(--muted); margin-bottom: 16px;">
        Select a member to transfer ownership to. You will become an admin after transfer.
      </p>
      <div class="form-group">
        <label for="newOwner">New Owner</label>
        <select id="newOwner">
          <% members.filter(m=> m.role !== 'owner').forEach(member => { %>
            <option value="<%= member.id %>">
              <%= member.name || member.email %>
            </option>
            <% }) %>
        </select>
      </div>
      <div class="form-actions">
        <button class="btn btn-secondary" onclick="hideTransferModal()">Cancel</button>
        <button class="btn btn-primary" onclick="confirmTransfer()">Transfer Ownership</button>
      </div>
    </div>
  </div>

  <script>
    const orgId = '<%= organization._id %>';

    async function updateRole(memberId, newRole) {
      if (!confirm(`Change role to ${newRole}?`)) {
        window.location.reload();
        return;
      }

      try {
        const response = await fetch(`/api/organizations/${orgId}/members/${memberId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: newRole })
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to update role');
          window.location.reload();
        }
      } catch (error) {
        alert('Failed to update role');
        window.location.reload();
      }
    }

    async function removeMember(memberId, email) {
      if (!confirm(`Remove ${email} from this organization?`)) return;

      try {
        const response = await fetch(`/api/organizations/${orgId}/members/${memberId}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to remove member');
        }
      } catch (error) {
        alert('Failed to remove member');
      }
    }

    async function leaveOrganization() {
      if (!confirm('Are you sure you want to leave this organization?')) return;

      try {
        const response = await fetch(`/api/organizations/${orgId}/leave`, {
          method: 'POST'
        });

        if (response.ok) {
          window.location.href = '/organizations';
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to leave organization');
        }
      } catch (error) {
        alert('Failed to leave organization');
      }
    }

    function showTransferModal() {
      document.getElementById('transferModal').classList.add('active');
    }

    function hideTransferModal() {
      document.getElementById('transferModal').classList.remove('active');
    }

    async function confirmTransfer() {
      const newOwnerId = document.getElementById('newOwner').value;
      if (!newOwnerId) {
        alert('Please select a new owner');
        return;
      }

      if (!confirm('Are you sure you want to transfer ownership? This cannot be undone.')) return;

      try {
        const response = await fetch(`/api/organizations/${orgId}/transfer-ownership`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newOwnerId })
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to transfer ownership');
        }
      } catch (error) {
        alert('Failed to transfer ownership');
      }
    }
  </script>

  <!-- Invitation Gatekeeper - Blocks page until invitation decision is made -->
  <script src="/js/invitation-gatekeeper.js"></script>
</body>

</html>