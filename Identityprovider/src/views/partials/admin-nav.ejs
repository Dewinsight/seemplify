<!-- Admin Navigation -->
<nav class="admin-nav">
  <div class="admin-nav-brand">
    <a href="/admin" class="admin-nav-logo">
      <%- brand.navLogoHtml %>
      <span class="admin-nav-badge">Admin</span>
    </a>
  </div>

  <div class="admin-nav-links">
    <a href="/admin" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7" rx="1" />
        <rect x="14" y="3" width="7" height="7" rx="1" />
        <rect x="14" y="14" width="7" height="7" rx="1" />
        <rect x="3" y="14" width="7" height="7" rx="1" />
      </svg>
      Dashboard
    </a>
    <a href="/admin/plans" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'plans' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
        <line x1="12" y1="22.08" x2="12" y2="12" />
      </svg>
      Plans
    </a>
    <a href="/admin/requests" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'requests' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
        <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
        <path d="M12 11h4" />
        <path d="M12 16h4" />
        <path d="M8 11h.01" />
        <path d="M8 16h.01" />
      </svg>
      Requests
      <% if (typeof adminStats !== 'undefined' && adminStats.pendingRequests > 0) { %>
        <span class="admin-nav-badge-count"><%= adminStats.pendingRequests %></span>
      <% } %>
    </a>
    <a href="/admin/demo-requests" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'demo-requests' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        <path d="M8 9h8" />
        <path d="M8 13h5" />
      </svg>
      Demo Requests
      <% if (typeof adminStats !== 'undefined' && adminStats.pendingDemoRequests > 0) { %>
        <span class="admin-nav-badge-count"><%= adminStats.pendingDemoRequests %></span>
      <% } %>
    </a>
    <a href="/admin/campaigns" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'campaigns' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16v12H4z" />
        <path d="M4 8l8 5 8-5" />
        <path d="M8 17h8" />
      </svg>
      Campaigns
    </a>
    <a href="/admin/subscriptions" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'subscriptions' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
        <circle cx="12" cy="7" r="4" />
      </svg>
      Subscriptions
    </a>
    <a href="/admin/simple-lms" class="admin-nav-link" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
        <path d="M4 4.5A2.5 2.5 0 0 0 6.5 7H20" />
        <path d="M6.5 7A2.5 2.5 0 0 1 9 9.5V17" />
        <path d="M17 7v10" />
        <path d="M13 7v10" />
      </svg>
      Seemplify Learning
    </a>
    <a href="/admin/recruiter-admin" class="admin-nav-link" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 20V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v16" />
        <rect x="2" y="6" width="20" height="14" rx="2" />
        <path d="M8 10h8" />
        <path d="M8 14h5" />
      </svg>
      Recruiter Admin
    </a>
    <a href="/admin/experience-admin" class="admin-nav-link" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 19V9M10 19V5M16 19v-7M22 19V8" />
        <path d="M2 19h22" />
      </svg>
      Experience Admin
    </a>
    <a href="/admin/organizations" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'organizations' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 21h18M5 21V7l8-4 8 4v14M8 21v-4h8v4" />
      </svg>
      Organizations
    </a>
    <a href="/admin/users" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'users' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
      </svg>
      Admin Users
    </a>
  </div>

  <div class="admin-nav-user">
    <% if (typeof admin !== 'undefined' && admin) { %>
      <div class="admin-nav-user-info">
        <div class="admin-nav-user-avatar">
          <%= admin.name.substring(0, 2).toUpperCase() %>
        </div>
        <div class="admin-nav-user-details">
          <div class="admin-nav-user-name"><%= admin.name %></div>
          <div class="admin-nav-user-role">
            <%= admin.isSuperAdmin ? 'Super Admin' : 'System Admin' %>
          </div>
        </div>
      </div>
      
      <!-- Theme Toggle -->
      <div class="theme-dropdown admin-theme-dropdown">
        <button onclick="window.ThemeManager.toggleDropdown(event)" class="admin-theme-toggle" aria-label="Toggle theme">
          <svg class="theme-toggle-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5" />
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
          </svg>
          <svg class="theme-toggle-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
        <div class="admin-theme-menu" id="theme-menu">
          <button class="theme-option" data-value="light" onclick="window.ThemeManager.setTheme('light')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5" />
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
            </svg>
            Light
          </button>
          <button class="theme-option" data-value="dark" onclick="window.ThemeManager.setTheme('dark')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            Dark
          </button>
          <button class="theme-option" data-value="system" onclick="window.ThemeManager.setTheme('system')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
              <line x1="8" y1="21" x2="16" y2="21" />
              <line x1="12" y1="17" x2="12" y2="21" />
            </svg>
            System
          </button>
        </div>
      </div>
      
      <a href="/admin/logout" class="admin-nav-link admin-nav-exit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <polyline points="16 17 21 12 16 7" />
          <line x1="21" y1="12" x2="9" y2="12" />
        </svg>
        Logout
      </a>
    <% } %>
  </div>
</nav>
