<script>
  (function initRouteFeedback() {
    const progress = document.querySelector('[data-route-progress]');
    if (!progress) return;

    let navigationStarted = false;
    const start = () => {
      if (navigationStarted) return;
      navigationStarted = true;
      progress.classList.add('is-active');
    };

    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      const link = event.target.closest('a[href]');
      if (!link || link.target === '_blank' || link.hasAttribute('download')) return;

      let destination;
      try {
        destination = new URL(link.href, window.location.href);
      } catch (_) {
        return;
      }

      if (destination.origin !== window.location.origin) return;
      if (destination.pathname === window.location.pathname && destination.search === window.location.search && destination.hash) return;
      start();
    });

    document.addEventListener('submit', (event) => {
      if (!event.defaultPrevented) start();
    });
    window.addEventListener('pageshow', () => {
      navigationStarted = false;
      progress.classList.remove('is-active');
    });
  })();

  (function initNotificationBadge() {
    const badges = Array.from(document.querySelectorAll('[data-notification-badge]'));
    const pendingSignatureBanner = document.querySelector('[data-pending-signature-banner]');
    const pendingSignatureCopy = document.querySelector('[data-pending-signature-copy]');
    const pendingSignatureLink = document.querySelector('[data-pending-signature-link]');
    if (!badges.length && !pendingSignatureBanner) return;

    const setCount = (count) => {
      const safeCount = Number.isFinite(Number(count)) ? Math.max(0, Number(count)) : 0;
      badges.forEach((badge) => {
        if (safeCount > 0) {
          badge.hidden = false;
          badge.textContent = safeCount > 99 ? '99+' : String(safeCount);
        } else {
          badge.hidden = true;
          badge.textContent = '0';
        }
      });
    };

    const setPendingSignatureBanner = (count) => {
      if (!pendingSignatureBanner || !pendingSignatureCopy) return;

      const safeCount = Number.isFinite(Number(count)) ? Math.max(0, Number(count)) : 0;
      if (safeCount > 0) {
        pendingSignatureBanner.hidden = false;
        pendingSignatureCopy.textContent = safeCount === 1
          ? '1 document is waiting for your signature.'
          : `${safeCount} documents are waiting for your signature.`;
      } else {
        pendingSignatureBanner.hidden = true;
        pendingSignatureCopy.textContent = '0 documents are waiting for your signature.';
      }
    };

    const setPendingSignatureLink = (tasks) => {
      if (!pendingSignatureLink) return;
      const fallbackHref = pendingSignatureLink.dataset.fallbackHref || '/notifications?category=documents';
      const nextHref = Array.isArray(tasks)
        ? (tasks.find((task) => task && task.category === 'documents' && typeof task.actionUrl === 'string' && task.actionUrl.trim())?.actionUrl || fallbackHref)
        : fallbackHref;
      pendingSignatureLink.href = nextHref;
    };

    fetch('/api/notifications/summary', {
      method: 'GET',
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' }
    })
      .then((response) => {
        if (!response.ok) throw new Error(`Failed (${response.status})`);
        return response.json();
      })
      .then((payload) => {
        setCount(payload?.totalUnread || 0);
        setPendingSignatureBanner(payload?.pendingSignatureCount || 0);
        setPendingSignatureLink(payload?.tasks || []);
      })
      .catch(() => {
        setCount(0);
        setPendingSignatureBanner(<%= navInitialPendingSignatureCount %>);
      });
  })();

  (function initStickyTopNavState() {
    const nav = document.querySelector('.top-nav');
    if (!nav) return;

    let ticking = false;
    const maxShrinkScroll = 140;

    const update = () => {
      ticking = false;
      const scrollY = Math.max(0, window.scrollY || window.pageYOffset || 0);
      const progress = Math.min(1, scrollY / maxShrinkScroll);
      nav.style.setProperty('--top-nav-progress', progress.toFixed(4));
    };

    update();
    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
  })();
</script>
