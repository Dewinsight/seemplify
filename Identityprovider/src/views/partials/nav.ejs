<%
  const navOrganizations = (typeof organizations !== 'undefined' && Array.isArray(organizations)) ? organizations : [];
  const navUserCurrentOrgId = user?.currentOrganization?._id?.toString?.()
    || user?.currentOrganization?.toString?.()
    || null;
  const navRouteOrganization = typeof organization !== 'undefined' ? organization : null;
  const navUserOrganization = user?.currentOrganization && typeof user.currentOrganization === 'object'
    ? user.currentOrganization
    : null;
  const navCurrentOrganization = navOrganizations.find((item) => {
    const itemId = item?.id?.toString?.() || item?._id?.toString?.() || null;
    return item?.isCurrent || item?.isCurrentOrganization || (itemId && navUserCurrentOrgId && itemId === navUserCurrentOrgId);
  }) || navRouteOrganization || navUserOrganization || null;
  const navCurrentOrganizationId = navCurrentOrganization?.id?.toString?.()
    || navCurrentOrganization?._id?.toString?.()
    || null;
  const navCurrentOrganizationRole = navCurrentOrganization?.role || null;
