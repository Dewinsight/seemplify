<% if (profileCompletion && !profileCompletion.complete) { %>
    <style>
        body.profile-wizard-open {
            overflow: hidden;
        }

        #profileCompletionWizard[hidden] {
            display: none !important;
        }

        .profile-wizard-overlay {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: rgba(15, 23, 42, 0.68);
            z-index: 1200;
        }

        .profile-wizard-modal {
            position: relative;
            width: min(680px, 100%);
            max-height: min(92vh, 860px);
            overflow: auto;
            padding: 28px;
            border: 1px solid var(--border);
            border-radius: 18px;
            background: var(--panel);
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.28);
        }

        .profile-wizard-close {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 36px;
            height: 36px;
            border: 1px solid var(--border);
            border-radius: 999px;
            background: var(--hover-bg);
            color: var(--text);
            font-size: 22px;
            line-height: 1;
            cursor: pointer;
        }

        .profile-wizard-kicker {
            margin-bottom: 12px;
            color: var(--brand);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .profile-wizard-title {
            margin: 0 0 8px;
            color: var(--text);
            font-size: 28px;
            line-height: 1.15;
        }

        .profile-wizard-copy {
            margin: 0 0 18px;
            color: var(--muted);
        }

        .profile-wizard-progress {
            width: 100%;
            height: 10px;
            overflow: hidden;
            border-radius: 999px;
            background: var(--hover-bg);
        }

        .profile-wizard-progress-bar {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #0f766e, #14b8a6);
        }

        .profile-wizard-progress-label {
            margin-top: 8px;
            color: var(--muted);
            font-size: 13px;
        }

        .profile-wizard-steps {
            display: grid;
            gap: 12px;
            margin: 20px 0 24px;
        }

        .profile-wizard-step {
            display: grid;
            grid-template-columns: 40px 1fr auto;
            gap: 14px;
            align-items: center;
            padding: 14px 16px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: var(--hover-bg);
        }

        .profile-wizard-step.is-current {
            border-color: var(--brand);
            box-shadow: inset 0 0 0 1px rgba(15, 118, 110, 0.2);
        }

        .profile-wizard-step.is-complete {
            opacity: 0.78;
        }

        .profile-wizard-step-index {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border: 1px solid var(--border);
            border-radius: 999px;
            background: var(--panel-strong);
            color: var(--text);
            font-weight: 700;
        }

        .profile-wizard-step-title {
            margin-bottom: 4px;
            color: var(--text);
            font-weight: 700;
        }

        .profile-wizard-step-copy {
            color: var(--muted);
            font-size: 13px;
        }

        .profile-wizard-step-status {
            color: var(--brand);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .profile-wizard-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        @media (max-width: 768px) {
            .profile-wizard-modal {
                padding: 22px;
            }

            .profile-wizard-step {
                grid-template-columns: 40px 1fr;
            }

            .profile-wizard-step-status {
                grid-column: 2;
            }
        }
    </style>

    <div id="profileCompletionWizard" class="profile-wizard-overlay" hidden>
        <div class="profile-wizard-modal" role="dialog" aria-modal="true" aria-labelledby="profileWizardTitle">
            <button type="button" class="profile-wizard-close" id="profileWizardClose" aria-label="Close wizard">&times;</button>
            <div class="profile-wizard-kicker">Profile Setup</div>
            <h2 id="profileWizardTitle" class="profile-wizard-title">Complete your employee profile</h2>
            <p class="profile-wizard-copy">
                Payroll and HR need these details before your profile is fully ready. Complete each step below.
            </p>

            <div class="profile-wizard-progress">
                <div class="profile-wizard-progress-bar" style="width: <%= profileCompletion.percent %>%;"></div>
            </div>
            <div class="profile-wizard-progress-label">
                <%= profileCompletion.completedCount %> of <%= profileCompletion.totalSteps %> required sections completed
            </div>

            <div class="profile-wizard-steps">
                <% profileCompletion.steps.forEach((step, index) => { %>
                    <div class="profile-wizard-step <%= step.complete ? 'is-complete' : '' %> <%= profileCompletion.nextIncompleteStep?.key === step.key ? 'is-current' : '' %>">
                        <div class="profile-wizard-step-index"><%= index + 1 %></div>
                        <div>
                            <div class="profile-wizard-step-title"><%= step.label %></div>
                            <div class="profile-wizard-step-copy"><%= step.description %></div>
                        </div>
                        <div class="profile-wizard-step-status"><%= step.complete ? 'Done' : 'Required' %></div>
                    </div>
                <% }) %>
            </div>

            <div class="profile-wizard-actions">
                <button type="button" class="btn btn-primary" id="profileWizardPrimary">
                    Continue
                </button>
                <% const dependentsStep = (profileCompletion.steps || []).find(step => step.key === 'dependents') %>
                <% if (currentProfileSection === 'dependents' && dependentsStep && !dependentsStep.complete) { %>
                    <button type="button" class="btn btn-secondary" id="profileWizardNoDependents">
                        I have no dependents
                    </button>
                <% } %>
                <button type="button" class="btn btn-secondary" id="profileWizardDismiss">
                    Remind me later
                </button>
            </div>
        </div>
    </div>

    <script>
        (() => {
            const profileCompletion = <%- JSON.stringify(profileCompletion) %>;
            const currentProfileSection = <%- JSON.stringify(currentProfileSection || '') %>;
            const modal = document.getElementById('profileCompletionWizard');
            const primaryButton = document.getElementById('profileWizardPrimary');
            const closeButton = document.getElementById('profileWizardClose');
            const dismissButton = document.getElementById('profileWizardDismiss');
            const noDependentsButton = document.getElementById('profileWizardNoDependents');

            if (!modal || !profileCompletion || profileCompletion.complete) {
                return;
            }

            const nextStep = profileCompletion.nextIncompleteStep || (profileCompletion.steps || []).find(step => !step.complete) || null;

            function closeWizard() {
                modal.hidden = true;
                document.body.classList.remove('profile-wizard-open');
            }

            function openWizard() {
                modal.hidden = false;
                document.body.classList.add('profile-wizard-open');
            }

            function resolveWizardTarget() {
                if (!nextStep) {
                    return '/profile/personal';
                }

                if (nextStep.key === currentProfileSection) {
                    return null;
                }

                return `${nextStep.route}?wizard=1`;
            }

            primaryButton?.addEventListener('click', () => {
                const target = resolveWizardTarget();
                if (!target) {
                    closeWizard();
                    return;
                }

                window.location.href = target;
            });

            closeButton?.addEventListener('click', closeWizard);
            dismissButton?.addEventListener('click', closeWizard);
            modal.addEventListener('click', (event) => {
                if (event.target === modal) {
                    closeWizard();
                }
            });

            noDependentsButton?.addEventListener('click', async () => {
                noDependentsButton.disabled = true;
                try {
                    const response = await fetch('/api/profile/dependents', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ hasDependents: false })
                    });
                    const result = await response.json();

                    if (!response.ok) {
                        throw new Error(result.error || 'Failed to confirm dependents status');
                    }

                    const nextRoute = result?.nextStep?.route ? `${result.nextStep.route}?wizard=1` : null;
                    if (nextRoute) {
                        window.location.href = nextRoute;
                        return;
                    }

                    window.location.reload();
                } catch (error) {
                    alert(error.message || 'Failed to confirm dependents status');
                    noDependentsButton.disabled = false;
                }
            });

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => {
                    requestAnimationFrame(openWizard);
                }, { once: true });
            } else {
                requestAnimationFrame(openWizard);
            }
        })();
    </script>
<% } %>
