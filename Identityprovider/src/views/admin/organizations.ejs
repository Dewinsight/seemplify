<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Organizations - Admin - Seemplify IDP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../../public/css/idp-theme.css') %>

    .org-meta {
      font-size: 12px;
      color: var(--muted);
      margin-top: 2px;
    }

    .org-inline-muted {
      color: var(--muted);
      font-size: 12px;
    }
  </style>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/theme.js?v=3"></script>
</head>

<body>
  <% const totalOrgs = organizations?.length || 0; %>
  <% const activeOrgs = organizations?.filter(org => org.subscriptionStatus === 'active').length || 0; %>
  <% const graceOrgs = organizations?.filter(org => org.subscriptionStatus === 'grace_period').length || 0; %>
  <% const noSubOrgs = organizations?.filter(org => !org.activeSubscription || org.subscriptionStatus === 'none').length || 0; %>

  <div class="admin-layout">
    <%- include('../partials/admin-nav', { activePage: 'organizations' }) %>

    <main class="admin-content">
      <div class="admin-header">
        <h1>Organizations</h1>
      </div>

      <% if (notice) { %>
        <div class="alert <%= noticeType === 'error' ? 'alert-danger' : 'alert-success' %>">
          <span class="alert-icon"><%= noticeType === 'error' ? 'âš ' : 'âœ“' %></span>
          <span><%= notice %></span>
        </div>
      <% } %>

      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <div class="admin-stat-label">Total Organizations</div>
          <div class="admin-stat-value"><%= totalOrgs %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Active Subscriptions</div>
          <div class="admin-stat-value" style="color: #22c55e;"><%= activeOrgs %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Grace Period</div>
          <div class="admin-stat-value" style="color: #f59e0b;"><%= graceOrgs %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">No Subscription</div>
          <div class="admin-stat-value" style="color: #ef4444;"><%= noSubOrgs %></div>
        </div>
      </div>

      <% if (organizations && organizations.length > 0) { %>
        <div class="admin-table-container">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Organization</th>
                <th>Owner</th>
                <th>Members</th>
                <th>Current Plan</th>
                <th>Subscription Status</th>
                <th>Expires</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% organizations.forEach(org => { %>
                <% const ownerName = org.owner?.profile?.name || org.owner?.email || 'Unknown'; %>
                <% const ownerEmail = org.owner?.email || 'N/A'; %>
                <% const status = org.subscriptionStatus || 'none'; %>
                <% const badgeClass = status === 'none' ? 'cancelled' : status; %>
                <% const expiresDate = org.subscriptionExpiresAt ? new Date(org.subscriptionExpiresAt) : null; %>

                <tr>
                  <td>
                    <div style="font-weight: 600;"><%= org.name || 'Unnamed Organization' %></div>
                    <div class="org-meta"><%= org._id %></div>
                  </td>
                  <td>
                    <div><%= ownerName %></div>
                    <div class="org-meta"><%= ownerEmail %></div>
                  </td>
                  <td>
                    <div><%= org.memberCount || 0 %> active</div>
                    <div class="org-meta"><%= org.members?.length || 0 %> total</div>
                  </td>
                  <td>
                    <% if (org.currentPlan) { %>
                      <div><%= org.currentPlan.name || 'Unknown Plan' %></div>
                    <% } else { %>
                      <div class="org-inline-muted">No active plan</div>
                    <% } %>
                  </td>
                  <td>
                    <span class="status-badge status-badge--<%= badgeClass %>"><%= status %></span>
                  </td>
                  <td>
                    <% if (expiresDate) { %>
                      <div><%= expiresDate.toLocaleDateString() %></div>
                      <div class="org-meta"><%= expiresDate.toLocaleTimeString() %></div>
                    <% } else { %>
                      <div class="org-inline-muted">N/A</div>
                    <% } %>
                  </td>
                  <td>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                      <a href="/admin/organizations/<%= org._id %>" class="btn btn-sm btn-secondary">View</a>
                      <a href="/admin/subscriptions" class="btn btn-sm btn-secondary">Manage</a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="admin-card">
          <div class="admin-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 21h18M5 21V7l8-4 8 4v14M8 21v-4h8v4" />
            </svg>
            <h3>No organizations found</h3>
            <p>Organizations will appear here once users create or join them.</p>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</body>

</html>
