<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard - Seemplify IDP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/theme.js?v=2"></script>
</head>

<body>
  <div class="admin-layout">
    <%- include('../partials/admin-nav', { activePage: 'dashboard' }) %>

    <main class="admin-content">
      <%
        const workforceSummary = workforceAnalytics?.summary || {};
        const workforceApps = workforceAnalytics?.apps || [];
        const workforceTopOrganizations = workforceAnalytics?.topOrganizations || [];
        const workforceRecentActivity = workforceAnalytics?.recentActivity || [];
      %>
      <div class="admin-header">
        <h1>Dashboard</h1>
        <div class="admin-header-actions">
          <a href="/admin/subscriptions/lifecycle/run" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 4 23 10 17 10" />
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
            </svg>
            Run Lifecycle Jobs
          </a>
        </div>
      </div>

      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <div class="admin-stat-label">Total Organizations</div>
          <div class="admin-stat-value"><%= stats.organizations.total %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Active Subscriptions</div>
          <div class="admin-stat-value"><%= stats.subscriptions.active %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Pending Requests</div>
          <div class="admin-stat-value" style="color: <%= stats.requests.pending > 0 ? '#f59e0b' : 'var(--text)' %>">
            <%= stats.requests.pending %>
          </div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Orgs Without Subscription</div>
          <div class="admin-stat-value"><%= stats.organizations.withoutSubscription %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">New Demo Requests</div>
          <div class="admin-stat-value" style="color: <%= demoRequestStats?.new > 0 ? '#f59e0b' : 'var(--text)' %>">
            <%= demoRequestStats?.new || 0 %>
          </div>
        </div>
      </div>

      <div class="admin-card">
        <div class="admin-card-header">
          <div>
            <div class="admin-card-title">Workforce Operations Analytics</div>
            <div class="admin-card-subtitle">
              Payroll, Leave Management, and Time &amp; Attendance activity from
              <%= new Date(workforceSummary.lookbackStart || Date.now()).toLocaleDateString('en-GB') %>
              to
              <%= new Date(workforceSummary.lookbackEnd || Date.now()).toLocaleDateString('en-GB') %>
            </div>
          </div>
        </div>

        <div class="admin-stats-grid admin-stats-grid--compact">
          <div class="admin-stat-card admin-stat-card--accent">
            <div class="admin-stat-label">HR Suite Licensed Orgs</div>
            <div class="admin-stat-value"><%= workforceSummary.entitledOrganizations || 0 %></div>
            <div class="admin-stat-change">With at least one workforce product enabled</div>
          </div>
          <div class="admin-stat-card admin-stat-card--accent">
            <div class="admin-stat-label">Active Orgs (30d)</div>
            <div class="admin-stat-value"><%= workforceSummary.activeOrganizations30d || 0 %></div>
            <div class="admin-stat-change"><%= workforceSummary.averageAdoptionRate || 0 %>% average adoption across the tracked apps</div>
          </div>
          <div class="admin-stat-card admin-stat-card--accent">
            <div class="admin-stat-label">Active Users (30d)</div>
            <div class="admin-stat-value"><%= workforceSummary.activeUsers30d || 0 %></div>
            <div class="admin-stat-change">Unique admins and employees reaching the HR apps</div>
          </div>
          <div class="admin-stat-card admin-stat-card--accent">
            <div class="admin-stat-label">Successful Launches (30d)</div>
            <div class="admin-stat-value"><%= workforceSummary.successfulLaunches30d || 0 %></div>
            <div class="admin-stat-change <%= workforceSummary.blockedLaunches30d > 0 ? 'negative' : 'positive' %>">
              <%= workforceSummary.blockedLaunches30d || 0 %> blocked launches, top app: <%= workforceSummary.mostUsedAppName || 'None' %>
            </div>
          </div>
        </div>
      </div>

      <div class="workforce-app-grid">
        <% workforceApps.forEach(app => { %>
          <div class="admin-card workforce-app-card" style="--app-accent: <%= app.color %>;">
            <div class="workforce-app-card__header">
              <div>
                <div class="workforce-app-card__eyebrow"><%= app.name %></div>
                <div class="workforce-app-card__title"><%= app.adoptionRate30d %>% org adoption</div>
              </div>
              <span class="workforce-app-card__chip"><%= app.successRate30d %>% success rate</span>
            </div>

            <div class="workforce-app-metrics">
              <div class="workforce-app-metric">
                <span class="workforce-app-metric__label">Licensed Orgs</span>
                <span class="workforce-app-metric__value"><%= app.entitledOrganizations %></span>
              </div>
              <div class="workforce-app-metric">
                <span class="workforce-app-metric__label">Active Orgs</span>
                <span class="workforce-app-metric__value"><%= app.activeOrganizations30d %></span>
              </div>
              <div class="workforce-app-metric">
                <span class="workforce-app-metric__label">Active Users</span>
                <span class="workforce-app-metric__value"><%= app.activeUsers30d %></span>
              </div>
              <div class="workforce-app-metric">
                <span class="workforce-app-metric__label">Launches (30d)</span>
                <span class="workforce-app-metric__value"><%= app.successfulLaunches30d %></span>
              </div>
              <div class="workforce-app-metric">
                <span class="workforce-app-metric__label">Launches (7d)</span>
                <span class="workforce-app-metric__value"><%= app.launches7d %></span>
              </div>
              <div class="workforce-app-metric">
                <span class="workforce-app-metric__label">Idle Licensed Orgs</span>
                <span class="workforce-app-metric__value"><%= app.idleOrganizations %></span>
              </div>
            </div>

            <div class="workforce-app-card__trend">
              <div class="workforce-sparkline" aria-hidden="true">
                <% app.sparkline.forEach(point => { %>
                  <span
                    class="workforce-sparkline__bar"
                    title="<%= point.label %>: <%= point.count %> launches"
                    style="height: <%= point.height %>%"
                  ></span>
                <% }) %>
              </div>
              <div class="workforce-app-card__meta">
                <div class="admin-stat-change <%= app.growth.tone === 'positive' ? 'positive' : app.growth.tone === 'negative' ? 'negative' : '' %>">
                  <%= app.growth.label %>
                </div>
                <div class="workforce-app-card__footnote">
                  <%= app.blockedLaunches30d %> blocked attempts
                  <% if (app.lastLaunchAt) { %>
                    | last activity <%= new Date(app.lastLaunchAt).toLocaleString('en-GB') %>
                  <% } else { %>
                    | no activity recorded yet
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">Top Organizations By Workforce Usage</div>
        </div>

        <% if (workforceTopOrganizations.length > 0) { %>
          <div class="admin-table-container" style="border: none;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Organization</th>
                  <th>Total Launches</th>
                  <th>Apps Used</th>
                  <th>Breakdown</th>
                  <th>Last Activity</th>
                </tr>
              </thead>
              <tbody>
                <% workforceTopOrganizations.forEach(org => { %>
                  <tr>
                    <td style="font-weight: 600;"><%= org.organizationName %></td>
                    <td><%= org.totalLaunches %></td>
                    <td><%= org.appsUsed %></td>
                    <td><%= org.breakdownText || 'No recent breakdown' %></td>
                    <td><%= org.lastUsedAt ? new Date(org.lastUsedAt).toLocaleString('en-GB') : 'Never' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="admin-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3v18h18" />
              <path d="M7 14l3-3 3 2 4-6" />
            </svg>
            <h3>No workforce usage yet</h3>
            <p>When organizations start using payroll, leave, or time-attendance, their activity will appear here.</p>
          </div>
        <% } %>
      </div>

      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">Recent HR App Activity</div>
        </div>

        <% if (workforceRecentActivity.length > 0) { %>
          <div class="admin-table-container" style="border: none;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>App</th>
                  <th>Organization</th>
                  <th>User</th>
                  <th>Status</th>
                  <th>When</th>
                </tr>
              </thead>
              <tbody>
                <% workforceRecentActivity.forEach(activity => { %>
                  <tr>
                    <td style="font-weight: 600;"><%= activity.appName %></td>
                    <td><%= activity.organizationName %></td>
                    <td><%= activity.accountName %></td>
                    <td>
                      <span class="status-badge status-badge--<%= activity.badgeStatus %>">
                        <%= activity.statusLabel %>
                      </span>
                    </td>
                    <td><%= activity.createdAt ? new Date(activity.createdAt).toLocaleString('en-GB') : 'Unknown' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="admin-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 8v4l3 3" />
              <circle cx="12" cy="12" r="10" />
            </svg>
            <h3>No recent HR app activity</h3>
            <p>Launch events across Payroll, Leave Management, and Time &amp; Attendance will show here.</p>
          </div>
        <% } %>
      </div>

      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">Recent Subscription Requests</div>
          <a href="/admin/requests" class="btn btn-sm btn-secondary">View All</a>
        </div>

        <% if (recentRequests && recentRequests.length > 0) { %>
          <div class="admin-table-container" style="border: none;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Organization</th>
                  <th>Plan</th>
                  <th>Contact</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% recentRequests.forEach(request => { %>
                  <tr>
                    <td>
                      <div style="font-weight: 600;"><%= request.organization?.name || 'Unknown' %></div>
                    </td>
                    <td>
                      <div><%= request.plan?.name || 'Unknown' %></div>
                      <div style="font-size: 12px; color: var(--muted);"><%= request.billingCycle %></div>
                    </td>
                    <td>
                      <div><%= request.contactInfo?.name %></div>
                      <div style="font-size: 12px; color: var(--muted);"><%= request.contactInfo?.email %></div>
                    </td>
                    <td>
                      <span class="status-badge status-badge--<%= request.status %>">
                        <%= request.status %>
                      </span>
                    </td>
                    <td>
                      <div><%= new Date(request.createdAt).toLocaleDateString() %></div>
                    </td>
                    <td>
                      <a href="/admin/requests/<%= request._id %>" class="btn btn-sm btn-secondary">View</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="admin-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
              <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
            </svg>
            <h3>No recent requests</h3>
            <p>When organizations request subscriptions, they will appear here.</p>
          </div>
        <% } %>
      </div>

      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">Recent Demo Requests</div>
          <a href="/admin/demo-requests" class="btn btn-sm btn-secondary">Open Queue</a>
        </div>

        <% if (recentDemoRequests && recentDemoRequests.length > 0) { %>
          <div class="admin-table-container" style="border: none;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Requester</th>
                  <th>Company</th>
                  <th>Status</th>
                  <th>Submitted</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% recentDemoRequests.forEach(request => { %>
                  <tr>
                    <td>
                      <div style="font-weight: 600;"><%= request.name %></div>
                      <div style="font-size: 12px; color: var(--muted);"><%= request.email %></div>
                    </td>
                    <td><%= request.company || 'N/A' %></td>
                    <td>
                      <span class="status-badge status-badge--<%= request.status === 'new' ? 'pending' : request.status %>">
                        <%= request.status %>
                      </span>
                    </td>
                    <td><%= new Date(request.createdAt).toLocaleDateString('en-GB') %></td>
                    <td>
                      <a href="/admin/demo-requests/<%= request._id %>" class="btn btn-sm btn-secondary">View</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="admin-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
            <h3>No demo requests yet</h3>
            <p>Public book-a-demo submissions will appear here for follow-up.</p>
          </div>
        <% } %>
      </div>

      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">Plan Overview</div>
          <a href="/admin/plans" class="btn btn-sm btn-secondary">Manage Plans</a>
        </div>

        <% if (stats.plans && stats.plans.length > 0) { %>
          <div class="admin-table-container" style="border: none;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Plan</th>
                  <th>Active Subscriptions</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% stats.plans.forEach(plan => { %>
                  <tr>
                    <td style="font-weight: 600;"><%= plan.name %></td>
                    <td><%= plan.activeSubscriptions %></td>
                    <td>
                      <% if (plan.isActive && plan.isPublic) { %>
                        <span class="status-badge status-badge--active">Active</span>
                      <% } else if (plan.isActive) { %>
                        <span class="status-badge status-badge--pending">Private</span>
                      <% } else { %>
                        <span class="status-badge status-badge--expired">Inactive</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="admin-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
            </svg>
            <h3>No plans created yet</h3>
            <p>Create your first plan to get started.</p>
            <a href="/admin/plans" class="btn btn-primary" style="margin-top: 16px;">Manage Plans</a>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</body>

</html>
