<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Campaigns - Seemplify IDP Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/theme.js?v=2"></script>
  <style>
    .campaign-console-grid { display:grid; grid-template-columns:minmax(0, 1.55fr) minmax(340px, .95fr); gap:20px; align-items:start; }
    .campaign-stat-grid { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:16px; margin-bottom:24px; }
    .campaign-stat-card { padding:18px 20px; border-radius:18px; border:1px solid var(--border); background:var(--panel); }
    .campaign-shell { display:grid; gap:18px; }
    .campaign-sticky { position:sticky; top:20px; display:grid; gap:18px; }
    .campaign-form-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:16px; }
    .campaign-form-grid--triple { grid-template-columns:repeat(3, minmax(0, 1fr)); }
    .campaign-toolbar { display:flex; flex-wrap:wrap; gap:10px; }
    .campaign-mode-toggle { display:inline-flex; padding:4px; gap:4px; border-radius:999px; border:1px solid var(--border); background:var(--panel-strong); }
    .campaign-mode-toggle button { border:none; background:transparent; color:var(--muted); padding:8px 14px; border-radius:999px; cursor:pointer; font-weight:600; }
    .campaign-mode-toggle button.active { background:rgba(99, 102, 241, 0.12); color:#818cf8; }
    .campaign-builder-grid { display:grid; grid-template-columns:280px minmax(0, 1fr); gap:18px; align-items:start; }
    .campaign-palette { display:grid; gap:12px; }
    .campaign-palette-list { display:grid; gap:8px; }
    .campaign-palette-item { display:flex; justify-content:space-between; align-items:center; gap:12px; border:1px solid var(--border); border-radius:14px; padding:12px 14px; background:var(--panel-strong); }
    .campaign-preview-shell { position:relative; min-height:640px; padding:18px; border-radius:22px; border:1px solid var(--border); background:linear-gradient(180deg, rgba(109,40,217,.08), rgba(20,184,166,.04)); }
    .campaign-preview-canvas { width:100%; max-width:720px; margin:0 auto; background:#f6f0ff; border-radius:28px; padding:22px; box-shadow:0 25px 80px rgba(15,23,42,.16); }
    .campaign-preview-stack { display:grid; gap:14px; }
    .campaign-block { position:relative; border-radius:26px; border:1px solid rgba(31,22,55,.08); background:#ffffff; overflow:hidden; }
    .campaign-block.is-dragging { opacity:.45; }
    .campaign-block-toolbar { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:12px 16px; border-bottom:1px solid rgba(31,22,55,.08); background:rgba(246,240,255,.85); }
    .campaign-block-toolbar strong { font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#6d6485; }
    .campaign-block-actions { display:flex; gap:8px; }
    .campaign-block-actions button { border:none; background:rgba(15,23,42,.06); color:#221934; border-radius:999px; width:30px; height:30px; cursor:pointer; }
    .campaign-block-body { padding:22px; display:grid; gap:14px; color:#221934; }
    .campaign-block-body[data-type="hero"] { background:linear-gradient(160deg, #6d28d9 0%, #221934 100%); color:#ffffff; }
    .campaign-block-body[data-type="cta"] { background:rgba(109,40,217,.06); }
    .campaign-preview-eyebrow { font-size:12px; letter-spacing:.24em; text-transform:uppercase; color:inherit; opacity:.72; }
    .campaign-preview-title { font-size:30px; line-height:1.08; font-weight:700; letter-spacing:-.03em; outline:none; }
    .campaign-preview-subtitle { font-size:15px; line-height:1.7; outline:none; }
    .campaign-preview-editable { min-height:18px; outline:none; }
    .campaign-preview-editable:focus { box-shadow:0 0 0 2px rgba(109,40,217,.18); border-radius:10px; }
    .campaign-preview-items { display:grid; gap:10px; }
    .campaign-preview-item { display:grid; grid-template-columns:26px 1fr auto; gap:10px; align-items:flex-start; }
    .campaign-preview-item-badge { width:26px; height:26px; border-radius:999px; background:rgba(20,184,166,.12); color:#14b8a6; display:flex; align-items:center; justify-content:center; font-weight:700; }
    .campaign-preview-item button { border:none; background:transparent; color:#ef4444; cursor:pointer; }
    .campaign-preview-buttons { display:flex; flex-wrap:wrap; gap:10px; }
    .campaign-preview-button { display:inline-flex; align-items:center; gap:8px; padding:12px 18px; border-radius:999px; border:1px solid rgba(255,255,255,.3); text-decoration:none; font-weight:700; }
    .campaign-preview-button.primary { background:linear-gradient(135deg, #14b8a6, #6d28d9); color:#ffffff; border:none; }
    .campaign-preview-button.secondary { background:transparent; color:inherit; }
    .campaign-preview-button input { border:none; background:transparent; color:inherit; width:100%; min-width:140px; outline:none; }
    .campaign-preview-button .campaign-mini-input { max-width:150px; }
    .campaign-mini-input { width:100%; border:1px solid rgba(31,22,55,.12); border-radius:999px; padding:8px 12px; background:rgba(255,255,255,.82); color:#221934; }
    .campaign-mini-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:12px; }
    .campaign-html-grid { display:grid; grid-template-columns:minmax(0, .95fr) minmax(0, 1fr); gap:18px; }
    .campaign-html-editor { min-height:560px; font-family:ui-monospace, SFMono-Regular, Menlo, monospace; resize:vertical; }
    .campaign-html-preview { min-height:560px; border:1px solid var(--border); border-radius:18px; background:#ffffff; padding:18px; overflow:auto; }
    .campaign-card-stack { display:grid; gap:12px; }
    .campaign-list-card { border:1px solid var(--border); border-radius:18px; padding:16px; background:var(--panel-strong); display:grid; gap:10px; cursor:pointer; }
    .campaign-list-card.active { border-color:rgba(99,102,241,.45); box-shadow:0 0 0 1px rgba(99,102,241,.18); }
    .campaign-list-meta, .campaign-health-list { display:grid; gap:8px; }
    .campaign-pill { display:inline-flex; align-items:center; gap:6px; padding:5px 10px; border-radius:999px; font-size:12px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; }
    .campaign-pill.red { background:rgba(239,68,68,.12); color:#fca5a5; }
    .campaign-pill.amber { background:rgba(245,158,11,.12); color:#fbbf24; }
    .campaign-pill.green { background:rgba(34,197,94,.12); color:#86efac; }
    .campaign-audience-card, .campaign-template-card, .campaign-health-card { border:1px solid var(--border); border-radius:18px; padding:14px; background:var(--panel-strong); display:grid; gap:8px; }
    .campaign-upload-form { display:grid; gap:12px; }
    .campaign-link-popover { position:fixed; z-index:1200; min-width:260px; padding:12px; border-radius:16px; border:1px solid var(--border); background:var(--panel-solid); box-shadow:0 20px 60px rgba(2,6,23,.35); display:none; gap:10px; }
    .campaign-link-popover.show { display:grid; }
    .campaign-link-popover-actions { display:flex; justify-content:flex-end; gap:8px; }
    .campaign-empty-state { border:1px dashed var(--border); border-radius:18px; padding:18px; color:var(--muted); text-align:center; }
    .campaign-hero-panel {
      display:grid;
      grid-template-columns:minmax(0, 1.3fr) minmax(280px, .85fr);
      gap:18px;
      padding:22px;
      margin-bottom:24px;
      border-radius:24px;
      border:1px solid var(--border);
      background:
        radial-gradient(circle at top left, rgba(99,102,241,.18), transparent 42%),
        linear-gradient(135deg, rgba(15,23,42,.98), rgba(24,24,44,.96));
      box-shadow:0 24px 70px rgba(2,6,23,.22);
    }
    .campaign-hero-copy { display:grid; gap:14px; }
    .campaign-hero-copy h2 { margin:0; color:#f8fafc; font-size:34px; line-height:1.04; letter-spacing:-.04em; }
    .campaign-hero-copy p { margin:0; color:rgba(226,232,240,.8); max-width:760px; line-height:1.7; }
    .campaign-hero-pill {
      display:inline-flex;
      align-items:center;
      gap:8px;
      width:max-content;
      padding:8px 12px;
      border-radius:999px;
      border:1px solid rgba(148,163,184,.14);
      background:rgba(15,23,42,.4);
      color:#cbd5e1;
      font-size:12px;
      font-weight:700;
      letter-spacing:.06em;
      text-transform:uppercase;
    }
    .campaign-hero-steps {
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:12px;
    }
    .campaign-hero-step {
      padding:14px;
      border-radius:18px;
      border:1px solid rgba(148,163,184,.16);
      background:rgba(15,23,42,.42);
      display:grid;
      gap:8px;
      color:#e2e8f0;
    }
    .campaign-hero-step strong { color:#f8fafc; }
    .campaign-hero-step-badge {
      width:32px;
      height:32px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border-radius:999px;
      background:rgba(129,140,248,.18);
      color:#c7d2fe;
      font-size:12px;
      font-weight:700;
      letter-spacing:.08em;
      text-transform:uppercase;
    }
    .campaign-hero-aside {
      display:grid;
      gap:12px;
      padding:18px;
      border-radius:22px;
      border:1px solid rgba(148,163,184,.16);
      background:rgba(15,23,42,.52);
      align-content:start;
    }
    .campaign-hero-aside h3 { margin:0; color:#f8fafc; font-size:18px; }
    .campaign-hero-aside p { margin:0; color:rgba(226,232,240,.8); line-height:1.7; }
    .campaign-manager-toolbar {
      display:grid;
      grid-template-columns:minmax(0, 1fr) 180px;
      gap:12px;
      margin-top:16px;
    }
    .campaign-manager-summary {
      margin-top:14px;
      padding:12px 14px;
      border-radius:16px;
      border:1px solid rgba(148,163,184,.12);
      background:rgba(99,102,241,.06);
      color:var(--muted);
      font-size:13px;
    }
    .campaign-list-card {
      transition:transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    }
    .campaign-list-card:hover { transform:translateY(-1px); }
    .campaign-list-card.active {
      box-shadow:0 0 0 1px rgba(99,102,241,.18), 0 18px 40px rgba(15,23,42,.14);
      background:linear-gradient(180deg, rgba(99,102,241,.08), rgba(15,23,42,.02));
    }
    .campaign-list-head { display:flex; justify-content:space-between; gap:12px; align-items:flex-start; }
    .campaign-list-metrics {
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:10px;
      padding-top:10px;
      border-top:1px solid var(--border);
    }
    .campaign-mini-stat {
      padding:10px 12px;
      border-radius:14px;
      background:rgba(148,163,184,.06);
      border:1px solid rgba(148,163,184,.1);
    }
    .campaign-mini-stat-label {
      display:block;
      margin-bottom:4px;
      color:var(--muted);
      font-size:11px;
      font-weight:700;
      letter-spacing:.08em;
      text-transform:uppercase;
    }
    .campaign-mini-stat-value {
      color:var(--text);
      font-size:16px;
      font-weight:700;
    }
    .campaign-selected-card {
      display:grid;
      gap:14px;
      padding:18px;
      border-radius:20px;
      border:1px solid var(--border);
      background:linear-gradient(180deg, rgba(99,102,241,.08), rgba(15,23,42,.02));
    }
    .campaign-selected-grid {
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:10px;
    }
    .campaign-selected-item {
      padding:12px 14px;
      border-radius:16px;
      border:1px solid rgba(148,163,184,.1);
      background:rgba(148,163,184,.06);
    }
    .campaign-selected-item strong {
      display:block;
      margin-bottom:6px;
      color:var(--muted);
      font-size:11px;
      font-weight:700;
      letter-spacing:.08em;
      text-transform:uppercase;
    }
    .campaign-selected-item span { color:var(--text); font-weight:600; line-height:1.4; }
    .campaign-audience-hint {
      padding:14px;
      border-radius:18px;
      border:1px solid rgba(148,163,184,.12);
      background:rgba(20,184,166,.05);
      color:var(--muted);
      font-size:13px;
      line-height:1.7;
      margin-bottom:14px;
    }
    .campaign-upload-actions { display:flex; flex-wrap:wrap; gap:10px; }
    .campaign-audience-status {
      min-height:20px;
      font-size:13px;
      color:var(--muted);
      margin-top:12px;
    }
    .campaign-audience-status.success { color:#10b981; }
    .campaign-audience-status.error { color:#f87171; }
    .campaign-mapping-panel {
      display:grid;
      gap:16px;
      margin-top:16px;
      padding:16px;
      border-radius:18px;
      border:1px solid rgba(148,163,184,.12);
      background:rgba(15,23,42,.02);
    }
    .campaign-preview-meta {
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:10px;
    }
    .campaign-mapping-grid {
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:12px;
    }
    .campaign-mapping-card {
      padding:12px;
      border-radius:16px;
      border:1px solid rgba(148,163,184,.1);
      background:rgba(148,163,184,.06);
      display:grid;
      gap:8px;
    }
    .campaign-mapping-card.required {
      border-color:rgba(245,158,11,.25);
      background:rgba(245,158,11,.08);
    }
    .campaign-mapping-label {
      display:flex;
      justify-content:space-between;
      gap:8px;
      align-items:center;
      color:var(--text);
      font-weight:700;
      font-size:13px;
    }
    .campaign-mapping-description {
      color:var(--muted);
      font-size:12px;
      line-height:1.6;
    }
    .campaign-preview-table-wrap {
      overflow:auto;
      border-radius:16px;
      border:1px solid rgba(148,163,184,.12);
      background:rgba(15,23,42,.02);
    }
    .campaign-preview-table {
      width:100%;
      min-width:540px;
      border-collapse:collapse;
    }
    .campaign-preview-table th,
    .campaign-preview-table td {
      padding:10px 12px;
      border-bottom:1px solid rgba(148,163,184,.12);
      text-align:left;
      vertical-align:top;
      font-size:13px;
    }
    .campaign-preview-table th {
      background:rgba(99,102,241,.08);
      color:var(--text);
      font-weight:700;
    }
    @media (max-width: 1280px) {
      .campaign-console-grid, .campaign-builder-grid, .campaign-html-grid { grid-template-columns:1fr; }
      .campaign-sticky { position:static; }
      .campaign-hero-panel { grid-template-columns:1fr; }
    }
    @media (max-width: 820px) {
      .campaign-stat-grid,
      .campaign-form-grid,
      .campaign-form-grid--triple,
      .campaign-mini-grid,
      .campaign-hero-steps,
      .campaign-manager-toolbar,
      .campaign-preview-meta,
      .campaign-mapping-grid,
      .campaign-selected-grid {
        grid-template-columns:1fr;
      }
      .campaign-list-metrics { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    }
  </style>
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/admin-nav', { activePage: 'campaigns' }) %>
    <main class="admin-content">
      <div class="admin-header">
        <div>
          <h1>Campaign Console</h1>
          <div style="color:var(--muted); font-size:13px; margin-top:4px;">Manage existing campaigns, edit the selected campaign, and import mapped audiences from CSV or Excel.</div>
        </div>
        <div class="campaign-toolbar">
          <button id="newCampaignBtn" class="btn btn-secondary">New Campaign</button>
          <button id="saveCampaignBtn" class="btn btn-primary">Save Draft</button>
          <button id="launchCampaignBtn" class="btn btn-success">Launch</button>
          <button id="pauseCampaignBtn" class="btn btn-secondary">Pause</button>
          <button id="resumeCampaignBtn" class="btn btn-secondary">Resume</button>
          <button id="cancelCampaignBtn" class="btn btn-danger">Cancel</button>
        </div>
      </div>

      <section class="campaign-hero-panel">
        <div class="campaign-hero-copy">
          <div class="campaign-hero-pill">Campaign Operations</div>
          <h2>See every campaign, manage the current one, and import mapped audiences properly.</h2>
          <p>This page now separates the three real jobs: finding and reopening other campaigns, editing the campaign you have selected, and building reusable audiences from uploaded CSV or Excel files with extracted headers and explicit field mapping.</p>
          <div class="campaign-hero-steps">
            <div class="campaign-hero-step">
              <span class="campaign-hero-step-badge">1</span>
              <strong>Manage campaigns</strong>
              <span>Use the manager list to search, filter, and reopen any draft, running, paused, or completed campaign.</span>
            </div>
            <div class="campaign-hero-step">
              <span class="campaign-hero-step-badge">2</span>
              <strong>Edit and test</strong>
              <span>Keep sender, audience, pacing, and content in one place, then send test emails before launch.</span>
            </div>
            <div class="campaign-hero-step">
              <span class="campaign-hero-step-badge">3</span>
              <strong>Extract and map</strong>
              <span>Upload CSV or Excel, inspect the detected columns, map the important fields, preview rows, then import.</span>
            </div>
          </div>
        </div>
        <aside class="campaign-hero-aside">
          <h3>How to use this page</h3>
          <p>Click any campaign card in the manager to load it back into the editor. The active campaign snapshot on the right shows what you are currently editing.</p>
          <p>The audience studio is no longer a blind upload. Extract the columns first, map them, then import the audience into the library and select it in the form.</p>
        </aside>
      </section>

      <div class="campaign-stat-grid">
        <div class="campaign-stat-card">
          <div class="admin-stat-label">Campaigns</div>
          <div id="campaignStatTotal" class="admin-stat-value"><%= campaigns.length %></div>
        </div>
        <div class="campaign-stat-card">
          <div class="admin-stat-label">Audiences</div>
          <div id="campaignStatAudiences" class="admin-stat-value"><%= audiences.length %></div>
        </div>
        <div class="campaign-stat-card">
          <div class="admin-stat-label">Templates</div>
          <div id="campaignStatTemplates" class="admin-stat-value"><%= templates.length %></div>
        </div>
        <div class="campaign-stat-card">
          <div class="admin-stat-label">Healthy Senders</div>
          <div id="campaignStatHealthySenders" class="admin-stat-value"><%= senderHealth.filter((item) => item.readinessBand === 'green').length %></div>
        </div>
      </div>

      <div class="campaign-console-grid">
        <section class="campaign-shell">
          <div class="admin-card">
            <div class="admin-card-header">
              <div>
                <div class="admin-card-title">Campaign Setup</div>
                <div class="admin-card-subtitle">Define the audience, sender, pacing, and campaign metadata before launch.</div>
              </div>
            </div>
            <form id="campaignForm" class="campaign-shell">
              <input type="hidden" id="campaignId">
              <div class="campaign-form-grid">
                <div class="admin-form-group">
                  <label class="admin-form-label">Campaign name</label>
                  <input id="campaignName" class="admin-form-input" type="text" placeholder="Seemplify HR Launch">
                </div>
                <div class="admin-form-group">
                  <label class="admin-form-label">Audience</label>
                  <select id="campaignAudience" class="admin-form-select"></select>
                </div>
              </div>
              <div class="campaign-form-grid">
                <div class="admin-form-group">
                  <label class="admin-form-label">Sender name</label>
                  <input id="senderName" class="admin-form-input" type="text" placeholder="Seemplify">
                </div>
                <div class="admin-form-group">
                  <label class="admin-form-label">Sender email</label>
                  <input id="senderEmail" class="admin-form-input" type="email" placeholder="campaigns@seemplifyai.com">
                </div>
              </div>
              <div class="campaign-form-grid">
                <div class="admin-form-group">
                  <label class="admin-form-label">Subject</label>
                  <input id="campaignSubject" class="admin-form-input" type="text" placeholder="{{ contact.FIRSTNAME }}, simplify HR operations with Seemplify">
                </div>
                <div class="admin-form-group">
                  <label class="admin-form-label">Preview text</label>
                  <input id="campaignPreviewText" class="admin-form-input" type="text" placeholder="One operating system for recruiting, onboarding, approvals, payroll, and performance.">
                </div>
              </div>
              <div class="campaign-form-grid campaign-form-grid--triple">
                <div class="admin-form-group">
                  <label class="admin-form-label">Reply-to</label>
                  <input id="campaignReplyTo" class="admin-form-input" type="email" placeholder="hello@seemplifyai.com">
                </div>
                <div class="admin-form-group">
                  <label class="admin-form-label">Batch size</label>
                  <input id="campaignBatchSize" class="admin-form-input" type="number" min="1" value="200">
                </div>
                <div class="admin-form-group">
                  <label class="admin-form-label">Interval (minutes)</label>
                  <input id="campaignIntervalMinutes" class="admin-form-input" type="number" min="1" value="30">
                </div>
              </div>
              <div class="campaign-form-grid campaign-form-grid--triple">
                <div class="admin-form-group">
                  <label class="admin-form-label">UTM source</label>
                  <input id="campaignUtmSource" class="admin-form-input" type="text" value="seemplify">
                </div>
                <div class="admin-form-group">
                  <label class="admin-form-label">UTM medium</label>
                  <input id="campaignUtmMedium" class="admin-form-input" type="text" value="email">
                </div>
                <div class="admin-form-group">
                  <label class="admin-form-label">UTM campaign</label>
                  <input id="campaignUtmCampaign" class="admin-form-input" type="text" placeholder="seemplify-launch">
                </div>
              </div>
              <div class="campaign-form-grid">
                <div class="admin-form-group">
                  <label class="admin-form-label">Template</label>
                  <select id="campaignTemplate" class="admin-form-select"></select>
                </div>
                <div class="admin-form-group">
                  <label class="admin-form-label">Test emails</label>
                  <input id="campaignTestEmails" class="admin-form-input" type="text" placeholder="you@company.com, teammate@company.com">
                </div>
              </div>
              <label class="admin-form-checkbox">
                <input id="allowExternalDecoration" type="checkbox">
                <span>Decorate external links with UTM parameters</span>
              </label>
            </form>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div>
                <div class="admin-card-title">Email Builder</div>
                <div class="admin-card-subtitle">Use the visual builder or raw HTML mode. Select text in preview mode to add or edit hyperlinks in place.</div>
              </div>
              <div class="campaign-mode-toggle">
                <button id="visualModeBtn" type="button" class="active">Visual</button>
                <button id="htmlModeBtn" type="button">HTML</button>
              </div>
            </div>

            <div id="visualBuilder" class="campaign-builder-grid">
              <aside class="campaign-palette">
                <div class="campaign-palette-list">
                  <div class="campaign-palette-item"><div><strong>Hero</strong><div class="admin-card-subtitle">Lead section with primary CTA</div></div><button data-add-block="hero" class="btn btn-secondary btn-sm" type="button">Add</button></div>
                  <div class="campaign-palette-item"><div><strong>Text</strong><div class="admin-card-subtitle">Free-form narrative block</div></div><button data-add-block="text" class="btn btn-secondary btn-sm" type="button">Add</button></div>
                  <div class="campaign-palette-item"><div><strong>Features</strong><div class="admin-card-subtitle">Structured benefits list</div></div><button data-add-block="features" class="btn btn-secondary btn-sm" type="button">Add</button></div>
                  <div class="campaign-palette-item"><div><strong>CTA</strong><div class="admin-card-subtitle">Standalone call-to-action panel</div></div><button data-add-block="cta" class="btn btn-secondary btn-sm" type="button">Add</button></div>
                  <div class="campaign-palette-item"><div><strong>Divider</strong><div class="admin-card-subtitle">Visual spacing break</div></div><button data-add-block="divider" class="btn btn-secondary btn-sm" type="button">Add</button></div>
                  <div class="campaign-palette-item"><div><strong>Footer</strong><div class="admin-card-subtitle">Compliance footer and unsubscribe note</div></div><button data-add-block="footer" class="btn btn-secondary btn-sm" type="button">Add</button></div>
                </div>
                <div class="campaign-empty-state">
                  Drag blocks to reorder them. Text blocks are editable directly inside the preview.
                </div>
              </aside>
              <div class="campaign-preview-shell">
                <div class="campaign-preview-canvas">
                  <div id="visualPreview" class="campaign-preview-stack"></div>
                </div>
              </div>
            </div>

            <div id="htmlBuilder" class="campaign-html-grid" style="display:none;">
              <div class="admin-form-group" style="margin:0;">
                <label class="admin-form-label">HTML source</label>
                <textarea id="htmlEditor" class="admin-form-textarea campaign-html-editor" spellcheck="false"></textarea>
              </div>
              <div class="admin-form-group" style="margin:0;">
                <label class="admin-form-label">Preview</label>
                <div id="htmlPreview" class="campaign-html-preview campaign-preview-editable" contenteditable="true"></div>
              </div>
            </div>

            <div class="campaign-toolbar" style="margin-top:18px;">
              <button id="sendTestBtn" class="btn btn-secondary" type="button">Send Test</button>
              <a id="campaignDetailLink" class="btn btn-secondary" href="#" target="_blank" rel="noopener noreferrer">Open Analytics</a>
            </div>
          </div>
        </section>

        <aside class="campaign-sticky">
          <div class="admin-card">
            <div class="admin-card-header">
              <div>
                <div class="admin-card-title">Campaigns</div>
                <div class="admin-card-subtitle">This is where you see and manage other campaigns. Search, filter, and reopen any campaign from here.</div>
              </div>
            </div>
            <div class="campaign-manager-toolbar">
              <div class="admin-form-group" style="margin:0;">
                <label class="admin-form-label">Search campaigns</label>
                <input id="campaignSearchInput" class="admin-form-input" type="search" placeholder="Search by campaign, sender, audience, or status">
              </div>
              <div class="admin-form-group" style="margin:0;">
                <label class="admin-form-label">Status</label>
                <select id="campaignStatusFilter" class="admin-form-select">
                  <option value="all">All statuses</option>
                  <option value="draft">Draft</option>
                  <option value="ready">Ready</option>
                  <option value="scheduled">Scheduled</option>
                  <option value="running">Running</option>
                  <option value="paused">Paused</option>
                  <option value="completed">Completed</option>
                  <option value="cancelled">Cancelled</option>
                  <option value="failed">Failed</option>
                </select>
              </div>
            </div>
            <div id="campaignListSummary" class="campaign-manager-summary">Showing the most recent campaigns.</div>
            <div id="campaignList" class="campaign-card-stack"></div>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div>
                <div class="admin-card-title">Active Campaign Snapshot</div>
                <div class="admin-card-subtitle">A quick view of the campaign you currently have loaded into the editor.</div>
              </div>
            </div>
            <div id="selectedCampaignSummary" class="campaign-selected-card"></div>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div>
                <div class="admin-card-title">Audience Studio</div>
                <div class="admin-card-subtitle">Upload CSV or Excel, extract the fields, map them explicitly, preview the rows, then import the audience.</div>
              </div>
            </div>
            <div class="campaign-audience-hint">
              Step 1: choose the file. Step 2: click <strong>Extract Fields</strong>. Step 3: map the detected headers. Step 4: click <strong>Import Audience</strong>. You can then assign that audience in the campaign form.
            </div>
            <form id="audienceUploadForm" class="campaign-upload-form">
              <input id="audienceName" class="admin-form-input" type="text" placeholder="Audience name">
              <input id="audienceDescription" class="admin-form-input" type="text" placeholder="Audience description (optional)">
              <input id="audienceFile" class="admin-form-input" type="file" accept=".csv,.xlsx,.xls,text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
              <div id="audienceSheetGroup" class="admin-form-group" style="display:none; margin:0;">
                <label class="admin-form-label">Workbook sheet</label>
                <select id="audienceSheetSelect" class="admin-form-select"></select>
              </div>
              <div class="campaign-upload-actions">
                <button id="audiencePreviewBtn" class="btn btn-secondary" type="submit">Extract Fields</button>
                <button id="audienceImportBtn" class="btn btn-primary" type="button" disabled>Import Audience</button>
                <button id="audienceResetBtn" class="btn btn-secondary" type="button">Reset</button>
              </div>
            </form>
            <div id="audienceImportStatus" class="campaign-audience-status">No file extracted yet.</div>
            <div id="audienceMappingPanel" class="campaign-mapping-panel" style="display:none;">
              <div id="audiencePreviewMeta" class="campaign-preview-meta"></div>
              <div>
                <div class="admin-card-title" style="font-size:15px; margin-bottom:8px;">Field Mapping</div>
                <div id="audienceColumnMapping" class="campaign-mapping-grid"></div>
              </div>
              <div>
                <div class="admin-card-title" style="font-size:15px; margin-bottom:8px;">Sample Rows</div>
                <div id="audiencePreviewTable" class="campaign-preview-table-wrap"></div>
              </div>
            </div>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div>
                <div class="admin-card-title">Audience Library</div>
                <div class="admin-card-subtitle">Reusable imported audiences. Import them in the studio above, then assign them to campaigns.</div>
              </div>
            </div>
            <div id="audienceList" class="campaign-card-stack" style="margin-top:16px;"></div>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div>
                <div class="admin-card-title">Template Library</div>
                <div class="admin-card-subtitle">Start from a Seemplify template, then customize every block or switch to HTML.</div>
              </div>
            </div>
            <div id="templateList" class="campaign-card-stack"></div>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div>
                <div class="admin-card-title">Sender Health</div>
                <div class="admin-card-subtitle">Warn-and-override readiness based on Brevo sender state, domain verification, webhook status, and recent local health.</div>
              </div>
            </div>
            <div id="senderHealthList" class="campaign-health-list"></div>
          </div>
        </aside>
      </div>
    </main>
  </div>

  <div id="linkPopover" class="campaign-link-popover">
    <input id="linkPopoverInput" class="admin-form-input" type="url" placeholder="https://auth.seemplifyai.com/signup">
    <div class="campaign-link-popover-actions">
      <button id="unlinkSelectionBtn" class="btn btn-secondary btn-sm" type="button">Remove link</button>
      <button id="applyLinkBtn" class="btn btn-primary btn-sm" type="button">Apply</button>
    </div>
  </div>

  <script>
    window.__CAMPAIGN_CONSOLE__ = <%- JSON.stringify({
      campaigns,
      audiences,
      templates,
      senderHealth,
      audienceFields
    }).replace(/</g, '\\u003c') %>
  </script>
  <script src="/js/admin-campaign-console.js"></script>
</body>
</html>
