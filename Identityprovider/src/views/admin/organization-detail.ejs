<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Organization Details - Admin - Seemplify IDP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../../public/css/idp-theme.css') %>

    .org-detail-grid {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 20px;
      margin-bottom: 24px;
    }

    .org-detail-stack {
      display: grid;
      gap: 20px;
      align-content: start;
    }

    .org-meta-line {
      font-size: 13px;
      color: var(--muted);
      margin-top: 4px;
      word-break: break-word;
    }

    .org-kv-list {
      display: grid;
      gap: 10px;
    }

    .org-kv-item {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      gap: 10px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
      font-size: 14px;
    }

    .org-kv-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .org-kv-key {
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
    }

    .org-kv-value {
      color: var(--text);
      word-break: break-word;
    }

    .org-muted {
      color: var(--muted);
      font-size: 12px;
    }

    .org-activity-list {
      display: grid;
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .org-activity-item {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px;
      background: var(--panel-strong);
    }

    .org-activity-title {
      font-size: 13px;
      color: var(--text);
      margin: 0 0 6px;
      line-height: 1.45;
    }

    .org-activity-meta {
      font-size: 12px;
      color: var(--muted);
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .org-pill {
      display: inline-flex;
      padding: 3px 8px;
      border-radius: 999px;
      background: var(--hover-bg);
      color: var(--muted);
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .org-invite-list {
      display: grid;
      gap: 12px;
    }

    .org-invite-item {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      background: var(--panel-strong);
      display: grid;
      gap: 10px;
    }

    .org-invite-header {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .org-invite-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
    }

    .org-invite-meta {
      display: grid;
      gap: 4px;
      font-size: 12px;
      color: var(--muted);
    }

    .org-invite-form {
      display: grid;
      gap: 14px;
    }

    .org-invite-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }

    .org-toggle-note {
      display: grid;
      gap: 4px;
      margin-top: 6px;
    }

    .org-action-panel {
      display: grid;
      gap: 14px;
      margin-bottom: 18px;
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--panel-strong);
    }

    .org-action-toolbar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }

    .org-action-buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .org-action-summary {
      font-size: 13px;
      color: var(--muted);
    }

    .org-table-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .org-checkbox-cell {
      width: 40px;
    }

    .org-member-flags {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 6px;
    }

    .org-mini-badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 2px 8px;
      font-size: 11px;
      font-weight: 700;
      background: rgba(59, 130, 246, 0.12);
      color: #93c5fd;
    }

    .org-mini-badge--danger {
      background: rgba(239, 68, 68, 0.12);
      color: #fca5a5;
    }

    .org-danger-zone {
      border-color: rgba(239, 68, 68, 0.3);
    }

    @media (max-width: 1100px) {
      .org-detail-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .org-kv-item {
        grid-template-columns: 1fr;
        gap: 6px;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/theme.js?v=3"></script>
</head>

<body>
  <% const activeMembers = members.filter(member => member.status === 'active'); %>
  <% const inactiveMembers = members.filter(member => member.status !== 'active'); %>
  <% const pendingRequests = requests.filter(request => request.status === 'pending').length; %>
  <% const currentSubscription = organization.activeSubscription; %>
  <% const statusBadgeClass = organization.subscriptionStatus === 'none' ? 'cancelled' : (organization.subscriptionStatus || 'pending'); %>
  <% const launchItems = appLaunches || []; %>
  <% const onboardingItems = onboardingAssignments || []; %>
  <% const inviteItems = pendingInvitations || []; %>
  <% const inviteTeamOptions = inviteTeams || []; %>
  <% const successfulLaunches = launchItems.filter(item => item.isSuccessful).length; %>
  <% const onboardingInProgress = onboardingSummary?.inProgress || 0; %>
  <% const replacementCandidates = activeMembers.filter(member => member.account); %>

  <div class="admin-layout">
    <%- include('../partials/admin-nav', { activePage: 'organizations' }) %>

    <main class="admin-content">
      <div class="admin-header">
        <div>
          <h1><%= organization.name || 'Organization' %></h1>
          <div class="org-meta-line">Organization ID: <%= organization._id %></div>
        </div>
        <div class="admin-header-actions">
          <a href="/organizations/<%= organization._id %>/access-control" class="btn btn-primary">Roles &amp; Permissions</a>
          <a href="/admin/organizations" class="btn btn-secondary">Back to Organizations</a>
          <a href="/admin/subscriptions" class="btn btn-secondary">Subscriptions</a>
          <a href="/admin/requests" class="btn btn-secondary">Requests</a>
        </div>
      </div>

      <% if (notice) { %>
        <div class="alert <%= noticeType === 'error' ? 'alert-danger' : 'alert-success' %>">
          <span class="alert-icon"><%= noticeType === 'error' ? '⚠' : '✓' %></span>
          <span><%= notice %></span>
        </div>
      <% } %>

      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <div class="admin-stat-label">Active Members</div>
          <div class="admin-stat-value"><%= activeMembers.length %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Pending Requests</div>
          <div class="admin-stat-value" style="color: <%= pendingRequests > 0 ? '#f59e0b' : 'var(--text)' %>"><%= pendingRequests %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Subscription Records</div>
          <div class="admin-stat-value"><%= subscriptions.length %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Subscription Status</div>
          <div class="admin-stat-value" style="font-size: 18px;">
            <span class="status-badge status-badge--<%= statusBadgeClass %>"><%= organization.subscriptionStatus || 'none' %></span>
          </div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">App Launch Clicks</div>
          <div class="admin-stat-value"><%= launchItems.length %></div>
          <div class="org-muted"><%= successfulLaunches %> successful</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Onboarding</div>
          <div class="admin-stat-value"><%= onboardingItems.length %></div>
          <div class="org-muted"><%= onboardingInProgress %> in progress</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Pending Invites</div>
          <div class="admin-stat-value"><%= inviteItems.length %></div>
        </div>
      </div>

      <div class="org-detail-grid">
        <section class="org-detail-stack">
          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">Users</div>
            </div>

            <% if (members.length > 0) { %>
              <form id="member-action-form" method="post" action="/admin/organizations/<%= organization._id %>/members/action" class="org-action-panel">
                <input type="hidden" id="member-action-input" name="action" value="">

                <div class="org-action-toolbar">
                  <div class="org-action-summary">
                    <strong id="selected-member-count">0</strong> selected.
                    Remove detaches users from this organization only. Delete permanently removes the account from IDP when it has no other active organizations.
                  </div>
                  <div class="org-action-buttons">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="submitMemberAction('remove_members')">Remove Selected</button>
                    <button type="button" class="btn btn-danger btn-sm" onclick="submitMemberAction('delete_accounts')">Delete Selected Accounts</button>
                  </div>
                </div>

                <div class="admin-form-row">
                  <div class="admin-form-group">
                    <label class="admin-form-label" for="owner-replacement-id">Owner Replacement</label>
                    <select id="owner-replacement-id" name="ownerReplacementId" class="admin-form-select">
                      <option value="">Select if required</option>
                      <% replacementCandidates.forEach(member => { %>
                        <option value="<%= member.account._id %>">
                          <%= member.account.profile?.name || member.account.email || 'Unknown user' %> (<%= member.role.replace(/_/g, ' ') %>)
                        </option>
                      <% }) %>
                    </select>
                    <div class="org-muted" style="margin-top: 6px;">Required if the selected members include the last owner and the organization will continue.</div>
                  </div>

                  <div class="admin-form-group">
                    <label class="admin-form-label" for="admin-replacement-id">Admin Replacement</label>
                    <select id="admin-replacement-id" name="adminReplacementId" class="admin-form-select">
                      <option value="">Select if required</option>
                      <% replacementCandidates.forEach(member => { %>
                        <option value="<%= member.account._id %>">
                          <%= member.account.profile?.name || member.account.email || 'Unknown user' %> (<%= member.role.replace(/_/g, ' ') %>)
                        </option>
                      <% }) %>
                    </select>
                    <div class="org-muted" style="margin-top: 6px;">Required if the selected members include the last active organization admin and the organization will continue.</div>
                  </div>
                </div>

                <label class="admin-form-checkbox">
                  <input id="delete-org-if-empty" name="deleteOrganizationIfEmpty" type="checkbox" value="1">
                  <span>Delete the organization too if this action would remove every remaining member</span>
                </label>
              </form>

              <div class="admin-table-container" style="border: none;">
                <table class="admin-table">
                  <thead>
                    <tr>
                      <th class="org-checkbox-cell">
                        <input type="checkbox" id="select-all-members">
                      </th>
                      <th>User</th>
                      <th>Role</th>
                      <th>Status</th>
                      <th>Joined</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% members.forEach(member => { %>
                      <tr>
                        <td class="org-checkbox-cell">
                          <% if (member.status === 'active') { %>
                            <input
                              type="checkbox"
                              class="member-select-checkbox"
                              form="member-action-form"
                              name="memberIds"
                              value="<%= member.account?._id || '' %>"
                            >
                          <% } %>
                        </td>
                        <td>
                          <div style="font-weight: 600;"><%= member.account?.profile?.name || member.account?.email || 'Unknown user' %></div>
                          <div class="org-muted"><%= member.account?.email || 'N/A' %></div>
                          <div class="org-member-flags">
                            <% if (member.role === 'owner') { %>
                              <span class="org-mini-badge">Owner</span>
                            <% } %>
                            <% if (member.account?.isSystemAdmin || member.account?.isSuperAdmin) { %>
                              <span class="org-mini-badge org-mini-badge--danger">Protected admin account</span>
                            <% } %>
                          </div>
                        </td>
                        <td style="text-transform: capitalize;"><%= (member.role || 'unknown').replace(/_/g, ' ') %></td>
                        <td>
                          <span class="status-badge status-badge--<%= member.status === 'active' ? 'active' : 'cancelled' %>"><%= member.status || 'unknown' %></span>
                        </td>
                        <td>
                          <%= member.joinedAt ? new Date(member.joinedAt).toLocaleDateString() : 'N/A' %>
                        </td>
                        <td>
                          <% if (member.status === 'active' && member.account?._id) { %>
                            <div class="org-table-actions">
                              <button type="button" class="btn btn-sm btn-secondary" onclick='submitSingleMemberAction("remove_members", "<%= member.account._id %>", <%- JSON.stringify(member.account?.profile?.name || member.account?.email || "this member") %>)'>Remove</button>
                              <% if (member.account?.isSystemAdmin || member.account?.isSuperAdmin) { %>
                                <span class="org-muted">Delete blocked</span>
                              <% } else { %>
                                <button type="button" class="btn btn-sm btn-danger" onclick='submitSingleMemberAction("delete_accounts", "<%= member.account._id %>", <%- JSON.stringify(member.account?.profile?.name || member.account?.email || "this member") %>)'>Delete Account</button>
                              <% } %>
                            </div>
                          <% } else { %>
                            <span class="org-muted">-</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="admin-empty" style="padding: 16px;">
                <p>No members found for this organization.</p>
              </div>
            <% } %>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">Plan Request Activity</div>
            </div>

            <% if (requests.length > 0) { %>
              <div class="admin-table-container" style="border: none;">
                <table class="admin-table">
                  <thead>
                    <tr>
                      <th>Request</th>
                      <th>Requested By</th>
                      <th>Status</th>
                      <th>Submitted</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% requests.forEach(request => { %>
                      <tr>
                        <td>
                          <div style="font-weight: 600;"><%= request.plan?.name || 'Unknown plan' %></div>
                          <div class="org-muted">
                            <%= request.requestTypeDisplay || request.requestType || 'Request' %>
                            <% if (request.formattedPrice) { %> - <%= request.formattedPrice %><% } %>
                          </div>
                        </td>
                        <td>
                          <div><%= request.requestedBy?.profile?.name || request.requestedBy?.email || 'Unknown' %></div>
                          <div class="org-muted"><%= request.requestedBy?.email || 'N/A' %></div>
                        </td>
                        <td>
                          <span class="status-badge status-badge--<%= request.status || 'pending' %>"><%= request.status || 'unknown' %></span>
                        </td>
                        <td><%= request.createdAt ? new Date(request.createdAt).toLocaleString() : 'N/A' %></td>
                        <td>
                          <a href="/admin/requests/<%= request._id %>" class="btn btn-sm btn-secondary">View</a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="admin-empty" style="padding: 16px;">
                <p>No subscription requests yet.</p>
              </div>
            <% } %>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">App Click Activity</div>
            </div>

            <% if (launchItems.length > 0) { %>
              <div class="admin-table-container" style="border: none;">
                <table class="admin-table">
                  <thead>
                    <tr>
                      <th>App</th>
                      <th>User</th>
                      <th>Outcome</th>
                      <th>Auth Flow</th>
                      <th>Time</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% launchItems.forEach(launch => { %>
                      <tr>
                        <td>
                          <div style="font-weight: 600;"><%= launch.appName || launch.appId || 'Unknown app' %></div>
                          <div class="org-muted"><%= launch.appId || 'N/A' %></div>
                        </td>
                        <td>
                          <div><%= launch.account?.profile?.name || launch.account?.email || 'Unknown user' %></div>
                          <div class="org-muted"><%= launch.account?.email || 'N/A' %></div>
                        </td>
                        <td>
                          <span class="status-badge status-badge--<%= launch.badgeStatus || 'pending' %>"><%= launch.statusLabel || launch.status || 'unknown' %></span>
                        </td>
                        <td>
                          <%= launch.details?.authType || launch.source || 'hub' %>
                        </td>
                        <td>
                          <%= launch.createdAt ? new Date(launch.createdAt).toLocaleString() : 'N/A' %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="admin-empty" style="padding: 16px;">
                <p>No app clicks logged yet for this organization.</p>
              </div>
            <% } %>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">Subscription History</div>
            </div>

            <% if (subscriptions.length > 0) { %>
              <div class="admin-table-container" style="border: none;">
                <table class="admin-table">
                  <thead>
                    <tr>
                      <th>Plan</th>
                      <th>Status</th>
                      <th>Period</th>
                      <th>Approved By</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% subscriptions.forEach(subscription => { %>
                      <tr>
                        <td>
                          <div style="font-weight: 600;"><%= subscription.plan?.name || 'Unknown plan' %></div>
                          <div class="org-muted"><%= subscription.formattedPrice || '' %></div>
                        </td>
                        <td>
                          <span class="status-badge status-badge--<%= subscription.status || 'pending' %>"><%= subscription.status || 'unknown' %></span>
                        </td>
                        <td>
                          <div><%= subscription.startDate ? new Date(subscription.startDate).toLocaleDateString() : 'N/A' %></div>
                          <div class="org-muted">to <%= subscription.endDate ? new Date(subscription.endDate).toLocaleDateString() : 'N/A' %></div>
                        </td>
                        <td>
                          <div><%= subscription.approvedBy?.profile?.name || subscription.approvedBy?.email || 'N/A' %></div>
                          <div class="org-muted"><%= subscription.approvedAt ? new Date(subscription.approvedAt).toLocaleString() : '' %></div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="admin-empty" style="padding: 16px;">
                <p>No subscriptions found for this organization.</p>
              </div>
            <% } %>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">Onboarding Activity</div>
            </div>

            <% if (onboardingItems.length > 0) { %>
              <div class="admin-table-container" style="border: none;">
                <table class="admin-table">
                  <thead>
                    <tr>
                      <th>Member</th>
                      <th>Template</th>
                      <th>Progress</th>
                      <th>Status</th>
                      <th>Updated</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% onboardingItems.forEach(assignment => { %>
                      <tr>
                        <td>
                          <div style="font-weight: 600;"><%= assignment.member?.profile?.name || assignment.member?.email || 'Unknown member' %></div>
                          <div class="org-muted"><%= assignment.member?.email || 'N/A' %></div>
                        </td>
                        <td>
                          <div><%= assignment.template?.name || 'Custom Assignment' %></div>
                          <% if (assignment.dueAt) { %>
                            <div class="org-muted">Due: <%= new Date(assignment.dueAt).toLocaleDateString() %></div>
                          <% } %>
                        </td>
                        <td>
                          <% if (assignment.totalItems > 0) { %>
                            <%= assignment.completedItems %> / <%= assignment.totalItems %> completed
                          <% } else { %>
                            N/A
                          <% } %>
                        </td>
                        <td>
                          <span class="status-badge status-badge--<%= assignment.badgeStatus || 'pending' %>"><%= (assignment.status || 'unknown').replace(/_/g, ' ') %></span>
                        </td>
                        <td>
                          <div><%= assignment.updatedAt ? new Date(assignment.updatedAt).toLocaleString() : 'N/A' %></div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="admin-empty" style="padding: 16px;">
                <p>No onboarding assignments found for this organization.</p>
              </div>
            <% } %>
          </div>

          <div class="admin-card org-danger-zone">
            <div class="admin-card-header">
              <div class="admin-card-title">Organization Removal</div>
            </div>
            <div class="org-muted" style="margin-bottom: 14px;">
              Delete the entire organization, all teams, invitations, onboarding records, subscriptions, and related admin data.
            </div>
            <form method="post" action="/admin/organizations/<%= organization._id %>/members/action" onsubmit='return window.confirm("Delete " + <%- JSON.stringify(organization.name || "this organization") %> + "? This cannot be undone.");'>
              <input type="hidden" name="action" value="delete_organization">
              <div class="org-table-actions">
                <button type="submit" class="btn btn-danger">Delete Organization</button>
              </div>
            </form>
          </div>
        </section>

        <aside class="org-detail-stack">
          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">Organization Invitations</div>
            </div>

            <form method="post" action="/admin/organizations/<%= organization._id %>/invitations" class="org-invite-form">
              <div class="admin-form-row">
                <div class="admin-form-group">
                  <label class="admin-form-label" for="invite-email">Email</label>
                  <input id="invite-email" name="email" type="email" class="admin-form-input" placeholder="new.member@example.com" required>
                </div>
                <div class="admin-form-group">
                  <label class="admin-form-label" for="invite-role">Role</label>
                  <select id="invite-role" name="role" class="admin-form-select" required>
                    <option value="recruiter">Recruiter</option>
                    <option value="staff">Staff</option>
                    <option value="interviewer">Interviewer</option>
                    <option value="hr_manager">HR Manager</option>
                    <option value="admin">Admin</option>
                  </select>
                </div>
              </div>

              <div class="admin-form-row">
                <div class="admin-form-group">
                  <label class="admin-form-label" for="invite-designation">Designation</label>
                  <input id="invite-designation" name="designation" type="text" class="admin-form-input" placeholder="Product Designer" required>
                </div>
                <div class="admin-form-group">
                  <label class="admin-form-label" for="invite-employee-id">Employee ID</label>
                  <input id="invite-employee-id" name="employeeId" type="text" class="admin-form-input" placeholder="Optional">
                </div>
              </div>

              <div class="admin-form-group">
                <label class="admin-form-label" for="invite-team">Team</label>
                <select id="invite-team" name="team" class="admin-form-select" <%= inviteTeamOptions.length === 0 ? 'disabled' : 'required' %>>
                  <% if (inviteTeamOptions.length === 0) { %>
                    <option value="">No teams available</option>
                  <% } else { %>
                    <option value="">Select a team</option>
                    <% inviteTeamOptions.forEach(team => { %>
                      <option value="<%= team.id %>"><%= team.name %> (<%= team.departmentName %>)</option>
                    <% }) %>
                  <% } %>
                </select>
                <% if (inviteTeamOptions.length === 0) { %>
                  <div class="org-muted" style="margin-top: 6px;">Create at least one team in this organization before sending invites.</div>
                <% } %>
              </div>

              <label class="admin-form-checkbox">
                <input id="invite-send-as-reminder" name="sendAsReminder" type="checkbox" value="1">
                <span>Send as reminder</span>
              </label>
              <div class="org-toggle-note org-muted">
                <span>If enabled, the email is sent with reminder wording instead of first-time invitation wording.</span>
                <span>If a pending invite already exists for this email, it will be refreshed and resent instead of being blocked.</span>
              </div>

              <div class="org-invite-actions">
                <div class="org-muted">New invites grant access to all assigned workspace apps by default.</div>
                <button id="invite-submit-button" type="submit" class="btn btn-primary" <%= inviteTeamOptions.length === 0 ? 'disabled' : '' %>>Send Invite</button>
              </div>
            </form>

            <div style="height: 1px; background: var(--border); margin: 20px 0;"></div>

            <% if (inviteItems.length > 0) { %>
              <div class="org-invite-list">
                <% inviteItems.forEach(invite => { %>
                  <div class="org-invite-item">
                    <div class="org-invite-header">
                      <div>
                        <div class="org-invite-title"><%= invite.email %></div>
                        <div class="org-muted"><%= invite.role.replace(/_/g, ' ') %> · <%= invite.designation %></div>
                      </div>
                      <span class="status-badge status-badge--pending">pending</span>
                    </div>
                    <div class="org-invite-meta">
                      <span>Department: <%= invite.departmentName %></span>
                      <span>Team: <%= invite.teamName %></span>
                      <% if (invite.employeeId) { %><span>Employee ID: <%= invite.employeeId %></span><% } %>
                      <span>Invited by: <%= invite.invitedBy?.profile?.name || invite.invitedBy?.email || 'System' %></span>
                      <span>Expires: <%= invite.expiresAt ? new Date(invite.expiresAt).toLocaleString() : 'N/A' %></span>
                    </div>
                    <div class="org-invite-actions">
                      <div class="org-muted">Created <%= invite.createdAt ? new Date(invite.createdAt).toLocaleString() : 'N/A' %></div>
                      <form method="post" action="/admin/organizations/<%= organization._id %>/invitations/<%= invite._id %>/reminder">
                        <button type="submit" class="btn btn-sm btn-secondary">Send Reminder</button>
                      </form>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="admin-empty" style="padding: 16px 0 0;">
                <p>No pending invitations for this organization.</p>
              </div>
            <% } %>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">Organization Overview</div>
            </div>
            <div class="org-kv-list">
              <div class="org-kv-item">
                <div class="org-kv-key">Owner</div>
                <div class="org-kv-value">
                  <%= organization.owner?.profile?.name || organization.owner?.email || 'Unknown' %><br>
                  <span class="org-muted"><%= organization.owner?.email || 'N/A' %></span>
                </div>
              </div>
              <div class="org-kv-item">
                <div class="org-kv-key">Description</div>
                <div class="org-kv-value"><%= organization.description || 'No description set' %></div>
              </div>
              <div class="org-kv-item">
                <div class="org-kv-key">Created</div>
                <div class="org-kv-value"><%= organization.createdAt ? new Date(organization.createdAt).toLocaleString() : 'N/A' %></div>
              </div>
              <div class="org-kv-item">
                <div class="org-kv-key">Members</div>
                <div class="org-kv-value">
                  <%= activeMembers.length %> active
                  <% if (inactiveMembers.length > 0) { %>
                    <span class="org-muted">, <%= inactiveMembers.length %> inactive</span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">Current Plan</div>
            </div>

            <% if (currentSubscription) { %>
              <div class="org-kv-list">
                <div class="org-kv-item">
                  <div class="org-kv-key">Plan</div>
                  <div class="org-kv-value"><%= currentSubscription.plan?.name || organization.currentPlan?.name || 'Unknown plan' %></div>
                </div>
                <div class="org-kv-item">
                  <div class="org-kv-key">Status</div>
                  <div class="org-kv-value">
                    <span class="status-badge status-badge--<%= currentSubscription.status || 'pending' %>"><%= currentSubscription.status || 'unknown' %></span>
                  </div>
                </div>
                <div class="org-kv-item">
                  <div class="org-kv-key">Billing</div>
                  <div class="org-kv-value">
                    <%= currentSubscription.billingCycle || 'N/A' %>
                    <% if (currentSubscription.formattedPrice) { %>
                      <span class="org-muted">- <%= currentSubscription.formattedPrice %></span>
                    <% } %>
                  </div>
                </div>
                <div class="org-kv-item">
                  <div class="org-kv-key">Period</div>
                  <div class="org-kv-value">
                    <%= currentSubscription.startDate ? new Date(currentSubscription.startDate).toLocaleDateString() : 'N/A' %>
                    to
                    <%= currentSubscription.endDate ? new Date(currentSubscription.endDate).toLocaleDateString() : 'N/A' %>
                  </div>
                </div>
              </div>
              <div class="org-table-actions" style="margin-top: 14px;">
                <a href="/admin/subscriptions" class="btn btn-sm btn-secondary">Open Subscriptions</a>
                <% if (['active', 'suspended', 'pending_renewal'].includes(currentSubscription.status)) { %>
                  <button
                    type="button"
                    class="btn btn-sm btn-secondary"
                    style="color: #ef4444;"
                    onclick='expireOrganizationSubscription("<%= currentSubscription._id %>", <%- JSON.stringify(organization.name || "this organization") %>)'>
                    Expire Plan Now
                  </button>
                <% } %>
              </div>
            <% } else if (organization.currentPlan) { %>
              <div class="org-kv-list">
                <div class="org-kv-item">
                  <div class="org-kv-key">Plan</div>
                  <div class="org-kv-value"><%= organization.currentPlan.name || 'Unknown plan' %></div>
                </div>
                <div class="org-kv-item">
                  <div class="org-kv-key">Status</div>
                  <div class="org-kv-value">Cached plan set, no active subscription record</div>
                </div>
              </div>
            <% } else { %>
              <div class="admin-empty" style="padding: 16px;">
                <p>No active plan assigned.</p>
              </div>
            <% } %>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">App Usage Summary</div>
            </div>
            <% if (appLaunchSummary && appLaunchSummary.length > 0) { %>
              <div class="org-kv-list">
                <% appLaunchSummary.forEach(summary => { %>
                  <div class="org-kv-item">
                    <div class="org-kv-key"><%= summary.appName %></div>
                    <div class="org-kv-value">
                      <strong><%= summary.totalLaunches %></strong> launches
                      <div class="org-muted">
                        <%= summary.successfulLaunches %> successful
                        <% if (summary.blockedLaunches > 0) { %>, <%= summary.blockedLaunches %> blocked<% } %>
                        <% if (summary.failedLaunches > 0) { %>, <%= summary.failedLaunches %> failed<% } %>
                      </div>
                      <% if (summary.lastUsedAt) { %>
                        <div class="org-muted">Last used: <%= new Date(summary.lastUsedAt).toLocaleString() %></div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="admin-empty" style="padding: 16px;">
                <p>No app usage summary available yet.</p>
              </div>
            <% } %>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">Onboarding Summary</div>
            </div>
            <div class="org-kv-list">
              <div class="org-kv-item">
                <div class="org-kv-key">Total</div>
                <div class="org-kv-value"><%= onboardingSummary?.total || 0 %> assignments</div>
              </div>
              <div class="org-kv-item">
                <div class="org-kv-key">Pending</div>
                <div class="org-kv-value"><%= onboardingSummary?.pending || 0 %></div>
              </div>
              <div class="org-kv-item">
                <div class="org-kv-key">In Progress</div>
                <div class="org-kv-value"><%= onboardingSummary?.inProgress || 0 %></div>
              </div>
              <div class="org-kv-item">
                <div class="org-kv-key">Completed</div>
                <div class="org-kv-value"><%= onboardingSummary?.completed || 0 %></div>
              </div>
              <div class="org-kv-item">
                <div class="org-kv-key">Cancelled</div>
                <div class="org-kv-value"><%= onboardingSummary?.cancelled || 0 %></div>
              </div>
            </div>
          </div>

          <div class="admin-card">
            <div class="admin-card-header">
              <div class="admin-card-title">Recent Activity</div>
            </div>
            <% if (activity.length > 0) { %>
              <ul class="org-activity-list">
                <% activity.forEach(item => { %>
                  <li class="org-activity-item">
                    <p class="org-activity-title"><%= item.title %></p>
                    <div class="org-activity-meta">
                      <span class="org-pill"><%= item.type %></span>
                      <span class="status-badge status-badge--<%= item.status || 'pending' %>"><%= item.status || 'unknown' %></span>
                    </div>
                    <div class="org-activity-meta" style="margin-top: 6px;">
                      <span><%= item.actor %></span>
                      <span><%= item.at ? new Date(item.at).toLocaleString() : '' %></span>
                    </div>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="admin-empty" style="padding: 16px;">
                <p>No recent activity yet.</p>
              </div>
            <% } %>
          </div>
        </aside>
      </div>
    </main>
  </div>

  <script>
    (function () {
      const reminderToggle = document.getElementById('invite-send-as-reminder');
      const submitButton = document.getElementById('invite-submit-button');
      if (!reminderToggle || !submitButton) return;

      const syncSubmitLabel = () => {
        submitButton.textContent = reminderToggle.checked ? 'Send Reminder' : 'Send Invite';
      };

      reminderToggle.addEventListener('change', syncSubmitLabel);
      syncSubmitLabel();
    })();

    (function () {
      const form = document.getElementById('member-action-form');
      const selectAll = document.getElementById('select-all-members');
      const selectedCount = document.getElementById('selected-member-count');
      const actionInput = document.getElementById('member-action-input');

      if (!form || !actionInput) return;

      const getCheckboxes = () => Array.from(document.querySelectorAll('.member-select-checkbox'));
      const getSelectedCheckboxes = () => getCheckboxes().filter(checkbox => checkbox.checked);

      const updateSelectionState = () => {
        const checkboxes = getCheckboxes();
        const checked = getSelectedCheckboxes();
        if (selectedCount) {
          selectedCount.textContent = String(checked.length);
        }
        if (selectAll) {
          selectAll.checked = checkboxes.length > 0 && checked.length === checkboxes.length;
          selectAll.indeterminate = checked.length > 0 && checked.length < checkboxes.length;
        }
      };

      if (selectAll) {
        selectAll.addEventListener('change', () => {
          getCheckboxes().forEach(checkbox => {
            checkbox.checked = selectAll.checked;
          });
          updateSelectionState();
        });
      }

      getCheckboxes().forEach(checkbox => {
        checkbox.addEventListener('change', updateSelectionState);
      });

      window.submitMemberAction = (action) => {
        const checked = getSelectedCheckboxes();
        if (checked.length === 0) {
          window.alert('Select at least one active member first.');
          return;
        }

        const actionLabel = action === 'delete_accounts' ? 'delete the selected account(s)' : 'remove the selected member(s)';
        if (!window.confirm(`Are you sure you want to ${actionLabel}?`)) {
          return;
        }

        actionInput.value = action;
        form.submit();
      };

      window.submitSingleMemberAction = (action, memberId, memberLabel) => {
        getCheckboxes().forEach(checkbox => {
          checkbox.checked = checkbox.value === memberId;
        });
        updateSelectionState();

        const actionLabel = action === 'delete_accounts' ? 'delete this account' : 'remove this member from the organization';
        if (!window.confirm(`Are you sure you want to ${actionLabel} for ${memberLabel}?`)) {
          return;
        }

        actionInput.value = action;
        form.submit();
      };

      updateSelectionState();
    })();

    async function expireOrganizationSubscription(subscriptionId, organizationName) {
      const reason = window.prompt('Reason for expiring this plan now (optional):');
      if (reason === null) return;

      if (!window.confirm(`Expire the current plan for ${organizationName || 'this organization'} now? Access will lock immediately and the grace period will start from today.`)) {
        return;
      }

      try {
        const response = await fetch(`/api/admin/subscriptions/${subscriptionId}/expire`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason })
        });
        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || 'Failed to expire subscription.');
        }

        window.location.reload();
      } catch (error) {
        window.alert(error.message || 'Failed to expire subscription.');
      }
    }
  </script>
</body>

</html>
