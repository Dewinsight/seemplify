<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Campaigns - Admin - Seemplify IDP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../../public/css/idp-theme.css') %>

    .campaign-home-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin-bottom: 24px;
    }

    .campaign-home-card {
      display: grid;
      gap: 16px;
      padding: 24px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: var(--panel);
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
    }

    .campaign-home-card h2 {
      margin: 0;
      font-size: 24px;
      color: var(--text);
      letter-spacing: -0.03em;
    }

    .campaign-home-card p {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
    }

    .campaign-home-kicker {
      display: inline-flex;
      width: max-content;
      padding: 6px 10px;
      border-radius: 999px;
      background: var(--panel-strong);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .campaign-home-list {
      margin: 0;
      padding-left: 18px;
      color: var(--muted);
      display: grid;
      gap: 8px;
    }

    .campaign-home-recent {
      display: grid;
      gap: 12px;
    }

    .campaign-home-recent-card {
      padding: 16px 18px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: var(--panel);
      display: grid;
      gap: 10px;
    }

    .campaign-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .campaign-status-pill.draft { background: rgba(245, 158, 11, 0.12); color: #fbbf24; }
    .campaign-status-pill.ready,
    .campaign-status-pill.scheduled,
    .campaign-status-pill.paused { background: rgba(59, 130, 246, 0.12); color: #93c5fd; }
    .campaign-status-pill.running,
    .campaign-status-pill.completed { background: rgba(34, 197, 94, 0.12); color: #86efac; }
    .campaign-status-pill.cancelled,
    .campaign-status-pill.failed { background: rgba(239, 68, 68, 0.12); color: #fca5a5; }

    .campaign-home-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    @media (max-width: 960px) {
      .campaign-home-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/theme.js?v=2"></script>
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/admin-nav', { activePage: 'campaigns' }) %>

    <main class="admin-content">
      <div class="admin-header">
        <div>
          <h1>Campaigns</h1>
          <div style="color: var(--muted); font-size: 13px; margin-top: 4px;">Choose what you want to do first, then drill into the right workspace.</div>
        </div>
      </div>

      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <div class="admin-stat-label">Total Campaigns</div>
          <div class="admin-stat-value"><%= stats.total %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Drafts</div>
          <div class="admin-stat-value"><%= stats.draft %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Running</div>
          <div class="admin-stat-value"><%= stats.running %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Completed</div>
          <div class="admin-stat-value"><%= stats.completed %></div>
        </div>
      </div>

      <div class="campaign-home-grid">
        <section class="campaign-home-card">
          <span class="campaign-home-kicker">Create Campaign</span>
          <h2>Start a new campaign in a focused workspace.</h2>
          <p>Open the campaign editor without the campaign list clutter. You can set the audience, sender, content, pacing, test emails, and imports in one dedicated workspace.</p>
          <ul class="campaign-home-list">
            <li>Create a new campaign from scratch</li>
            <li>Use templates and the visual builder</li>
            <li>Import and map audience files from CSV or Excel</li>
          </ul>
          <div class="campaign-home-actions">
            <a href="/admin/campaigns/create" class="btn btn-primary">Create Campaign</a>
          </div>
        </section>

        <section class="campaign-home-card">
          <span class="campaign-home-kicker">Manage Campaigns</span>
          <h2>Browse and reopen campaigns you already created.</h2>
          <p>Go to the management view to search, filter, and inspect existing campaigns before drilling into the editor or analytics for a specific one.</p>
          <ul class="campaign-home-list">
            <li>See all campaigns in one dedicated list</li>
            <li>Filter by status and search by name, sender, or audience</li>
            <li>Jump into edit or analytics for any campaign</li>
          </ul>
          <div class="campaign-home-actions">
            <a href="/admin/campaigns/manage" class="btn btn-secondary">Manage Campaigns</a>
          </div>
        </section>
      </div>

      <div class="admin-card">
        <div class="admin-card-header">
          <div>
            <div class="admin-card-title">Recent Campaigns</div>
            <div class="admin-card-subtitle">Quick access to the campaigns you were working on most recently.</div>
          </div>
        </div>

        <% if (recentCampaigns && recentCampaigns.length > 0) { %>
          <div class="campaign-home-recent">
            <% recentCampaigns.forEach(campaign => { %>
              <article class="campaign-home-recent-card">
                <div style="display:flex; justify-content:space-between; gap:12px; align-items:flex-start;">
                  <div>
                    <div style="font-size:18px; font-weight:700; color:var(--text);"><%= campaign.name %></div>
                    <div class="admin-card-subtitle"><%= campaign.audience?.name || 'No audience selected' %></div>
                  </div>
                  <span class="campaign-status-pill <%= campaign.status || 'draft' %>"><%= campaign.status || 'draft' %></span>
                </div>
                <div class="admin-card-subtitle">
                  Sender: <%= campaign.sender?.email || 'Not set' %> |
                  Updated: <%= campaign.updatedAt ? new Date(campaign.updatedAt).toLocaleString('en-GB') : 'N/A' %>
                </div>
                <div class="campaign-home-actions">
                  <a href="/admin/campaigns/editor/<%= campaign._id %>" class="btn btn-secondary btn-sm">Edit</a>
                  <a href="/admin/campaigns/<%= campaign._id %>" class="btn btn-secondary btn-sm">Analytics</a>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="admin-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 6h16v12H4z" />
              <path d="M4 8l8 5 8-5" />
            </svg>
            <h3>No campaigns yet</h3>
            <p>Create your first campaign to start building your outreach flow.</p>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
