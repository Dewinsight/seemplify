<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Manage Campaigns - Admin - Seemplify IDP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../../public/css/idp-theme.css') %>

    .campaign-manage-toolbar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 180px auto;
      gap: 12px;
      align-items: end;
      margin-bottom: 24px;
    }

    .campaign-manage-grid {
      display: grid;
      gap: 14px;
    }

    .campaign-manage-card {
      padding: 18px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: var(--panel);
      display: grid;
      gap: 12px;
    }

    .campaign-manage-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
    }

    .campaign-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .campaign-status-pill.draft { background: rgba(245, 158, 11, 0.12); color: #fbbf24; }
    .campaign-status-pill.ready,
    .campaign-status-pill.scheduled,
    .campaign-status-pill.paused { background: rgba(59, 130, 246, 0.12); color: #93c5fd; }
    .campaign-status-pill.running,
    .campaign-status-pill.completed { background: rgba(34, 197, 94, 0.12); color: #86efac; }
    .campaign-status-pill.cancelled,
    .campaign-status-pill.failed { background: rgba(239, 68, 68, 0.12); color: #fca5a5; }

    .campaign-manage-meta {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }

    .campaign-manage-meta-item {
      padding: 12px 14px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: var(--panel-strong);
    }

    .campaign-manage-meta-item strong {
      display: block;
      margin-bottom: 6px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .campaign-manage-meta-item span {
      color: var(--text);
      font-weight: 600;
      line-height: 1.45;
    }

    .campaign-manage-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .campaign-manage-summary {
      margin-bottom: 16px;
      color: var(--muted);
      font-size: 13px;
    }

    @media (max-width: 980px) {
      .campaign-manage-toolbar,
      .campaign-manage-meta {
        grid-template-columns: 1fr;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/theme.js?v=2"></script>
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/admin-nav', { activePage: 'campaigns' }) %>

    <main class="admin-content">
      <div class="admin-header">
        <div>
          <h1>Manage Campaigns</h1>
          <div style="color: var(--muted); font-size: 13px; margin-top: 4px;">View existing campaigns here first, then drill into edit or analytics for the one you want.</div>
        </div>
        <div class="admin-header-actions">
          <a href="/admin/campaigns" class="btn btn-secondary">Campaign Home</a>
          <a href="/admin/campaigns/create" class="btn btn-primary">Create Campaign</a>
        </div>
      </div>

      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <div class="admin-stat-label">Total Campaigns</div>
          <div class="admin-stat-value"><%= stats.total %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Drafts</div>
          <div class="admin-stat-value"><%= stats.draft %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Running</div>
          <div class="admin-stat-value"><%= stats.running %></div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-label">Healthy Senders</div>
          <div class="admin-stat-value"><%= stats.healthySenders %></div>
        </div>
      </div>

      <form method="GET" action="/admin/campaigns/manage" class="campaign-manage-toolbar">
        <div class="admin-form-group" style="margin:0;">
          <label class="admin-form-label">Search campaigns</label>
          <input name="search" class="admin-form-input" type="search" value="<%= filters.search %>" placeholder="Search by name, sender, audience, or status">
        </div>
        <div class="admin-form-group" style="margin:0;">
          <label class="admin-form-label">Status</label>
          <select name="status" class="admin-form-select">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All statuses</option>
            <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
            <option value="ready" <%= filters.status === 'ready' ? 'selected' : '' %>>Ready</option>
            <option value="scheduled" <%= filters.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
            <option value="running" <%= filters.status === 'running' ? 'selected' : '' %>>Running</option>
            <option value="paused" <%= filters.status === 'paused' ? 'selected' : '' %>>Paused</option>
            <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
            <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>Failed</option>
          </select>
        </div>
        <div class="campaign-manage-actions" style="justify-content:flex-end;">
          <button class="btn btn-secondary" type="submit">Apply Filters</button>
        </div>
      </form>

      <div class="campaign-manage-summary">
        Showing <%= filteredCount %> of <%= totalCampaigns %> campaigns.
      </div>

      <% if (campaigns && campaigns.length > 0) { %>
        <div class="campaign-manage-grid">
          <% campaigns.forEach(campaign => { %>
            <article class="campaign-manage-card">
              <div class="campaign-manage-head">
                <div>
                  <div style="font-size: 18px; font-weight: 700; color: var(--text);"><%= campaign.name %></div>
                  <div class="admin-card-subtitle"><%= campaign.audience?.name || 'No audience selected' %></div>
                </div>
                <span class="campaign-status-pill <%= campaign.status || 'draft' %>"><%= campaign.status || 'draft' %></span>
              </div>

              <div class="campaign-manage-meta">
                <div class="campaign-manage-meta-item">
                  <strong>Sender</strong>
                  <span><%= campaign.sender?.email || 'Not set' %></span>
                </div>
                <div class="campaign-manage-meta-item">
                  <strong>Updated</strong>
                  <span><%= campaign.updatedAt ? new Date(campaign.updatedAt).toLocaleString('en-GB') : 'N/A' %></span>
                </div>
                <div class="campaign-manage-meta-item">
                  <strong>Sent</strong>
                  <span><%= Number(campaign.metrics?.sent || 0) %></span>
                </div>
                <div class="campaign-manage-meta-item">
                  <strong>Opened</strong>
                  <span><%= Number(campaign.metrics?.opened || 0) %></span>
                </div>
              </div>

              <div class="campaign-manage-actions">
                <a href="/admin/campaigns/editor/<%= campaign._id %>" class="btn btn-secondary btn-sm">Edit Campaign</a>
                <a href="/admin/campaigns/<%= campaign._id %>" class="btn btn-secondary btn-sm">View Analytics</a>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="admin-card">
          <div class="admin-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 6h16v12H4z" />
              <path d="M4 8l8 5 8-5" />
            </svg>
            <h3>No campaigns found</h3>
            <p>Try changing the search or status filter, or create a new campaign.</p>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
