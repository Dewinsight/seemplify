                <div class="empty-state" id="template-pdf-empty">
                  <div class="pdf-dropzone" data-pdf-dropzone="template" tabindex="0" role="button" aria-label="Upload PDF">
                    <input type="file" id="template-document" accept=".pdf" style="display:none;" />
