    function initOnboardingFlows() {
      const flows = document.querySelectorAll('[data-onboarding-flow]');
      flows.forEach(flow => {
        const assignmentId = (flow.dataset.assignment || '').toString();
        const links = Array.from(flow.querySelectorAll('[data-step-link]'));
        const panels = Array.from(flow.querySelectorAll('[data-step-panel]'));
        const prevBtn = flow.querySelector('[data-step-prev]');
        const nextBtn = flow.querySelector('[data-step-next]');
        const indicator = flow.querySelector('[data-step-indicator]');
        const indicatorInline = flow.querySelector('[data-step-indicator-inline]');
        const progressBar = flow.querySelector('[data-progress-bar]');
        const progressLabel = flow.querySelector('[data-progress-label]');

        if (!links.length || !panels.length) return;

        let currentIndex = 0;
        const storageKey = assignmentId ? `onboardingFlow:${assignmentId}:step` : null;

        const clampIndex = (value) => {
          const n = Number(value);
          if (!Number.isFinite(n)) return 0;
          return Math.min(panels.length - 1, Math.max(0, Math.floor(n)));
        };

        const metaFor = (panel) => ({
          required: panel?.dataset?.stepRequired === '1',
          actionable: panel?.dataset?.stepActionable === '1',
          userDone: panel?.dataset?.stepUserdone === '1'
        });

        const computeProgress = () => {
          const actionableRequired = panels.filter(p => {
            const m = metaFor(p);
            return m.actionable && m.required;
          });
          const doneRequired = actionableRequired.filter(p => metaFor(p).userDone);

          const total = actionableRequired.length;
          const done = doneRequired.length;
          const pct = total ? Math.round((done / total) * 100) : 100;

          if (progressBar) {
            progressBar.style.width = `${pct}%`;
            progressBar.setAttribute('aria-valuenow', String(pct));
          }
          if (progressLabel) {
            progressLabel.textContent = total ? `${done} / ${total} required done` : 'No required actions';
          }
        };

        const updateIndicator = () => {
          const label = `Step ${currentIndex + 1} of ${panels.length}`;
          if (indicator) indicator.textContent = label;
          if (indicatorInline) indicatorInline.textContent = label;
        };

        const setButtonState = () => {
          if (prevBtn) prevBtn.disabled = currentIndex <= 0;
          if (nextBtn) nextBtn.disabled = currentIndex >= panels.length - 1;
        };

        const selectStep = (index, opts = {}) => {
          const options = {
            persist: opts.persist !== false,
            scroll: opts.scroll === true
          };
          currentIndex = clampIndex(index);

          links.forEach(link => {
            const isActive = clampIndex(link.dataset.step) === currentIndex;
            link.classList.toggle('active', isActive);
            link.setAttribute('aria-selected', isActive ? 'true' : 'false');
            link.tabIndex = isActive ? 0 : -1;
          });

          panels.forEach(panel => {
            const isActive = clampIndex(panel.dataset.step) === currentIndex;
            panel.classList.toggle('active', isActive);
            if (isActive) {
              panel.removeAttribute('hidden');
            } else {
              panel.setAttribute('hidden', '');
            }
          });

          updateIndicator();
          setButtonState();
          computeProgress();

          if (storageKey && options.persist) {
            try { localStorage.setItem(storageKey, String(currentIndex)); } catch (e) {}
          }

          if (options.scroll) {
            try { flow.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) {}
          }
        };

        const pickInitialIndex = (savedIndex) => {
          const safeSaved = clampIndex(savedIndex);
          const savedPanel = panels[safeSaved];
          if (savedPanel) {
            const m = metaFor(savedPanel);
            if (m.actionable && !m.userDone) return safeSaved;
          }

          let idx = panels.findIndex(p => {
            const m = metaFor(p);
            return m.actionable && m.required && !m.userDone;
          });
          if (idx >= 0) return idx;

          idx = panels.findIndex(p => {
            const m = metaFor(p);
            return m.actionable && !m.userDone;
          });
          if (idx >= 0) return idx;

          return safeSaved;
        };

        links.forEach(link => {
          link.addEventListener('click', () => {
            selectStep(link.dataset.step, { scroll: false });
          });
        });

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            selectStep(currentIndex - 1, { scroll: true });
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            selectStep(currentIndex + 1, { scroll: true });
          });
        }

        const saved = storageKey ? localStorage.getItem(storageKey) : null;
        selectStep(pickInitialIndex(saved), { persist: false, scroll: false });
      });
    }

    initOnboardingFlows();
  </script>

  <script src="/js/invitation-gatekeeper.js"></script>
</body>

</html>
