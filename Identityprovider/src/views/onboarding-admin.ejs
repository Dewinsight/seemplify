    function renderItems(list, containerId) {
      const container = document.getElementById(containerId);
      if (!container) return;

      if (list.length === 0) {
        container.innerHTML = '<div class="center-items-empty">No items added yet.</div>';
      } else {
        container.innerHTML = list
          .map((item, index) => `
            <article class="center-item-preview">
              <div class="center-item-preview-body">
                <div class="center-item-preview-title">${escapeHtml(item.title || 'Untitled')}</div>
