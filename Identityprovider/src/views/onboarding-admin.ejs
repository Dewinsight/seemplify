          <div class="form-group" id="template-esign-signers" style="display:none;">
            <label>Signers</label>
            <div id="template-signers-options" class="signers-options-list"></div>
            <div class="form-hint">Select who must sign. "Onboarding member" will sign as the assignee.</div>
          </div>
          <div class="form-group" id="template-esign-fields" style="display:none;">
            <label>Signature Fields</label>

            <div class="esign-builder">
              <div class="esign-panel">
                <div class="esign-panel-header">
                  <div class="esign-panel-title">Field Tools</div>
                  <div style="color: var(--muted); font-size: 12px;">Pick a recipient, then drag a field onto the PDF. Drag to move; use the corner handle to resize.</div>
                </div>

                <div class="esign-palette" aria-label="Field type palette">
                  <button class="esign-chip active" type="button" data-esign-chip="template" data-type="signature" onclick="setFieldType('template', 'signature')">Signature</button>
                  <button class="esign-chip" type="button" data-esign-chip="template" data-type="date" onclick="setFieldType('template', 'date')">Date</button>
                  <button class="esign-chip" type="button" data-esign-chip="template" data-type="text" onclick="setFieldType('template', 'text')">Name/Text</button>
                </div>

                <div class="form-group">
                  <label for="template-sign-signer">Active recipient</label>
                  <div id="template-recipient-chips" class="esign-recipient-chips" aria-label="Recipients"></div>
                  <select id="template-sign-signer"></select>
                </div>

                <div class="form-group">
                  <label for="template-sign-type">Field type</label>
                  <select id="template-sign-type">
                    <option value="signature">Signature</option>
                    <option value="date">Date</option>
                    <option value="text">Text</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="template-sign-label">Label</label>
                  <input type="text" id="template-sign-label" placeholder="e.g. Employee Signature" />
                </div>

                <div class="form-group" id="template-sign-text-wrap" style="display:none;">
                  <label for="template-sign-text">Text (optional)</label>
                  <input type="text" id="template-sign-text" placeholder="Leave blank to use the signer's name" />
                  <div class="form-hint">Only used when Field type is Text.</div>
                </div>

                <details class="esign-advanced">
                  <summary>Advanced placement</summary>
                  <div class="esign-advanced-grid">
                    <input type="number" id="template-sign-page" placeholder="Page" value="1" min="1" />
                    <select id="template-sign-origin">
                      <option value="top-left">Top-left origin</option>
                      <option value="bottom-left">Bottom-left origin</option>
                    </select>
                    <input type="number" id="template-sign-x" placeholder="X" value="50" />
                    <input type="number" id="template-sign-y" placeholder="Y" value="50" />
                    <input type="number" id="template-sign-width" placeholder="Width" value="180" />
                    <input type="number" id="template-sign-height" placeholder="Height" value="60" />
                  </div>
                  <div style="display:flex; gap: 8px; flex-wrap: wrap; margin-top: 10px;">
                    <button class="btn btn-secondary btn-sm" type="button" onclick="addSignatureField('template')">Add Field At Coordinates</button>
                    <button class="btn btn-danger btn-sm" type="button" onclick="removeSelectedSignatureField('template')">Delete Selected</button>
                  </div>
                  <div class="form-hint" style="margin-top: 10px;">Coordinates are in PDF points (72 = 1 inch). Drag fields to reposition.</div>
                </details>

                <div class="esign-panel-header" style="margin-top: 12px;">
                  <div class="esign-panel-title">Fields</div>
                  <div id="template-signature-fields-count" style="color: var(--muted); font-size: 12px;"></div>
                </div>
                <div id="template-signature-fields-list" class="esign-fields-list"></div>
                <div class="form-hint" style="margin-top: 10px;">Drag fields from the left onto the document. Drag to move, use the corner to resize. Click a field to edit.</div>
              </div>

              <div>
                <div class="pdf-viewer" id="template-pdf-viewer" style="display:none;">
                  <div class="pdf-toolbar">
                    <div style="display:flex; gap: 6px; align-items:center;">
                      <button class="btn btn-secondary btn-sm" type="button" onclick="changePdfPage('template', -1)">Prev</button>
                      <span id="template-pdf-page-label" style="font-size: 12px; color: var(--muted);">Page 1 / 1</span>
                      <button class="btn btn-secondary btn-sm" type="button" onclick="changePdfPage('template', 1)">Next</button>
                    </div>
                    <div style="display:flex; gap: 6px; align-items:center;">
                      <button class="btn btn-secondary btn-sm" type="button" onclick="changePdfZoom('template', -0.15)">-</button>
                      <span id="template-pdf-zoom-label" style="font-size: 12px; color: var(--muted);">100%</span>
                      <button class="btn btn-secondary btn-sm" type="button" onclick="changePdfZoom('template', 0.15)">+</button>
                      <button class="btn btn-secondary btn-sm" type="button" id="template-place-toggle" onclick="togglePlaceMode('template')">Click to place: OFF</button>
                      <button class="btn btn-secondary btn-sm" type="button" onclick="openEsignFilePicker('template')">Upload PDF</button>
                      <button class="btn btn-danger btn-sm" type="button" onclick="removeEsignDocument('template')">Remove PDF</button>
                      <span id="template-document-status-toolbar" class="pdf-toolbar-status"></span>
                    </div>
                  </div>
                  <div class="pdf-canvas-wrap" id="template-pdf-canvas-wrap">
                    <div class="pdf-stage" id="template-pdf-stage">
                      <canvas id="template-pdf-canvas"></canvas>
                      <div class="pdf-overlay" id="template-pdf-overlay"></div>
