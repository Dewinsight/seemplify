    let activeAssigneeId = null;
    const ESIGN_COLOR = '#6366f1';

    function normalizeId(value) {
      if (!value) return '';
      if (typeof value === 'string') {
        const trimmed = value.trim();
        if (!trimmed || trimmed === 'undefined' || trimmed === 'null' || trimmed === '[object Object]') return '';
        const m = trimmed.match(/^[Oo]bject[Ii]d\(['"]([0-9a-fA-F]{24})['"]\)$/);
        if (m) return m[1];
        return trimmed;
      }
      if (typeof value === 'number') return String(value);
      if (typeof value === 'object') {
        if (typeof value.$oid === 'string') return value.$oid;
        if (value.key) return normalizeId(value.key);
        if (value.value) return normalizeId(value.value);
        if (value._id) return normalizeId(value._id);
        if (value.id) return normalizeId(value.id);
        if (value.member) return normalizeId(value.member);
        if (value.memberId) return normalizeId(value.memberId);
      }
      try {
        return String(value);
      } catch (e) {
        return '';
      }
    }

    function fieldAssignedToUser(field, userId, assigneeId) {
      // Prefer signerKey because signerId can sometimes be a nested object (or coerces poorly).
      const raw = normalizeId(field.signerKey || field.signerId || field.signer);
      if (!raw) return true; // Unassigned fields can be signed by any allowed signer.
      const resolved = raw === 'assignee' ? normalizeId(assigneeId) : raw;
      return resolved === userId;
    }

    function clampNumber(value, min, max) {
      return Math.min(max, Math.max(min, value));
    }

    function getFieldDisplayTitle(field, index) {
      const label = (field.label || '').trim();
      if (label) return `${index + 1}. ${label}`;
      if (field.type === 'date') return `${index + 1}. Date`;
      if (field.type === 'text') return `${index + 1}. Text`;
      return `${index + 1}. Signature`;
    }

    function renderEsignFieldsList() {
      if (!esignFieldsList) return;
      esignFieldsList.innerHTML = '';

      if (esignFieldsCount) {
        const n = activeFields.length;
        esignFieldsCount.textContent = `${n} field${n === 1 ? '' : 's'}`;
      }

      activeFields.forEach((field, index) => {
        const row = document.createElement('div');
        row.className = 'esign-field-row' + (index === selectedEsignFieldIndex ? ' active' : '');
        row.style.setProperty('--esign-color', ESIGN_COLOR);
        row.tabIndex = 0;
        row.setAttribute('role', 'button');
        row.setAttribute('aria-label', `Jump to field ${index + 1}`);

        const dot = document.createElement('div');
        dot.className = 'esign-field-dot';
        dot.style.background = ESIGN_COLOR;

        const body = document.createElement('div');
        const title = document.createElement('div');
        title.className = 'esign-field-row-title';
        title.textContent = getFieldDisplayTitle(field, index);

        const meta = document.createElement('div');
        meta.className = 'esign-field-row-meta';
        meta.textContent = `Page ${field.page || 1} - ${field.type || 'signature'}`;

        body.appendChild(title);
        body.appendChild(meta);

        row.appendChild(dot);
        row.appendChild(body);

        row.addEventListener('click', () => selectEsignField(index, { scroll: true }));
        row.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            selectEsignField(index, { scroll: true });
          }
        });

        esignFieldsList.appendChild(row);
      });
    }

    function scrollToEsignField(field) {
      if (!field || !esignPdfCanvasWrap || !esignPdfState.viewport) return;
      const stage = esignPdfStage || esignPdfOverlay?.parentElement;
      const stageOffsetLeft = stage?.offsetLeft || 0;
      const stageOffsetTop = stage?.offsetTop || 0;
      const scale = esignPdfState.scale || 1;
      const pdfHeight = esignPdfState.viewport.viewBox[3] - esignPdfState.viewport.viewBox[1];
      const topLeftY = field.origin === 'bottom-left'
        ? (pdfHeight - field.y - field.height)
        : field.y;

      const targetLeft = stageOffsetLeft + (field.x * scale) + ((field.width || 0) * scale) / 2;
      const targetTop = stageOffsetTop + (topLeftY * scale) + ((field.height || 0) * scale) / 2;

      const nextLeft = clampNumber(targetLeft - (esignPdfCanvasWrap.clientWidth / 2), 0, esignPdfCanvasWrap.scrollWidth);
      const nextTop = clampNumber(targetTop - (esignPdfCanvasWrap.clientHeight / 2), 0, esignPdfCanvasWrap.scrollHeight);

      esignPdfCanvasWrap.scrollTo({ left: nextLeft, top: nextTop, behavior: 'smooth' });
    }

    function selectEsignField(index, options = {}) {
      if (!activeFields.length) return;
      const safeIndex = clampNumber(Number(index) || 0, 0, activeFields.length - 1);
      selectedEsignFieldIndex = safeIndex;
      renderEsignFieldsList();

      const field = activeFields[selectedEsignFieldIndex];
      if (!field) return;

      const desiredPage = Number(field.page) || 1;
      if (esignPdfState.page !== desiredPage) {
        esignPdfState.page = desiredPage;
        renderEsignPdfPage().then(() => {
          if (options.scroll !== false) scrollToEsignField(field);
        });
        return;
      }

      renderEsignOverlay();
      if (options.scroll !== false) scrollToEsignField(field);
    }

    function jumpEsignField(delta) {
      if (!activeFields.length) return;
      const base = selectedEsignFieldIndex >= 0 ? selectedEsignFieldIndex : 0;
      selectEsignField(base + delta, { scroll: true });
    }

    function changeEsignZoom(delta) {
      if (!esignPdfState.pdf) return;
      const next = clampNumber((esignPdfState.zoom || 1) + Number(delta || 0), 0.6, 2.25);
      if (Math.abs(next - (esignPdfState.zoom || 1)) < 0.001) return;
      esignPdfState.zoom = next;
      renderEsignPdfPage().then(() => {
        const field = activeFields[selectedEsignFieldIndex];
        if (field && Number(field.page) === esignPdfState.page) {
          scrollToEsignField(field);
        }
      });
    }

    function resizeSignatureCanvas() {
      const ratio = window.devicePixelRatio || 1;
      const rect = signatureCanvas.getBoundingClientRect();
      signatureCanvas.width = Math.max(1, Math.round(rect.width * ratio));
      signatureCanvas.height = Math.max(1, Math.round(rect.height * ratio));
      signatureCtx.setTransform(1, 0, 0, 1, 0, 0);
      signatureCtx.lineCap = 'round';
      signatureCtx.lineJoin = 'round';
      signatureCtx.strokeStyle = '#09090b';
      signatureCtx.lineWidth = 2 * (signatureCanvas.width / Math.max(rect.width, 1));
    }

    function clearSignature(reset = true, preserveStored = false) {
      signatureCtx.save();
      signatureCtx.setTransform(1, 0, 0, 1, 0, 0);
      signatureCtx.clearRect(0, 0, signatureCanvas.width, signatureCanvas.height);
      signatureCtx.restore();
      if (reset) {
        hasSignature = false;
        signaturePreviewUrl = null;
        if (!preserveStored) {
          localStorage.removeItem('esignSignatureDataUrl');
        }
      }
      renderEsignOverlay();
    }

    function loadSignatureDataUrl(dataUrl) {
      if (!dataUrl) return;
      const image = new Image();
      image.onload = () => {
        clearSignature(false);
        signatureCtx.drawImage(image, 0, 0, signatureCanvas.width, signatureCanvas.height);
        hasSignature = true;
        signaturePreviewUrl = dataUrl;
        renderEsignOverlay();
      };
      image.src = dataUrl;
    }

    function storeSignatureToLocal() {
      if (!hasSignature) return;
      const dataUrl = signatureCanvas.toDataURL('image/png');
      signaturePreviewUrl = dataUrl;
      localStorage.setItem('esignSignatureDataUrl', dataUrl);
      renderEsignOverlay();
    }

    async function loadEsignPdf(url) {
      if (!url || !window.pdfjsLib) {
        return;
      }

      pdfjsLib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';
      const loadingTask = pdfjsLib.getDocument(url);
      const pdf = await loadingTask.promise;
      esignPdfState.pdf = pdf;
      esignPdfState.totalPages = pdf.numPages;
      if (typeof esignPdfState.zoom !== 'number' || !Number.isFinite(esignPdfState.zoom)) {
        esignPdfState.zoom = 1;
      }
      esignPdfState.page = clampNumber(esignPdfState.page || 1, 1, esignPdfState.totalPages || 1);
      if (esignPdfViewer) {
        esignPdfViewer.style.display = 'block';
      }
      if (esignPdfPageRange) {
        esignPdfPageRange.min = '1';
        esignPdfPageRange.max = String(esignPdfState.totalPages || 1);
        esignPdfPageRange.value = String(esignPdfState.page || 1);
        esignPdfPageRange.style.display = (esignPdfState.totalPages || 1) > 1 ? 'inline-block' : 'none';
      }
      await renderEsignPdfPage();
      const selectedField = activeFields[selectedEsignFieldIndex];
      if (selectedField && Number(selectedField.page || 1) === Number(esignPdfState.page || 1)) {
        scrollToEsignField(selectedField);
      }
    }

    async function renderEsignPdfPage() {
      if (!esignPdfState.pdf) return;
      const page = await esignPdfState.pdf.getPage(esignPdfState.page);
      const unscaledViewport = page.getViewport({ scale: 1 });
      const wrapWidth = getWrapInnerWidth(esignPdfCanvasWrap) || esignPdfCanvas.parentElement?.clientWidth || 600;
      const zoom = esignPdfState.zoom || 1;
      const scale = (wrapWidth / unscaledViewport.width) * zoom;
      const viewport = page.getViewport({ scale });

      const ratio = window.devicePixelRatio || 1;
      esignPdfCanvas.width = Math.floor(viewport.width * ratio);
      esignPdfCanvas.height = Math.floor(viewport.height * ratio);
      esignPdfCanvas.style.width = `${Math.floor(viewport.width)}px`;
      esignPdfCanvas.style.height = `${Math.floor(viewport.height)}px`;
      const ctx = esignPdfCanvas.getContext('2d');
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, viewport.width, viewport.height);
      await page.render({ canvasContext: ctx, viewport }).promise;

      esignPdfOverlay.style.width = `${viewport.width}px`;
      esignPdfOverlay.style.height = `${viewport.height}px`;
      esignPdfOverlay.innerHTML = '';

      esignPdfState.scale = scale;
      esignPdfState.viewport = viewport;

      if (esignPdfPageLabel) {
        esignPdfPageLabel.textContent = `Page ${esignPdfState.page} / ${esignPdfState.totalPages}`;
      }

      if (esignPdfPageRange) {
        esignPdfPageRange.value = String(esignPdfState.page || 1);
      }

      if (esignPdfZoomLabel) {
        esignPdfZoomLabel.textContent = `${Math.round((esignPdfState.zoom || 1) * 100)}%`;
      }

      renderEsignOverlay();
    }

    function changeEsignPdfPage(delta) {
      if (!esignPdfState.pdf) return;
      const nextPage = Math.min(esignPdfState.totalPages, Math.max(1, esignPdfState.page + delta));
      if (nextPage === esignPdfState.page) return;
      esignPdfState.page = nextPage;
      renderEsignPdfPage();
    }

    function bindPdfPanScroll(wrapEl, options = {}) {
      if (!wrapEl) return;
      const ignoreSelector = options.ignoreSelector || null;
      const isEnabled = typeof options.isEnabled === 'function' ? options.isEnabled : (() => true);
      const threshold = typeof options.threshold === 'number' ? options.threshold : 4;

      let isDown = false;
      let moved = false;
      let pointerId = null;
      let startX = 0;
      let startY = 0;
      let startLeft = 0;
      let startTop = 0;

      wrapEl.classList.add('can-pan');

      wrapEl.addEventListener('pointerdown', (event) => {
        if (!isEnabled()) return;
        if (event.pointerType !== 'mouse') return;
        if (event.button !== 0) return;
        if (ignoreSelector && event.target.closest(ignoreSelector)) return;

        isDown = true;
        moved = false;
        pointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        startLeft = wrapEl.scrollLeft;
        startTop = wrapEl.scrollTop;

        wrapEl.classList.add('is-pan-ready');
        wrapEl.setPointerCapture(pointerId);
      });

      wrapEl.addEventListener('pointermove', (event) => {
        if (!isDown) return;
        const dx = event.clientX - startX;
        const dy = event.clientY - startY;
        if (!moved && Math.hypot(dx, dy) < threshold) return;
        moved = true;
        wrapEl.classList.add('is-panning');
        wrapEl.scrollLeft = startLeft - dx;
        wrapEl.scrollTop = startTop - dy;
      });

      const endPan = () => {
        if (!isDown) return;
        isDown = false;
        wrapEl.classList.remove('is-panning');
        wrapEl.classList.remove('is-pan-ready');
        if (pointerId != null) {
          try { wrapEl.releasePointerCapture(pointerId); } catch (e) {}
        }
        pointerId = null;
      };

      wrapEl.addEventListener('pointerup', endPan);
      wrapEl.addEventListener('pointercancel', endPan);

      wrapEl.addEventListener('click', (event) => {
        if (moved) {
          event.preventDefault();
          event.stopPropagation();
        }
      }, true);
    }

    function renderEsignOverlay() {
      if (!esignPdfState.viewport || !esignPdfOverlay) return;
      esignPdfOverlay.innerHTML = '';
      const scale = esignPdfState.scale || 1;
      const pdfHeight = esignPdfState.viewport.viewBox[3] - esignPdfState.viewport.viewBox[1];
      const now = new Date().toLocaleDateString();
      const signerName = esignSignerName.value.trim();

      activeFields.forEach((field, index) => {
        if ((field.page || 1) !== esignPdfState.page) return;
        const fieldEl = document.createElement('div');
        fieldEl.className = 'esign-field esign-field-preview';
        fieldEl.dataset.index = String(index);
        fieldEl.style.setProperty('--esign-color', ESIGN_COLOR);
        fieldEl.style.borderColor = ESIGN_COLOR;

        const topLeftY = field.origin === 'bottom-left'
          ? (pdfHeight - field.y - field.height)
          : field.y;
        fieldEl.style.left = `${field.x * scale}px`;
        fieldEl.style.top = `${topLeftY * scale}px`;
        fieldEl.style.width = `${field.width * scale}px`;
        fieldEl.style.height = `${field.height * scale}px`;

        if (index === selectedEsignFieldIndex) {
          fieldEl.classList.add('selected');
        }

        const numberBadge = document.createElement('div');
        numberBadge.className = 'esign-field-number';
        numberBadge.textContent = String(index + 1);
        fieldEl.appendChild(numberBadge);

        if (field.type === 'signature') {
          if (signaturePreviewUrl) {
            const img = document.createElement('img');
            img.src = signaturePreviewUrl;
            fieldEl.appendChild(img);
          } else {
            const label = document.createElement('div');
            label.className = 'esign-field-title';
            label.textContent = field.label || 'Signature';
            fieldEl.appendChild(label);
          }
        } else if (field.type === 'date') {
          const label = document.createElement('div');
          label.className = 'esign-field-title';
          label.textContent = now;
          fieldEl.appendChild(label);
        } else if (field.type === 'text') {
          const label = document.createElement('div');
          label.className = 'esign-field-title';
          label.textContent = field.text || signerName || 'Text';
          fieldEl.appendChild(label);
        }

        fieldEl.addEventListener('click', () => {
          selectEsignField(index, { scroll: true });
          if (!hasSignature && field.type === 'signature') {
            signatureCanvas?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });

        esignPdfOverlay.appendChild(fieldEl);
      });
    }

    function getCanvasPoint(event) {
      const rect = signatureCanvas.getBoundingClientRect();
      const scaleX = signatureCanvas.width / Math.max(rect.width, 1);
      const scaleY = signatureCanvas.height / Math.max(rect.height, 1);
      return {
        x: clampNumber((event.clientX - rect.left) * scaleX, 0, signatureCanvas.width),
        y: clampNumber((event.clientY - rect.top) * scaleY, 0, signatureCanvas.height)
      };
    }

    signatureCanvas.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      isDrawing = true;
      hasSignature = true;
      const point = getCanvasPoint(event);
      lastSignaturePoint = point;
      lastSignatureMidPoint = point;

      // Draw a tiny dot so taps still create a visible mark.
      signatureCtx.beginPath();
      signatureCtx.moveTo(point.x, point.y);
      signatureCtx.lineTo(point.x + 0.01, point.y + 0.01);
      signatureCtx.stroke();
      signatureCanvas.setPointerCapture(event.pointerId);
    });

    signatureCanvas.addEventListener('pointermove', (event) => {
      if (!isDrawing) return;
      const events = typeof event.getCoalescedEvents === 'function'
        ? event.getCoalescedEvents()
        : [event];

      for (const e of events) {
        const point = getCanvasPoint(e);
        if (!lastSignaturePoint) {
          lastSignaturePoint = point;
          lastSignatureMidPoint = point;
          continue;
        }

        const midPoint = {
          x: (lastSignaturePoint.x + point.x) / 2,
          y: (lastSignaturePoint.y + point.y) / 2
        };

        signatureCtx.beginPath();
        signatureCtx.moveTo(lastSignatureMidPoint.x, lastSignatureMidPoint.y);
        signatureCtx.quadraticCurveTo(lastSignaturePoint.x, lastSignaturePoint.y, midPoint.x, midPoint.y);
        signatureCtx.stroke();

        lastSignaturePoint = point;
        lastSignatureMidPoint = midPoint;
      }
    });

    signatureCanvas.addEventListener('pointerup', (event) => {
      isDrawing = false;
      lastSignaturePoint = null;
      lastSignatureMidPoint = null;
      signatureCtx.closePath();
      if (signatureCanvas.hasPointerCapture(event.pointerId)) {
        signatureCanvas.releasePointerCapture(event.pointerId);
      }
      storeSignatureToLocal();
    });

    signatureCanvas.addEventListener('pointerleave', () => {
      isDrawing = false;
      lastSignaturePoint = null;
      lastSignatureMidPoint = null;
    });

    signatureCanvas.addEventListener('pointercancel', () => {
      isDrawing = false;
      lastSignaturePoint = null;
      lastSignatureMidPoint = null;
    });

    function openESignModal(button) {
      const assignmentId = button.dataset.assignment;
      const itemId = button.dataset.item;
      const assigneeId = button.dataset.assigneeId || '';
      const docName = button.dataset.docName;
      const docUrl = button.dataset.docUrl;
      const previewUrl = button.dataset.previewUrl || docUrl;
      const fieldsRaw = button.dataset.fields ? decodeURIComponent(button.dataset.fields) : '[]';
      let fields = [];

      try {
        fields = JSON.parse(fieldsRaw) || [];
      } catch (error) {
        console.error('Failed to parse signature fields:', error);
      }

      activeFields = fields
        .map(field => ({
          ...field,
          page: Number(field.page) || 1,
          x: Number(field.x) || 0,
          y: Number(field.y) || 0,
          width: Number(field.width) || 180,
          height: Number(field.height) || 60
        }))
        .filter(field => fieldAssignedToUser(field, currentUserId, assigneeId))
        .sort((a, b) => (a.page || 1) - (b.page || 1) || (a.y || 0) - (b.y || 0) || (a.x || 0) - (b.x || 0));

      if (!previewUrl) {
        alert('Document is not available for signing');
        return;
      }
      if (!activeFields.length) {
        console.warn('No signature fields assigned to current signer', { currentUserId, assigneeId, fields });
        alert('No signature fields assigned to you');
        return;
      }
      activeAssignmentId = assignmentId;
      activeItemId = itemId;
      activeAssigneeId = assigneeId;
      selectedEsignFieldIndex = 0;
      esignDocumentName.textContent = docName || 'Document';
      if (esignDocumentSubtitle) {
        esignDocumentSubtitle.textContent = `You have ${activeFields.length} field${activeFields.length === 1 ? '' : 's'} to complete.`;
      }
      const viewerVersion = (previewUrl && docUrl && previewUrl !== docUrl) ? 'signed' : 'original';
      esignDocumentLink.href = `/onboarding/assignments/${assignmentId}/items/${itemId}/document?version=${viewerVersion}`;
      esignDocumentLink.style.display = (docUrl || previewUrl) ? 'inline-flex' : 'none';
      esignSignerName.value = '';
      esignModal.classList.add('active');
      esignPdfUrl = previewUrl;
      esignPdfState.zoom = 1;
      setTimeout(() => {
        resizeSignatureCanvas();
        clearSignature(true, true);
        const storedSignature = localStorage.getItem('esignSignatureDataUrl');
        if (storedSignature) {
          loadSignatureDataUrl(storedSignature);
        }
        renderEsignFieldsList();
        loadEsignPdf(previewUrl);
        selectEsignField(0, { scroll: false });
      }, 50);
    }

    function closeESignModal() {
      esignModal.classList.remove('active');
      activeAssignmentId = null;
      activeItemId = null;
      activeFields = [];
      selectedEsignFieldIndex = -1;
      esignPdfState.pdf = null;
      esignPdfState.page = 1;
      esignPdfState.totalPages = 0;
      esignPdfState.zoom = 1;
      esignPdfState.viewport = null;
      if (esignPdfViewer) {
        esignPdfViewer.style.display = 'none';
      }
    }

    esignModal?.addEventListener('click', (event) => {
      if (event.target === esignModal) {
        closeESignModal();
      }
    });

    document.querySelectorAll('[data-esign-button]').forEach(button => {
      button.addEventListener('click', () => {
        openESignModal(button);
      });
    });

    esignSignerName?.addEventListener('input', () => {
      renderEsignOverlay();
    });

    let esignPageScrubTimer = null;
    esignPdfPageRange?.addEventListener('input', () => {
      if (!esignPdfState.pdf) return;
      const next = clampNumber(Number(esignPdfPageRange.value), 1, esignPdfState.totalPages || 1);
      if (esignPdfPageLabel) {
        esignPdfPageLabel.textContent = `Page ${next} / ${esignPdfState.totalPages}`;
      }
      clearTimeout(esignPageScrubTimer);
      esignPageScrubTimer = setTimeout(() => {
        esignPdfState.page = next;
        renderEsignPdfPage();
      }, 120);
    });

    bindPdfPanScroll(esignPdfCanvasWrap, { ignoreSelector: '.esign-field-preview' });
    bindPdfPanScroll(document.getElementById('template-pdf-canvas-wrap'), {
      ignoreSelector: '.esign-field',
      isEnabled: () => !placeModeState.template
    });
    bindPdfPanScroll(document.getElementById('custom-pdf-canvas-wrap'), {
      ignoreSelector: '.esign-field',
      isEnabled: () => !placeModeState.custom
    });

    async function submitESignature() {
      if (!activeAssignmentId || !activeItemId) return;
      if (!hasSignature) {
        alert('Please add your signature before submitting');
        return;
      }

      const payload = {
        signatureDataUrl: signatureCanvas.toDataURL('image/png')
      };
      const signerName = esignSignerName.value.trim();
      if (signerName) {
        payload.signerName = signerName;
      }

      const response = await fetch(`/api/onboarding/${activeAssignmentId}/items/${activeItemId}/esign/complete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        window.location.reload();
      } else {
        const result = await response.json();
        alert(result.error || 'Failed to submit signature');
      }
    }

    let esignResizeTimer = null;
    window.addEventListener('resize', () => {
      if (!esignPdfState.pdf) return;
      clearTimeout(esignResizeTimer);
      esignResizeTimer = setTimeout(() => {
        renderEsignPdfPage();
      }, 150);
    });
