    function removeItem(containerId, index) {
      if (containerId === 'template-items-list') {
        templateItems.splice(index, 1);
        renderItems(templateItems, containerId);
      } else {
        customItems.splice(index, 1);
        renderItems(customItems, containerId);
      }
