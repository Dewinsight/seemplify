          <div class="center-builder-actions">
            <button class="btn btn-secondary" type="button" onclick="addTemplateItem()">Add Template Item</button>
          </div>
        </div>
      </div>
      </section>

      <section class="template-modal-panel" data-template-modal-panel="3" role="tabpanel" aria-label="Template review" hidden>
        <div class="template-modal-panel-heading">
          <h3 tabindex="-1">Step C: Review</h3>
          <p>Validate template details before creating it.</p>
        </div>
        <div class="center-review-grid">
          <div class="center-review-row">
            <div class="center-review-label">Template Name</div>
            <div class="center-review-value" id="template-review-name">Not set</div>
          </div>
          <div class="center-review-row">
            <div class="center-review-label">Description</div>
            <div class="center-review-value" id="template-review-description">No description</div>
          </div>
          <div class="center-review-row">
            <div class="center-review-label">Default</div>
            <div class="center-review-value" id="template-review-default">No</div>
          </div>
          <div class="center-review-row">
            <div class="center-review-label">Items</div>
            <div class="center-review-value" id="template-review-count">0 item(s)</div>
          </div>
          <div class="center-review-row">
