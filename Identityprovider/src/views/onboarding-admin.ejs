                  <button class="btn btn-secondary btn-sm" type="button" onclick="clearSignature()">Clear</button>
                  <button class="btn btn-primary btn-sm" id="esign-submit-btn" type="button" onclick="submitESignature()">Finish & Generate Signed PDF</button>
