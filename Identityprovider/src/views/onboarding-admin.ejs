  </div>

  <% if (typeof personalAssignments !== 'undefined') { %>
    <div class="modal" id="esignModal">
      <div class="modal-content modal-xl">
        <div class="modal-header">
          <h2>Sign Document</h2>
          <button class="modal-close" onclick="closeESignModal()">&times;</button>
        </div>

        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap: 12px; flex-wrap: wrap;">
          <div style="min-width: 240px;">
            <div id="esign-document-name" style="font-weight:800;">Document</div>
            <div id="esign-document-subtitle" style="color: var(--muted); font-size: 12px; margin-top: 4px;"></div>
          </div>
          <a class="btn btn-secondary btn-sm" id="esign-document-link" target="_blank" rel="noreferrer" style="display:none;">Open document</a>
        </div>

        <div class="esign-modal-layout" style="margin-top: 14px;">
