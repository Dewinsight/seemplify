<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Onboarding - <%= organization.name %> - Seemplify</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
</head>

<body>
  <%- include('partials/nav', { activePage: (typeof activePage !== 'undefined' ? activePage : 'organizations') }) %>

  <div class="container">
    <a href="/organizations/<%= organization._id %>/members" class="back-link">? Back to Members</a>

    <div class="header">
      <div>
        <h1>Onboarding Center</h1>
        <div class="header-subtitle">
          <%= organization.name %>
        </div>
      </div>
      <div class="header-actions">
        <button class="btn btn-primary" onclick="showTemplateModal()">+ Create Template</button>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <% if (typeof personalAssignments !== 'undefined') { %>
      <div class="tab-bar">
        <button class="tab-button" data-onboarding-tab="my">My Onboarding</button>
        <button class="tab-button" data-onboarding-tab="center">Onboarding Center</button>
      </div>

      <div class="tab-panel" id="tab-my-onboarding">
        <div class="card">
          <h2 style="margin-top:0">My Onboarding</h2>
          <% if (!personalAssignments || personalAssignments.length === 0) { %>
            <div class="empty-state" style="padding: 32px 16px;">
              <h3>No onboarding tasks</h3>
              <p>You are all set.</p>
            </div>
          <% } else { %>
            <div class="assignment-board-status" style="margin-bottom: 10px;" role="tablist" aria-label="Filter personal onboarding">
              <button type="button" class="assignment-status-chip active" data-personal-status-filter="current" aria-selected="true">Current</button>
              <button type="button" class="assignment-status-chip" data-personal-status-filter="history" aria-selected="false">History</button>
              <button type="button" class="assignment-status-chip" data-personal-status-filter="all" aria-selected="false">All</button>
            </div>
            <% personalAssignments.forEach(assignment => { %>
              <% const assignmentMemberId = (assignment.member?._id || assignment.member).toString(); %>
              <% const currentUserId = user._id.toString(); %>
              <% const isAssignee = assignmentMemberId === currentUserId; %>
              <div
                class="card onboarding-assignment-card onboarding-assignment-card--<%= assignment.status %>"
                style="margin-top: 12px;"
                data-personal-assignment
                data-personal-status="<%= assignment.status %>"
              >
                <div style="display:flex; align-items:center; justify-content:space-between; gap: 12px; flex-wrap: wrap;">
                  <div>
                    <div style="font-weight:700; font-size:16px;">
                      <%= assignment.organization?.name || organization?.name || 'Organization' %>
                    </div>
                    <div style="color: var(--muted); font-size: 13px; margin-top: 4px;">
                      Assigned <%= new Date(assignment.createdAt).toLocaleDateString() %>
                    </div>
                  </div>
                  <span class="role-badge onboarding-badge onboarding-<%= assignment.status %>">
                    <%= assignment.status.replace('_', ' ') %>
                  </span>
                </div>

                <% if (assignment.status === 'cancelled') { %>
                  <div class="onboarding-flow">
                    <div class="alert alert-error" style="margin:0;">This onboarding assignment was cancelled.</div>
                  </div>
                <% } else { %>
                  <% const visibleItems = []; %>
                  <% assignment.items.forEach(item => { %>
                    <% const signerConfigList = item.config?.signers || []; %>
                    <% const signerStatusList = item.data?.esign?.signers || []; %>
                    <% const signerMatch = signerConfigList.some(signer => String(signer.member || signer.memberId || signer.key || signer) === currentUserId); %>
                    <% const signerStatusMatch = signerStatusList.some(signer => String(signer.member) === currentUserId); %>
                    <% const canViewItem = isAssignee || (item.type === 'esign' && (signerMatch || signerStatusMatch)); %>
                    <% if (canViewItem) visibleItems.push(item); %>
                  <% }) %>

                  <% if (visibleItems.length === 0) { %>
                    <div class="empty-state" style="padding: 18px 0;">
                      <h3>No onboarding steps</h3>
                      <p>No items are assigned to you on this onboarding.</p>
                    </div>
                  <% } else { %>
                    <div class="onboarding-flow" data-onboarding-flow data-assignment="<%= assignment._id %>">
                      <div class="onboarding-flow-meta">
                        <div class="onboarding-step-indicator" data-step-indicator>Step 1 of <%= visibleItems.length %></div>
                        <div class="onboarding-progress-track" role="progressbar" aria-label="Progress">
                          <div class="onboarding-progress-bar" data-progress-bar></div>
                        </div>
                        <div class="onboarding-step-indicator" data-progress-label></div>
                      </div>

                      <div class="onboarding-stepper">
                        <div class="onboarding-steps" role="tablist" aria-label="Onboarding steps">
                          <% visibleItems.forEach((item, index) => { %>
                            <% const isRequired = item.required !== false; %>
                            <% const isCompleted = item.status === 'completed'; %>
                            <% let userActionable = false; %>
                            <% let userDone = false; %>
                            <% let statusText = isCompleted ? 'Completed' : 'Pending'; %>
                            <% const typeText = item.type === 'form' ? 'Form' : (item.type === 'upload' ? 'Upload' : 'E-sign'); %>

                            <% if (item.type === 'form' || item.type === 'upload') { %>
                              <% userActionable = !isCompleted; %>
                              <% userDone = isCompleted; %>
                              <% statusText = isCompleted ? 'Completed' : 'Action needed'; %>
                            <% } %>

                            <% if (item.type === 'esign') { %>
                              <% const signerConfigList = item.config?.signers || []; %>
                              <% const signerStatusList = item.data?.esign?.signers || []; %>
                              <% const signerConfigIds = signerConfigList.map(signer => String(signer.member || signer.memberId || signer.key || signer)); %>
                              <% const signerEntry = signerStatusList.find(signer => String(signer.member) === currentUserId); %>
                              <% const hasSigned = signerEntry && signerEntry.status === 'signed'; %>
                              <% const canSign = signerEntry || signerConfigIds.includes(currentUserId) || (!signerConfigIds.length && assignmentMemberId === currentUserId); %>
                              <% userActionable = !isCompleted && canSign && !hasSigned; %>
                              <% userDone = isCompleted || hasSigned; %>
                              <% statusText = isCompleted ? 'Completed' : (hasSigned ? 'Signed' : (userActionable ? 'Action needed' : 'Waiting')); %>
                            <% } %>

                            <% const stepClass = 'onboarding-step-link'
                              + (index === 0 ? ' active' : '')
                              + (userDone ? ' completed' : '')
                              + (userActionable ? ' actionable' : '')
                              + (!userActionable && !userDone ? ' waiting' : ''); %>

                            <button type="button" class="<%= stepClass %>" data-step-link data-step="<%= index %>" role="tab">
                              <span class="onboarding-step-index"><%= index + 1 %></span>
                              <span class="onboarding-step-body">
                                <span class="onboarding-step-title"><%= item.title %></span>
                                <span class="onboarding-step-meta">
                                  <span class="onboarding-step-chip"><%= typeText %></span>
                                  <span class="onboarding-step-chip"><%= isRequired ? 'Required' : 'Optional' %></span>
                                  <span class="onboarding-step-chip status"><%= statusText %></span>
                                </span>
                              </span>
                            </button>
                          <% }) %>
                        </div>

                        <div>
                          <% visibleItems.forEach((item, index) => { %>
                            <% const isRequired = item.required !== false; %>
                            <% const isCompleted = item.status === 'completed'; %>
                            <% let userActionable = false; %>
                            <% let userDone = false; %>

                            <% if (item.type === 'form' || item.type === 'upload') { %>
                              <% userActionable = !isCompleted; %>
                              <% userDone = isCompleted; %>
                            <% } %>

                            <% if (item.type === 'esign') { %>
                              <% const signerConfigList = item.config?.signers || []; %>
                              <% const signerStatusList = item.data?.esign?.signers || []; %>
                              <% const signerConfigIds = signerConfigList.map(signer => String(signer.member || signer.memberId || signer.key || signer)); %>
                              <% const signerEntry = signerStatusList.find(signer => String(signer.member) === currentUserId); %>
                              <% const hasSigned = signerEntry && signerEntry.status === 'signed'; %>
                              <% const canSign = signerEntry || signerConfigIds.includes(currentUserId) || (!signerConfigIds.length && assignmentMemberId === currentUserId); %>
                              <% userActionable = !isCompleted && canSign && !hasSigned; %>
                              <% userDone = isCompleted || hasSigned; %>
                            <% } %>

                            <section
                              class="onboarding-step-panel<%= index === 0 ? ' active' : '' %>"
                              data-step-panel
                              data-step="<%= index %>"
                              data-step-required="<%= isRequired ? 1 : 0 %>"
                              data-step-actionable="<%= userActionable ? 1 : 0 %>"
                              data-step-userdone="<%= userDone ? 1 : 0 %>"
                            >
                              <div class="onboarding-step-panel-header">
                                <div>
                                  <div class="onboarding-step-panel-title">Step <%= index + 1 %>: <%= item.title %></div>
                                  <% if (item.description) { %>
                                    <div class="onboarding-step-panel-subtitle"><%= item.description %></div>
                                  <% } %>
                                </div>
                                <div class="onboarding-step-panel-badges">
                                  <span class="role-badge onboarding-badge onboarding-<%= isRequired ? 'pending' : 'not_started' %>"><%= isRequired ? 'required' : 'optional' %></span>
                                  <span class="role-badge onboarding-badge onboarding-<%= isCompleted ? 'completed' : 'pending' %>"><%= isCompleted ? 'Completed' : 'Pending' %></span>
                                </div>
                              </div>

                              <% if (item.type === 'form') { %>
                                <% if (item.status !== 'completed') { %>
                                  <form data-form-item data-assignment="<%= assignment._id %>" data-item="<%= item._id %>" style="margin-top: 12px;">
                                    <% if (item.config?.fields && item.config.fields.length > 0) { %>
                                      <% item.config.fields.forEach(field => { %>
                                        <div class="form-group">
                                          <label for="field-<%= item._id %>-<%= field.key %>"><%= field.label %></label>
                                          <% if (field.type === 'textarea') { %>
                                            <textarea id="field-<%= item._id %>-<%= field.key %>" name="<%= field.key %>" <%= field.required ? 'required' : '' %>></textarea>
                                          <% } else if (field.type === 'select') { %>
                                            <select id="field-<%= item._id %>-<%= field.key %>" name="<%= field.key %>" <%= field.required ? 'required' : '' %>>
                                              <option value="">Select...</option>
                                              <% (field.options || []).forEach(option => { %>
                                                <option value="<%= option %>"><%= option %></option>
                                              <% }) %>
                                            </select>
                                          <% } else { %>
                                            <input type="<%= field.type || 'text' %>" id="field-<%= item._id %>-<%= field.key %>" name="<%= field.key %>" <%= field.required ? 'required' : '' %> />
                                          <% } %>
                                        </div>
                                      <% }) %>
                                    <% } else { %>
                                      <div class="form-group">
                                        <label for="field-<%= item._id %>-notes">Details</label>
                                        <textarea id="field-<%= item._id %>-notes" name="details"></textarea>
                                      </div>
                                    <% } %>
                                    <div class="form-actions">
                                      <button class="btn btn-primary" type="submit">Submit</button>
                                    </div>
                                  </form>
                                <% } else { %>
                                  <div class="alert alert-success" style="margin:0;">Submitted.</div>
                                  <% const submitted = item.data?.form || {}; %>
                                  <% const submittedKeys = Object.keys(submitted || {}); %>
                                  <% const fields = item.config?.fields || []; %>
                                  <% if (fields.length || submittedKeys.length) { %>
                                    <div class="onboarding-submitted-grid">
                                      <% if (fields.length) { %>
                                        <% fields.forEach(field => { %>
                                          <div class="onboarding-submitted-row">
                                            <div class="onboarding-submitted-key"><%= field.label %></div>
                                            <div class="onboarding-submitted-value"><%= submitted[field.key] ?? '' %></div>
                                          </div>
                                        <% }) %>
                                      <% } else { %>
                                        <% submittedKeys.forEach(key => { %>
                                          <div class="onboarding-submitted-row">
                                            <div class="onboarding-submitted-key"><%= key %></div>
                                            <div class="onboarding-submitted-value"><%= submitted[key] ?? '' %></div>
                                          </div>
                                        <% }) %>
                                      <% } %>
                                    </div>
                                  <% } %>
                                <% } %>
                              <% } %>

                              <% if (item.type === 'upload') { %>
                                <% if (item.status !== 'completed') { %>
                                  <div style="margin-top: 12px;">
                                    <input type="file" data-upload-input data-assignment="<%= assignment._id %>" data-item="<%= item._id %>" accept="<%= item.config?.accept || '.pdf,.jpg,.jpeg,.png' %>" />
                                    <button class="btn btn-secondary" type="button" style="margin-top: 8px;" onclick="uploadOnboardingFile('<%= assignment._id %>', '<%= item._id %>')">Upload</button>
                                  </div>
                                <% } else { %>
                                  <div style="display:flex; align-items:center; justify-content:space-between; gap: 12px; flex-wrap: wrap;">
                                    <div class="alert alert-success" style="margin:0;">Uploaded.</div>
                                    <a class="btn btn-secondary btn-sm" href="/onboarding/assignments/<%= assignment._id %>/items/<%= item._id %>/document" target="_blank" rel="noreferrer">View uploaded</a>
                                  </div>
                                  <% if (item.data?.upload?.fileName) { %>
                                    <div style="margin-top: 8px; color: var(--muted); font-size: 12px;">
                                      <%= item.data.upload.fileName %>
                                    </div>
                                  <% } %>
                                <% } %>
                              <% } %>

                              <% if (item.type === 'esign') { %>
                                <% const signerConfigList = item.config?.signers || []; %>
                                <% const signerStatusList = item.data?.esign?.signers || []; %>
                                <% const signerConfigIds = signerConfigList.map(signer => String(signer.member || signer.memberId || signer.key || signer)); %>
                                <% const signerEntry = signerStatusList.find(signer => String(signer.member) === currentUserId); %>
                                <% const hasSigned = signerEntry && signerEntry.status === 'signed'; %>
                                <% const canSign = signerEntry || signerConfigIds.includes(currentUserId) || (!signerConfigIds.length && assignmentMemberId === currentUserId); %>
                                <div style="margin-top: 12px; display:flex; gap: 10px; flex-wrap: wrap; align-items:center;">
                                  <span style="color: var(--muted); font-size: 13px;">
                                    Document: <%= item.config?.document?.fileName || 'Contract' %>
                                  </span>
                                  <% if (item.config?.document?.url) { %>
                                    <a class="btn btn-secondary btn-sm" href="/onboarding/assignments/<%= assignment._id %>/items/<%= item._id %>/document?version=original" target="_blank" rel="noreferrer">View</a>
                                  <% } %>
                                  <% if (item.status !== 'completed' && canSign && !hasSigned) { %>
                                    <button
                                      class="btn btn-primary btn-sm"
                                      type="button"
                                      data-esign-button
                                      data-assignment="<%= assignment._id %>"
                                      data-item="<%= item._id %>"
                                      data-assignee-id="<%= assignmentMemberId %>"
                                      data-doc-name="<%= item.config?.document?.fileName || 'Contract' %>"
                                      data-doc-url="<%= item.config?.document?.url || '' %>"
                                      data-preview-url="<%= item.data?.esign?.signedUrl || item.config?.document?.url || '' %>"
                                      data-fields="<%= encodeURIComponent(JSON.stringify(item.config?.signatureFields || [])) %>"
                                    >Sign document</button>
                                  <% } else if (item.data?.esign?.signedUrl) { %>
                                    <a class="btn btn-secondary btn-sm" href="/onboarding/assignments/<%= assignment._id %>/items/<%= item._id %>/document?version=signed" target="_blank" rel="noreferrer">Signed document</a>
                                  <% } %>
                                </div>

                                <% if (!canSign && item.status !== 'completed') { %>
                                  <div style="margin-top: 6px; font-size: 12px; color: var(--muted);">You are not assigned to sign this document.</div>
                                <% } %>

                                <% const displaySigners = signerStatusList.length
                                  ? signerStatusList
                                  : signerConfigList.map(signer => ({
                                      name: signer.name || signer.label,
                                      email: signer.email,
                                      status: 'pending'
                                    })); %>
                                <% if (displaySigners.length) { %>
                                  <div style="margin-top: 8px; font-size: 12px; color: var(--muted);">
                                    <% displaySigners.forEach((signer, idx) => { %>
                                      <span>
                                        <%= signer.name || signer.email %>: <%= signer.status === 'signed' ? 'Signed' : 'Pending' %>
                                      </span>
                                      <% if (idx < displaySigners.length - 1) { %>
                                        <span> | </span>
                                      <% } %>
                                    <% }) %>
                                  </div>
                                <% } %>
                                <% if (hasSigned && item.status !== 'completed') { %>
                                  <div style="margin-top: 6px; font-size: 12px; color: var(--muted);">You have signed. Waiting on others.</div>
                                <% } %>
                              <% } %>
                            </section>
                          <% }) %>

                          <div class="onboarding-step-controls">
                            <button class="btn btn-secondary" type="button" data-step-prev>Previous</button>
                            <div class="onboarding-step-indicator" data-step-indicator-inline></div>
                            <button class="btn btn-secondary" type="button" data-step-next>Next</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% } %>
                <% } %>
              </div>
            <% }) %>
            <div class="empty-state assignment-board-empty" data-personal-empty hidden>
              <h3>No assignments in this view</h3>
              <p>Switch filter to view current or historical onboarding tasks.</p>
            </div>
          <% } %>
        </div>
      </div>

      <div class="tab-panel" id="tab-onboarding-center">
    <% } %>

    <% const templateList = templates || []; %>
    <% const assignmentList = assignments || []; %>
    <% const memberSummary = memberOnboardingSummary || {}; %>
    <% const memberRows = memberOnboardingRows || []; %>
    <% const onboardingActivityFeed = onboardingActivities || []; %>
    <% const defaultTemplate = templateList.find(template => template.isDefault); %>
    <% const activeAssignmentCount = assignmentList.filter(assignment => assignment.status !== 'completed' && assignment.status !== 'cancelled').length; %>
    <% const completedAssignmentCount = assignmentList.filter(assignment => assignment.status === 'completed').length; %>

    <div class="onboarding-center-shell">
      <div class="center-kpis" aria-label="Onboarding metrics">
        <div class="center-kpi">
          <div class="center-kpi-label">Templates</div>
          <div class="center-kpi-value"><%= templateList.length %></div>
          <div class="center-kpi-meta">Reusable flows</div>
        </div>
        <div class="center-kpi">
          <div class="center-kpi-label">Default Template</div>
          <div class="center-kpi-value center-kpi-value-sm"><%= defaultTemplate ? defaultTemplate.name : 'None' %></div>
          <div class="center-kpi-meta">Applied by default</div>
        </div>
        <div class="center-kpi">
          <div class="center-kpi-label">Active</div>
          <div class="center-kpi-value"><%= activeAssignmentCount %></div>
          <div class="center-kpi-meta">In progress</div>
        </div>
        <div class="center-kpi">
          <div class="center-kpi-label">Completed</div>
          <div class="center-kpi-value"><%= completedAssignmentCount %></div>
          <div class="center-kpi-meta">Done assignments</div>
        </div>
        <div class="center-kpi">
          <div class="center-kpi-label">Members Completed</div>
          <div class="center-kpi-value"><%= memberSummary.completedMembers || 0 %></div>
          <div class="center-kpi-meta">People fully onboarded</div>
        </div>
        <div class="center-kpi">
          <div class="center-kpi-label">Completion Rate</div>
          <div class="center-kpi-value"><%= memberSummary.completionRate || 0 %>%</div>
          <div class="center-kpi-meta">Across active members</div>
        </div>
        <div class="center-kpi">
          <div class="center-kpi-label">Not Started</div>
          <div class="center-kpi-value"><%= memberSummary.notStartedMembers || 0 %></div>
          <div class="center-kpi-meta">No assignment yet</div>
        </div>
      </div>

    <div class="card center-card-assign assign-onboarding-card">
      <div class="center-card-header">
        <h2>Assign Onboarding</h2>
        <p>Create assignments, manage templates, and track recent activity.</p>
      </div>

      <div class="assign-onboarding-tabs" role="tablist" aria-label="Assign Onboarding sections">
        <button type="button" class="assign-tab-button active" data-assign-tab="assign" role="tab" aria-selected="true">Assign</button>
        <button type="button" class="assign-tab-button" data-assign-tab="templates" role="tab" aria-selected="false">Templates</button>
        <button type="button" class="assign-tab-button" data-assign-tab="recent" role="tab" aria-selected="false">Recent Assignments</button>
        <button type="button" class="assign-tab-button" data-assign-tab="members" role="tab" aria-selected="false">Member Completion</button>
        <button type="button" class="assign-tab-button" data-assign-tab="notifications" role="tab" aria-selected="false">Notifications</button>
      </div>

      <div class="assign-onboarding-tab-panel active" id="assign-tab-assign" data-assign-panel="assign" role="tabpanel" aria-label="New assignment">
        <div class="center-wizard">
      <div class="center-wizard-step-list" role="tablist" aria-label="Assignment steps">
        <button type="button" class="center-wizard-step active" data-center-step="1" role="tab" aria-selected="true">
          <span class="center-wizard-step-index">1</span>
          <span>Recipient</span>
        </button>
        <button type="button" class="center-wizard-step" data-center-step="2" role="tab" aria-selected="false">
          <span class="center-wizard-step-index">2</span>
          <span>Custom Items</span>
        </button>
        <button type="button" class="center-wizard-step" data-center-step="3" role="tab" aria-selected="false">
          <span class="center-wizard-step-index">3</span>
          <span>Review</span>
        </button>
      </div>

      <div class="center-wizard-panels">
        <section class="center-step-panel active" data-center-step-panel="1" role="tabpanel" aria-label="Step 1: Recipient and schedule">
          <div class="center-panel-heading">
            <h3 tabindex="-1">Step 1: Recipient and Schedule</h3>
            <p>Select member, optional template, and due date.</p>
          </div>
        <div class="form-group">
          <label for="assignmentMember">Member</label>
          <select id="assignmentMember">
            <option value="">Select member</option>
            <% members.forEach(member => { %>
              <option value="<%= member.id %>"><%= member.name %> (<%= member.email %>)</option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="assignmentTemplate">Template (optional)</label>
          <select id="assignmentTemplate">
            <option value="">No template</option>
            <% templates.forEach(template => { %>
              <option value="<%= template._id %>" <%= template.isDefault ? 'selected' : '' %>>
                <%= template.name %><%= template.isDefault ? ' (Default)' : '' %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="assignmentDue">Due Date (optional)</label>
          <input type="date" id="assignmentDue" />
        </div>

        </section>

        <section class="center-step-panel" data-center-step-panel="2" role="tabpanel" aria-label="Step 2: Custom items" hidden>
          <div class="center-panel-heading">
            <h3 tabindex="-1">Step 2: Add Custom Items</h3>
            <p>Create any extra tasks needed for this assignment.</p>
          </div>

        <div class="card center-items-card" style="margin:0;">
          <div class="center-items-header">
            <h3 style="margin-top:0">Custom Items</h3>
            <span class="center-items-count" id="custom-items-count">0 item(s)</span>
          </div>
          <div id="custom-items-list" class="center-items-list"></div>

          <div class="center-builder-fields">
            <div class="form-group">
              <label for="custom-type">Type</label>
              <select id="custom-type">
                <option value="form">Form</option>
                <option value="upload">Upload</option>
                <option value="esign">E-Sign</option>
              </select>
            </div>
            <div class="form-group">
              <label for="custom-title">Title</label>
              <input type="text" id="custom-title" placeholder="e.g. Employee Details" />
            </div>
            <div class="form-group">
              <label for="custom-description">Description</label>
              <textarea id="custom-description" placeholder="Instructions for the employee"></textarea>
            </div>
            <div class="form-group">
              <label>
                <input type="checkbox" id="custom-required" checked /> Required
              </label>
            </div>
            <div class="form-group" id="custom-form-fields">
              <label>Form fields</label>
              <div class="form-builder-shell" data-form-builder="custom">
                <div class="form-builder-toolbar">
                  <button class="btn btn-secondary btn-sm" type="button" onclick="addFormField('custom', 'text')">+ Short text</button>
                  <button class="btn btn-secondary btn-sm" type="button" onclick="addFormField('custom', 'textarea')">+ Paragraph</button>
                  <button class="btn btn-secondary btn-sm" type="button" onclick="addFormField('custom', 'email')">+ Email</button>
                  <button class="btn btn-secondary btn-sm" type="button" onclick="addFormField('custom', 'date')">+ Date</button>
                  <button class="btn btn-secondary btn-sm" type="button" onclick="addFormField('custom', 'select')">+ Dropdown</button>
                </div>
                <div id="custom-form-field-list" class="form-builder-field-list"></div>
                <div class="form-builder-preview">
                  <div class="form-builder-preview-title">Live preview</div>
                  <div id="custom-form-preview" class="form-builder-preview-body"></div>
                </div>
              </div>
              <textarea id="custom-fields" style="display:none;" aria-hidden="true"></textarea>
              <div class="form-hint">Drag fields to reorder. Click "Add Custom Item" when the form preview looks right.</div>
            </div>
            <div class="form-group" id="custom-upload-accept" style="display:none;">
              <label for="custom-accept">Accepted file types</label>
              <input type="text" id="custom-accept" value=".pdf,.jpg,.jpeg,.png" />
            </div>
            <div class="form-group" id="custom-esign-signers" style="display:none;">
              <label>Signers</label>
              <div id="custom-signers-options" class="signers-options-list"></div>
              <div class="form-hint">Select who must sign. "Onboarding member" will sign as the assignee.</div>
            </div>
            <div class="form-group" id="custom-esign-fields" style="display:none;">
              <label>Signature Fields</label>

              <div class="esign-builder">
                <div class="esign-panel">
                  <div class="esign-panel-header">
                    <div class="esign-panel-title">Field Tools</div>
                    <div style="color: var(--muted); font-size: 12px;">Pick a recipient, then drag a field onto the PDF. Drag to move; use the corner handle to resize.</div>
                  </div>

                  <div class="esign-palette" aria-label="Field type palette">
                    <button class="esign-chip active" type="button" data-esign-chip="custom" data-type="signature" onclick="setFieldType('custom', 'signature')">Signature</button>
                    <button class="esign-chip" type="button" data-esign-chip="custom" data-type="date" onclick="setFieldType('custom', 'date')">Date</button>
                    <button class="esign-chip" type="button" data-esign-chip="custom" data-type="text" onclick="setFieldType('custom', 'text')">Name/Text</button>
                  </div>

                  <div class="form-group">
                    <label for="custom-sign-signer">Active recipient</label>
                    <div id="custom-recipient-chips" class="esign-recipient-chips" aria-label="Recipients"></div>
                    <select id="custom-sign-signer"></select>
                  </div>

                  <div class="form-group">
                    <label for="custom-sign-type">Field type</label>
                    <select id="custom-sign-type">
                      <option value="signature">Signature</option>
                      <option value="date">Date</option>
                      <option value="text">Text</option>
                    </select>
                  </div>

                  <div class="form-group">
                    <label for="custom-sign-label">Label</label>
                    <input type="text" id="custom-sign-label" placeholder="e.g. Employee Signature" />
                  </div>

                  <div class="form-group" id="custom-sign-text-wrap" style="display:none;">
                    <label for="custom-sign-text">Text (optional)</label>
                    <input type="text" id="custom-sign-text" placeholder="Leave blank to use the signer's name" />
                    <div class="form-hint">Only used when Field type is Text.</div>
                  </div>

                  <details class="esign-advanced">
                    <summary>Advanced placement</summary>
                    <div class="esign-advanced-grid">
                      <input type="number" id="custom-sign-page" placeholder="Page" value="1" min="1" />
                      <select id="custom-sign-origin">
                        <option value="top-left">Top-left origin</option>
                        <option value="bottom-left">Bottom-left origin</option>
                      </select>
                      <input type="number" id="custom-sign-x" placeholder="X" value="50" />
                      <input type="number" id="custom-sign-y" placeholder="Y" value="50" />
                      <input type="number" id="custom-sign-width" placeholder="Width" value="180" />
                      <input type="number" id="custom-sign-height" placeholder="Height" value="60" />
                    </div>
                    <div style="display:flex; gap: 8px; flex-wrap: wrap; margin-top: 10px;">
                      <button class="btn btn-secondary btn-sm" type="button" onclick="addSignatureField('custom')">Add Field At Coordinates</button>
                      <button class="btn btn-danger btn-sm" type="button" onclick="removeSelectedSignatureField('custom')">Delete Selected</button>
                    </div>
                    <div class="form-hint" style="margin-top: 10px;">Coordinates are in PDF points (72 = 1 inch). Drag fields to reposition.</div>
                  </details>

                  <div class="esign-panel-header" style="margin-top: 12px;">
                    <div class="esign-panel-title">Fields</div>
                    <div id="custom-signature-fields-count" style="color: var(--muted); font-size: 12px;"></div>
                  </div>
                  <div id="custom-signature-fields-list" class="esign-fields-list"></div>
                  <div class="form-hint" style="margin-top: 10px;">Drag fields from the left onto the document. Drag to move, use the corner to resize. Click a field to edit.</div>
                </div>

                <div>
                  <div class="pdf-viewer" id="custom-pdf-viewer" style="display:none;">
                    <div class="pdf-toolbar">
                      <div style="display:flex; gap: 6px; align-items:center;">
                        <button class="btn btn-secondary btn-sm" type="button" onclick="changePdfPage('custom', -1)">Prev</button>
                        <span id="custom-pdf-page-label" style="font-size: 12px; color: var(--muted);">Page 1 / 1</span>
                        <button class="btn btn-secondary btn-sm" type="button" onclick="changePdfPage('custom', 1)">Next</button>
                      </div>
                      <div style="display:flex; gap: 6px; align-items:center;">
                        <button class="btn btn-secondary btn-sm" type="button" onclick="changePdfZoom('custom', -0.15)">-</button>
                        <span id="custom-pdf-zoom-label" style="font-size: 12px; color: var(--muted);">100%</span>
                        <button class="btn btn-secondary btn-sm" type="button" onclick="changePdfZoom('custom', 0.15)">+</button>
                        <button class="btn btn-secondary btn-sm" type="button" id="custom-place-toggle" onclick="togglePlaceMode('custom')">Click to place: OFF</button>
                        <button class="btn btn-secondary btn-sm" type="button" onclick="openEsignFilePicker('custom')">Upload PDF</button>
                        <button class="btn btn-danger btn-sm" type="button" onclick="removeEsignDocument('custom')">Remove PDF</button>
                        <span id="custom-document-status-toolbar" class="pdf-toolbar-status"></span>
                      </div>
                    </div>
                    <div class="pdf-canvas-wrap" id="custom-pdf-canvas-wrap">
                      <div class="pdf-stage" id="custom-pdf-stage">
                        <canvas id="custom-pdf-canvas"></canvas>
                        <div class="pdf-overlay" id="custom-pdf-overlay"></div>
                      </div>
                    </div>
                  </div>
                  <div class="empty-state" id="custom-pdf-empty">
                    <div class="pdf-dropzone" data-pdf-dropzone="custom" tabindex="0" role="button" aria-label="Upload PDF">
                      <input type="file" id="custom-document" accept=".pdf" style="display:none;" />
                      <div class="pdf-dropzone-title">Drop a PDF to start</div>
                      <div class="pdf-dropzone-subtitle">or click to choose a file (uploads immediately)</div>
                      <div class="pdf-dropzone-actions">
                        <button class="btn btn-primary btn-sm" type="button" onclick="openEsignFilePicker('custom')">Choose PDF</button>
                      </div>
                      <div id="custom-document-status" class="pdf-dropzone-status">No document uploaded.</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="center-builder-actions">
              <button class="btn btn-secondary" type="button" onclick="addCustomItem()">Add Custom Item</button>
            </div>
          </div>
        </div>

        </section>

        <section class="center-step-panel" data-center-step-panel="3" role="tabpanel" aria-label="Step 3: Review and assign" hidden>
          <div class="center-panel-heading">
            <h3 tabindex="-1">Step 3: Review and Assign</h3>
            <p>Double-check details before assigning.</p>
          </div>
          <div class="center-review-grid">
            <div class="center-review-row">
              <div class="center-review-label">Recipient</div>
              <div class="center-review-value" id="review-member">Not selected</div>
            </div>
            <div class="center-review-row">
              <div class="center-review-label">Template</div>
              <div class="center-review-value" id="review-template">No template</div>
            </div>
            <div class="center-review-row">
              <div class="center-review-label">Due Date</div>
              <div class="center-review-value" id="review-due">Not set</div>
            </div>
            <div class="center-review-row">
              <div class="center-review-label">Custom Items</div>
              <div class="center-review-value" id="review-custom-count">0 item(s)</div>
            </div>
            <div class="center-review-row">
              <div class="center-review-label">E-Sign Items</div>
              <div class="center-review-value" id="review-esign-count">0 item(s)</div>
            </div>
          </div>
          <div class="form-actions center-review-actions">
            <button class="btn btn-primary" type="button" onclick="assignOnboarding()">Assign Onboarding</button>
          </div>
        </section>

        <div class="center-step-controls">
          <button class="btn btn-secondary" type="button" id="center-step-prev" onclick="prevCenterStep()">Back</button>
          <div class="center-step-indicator" id="center-step-indicator">Step 1 of 3</div>
          <button class="btn btn-secondary" type="button" id="center-step-next" onclick="nextCenterStep()">Continue</button>
        </div>
      </div>
        </div>
      </div>

      <div class="assign-onboarding-tab-panel" id="assign-tab-templates" data-assign-panel="templates" role="tabpanel" aria-label="Templates" hidden>
        <div class="template-library">
          <div class="template-library-tools">
            <input type="text" data-template-filter placeholder="Search templates..." aria-label="Search templates" />
          </div>
          <% if (templates && templates.length > 0) { %>
            <div class="template-library-list">
              <% templates.forEach(template => { %>
                <article
                  class="template-library-item"
                  data-template-item
                  data-template-search="<%= (template.name + ' ' + (template.description || '')).toLowerCase() %>"
                >
                  <div class="template-library-item-head">
                    <div class="template-library-item-title">
                      <%= template.name %>
                      <% if (template.isDefault) { %>
                        <span class="role-badge onboarding-badge onboarding-completed">Default</span>
                      <% } %>
                    </div>
                    <div class="template-library-item-meta">
                      <%= template.items.length %> item<%= template.items.length === 1 ? '' : 's' %>
                    </div>
                  </div>
                  <div class="template-library-item-desc"><%= template.description || 'No description' %></div>
                  <div class="template-library-item-actions">
                    <button class="btn btn-secondary btn-sm" type="button" data-use-template="<%= template._id %>">Use Template</button>
                    <% if (!template.isDefault) { %>
                      <button class="btn btn-secondary btn-sm" type="button" onclick="setDefaultTemplate('<%= template._id %>')">Set Default</button>
                    <% } %>
                    <button class="btn btn-danger btn-sm" type="button" onclick="deleteTemplate('<%= template._id %>')">Delete</button>
                  </div>
                </article>
              <% }) %>
            </div>
            <div class="empty-state template-library-empty" data-template-empty hidden>
              <h3>No matching templates</h3>
              <p>Try a different search term.</p>
            </div>
          <% } else { %>
            <div class="empty-state">
              <h3>No templates yet</h3>
              <p>Create a template for general onboarding.</p>
            </div>
          <% } %>
        </div>
      </div>

      <div class="assign-onboarding-tab-panel" id="assign-tab-recent" data-assign-panel="recent" role="tabpanel" aria-label="Recent assignments" hidden>
        <div class="assignment-board">
      <div class="center-card-header">
        <h2>Recent Assignments</h2>
        <p>Monitor status and take quick actions.</p>
      </div>
      <div class="assignment-board-tools">
        <input type="text" data-assignment-filter placeholder="Search assignments..." aria-label="Search assignments" />
      </div>
      <div class="assignment-board-status" role="tablist" aria-label="Filter assignments by status">
        <button type="button" class="assignment-status-chip active" data-assignment-status-filter="all" aria-selected="true">All</button>
        <button type="button" class="assignment-status-chip" data-assignment-status-filter="pending" aria-selected="false">Pending</button>
        <button type="button" class="assignment-status-chip" data-assignment-status-filter="in_progress" aria-selected="false">In Progress</button>
        <button type="button" class="assignment-status-chip" data-assignment-status-filter="completed" aria-selected="false">Completed</button>
        <button type="button" class="assignment-status-chip" data-assignment-status-filter="cancelled" aria-selected="false">Cancelled</button>
      </div>
      <% if (assignments && assignments.length > 0) { %>
        <div class="assignment-board-list">
          <% assignments.forEach(assignment => { %>
            <% const assignmentName = assignment.member?.profile?.name || assignment.member?.email || 'Member'; %>
            <% const assignmentSearch = (assignmentName + ' ' + (assignment.member?.email || '') + ' ' + assignment.status).toLowerCase(); %>
            <article
              class="assignment-board-item assignment-board-item--<%= assignment.status %>"
              data-assignment-item
              data-assignment-status="<%= assignment.status %>"
              data-assignment-search="<%= assignmentSearch %>"
            >
              <div class="assignment-board-item-main">
                <div class="assignment-board-item-name"><%= assignmentName %></div>
                <div class="assignment-board-item-meta">
                  Assigned <%= new Date(assignment.createdAt).toLocaleDateString() %>
                  <% if (assignment.dueAt) { %>
                    - Due <%= new Date(assignment.dueAt).toLocaleDateString() %>
                  <% } %>
                </div>
              </div>
              <div class="assignment-board-item-actions">
                <span class="role-badge onboarding-badge onboarding-<%= assignment.status %>"><%= assignment.status.replace('_', ' ') %></span>
                <a class="btn btn-secondary btn-sm" href="/organizations/<%= organization._id %>/onboarding/assignments/<%= assignment._id %>">View</a>
                <% if (assignment.status !== 'completed' && assignment.status !== 'cancelled') { %>
                  <button class="btn btn-danger btn-sm" type="button" onclick="cancelAssignment('<%= assignment._id %>')">Cancel</button>
                <% } %>
              </div>
            </article>
          <% }) %>
        </div>
        <div class="empty-state assignment-board-empty" data-assignment-empty hidden>
          <h3>No matching assignments</h3>
          <p>Adjust your search or filter.</p>
        </div>
      <% } else { %>
        <div class="empty-state">
          <h3>No assignments yet</h3>
          <p>Assign onboarding to get started.</p>
        </div>
      <% } %>
        </div>
      </div>

      <div class="assign-onboarding-tab-panel" id="assign-tab-members" data-assign-panel="members" role="tabpanel" aria-label="Member completion" hidden>
        <div class="assignment-board">
          <div class="center-card-header">
            <h2>Member Completion Analytics</h2>
            <p>Track who has completed onboarding and who still needs follow-up.</p>
          </div>

          <div class="center-kpis" aria-label="Member onboarding summary">
            <div class="center-kpi">
              <div class="center-kpi-label">Total Members</div>
              <div class="center-kpi-value"><%= memberSummary.totalMembers || 0 %></div>
              <div class="center-kpi-meta">Active in organization</div>
            </div>
            <div class="center-kpi">
              <div class="center-kpi-label">Completed</div>
              <div class="center-kpi-value"><%= memberSummary.completedMembers || 0 %></div>
              <div class="center-kpi-meta">Fully onboarded</div>
            </div>
            <div class="center-kpi">
              <div class="center-kpi-label">In Progress</div>
              <div class="center-kpi-value"><%= memberSummary.inProgressMembers || 0 %></div>
              <div class="center-kpi-meta">Started onboarding</div>
            </div>
            <div class="center-kpi">
              <div class="center-kpi-label">Pending</div>
              <div class="center-kpi-value"><%= memberSummary.pendingMembers || 0 %></div>
              <div class="center-kpi-meta">Assigned, not started</div>
            </div>
          </div>

          <% if (memberRows.length > 0) { %>
            <div class="assignment-board-list" style="margin-top: 12px;">
              <% memberRows.forEach(memberRow => { %>
                <% const latestAssignment = memberRow.latestAssignment || null; %>
                <article class="assignment-board-item assignment-board-item--<%= memberRow.onboardingStatus %>">
                  <div class="assignment-board-item-main">
                    <div class="assignment-board-item-name"><%= memberRow.name %></div>
                    <div class="assignment-board-item-meta">
                      <%= memberRow.email %>
                      <% if (latestAssignment?.createdAt) { %>
                        - Last assigned <%= new Date(latestAssignment.createdAt).toLocaleDateString() %>
                      <% } %>
                      <% if (latestAssignment?.completedAt) { %>
                        - Completed <%= new Date(latestAssignment.completedAt).toLocaleDateString() %>
                      <% } %>
                    </div>
                  </div>
                  <div class="assignment-board-item-actions">
                    <span class="role-badge onboarding-badge onboarding-<%= memberRow.onboardingStatus %>"><%= memberRow.onboardingStatus.replace('_', ' ') %></span>
                    <% if (latestAssignment?.id) { %>
                      <a class="btn btn-secondary btn-sm" href="/organizations/<%= organization._id %>/onboarding/assignments/<%= latestAssignment.id %>">View latest</a>
                    <% } %>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-state">
              <h3>No members found</h3>
              <p>Invite members to start tracking onboarding progress.</p>
            </div>
          <% } %>
        </div>
      </div>

      <div class="assign-onboarding-tab-panel" id="assign-tab-notifications" data-assign-panel="notifications" role="tabpanel" aria-label="Onboarding notifications" hidden>
        <div class="assignment-board">
          <div class="center-card-header">
            <h2>Onboarding Notifications</h2>
            <p>Admins can monitor assignment and completion activity in this feed.</p>
          </div>

          <% if (onboardingActivityFeed.length > 0) { %>
            <div class="assignment-board-list">
              <% onboardingActivityFeed.forEach(activity => { %>
                <% const memberName = activity.member?.profile?.name || activity.member?.email || 'Member'; %>
                <% const actorName = activity.actor?.profile?.name || activity.actor?.email || 'System'; %>
                <% const activityAssignmentId = activity.assignment?._id || activity.assignment; %>
                <% const eventLabel = activity.type === 'assignment_completed'
                  ? 'Completed'
                  : (activity.type === 'assignment_cancelled' ? 'Cancelled' : 'Assigned'); %>
                <% const eventDescription = activity.type === 'assignment_completed'
                  ? `${memberName} completed onboarding`
                  : (activity.type === 'assignment_cancelled'
                    ? `${actorName} cancelled onboarding for ${memberName}`
                    : `${actorName} assigned onboarding to ${memberName}`); %>
                <% const activityStatusClass = activity.type === 'assignment_completed'
                  ? 'completed'
                  : (activity.type === 'assignment_cancelled' ? 'cancelled' : 'pending'); %>
                <article class="assignment-board-item assignment-board-item--<%= activityStatusClass %>">
                  <div class="assignment-board-item-main">
                    <div class="assignment-board-item-name"><%= eventDescription %></div>
                    <div class="assignment-board-item-meta">
                      <%= new Date(activity.createdAt).toLocaleString() %>
                      <% if (activity.metadata?.triggerItemType) { %>
                        - Triggered by <%= activity.metadata.triggerItemType %> item
                      <% } %>
                    </div>
                  </div>
                  <div class="assignment-board-item-actions">
                    <span class="role-badge onboarding-badge onboarding-<%= activityStatusClass %>">
                      <%= eventLabel %>
                    </span>
                    <% if (activityAssignmentId) { %>
                      <a class="btn btn-secondary btn-sm" href="/organizations/<%= organization._id %>/onboarding/assignments/<%= activityAssignmentId %>">Open</a>
                    <% } %>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-state">
              <h3>No onboarding notifications yet</h3>
              <p>Activity will appear here once onboarding is assigned or completed.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
    </div>
    <% if (typeof personalAssignments !== 'undefined') { %>
      </div>
    <% } %>
  </div>

  <!-- Template Modal -->
  <div class="modal" id="templateModal">
    <div class="modal-content modal-xl template-modal-shell">
      <div class="modal-header">
        <h2>Create Template</h2>
        <button class="modal-close" onclick="hideTemplateModal()">&times;</button>
      </div>
      <div class="template-modal-step-list" role="tablist" aria-label="Template builder steps">
        <button type="button" class="template-modal-step active" data-template-modal-step="1" role="tab" aria-selected="true">
          <span class="template-modal-step-index">A</span>
          <span>Basics</span>
        </button>
        <button type="button" class="template-modal-step" data-template-modal-step="2" role="tab" aria-selected="false">
          <span class="template-modal-step-index">B</span>
          <span>Items</span>
        </button>
        <button type="button" class="template-modal-step" data-template-modal-step="3" role="tab" aria-selected="false">
          <span class="template-modal-step-index">C</span>
          <span>Review</span>
        </button>
      </div>

      <section class="template-modal-panel active" data-template-modal-panel="1" role="tabpanel" aria-label="Template basics">
        <div class="template-modal-panel-heading">
          <h3 tabindex="-1">Step A: Basics</h3>
          <p>Name the template and set default behavior.</p>
        </div>
      <div class="form-group">
        <label for="template-name">Template name</label>
        <input type="text" id="template-name" placeholder="General Onboarding" />
      </div>
      <div class="form-group">
        <label for="template-description">Description</label>
        <textarea id="template-description" placeholder="Standard onboarding for new hires"></textarea>
      </div>
      <div class="form-group">
        <label>
          <input type="checkbox" id="template-default" /> Set as default
        </label>
      </div>
      </section>

      <section class="template-modal-panel" data-template-modal-panel="2" role="tabpanel" aria-label="Template items" hidden>
        <div class="template-modal-panel-heading">
          <h3 tabindex="-1">Step B: Build Items</h3>
          <p>Add form, upload, and e-sign steps to your template.</p>
        </div>

      <div class="card center-items-card template-items-card" style="margin:0;">
        <div class="center-items-header">
          <h3 style="margin-top:0">Template Items</h3>
          <span class="center-items-count" id="template-items-count">0 item(s)</span>
        </div>
        <div id="template-items-list" class="center-items-list"></div>

        <div class="center-builder-fields">
          <div class="form-group">
            <label for="template-type">Type</label>
            <select id="template-type">
              <option value="form">Form</option>
              <option value="upload">Upload</option>
              <option value="esign">E-Sign</option>
            </select>
          </div>
          <div class="form-group">
            <label for="template-title">Title</label>
            <input type="text" id="template-title" placeholder="e.g. HR Details" />
          </div>
          <div class="form-group">
            <label for="template-description-item">Description</label>
            <textarea id="template-description-item" placeholder="Instructions for the employee"></textarea>
          </div>
          <div class="form-group">
            <label>
              <input type="checkbox" id="template-required" checked /> Required
            </label>
          </div>
          <div class="form-group" id="template-form-fields">
            <label>Form fields</label>
            <div class="form-builder-shell" data-form-builder="template">
              <div class="form-builder-toolbar">
                <button class="btn btn-secondary btn-sm" type="button" onclick="addFormField('template', 'text')">+ Short text</button>
                <button class="btn btn-secondary btn-sm" type="button" onclick="addFormField('template', 'textarea')">+ Paragraph</button>
                <button class="btn btn-secondary btn-sm" type="button" onclick="addFormField('template', 'email')">+ Email</button>
                <button class="btn btn-secondary btn-sm" type="button" onclick="addFormField('template', 'date')">+ Date</button>
                <button class="btn btn-secondary btn-sm" type="button" onclick="addFormField('template', 'select')">+ Dropdown</button>
              </div>
              <div id="template-form-field-list" class="form-builder-field-list"></div>
              <div class="form-builder-preview">
                <div class="form-builder-preview-title">Live preview</div>
                <div id="template-form-preview" class="form-builder-preview-body"></div>
              </div>
            </div>
            <textarea id="template-fields" style="display:none;" aria-hidden="true"></textarea>
            <div class="form-hint">Drag fields to reorder. The live preview matches what new members will fill.</div>
          </div>
