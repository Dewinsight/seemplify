  <script src="/vendor/pdfjs/pdf.min.js"></script>
  <script>
    const orgId = '<%= organization._id %>';
    const orgMembers = <%- JSON.stringify(members || []) %>;
    const templateItems = [];
    const customItems = [];
    const formFieldState = { template: [], custom: [] };
    const signatureFieldState = { template: [], custom: [] };
    const selectedSignatureFieldIndex = { template: -1, custom: -1 };
    const signerSelectionState = { template: [], custom: [] };
    const signatureDocumentState = { template: null, custom: null };
    const pdfState = {
      template: { pdf: null, page: 1, totalPages: 0, scale: 1, zoom: 1, viewport: null },
      custom: { pdf: null, page: 1, totalPages: 0, scale: 1, zoom: 1, viewport: null }
    };
    const placeModeState = { template: false, custom: false };
    const dragState = { active: false, prefix: null, index: -1, startX: 0, startY: 0, originX: 0, originY: 0, element: null };
    const resizeState = { active: false, prefix: null, index: -1, startX: 0, startY: 0, originWidth: 0, originHeight: 0, originX: 0, originTopLeftY: 0, element: null };
    const paletteDragState = { active: false, candidate: null, prefix: null, type: null, btn: null, pointerId: null, startX: 0, startY: 0, ghost: null };
    const suppressNextOverlayClick = { template: false, custom: false };
    const SIGNER_COLORS = ['#60a5fa', '#34d399', '#fbbf24', '#fb7185', '#a78bfa', '#22c55e', '#f97316'];
    const centerWizardState = { step: 1, total: 3 };
    const templateModalState = { step: 1, total: 3 };
    const assignmentFilterState = { query: '', status: 'all' };
    const fieldTypeOptions = ['text', 'textarea', 'email', 'tel', 'number', 'date', 'select'];
    const fieldTypeLabelMap = {
      text: 'Short text',
      textarea: 'Paragraph',
      email: 'Email',
      tel: 'Phone',
      number: 'Number',
      date: 'Date',
      select: 'Dropdown'
    };
    let fieldIdSeed = 0;

    function clampStep(step, max) {
      const n = Number(step);
      if (!Number.isFinite(n)) return 1;
      return Math.max(1, Math.min(max, Math.floor(n)));
    }

    function renderCenterReview() {
      const memberSelect = document.getElementById('assignmentMember');
      const templateSelect = document.getElementById('assignmentTemplate');
      const dueInput = document.getElementById('assignmentDue');

      const memberLabel = memberSelect?.selectedOptions?.[0]?.textContent || '';
      const templateLabel = templateSelect?.selectedOptions?.[0]?.textContent || '';
      const dueLabel = dueInput?.value ? new Date(`${dueInput.value}T00:00:00`).toLocaleDateString() : 'Not set';
      const esignCount = customItems.filter(item => item.type === 'esign').length;

      const memberEl = document.getElementById('review-member');
      const templateEl = document.getElementById('review-template');
      const dueEl = document.getElementById('review-due');
      const customCountEl = document.getElementById('review-custom-count');
      const esignCountEl = document.getElementById('review-esign-count');

      if (memberEl) memberEl.textContent = memberSelect?.value ? memberLabel : 'Not selected';
      if (templateEl) templateEl.textContent = templateSelect?.value ? templateLabel : 'No template';
      if (dueEl) dueEl.textContent = dueLabel;
      if (customCountEl) customCountEl.textContent = `${customItems.length} item(s)`;
      if (esignCountEl) esignCountEl.textContent = `${esignCount} item(s)`;
    }

    function setCenterStep(step, options = {}) {
      const nextStep = clampStep(step, centerWizardState.total);
      centerWizardState.step = nextStep;

      const stepButtons = Array.from(document.querySelectorAll('[data-center-step]'));
      const panels = Array.from(document.querySelectorAll('[data-center-step-panel]'));
      const indicator = document.getElementById('center-step-indicator');
      const prevBtn = document.getElementById('center-step-prev');
      const nextBtn = document.getElementById('center-step-next');

      stepButtons.forEach(button => {
        const isActive = Number(button.dataset.centerStep) === nextStep;
        button.classList.toggle('active', isActive);
        button.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach(panel => {
        const panelStep = Number(panel.dataset.centerStepPanel);
        const isActive = panelStep === nextStep;
        panel.classList.toggle('active', isActive);
        if (isActive) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });

      if (indicator) indicator.textContent = `Step ${nextStep} of ${centerWizardState.total}`;
      if (prevBtn) prevBtn.disabled = nextStep <= 1;
      if (nextBtn) {
        nextBtn.style.display = nextStep === centerWizardState.total ? 'none' : 'inline-flex';
      }

      if (nextStep === centerWizardState.total) {
        renderCenterReview();
      }

      if (options.focus !== false) {
        const activePanel = document.querySelector(`[data-center-step-panel="${nextStep}"] h3`);
        if (activePanel) activePanel.focus?.();
      }
    }

    function validateCenterStep(step) {
      if (step === 1) {
        const memberId = document.getElementById('assignmentMember')?.value;
        if (!memberId) {
          alert('Please select a member before continuing.');
          return false;
        }
      }
      return true;
    }

    function nextCenterStep() {
      const current = centerWizardState.step;
      if (!validateCenterStep(current)) return;
      setCenterStep(current + 1, { focus: true });
    }

    function prevCenterStep() {
      setCenterStep(centerWizardState.step - 1, { focus: true });
    }

    function applyTemplateToAssignment(templateId, options = {}) {
      const select = document.getElementById('assignmentTemplate');
      if (!select || !templateId) return;
      select.value = String(templateId);
      renderCenterReview();
      if (options.jumpToStep !== false) {
        setCenterStep(1, { focus: false });
      }
    }

    function filterTemplateLibrary(query) {
      const searchTerm = String(query || '').trim().toLowerCase();
      const items = Array.from(document.querySelectorAll('[data-template-item]'));
      const empty = document.querySelector('[data-template-empty]');
      if (!items.length) return;

      let visible = 0;
      items.forEach(item => {
        const haystack = (item.dataset.templateSearch || '').toLowerCase();
        const matches = !searchTerm || haystack.includes(searchTerm);
        item.hidden = !matches;
        if (matches) visible += 1;
      });

      if (empty) empty.hidden = visible !== 0;
    }

    function filterAssignments(options = {}) {
      if (Object.prototype.hasOwnProperty.call(options, 'query')) {
        assignmentFilterState.query = String(options.query || '').trim().toLowerCase();
      }
      if (Object.prototype.hasOwnProperty.call(options, 'status')) {
        assignmentFilterState.status = options.status || 'all';
      }

      const items = Array.from(document.querySelectorAll('[data-assignment-item]'));
      const empty = document.querySelector('[data-assignment-empty]');
      const chips = Array.from(document.querySelectorAll('[data-assignment-status-filter]'));

      chips.forEach(chip => {
        const isActive = chip.dataset.assignmentStatusFilter === assignmentFilterState.status;
        chip.classList.toggle('active', isActive);
        chip.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      let visible = 0;
      items.forEach(item => {
        const status = item.dataset.assignmentStatus || '';
        const search = (item.dataset.assignmentSearch || '').toLowerCase();
        const statusMatch = assignmentFilterState.status === 'all' || status === assignmentFilterState.status;
        const queryMatch = !assignmentFilterState.query || search.includes(assignmentFilterState.query);
        const matches = statusMatch && queryMatch;
        item.hidden = !matches;
        if (matches) visible += 1;
      });

      if (empty) empty.hidden = visible !== 0;
    }

    function filterPersonalAssignments(scope = 'current') {
      const chips = Array.from(document.querySelectorAll('[data-personal-status-filter]'));
      const cards = Array.from(document.querySelectorAll('[data-personal-assignment]'));
      const empty = document.querySelector('[data-personal-empty]');
      if (!cards.length || !chips.length) return;

      chips.forEach(chip => {
        const isActive = chip.dataset.personalStatusFilter === scope;
        chip.classList.toggle('active', isActive);
        chip.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      let visible = 0;
      cards.forEach(card => {
        const status = String(card.dataset.personalStatus || '').toLowerCase();
        const isCurrent = status === 'pending' || status === 'in_progress';
        const isHistory = status === 'completed' || status === 'cancelled';
        const show = scope === 'all'
          ? true
          : (scope === 'history' ? isHistory : isCurrent);

        card.hidden = !show;
        if (show) visible += 1;
      });

      if (empty) {
        empty.hidden = visible !== 0;
      }
    }

    function renderTemplateReview() {
      const name = document.getElementById('template-name')?.value.trim() || '';
      const description = document.getElementById('template-description')?.value.trim() || '';
      const isDefault = !!document.getElementById('template-default')?.checked;
      const esignCount = templateItems.filter(item => item.type === 'esign').length;

      const nameEl = document.getElementById('template-review-name');
      const descriptionEl = document.getElementById('template-review-description');
      const defaultEl = document.getElementById('template-review-default');
      const countEl = document.getElementById('template-review-count');
      const esignEl = document.getElementById('template-review-esign');

      if (nameEl) nameEl.textContent = name || 'Not set';
      if (descriptionEl) descriptionEl.textContent = description || 'No description';
      if (defaultEl) defaultEl.textContent = isDefault ? 'Yes' : 'No';
      if (countEl) countEl.textContent = `${templateItems.length} item(s)`;
      if (esignEl) esignEl.textContent = `${esignCount} item(s)`;
    }

    function setTemplateModalStep(step, options = {}) {
      const nextStep = clampStep(step, templateModalState.total);
      templateModalState.step = nextStep;

      const stepButtons = Array.from(document.querySelectorAll('[data-template-modal-step]'));
      const panels = Array.from(document.querySelectorAll('[data-template-modal-panel]'));
      const prevBtn = document.getElementById('template-modal-prev');
      const nextBtn = document.getElementById('template-modal-next');
      const createBtn = document.getElementById('template-modal-create');

      stepButtons.forEach(button => {
        const isActive = Number(button.dataset.templateModalStep) === nextStep;
        button.classList.toggle('active', isActive);
        button.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach(panel => {
        const panelStep = Number(panel.dataset.templateModalPanel);
        const isActive = panelStep === nextStep;
        panel.classList.toggle('active', isActive);
        if (isActive) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });

      if (prevBtn) prevBtn.disabled = nextStep <= 1;
      if (nextBtn) nextBtn.style.display = nextStep === templateModalState.total ? 'none' : 'inline-flex';
      if (createBtn) createBtn.style.display = nextStep === templateModalState.total ? 'inline-flex' : 'none';

      if (nextStep === templateModalState.total) {
        renderTemplateReview();
      }

      if (options.focus !== false) {
        const activeHeading = document.querySelector(`[data-template-modal-panel="${nextStep}"] h3`);
        if (activeHeading) activeHeading.focus?.();
      }
    }

    function validateTemplateModalStep(step) {
      if (step === 1) {
        const name = document.getElementById('template-name')?.value.trim();
        if (!name) {
          alert('Template name is required.');
          return false;
        }
      }
      if (step === 2 && templateItems.length === 0) {
        alert('Add at least one item before continuing.');
        return false;
      }
      return true;
    }

    function nextTemplateModalStep() {
      const current = templateModalState.step;
      if (!validateTemplateModalStep(current)) return;
      setTemplateModalStep(current + 1, { focus: true });
    }

    function prevTemplateModalStep() {
      setTemplateModalStep(templateModalState.step - 1, { focus: true });
    }

    function showTemplateModal() {
      document.getElementById('templateModal').classList.add('active');
      setTemplateModalStep(1, { focus: false });
      setTimeout(() => {
        document.getElementById('template-name')?.focus();
      }, 30);
    }

    function hideTemplateModal() {
      document.getElementById('templateModal').classList.remove('active');
    }

    function toggleItemInputs(prefix) {
      const type = document.getElementById(`${prefix}-type`).value;
      document.getElementById(`${prefix}-form-fields`).style.display = type === 'form' ? 'block' : 'none';
      document.getElementById(`${prefix}-upload-accept`).style.display = type === 'upload' ? 'block' : 'none';
      document.getElementById(`${prefix}-esign-fields`).style.display = type === 'esign' ? 'block' : 'none';
      document.getElementById(`${prefix}-esign-signers`).style.display = type === 'esign' ? 'block' : 'none';
      const viewer = document.getElementById(`${prefix}-pdf-viewer`);
      const empty = document.getElementById(`${prefix}-pdf-empty`);
      if (type === 'esign') {
        if (viewer) viewer.style.display = signatureDocumentState[prefix] ? 'block' : 'none';
        if (empty) empty.style.display = signatureDocumentState[prefix] ? 'none' : 'block';
      } else {
        if (viewer) viewer.style.display = 'none';
        if (empty) empty.style.display = 'none';
      }
    }

    ['template', 'custom'].forEach(prefix => {
      document.getElementById(`${prefix}-type`).addEventListener('change', () => toggleItemInputs(prefix));
    });

    function sanitizeFieldKey(label, fallbackIndex = 1, seenKeys = new Set()) {
      const base = String(label || '')
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '_')
        .replace(/^_+|_+$/g, '') || `field_${fallbackIndex}`;

      let candidate = base;
      let i = 2;
      while (seenKeys.has(candidate)) {
        candidate = `${base}_${i++}`;
      }
      seenKeys.add(candidate);
      return candidate;
    }

    function parseSelectOptions(raw) {
      if (Array.isArray(raw)) {
        return raw.map(item => String(item || '').trim()).filter(Boolean);
      }
      return String(raw || '')
        .split(',')
        .map(item => item.trim())
        .filter(Boolean);
    }

    function parseFields(raw) {
      const value = String(raw || '').trim();
      if (!value) return [];

      if (value.startsWith('[')) {
        try {
          const parsed = JSON.parse(value);
          if (Array.isArray(parsed)) {
            return parsed
              .map(field => ({
                label: String(field?.label || '').trim(),
                key: String(field?.key || '').trim(),
                type: fieldTypeOptions.includes(field?.type) ? field.type : 'text',
                required: field?.required === true,
                options: parseSelectOptions(field?.options)
              }))
              .filter(field => field.label);
          }
        } catch (error) {
          // Fall through to legacy parser.
        }
      }

      return value
        .split('\n')
        .map(line => line.trim())
        .filter(Boolean)
        .map(line => {
          const [labelPart, typePart, requiredPart, optionsPart] = line.split('|').map(p => p.trim());
          const type = fieldTypeOptions.includes(typePart) ? typePart : 'text';
          return {
            label: labelPart,
            key: sanitizeFieldKey(labelPart),
            type,
            required: requiredPart === 'required' || requiredPart === 'true',
            options: type === 'select' ? parseSelectOptions(optionsPart) : []
          };
        })
        .filter(field => field.label);
    }

    function createFormField(type = 'text', overrides = {}) {
      const nextType = fieldTypeOptions.includes(type) ? type : 'text';
      fieldIdSeed += 1;
      return {
        id: `f_${fieldIdSeed}`,
        label: overrides.label || fieldTypeLabelMap[nextType] || 'Question',
        type: nextType,
        required: overrides.required === true,
        options: nextType === 'select' ? parseSelectOptions(overrides.options || 'Option 1, Option 2') : []
      };
    }

    function ensureFormFieldState(prefix) {
      if (!Array.isArray(formFieldState[prefix])) {
        formFieldState[prefix] = [];
      }

      if (formFieldState[prefix].length > 0) return;

      const raw = document.getElementById(`${prefix}-fields`)?.value || '';
      const parsed = parseFields(raw);

      if (parsed.length > 0) {
        formFieldState[prefix] = parsed.map(field => createFormField(field.type, field));
      } else {
        formFieldState[prefix] = [createFormField('text', { label: 'Question 1', required: true })];
      }
    }

    function serializeFormFields(prefix) {
      const hidden = document.getElementById(`${prefix}-fields`);
      if (!hidden) return;

      const serialized = getFormFieldsForSubmission(prefix);
      hidden.value = JSON.stringify(serialized);
    }

    function getFormFieldsForSubmission(prefix) {
      const fields = Array.isArray(formFieldState[prefix]) ? formFieldState[prefix] : [];
      const seen = new Set();

      return fields
        .map((field, index) => {
          const label = String(field?.label || '').trim();
          if (!label) return null;
          const type = fieldTypeOptions.includes(field?.type) ? field.type : 'text';
          return {
            label,
            key: sanitizeFieldKey(field?.key || label, index + 1, seen),
            type,
            required: field?.required === true,
            options: type === 'select' ? parseSelectOptions(field?.options) : []
          };
        })
        .filter(Boolean);
    }

    function updateFormField(prefix, fieldId, key, value) {
      const fields = formFieldState[prefix] || [];
      const index = fields.findIndex(field => field.id === fieldId);
      if (index < 0) return;

      if (key === 'required') {
        fields[index].required = value === true || value === 'true';
      } else if (key === 'options') {
        fields[index].options = parseSelectOptions(value);
      } else if (key === 'type') {
        fields[index].type = fieldTypeOptions.includes(value) ? value : 'text';
        if (fields[index].type !== 'select') fields[index].options = [];
      } else {
        fields[index][key] = value;
      }

      renderFormFieldBuilder(prefix);
    }

    function removeFormField(prefix, fieldId) {
      const fields = formFieldState[prefix] || [];
      const nextFields = fields.filter(field => field.id !== fieldId);
      formFieldState[prefix] = nextFields.length > 0
        ? nextFields
        : [createFormField('text', { label: 'Question 1' })];
      renderFormFieldBuilder(prefix);
    }

    function addFormField(prefix, type = 'text') {
      ensureFormFieldState(prefix);
      const fields = formFieldState[prefix];
      const nextIndex = fields.length + 1;
      const label = type === 'select' ? `Dropdown ${nextIndex}` : `Question ${nextIndex}`;
      fields.push(createFormField(type, { label }));
      renderFormFieldBuilder(prefix);
    }

    function moveFormField(prefix, fieldId, direction) {
      const fields = formFieldState[prefix] || [];
      const index = fields.findIndex(field => field.id === fieldId);
      if (index < 0) return;

      const nextIndex = direction === 'up' ? index - 1 : index + 1;
      if (nextIndex < 0 || nextIndex >= fields.length) return;

      const temp = fields[index];
      fields[index] = fields[nextIndex];
      fields[nextIndex] = temp;
      renderFormFieldBuilder(prefix);
    }

    function renderFormFieldBuilder(prefix) {
      ensureFormFieldState(prefix);
      const fields = formFieldState[prefix] || [];
      const listEl = document.getElementById(`${prefix}-form-field-list`);
      const previewEl = document.getElementById(`${prefix}-form-preview`);
      if (!listEl || !previewEl) return;

      listEl.innerHTML = fields.map((field, index) => {
        const type = fieldTypeOptions.includes(field.type) ? field.type : 'text';
        const optionList = parseSelectOptions(field.options);
        const typeOptions = fieldTypeOptions
          .map(option => `<option value="${option}" ${type === option ? 'selected' : ''}>${fieldTypeLabelMap[option] || option}</option>`)
          .join('');
        const optionsInput = type === 'select'
          ? `
            <div class="form-builder-field-options">
              <label>Options (comma separated)</label>
              <input type="text" value="${escapeHtml(optionList.join(', '))}" data-field-input="options" />
            </div>
          `
          : '';

        return `
          <article class="form-builder-field" draggable="true" data-form-field-id="${field.id}">
            <div class="form-builder-field-head">
              <span class="form-builder-drag" title="Drag to reorder">::</span>
              <span class="form-builder-field-index">${index + 1}</span>
              <input type="text" value="${escapeHtml(field.label || '')}" placeholder="Field label" data-field-input="label" />
              <select data-field-input="type">${typeOptions}</select>
              <label class="form-builder-required-toggle">
                <input type="checkbox" ${field.required ? 'checked' : ''} data-field-input="required" />
                Required
              </label>
              <div class="form-builder-field-actions">
                <button class="btn btn-secondary btn-sm" type="button" data-field-move="up">Up</button>
                <button class="btn btn-secondary btn-sm" type="button" data-field-move="down">Down</button>
                <button class="btn btn-danger btn-sm" type="button" data-field-remove>Remove</button>
              </div>
            </div>
            ${optionsInput}
          </article>
        `;
      }).join('');

      previewEl.innerHTML = fields.map((field, index) => {
        const type = fieldTypeOptions.includes(field.type) ? field.type : 'text';
        const requiredMark = field.required ? ' *' : '';
        const label = escapeHtml(field.label || `Question ${index + 1}`);
        if (type === 'textarea') {
          return `
            <div class="form-builder-preview-field">
              <label>${label}${requiredMark}</label>
              <textarea placeholder="Response..."></textarea>
            </div>
          `;
        }
        if (type === 'select') {
          const options = parseSelectOptions(field.options);
          const optionMarkup = options.length
            ? options.map(option => `<option>${escapeHtml(option)}</option>`).join('')
            : '<option>Option 1</option>';
          return `
            <div class="form-builder-preview-field">
              <label>${label}${requiredMark}</label>
              <select>
                <option value="">Select an option...</option>
                ${optionMarkup}
              </select>
            </div>
          `;
        }
        const inputType = type === 'textarea' ? 'text' : type;
        return `
          <div class="form-builder-preview-field">
            <label>${label}${requiredMark}</label>
            <input type="${inputType}" placeholder="Response..." />
          </div>
        `;
      }).join('');

      serializeFormFields(prefix);

      const rows = Array.from(listEl.querySelectorAll('[data-form-field-id]'));
      rows.forEach(row => {
        const rowFieldId = row.dataset.formFieldId;

        row.querySelectorAll('[data-field-input]').forEach(input => {
          const key = input.dataset.fieldInput;
          input.addEventListener('input', (event) => {
            const value = key === 'required' ? event.target.checked : event.target.value;
            updateFormField(prefix, rowFieldId, key, value);
          });
          input.addEventListener('change', (event) => {
            const value = key === 'required' ? event.target.checked : event.target.value;
            updateFormField(prefix, rowFieldId, key, value);
          });
        });

        const removeBtn = row.querySelector('[data-field-remove]');
        removeBtn?.addEventListener('click', () => removeFormField(prefix, rowFieldId));

        row.querySelectorAll('[data-field-move]').forEach(button => {
          button.addEventListener('click', () => moveFormField(prefix, rowFieldId, button.dataset.fieldMove));
        });

        row.addEventListener('dragstart', (event) => {
          event.dataTransfer.effectAllowed = 'move';
          event.dataTransfer.setData('text/plain', rowFieldId);
          row.classList.add('dragging');
        });
        row.addEventListener('dragend', () => row.classList.remove('dragging'));
        row.addEventListener('dragover', (event) => {
          event.preventDefault();
          row.classList.add('drag-over');
        });
        row.addEventListener('dragleave', () => row.classList.remove('drag-over'));
        row.addEventListener('drop', (event) => {
          event.preventDefault();
          row.classList.remove('drag-over');
          const draggedId = event.dataTransfer.getData('text/plain');
          if (!draggedId || draggedId === rowFieldId) return;

          const fieldList = formFieldState[prefix] || [];
          const fromIndex = fieldList.findIndex(field => field.id === draggedId);
          const toIndex = fieldList.findIndex(field => field.id === rowFieldId);
          if (fromIndex < 0 || toIndex < 0 || fromIndex === toIndex) return;

          const [movedField] = fieldList.splice(fromIndex, 1);
          fieldList.splice(toIndex, 0, movedField);
          renderFormFieldBuilder(prefix);
        });
      });
    }

    function getSignerOptions() {
      const options = [{
        key: 'assignee',
        label: 'Onboarding member',
        type: 'assignee'
      }];

      orgMembers.forEach(member => {
        options.push({
          key: member.id?.toString() || '',
          label: `${member.name} (${member.email})`,
          type: 'member'
        });
      });

      return options.filter(option => option.key);
    }

    function renderSignerOptions(prefix) {
      const container = document.getElementById(`${prefix}-signers-options`);
      if (!container) return;

      const options = getSignerOptions();
      const selectedKeys = signerSelectionState[prefix].length
        ? signerSelectionState[prefix].map(item => item.key)
        : ['assignee'];

      container.innerHTML = options
        .map(option => `
          <label style="display:flex; gap: 8px; align-items:center; font-size: 13px;">
            <input type="checkbox" value="${option.key}" ${selectedKeys.includes(option.key) ? 'checked' : ''} />
            ${option.label}
          </label>
        `)
        .join('');

      container.querySelectorAll('input[type="checkbox"]').forEach(input => {
        input.addEventListener('change', () => {
          const keys = Array.from(container.querySelectorAll('input[type="checkbox"]:checked'))
            .map(el => el.value);
          updateSignerSelection(prefix, keys);
        });
      });

      updateSignerSelection(prefix, selectedKeys, { silent: true });
    }

    function updateSignerSelection(prefix, selectedKeys, options = {}) {
      const available = getSignerOptions();
      let keys = selectedKeys && selectedKeys.length ? selectedKeys : ['assignee'];
      if (!keys.length) {
        keys = ['assignee'];
      }

      signerSelectionState[prefix] = available
        .filter(option => keys.includes(option.key))
        .map(option => ({
          key: option.key,
          label: option.label,
          type: option.type
        }));

      populateSignerSelect(prefix);

      const validKeys = new Set(signerSelectionState[prefix].map(option => option.key));
      if (signatureFieldState[prefix].length) {
        signatureFieldState[prefix].forEach(field => {
          if (!field.signerKey || !validKeys.has(field.signerKey)) {
            field.signerKey = signerSelectionState[prefix][0]?.key || 'assignee';
          }
        });
        renderSignatureFields(prefix);
        renderOverlayFields(prefix);
      }

      if (!options.silent) {
        const container = document.getElementById(`${prefix}-signers-options`);
        if (container) {
          container.querySelectorAll('input[type="checkbox"]').forEach(input => {
            input.checked = validKeys.has(input.value);
          });
        }
      }
    }

    function populateSignerSelect(prefix) {
      const select = document.getElementById(`${prefix}-sign-signer`);
      if (!select) return;

      const signers = signerSelectionState[prefix].length
        ? signerSelectionState[prefix]
        : [{ key: 'assignee', label: 'Onboarding member', type: 'assignee' }];

      const currentValue = select.value;
      select.innerHTML = signers
        .map(signer => `<option value="${signer.key}">${signer.label}</option>`)
        .join('');

      const nextValue = currentValue && signers.some(signer => signer.key === currentValue)
        ? currentValue
        : (signers[0]?.key || 'assignee');
      select.value = nextValue;

      renderRecipientChips(prefix);
    }

    function renderRecipientChips(prefix) {
      const container = document.getElementById(`${prefix}-recipient-chips`);
      const select = document.getElementById(`${prefix}-sign-signer`);
      if (!container || !select) return;

      const signers = signerSelectionState[prefix].length
        ? signerSelectionState[prefix]
        : [{ key: 'assignee', label: 'Onboarding member', type: 'assignee' }];

      const activeKey = select.value || (signers[0]?.key || 'assignee');

      container.innerHTML = signers.map(signer => {
        const key = signer.key || 'assignee';
        const color = getSignerColor(prefix, key);
        const label = escapeHtml(getSignerLabel(prefix, key));
        const activeClass = key === activeKey ? 'active' : '';
        return `
          <button type="button" class="esign-recipient-chip ${activeClass}" data-signer-key="${escapeHtml(key)}" style="--esign-color:${color};">
            <span class="esign-recipient-dot"></span>
            <span>${label}</span>
          </button>
        `;
      }).join('');

      container.querySelectorAll('[data-signer-key]').forEach(button => {
        button.addEventListener('click', () => {
          const key = button.dataset.signerKey;
          if (!key) return;
          select.value = key;
          select.dispatchEvent(new Event('change', { bubbles: true }));
        });
      });
    }

    function getSignerLabel(prefix, key) {
      const signer = signerSelectionState[prefix].find(item => item.key === key);
      const label = signer ? signer.label : 'Onboarding member';
      return String(label || '').replace(/\s*\(.+\)\s*$/, '');
    }

    function getSignerColor(prefix, signerKey) {
      const key = signerKey || 'assignee';
      const signers = signerSelectionState[prefix]?.length
        ? signerSelectionState[prefix].map(signer => signer.key)
        : ['assignee'];
      const index = Math.max(0, signers.indexOf(key));
      return SIGNER_COLORS[index % SIGNER_COLORS.length];
    }

    function hexToRgba(hex, alpha) {
      const raw = (hex || '').replace('#', '').trim();
      if (raw.length !== 6) return `rgba(99,102,241,${alpha})`;
      const r = parseInt(raw.slice(0, 2), 16);
      const g = parseInt(raw.slice(2, 4), 16);
      const b = parseInt(raw.slice(4, 6), 16);
      return `rgba(${r},${g},${b},${alpha})`;
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function getWrapInnerWidth(el) {
      if (!el) return 600;
      const styles = window.getComputedStyle(el);
      const padLeft = parseFloat(styles.paddingLeft) || 0;
      const padRight = parseFloat(styles.paddingRight) || 0;
      const width = (el.clientWidth || 0) - padLeft - padRight;
      return width > 0 ? width : (el.clientWidth || 600);
    }

    function setFieldType(prefix, type) {
      const typeSelect = document.getElementById(`${prefix}-sign-type`);
      if (typeSelect) {
        typeSelect.value = type;
      }
      syncFieldTypeUI(prefix);
      updateSelectedSignatureFieldFromInputs(prefix);
    }

    function syncFieldTypeUI(prefix) {
      const typeSelect = document.getElementById(`${prefix}-sign-type`);
      const labelInput = document.getElementById(`${prefix}-sign-label`);
      const textWrap = document.getElementById(`${prefix}-sign-text-wrap`);

      const type = typeSelect?.value || 'signature';
      if (textWrap) {
        textWrap.style.display = type === 'text' ? 'block' : 'none';
      }

      // Palette active state
      document.querySelectorAll(`[data-esign-chip="${prefix}"]`).forEach(btn => {
        btn.classList.toggle('active', btn.dataset.type === type);
      });

      // Auto-suggest a label if empty
      if (labelInput && !labelInput.value.trim()) {
        if (type === 'date') labelInput.placeholder = 'e.g. Date Signed';
        else if (type === 'text') labelInput.placeholder = 'e.g. Full Name';
        else labelInput.placeholder = 'e.g. Employee Signature';
      }
    }

    function renderSignatureFields(prefix) {
      const container = document.getElementById(`${prefix}-signature-fields-list`);
      const fields = signatureFieldState[prefix] || [];
      const countEl = document.getElementById(`${prefix}-signature-fields-count`);
      if (countEl) countEl.textContent = fields.length ? `${fields.length} field${fields.length === 1 ? '' : 's'}` : '';

      if (!fields.length) {
        container.innerHTML = '<div style="color: var(--muted); font-size: 12px;">No fields yet. Drag a field from the palette onto the PDF (or enable Click to place).</div>';
        return;
      }

      container.innerHTML = fields
        .map((field, index) => `
          <div class="esign-field-row ${index === selectedSignatureFieldIndex[prefix] ? 'active' : ''}" style="--esign-color:${getSignerColor(prefix, field.signerKey || 'assignee')};" onclick="selectSignatureField('${prefix}', ${index})">
            <div class="esign-field-dot" style="--esign-color:${getSignerColor(prefix, field.signerKey || 'assignee')};"></div>
            <div style="min-width:0;">
              <div class="esign-field-row-title">${index + 1}. ${escapeHtml(field.label || field.type)} <span style="color: var(--muted); font-weight:700;">(${escapeHtml(field.type)})</span></div>
              <div class="esign-field-row-meta">${escapeHtml(getSignerLabel(prefix, field.signerKey || 'assignee'))} | Page ${Number(field.page) || 1}</div>
            </div>
            <div class="esign-field-row-actions">
              <button class="btn btn-danger btn-sm" type="button" onclick="event.stopPropagation(); removeSignatureField('${prefix}', ${index});">Delete</button>
            </div>
          </div>
        `)
        .join('');
    }

    function syncSelectedSignatureFieldInputs(prefix) {
      const index = selectedSignatureFieldIndex[prefix];
      if (index < 0) return;
      const field = signatureFieldState[prefix]?.[index];
      if (!field) return;

      const labelInput = document.getElementById(`${prefix}-sign-label`);
      const typeInput = document.getElementById(`${prefix}-sign-type`);
      const signerSelect = document.getElementById(`${prefix}-sign-signer`);
      const pageInput = document.getElementById(`${prefix}-sign-page`);
      const xInput = document.getElementById(`${prefix}-sign-x`);
      const yInput = document.getElementById(`${prefix}-sign-y`);
      const widthInput = document.getElementById(`${prefix}-sign-width`);
      const heightInput = document.getElementById(`${prefix}-sign-height`);
      const originInput = document.getElementById(`${prefix}-sign-origin`);
      const textInput = document.getElementById(`${prefix}-sign-text`);

      if (labelInput) labelInput.value = field.label || '';
      if (typeInput) typeInput.value = field.type || 'signature';
      if (signerSelect) signerSelect.value = field.signerKey || 'assignee';
      if (pageInput) pageInput.value = String(field.page || 1);
      if (xInput) xInput.value = String(field.x ?? 0);
      if (yInput) yInput.value = String(field.y ?? 0);
      if (widthInput) widthInput.value = String(field.width || 180);
      if (heightInput) heightInput.value = String(field.height || 60);
      if (originInput) originInput.value = field.origin === 'bottom-left' ? 'bottom-left' : 'top-left';
      if (textInput) textInput.value = field.text || '';

      syncFieldTypeUI(prefix);
      renderRecipientChips(prefix);
    }

    function updateSelectedSignatureFieldFromInputs(prefix) {
      const index = selectedSignatureFieldIndex[prefix];
      if (index < 0) return;
      const field = signatureFieldState[prefix]?.[index];
      if (!field) return;

      const labelInput = document.getElementById(`${prefix}-sign-label`);
      const typeInput = document.getElementById(`${prefix}-sign-type`);
      const signerSelect = document.getElementById(`${prefix}-sign-signer`);
      const pageInput = document.getElementById(`${prefix}-sign-page`);
      const xInput = document.getElementById(`${prefix}-sign-x`);
      const yInput = document.getElementById(`${prefix}-sign-y`);
      const widthInput = document.getElementById(`${prefix}-sign-width`);
      const heightInput = document.getElementById(`${prefix}-sign-height`);
      const originInput = document.getElementById(`${prefix}-sign-origin`);
      const textInput = document.getElementById(`${prefix}-sign-text`);

      const nextType = typeInput?.value || field.type || 'signature';
      field.type = nextType;
      field.signerKey = signerSelect?.value || field.signerKey || 'assignee';
      field.label = (labelInput?.value || '').trim() || (nextType === 'date' ? 'Date' : nextType === 'text' ? 'Text' : 'Signature');
      field.page = Math.max(1, Number(pageInput?.value || field.page || 1));
      field.x = Number(xInput?.value ?? field.x);
      field.y = Number(yInput?.value ?? field.y);
      field.width = Math.max(1, Number(widthInput?.value || field.width || 180));
      field.height = Math.max(1, Number(heightInput?.value || field.height || 60));
      field.origin = originInput?.value === 'bottom-left' ? 'bottom-left' : 'top-left';
      field.text = nextType === 'text' ? ((textInput?.value || '').trim() || undefined) : undefined;

      const state = pdfState[prefix];
      if (state?.pdf && field.page && field.page !== state.page) {
        state.page = field.page;
        renderPdfPage(prefix);
      } else {
        renderOverlayFields(prefix);
      }
      renderSignatureFields(prefix);
    }

    async function selectSignatureField(prefix, index, options = {}) {
      selectedSignatureFieldIndex[prefix] = index;
      syncSelectedSignatureFieldInputs(prefix);

      const field = signatureFieldState[prefix]?.[index];
      const state = pdfState[prefix];
      if (field && state?.pdf && field.page && field.page !== state.page) {
        state.page = field.page;
        await renderPdfPage(prefix);
      } else {
        renderOverlayFields(prefix);
      }

      renderSignatureFields(prefix);
      if (options.scroll !== false) {
        scrollSignatureFieldIntoView(prefix, index);
      }
    }

    function scrollSignatureFieldIntoView(prefix, index) {
      const wrap = document.getElementById(`${prefix}-pdf-canvas-wrap`);
      const overlay = document.getElementById(`${prefix}-pdf-overlay`);
      if (!wrap || !overlay) return;
      const el = overlay.querySelector(`.esign-field[data-index="${index}"]`);
      if (!el) return;

      const wrapRect = wrap.getBoundingClientRect();
      const elRect = el.getBoundingClientRect();
      const left = (elRect.left - wrapRect.left) + wrap.scrollLeft;
      const top = (elRect.top - wrapRect.top) + wrap.scrollTop;

      wrap.scrollTo({
        left: Math.max(0, left - (wrap.clientWidth / 2) + (el.clientWidth / 2)),
        top: Math.max(0, top - (wrap.clientHeight / 2) + (el.clientHeight / 2)),
        behavior: 'smooth'
      });
    }

    function clearSignatureFieldSelection(prefix) {
      if (selectedSignatureFieldIndex[prefix] < 0) return;
      selectedSignatureFieldIndex[prefix] = -1;
      renderSignatureFields(prefix);
      renderOverlayFields(prefix);
    }

    function removeSelectedSignatureField(prefix) {
      const index = selectedSignatureFieldIndex[prefix];
      if (index < 0) {
        alert('Select a field to delete');
        return;
      }
      removeSignatureField(prefix, index);
    }

    function bindSignatureFieldEditor(prefix) {
      const typeEl = document.getElementById(`${prefix}-sign-type`);
      const labelEl = document.getElementById(`${prefix}-sign-label`);
      const signerEl = document.getElementById(`${prefix}-sign-signer`);
      const pageEl = document.getElementById(`${prefix}-sign-page`);
      const xEl = document.getElementById(`${prefix}-sign-x`);
      const yEl = document.getElementById(`${prefix}-sign-y`);
      const widthEl = document.getElementById(`${prefix}-sign-width`);
      const heightEl = document.getElementById(`${prefix}-sign-height`);
      const originEl = document.getElementById(`${prefix}-sign-origin`);
      const textEl = document.getElementById(`${prefix}-sign-text`);

      typeEl?.addEventListener('change', () => {
        syncFieldTypeUI(prefix);
        updateSelectedSignatureFieldFromInputs(prefix);
      });
      signerEl?.addEventListener('change', () => {
        renderRecipientChips(prefix);
        updateSelectedSignatureFieldFromInputs(prefix);
      });
      originEl?.addEventListener('change', () => updateSelectedSignatureFieldFromInputs(prefix));

      const onInput = () => updateSelectedSignatureFieldFromInputs(prefix);
      labelEl?.addEventListener('input', onInput);
      pageEl?.addEventListener('input', onInput);
      xEl?.addEventListener('input', onInput);
      yEl?.addEventListener('input', onInput);
      widthEl?.addEventListener('input', onInput);
      heightEl?.addEventListener('input', onInput);
      textEl?.addEventListener('input', onInput);
    }

    function setDocumentStatus(prefix, message, isError = false) {
      const targets = [
        document.getElementById(`${prefix}-document-status`),
        document.getElementById(`${prefix}-document-status-toolbar`)
      ].filter(Boolean);

      targets.forEach(el => {
        el.textContent = message;
        el.style.color = isError ? '#f87171' : 'var(--muted)';
      });
    }

    function openEsignFilePicker(prefix) {
      const input = document.getElementById(`${prefix}-document`);
      if (!input) {
        alert('File picker is not available');
        return;
      }
      input.click();
    }

    async function deleteUploadedDocument(publicId) {
      if (!publicId) return;

      try {
        const response = await fetch(`/api/organizations/${orgId}/onboarding/documents/delete`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ publicId })
        });

        if (!response.ok) {
          const data = await response.json().catch(() => ({}));
          throw new Error(data.error || 'Failed to delete document');
        }
      } catch (error) {
        console.warn('Failed to delete onboarding document from storage:', error);
      }
    }

    async function removeEsignDocument(prefix) {
      const existing = signatureDocumentState[prefix];
      if (!existing) {
        setDocumentStatus(prefix, 'No document uploaded.');
        toggleItemInputs(prefix);
        return;
      }

      const ok = confirm('Remove this PDF? This will clear all placed fields.');
      if (!ok) return;

      setDocumentStatus(prefix, 'Removing...');

      const publicId = existing.publicId;
      signatureDocumentState[prefix] = null;
      pdfState[prefix] = { pdf: null, page: 1, totalPages: 0, scale: 1, zoom: 1, viewport: null };
      placeModeState[prefix] = false;
      resetSignatureFields(prefix);
      toggleItemInputs(prefix);
      setDocumentStatus(prefix, 'No document uploaded.');

      if (publicId) {
        await deleteUploadedDocument(publicId);
      }
    }

    async function uploadAndPreviewEsignDocument(prefix, file, options = {}) {
      if (!file) {
        alert('Please select a PDF file first');
        return;
      }

      if (!String(file.type || '').includes('pdf') && !String(file.name || '').toLowerCase().endsWith('.pdf')) {
        alert('Only PDF documents are allowed for e-signing');
        return;
      }

      const existing = signatureDocumentState[prefix];
      const isReplace = !!existing;

      if (isReplace && !options.skipConfirm) {
        const ok = confirm('Replace the current PDF? This will clear all placed fields.');
        if (!ok) return;
      }

      setDocumentStatus(prefix, 'Uploading...');

      try {
        const documentData = await uploadDocument(file);

        signatureDocumentState[prefix] = documentData;
        setDocumentStatus(prefix, `Uploaded: ${documentData.fileName || file.name}`);

        resetSignatureFields(prefix);
        await loadPdfPreview(prefix, documentData.url);

        if (isReplace && existing?.publicId && existing.publicId !== documentData.publicId) {
          await deleteUploadedDocument(existing.publicId);
        }
      } catch (error) {
        console.error('PDF upload error:', error);
        setDocumentStatus(prefix, error.message || 'Upload failed', true);
        alert(error.message || 'Failed to upload document');
      }
    }

    function bindEsignDocumentUpload(prefix) {
      const input = document.getElementById(`${prefix}-document`);
      const dropzone = document.querySelector(`[data-pdf-dropzone="${prefix}"]`);
      const wrap = document.getElementById(`${prefix}-pdf-canvas-wrap`);

      if (input && input.dataset.bound !== '1') {
        input.dataset.bound = '1';
        input.addEventListener('change', async () => {
          const file = input.files && input.files.length ? input.files[0] : null;
          input.value = '';
          await uploadAndPreviewEsignDocument(prefix, file);
        });
      }

      if (dropzone && dropzone.dataset.bound !== '1') {
        dropzone.dataset.bound = '1';

        dropzone.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openEsignFilePicker(prefix);
          }
        });

        dropzone.addEventListener('click', (event) => {
          if (event.target.closest('button')) return;
          openEsignFilePicker(prefix);
        });

        dropzone.addEventListener('dragover', (event) => {
          event.preventDefault();
          dropzone.classList.add('dragover');
        });

        dropzone.addEventListener('dragleave', () => {
          dropzone.classList.remove('dragover');
        });

        dropzone.addEventListener('drop', async (event) => {
          event.preventDefault();
          dropzone.classList.remove('dragover');
          const file = event.dataTransfer?.files?.[0] || null;
          await uploadAndPreviewEsignDocument(prefix, file, { skipConfirm: true });
        });
      }

      if (wrap && wrap.dataset.pdfDropBound !== '1') {
        wrap.dataset.pdfDropBound = '1';

        wrap.addEventListener('dragover', (event) => {
          if (!event.dataTransfer) return;
          event.preventDefault();
          wrap.classList.add('drop-active');
        });

        wrap.addEventListener('dragleave', () => {
          wrap.classList.remove('drop-active');
        });

        wrap.addEventListener('drop', async (event) => {
          if (!event.dataTransfer) return;
          event.preventDefault();
          wrap.classList.remove('drop-active');
          const file = event.dataTransfer?.files?.[0] || null;
          if (!file) return;
          await uploadAndPreviewEsignDocument(prefix, file);
        });
      }
    }

    async function loadPdfPreview(prefix, url) {
      if (!window.pdfjsLib) {
        alert('PDF preview library is not available');
        return;
      }

      pdfjsLib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';

      const loadingTask = pdfjsLib.getDocument(url);
      const pdf = await loadingTask.promise;
      pdfState[prefix].pdf = pdf;
      pdfState[prefix].page = 1;
      pdfState[prefix].totalPages = pdf.numPages;
      pdfState[prefix].zoom = 1;

      const viewer = document.getElementById(`${prefix}-pdf-viewer`);
      const empty = document.getElementById(`${prefix}-pdf-empty`);
      if (viewer) {
        viewer.style.display = 'block';
      }
      if (empty) {
        empty.style.display = 'none';
      }

      // Default to drag-to-place after upload; click-to-place can be toggled on if desired.
      placeModeState[prefix] = false;
      updatePlaceModeUI(prefix);

      await renderPdfPage(prefix);
    }

    async function renderPdfPage(prefix) {
      const state = pdfState[prefix];
      if (!state.pdf) return;

      const canvas = document.getElementById(`${prefix}-pdf-canvas`);
      const overlay = document.getElementById(`${prefix}-pdf-overlay`);
      const wrap = document.getElementById(`${prefix}-pdf-canvas-wrap`);
      if (!canvas || !overlay || !wrap) return;

      const page = await state.pdf.getPage(state.page);
      const unscaledViewport = page.getViewport({ scale: 1 });
      const availableWidth = getWrapInnerWidth(wrap) || 600;
      const scale = (availableWidth / unscaledViewport.width) * (state.zoom || 1);
      const viewport = page.getViewport({ scale });

      const ratio = window.devicePixelRatio || 1;
      canvas.width = Math.floor(viewport.width * ratio);
      canvas.height = Math.floor(viewport.height * ratio);
      canvas.style.width = `${Math.floor(viewport.width)}px`;
      canvas.style.height = `${Math.floor(viewport.height)}px`;
      const ctx = canvas.getContext('2d');
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, viewport.width, viewport.height);
      await page.render({ canvasContext: ctx, viewport }).promise;

      overlay.style.width = `${viewport.width}px`;
      overlay.style.height = `${viewport.height}px`;
      overlay.innerHTML = '';

      state.scale = scale;
      state.viewport = viewport;

      const label = document.getElementById(`${prefix}-pdf-page-label`);
      if (label) {
        label.textContent = `Page ${state.page} / ${state.pdf.numPages}`;
      }

      const zoomLabel = document.getElementById(`${prefix}-pdf-zoom-label`);
      if (zoomLabel) {
        zoomLabel.textContent = `${Math.round((state.zoom || 1) * 100)}%`;
      }

      if (!overlay.dataset.bound) {
        overlay.addEventListener('click', (event) => {
          if (event.target.closest('.esign-field')) return;

          if (placeModeState[prefix]) {
            addFieldAtPoint(prefix, event);
            return;
          }

          clearSignatureFieldSelection(prefix);
        });
        overlay.dataset.bound = 'true';
      }

      updatePlaceModeUI(prefix);
      renderOverlayFields(prefix);
    }

    function changePdfPage(prefix, delta) {
      const state = pdfState[prefix];
      if (!state.pdf) return;
      const nextPage = Math.min(state.pdf.numPages, Math.max(1, state.page + delta));
      if (nextPage === state.page) return;
      state.page = nextPage;
      renderPdfPage(prefix);
    }

    function updatePlaceModeUI(prefix) {
      const button = document.getElementById(`${prefix}-place-toggle`);
      if (button) {
        button.textContent = placeModeState[prefix] ? 'Click to place: ON' : 'Click to place: OFF';
      }
      const overlay = document.getElementById(`${prefix}-pdf-overlay`);
      if (overlay) {
        overlay.classList.toggle('place-mode', !!placeModeState[prefix]);
      }
    }

    function togglePlaceMode(prefix) {
      placeModeState[prefix] = !placeModeState[prefix];
      updatePlaceModeUI(prefix);
    }

    function changePdfZoom(prefix, delta) {
      const state = pdfState[prefix];
      if (!state.pdf) return;
      const nextZoom = Math.max(0.5, Math.min(2.25, (state.zoom || 1) + delta));
      state.zoom = nextZoom;
      renderPdfPage(prefix);
    }

    function bindPaletteDrag(prefix) {
      document.querySelectorAll(`[data-esign-chip="${prefix}"]`).forEach(button => {
        if (button.dataset.dragBound === '1') return;
        button.dataset.dragBound = '1';

        button.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          paletteDragState.candidate = {
            prefix,
            type: button.dataset.type || 'signature',
            btn: button,
            pointerId: event.pointerId,
            startX: event.clientX,
            startY: event.clientY
          };
        });
      });
    }

    function beginPaletteDrag(candidate, event) {
      const prefix = candidate?.prefix;
      const type = candidate?.type || 'signature';
      const btn = candidate?.btn;
      const state = prefix ? pdfState[prefix] : null;
      const overlay = prefix ? document.getElementById(`${prefix}-pdf-overlay`) : null;

      paletteDragState.candidate = null;

      if (!prefix || !btn || !state?.viewport || !overlay) {
        return;
      }

      // Prevent the chip click from firing after a drag.
      const swallow = (e) => {
        e.preventDefault();
        e.stopPropagation();
      };
      btn.addEventListener('click', swallow, { once: true, capture: true });

      paletteDragState.active = true;
      paletteDragState.prefix = prefix;
      paletteDragState.type = type;
      paletteDragState.btn = btn;
      paletteDragState.pointerId = event.pointerId;

      const signerKey = document.getElementById(`${prefix}-sign-signer`)?.value || 'assignee';
      const signerColor = getSignerColor(prefix, signerKey);
      const signerLabel = getSignerLabel(prefix, signerKey);
      const { width, height } = getDefaultFieldSize(type);
      const scale = state.scale || 1;

      const ghost = document.createElement('div');
      ghost.className = 'esign-field esign-field-ghost esign-field-builder';
      ghost.style.setProperty('--esign-color', signerColor);
      ghost.style.borderColor = signerColor;
      ghost.style.background = hexToRgba(signerColor, 0.18);
      ghost.style.width = `${Math.max(60, Math.round(width * scale))}px`;
      ghost.style.height = `${Math.max(24, Math.round(height * scale))}px`;
      ghost.innerHTML = `
        <div class="esign-field-title">${escapeHtml(getDefaultFieldLabel(type))}</div>
        <div class="esign-field-signer">${escapeHtml(signerLabel)}</div>
      `;
      document.body.appendChild(ghost);
      paletteDragState.ghost = ghost;

      updatePaletteDrag(event);
    }

    function updatePaletteDrag(event) {
      if (!paletteDragState.active) return;

      const ghost = paletteDragState.ghost;
      if (ghost) {
        const x = Math.round(event.clientX + 14);
        const y = Math.round(event.clientY + 14);
        ghost.style.transform = `translate(${x}px, ${y}px)`;
      }

      const prefix = paletteDragState.prefix;
      const overlay = prefix ? document.getElementById(`${prefix}-pdf-overlay`) : null;
      if (!overlay) return;

      const r = overlay.getBoundingClientRect();
      const inside = event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom;
      overlay.classList.toggle('drop-active', inside);
    }

    function endPaletteDrag(event) {
      if (!paletteDragState.active) {
        paletteDragState.candidate = null;
        return;
      }

      const prefix = paletteDragState.prefix;
      const overlay = prefix ? document.getElementById(`${prefix}-pdf-overlay`) : null;
      const state = prefix ? pdfState[prefix] : null;

      if (overlay) {
        overlay.classList.remove('drop-active');
      }

      if (overlay && state?.viewport) {
        const r = overlay.getBoundingClientRect();
        const inside = event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom;
        if (inside) {
          suppressNextOverlayClick[prefix] = true;
          addFieldAtClientPoint(prefix, event.clientX, event.clientY, { type: paletteDragState.type });
        }
      }

      if (paletteDragState.ghost) {
        paletteDragState.ghost.remove();
      }

      paletteDragState.active = false;
      paletteDragState.prefix = null;
      paletteDragState.type = null;
      paletteDragState.btn = null;
      paletteDragState.pointerId = null;
      paletteDragState.ghost = null;
      paletteDragState.candidate = null;
    }

    function getDefaultFieldSize(type) {
      if (type === 'date') {
        return { width: 120, height: 30 };
      }
      if (type === 'text') {
        return { width: 160, height: 30 };
      }
      return { width: 180, height: 60 };
    }

    function addFieldAtPoint(prefix, event) {
      if (suppressNextOverlayClick[prefix]) {
        suppressNextOverlayClick[prefix] = false;
        return;
      }

      addFieldAtClientPoint(prefix, event.clientX, event.clientY);
    }

    function getDefaultFieldLabel(type) {
      if (type === 'date') return 'Date';
      if (type === 'text') return 'Text';
      return 'Signature';
    }

    function addFieldAtClientPoint(prefix, clientX, clientY, options = {}) {
      const state = pdfState[prefix];
      const overlay = document.getElementById(`${prefix}-pdf-overlay`);
      if (!overlay || !state.viewport) return;

      const rect = overlay.getBoundingClientRect();
      const xPx = clientX - rect.left;
      const yPx = clientY - rect.top;
      const scale = state.scale || 1;

      const typeSelect = document.getElementById(`${prefix}-sign-type`);
      const type = options.type || typeSelect?.value || 'signature';
      const labelInput = document.getElementById(`${prefix}-sign-label`);
      const textInput = document.getElementById(`${prefix}-sign-text`);
      const signerSelect = document.getElementById(`${prefix}-sign-signer`);
      const originInput = document.getElementById(`${prefix}-sign-origin`);
      const { width, height } = getDefaultFieldSize(type);

      const pdfWidth = state.viewport.viewBox[2] - state.viewport.viewBox[0];
      const pdfHeight = state.viewport.viewBox[3] - state.viewport.viewBox[1];

      let x = xPx / scale;
      let y = yPx / scale;
      x = Math.max(0, Math.min(x, pdfWidth - width));
      y = Math.max(0, Math.min(y, pdfHeight - height));

      // If a field is selected, inputs are editing that field. For new fields, prefer sane defaults.
      const isEditingExisting = selectedSignatureFieldIndex[prefix] >= 0;
      const origin = !isEditingExisting && originInput?.value === 'bottom-left' ? 'bottom-left' : 'top-left';
      const storedY = origin === 'bottom-left'
        ? Math.max(0, Math.min(pdfHeight - y - height, pdfHeight - height))
        : y;

      const rawLabel = !isEditingExisting ? (labelInput?.value || '').trim() : '';
      const rawText = !isEditingExisting ? (textInput?.value || '').trim() : '';

      const field = {
        label: rawLabel || getDefaultFieldLabel(type),
        type,
        signerKey: signerSelect?.value || 'assignee',
        page: state.page,
        x,
        y: storedY,
        width,
        height,
        origin,
        text: type === 'text' ? (rawText || undefined) : undefined
      };

      signatureFieldState[prefix].push(field);
      selectedSignatureFieldIndex[prefix] = signatureFieldState[prefix].length - 1;
      renderSignatureFields(prefix);
      renderOverlayFields(prefix);
      scrollSignatureFieldIntoView(prefix, selectedSignatureFieldIndex[prefix]);
    }

    function renderOverlayFields(prefix) {
      const state = pdfState[prefix];
      const overlay = document.getElementById(`${prefix}-pdf-overlay`);
      if (!overlay || !state.viewport) return;

      const scale = state.scale || 1;
      overlay.innerHTML = '';

      const pdfHeight = state.viewport.viewBox[3] - state.viewport.viewBox[1];

      signatureFieldState[prefix].forEach((field, index) => {
        if (field.page !== state.page) return;

        const signerKey = field.signerKey || 'assignee';
        const signerColor = getSignerColor(prefix, signerKey);

        const fieldEl = document.createElement('div');
        fieldEl.className = 'esign-field esign-field-builder';
        fieldEl.dataset.index = String(index);
        fieldEl.style.setProperty('--esign-color', signerColor);
        fieldEl.style.borderColor = signerColor;
        fieldEl.style.background = hexToRgba(signerColor, 0.14);
        fieldEl.style.left = `${field.x * scale}px`;
        const topLeftY = field.origin === 'bottom-left'
          ? (pdfHeight - field.y - field.height)
          : field.y;
        fieldEl.style.top = `${topLeftY * scale}px`;
        fieldEl.style.width = `${field.width * scale}px`;
        fieldEl.style.height = `${field.height * scale}px`;

        if (index === selectedSignatureFieldIndex[prefix]) {
          fieldEl.classList.add('selected');
        }

        const numberBadge = document.createElement('div');
        numberBadge.className = 'esign-field-number';
        numberBadge.textContent = String(index + 1);
        fieldEl.appendChild(numberBadge);

        const fieldTitle = document.createElement('div');
        fieldTitle.className = 'esign-field-title';
        fieldTitle.textContent = field.label || field.type;
        fieldEl.appendChild(fieldTitle);

        const fieldSigner = document.createElement('div');
        fieldSigner.className = 'esign-field-signer';
        fieldSigner.textContent = getSignerLabel(prefix, signerKey);
        fieldEl.appendChild(fieldSigner);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'esign-field-remove';
        removeBtn.textContent = 'x';
        removeBtn.addEventListener('click', (event) => {
          event.stopPropagation();
          removeSignatureField(prefix, index);
          renderOverlayFields(prefix);
        });
        fieldEl.appendChild(removeBtn);

        const resizeHandle = document.createElement('div');
        resizeHandle.className = 'esign-field-resize';
        resizeHandle.addEventListener('pointerdown', (event) => {
          event.stopPropagation();
          startResizeField(prefix, index, event);
        });
        fieldEl.appendChild(resizeHandle);

        fieldEl.addEventListener('pointerdown', (event) => {
          if (event.target.closest('.esign-field-remove')) return;
          if (event.target.closest('.esign-field-resize')) return;
          event.preventDefault();

          selectedSignatureFieldIndex[prefix] = index;
          syncSelectedSignatureFieldInputs(prefix);
          renderSignatureFields(prefix);
          overlay.querySelectorAll('.esign-field.selected').forEach(el => el.classList.remove('selected'));
          fieldEl.classList.add('selected');

          const stateForDrag = pdfState[prefix];
          const pdfHeightForDrag = stateForDrag?.viewport
            ? stateForDrag.viewport.viewBox[3] - stateForDrag.viewport.viewBox[1]
            : 0;
          const startTopLeftY = field.origin === 'bottom-left'
            ? (pdfHeightForDrag - field.y - field.height)
            : field.y;
          dragState.active = true;
          dragState.prefix = prefix;
          dragState.index = index;
          dragState.startX = event.clientX;
          dragState.startY = event.clientY;
          dragState.originX = field.x;
          dragState.originY = startTopLeftY;
          dragState.element = fieldEl;
          fieldEl.classList.add('active');
          fieldEl.setPointerCapture(event.pointerId);
        });

        overlay.appendChild(fieldEl);
      });
    }

    function startResizeField(prefix, index, event) {
      const state = pdfState[prefix];
      const field = signatureFieldState[prefix]?.[index];
      if (!field || !state?.viewport) return;

      const pdfHeight = state.viewport.viewBox[3] - state.viewport.viewBox[1];
      const topLeftY = field.origin === 'bottom-left'
        ? (pdfHeight - field.y - field.height)
        : field.y;

      resizeState.active = true;
      resizeState.prefix = prefix;
      resizeState.index = index;
      resizeState.startX = event.clientX;
      resizeState.startY = event.clientY;
      resizeState.originWidth = field.width || 0;
      resizeState.originHeight = field.height || 0;
      resizeState.originX = field.x || 0;
      resizeState.originTopLeftY = topLeftY || 0;
      resizeState.element = event.target.closest('.esign-field');

      try {
        resizeState.element?.setPointerCapture(event.pointerId);
      } catch (e) {}
    }

    function addSignatureField(prefix) {
      const labelInput = document.getElementById(`${prefix}-sign-label`);
      const typeInput = document.getElementById(`${prefix}-sign-type`);
      const signerSelect = document.getElementById(`${prefix}-sign-signer`);
      const pageInput = document.getElementById(`${prefix}-sign-page`);
      const xInput = document.getElementById(`${prefix}-sign-x`);
      const yInput = document.getElementById(`${prefix}-sign-y`);
      const widthInput = document.getElementById(`${prefix}-sign-width`);
      const heightInput = document.getElementById(`${prefix}-sign-height`);
      const originInput = document.getElementById(`${prefix}-sign-origin`);
      const textInput = document.getElementById(`${prefix}-sign-text`);

      const page = Number(pageInput.value || 1);
      const x = Number(xInput.value);
      const y = Number(yInput.value);
      const width = Number(widthInput.value || 180);
      const height = Number(heightInput.value || 60);

      if (!Number.isFinite(x) || !Number.isFinite(y)) {
        alert('Please enter valid X and Y coordinates');
        return;
      }

      const nextType = typeInput.value;
      const rawLabel = labelInput.value.trim();
      const field = {
        label: rawLabel || getDefaultFieldLabel(nextType),
        type: nextType,
        signerKey: signerSelect?.value || 'assignee',
        page: Number.isFinite(page) && page > 0 ? page : 1,
        x,
        y,
        width: Number.isFinite(width) && width > 0 ? width : 180,
        height: Number.isFinite(height) && height > 0 ? height : 60,
        origin: originInput.value,
        text: nextType === 'text' ? (textInput.value.trim() || undefined) : undefined
      };

      signatureFieldState[prefix].push(field);
      selectSignatureField(prefix, signatureFieldState[prefix].length - 1);
    }

    function removeSignatureField(prefix, index) {
      signatureFieldState[prefix].splice(index, 1);

      const remaining = signatureFieldState[prefix].length;
      if (remaining === 0) {
        selectedSignatureFieldIndex[prefix] = -1;
      } else if (selectedSignatureFieldIndex[prefix] === index) {
        selectedSignatureFieldIndex[prefix] = Math.min(index, remaining - 1);
      } else if (selectedSignatureFieldIndex[prefix] > index) {
        selectedSignatureFieldIndex[prefix] = selectedSignatureFieldIndex[prefix] - 1;
      }

      renderSignatureFields(prefix);
      renderOverlayFields(prefix);
      syncSelectedSignatureFieldInputs(prefix);
    }

    function resetSignatureFields(prefix) {
      signatureFieldState[prefix] = [];
      selectedSignatureFieldIndex[prefix] = -1;
      renderSignatureFields(prefix);
      renderOverlayFields(prefix);
    }

    if (!window.__esignDragBound) {
      document.addEventListener('pointermove', (event) => {
        const target = event.target;
        if (target && target.closest && target.closest('#esignModal')) {
          return;
        }

        if (paletteDragState.candidate && !paletteDragState.active && paletteDragState.candidate.pointerId === event.pointerId) {
          const dx = event.clientX - paletteDragState.candidate.startX;
          const dy = event.clientY - paletteDragState.candidate.startY;
          if (Math.abs(dx) + Math.abs(dy) > 10) {
            beginPaletteDrag(paletteDragState.candidate, event);
          }
        }

        if (paletteDragState.active) {
          updatePaletteDrag(event);
          return;
        }

        if (resizeState.active) {
          const state = pdfState[resizeState.prefix];
          const field = signatureFieldState[resizeState.prefix]?.[resizeState.index];
          if (!state?.viewport || !field) return;

          const scale = state.scale || 1;
          const dx = (event.clientX - resizeState.startX) / scale;
          const dy = (event.clientY - resizeState.startY) / scale;

          const pdfWidth = state.viewport.viewBox[2] - state.viewport.viewBox[0];
          const pdfHeight = state.viewport.viewBox[3] - state.viewport.viewBox[1];

          const minW = field.type === 'signature' ? 120 : 90;
          const minH = field.type === 'signature' ? 40 : 24;
          const maxW = Math.max(minW, pdfWidth - (field.x || 0));
          const maxH = Math.max(minH, pdfHeight - (resizeState.originTopLeftY || 0));

          const nextW = Math.min(maxW, Math.max(minW, (resizeState.originWidth || 0) + dx));
          const nextH = Math.min(maxH, Math.max(minH, (resizeState.originHeight || 0) + dy));

          field.width = nextW;
          field.height = nextH;

          if (field.origin === 'bottom-left') {
            field.y = Math.max(0, Math.min(pdfHeight - (resizeState.originTopLeftY || 0) - field.height, pdfHeight - field.height));
          } else {
            field.y = resizeState.originTopLeftY || 0;
          }

          if (resizeState.element) {
            resizeState.element.style.width = `${field.width * scale}px`;
            resizeState.element.style.height = `${field.height * scale}px`;
            resizeState.element.style.top = `${(resizeState.originTopLeftY || 0) * scale}px`;
          }

          return;
        }

        if (!dragState.active) return;
        const state = pdfState[dragState.prefix];
        const scale = state.scale || 1;
        const dx = (event.clientX - dragState.startX) / scale;
        const dy = (event.clientY - dragState.startY) / scale;
        const field = signatureFieldState[dragState.prefix][dragState.index];
        if (!field) return;
        const pdfHeight = state?.viewport
          ? state.viewport.viewBox[3] - state.viewport.viewBox[1]
          : 0;
        const nextX = Math.max(0, dragState.originX + dx);
        const nextTopLeftY = Math.max(0, dragState.originY + dy);
        field.x = nextX;
        field.y = field.origin === 'bottom-left'
          ? Math.max(0, Math.min(pdfHeight - nextTopLeftY - field.height, pdfHeight - field.height))
          : nextTopLeftY;
        if (dragState.element) {
          const drawY = field.origin === 'bottom-left'
            ? (pdfHeight - field.y - field.height)
            : field.y;
          dragState.element.style.left = `${field.x * scale}px`;
          dragState.element.style.top = `${drawY * scale}px`;
        }
      });

      document.addEventListener('pointerup', (event) => {
        if (paletteDragState.active) {
          endPaletteDrag(event);
          return;
        }

        if (paletteDragState.candidate && paletteDragState.candidate.pointerId === event.pointerId) {
          paletteDragState.candidate = null;
        }

        if (resizeState.active) {
          const prefix = resizeState.prefix;
          resizeState.active = false;
          resizeState.element = null;
          if (prefix) {
            renderSignatureFields(prefix);
            renderOverlayFields(prefix);
            syncSelectedSignatureFieldInputs(prefix);
          }
          return;
        }

        if (!dragState.active) return;
        if (dragState.element) {
          dragState.element.classList.remove('active');
        }
        const prefix = dragState.prefix;
        dragState.active = false;
        dragState.element = null;
        if (prefix) {
          renderSignatureFields(prefix);
          syncSelectedSignatureFieldInputs(prefix);
        }
      });

      window.__esignDragBound = true;
    }

