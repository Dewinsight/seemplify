      <div class="form-actions template-modal-actions">
        <button class="btn btn-secondary" type="button" onclick="hideTemplateModal()">Cancel</button>
        <button class="btn btn-secondary" type="button" id="template-modal-prev" onclick="prevTemplateModalStep()">Back</button>
        <button class="btn btn-secondary" type="button" id="template-modal-next" onclick="nextTemplateModalStep()">Continue</button>
        <button class="btn btn-primary" type="button" id="template-modal-create" style="display:none;" onclick="createTemplate()">Create Template</button>
      </div>
