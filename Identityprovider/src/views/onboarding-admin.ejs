    async function addItem(prefix, list, containerId) {
      const type = document.getElementById(`${prefix}-type`).value;
      const title = document.getElementById(`${prefix}-title`).value.trim();
      const descriptionElement = document.getElementById(`${prefix}-description${prefix === 'template' ? '-item' : ''}`);
      const description = descriptionElement ? descriptionElement.value.trim() : '';
      const required = document.getElementById(`${prefix}-required`).checked;

      if (!title) {
        alert('Title is required');
        return;
      }

      const item = { type, title, description, required, config: {} };

      if (type === 'form') {
        const parsedFields = getFormFieldsForSubmission(prefix);
        item.config.fields = parsedFields;
        if (!item.config.fields.length) {
          alert('Add at least one form field before saving this item');
          return;
        }
      }

      if (type === 'upload') {
        item.config.accept = document.getElementById(`${prefix}-accept`).value;
      }

      if (type === 'esign') {
        const documentData = signatureDocumentState[prefix];
        if (!documentData) {
          alert('Upload a contract PDF first');
          return;
        }
        if (!signatureFieldState[prefix].length) {
          alert('Add at least one signature field');
          return;
        }

        const selectedSigners = signerSelectionState[prefix].length
          ? signerSelectionState[prefix]
          : [{ key: 'assignee', label: 'Onboarding member', type: 'assignee' }];
        const usedSignerKeys = new Set(signatureFieldState[prefix].map(field => field.signerKey || 'assignee'));
        const missingSignerKeys = selectedSigners
          .map(signer => signer.key)
          .filter(key => !usedSignerKeys.has(key));

        if (missingSignerKeys.length) {
          const missingLabels = missingSignerKeys
            .map(key => getSignerLabel(prefix, key))
            .join(', ');
          alert(`Assign at least one field to each signer. Missing: ${missingLabels}`);
          return;
        }

        item.config.document = documentData;
        item.config.signatureFields = signatureFieldState[prefix].map(field => ({ ...field }));
        item.config.signers = signerSelectionState[prefix].map(signer => ({
          key: signer.key,
          type: signer.type,
          memberId: signer.key !== 'assignee' ? signer.key : undefined,
          label: signer.label
        }));
      }

      list.push(item);
      renderItems(list, containerId);

      if (type === 'esign') {
        document.getElementById(`${prefix}-document`).value = '';
        signatureDocumentState[prefix] = null;
        pdfState[prefix] = { pdf: null, page: 1, totalPages: 0, scale: 1, zoom: 1, viewport: null };
        placeModeState[prefix] = false;
        setDocumentStatus(prefix, 'No document uploaded.');
        const viewer = document.getElementById(`${prefix}-pdf-viewer`);
        if (viewer) viewer.style.display = 'none';
        const empty = document.getElementById(`${prefix}-pdf-empty`);
        if (empty) empty.style.display = 'block';
        resetSignatureFields(prefix);
      }
    }

