<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>LMS Roles - <%= organization.name %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=3"></script>
  <style>
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .stat-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
    }

    .stat-value {
      font-size: 28px;
      font-weight: 700;
      color: var(--text);
    }

    .stat-label {
      font-size: 13px;
      color: var(--muted);
      margin-top: 4px;
    }

    .member-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px;
      border-bottom: 1px solid var(--border);
    }

    .member-row:last-child {
      border-bottom: none;
    }

    .member-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .member-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--brand);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 14px;
    }

    .member-name {
      font-weight: 500;
      color: var(--text);
    }

    .member-email {
      font-size: 13px;
      color: var(--muted);
    }

    .member-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .role-select {
      padding: 8px 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--card);
      color: var(--text);
      font-size: 14px;
      min-width: 140px;
      cursor: pointer;
    }

    .role-select option {
      background: var(--card);
      color: var(--text);
    }

    .role-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
    }

    .role-badge.course_creator {
      background: rgba(139, 92, 246, 0.15);
      color: #8b5cf6;
    }

    .role-badge.student {
      background: rgba(6, 182, 212, 0.15);
      color: #06b6d4;
    }

    .role-badge.moderator {
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
    }

    .role-badge.batch_evaluator {
      background: rgba(16, 185, 129, 0.15);
      color: #10b981;
    }

    .role-badge.course_evaluator {
      background: rgba(236, 72, 153, 0.15);
      color: #ec4899;
    }

    .role-badge.administrator {
      background: rgba(220, 38, 38, 0.15);
      color: #dc2626;
    }

    .role-badge.none {
      background: rgba(113, 113, 122, 0.15);
      color: #71717a;
    }

    .requests-section {
      margin-top: 32px;
    }

    .request-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-bottom: 12px;
      background: var(--card);
    }

    .request-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .request-details {
      flex: 1;
    }

    .request-reason {
      font-size: 13px;
      color: var(--muted);
      margin-top: 4px;
      font-style: italic;
    }

    .request-actions {
      display: flex;
      gap: 8px;
    }

    .btn-approve {
      background: #10b981;
      color: white;
      border: none;
    }

    .btn-approve:hover {
      background: #059669;
    }

    .btn-reject {
      background: #ef4444;
      color: white;
      border: none;
    }

    .btn-reject:hover {
      background: #dc2626;
    }

    .empty-state {
      text-align: center;
      padding: 40px;
      color: var(--muted);
    }

    .tabs {
      display: flex;
      gap: 4px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .tab {
      padding: 12px 20px;
      border: none;
      background: none;
      color: var(--muted);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      transition: all 0.2s ease;
    }

    .tab:hover {
      color: var(--text);
    }

    .tab.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .pending-badge {
      background: #f59e0b;
      color: white;
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 11px;
      margin-left: 8px;
    }
  </style>
</head>

<body>
  <%- include('partials/nav', { activePage: 'organizations' }) %>

  <div class="container">
    <div class="header">
      <div>
        <a href="/organizations" class="btn btn-secondary" style="margin-bottom: 12px;">← Back to Organizations</a>
        <h1>🎓 LMS Roles - <%= organization.name %></h1>
        <p style="color: var(--muted); margin-top: 8px;">Manage who can access the Learning Management System and their roles</p>
      </div>
    </div>

    <div id="alertSuccess" class="alert alert-success" style="display: none;"></div>
    <div id="alertError" class="alert alert-error" style="display: none;"></div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value" id="totalMembers"><%= members.length %></div>
        <div class="stat-label">Total Members</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="studentCount"><%= lmsRoles.filter(r => r.role === 'student').length %></div>
        <div class="stat-label">Students</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="courseCreatorCount"><%= lmsRoles.filter(r => r.role === 'course_creator').length %></div>
        <div class="stat-label">Course Creators</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="moderatorCount"><%= lmsRoles.filter(r => r.role === 'moderator').length %></div>
        <div class="stat-label">Moderators</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="pendingCount"><%= accessRequests.length %></div>
        <div class="stat-label">Pending Requests</div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
      <button class="tab active" onclick="showTab('members')">
        All Members
      </button>
      <button class="tab" onclick="showTab('requests')">
        Access Requests
        <% if (accessRequests.length > 0) { %>
          <span class="pending-badge"><%= accessRequests.length %></span>
        <% } %>
      </button>
    </div>

    <!-- Members Tab -->
    <div class="tab-content active" id="members-tab">
      <div class="card">
        <% if (members.length === 0) { %>
          <div class="empty-state">
            <p>No members in this organization yet.</p>
          </div>
        <% } else { %>
          <% 
            const roleLabels = {
              'student': '🎓 Student',
              'course_creator': '👨‍🏫 Course Creator',
              'moderator': '🛡️ Moderator',
              'batch_evaluator': '📋 Batch Evaluator',
              'course_evaluator': '🏆 Course Evaluator',
              'administrator': '👑 Administrator'
            };
          %>
          <% members.forEach(member => { 
            const lmsRole = lmsRoles.find(r => r.account?.toString() === member.account._id.toString() || r.userId?.toString() === member.account._id.toString());
          %>
            <div class="member-row">
              <div class="member-info">
                <div class="member-avatar">
                  <%= (member.account.profile?.name || member.account.email)[0].toUpperCase() %>
                </div>
                <div>
                  <div class="member-name"><%= member.account.profile?.name || member.account.email %></div>
                  <div class="member-email"><%= member.account.email %></div>
                </div>
              </div>
              <div class="member-actions">
                <span class="role-badge <%= lmsRole ? lmsRole.role : 'none' %>">
                  <%= lmsRole ? roleLabels[lmsRole.role] || lmsRole.role : 'No LMS Role' %>
                </span>
                <select class="role-select" onchange="updateRole('<%= member.account._id %>', this.value)" data-user-id="<%= member.account._id %>">
                  <option value="">No LMS Access</option>
                  <option value="student" <%= lmsRole?.role === 'student' ? 'selected' : '' %>>🎓 Student</option>
                  <option value="course_creator" <%= lmsRole?.role === 'course_creator' ? 'selected' : '' %>>👨‍🏫 Course Creator</option>
                  <option value="moderator" <%= lmsRole?.role === 'moderator' ? 'selected' : '' %>>🛡️ Moderator</option>
                  <option value="batch_evaluator" <%= lmsRole?.role === 'batch_evaluator' ? 'selected' : '' %>>📋 Batch Evaluator</option>
                  <option value="course_evaluator" <%= lmsRole?.role === 'course_evaluator' ? 'selected' : '' %>>🏆 Course Evaluator</option>
                  <option value="administrator" <%= lmsRole?.role === 'administrator' ? 'selected' : '' %>>👑 Administrator</option>
                </select>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Access Requests Tab -->
    <div class="tab-content" id="requests-tab">
      <% if (accessRequests.length === 0) { %>
        <div class="card empty-state">
          <p>No pending access requests.</p>
        </div>
      <% } else { %>
        <% accessRequests.forEach(request => { %>
          <div class="request-card" id="request-<%= request._id %>">
            <div class="request-info">
              <div class="member-avatar">
                <%= (request.requestedBy?.profile?.name || request.requestedBy?.email || '?')[0].toUpperCase() %>
              </div>
              <div class="request-details">
                <div class="member-name"><%= request.requestedBy?.profile?.name || request.requestedBy?.email || 'Unknown User' %></div>
                <div class="member-email">
                  Requested: <span class="role-badge <%= request.requestedRole %>">
                    <%= roleLabels[request.requestedRole] || request.requestedRole %>
                  </span>
                  • <%= new Date(request.requestedAt || request.createdAt).toLocaleDateString() %>
                </div>
                <% if (request.requestReason || request.reason) { %>
                  <div class="request-reason">"<%= request.requestReason || request.reason %>"</div>
                <% } %>
              </div>
            </div>
            <div class="request-actions">
              <button class="btn btn-approve" onclick="approveRequest('<%= request._id %>')">
                ✓ Approve
              </button>
              <button class="btn btn-reject" onclick="rejectRequest('<%= request._id %>')">
                ✕ Reject
              </button>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <script>
    const organizationId = '<%= organization._id %>';
    
    const roleLabels = {
      'student': '🎓 Student',
      'course_creator': '👨‍🏫 Course Creator',
      'moderator': '🛡️ Moderator',
      'batch_evaluator': '📋 Batch Evaluator',
      'course_evaluator': '🏆 Course Evaluator',
      'administrator': '👑 Administrator'
    };

    function showTab(tabName) {
      // Update tab buttons
      document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
      event.target.classList.add('active');

      // Update tab content
      document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
      document.getElementById(`${tabName}-tab`).classList.add('active');
    }

    function showAlert(type, message) {
      const alertEl = document.getElementById(type === 'success' ? 'alertSuccess' : 'alertError');
      alertEl.textContent = message;
      alertEl.style.display = 'block';
      setTimeout(() => alertEl.style.display = 'none', 5000);
    }

    async function updateRole(userId, role) {
      try {
        const response = await fetch(`/api/lms/roles/${organizationId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, role: role || null })
        });

        const data = await response.json();

        if (response.ok) {
          showAlert('success', role ? `LMS role updated to ${roleLabels[role] || role}` : 'LMS role removed');
          // Update the badge
          const row = document.querySelector(`[data-user-id="${userId}"]`).closest('.member-row');
          const badge = row.querySelector('.role-badge');
          badge.className = `role-badge ${role || 'none'}`;
          badge.textContent = roleLabels[role] || 'No LMS Role';

          // Update stats
          updateStats();
        } else {
          throw new Error(data.error || 'Failed to update role');
        }
      } catch (error) {
        showAlert('error', error.message);
        // Revert the select
        location.reload();
      }
    }

    async function approveRequest(requestId) {
      try {
        const response = await fetch(`/api/lms/access-requests/${organizationId}/${requestId}/approve`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();

        if (response.ok) {
          showAlert('success', 'Access request approved');
          document.getElementById(`request-${requestId}`).remove();
          updateStats();
          // Reload to show updated member list
          setTimeout(() => location.reload(), 1000);
        } else {
          throw new Error(data.error || 'Failed to approve request');
        }
      } catch (error) {
        showAlert('error', error.message);
      }
    }

    async function rejectRequest(requestId) {
      if (!confirm('Are you sure you want to reject this access request?')) return;

      try {
        const response = await fetch(`/api/lms/access-requests/${organizationId}/${requestId}/deny`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();

        if (response.ok) {
          showAlert('success', 'Access request rejected');
          document.getElementById(`request-${requestId}`).remove();
          updateStats();
        } else {
          throw new Error(data.error || 'Failed to reject request');
        }
      } catch (error) {
        showAlert('error', error.message);
      }
    }

    function updateStats() {
      // Re-count from the DOM
      const students = document.querySelectorAll('.role-badge.student').length;
      const courseCreators = document.querySelectorAll('.role-badge.course_creator').length;
      const moderators = document.querySelectorAll('.role-badge.moderator').length;
      const pending = document.querySelectorAll('.request-card').length;

      document.getElementById('studentCount').textContent = students;
      document.getElementById('courseCreatorCount').textContent = courseCreators;
      document.getElementById('moderatorCount').textContent = moderators;
      document.getElementById('pendingCount').textContent = pending;

      // Update tab badge
      const badge = document.querySelector('.pending-badge');
      if (badge) {
        if (pending > 0) {
          badge.textContent = pending;
        } else {
          badge.remove();
        }
      }
    }
  </script>
</body>

</html>
