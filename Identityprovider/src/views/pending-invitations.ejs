<!DOCTYPE html>
<html>

<head>
  <title>My Pending Invitations - AIIN Identity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    :root {
      --brand: #60a5fa;
      --brand-2: #a855f7;
      --surface: #0b1224;
      --surface-2: #0f172a;
      --surface-3: #1e293b;
      --line: #1f2a44;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --success: #22c55e;
      --error: #ef4444;
      --warning: #f59e0b;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, #0b1224 0%, #0f172a 55%, #0b1224 100%);
      min-height: 100vh;
      color: var(--text);
      padding: 24px;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .header h1 {
      font-size: 28px;
      color: #f8fafc;
    }

    .header-subtitle {
      color: var(--muted);
      font-size: 14px;
      margin-top: 4px;
    }

    .btn {
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--brand), var(--brand-2));
      color: white;
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(96, 165, 250, 0.4);
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    .btn-secondary {
      background: var(--surface-3);
      color: var(--text);
      border: 1px solid var(--line);
    }

    .btn-danger {
      background: rgba(239, 68, 68, 0.2);
      color: #fca5a5;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .card {
      background: linear-gradient(160deg, rgba(16, 24, 40, 0.88), rgba(11, 18, 36, 0.92));
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 16px;
    }

    .invite-card {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .invite-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 16px;
    }

    .invite-org-name {
      font-size: 20px;
      font-weight: 600;
      color: #f8fafc;
      margin-bottom: 4px;
    }

    .invite-org-desc {
      font-size: 14px;
      color: var(--muted);
      margin-top: 4px;
    }

    .invite-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 12px;
      font-size: 13px;
      color: var(--muted);
    }

    .invite-actions {
      display: flex;
      gap: 12px;
      margin-top: 16px;
    }

    .role-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .role-admin {
      background: rgba(96, 165, 250, 0.2);
      color: #60a5fa;
    }

    .role-hr_manager {
      background: rgba(34, 197, 94, 0.2);
      color: #22c55e;
    }

    .role-recruiter {
      background: rgba(245, 158, 11, 0.2);
      color: #f59e0b;
    }

    .role-interviewer {
      background: rgba(148, 163, 184, 0.2);
      color: #94a3b8;
    }

    .status-pending {
      color: var(--warning);
    }

    .back-link {
      color: var(--muted);
      text-decoration: none;
      font-size: 14px;
      margin-bottom: 16px;
      display: inline-block;
    }

    .back-link:hover {
      color: var(--text);
    }

    .alert {
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 16px;
      font-size: 14px;
    }

    .alert-error {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }

    .alert-success {
      background: rgba(34, 197, 94, 0.15);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #86efac;
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
    }

    .empty-state h3 {
      color: #f8fafc;
      margin-bottom: 8px;
    }

    .empty-state p {
      color: var(--muted);
      margin-bottom: 24px;
    }

    /* Top Navigation */
    .top-nav {
      background: rgba(15, 23, 42, 0.95);
      border-bottom: 1px solid var(--line);
      padding: 12px 24px;
      margin: -24px -24px 24px -24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      backdrop-filter: blur(10px);
    }

    .top-nav-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }

    .top-nav-brand svg {
      width: 32px;
      height: 32px;
    }

    .top-nav-brand span {
      font-size: 18px;
      font-weight: 700;
      background: linear-gradient(135deg, var(--brand), var(--brand-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .top-nav-links {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .top-nav-link {
      padding: 8px 16px;
      border-radius: 8px;
      color: var(--muted);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.2s;
    }

    .top-nav-link:hover {
      color: var(--text);
      background: var(--surface-3);
    }

    .top-nav-link.active {
      color: var(--text);
      background: var(--surface-3);
    }

    .top-nav-user {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .top-nav-user-info {
      text-align: right;
    }

    .top-nav-user-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
    }

    .top-nav-user-email {
      font-size: 12px;
      color: var(--muted);
    }

    .top-nav-logout {
      padding: 8px 16px;
      border-radius: 8px;
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
    }

    .top-nav-logout:hover {
      background: rgba(239, 68, 68, 0.25);
    }

    @media (max-width: 768px) {
      .top-nav {
        flex-wrap: wrap;
        gap: 12px;
      }

      .top-nav-user-info {
        display: none;
      }
    }
  </style>
</head>

<body>
  <!-- Top Navigation -->
  <nav class="top-nav">
    <a href="https://seemplifyai.com" class="top-nav-brand">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="url(#grad1)" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round" />
        <path d="M2 17L12 22L22 17" stroke="url(#grad1)" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round" />
        <path d="M2 12L12 17L22 12" stroke="url(#grad1)" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round" />
        <defs>
          <linearGradient id="grad1" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
            <stop stop-color="#60a5fa" />
            <stop offset="1" stop-color="#a855f7" />
          </linearGradient>
        </defs>
      </svg>
      <span>AIIN Identity</span>
    </a>
    <div class="top-nav-links">
      <a href="/" class="top-nav-link">Home</a>
      <a href="/organizations" class="top-nav-link">Organizations</a>
      <a href="/invitations/pending" class="top-nav-link active">My Invitations</a>
      <a href="/profile" class="top-nav-link">Profile</a>
      <a href="/logout" class="top-nav-link">Logout</a>
    </div>
    <div class="top-nav-user">
      <div class="top-nav-user-info">
        <div class="top-nav-user-name">
          <%= user.profile?.firstName || user.profile?.name || user.email.split('@')[0] %>
        </div>
        <div class="top-nav-user-email">
          <%= user.email %>
        </div>
      </div>
      <a href="/logout" class="top-nav-logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <a href="/organizations" class="back-link">← Back to Organizations</a>

    <div class="header">
      <div>
        <h1>My Pending Invitations</h1>
        <div class="header-subtitle">Invitations sent to <%= user.email %>
        </div>
      </div>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
      <% } %>

        <% if (typeof success !=='undefined' && success) { %>
          <div class="alert alert-success">
            <%= success %>
          </div>
          <% } %>

            <% if (invitations && invitations.length> 0) { %>
              <% invitations.forEach(invite=> { %>
                <div class="card invite-card" data-invite-id="<%= invite.id %>">
                  <div class="invite-header">
                    <div class="invite-info">
                      <div class="invite-org-name">
                        <%= invite.organization.name %>
                      </div>
                      <% if (invite.organization.description) { %>
                        <div class="invite-org-desc">
                          <%= invite.organization.description %>
                        </div>
                        <% } %>
                          <div class="invite-meta">
                            <span class="role-badge role-<%= invite.role %>">
                              <%= invite.role %>
                            </span>
                            <span class="status-pending">Pending</span>
                            <span>Invited by <%= invite.invitedBy?.name || invite.invitedBy?.email || 'Unknown' %>
                                </span>
                            <span>Expires <%= new Date(invite.expiresAt).toLocaleDateString() %></span>
                          </div>
                    </div>
                  </div>
                  <div class="invite-actions">
                    <button class="btn btn-primary"
                      onclick="acceptInvite('<%= invite.id %>', '<%= invite.organization.name %>')"
                      id="accept-btn-<%= invite.id %>">
                      Accept Invitation
                    </button>
                    <button class="btn btn-secondary" onclick="rejectInvite('<%= invite.id %>')"
                      id="reject-btn-<%= invite.id %>">
                      Decline
                    </button>
                  </div>
                </div>
                <% }) %>
                  <% } else { %>
                    <div class="card empty-state">
                      <h3>No pending invitations</h3>
                      <p>You don't have any pending invitations at the moment.</p>
                      <a href="/organizations" class="btn btn-primary">View Organizations</a>
                    </div>
                    <% } %>
  </div>

  <script>
    async function acceptInvite(inviteId, orgName) {
      const btn = document.getElementById(`accept-btn-${inviteId}`);
      const rejectBtn = document.getElementById(`reject-btn-${inviteId}`);

      if (!confirm(`Accept invitation to join ${orgName}?`)) return;

      btn.disabled = true;
      btn.textContent = 'Accepting...';
      if (rejectBtn) rejectBtn.disabled = true;

      try {
        const response = await fetch(`/api/invitations/accept/${inviteId}`, {
          method: 'POST'
        });

        const data = await response.json();

        if (response.ok) {
          alert(`Successfully joined ${orgName}!`);
          window.location.href = `/organizations/${data.organization.id}/members?success=Welcome to ${orgName}!`;
        } else {
          alert(data.error || 'Failed to accept invitation');
          btn.disabled = false;
          btn.textContent = 'Accept Invitation';
          if (rejectBtn) rejectBtn.disabled = false;
        }
      } catch (error) {
        console.error('Accept invitation error:', error);
        alert('Failed to accept invitation');
        btn.disabled = false;
        btn.textContent = 'Accept Invitation';
        if (rejectBtn) rejectBtn.disabled = false;
      }
    }

    async function rejectInvite(inviteId) {
      if (!confirm('Decline this invitation?')) return;

      const btn = document.getElementById(`reject-btn-${inviteId}`);
      const acceptBtn = document.getElementById(`accept-btn-${inviteId}`);

      btn.disabled = true;
      if (acceptBtn) acceptBtn.disabled = true;

      try {
        // For now, just remove from view - we could add a reject endpoint later
        const card = document.querySelector(`[data-invite-id="${inviteId}"]`);
        if (card) {
          card.style.opacity = '0.5';
          card.style.pointerEvents = 'none';
        }
        alert('Invitation declined');
      } catch (error) {
        console.error('Reject invitation error:', error);
        alert('Failed to decline invitation');
        btn.disabled = false;
        if (acceptBtn) acceptBtn.disabled = false;
      }
    }
  </script>
</body>

</html>