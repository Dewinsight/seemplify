<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Book a Demo - <%= brand.name %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
    .demo-page {
      max-width: 1120px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 20px;
      padding: 32px 20px 48px;
    }
    .demo-shell {
      display: grid;
      gap: 20px;
    }
    .demo-card {
      background: var(--panel);
      border: 1px solid var(--border);
      box-shadow: var(--card-shadow);
      border-radius: 24px;
      padding: 28px;
      backdrop-filter: blur(16px);
    }
    .demo-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(99, 102, 241, 0.14);
      color: var(--brand);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .demo-title {
      margin: 18px 0 10px;
      font-size: 42px;
      line-height: 1;
      letter-spacing: -0.04em;
      color: var(--text);
    }
    .demo-copy {
      color: var(--muted);
      font-size: 15px;
      line-height: 1.7;
      max-width: 56ch;
    }
    .demo-highlights {
      display: grid;
      gap: 14px;
      margin-top: 22px;
    }
    .demo-highlight {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 12px;
      align-items: start;
      padding: 14px 16px;
      border-radius: 16px;
      background: var(--hover-bg);
      border: 1px solid var(--border);
    }
    .demo-highlight-icon {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(76, 29, 149, 0.18));
      color: var(--text);
      font-size: 18px;
    }
    .demo-highlight-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }
    .demo-highlight-copy {
      font-size: 13px;
      line-height: 1.6;
      color: var(--muted);
    }
    .demo-form-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }
    .demo-form-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.02em;
    }
    .demo-form-copy {
      margin-top: 4px;
      font-size: 14px;
      color: var(--muted);
    }
    .demo-form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .demo-form-grid .full {
      grid-column: 1 / -1;
    }
    .demo-form-group {
      display: grid;
      gap: 8px;
    }
    .demo-form-group label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-secondary);
    }
    .demo-input,
    .demo-textarea {
      width: 100%;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: var(--panel-strong);
      color: var(--text);
      padding: 13px 14px;
      font: inherit;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    .demo-input:focus,
    .demo-textarea:focus {
      outline: none;
      border-color: rgba(99, 102, 241, 0.55);
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
      background: var(--hover-bg);
    }
    .demo-textarea {
      min-height: 132px;
      resize: vertical;
    }
    .demo-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 20px;
    }
    .demo-note {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.6;
      max-width: 42ch;
    }
    .demo-btn {
      appearance: none;
      border: none;
      border-radius: 999px;
      padding: 14px 22px;
      min-width: 180px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      background: linear-gradient(135deg, #0f172a, #1f2937);
      color: #fff;
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.24);
      transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
    }
    .demo-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 14px 36px rgba(15, 23, 42, 0.32);
    }
    .demo-btn[disabled] {
      opacity: 0.7;
      cursor: wait;
      transform: none;
    }
    .demo-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      text-decoration: none;
      font-weight: 600;
      margin-bottom: 18px;
    }
    .demo-link:hover {
      color: var(--text);
    }
    .demo-alert {
      display: none;
      margin-bottom: 16px;
      padding: 14px 16px;
      border-radius: 14px;
      border: 1px solid transparent;
      font-size: 14px;
      line-height: 1.6;
    }
    .demo-alert.show {
      display: block;
    }
    .demo-alert-success {
      border-color: rgba(139, 92, 246, 0.35);
      background: rgba(139, 92, 246, 0.1);
      color: #c4b5fd;
    }
    .demo-alert-error {
      border-color: rgba(239, 68, 68, 0.35);
      background: rgba(239, 68, 68, 0.1);
      color: #f87171;
    }
    @media (max-width: 980px) {
      .demo-page {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 640px) {
      .demo-form-grid {
        grid-template-columns: 1fr;
      }
      .demo-title {
        font-size: 34px;
      }
    }
  </style>
  <script src="/js/theme.js?v=2"></script>
</head>
<body>
  <div class="demo-page">
    <section class="demo-shell">
      <div class="demo-card">
        <a href="/login" class="demo-link">
          <span>&larr;</span>
          <span>Back to sign in</span>
        </a>
        <div class="demo-kicker">Book a Demo</div>
        <h1 class="demo-title">See <%= brand.name %> in action.</h1>
        <p class="demo-copy">
          Tell us a bit about your team and what you want to solve. We will review your request and get back to you soon
          to schedule the walkthrough.
        </p>
        <div class="demo-highlights">
          <div class="demo-highlight">
            <div class="demo-highlight-icon">1</div>
            <div>
              <div class="demo-highlight-title">Identity, HR, and payroll in one flow</div>
              <div class="demo-highlight-copy">Walk through how onboarding, leave, time, payroll, performance, and learning connect.</div>
            </div>
          </div>
          <div class="demo-highlight">
            <div class="demo-highlight-icon">2</div>
            <div>
              <div class="demo-highlight-title">See your actual use case</div>
              <div class="demo-highlight-copy">We tailor the walkthrough around your team structure, access rules, and workforce workflows.</div>
            </div>
          </div>
          <div class="demo-highlight">
            <div class="demo-highlight-icon">3</div>
            <div>
              <div class="demo-highlight-title">Get a follow-up from the team</div>
              <div class="demo-highlight-copy">Your request is sent directly to the <%= brand.name %> admin queue and email notifications go out immediately.</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="demo-card">
      <div class="demo-form-header">
        <div>
          <div class="demo-form-title">Request your demo</div>
          <div class="demo-form-copy">We use this to route your request and reply with the right next step.</div>
        </div>
      </div>

      <div id="demoSuccess" class="demo-alert demo-alert-success" role="status" aria-live="polite"></div>
      <div id="demoError" class="demo-alert demo-alert-error" role="alert" aria-live="polite"></div>

      <form id="bookDemoForm">
        <div class="demo-form-grid">
          <div class="demo-form-group">
            <label for="name">Full name *</label>
            <input class="demo-input" type="text" id="name" name="name" value="<%= formValues?.name || '' %>" required>
          </div>
          <div class="demo-form-group">
            <label for="email">Work email *</label>
            <input class="demo-input" type="email" id="email" name="email" value="<%= formValues?.email || '' %>" required>
          </div>
          <div class="demo-form-group">
            <label for="company">Company *</label>
            <input class="demo-input" type="text" id="company" name="company" value="<%= formValues?.company || '' %>" required>
          </div>
          <div class="demo-form-group">
            <label for="role">Role</label>
            <input class="demo-input" type="text" id="role" name="role" value="<%= formValues?.role || '' %>" placeholder="e.g. HR Lead">
          </div>
          <div class="demo-form-group full">
            <label for="phone">Phone</label>
            <input class="demo-input" type="text" id="phone" name="phone" value="<%= formValues?.phone || '' %>" placeholder="Optional">
          </div>
          <div class="demo-form-group full">
            <label for="message">What do you want to see?</label>
            <textarea class="demo-textarea" id="message" name="message" placeholder="Tell us about the workflow, team size, or modules you want us to focus on."><%= formValues?.message || '' %></textarea>
          </div>
        </div>

        <div class="demo-actions">
          <div class="demo-note">
            We will email you to confirm we received the request, and the team will follow up soon.
          </div>
          <button class="demo-btn" type="submit" id="submitBtn">
            <span id="submitText">Send demo request</span>
          </button>
        </div>
      </form>
    </section>
  </div>

  <script>
    const form = document.getElementById('bookDemoForm')
    const submitBtn = document.getElementById('submitBtn')
    const submitText = document.getElementById('submitText')
    const successBox = document.getElementById('demoSuccess')
    const errorBox = document.getElementById('demoError')

    function showMessage(target, message) {
      target.textContent = message
      target.classList.add('show')
      window.scrollTo({ top: 0, behavior: 'smooth' })
    }

    function clearMessages() {
      successBox.classList.remove('show')
      errorBox.classList.remove('show')
      successBox.textContent = ''
      errorBox.textContent = ''
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      clearMessages()
      submitBtn.disabled = true
      submitText.textContent = 'Sending...'

      const formData = new FormData(form)
      const payload = Object.fromEntries(formData.entries())

      try {
        const response = await fetch('/api/public/book-demo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })

        const result = await response.json()
        if (!response.ok) {
          showMessage(errorBox, result.error || 'Failed to send demo request')
          return
        }

        form.reset()
        showMessage(successBox, result.message || 'Your demo request has been received. We will get back to you soon.')
      } catch (error) {
        console.error('Book demo request failed:', error)
        showMessage(errorBox, 'Failed to send demo request')
      } finally {
        submitBtn.disabled = false
        submitText.textContent = 'Send demo request'
      }
    })
  </script>
</body>
</html>
