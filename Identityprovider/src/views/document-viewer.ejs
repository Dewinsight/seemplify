<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title><%= title || 'Document' %> - Seemplify</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
</head>

<body>
  <%- include('partials/nav', { activePage: activePage || 'onboarding' }) %>

  <div class="container">
    <a class="back-link" href="<%= backUrl || '/onboarding' %>">&larr; Back</a>

    <div class="header" style="margin-top: 10px;">
      <div>
        <h1 style="margin:0;"><%= title || 'Document' %></h1>
        <% if (subtitle) { %>
          <div class="header-subtitle"><%= subtitle %></div>
        <% } %>
      </div>
      <% if (docUrl) { %>
        <div class="header-actions">
          <a class="btn btn-secondary" href="<%= docUrl %>" target="_blank" rel="noreferrer">Open</a>
          <% if (downloadUrl) { %>
            <a class="btn btn-primary" href="<%= downloadUrl %>" rel="noreferrer">Download</a>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="card">
      <% if (!docUrl) { %>
        <div class="empty-state">
          <h3>Document unavailable</h3>
          <p>The document could not be loaded.</p>
        </div>
      <% } else { %>
        <% const resolvedDocType = (docType || 'pdf').toString().toLowerCase(); %>
        <% if (resolvedDocType === 'image') { %>
          <div style="display:flex; justify-content:center;">
            <img
              src="<%= docUrl %>"
              alt="<%= title || 'Document' %>"
              style="max-width: 100%; border-radius: 12px; border: 1px solid var(--border); background: var(--panel);"
            />
          </div>
        <% } else if (resolvedDocType === 'pdf') { %>
          <div class="pdf-viewer" id="pdf-viewer">
            <div class="pdf-toolbar">
              <div style="display:flex; gap: 6px; align-items:center; flex-wrap: wrap;">
                <button class="btn btn-secondary btn-sm" type="button" id="pdf-prev">Prev</button>
                <span id="pdf-page-label" style="font-size: 12px; color: var(--muted);">Page 1 / 1</span>
                <button class="btn btn-secondary btn-sm" type="button" id="pdf-next">Next</button>
                <input class="pdf-page-range" type="range" min="1" max="1" value="1" id="pdf-page-range" aria-label="Page slider" />
              </div>
              <div style="display:flex; gap: 6px; align-items:center;">
                <button class="btn btn-secondary btn-sm" type="button" id="pdf-zoom-out">-</button>
                <span id="pdf-zoom-label" style="font-size: 12px; color: var(--muted);">100%</span>
                <button class="btn btn-secondary btn-sm" type="button" id="pdf-zoom-in">+</button>
                <button class="btn btn-secondary btn-sm" type="button" id="pdf-fit">Fit</button>
              </div>
            </div>
            <div class="pdf-canvas-wrap" id="pdf-canvas-wrap">
              <div class="pdf-stage" id="pdf-stage">
                <canvas id="pdf-canvas"></canvas>
              </div>
            </div>
            <div class="pdf-hint">Tip: drag to pan. Use the slider to jump pages fast.</div>
            <div class="alert alert-error" id="pdf-error" style="margin-top: 12px; display:none;"></div>
          </div>
        <% } else { %>
          <div class="empty-state">
            <h3>Preview not available</h3>
            <p>Use "Open" to view and "Download" to save the file.</p>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <script src="/vendor/pdfjs/pdf.min.js"></script>
  <script>
    const docUrl = <%- JSON.stringify(docUrl || '') %>;
    const docType = <%- JSON.stringify((docType || 'pdf').toString().toLowerCase()) %>;
    const viewer = document.getElementById('pdf-viewer');
    const wrap = document.getElementById('pdf-canvas-wrap');
    const stage = document.getElementById('pdf-stage');
    const canvas = document.getElementById('pdf-canvas');
    const ctx = canvas ? canvas.getContext('2d') : null;
    const pageLabel = document.getElementById('pdf-page-label');
    const pageRange = document.getElementById('pdf-page-range');
    const prevBtn = document.getElementById('pdf-prev');
    const nextBtn = document.getElementById('pdf-next');
    const zoomOutBtn = document.getElementById('pdf-zoom-out');
    const zoomInBtn = document.getElementById('pdf-zoom-in');
    const zoomLabel = document.getElementById('pdf-zoom-label');
    const fitBtn = document.getElementById('pdf-fit');
    const errorEl = document.getElementById('pdf-error');

    const state = { pdf: null, page: 1, totalPages: 0, scale: 1, zoom: 1 };

    function clampNumber(value, min, max) {
      return Math.min(max, Math.max(min, value));
    }

    function getWrapInnerWidth(el) {
      if (!el) return 700;
      const styles = window.getComputedStyle(el);
      const padLeft = parseFloat(styles.paddingLeft) || 0;
      const padRight = parseFloat(styles.paddingRight) || 0;
      const width = (el.clientWidth || 0) - padLeft - padRight;
      return width > 0 ? width : (el.clientWidth || 700);
    }

    function showPdfError(message) {
      if (!errorEl) return;
      errorEl.textContent = message || 'Failed to load document';
      errorEl.style.display = 'block';
    }

    function updateToolbar() {
      if (pageLabel) {
        pageLabel.textContent = `Page ${state.page} / ${state.totalPages || 1}`;
      }
      if (pageRange) {
        pageRange.min = '1';
        pageRange.max = String(state.totalPages || 1);
        pageRange.value = String(state.page || 1);
        pageRange.style.display = (state.totalPages || 1) > 1 ? 'inline-block' : 'none';
      }
      if (zoomLabel) {
        zoomLabel.textContent = `${Math.round((state.zoom || 1) * 100)}%`;
      }
    }

    async function loadPdf(url) {
      if (!url || !window.pdfjsLib || !canvas || !ctx) return;
      try {
        pdfjsLib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';
        const loadingTask = pdfjsLib.getDocument(url);
        const pdf = await loadingTask.promise;
        state.pdf = pdf;
        state.page = 1;
        state.totalPages = pdf.numPages;
        state.zoom = 1;
        updateToolbar();
        await renderPage();
      } catch (err) {
        console.error('PDF load error:', err);
        showPdfError('Could not load this PDF. If it was just signed, refresh and try again.');
      }
    }

    async function renderPage() {
      if (!state.pdf || !canvas || !ctx) return;
      const page = await state.pdf.getPage(state.page);
      const unscaledViewport = page.getViewport({ scale: 1 });
      const wrapWidth = getWrapInnerWidth(wrap) || 700;
      const scale = (wrapWidth / unscaledViewport.width) * (state.zoom || 1);
      state.scale = scale;
      const viewport = page.getViewport({ scale });

      const ratio = window.devicePixelRatio || 1;
      canvas.width = Math.floor(viewport.width * ratio);
      canvas.height = Math.floor(viewport.height * ratio);
      canvas.style.width = `${Math.floor(viewport.width)}px`;
      canvas.style.height = `${Math.floor(viewport.height)}px`;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, viewport.width, viewport.height);

      await page.render({ canvasContext: ctx, viewport }).promise;

      updateToolbar();
    }

    function changePage(delta) {
      if (!state.pdf) return;
      const next = Math.min(state.totalPages, Math.max(1, state.page + delta));
      if (next === state.page) return;
      state.page = next;
      updateToolbar();
      renderPage();
    }

    prevBtn?.addEventListener('click', () => changePage(-1));
    nextBtn?.addEventListener('click', () => changePage(1));

    let pageScrubTimer = null;
    pageRange?.addEventListener('input', () => {
      if (!state.pdf) return;
      const next = clampNumber(Number(pageRange.value), 1, state.totalPages || 1);
      if (pageLabel) {
        pageLabel.textContent = `Page ${next} / ${state.totalPages}`;
      }
      clearTimeout(pageScrubTimer);
      pageScrubTimer = setTimeout(() => {
        state.page = next;
        renderPage();
      }, 120);
    });

    function changeZoom(delta) {
      if (!state.pdf) return;
      const next = clampNumber((state.zoom || 1) + Number(delta || 0), 0.6, 2.25);
      if (Math.abs(next - (state.zoom || 1)) < 0.001) return;
      state.zoom = next;
      updateToolbar();
      renderPage();
    }

    zoomOutBtn?.addEventListener('click', () => changeZoom(-0.15));
    zoomInBtn?.addEventListener('click', () => changeZoom(0.15));
    fitBtn?.addEventListener('click', () => {
      if (!state.pdf) return;
      state.zoom = 1;
      updateToolbar();
      renderPage();
    });

    function bindPdfPanScroll(wrapEl) {
      if (!wrapEl) return;
      let isDown = false;
      let moved = false;
      let pointerId = null;
      let startX = 0;
      let startY = 0;
      let startLeft = 0;
      let startTop = 0;
      const threshold = 3;

      wrapEl.classList.add('can-pan');

      wrapEl.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse') return;
        if (event.button !== 0) return;
        isDown = true;
        moved = false;
        pointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        startLeft = wrapEl.scrollLeft;
        startTop = wrapEl.scrollTop;
        wrapEl.classList.add('is-pan-ready');
        wrapEl.setPointerCapture(pointerId);
      });

      wrapEl.addEventListener('pointermove', (event) => {
        if (!isDown) return;
        const dx = event.clientX - startX;
        const dy = event.clientY - startY;
        if (!moved && Math.hypot(dx, dy) < threshold) return;
        moved = true;
        wrapEl.classList.add('is-panning');
        wrapEl.scrollLeft = startLeft - dx;
        wrapEl.scrollTop = startTop - dy;
      });

      const endPan = () => {
        if (!isDown) return;
        isDown = false;
        wrapEl.classList.remove('is-panning');
        wrapEl.classList.remove('is-pan-ready');
        if (pointerId != null) {
          try { wrapEl.releasePointerCapture(pointerId); } catch (e) {}
        }
        pointerId = null;
      };

      wrapEl.addEventListener('pointerup', endPan);
      wrapEl.addEventListener('pointercancel', endPan);

      wrapEl.addEventListener('click', (event) => {
        if (moved) {
          event.preventDefault();
          event.stopPropagation();
        }
      }, true);
    }

    bindPdfPanScroll(wrap);

    let resizeTimer = null;
    window.addEventListener('resize', () => {
      if (!state.pdf) return;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => renderPage(), 150);
    });

    if (docType === 'pdf' && docUrl) {
      loadPdf(docUrl);
    }
  </script>
</body>

</html>
