<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Subscription - Seemplify</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    body {
      padding: 28px 18px 48px;
    }

    .subscription-container {
      max-width: 1000px;
      margin: 0 auto;
    }

    .page-header {
      margin-bottom: 32px;
    }

    .page-header h1 {
      font-size: 28px;
      font-weight: 700;
      color: var(--text);
      margin: 0 0 8px;
    }

    .page-header p {
      font-size: 16px;
      color: var(--muted);
      margin: 0;
    }

    .alert {
      padding: 16px;
      border-radius: 8px;
      margin-bottom: 24px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .alert svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    .alert-success {
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #22c55e;
    }

    .alert-warning {
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #f59e0b;
    }

    .alert-info {
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.3);
      color: var(--brand);
    }

    .subscription-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 32px;
    }

    @media (max-width: 768px) {
      .subscription-grid {
        grid-template-columns: 1fr;
      }
    }

    .card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .card-title {
      font-size: 18px;
      font-weight: 600;
      color: var(--text);
      margin: 0;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .status-badge--active {
      background: rgba(34, 197, 94, 0.1);
      color: #22c55e;
    }

    .status-badge--pending {
      background: rgba(245, 158, 11, 0.1);
      color: #f59e0b;
    }

    .status-badge--expired {
      background: rgba(239, 68, 68, 0.1);
      color: #ef4444;
    }

    .status-badge--none {
      background: rgba(107, 114, 128, 0.1);
      color: #6b7280;
    }

    .subscription-details {
      display: grid;
      gap: 16px;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }

    .detail-row:last-child {
      border-bottom: none;
    }

    .detail-label {
      font-size: 14px;
      color: var(--muted);
    }

    .detail-value {
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
    }

    .plan-name {
      font-size: 24px;
      font-weight: 700;
      color: var(--text);
      margin: 0 0 16px;
    }

    .features-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .features-list li {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      font-size: 14px;
      color: var(--text);
    }

    .features-list li svg {
      width: 16px;
      height: 16px;
      color: #22c55e;
      flex-shrink: 0;
    }

    .no-subscription {
      text-align: center;
      padding: 48px 24px;
    }

    .no-subscription svg {
      width: 64px;
      height: 64px;
      color: var(--muted);
      margin-bottom: 16px;
    }

    .no-subscription h3 {
      font-size: 18px;
      font-weight: 600;
      color: var(--text);
      margin: 0 0 8px;
    }

    .no-subscription p {
      font-size: 14px;
      color: var(--muted);
      margin: 0 0 24px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
    }



    .btn-danger {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #ef4444;
    }

    .btn-danger:hover {
      background: rgba(239, 68, 68, 0.2);
    }

    .btn-sm {
      padding: 8px 12px;
      font-size: 13px;
    }

    /* Requests Section */
    .requests-section {
      margin-top: 32px;
    }

    .requests-table {
      width: 100%;
      border-collapse: collapse;
    }

    .requests-table th,
    .requests-table td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    .requests-table th {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .requests-table td {
      font-size: 14px;
      color: var(--text);
    }

    .empty-state {
      text-align: center;
      padding: 32px;
      color: var(--muted);
    }

    .org-selector {
      margin-bottom: 24px;
    }

    .org-selector label {
      display: block;
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 8px;
    }

    .org-selector select {
      padding: 12px 16px;
      font-size: 14px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      min-width: 250px;
    }

    .expiry-warning {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.3);
      border-radius: 8px;
      color: #f59e0b;
      font-size: 14px;
      margin-top: 16px;
    }

    .expiry-warning svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }
  </style>
  <script src="/js/theme.js?v=2"></script>
</head>

<body>
  <%- include('partials/nav', { activePage: 'subscription' }) %>

  <div class="subscription-container">
    <div class="page-header">
      <h1>Subscription</h1>
      <p>Manage your organization's subscription and view available plans.</p>
    </div>

    <% if (typeof requested !== 'undefined' && requested) { %>
      <div class="alert alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 6L9 17l-5-5" />
        </svg>
        <span>Your subscription request has been submitted successfully! We'll review it and get back to you soon.</span>
      </div>
    <% } %>

    <% if (subscription && subscription.status !== 'active') { %>
      <div class="alert alert-warning">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 8v4M12 16h.01" />
        </svg>
        <span>Your current plan is no longer active. Access in the IDP is locked until another requestable plan is approved.</span>
      </div>
    <% } else if (!subscription && organization) { %>
      <div class="alert alert-warning">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 8v4M12 16h.01" />
        </svg>
        <span>This organization does not have an active plan. Request a plan to restore access.</span>
      </div>
    <% } %>

    <% if (!organization) { %>
      <div class="card">
        <div class="no-subscription">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 21h18M5 21V7l8-4 8 4v14M8 21v-4h8v4" />
          </svg>
          <h3>No Organization Selected</h3>
          <p>Please select an organization to view subscription details.</p>
          <a href="/organizations" class="btn btn-primary">Go to Organizations</a>
        </div>
      </div>
    <% } else { %>
      <% if (organizations && organizations.length > 1) { %>
        <div class="org-selector">
          <label>Viewing subscription for:</label>
          <select onchange="window.location.href='/subscription?org=' + this.value">
            <% organizations.forEach(org => { %>
              <option value="<%= org._id %>" <%= org._id.toString() === organization._id.toString() ? 'selected' : '' %>>
                <%= org.name %>
              </option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <div class="subscription-grid">
        <!-- Current Subscription Card -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Current Subscription</h2>
            <% if (subscription) { %>
              <span class="status-badge status-badge--<%= subscription.status %>">
                <%= subscription.status.charAt(0).toUpperCase() + subscription.status.slice(1) %>
              </span>
            <% } else { %>
              <span class="status-badge status-badge--none">No Subscription</span>
            <% } %>
          </div>

          <% if (subscription) { %>
            <h3 class="plan-name"><%= subscription.plan.name %></h3>

            <div class="subscription-details">
              <div class="detail-row">
                <span class="detail-label">Billing Cycle</span>
                <span class="detail-value"><%= subscription.billingCycle.charAt(0).toUpperCase() + subscription.billingCycle.slice(1) %></span>
              </div>
              <div class="detail-row">
                <span class="detail-label">Price</span>
                <span class="detail-value"><%= subscription.formattedPrice %></span>
              </div>
              <div class="detail-row">
                <span class="detail-label">Start Date</span>
                <span class="detail-value"><%= new Date(subscription.startDate).toLocaleDateString() %></span>
              </div>
              <div class="detail-row">
                <span class="detail-label">Expires</span>
                <span class="detail-value"><%= new Date(subscription.endDate).toLocaleDateString() %></span>
              </div>
              <% if (subscription.daysUntilExpiry !== undefined) { %>
                <div class="detail-row">
                  <span class="detail-label">Days Remaining</span>
                  <span class="detail-value" style="color: <%= subscription.daysUntilExpiry <= 7 ? '#ef4444' : subscription.daysUntilExpiry <= 30 ? '#f59e0b' : '#22c55e' %>">
                    <%= subscription.daysUntilExpiry %> days
                  </span>
                </div>
              <% } %>
            </div>

            <% if (subscription.daysUntilExpiry <= 30 && subscription.daysUntilExpiry > 0) { %>
              <div class="expiry-warning">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 8v4M12 16h.01" />
                </svg>
                <span>Your subscription expires in <%= subscription.daysUntilExpiry %> days. Request another plan now to avoid access being locked.</span>
              </div>
            <% } %>

            <div style="margin-top: 20px;">
              <a href="/plans" class="btn btn-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                </svg>
                View All Plans
              </a>
            </div>
          <% } else { %>
            <div class="no-subscription">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              </svg>
              <h3>No Active Subscription</h3>
              <p>Request a plan to restore access to the IDP apps for this organization.</p>
              <a href="/plans" class="btn btn-primary">Request a Plan</a>
            </div>
          <% } %>
        </div>

        <!-- Features Card -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Available Features</h2>
          </div>

          <% if (features) { %>
            <ul class="features-list">
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= features.recruiter ? '#22c55e' : 'var(--muted)' %>">
                  <% if (features.recruiter) { %>
                    <path d="M20 6L9 17l-5-5" />
                  <% } else { %>
                    <path d="M18 6L6 18M6 6l12 12" />
                  <% } %>
                </svg>
                <span style="color: <%= features.recruiter ? 'var(--text)' : 'var(--muted)' %>">Recruiter (SmartHR)</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= features.leaveManagement ? '#22c55e' : 'var(--muted)' %>">
                  <% if (features.leaveManagement) { %>
                    <path d="M20 6L9 17l-5-5" />
                  <% } else { %>
                    <path d="M18 6L6 18M6 6l12 12" />
                  <% } %>
                </svg>
                <span style="color: <%= features.leaveManagement ? 'var(--text)' : 'var(--muted)' %>">Leave Management</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= features.payrollManagement ? '#22c55e' : 'var(--muted)' %>">
                  <% if (features.payrollManagement) { %>
                    <path d="M20 6L9 17l-5-5" />
                  <% } else { %>
                    <path d="M18 6L6 18M6 6l12 12" />
                  <% } %>
                </svg>
                <span style="color: <%= features.payrollManagement ? 'var(--text)' : 'var(--muted)' %>">Payroll Management</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= features.performanceManagement ? '#22c55e' : 'var(--muted)' %>">
                  <% if (features.performanceManagement) { %>
                    <path d="M20 6L9 17l-5-5" />
                  <% } else { %>
                    <path d="M18 6L6 18M6 6l12 12" />
                  <% } %>
                </svg>
                <span style="color: <%= features.performanceManagement ? 'var(--text)' : 'var(--muted)' %>">Performance Management</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= features.outlineDocs ? '#22c55e' : 'var(--muted)' %>">
                  <% if (features.outlineDocs) { %>
                    <path d="M20 6L9 17l-5-5" />
                  <% } else { %>
                    <path d="M18 6L6 18M6 6l12 12" />
                  <% } %>
                </svg>
                <span style="color: <%= features.outlineDocs ? 'var(--text)' : 'var(--muted)' %>">Outline Docs</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= features.aiChat ? '#22c55e' : 'var(--muted)' %>">
                  <% if (features.aiChat) { %>
                    <path d="M20 6L9 17l-5-5" />
                  <% } else { %>
                    <path d="M18 6L6 18M6 6l12 12" />
                  <% } %>
                </svg>
                <span style="color: <%= features.aiChat ? 'var(--text)' : 'var(--muted)' %>">AI Chat Assistant</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= features.lms ? '#22c55e' : 'var(--muted)' %>">
                  <% if (features.lms) { %>
                    <path d="M20 6L9 17l-5-5" />
                  <% } else { %>
                    <path d="M18 6L6 18M6 6l12 12" />
                  <% } %>
                </svg>
                <span style="color: <%= features.lms ? 'var(--text)' : 'var(--muted)' %>">Learning Management</span>
              </li>
            </ul>

            <% if (limits) { %>
              <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border);">
                <div class="detail-row">
                  <span class="detail-label">Member Limit</span>
                  <span class="detail-value"><%= limits.maxMembers === null ? 'Unlimited' : limits.maxMembers %></span>
                </div>
                <div class="detail-row">
                  <span class="detail-label">Team Limit</span>
                  <span class="detail-value"><%= limits.maxTeams === null ? 'Unlimited' : limits.maxTeams %></span>
                </div>
              </div>
            <% } %>
          <% } else { %>
            <p style="color: var(--muted); text-align: center; padding: 24px;">Subscribe to a plan to unlock features.</p>
          <% } %>
        </div>
      </div>

      <!-- Subscription Requests -->
      <div class="card requests-section">
        <div class="card-header">
          <h2 class="card-title">Subscription Requests</h2>
        </div>

        <% if (requests && requests.length > 0) { %>
          <table class="requests-table">
            <thead>
              <tr>
                <th>Plan</th>
                <th>Billing</th>
                <th>Type</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% requests.forEach(request => { %>
                <tr>
                  <td><%= request.plan?.name || 'Unknown' %></td>
                  <td><%= request.billingCycle %></td>
                  <td><%= request.requestTypeDisplay || request.requestType %></td>
                  <td>
                    <span class="status-badge status-badge--<%= request.status %>">
                      <%= request.status %>
                    </span>
                  </td>
                  <td><%= new Date(request.createdAt).toLocaleDateString() %></td>
                  <td>
                    <% if (request.status === 'pending' && isAdmin) { %>
                      <button class="btn btn-sm btn-danger" onclick="cancelRequest('<%= request.id %>')">
                        Cancel
                      </button>
                    <% } else if (request.status === 'rejected' && request.rejectionReason) { %>
                      <button class="btn btn-sm btn-secondary" onclick="alert('Rejection reason: <%= request.rejectionReason %>')">
                        View Reason
                      </button>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="empty-state">
            <p>No subscription requests yet.</p>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <script>
    async function cancelRequest(requestId) {
      if (!confirm('Are you sure you want to cancel this subscription request?')) {
        return
      }

      try {
        const response = await fetch('/api/organizations/<%= organization?._id %>/subscription/requests/' + requestId, {
          method: 'DELETE'
        })

        const data = await response.json()

        if (!response.ok) {
          throw new Error(data.error || 'Failed to cancel request')
        }

        window.location.reload()
      } catch (error) {
        alert('Error: ' + error.message)
      }
    }
  </script>
</body>

</html>
