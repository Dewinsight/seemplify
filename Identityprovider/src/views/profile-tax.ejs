<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Tax Information - Seemplify</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        <%- include('../public/css/idp-theme.css') %>
    </style>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/profile-dashboard.css">
    <script src="/js/theme.js?v=2"></script>
</head>

<body>
    <%- include('partials/nav', { activePage: 'profile' }) %>

        <div class="container">
            <div class="header">
                <div>
                    <h1>Tax Information</h1>
                    <div class="header-subtitle">
                        Manage your W-4 withholding settings
                    </div>
                </div>
            </div>

            <!-- Profile Navigation Tabs -->
            <div class="profile-nav">
                <a href="/profile">Dashboard</a>
                <a href="/profile/personal">Personal Info</a>
                <a href="/profile/documents">Documents</a>
                <a href="/profile/tax" class="active">Tax Settings</a>
                <a href="/profile/banking">Banking</a>
                <a href="/profile/dependents">Dependents</a>
            </div>

            <div id="alertSuccess" class="alert alert-success"></div>
            <div id="alertError" class="alert alert-error"></div>

            <!-- Current W-4 Status -->
            <% if (user.profile?.taxInfo?.lastUpdated) { %>
                <div class="card" style="background: var(--hover-bg); border-color: var(--success);">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="font-size: 32px;">✅</div>
                        <div>
                            <h3 style="margin: 0; font-size: 16px; color: var(--text);">W-4 Form Completed</h3>
                            <p style="margin: 4px 0 0; font-size: 14px; color: var(--muted);">
                                Last updated: <%= new Date(user.profile.taxInfo.lastUpdated).toLocaleDateString('en-US',
                                    { year: 'numeric' , month: 'long' , day: 'numeric' }) %>
                            </p>
                        </div>
                    </div>
                </div>
                <% } else { %>
                    <div class="card" style="background: var(--hover-bg); border-color: var(--brand);">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="font-size: 32px;">ℹ️</div>
                            <div>
                                <h3 style="margin: 0; font-size: 16px; color: var(--text);">W-4 Form Required</h3>
                                <p style="margin: 4px 0 0; font-size: 14px; color: var(--muted);">
                                    Please complete your W-4 tax withholding information below
                                </p>
                            </div>
                        </div>
                    </div>
                    <% } %>

                        <!-- W-4 Form -->
                        <div class="card">
                            <h3 style="font-size: 18px; margin-bottom: 8px;">Federal W-4 Withholding</h3>
                            <p style="font-size: 14px; color: var(--muted); margin-bottom: 24px;">
                                This information determines how much federal income tax is withheld from your paycheck.
                            </p>

                            <form id="taxForm">
                                <div class="form-group">
                                    <label for="filingStatus">Filing Status <span
                                            style="color: var(--error);">*</span></label>
                                    <select id="filingStatus" name="filingStatus" required>
                                        <option value="">Select filing status...</option>
                                        <option value="single" <%=user.profile?.taxInfo?.filingStatus==='single'
                                            ? 'selected' : '' %>>Single or Married filing separately</option>
                                        <option value="married_jointly"
                                            <%=user.profile?.taxInfo?.filingStatus==='married_jointly' ? 'selected' : ''
                                            %>>Married filing jointly</option>
                                        <option value="married_separately"
                                            <%=user.profile?.taxInfo?.filingStatus==='married_separately' ? 'selected'
                                            : '' %>>Married filing separately</option>
                                        <option value="head_of_household"
                                            <%=user.profile?.taxInfo?.filingStatus==='head_of_household' ? 'selected'
                                            : '' %>>Head of household</option>
                                    </select>
                                    <div class="form-hint">Choose the filing status you'll use on your tax return</div>
                                </div>

                                <div class="form-group">
                                    <label for="w4Allowances">Number of Allowances/Dependents</label>
                                    <input type="number" id="w4Allowances" name="w4Allowances" min="0" max="20"
                                        value="<%= user.profile?.taxInfo?.w4Allowances || 0 %>" placeholder="0">
                                    <div class="form-hint">Enter the number of dependents you claim</div>
                                </div>

                                <div class="form-group">
                                    <label for="additionalWithholding">Additional Withholding Amount (Optional)</label>
                                    <input type="number" id="additionalWithholding" name="additionalWithholding" min="0"
                                        step="0.01" value="<%= user.profile?.taxInfo?.additionalWithholding || '' %>"
                                        placeholder="0.00">
                                    <div class="form-hint">Extra amount to withhold from each paycheck (enter as
                                        dollars, e.g., 50.00)</div>
                                </div>

                                <div class="form-group">
                                    <label>
                                        <input type="checkbox" id="multipleJobs" name="multipleJobs">
                                        I have multiple jobs or my spouse works
                                    </label>
                                    <div class="form-hint">Check this if you or your spouse has more than one job</div>
                                </div>
                            </form>
                        </div>

                        <!-- W-4 Document -->
                        <% if (user.profile?.taxInfo?.lastUpdated) { %>
                            <div class="card">
                                <h3 style="font-size: 18px; margin-bottom: 16px;">Your W-4 Document</h3>
                                <div
                                    style="display: flex; align-items: center; gap: 16px; padding: 16px; background: var(--hover-bg); border-radius: 8px;">
                                    <div style="font-size: 48px;">📄</div>
                                    <div style="flex: 1;">
                                        <div style="font-weight: 600; color: var(--text);">Form W-4 (Signed)</div>
                                        <div style="font-size: 14px; color: var(--muted);">
                                            Completed on <%= new
                                                Date(user.profile.taxInfo.lastUpdated).toLocaleDateString() %>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-secondary" onclick="downloadW4()">
                                        Download PDF
                                    </button>
                                </div>
                            </div>
                            <% } %>

                                <!-- Save Button -->
                                <div class="card">
                                    <div class="form-actions">
                                        <button type="button" class="btn btn-primary" id="saveBtn"
                                            onclick="saveTaxInfo()">
                                            <span id="btnText">Save Tax Information</span>
                                            <span id="btnSpinner" style="display:none;">Saving...</span>
                                        </button>
                                        <a href="/profile" class="btn btn-secondary">Cancel</a>
                                    </div>

                                    <div
                                        style="margin-top: 16px; padding: 16px; background: var(--hover-bg); border-radius: 8px; font-size: 14px; color: var(--muted);">
                                        <strong>Important:</strong> Changes to your W-4 will be automatically sent to
                                        Payroll and applied to your next paycheck.
                                    </div>
                                </div>
        </div>

        <script>
            async function saveTaxInfo() {
                const alertSuccess = document.getElementById('alertSuccess');
                const alertError = document.getElementById('alertError');
                const saveBtn = document.getElementById('saveBtn');
                const btnText = document.getElementById('btnText');
                const btnSpinner = document.getElementById('btnSpinner');

                // Hide previous alerts
                alertSuccess.classList.remove('show');
                alertError.classList.remove('show');

                // Validation
                const filingStatus = document.getElementById('filingStatus').value;
                if (!filingStatus) {
                    alertError.textContent = 'Please select a filing status';
                    alertError.classList.add('show');
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    return;
                }

                // Show loading
                saveBtn.disabled = true;
                btnText.style.display = 'none';
                btnSpinner.style.display = 'inline';

                // Collect data
                const data = {
                    filingStatus: filingStatus,
                    w4Allowances: parseInt(document.getElementById('w4Allowances').value) || 0,
                    additionalWithholding: parseFloat(document.getElementById('additionalWithholding').value) || 0,
                    multipleJobs: document.getElementById('multipleJobs').checked
                };

                try {
                    const response = await fetch('/api/profile/tax', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (response.ok) {
                        alertSuccess.textContent = result.message || 'Tax information updated successfully! Payroll has been notified.';
                        alertSuccess.classList.add('show');
                        window.scrollTo({ top: 0, behavior: 'smooth' });

                        // Reload page after 2 seconds to show updated status
                        setTimeout(() => window.location.reload(), 2000);
                    } else {
                        alertError.textContent = result.error || 'Failed to update tax information';
                        alertError.classList.add('show');
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alertError.textContent = 'An error occurred while saving';
                    alertError.classList.add('show');
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } finally {
                    saveBtn.disabled = false;
                    btnText.style.display = 'inline';
                    btnSpinner.style.display = 'none';
                }
            }

            function downloadW4() {
                window.location.href = '/api/profile/tax/download-w4';
            }
        </script>

        <script src="/js/invitation-gatekeeper.js"></script>
</body>

</html>