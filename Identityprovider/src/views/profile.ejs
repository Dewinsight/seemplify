<!DOCTYPE html>
<html>

<head>
  <title>Profile Settings - AIIN Identity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    :root {
      --brand: #60a5fa;
      --brand-2: #a855f7;
      --surface: #0b1224;
      --surface-2: #0f172a;
      --surface-3: #1e293b;
      --line: #1f2a44;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --success: #22c55e;
      --error: #ef4444;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, #0b1224 0%, #0f172a 55%, #0b1224 100%);
      min-height: 100vh;
      color: var(--text);
      padding: 24px;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .header h1 {
      font-size: 28px;
      color: #f8fafc;
    }

    .header-subtitle {
      color: var(--muted);
      font-size: 14px;
      margin-top: 4px;
    }

    .btn {
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--brand), var(--brand-2));
      color: white;
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 16px rgba(96, 165, 250, 0.3);
    }

    .btn-secondary {
      background: var(--surface-3);
      color: var(--text);
      border: 1px solid var(--line);
    }

    .btn-secondary:hover {
      background: var(--surface-2);
    }

    .card {
      background: linear-gradient(160deg, rgba(16, 24, 40, 0.88), rgba(11, 18, 36, 0.92));
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      font-weight: 500;
      color: var(--text);
      font-size: 14px;
    }

    .form-group input {
      width: 100%;
      padding: 12px 16px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--surface);
      color: var(--text);
      font-size: 15px;
      transition: all 0.2s;
    }

    .form-group input:focus {
      outline: none;
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.1);
    }

    .form-group input:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .form-hint {
      font-size: 13px;
      color: var(--muted);
      margin-top: 6px;
    }

    .alert {
      padding: 14px 18px;
      border-radius: 10px;
      margin-bottom: 20px;
      font-size: 14px;
      display: none;
    }

    .alert.show {
      display: block;
    }

    .alert-error {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }

    .alert-success {
      background: rgba(34, 197, 94, 0.15);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #86efac;
    }

    .avatar-section {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 24px;
      padding: 20px;
      background: var(--surface-3);
      border-radius: 12px;
      border: 1px solid var(--line);
    }

    .avatar {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--brand), var(--brand-2));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      font-weight: 700;
      color: white;
      flex-shrink: 0;
    }

    .avatar-info {
      flex: 1;
    }

    .avatar-info h3 {
      font-size: 18px;
      color: #f8fafc;
      margin-bottom: 4px;
    }

    .avatar-info p {
      font-size: 14px;
      color: var(--muted);
    }

    .form-actions {
      display: flex;
      gap: 12px;
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px solid var(--line);
    }

    .top-nav {
      background: rgba(15, 23, 42, 0.95);
      border-bottom: 1px solid var(--line);
      padding: 12px 24px;
      margin: -24px -24px 24px -24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      backdrop-filter: blur(10px);
    }

    .top-nav-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }

    .top-nav-brand svg {
      width: 32px;
      height: 32px;
    }

    .top-nav-brand span {
      font-size: 18px;
      font-weight: 700;
      background: linear-gradient(135deg, var(--brand), var(--brand-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .top-nav-links {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .top-nav-link {
      padding: 8px 16px;
      border-radius: 8px;
      color: var(--muted);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.2s;
    }

    .top-nav-link:hover {
      color: var(--text);
      background: var(--surface-3);
    }

    .top-nav-link.active {
      color: var(--text);
      background: var(--surface-3);
    }
  </style>
</head>

<body>
  <!-- Top Navigation -->
  <div class="top-nav">
    <a href="https://seemplifyai.com" class="top-nav-brand">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
      <span>AIIN Identity</span>
    </a>
    <div class="top-nav-links">
      <a href="/" class="top-nav-link">Home</a>
      <a href="/organizations" class="top-nav-link">Organizations</a>
      <a href="/profile" class="top-nav-link active">Profile</a>
      <a href="/logout" class="top-nav-link">Logout</a>
    </div>
  </div>

  <div class="container">
    <div class="header">
      <div>
        <h1>Profile Settings</h1>
        <div class="header-subtitle">
          Manage your personal information
        </div>
      </div>
    </div>

    <div id="alertSuccess" class="alert alert-success"></div>
    <div id="alertError" class="alert alert-error"></div>

    <div class="card">
      <div class="avatar-section">
        <div class="avatar">
          <%= (user.profile?.name || user.email)[0].toUpperCase() %>
        </div>
        <div class="avatar-info">
          <h3><%= user.profile?.name || 'No name set' %></h3>
          <p><%= user.email %></p>
        </div>
      </div>

      <form id="profileForm">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" value="<%= user.email %>" disabled>
          <div class="form-hint">Email cannot be changed. Contact support if you need to update it.</div>
        </div>

        <div class="form-group">
          <label for="name">Full Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            value="<%= user.profile?.name || '' %>" 
            placeholder="Enter your full name"
            maxlength="100"
          >
          <div class="form-hint">Your name will be displayed to other users in your organizations.</div>
        </div>

        <div class="form-group">
          <label for="preferredUsername">Preferred Username (Optional)</label>
          <input 
            type="text" 
            id="preferredUsername" 
            name="preferredUsername" 
            value="<%= user.profile?.preferred_username || '' %>" 
            placeholder="Enter a username"
            maxlength="50"
          >
          <div class="form-hint">A unique username for display purposes.</div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="saveBtn">
            <span id="btnText">Save Changes</span>
            <span id="btnSpinner" style="display:none;">Saving...</span>
          </button>
          <a href="/" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>

    <div class="card">
      <h3 style="font-size: 18px; margin-bottom: 16px;">Account Information</h3>
      <div style="display: grid; gap: 12px;">
        <div>
          <div style="font-size: 13px; color: var(--muted);">Account ID</div>
          <div style="font-size: 14px; color: var(--text); font-family: monospace;"><%= user.sub %></div>
        </div>
        <div>
          <div style="font-size: 13px; color: var(--muted);">Member Since</div>
          <div style="font-size: 14px; color: var(--text);"><%= new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
        </div>
        <div>
          <div style="font-size: 13px; color: var(--muted);">Email Verified</div>
          <div style="font-size: 14px; color: <%= user.emailVerified ? 'var(--success)' : 'var(--error)' %>;">
            <%= user.emailVerified ? '✓ Verified' : '✗ Not Verified' %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('profileForm');
    const saveBtn = document.getElementById('saveBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    const alertSuccess = document.getElementById('alertSuccess');
    const alertError = document.getElementById('alertError');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Hide previous alerts
      alertSuccess.classList.remove('show');
      alertError.classList.remove('show');

      // Disable button and show loading
      saveBtn.disabled = true;
      btnText.style.display = 'none';
      btnSpinner.style.display = 'inline';

      const formData = {
        name: document.getElementById('name').value.trim(),
        preferredUsername: document.getElementById('preferredUsername').value.trim() || null
      };

      try {
        const response = await fetch('/api/profile', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (response.ok) {
          alertSuccess.textContent = data.message || 'Profile updated successfully!';
          alertSuccess.classList.add('show');
          
          // Update avatar if name changed
          if (formData.name) {
            const avatar = document.querySelector('.avatar');
            avatar.textContent = formData.name[0].toUpperCase();
            
            const avatarName = document.querySelector('.avatar-info h3');
            avatarName.textContent = formData.name;
          }

          // Scroll to top to show success message
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          alertError.textContent = data.error || 'Failed to update profile';
          alertError.classList.add('show');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      } catch (error) {
        console.error('Profile update error:', error);
        alertError.textContent = 'An error occurred while updating your profile';
        alertError.classList.add('show');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } finally {
        // Re-enable button
        saveBtn.disabled = false;
        btnText.style.display = 'inline';
        btnSpinner.style.display = 'none';
      }
    });
  </script>
</body>

</html>
