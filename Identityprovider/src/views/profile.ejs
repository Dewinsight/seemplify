<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>My Profile - Seemplify</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        <%- include('../public/css/idp-theme.css') %>
    </style>
    <link rel="stylesheet" href="/css/main.css?v=3">
    <link rel="stylesheet" href="/css/profile-dashboard.css?v=2">
    <script src="/js/theme.js?v=3"></script>
</head>

<body class="idp-workspace-page">
    <%- include('partials/nav', { activePage: 'profile' }) %>

        <div class="container">
            <div class="header">
                <div>
                    <h1>My Profile</h1>
                    <div class="header-subtitle">
                        Your personal HR dashboard and information
                    </div>
                </div>
            </div>

            <!-- Profile Navigation Tabs -->
            <div class="profile-nav">
                <a href="/profile" class="active">Dashboard</a>
                <a href="/profile/personal">Personal Info</a>
            </div>

            <!-- Personal Info Summary -->
            <div class="card personal-summary">
                <div class="avatar-section">
                    <div class="avatar">
                        <%= (user.profile?.name || user.email)[0].toUpperCase() %>
                    </div>
                    <div class="avatar-info">
                        <h3>
                            <%= user.profile?.name || 'No name set' %>
                        </h3>
                        <p>
                            <%= user.email %>
                        </p>
                        <% if (user.profile?.personalInfo?.phoneNumbers?.mobile) { %>
                            <p style="font-size: 14px; color: var(--muted);">📱 <%=
                                    user.profile.personalInfo.phoneNumbers.mobile %>
                            </p>
                            <% } %>
                    </div>
                </div>
                <a href="/profile/personal" class="edit-profile-link">✏️ Edit Personal Info</a>
            </div>

            <!-- HR Dashboard Widgets -->
            <div class="dashboard-widgets">

                <!-- Leave Balance Widget -->
                <div class="widget-card">
                    <div class="widget-header">
                        <h3>Leave Balance</h3>
                        <span class="widget-icon">🏖️</span>
                    </div>
                    <div class="widget-body loading" id="leaveWidget">
                        <div class="spinner">Loading...</div>
                    </div>
                    <div class="widget-footer">
                        <a href="<%= process.env.LEAVE_MANAGEMENT_URL %>/request" target="_blank">
                            Request Time Off
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Payroll Widget -->
                <div class="widget-card">
                    <div class="widget-header">
                        <h3>Payroll</h3>
                        <span class="widget-icon">💰</span>
                    </div>
                    <div class="widget-body loading" id="payrollWidget">
                        <div class="spinner">Loading...</div>
                    </div>
                    <div class="widget-footer">
                        <a href="<%= process.env.PAYROLL_MANAGEMENT_URL %>/payslips" target="_blank">
                            View All Payslips
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Performance Widget -->
                <div class="widget-card">
                    <div class="widget-header">
                        <h3>Performance</h3>
                        <span class="widget-icon">🎯</span>
                    </div>
                    <div class="widget-body loading" id="performanceWidget">
                        <div class="spinner">Loading...</div>
                    </div>
                    <div class="widget-footer">
                        <a href="<%= process.env.PERFORMANCE_MANAGEMENT_URL %>/goals" target="_blank">
                            Manage Goals
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Time Tracking Widget -->
                <div class="widget-card">
                    <div class="widget-header">
                        <h3>Time Tracking</h3>
                        <span class="widget-icon">⏰</span>
                    </div>
                    <div class="widget-body loading" id="timeWidget">
                        <div class="spinner">Loading...</div>
                    </div>
                    <div class="widget-footer">
                        <a href="<%= process.env.TIME_ATTENDANCE_URL || 'https://time.seemplifyai.com' %>/timesheets" target="_blank">
                            View Timesheets
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Learning Widget -->
                <div class="widget-card">
                    <div class="widget-header">
                        <h3>Learning</h3>
                        <span class="widget-icon">📚</span>
                    </div>
                    <div class="widget-body loading" id="learningWidget">
                        <div class="spinner">Loading...</div>
                    </div>
                    <div class="widget-footer">
                        <a href="<%= process.env.SIMPLE_LMS_URL || '/simple-lms' %>">
                            Open Simple LMS
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Account Information (kept from original) -->
            <div class="card">
                <h3 style="font-size: 18px; margin-bottom: 16px;">Account Information</h3>
                <div style="display: grid; gap: 12px;">
                    <div>
                        <div style="font-size: 13px; color: var(--muted);">Account ID</div>
                        <div style="font-size: 14px; color: var(--text); font-family: monospace;">
                            <%= user.sub %>
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 13px; color: var(--muted);">Member Since</div>
                        <div style="font-size: 14px; color: var(--text);">
                            <%= new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                                day: 'numeric' }) %>
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 13px; color: var(--muted);">Email Verified</div>
                        <div
                            style="font-size: 14px; color: <%= user.emailVerified ? 'var(--success)' : 'var(--error)' %>;">
                            <%= user.emailVerified ? '✓ Verified' : '✗ Not Verified' %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // Fetch dashboard data on page load
            async function loadDashboardData() {
                try {
                    const response = await fetch('/api/profile/dashboard');
                    const result = await response.json();

                    if (result.success) {
                        populateWidgets(result.data);
                    } else {
                        showError('Failed to load dashboard data');
                    }
                } catch (error) {
                    console.error('Failed to load dashboard:', error);
                    showError('Unable to connect to dashboard');
                }
            }

            function populateWidgets(data) {
                // Populate leave widget
                const leaveWidget = document.getElementById('leaveWidget');
                if (data.leave && data.availability.leave) {
                    leaveWidget.className = 'widget-body';
                    leaveWidget.innerHTML = `
          <div class="stat-row">
            <span>Annual Leave:</span>
            <strong>${data.leave.annual || 0} days</strong>
          </div>
          <div class="stat-row">
            <span>Sick Leave:</span>
            <strong>${data.leave.sick || 0} days</strong>
          </div>
          ${data.leave.upcoming && data.leave.upcoming.length > 0 ? `
            <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); font-size: 13px; color: var(--muted);">
              <strong>Upcoming:</strong> ${formatDate(data.leave.upcoming[0].startDate)} - ${formatDate(data.leave.upcoming[0].endDate)}
            </div>
          ` : ''}
        `;
                } else {
                    leaveWidget.className = 'widget-body';
                    leaveWidget.innerHTML = '<div class="widget-empty">No leave data available</div>';
                }

                // Populate payroll widget
                const payrollWidget = document.getElementById('payrollWidget');
                if (data.payroll && data.availability.payroll) {
                    payrollWidget.className = 'widget-body';
                    payrollWidget.innerHTML = `
          <div class="stat-row">
            <span>Latest Payslip:</span>
            <strong>$${(data.payroll.latestPayslip?.netPay || 0).toLocaleString()}</strong>
          </div>
          <div class="stat-row">
            <span>YTD Earnings:</span>
            <strong>$${(data.payroll.ytd?.gross || 0).toLocaleString()}</strong>
          </div>
          ${data.payroll.latestPayslip?.month ? `
            <div style="margin-top: 12px; font-size: 13px; color: var(--muted);">
              ${data.payroll.latestPayslip.month}
            </div>
          ` : ''}
        `;
                } else {
                    payrollWidget.className = 'widget-body';
                    payrollWidget.innerHTML = '<div class="widget-empty">No payroll data available</div>';
                }

                // Populate performance widget
                const performanceWidget = document.getElementById('performanceWidget');
                if (data.performance && data.availability.performance) {
                    performanceWidget.className = 'widget-body';
                    performanceWidget.innerHTML = `
          <div class="stat-row">
            <span>Active Goals:</span>
            <strong>${data.performance.activeGoals || 0}</strong>
          </div>
          <div class="stat-row">
            <span>Completed Goals:</span>
            <strong>${data.performance.completedGoals || 0}</strong>
          </div>
          ${data.performance.recentFeedback && data.performance.recentFeedback.length > 0 ? `
            <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); font-size: 13px; color: var(--muted);">
              <strong>Recent feedback:</strong> "${data.performance.recentFeedback[0].snippet}"
            </div>
          ` : ''}
        `;
                } else {
                    performanceWidget.className = 'widget-body';
                    performanceWidget.innerHTML = '<div class="widget-empty">No performance data available</div>';
                }

                // Populate time tracking widget
                const timeWidget = document.getElementById('timeWidget');
                if (data.time && data.availability.time) {
                    timeWidget.className = 'widget-body';
                    const status = data.time.status === 'in' ? '🟢 Clocked In' : '⚪ Clocked Out';
                    timeWidget.innerHTML = `
          <div class="stat-row">
            <span>This Week:</span>
            <strong>${data.time.currentWeekHours || 0} hours</strong>
          </div>
          <div class="stat-row">
            <span>Status:</span>
            <strong>${status}</strong>
          </div>
          ${data.time.lastPunch ? `
            <div style="margin-top: 12px; font-size: 13px; color: var(--muted);">
              Last punch: ${formatTime(data.time.lastPunch)}
            </div>
          ` : ''}
        `;
                } else {
                    timeWidget.className = 'widget-body';
                    timeWidget.innerHTML = '<div class="widget-empty">No time tracking data available</div>';
                }

                // Populate learning widget
                const learningWidget = document.getElementById('learningWidget');
                if (data.learning && data.availability.learning) {
                    learningWidget.className = 'widget-body';
                    learningWidget.innerHTML = `
          <div class="stat-row">
            <span>Assigned Courses:</span>
            <strong>${data.learning.assignedCourses || 0}</strong>
          </div>
          <div class="stat-row">
            <span>In Progress:</span>
            <strong>${data.learning.inProgress || 0}</strong>
          </div>
          ${data.learning.courses && data.learning.courses.length > 0 ? `
            <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); font-size: 13px;">
              <strong>${data.learning.courses[0].title}</strong><br>
              <div style="margin-top: 4px; color: var(--muted);">${data.learning.courses[0].progress}% complete</div>
            </div>
          ` : ''}
        `;
                } else {
                    learningWidget.className = 'widget-body';
                    learningWidget.innerHTML = '<div class="widget-empty">No learning data available</div>';
                }
            }

            function showError(message) {
                // Show error state in all widgets
                const widgets = ['leaveWidget', 'payrollWidget', 'performanceWidget', 'timeWidget', 'learningWidget'];
                widgets.forEach(id => {
                    const widget = document.getElementById(id);
                    widget.className = 'widget-body error';
                    widget.innerHTML = `<div>${message}</div>`;
                });
            }

            function formatDate(dateString) {
                const date = new Date(dateString);
                return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            }

            function formatTime(dateString) {
                const date = new Date(dateString);
                return date.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
            }

            // Load data on page load
            document.addEventListener('DOMContentLoaded', loadDashboardData);
        </script>

        <!-- Invitation Gatekeeper -->
        <script src="/js/invitation-gatekeeper.js"></script>
</body>

</html>
