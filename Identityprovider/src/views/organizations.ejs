<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Organizations - AIIN Identity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
</head>

<body>
  <!-- Top Navigation -->
  <nav class="top-nav">
    <a href="https://seemplifyai.com" class="top-nav-brand">
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <linearGradient id="seemplifyNavGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#3b82f6" />
            <stop offset="50%" stop-color="#8b5cf6" />
            <stop offset="100%" stop-color="#ec4899" />
          </linearGradient>
        </defs>
        <path d="M 65 25 Q 75 25 75 35 Q 75 45 65 45 Q 50 50 35 55 Q 25 55 25 65 Q 25 75 35 75"
          stroke="url(#seemplifyNavGradient)" stroke-width="8" fill="none" stroke-linecap="round"
          stroke-linejoin="round" />
        <circle cx="65" cy="25" r="6" fill="#fff" />
        <circle cx="50" cy="50" r="6" fill="#fff" />
        <circle cx="35" cy="75" r="6" fill="#fff" />
      </svg>
      <span>Seemplify</span>
    </a>
    <div class="top-nav-links">
      <a href="/" class="top-nav-link">Home</a>
      <a href="/organizations" class="top-nav-link active">Organizations</a>
      <a href="/invitations/pending" class="top-nav-link">My Invitations</a>
      <a href="/profile" class="top-nav-link">Profile</a>
      <a href="/logout" class="top-nav-link">Logout</a>
    </div>
    <div class="top-nav-user">
      <div class="top-nav-user-info">
        <div class="top-nav-user-name">
          <%= user.profile?.firstName || user.profile?.name || user.email.split('@')[0] %>
        </div>
        <div class="top-nav-user-email">
          <%= user.email %>
        </div>
      </div>
      <a href="/logout" class="top-nav-logout">Logout</a>
    </div>
  </nav>

  <div class="container">

    <div class="header">
      <h1>Organizations</h1>
      <div class="header-actions">
        <% if (typeof pendingInvitationsCount !=='undefined' && pendingInvitationsCount> 0) { %>
          <div class="notification-badge">
            <div class="notification-icon" onclick="showInvitationsPopup()"
              title="You have <%= pendingInvitationsCount %> pending invitation<%= pendingInvitationsCount !== 1 ? 's' : '' %>">
              🔔
              <span class="badge-count">
                <%= pendingInvitationsCount %>
              </span>
            </div>
          </div>
          <% } %>
            <a href="/invitations/pending" class="btn btn-secondary">
              📧 My Invitations<% if (typeof pendingInvitationsCount !=='undefined' && pendingInvitationsCount> 0) { %>
                (<%= pendingInvitationsCount %>)<% } %>
            </a>
            <button class="btn btn-primary" onclick="showCreateModal()">
              + Create Organization
            </button>
      </div>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
      <% } %>

        <% if (typeof success !=='undefined' && success) { %>
          <div class="alert alert-success">
            <%= success %>
          </div>
          <% } %>

            <% if (organizations && organizations.length> 0) { %>
              <% organizations.forEach(org=> { %>
                <div class="card org-card">
                  <div class="org-info">
                    <div class="org-name">
                      <%= org.name %>
                        <% if (org.isCurrentOrganization) { %>
                          <span class="current-badge">Current</span>
                          <% } %>
                    </div>
                    <% if (org.description) { %>
                      <div class="org-description">
                        <%= org.description %>
                      </div>
                      <% } %>
                        <div class="org-meta">
                          <span class="role-badge role-<%= org.role %>">
                            <%= org.role %>
                          </span>
                          <span>
                            <%= org.memberCount %> member<%= org.memberCount !==1 ? 's' : '' %>
                          </span>
                        </div>
                  </div>
                  <div class="org-actions">
                    <% if (!org.isCurrentOrganization) { %>
                      <form action="/organizations/<%= org.id %>/switch" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-secondary">Switch</button>
                      </form>
                      <% } %>
                        <a href="/organizations/<%= org.id %>/members" class="btn btn-secondary">Members</a>
                        <a href="/organizations/<%= org.id %>/teams" class="btn btn-secondary">Teams</a>
                        <% if (['owner', 'admin' ].includes(org.role)) { %>
                          <a href="/organizations/<%= org.id %>/invitations" class="btn btn-secondary">Invitations</a>
                          <% } %>
                            <% if (org.role==='owner' ) { %>
                              <button class="btn btn-danger"
                                onclick="deleteOrganization('<%= org.id %>', '<%= org.name.replace(/'/g, " \\'") %>')">
                                🗑️ Delete
                              </button>
                              <% } %>
                  </div>
                </div>
                <% }) %>
                  <% } else { %>
                    <div class="card empty-state">
                      <h3>No organizations yet</h3>
                      <p>Create your first organization to get started.</p>
                      <button class="btn btn-primary" onclick="showCreateModal()">
                        + Create Organization
                      </button>
                    </div>
                    <% } %>
  </div>

  <!-- Pending Invitations Popup -->
  <div class="modal" id="invitationsPopup">
    <div class="modal-content" style="max-width: 600px;">
      <div class="modal-header">
        <h2>📧 You have pending invitations!</h2>
        <button class="modal-close" onclick="hideInvitationsPopup()">&times;</button>
      </div>
      <div id="invitationsList" style="max-height: 400px; overflow-y: auto;">
        <div style="text-align: center; padding: 20px;">
          <div class="spinner"
            style="border: 3px solid var(--line); border-top: 3px solid var(--brand); border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto;">
          </div>
          <p style="margin-top: 12px; color: var(--muted);">Loading invitations...</p>
        </div>
      </div>
      <div class="form-actions">
        <button type="button" class="btn btn-secondary" onclick="hideInvitationsPopup()">Close</button>
        <a href="/invitations/pending" class="btn btn-primary">View All Invitations</a>
      </div>
    </div>
  </div>

  <!-- Create Organization Modal -->
  <div class="modal" id="createModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Create Organization</h2>
        <button class="modal-close" onclick="hideCreateModal()">&times;</button>
      </div>
      <form action="/api/organizations" method="POST" id="createForm">
        <div class="form-group">
          <label for="name">Organization Name *</label>
          <input type="text" id="name" name="name" required maxlength="100" placeholder="Enter organization name">
        </div>
        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" maxlength="500"
            placeholder="Brief description (optional)"></textarea>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-secondary" onclick="hideCreateModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Create</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Track if we've already shown the popup this session
    const pendingInvitationsCount = <%= typeof pendingInvitationsCount !== 'undefined' ? pendingInvitationsCount : 0 %>;
    const popupShownKey = 'invitationsPopupShown_' + new Date().toDateString();

    function showCreateModal() {
      document.getElementById('createModal').classList.add('active');
    }

    function hideCreateModal() {
      document.getElementById('createModal').classList.remove('active');
    }

    function showInvitationsPopup() {
      document.getElementById('invitationsPopup').classList.add('active');
      loadInvitations();
      // Mark as shown for today
      sessionStorage.setItem(popupShownKey, 'true');
    }

    function hideInvitationsPopup() {
      document.getElementById('invitationsPopup').classList.remove('active');
    }

    async function loadInvitations() {
      const listContainer = document.getElementById('invitationsList');

      try {
        const response = await fetch('/api/invitations/pending');
        if (!response.ok) throw new Error('Failed to load invitations');

        const invitations = await response.json();

        if (invitations.length === 0) {
          listContainer.innerHTML = `
            <div style="text-align: center; padding: 40px 20px;">
              <div style="font-size: 48px; margin-bottom: 12px;">✨</div>
              <h3 style="color: var(--text); margin-bottom: 8px;">All caught up!</h3>
              <p style="color: var(--muted);">You don't have any pending invitations.</p>
            </div>
          `;
          return;
        }

        listContainer.innerHTML = invitations.map(invite => `
          <div class="card" style="margin-bottom: 12px; padding: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;">
              <div style="flex: 1;">
                <div style="font-size: 16px; font-weight: 600; color: var(--text); margin-bottom: 4px;">
                  ${invite.organization.name}
                </div>
                ${invite.organization.description ? `<div style="color: var(--muted); font-size: 14px; margin-bottom: 8px;">${invite.organization.description}</div>` : ''}
                <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                  <span class="role-badge role-${invite.role}">${invite.role}</span>
                  <span style="color: var(--muted); font-size: 13px;">
                    Invited by ${invite.invitedBy?.name || invite.invitedBy?.email || 'Unknown'}
                  </span>
                  <span style="color: var(--muted); font-size: 13px;">
                    Expires ${new Date(invite.expiresAt).toLocaleDateString()}
                  </span>
                </div>
              </div>
              <div style="display: flex; gap: 8px; flex-shrink: 0;">
                <button class="btn btn-primary btn-sm" onclick="acceptInvite('${invite.id}')">
                  Accept
                </button>
                <button class="btn btn-secondary btn-sm" onclick="declineInvite('${invite.id}')">
                  Decline
                </button>
              </div>
            </div>
          </div>
        `).join('');
      } catch (error) {
        console.error('Error loading invitations:', error);
        listContainer.innerHTML = `
          <div style="text-align: center; padding: 20px; color: var(--error);">
            Failed to load invitations. Please try again.
          </div>
        `;
      }
    }

    async function acceptInvite(inviteId) {
      try {
        const response = await fetch(`/api/invitations/accept/${inviteId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        if (response.ok) {
          const data = await response.json();
          // Redirect to the organization's members page
          window.location.href = `/organizations/${data.organization.id}/members?success=Welcome to ${encodeURIComponent(data.organization.name)}!`;
        } else {
          const error = await response.json();
          alert(error.error || 'Failed to accept invitation');
        }
      } catch (error) {
        console.error('Error accepting invitation:', error);
        alert('Failed to accept invitation');
      }
    }

    async function declineInvite(inviteId) {
      if (!confirm('Are you sure you want to decline this invitation?')) return;

      try {
        const response = await fetch(`/api/invitations/${inviteId}/reject`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        if (response.ok) {
          // Reload invitations
          loadInvitations();
        } else {
          const error = await response.json();
          alert(error.error || 'Failed to decline invitation');
        }
      } catch (error) {
        console.error('Error declining invitation:', error);
        alert('Failed to decline invitation');
      }
    }

    // Delete organization function
    async function deleteOrganization(orgId, orgName) {
      if (!confirm(`Delete organization "${orgName}"? This action cannot be undone and will remove all members.`)) return;

      try {
        const response = await fetch(`/api/organizations/${orgId}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to delete organization');
        }
      } catch (error) {
        console.error('Delete organization error:', error);
        alert('Failed to delete organization');
      }
    }

    // Handle form submission
    document.getElementById('createForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);

      try {
        const response = await fetch('/api/organizations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: formData.get('name'),
            description: formData.get('description')
          })
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to create organization');
        }
      } catch (error) {
        alert('Failed to create organization');
      }
    });

    // Close modal on outside click
    document.getElementById('createModal').addEventListener('click', (e) => {
      if (e.target.classList.contains('modal')) {
        hideCreateModal();
      }
    });

    // Close invitations popup on outside click
    document.getElementById('invitationsPopup').addEventListener('click', (e) => {
      if (e.target.classList.contains('modal')) {
        hideInvitationsPopup();
      }
    });

    // Auto-show invitations popup if there are pending invitations and we haven't shown it today
    document.addEventListener('DOMContentLoaded', () => {
      if (pendingInvitationsCount > 0 && !sessionStorage.getItem(popupShownKey)) {
        // Small delay to let the page render first
        setTimeout(() => {
          showInvitationsPopup();
        }, 500);
      }
    });
  </script>
</body>

</html>
