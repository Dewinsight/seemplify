<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Notifications - Seemplify</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
  <style>
    .notifications-shell {
      display: grid;
      gap: 14px;
    }

    .notifications-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      border-color: rgba(99, 102, 241, 0.35);
    }

    .notifications-summary-count {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text);
      line-height: 1;
    }

    .notifications-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .notifications-filter-chip {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 8px 12px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .notifications-filter-chip:hover {
      color: var(--text);
      background: var(--hover-bg);
      border-color: rgba(255, 255, 255, 0.18);
    }

    .notifications-filter-chip.active {
      color: var(--text);
      background: var(--panel-strong);
      border-color: rgba(99, 102, 241, 0.45);
    }

    .notification-task-list {
      display: grid;
      gap: 12px;
    }

    .notification-task {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--panel);
      padding: 14px;
      display: grid;
      gap: 10px;
    }

    .notification-task-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .notification-task-title {
      margin: 0;
      font-size: 16px;
      color: var(--text);
      font-weight: 700;
    }

    .notification-task-meta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      font-size: 12px;
      color: var(--muted);
    }

    .notification-task-badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .notification-task-badge.documents {
      background: rgba(14, 165, 233, 0.15);
      color: #0284c7;
    }

    .notification-task-badge.simplePerformance {
      background: rgba(34, 197, 94, 0.15);
      color: #16a34a;
    }

    .notification-task-message {
      margin: 0;
      color: var(--text-secondary);
      font-size: 14px;
      line-height: 1.4;
    }

    .notification-task-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    @media (max-width: 720px) {
      .notifications-summary-count {
        font-size: 24px;
      }
    }
  </style>
</head>

<body>
  <%- include('partials/nav', { activePage: 'notifications' }) %>

  <div class="container notifications-shell">
    <a href="/" class="back-link">&larr; Back to Hub</a>

    <div class="header" style="margin-bottom: 0;">
      <div>
        <h1 style="margin-bottom: 4px;">Notifications</h1>
        <div class="header-subtitle">Track all pending tasks across documents and evaluations.</div>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="card notifications-summary">
      <div>
        <div class="notifications-summary-count"><%= notificationSummary?.totalUnread || 0 %></div>
        <div style="color: var(--muted); font-size: 13px; margin-top: 4px;">Pending notification task<%= (notificationSummary?.totalUnread || 0) === 1 ? '' : 's' %></div>
      </div>
      <div style="display:flex; gap: 8px; flex-wrap: wrap;">
        <span class="pill pill--soft">Documents: <%= notificationSummary?.counts?.documents || 0 %></span>
        <span class="pill pill--soft">Simple Evaluation: <%= notificationSummary?.counts?.simplePerformance || 0 %></span>
      </div>
    </div>

    <div class="notifications-filters">
      <a href="/notifications" class="notifications-filter-chip<%= selectedCategory === 'all' ? ' active' : '' %>">All</a>
      <a href="/notifications?category=documents" class="notifications-filter-chip<%= selectedCategory === 'documents' ? ' active' : '' %>">Documents</a>
      <a href="/notifications?category=simplePerformance" class="notifications-filter-chip<%= selectedCategory === 'simplePerformance' ? ' active' : '' %>">Simple Evaluation</a>
    </div>

    <% if (!tasks || tasks.length === 0) { %>
      <div class="empty-state">
        <h3>No pending notifications in this view</h3>
        <p>Everything is up to date for this category.</p>
      </div>
    <% } else { %>
      <div class="notification-task-list">
        <% tasks.forEach(task => { %>
          <% const taskDate = new Date(task.createdAt || Date.now()); %>
          <article class="notification-task">
            <div class="notification-task-header">
              <h2 class="notification-task-title"><%= task.title %></h2>
              <span class="notification-task-badge <%= task.category %>">
                <%= task.category === 'documents' ? 'Document' : 'Evaluation' %>
              </span>
            </div>
            <p class="notification-task-message"><%= task.message %></p>
            <div class="notification-task-footer">
              <div class="notification-task-meta">
                <span><%= task.organizationName || 'Organization' %></span>
                <span>•</span>
                <span><%= taskDate.toLocaleString() %></span>
              </div>
              <a class="btn btn-primary btn-sm" href="<%= task.actionUrl %>"><%= task.actionLabel || 'Open' %></a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>

  <script src="/js/invitation-gatekeeper.js"></script>
</body>

</html>
