<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Notifications - Seemplify</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=3"></script>
  <style>
    .notifications-shell {
      display: grid;
      gap: 14px;
    }

    .notifications-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      border-color: rgba(99, 102, 241, 0.35);
    }

    .notifications-summary-count {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text);
      line-height: 1;
    }

    .notifications-summary-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .notification-task-list {
      display: grid;
      gap: 12px;
    }

    .notification-task {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--panel);
      padding: 14px;
      display: grid;
      gap: 10px;
    }

    .notification-task-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .notification-task-title {
      margin: 0;
      font-size: 16px;
      color: var(--text);
      font-weight: 700;
    }

    .notification-task-meta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      font-size: 12px;
      color: var(--muted);
    }

    .notification-task-badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .notification-task-badge.simplePerformance {
      background: rgba(34, 197, 94, 0.15);
      color: #16a34a;
    }

    .notification-task-message {
      margin: 0;
      color: var(--text-secondary);
      font-size: 14px;
      line-height: 1.4;
    }

    .notification-task-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .notification-task-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    @media (max-width: 720px) {
      .notifications-summary-count {
        font-size: 24px;
      }
    }
  </style>
</head>

<body>
  <%- include('partials/nav', { activePage: 'notifications' }) %>
  <% const remainingNotificationCount = Math.max(0, Number(notificationSummary?.counts?.simplePerformance || 0)); %>
  <% const visibleTasks = Array.isArray(notificationSummary?.tasks)
    ? notificationSummary.tasks.filter(task => task?.category === 'simplePerformance')
    : []; %>

  <div class="container notifications-shell">
    <a href="/" class="back-link">&larr; Back to Hub</a>

    <div class="header" style="margin-bottom: 0;">
      <div>
        <h1 style="margin-bottom: 4px;">Notifications</h1>
        <div class="header-subtitle">Review performance feedback that still needs your attention.</div>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="card notifications-summary">
      <div>
        <div class="notifications-summary-count"><%= remainingNotificationCount %></div>
        <div style="color: var(--muted); font-size: 13px; margin-top: 4px;">Unread performance update<%= remainingNotificationCount === 1 ? '' : 's' %></div>
      </div>
      <div class="notifications-summary-actions">
        <span class="pill pill--soft">Performance feedback: <%= remainingNotificationCount %></span>
        <% if (remainingNotificationCount > 0) { %>
          <button class="btn btn-secondary btn-sm" type="button" data-mark-all-read>
            Mark All as Read
          </button>
        <% } %>
      </div>
    </div>

    <% if (visibleTasks.length === 0) { %>
      <div class="empty-state">
        <h3>No unread performance feedback</h3>
        <p>You are up to date.</p>
      </div>
    <% } else { %>
      <div class="notification-task-list">
        <% visibleTasks.forEach(task => { %>
          <% const taskDate = new Date(task.createdAt || Date.now()); %>
          <article class="notification-task">
            <div class="notification-task-header">
              <h2 class="notification-task-title"><%= task.title %></h2>
              <span class="notification-task-badge simplePerformance">Evaluation</span>
            </div>
            <p class="notification-task-message"><%= task.message %></p>
            <div class="notification-task-footer">
              <div class="notification-task-meta">
                <span><%= task.organizationName || 'Organization' %></span>
                <span>•</span>
                <span><%= taskDate.toLocaleString() %></span>
              </div>
              <div class="notification-task-actions">
                <button
                  class="btn btn-secondary btn-sm"
                  type="button"
                  data-mark-read
                  data-task-id="<%= task.id %>"
                  data-category="<%= task.category %>"
                  data-org-id="<%= task.organizationId || '' %>"
                >
                  Mark as Read
                </button>
                <a class="btn btn-primary btn-sm" href="<%= task.actionUrl %>"><%= task.actionLabel || 'Open' %></a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>

  <script>
    const selectedNotificationCategory = 'simplePerformance';

    async function postNotificationAction(url, payload) {
      const response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload || {})
      });

      if (!response.ok) {
        let message = 'Request failed';
        try {
          const data = await response.json();
          if (data?.error) message = data.error;
        } catch (error) {}
        throw new Error(message);
      }

      return response.json().catch(() => ({}));
    }

    function refreshWithMessage(message, isError = false) {
      const url = new URL(window.location.href);
      if (message) {
        url.searchParams.set(isError ? 'error' : 'success', message);
      }
      if (!isError) {
        url.searchParams.delete('error');
      } else {
        url.searchParams.delete('success');
      }
      window.location.assign(url.toString());
    }

    document.querySelectorAll('[data-mark-read]').forEach(button => {
      button.addEventListener('click', async () => {
        const taskId = button.dataset.taskId || '';
        const category = button.dataset.category || '';
        const organizationId = button.dataset.orgId || '';
        if (!taskId || !category) return;

        button.disabled = true;
        try {
          await postNotificationAction('/api/notifications/read', {
            taskId,
            category,
            organizationId
          });
          refreshWithMessage('Notification marked as read.');
        } catch (error) {
          button.disabled = false;
          refreshWithMessage(error.message || 'Failed to mark notification as read.', true);
        }
      });
    });

    const markAllButton = document.querySelector('[data-mark-all-read]');
    markAllButton?.addEventListener('click', async () => {
      markAllButton.disabled = true;
      try {
        const result = await postNotificationAction('/api/notifications/read-all', {
          category: selectedNotificationCategory
        });
        const count = Number(result?.markedCount || 0);
        const successLabel = count === 1
          ? '1 notification marked as read.'
          : `${count} notifications marked as read.`;
        refreshWithMessage(successLabel);
      } catch (error) {
        markAllButton.disabled = false;
        refreshWithMessage(error.message || 'Failed to mark notifications as read.', true);
      }
    });
  </script>

  <script src="/js/invitation-gatekeeper.js"></script>
</body>

</html>

