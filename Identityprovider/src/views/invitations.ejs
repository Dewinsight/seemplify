<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Invitations - <%= organization.name %> - AIIN Identity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
    .access-badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      background: rgba(56, 189, 248, 0.16);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.28);
    }
    .app-access-mode-option {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 10px 12px;
      background: rgba(255, 255, 255, 0.02);
      cursor: pointer;
    }
    .app-access-selector {
      margin-top: 10px;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 12px;
      background: rgba(255, 255, 255, 0.02);
    }
    .app-access-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }
    .app-access-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 8px;
    }
    .app-access-item {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 8px 10px;
      background: rgba(15, 23, 42, 0.45);
    }
    .app-name {
      font-weight: 600;
      font-size: 13px;
    }
    .field-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 6px;
    }
    .field-toolbar label {
      margin-bottom: 0;
    }
    .field-help {
      margin-top: 6px;
      font-size: 12px;
      color: var(--muted);
    }
    .field-help.field-help-warning {
      color: #f59e0b;
    }
    .inline-create-panel {
      margin-top: 10px;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.03);
      display: none;
    }
    .inline-create-panel.active {
      display: block;
    }
    .inline-create-panel-title {
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 10px;
    }
    .inline-create-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 10px;
    }
    .inline-create-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 12px;
    }
    .invite-modal-content {
      width: min(820px, 100%);
    }
    .recipient-input-help {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 8px;
    }
    .recipient-input-help .field-help {
      margin-top: 0;
    }
    .recipient-feedback {
      display: none;
      margin-top: 10px;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: 9px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.45;
    }
    .recipient-feedback.active {
      display: block;
    }
    .recipient-feedback.error {
      border-color: color-mix(in srgb, var(--error) 55%, var(--line));
      background: color-mix(in srgb, var(--error) 9%, transparent);
      color: var(--error);
    }
    .recipient-feedback.success {
      border-color: color-mix(in srgb, var(--success) 55%, var(--line));
      background: color-mix(in srgb, var(--success) 9%, transparent);
      color: var(--text);
    }
    .recipient-review {
      margin-top: 12px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.02);
      overflow: hidden;
    }
    .recipient-review-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
    }
    .recipient-review-title {
      font-size: 14px;
      font-weight: 650;
      color: var(--text);
    }
    .recipient-review-title:focus {
      outline: none;
    }
    .recipient-review-summary {
      margin-top: 2px;
      color: var(--muted);
      font-size: 12px;
    }
    .recipient-review-actions,
    .recipient-row-actions {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .recipient-list {
      display: grid;
      gap: 10px;
      max-height: 520px;
      padding: 12px;
      overflow-y: auto;
    }
    .recipient-row {
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--panel-strong);
      overflow: hidden;
    }
    .recipient-row.invalid {
      border-color: color-mix(in srgb, var(--error) 60%, var(--line));
    }
    .recipient-summary {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      cursor: pointer;
      list-style: none;
    }
    .recipient-summary::-webkit-details-marker { display: none; }
    .recipient-index {
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border-radius: 999px;
      background: var(--input-bg);
      color: var(--muted);
      font-size: 12px;
      font-weight: 650;
    }
    .recipient-summary-email {
      overflow: hidden;
      color: var(--text);
      font-size: 13px;
      font-weight: 650;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .recipient-summary-meta {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      flex-wrap: wrap;
    }
    .recipient-summary-chip {
      padding: 4px 7px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--muted);
      font-size: 10px;
      line-height: 1;
    }
    .recipient-summary-chip.warning {
      border-color: color-mix(in srgb, #f59e0b 55%, var(--line));
      color: #f59e0b;
    }
    .recipient-chevron { color: var(--muted); transition: transform 0.15s ease; }
    .recipient-row[open] .recipient-chevron { transform: rotate(180deg); }
    .recipient-details {
      padding: 12px;
      border-top: 1px solid var(--line);
    }
    .recipient-fields-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .recipient-field.full { grid-column: 1 / -1; }
    .recipient-field label {
      margin-bottom: 4px;
      font-size: 11px;
    }
    .recipient-field input,
    .recipient-field select {
      min-height: 40px;
      padding: 9px 11px;
      font-size: 13px;
    }
    .recipient-field-error {
      display: none;
      margin-top: 4px;
      color: var(--error);
      font-size: 11px;
      line-height: 1.35;
    }
    .recipient-field-error.active {
      display: block;
    }
    .recipient-row-actions {
      justify-content: space-between;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--line);
    }
    .recipient-row-actions-group {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .recipient-inline-actions {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 6px;
      flex-wrap: wrap;
    }
    .recipient-app-access {
      display: grid;
      gap: 8px;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--input-bg);
    }
    .recipient-app-modes {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .recipient-app-modes label,
    .recipient-app-option {
      display: flex;
      align-items: center;
      gap: 7px;
      margin: 0;
      color: var(--text);
      font-size: 12px;
      font-weight: 500;
    }
    .recipient-app-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 7px;
    }
    .recipient-config-error {
      display: none;
      margin-top: 7px;
      color: var(--error);
      font-size: 11px;
    }
    .recipient-config-error.active { display: block; }
    .recipient-create-area {
      padding: 0 12px 12px;
    }
    .recipient-create-area .inline-create-panel { margin-top: 0; }
    .recipient-progress {
      color: var(--muted);
      font-size: 12px;
    }
    .recipient-action-button {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 7px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
    }
    .recipient-action-button:hover:not(:disabled) {
      border-color: var(--muted);
      background: var(--input-bg);
      color: var(--text);
    }
    .recipient-action-button:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }
    .recipient-action-button.remove:hover:not(:disabled) {
      border-color: var(--error);
      color: var(--error);
    }
    .recipient-send-status {
      min-height: 18px;
      margin-top: 4px;
      color: var(--muted);
      font-size: 11px;
    }
    .recipient-send-status.error {
      color: var(--error);
    }
    .recipient-send-status.success {
      color: var(--success);
    }
    .invite-source-tabs {
      display: flex;
      gap: 6px;
      margin-bottom: 12px;
      padding: 4px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--input-bg);
    }
    .invite-source-tab {
      flex: 1 1 0;
      padding: 8px 10px;
      border: 1px solid transparent;
      border-radius: 7px;
      background: transparent;
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }
    .invite-source-tab[aria-selected="true"] {
      border-color: var(--line);
      background: var(--panel-strong);
      color: var(--text);
    }
    .import-file-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .import-file-row input[type="file"] {
      flex: 1 1 240px;
      min-width: 0;
    }
    .import-template-links {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .import-panel {
      margin-top: 12px;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.02);
    }
    .import-panel-title {
      font-size: 13px;
      font-weight: 650;
      color: var(--text);
    }
    .import-mapping-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px;
      margin-top: 10px;
    }
    .import-mapping-field label {
      margin-bottom: 4px;
      font-size: 11px;
    }
    .import-mapping-field select {
      min-height: 40px;
      padding: 9px 11px;
      font-size: 13px;
    }
    .import-mapping-field .field-help {
      margin-top: 4px;
      font-size: 11px;
    }
    .import-preview-scroll {
      margin-top: 12px;
      overflow-x: auto;
      border: 1px solid var(--line);
      border-radius: 8px;
    }
    .import-preview-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    .import-preview-table th,
    .import-preview-table td {
      padding: 7px 10px;
      border-bottom: 1px solid var(--line);
      text-align: left;
      white-space: nowrap;
    }
    .import-preview-table th {
      color: var(--muted);
      font-weight: 600;
    }
    .import-preview-table tr:last-child td { border-bottom: none; }
    .import-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 12px;
      flex-wrap: wrap;
    }
    .import-skipped {
      margin: 12px 12px 0;
      padding: 10px 12px;
      border: 1px solid color-mix(in srgb, var(--error) 45%, var(--line));
      border-radius: 9px;
      background: color-mix(in srgb, var(--error) 7%, transparent);
      font-size: 12px;
    }
    .import-skipped ul {
      margin: 6px 0 0;
      padding-left: 18px;
      color: var(--muted);
      line-height: 1.5;
    }
    .recipient-issue-list {
      display: grid;
      gap: 4px;
      margin-bottom: 10px;
      padding: 9px 10px;
      border: 1px solid color-mix(in srgb, #f59e0b 45%, var(--line));
      border-radius: 8px;
      background: color-mix(in srgb, #f59e0b 8%, transparent);
      color: var(--text);
      font-size: 11px;
      line-height: 1.45;
    }
    .recipient-summary-name {
      color: var(--muted);
      font-size: 11px;
      font-weight: 500;
    }
    @media (max-width: 700px) {
      .recipient-input-help,
      .recipient-review-header {
        align-items: stretch;
        flex-direction: column;
      }
      .recipient-review-actions .btn {
        flex: 1 1 0;
      }
      .recipient-row {
        border-radius: 9px;
      }
      .recipient-summary {
        grid-template-columns: 28px minmax(0, 1fr) auto;
      }
      .recipient-summary-meta { grid-column: 2; justify-content: flex-start; }
      .recipient-chevron { grid-column: 3; grid-row: 1 / span 2; }
      .recipient-fields-grid,
      .recipient-app-grid { grid-template-columns: 1fr; }
      .recipient-row-actions { align-items: stretch; flex-direction: column; }
      .recipient-row-actions-group { flex-wrap: wrap; }
      .recipient-row-actions-group .btn { flex: 1 1 auto; }
      .invite-modal-content { width: 100%; }
      .recipient-list { max-height: none; }
      .recipient-summary-email { white-space: normal; overflow-wrap: anywhere; }
      .recipient-create-area {
        padding: 0 10px 10px;
      }
      .import-file-row,
      .import-actions { flex-direction: column; align-items: stretch; }
      .import-mapping-grid { grid-template-columns: 1fr; }
    }
  </style>
  <link rel="stylesheet" href="/css/main.css?v=4">
  <script src="/js/theme.js?v=3"></script>
  <script src="/js/invitation-recipient-parser.js?v=1"></script>
</head>
<body class="idp-workspace-page">
  <%- include('partials/nav', { activePage: 'organizations' }) %>

  <div class="container">
    <a href="/organizations" class="back-link">← Back to Organizations</a>

    <div class="header">
      <div>
        <h1>Pending Invitations</h1>
        <div class="header-subtitle"><%= organization.name %></div>
      </div>
      <div class="header-actions">
        <% if (canInviteMembers || canManageInvitations) { %><button class="btn btn-primary" onclick="showInviteModal()">+ Invite Member</button><% } %>
      </div>
    </div>

    <%- include('partials/organization-tabs', { organization, yourRole, activeSection: 'invitations', canViewMembers, canInviteMembers, canManageInvitations, canViewAccessControl }) %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <% if (invitations && invitations.length > 0) { %>
      <% invitations.forEach(invite => { %>
        <div class="card invite-card">
          <div class="invite-info">
            <div class="invite-email"><%= invite.email %></div>
            <div class="invite-meta">
              <span class="role-badge role-<%= invite.role %>"><%= invite.role %></span>
              <span>Designation: <%= invite.designation || 'Not set' %></span>
              <span>Employee ID: <%= invite.employeeId || 'Not set' %></span>
              <span class="access-badge"><%= invite.appAccessLabel || 'All apps' %></span>
              <span class="status-pending">Pending</span>
              <span>Department: <%= invite.departmentName || 'General' %></span>
              <span>Team: <%= invite.teamName || 'Not assigned' %></span>
              <span>Invited by <%= invite.invitedBy?.name || invite.invitedBy?.email || 'Unknown' %></span>
              <% if (invite.appAccess?.mode === 'selected' && invite.appAccessAppNames?.length) { %>
                <span>Apps: <%= invite.appAccessAppNames.join(', ') %></span>
              <% } %>
              <span>Expires <%= new Date(invite.expiresAt).toLocaleDateString() %></span>
            </div>
          </div>
          <% if (canManageInvitations || canInviteMembers) { %>
            <div class="invite-actions">
              <button class="btn btn-secondary btn-sm" onclick="resendInvite('<%= invite.id %>')">Resend</button>
              <button class="btn btn-danger btn-sm" onclick="cancelInvite('<%= invite.id %>', '<%= invite.email %>')">Cancel</button>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <div class="card empty-state">
        <h3>No pending invitations</h3>
        <p><%= (canInviteMembers || canManageInvitations) ? 'Invite members to join your organization.' : 'There are no pending invitations.' %></p>
        <% if (canInviteMembers || canManageInvitations) { %><button class="btn btn-primary" onclick="showInviteModal()">+ Invite Member</button><% } %>
      </div>
    <% } %>
  </div>

  <div class="modal" id="inviteModal">
    <div class="modal-content invite-modal-content" role="dialog" aria-modal="true" aria-labelledby="inviteModalTitle">
      <div class="modal-header">
        <h2 id="inviteModalTitle">Invite Members</h2>
        <button class="modal-close" type="button" aria-label="Close invitation dialog" onclick="hideInviteModal()">&times;</button>
      </div>
      <form id="inviteForm" novalidate>
        <div class="form-group">
          <div class="invite-source-tabs" role="tablist" aria-label="How to add recipients">
            <button type="button" class="invite-source-tab" role="tab" id="inviteSourceTabFile" aria-controls="inviteSourcePanelFile" aria-selected="true" data-invite-source="file">Upload CSV or Excel</button>
            <button type="button" class="invite-source-tab" role="tab" id="inviteSourceTabText" aria-controls="inviteSourcePanelText" aria-selected="false" data-invite-source="text">Paste emails</button>
          </div>

          <section id="inviteSourcePanelFile" role="tabpanel" aria-labelledby="inviteSourceTabFile" data-invite-source-panel="file">
            <label for="importFile">Bulk user creation file</label>
            <div class="import-file-row">
              <input type="file" id="importFile" accept=".csv,.xlsx,.xls,text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
              <div class="import-template-links">
                <a class="btn btn-secondary btn-sm" href="/api/organizations/<%= organization._id %>/member-imports/template?type=creation&amp;format=xlsx">Download Excel template</a>
                <a class="btn btn-secondary btn-sm" href="/api/organizations/<%= organization._id %>/member-imports/template?type=creation&amp;format=csv">CSV</a>
              </div>
            </div>
            <div class="field-help">Any column order works. After upload you confirm which column is which, then check every person before the invitations go out. Up to 50 people per upload, matching the hourly invitation limit.</div>

            <div class="import-panel" id="importMappingPanel" hidden>
              <div class="import-panel-title">Match your columns</div>
              <div class="field-help" id="importMappingSummary"></div>
              <div class="form-group" id="importSheetGroup" hidden style="margin-top: 10px;">
                <label for="importSheet">Worksheet</label>
                <select id="importSheet"></select>
              </div>
              <div class="import-mapping-grid" id="importMappingGrid"></div>
              <div class="import-preview-scroll" id="importPreviewScroll"></div>
              <div class="import-actions">
                <button type="button" class="btn btn-secondary btn-sm" id="importResetBtn">Choose another file</button>
                <button type="button" class="btn btn-primary btn-sm" id="importApplyBtn">Match rows</button>
              </div>
            </div>
          </section>

          <section id="inviteSourcePanelText" role="tabpanel" aria-labelledby="inviteSourceTabText" data-invite-source-panel="text" hidden>
            <label for="recipientSource">Recipient emails</label>
            <textarea id="recipientSource" name="recipientSource" rows="4" placeholder="Paste emails, a copied message, a spreadsheet column, or any mixed text"></textarea>
            <div class="recipient-input-help">
              <div class="field-help">We’ll find email addresses anywhere in the text, remove duplicates, and keep their pasted order.</div>
              <button type="button" class="btn btn-secondary btn-sm" id="reviewRecipientsBtn" onclick="reviewRecipientText()">Review emails</button>
            </div>
          </section>

          <div class="recipient-feedback" id="recipientFeedback" role="status" aria-live="polite"></div>
          <section class="recipient-review" id="recipientReview" aria-labelledby="recipientReviewTitle" hidden>
            <div class="recipient-review-header">
              <div>
                <div class="recipient-review-title" id="recipientReviewTitle" tabindex="-1">Check recipients</div>
                <div class="recipient-review-summary" id="recipientReviewSummary"></div>
              </div>
              <div class="recipient-review-actions">
                <button type="button" class="btn btn-secondary btn-sm" onclick="sortRecipientsAlphabetically()">Sort A–Z</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="reviewRecipientText()">Extract again</button>
              </div>
            </div>
            <div class="import-skipped" id="importSkipped" hidden></div>
            <div class="recipient-list" id="recipientList"></div>
            <div class="recipient-create-area">
              <% if (canManageDepartments) { %>
                <div class="inline-create-panel" id="createDepartmentPanel">
                  <div class="inline-create-panel-title">Create a department for <span id="createDepartmentRecipientLabel">this recipient</span></div>
                  <div class="inline-create-grid">
                    <div>
                      <label for="newDepartmentName">Department name *</label>
                      <input type="text" id="newDepartmentName" maxlength="100" placeholder="e.g. Operations">
                    </div>
                    <div>
                      <label for="newDepartmentParent">Parent department</label>
                      <select id="newDepartmentParent"></select>
                    </div>
                  </div>
                  <div class="field-help">The department will be created and selected for this person. You can then create or choose their team.</div>
                  <div class="inline-create-actions">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="closeInlineCreatePanels()">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" id="createDepartmentBtn" onclick="createDepartmentFromInvite()">Create department</button>
                  </div>
                </div>
              <% } %>
              <% if (canManageTeams) { %>
                <div class="inline-create-panel" id="createTeamPanel">
                  <div class="inline-create-panel-title">Create a team for <span id="createTeamRecipientLabel">this recipient</span></div>
                  <div class="inline-create-grid">
                    <div>
                      <label for="newTeamName">Team name *</label>
                      <input type="text" id="newTeamName" maxlength="100" placeholder="e.g. People Operations">
                    </div>
                    <div>
                      <label for="newTeamDepartment">Department *</label>
                      <select id="newTeamDepartment" onchange="renderNewTeamParentOptions()"></select>
                    </div>
                    <div>
                      <label for="newTeamParent">Parent team</label>
                      <select id="newTeamParent"><option value="">No parent team</option></select>
                    </div>
                    <div>
                      <label for="newTeamDescription">Description <span aria-hidden="true">·</span> optional</label>
                      <input type="text" id="newTeamDescription" maxlength="240" placeholder="What does this team do?">
                    </div>
                  </div>
                  <div class="field-help">The team will be created and selected for this person immediately.</div>
                  <div class="inline-create-actions">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="closeInlineCreatePanels()">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" id="createTeamBtn" onclick="createTeamFromInvite()">Create team</button>
                  </div>
                </div>
              <% } %>
            </div>
          </section>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-secondary" onclick="hideInviteModal()">Cancel</button>
          <button type="submit" class="btn btn-primary" id="sendInviteBtn" disabled>Review emails to continue</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const orgId = '<%= organization._id %>';
    const canCreateDepartments = <%- JSON.stringify(Boolean(canManageDepartments)) %>;
    const canCreateTeams = <%- JSON.stringify(Boolean(canManageTeams)) %>;
    const canAssignRolesClient = <%- JSON.stringify(Boolean(canAssignRoles)) %>;
    const canAssignAppsClient = <%- JSON.stringify(Boolean(canAssignApps)) %>;
    const availableApps = <%- JSON.stringify(availableApps || []) %>;
    let departments = <%- JSON.stringify(departments || []) %>;
    let teams = <%- JSON.stringify(teams || []) %>;
    const recipientParser = globalThis.InvitationRecipientParser;
    let recipients = [];
    let nextRecipientId = 1;
    let reviewedRecipientSource = '';
    let importState = null;
    let importedFromFile = false;
    let isSendingInvitations = false;
    let inlineCreateRecipientId = null;
    let inviteDialogTrigger = null;
    let previousBodyOverflow = '';

    const roleLabels = {
      admin: 'Admin',
      hr_manager: 'HR Manager',
      recruiter: 'Recruiter',
      interviewer: 'Interviewer',
      staff: 'Staff'
    };

    function setRecipientFeedback(message = '', kind = '') {
      const feedback = document.getElementById('recipientFeedback');
      feedback.textContent = message;
      feedback.className = `recipient-feedback${message ? ' active' : ''}${kind ? ` ${kind}` : ''}`;
    }

    function updateSendInviteButton() {
      const button = document.getElementById('sendInviteBtn');
      if (isSendingInvitations) return;

      const isReviewed = recipients.length > 0 &&
        (importedFromFile || document.getElementById('recipientSource').value === reviewedRecipientSource);
      const recipientsAreValid = isReviewed && validateRecipients(false);
      button.disabled = !recipientsAreValid;
      const incompleteCount = recipients.filter(recipient => !recipient.isValid).length;
      button.textContent = !isReviewed
        ? 'Add recipients to continue'
        : incompleteCount > 0
          ? `Complete ${incompleteCount} invitation${incompleteCount === 1 ? '' : 's'}`
          : `Send ${recipients.length} invitation${recipients.length === 1 ? '' : 's'}`;
    }

    function roleOptionsMarkup(selectedRole) {
      const roles = canAssignRolesClient
        ? ['admin', 'hr_manager', 'recruiter', 'interviewer', 'staff']
        : ['staff'];
      return roles.map(role => `<option value="${role}"${role === selectedRole ? ' selected' : ''}>${roleLabels[role]}</option>`).join('');
    }

    function departmentOptionsMarkup(selectedDepartmentId = '') {
      const sortedDepartments = sortDepartments(departments);
      return '<option value="">Select a department</option>' + sortedDepartments.map(department => (
        `<option value="${department.id}"${department.id === selectedDepartmentId ? ' selected' : ''}>${escapeHtml(department.name)}</option>`
      )).join('');
    }

    function teamOptionsMarkup(departmentId, selectedTeamId = '') {
      return '<option value="">Select a team</option>' + teams
        .filter(team => team.departmentId === departmentId)
        .sort((left, right) => left.name.localeCompare(right.name))
        .map(team => `<option value="${team.id}"${team.id === selectedTeamId ? ' selected' : ''}>${escapeHtml(team.name)}</option>`)
        .join('');
    }

    function appAccessMarkup(recipient) {
      if (!canAssignAppsClient) {
        return '<div class="field-help">No product access initially. An access administrator can assign products after the member joins.</div>';
      }
      const selectedMode = recipient.appAccess.mode === 'selected';
      const appOptions = availableApps.length > 0
        ? `<div class="recipient-app-grid">${availableApps.map(app => `
            <label class="recipient-app-option">
              <input type="checkbox" data-recipient-app value="${escapeHtml(app.appId)}"${recipient.appAccess.appIds.includes(app.appId) ? ' checked' : ''}>
              <span>${escapeHtml(app.name)}</span>
            </label>`).join('')}</div>`
        : '<div class="field-help">No apps are currently configured.</div>';
      return `
        <div class="recipient-app-access">
          <div class="recipient-app-modes">
            <label><input type="radio" name="recipient-app-mode-${recipient.id}" data-recipient-app-mode value="all"${selectedMode ? '' : ' checked'}> All apps</label>
            <label><input type="radio" name="recipient-app-mode-${recipient.id}" data-recipient-app-mode value="selected"${selectedMode ? ' checked' : ''}> Selected apps only</label>
          </div>
          ${selectedMode ? appOptions : ''}
        </div>`;
    }

    function recipientRowMarkup(recipient, index) {
      const team = teams.find(candidate => candidate.id === recipient.teamId);
      const teamLabel = team?.name || 'Team required';
      return `
        <details class="recipient-row" data-recipient-id="${recipient.id}"${recipient.expanded ? ' open' : ''}>
          <summary class="recipient-summary">
            <span class="recipient-index" aria-hidden="true">${index + 1}</span>
            <span class="recipient-summary-email">${escapeHtml(recipient.email)}${recipient.fullName ? `<span class="recipient-summary-name"> · ${escapeHtml(recipient.fullName)}</span>` : ''}</span>
            <span class="recipient-summary-meta">
              <span class="recipient-summary-chip">${escapeHtml(roleLabels[recipient.role] || recipient.role)}</span>
              <span class="recipient-summary-chip${team ? '' : ' warning'}">${escapeHtml(teamLabel)}</span>
            </span>
            <span class="recipient-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="recipient-details">
            ${(recipient.importIssues || []).length > 0 ? `<div class="recipient-issue-list" role="note">${recipient.importIssues.map(text => `<span>${escapeHtml(text)}</span>`).join('')}</div>` : ''}
            <div class="recipient-fields-grid">
              <div class="recipient-field full">
                <label for="recipient-email-${recipient.id}">Email address *</label>
                <input type="email" id="recipient-email-${recipient.id}" data-recipient-email value="${escapeHtml(recipient.email)}" autocomplete="off">
                <div class="recipient-field-error" data-recipient-error></div>
                <div class="recipient-send-status${recipient.sendError ? ' error' : ''}" data-recipient-status>${escapeHtml(recipient.sendError || '')}</div>
              </div>
              <div class="recipient-field">
                <label for="recipient-role-${recipient.id}">Access role</label>
                <select id="recipient-role-${recipient.id}" data-recipient-role${canAssignRolesClient ? '' : ' disabled'}>${roleOptionsMarkup(recipient.role)}</select>
              </div>
              <div class="recipient-field">
                <label for="recipient-designation-${recipient.id}">Designation <span aria-hidden="true">·</span> optional</label>
                <input type="text" id="recipient-designation-${recipient.id}" data-recipient-designation value="${escapeHtml(recipient.designation || '')}" maxlength="120" placeholder="e.g. Software Engineer" autocomplete="off">
              </div>
              <div class="recipient-field">
                <label for="recipient-employee-${recipient.id}">Employee ID <span aria-hidden="true">·</span> optional</label>
                <input type="text" id="recipient-employee-${recipient.id}" data-recipient-employee-id value="${escapeHtml(recipient.employeeId || '')}" maxlength="80" placeholder="e.g. EMP-0042" autocomplete="off">
                <div class="recipient-field-error" data-employee-id-error></div>
              </div>
              <div class="recipient-field">
                <label for="recipient-department-${recipient.id}">Department</label>
                <select id="recipient-department-${recipient.id}" data-recipient-department>${departmentOptionsMarkup(recipient.departmentId)}</select>
                <div class="recipient-inline-actions">
                  ${canCreateDepartments ? `<button type="button" class="btn btn-secondary btn-sm" data-create-department>+ Create department</button>` : ''}
                </div>
              </div>
              <div class="recipient-field full">
                <label for="recipient-team-${recipient.id}">Team *</label>
                <select id="recipient-team-${recipient.id}" data-recipient-team${recipient.departmentId ? '' : ' disabled'}>${teamOptionsMarkup(recipient.departmentId, recipient.teamId)}</select>
                <div class="recipient-inline-actions">
                  <span class="field-help">Required. The selected team determines the member’s department.</span>
                  ${canCreateTeams ? `<button type="button" class="btn btn-secondary btn-sm" data-create-team>+ Create team</button>` : ''}
                </div>
              </div>
              <div class="recipient-field full">
                <label>Initial app access</label>
                ${appAccessMarkup(recipient)}
              </div>
            </div>
            <div class="recipient-config-error" data-recipient-config-error></div>
            <div class="recipient-row-actions">
              <div class="recipient-row-actions-group">
                <button type="button" class="btn btn-secondary btn-sm" data-apply-recipient-details>Apply role, team &amp; access to everyone</button>
              </div>
              <div class="recipient-row-actions-group">
                <button type="button" class="recipient-action-button" data-recipient-action="up" aria-label="Move ${escapeHtml(recipient.email)} up" ${index === 0 ? 'disabled' : ''}>↑</button>
                <button type="button" class="recipient-action-button" data-recipient-action="down" aria-label="Move ${escapeHtml(recipient.email)} down" ${index === recipients.length - 1 ? 'disabled' : ''}>↓</button>
                <button type="button" class="recipient-action-button remove" data-recipient-action="remove" aria-label="Remove ${escapeHtml(recipient.email)}">×</button>
              </div>
            </div>
          </div>
        </details>`;
    }

    function renderRecipientReview() {
      const review = document.getElementById('recipientReview');
      review.hidden = recipients.length === 0;
      if (recipients.length === 0) {
        document.getElementById('recipientList').innerHTML = '';
        updateSendInviteButton();
        return;
      }

      document.getElementById('recipientReviewSummary').textContent =
        `${recipients.length} invitation${recipients.length === 1 ? '' : 's'} in sending order. Open each person to set their required team and optional details.`;
      const list = document.getElementById('recipientList');
      list.innerHTML = recipients.map(recipientRowMarkup).join('');
      list.querySelectorAll('.recipient-row').forEach((row) => {
        row.addEventListener('toggle', () => {
          const recipient = recipients.find(item => item.id === Number(row.dataset.recipientId));
          if (recipient) recipient.expanded = row.open;
        });
      });

      list.querySelectorAll('[data-recipient-email]').forEach((input) => {
        input.addEventListener('input', (event) => {
          const row = event.target.closest('[data-recipient-id]');
          const recipient = recipients.find(item => item.id === Number(row.dataset.recipientId));
          if (!recipient) return;
          recipient.email = event.target.value.trim();
          recipient.sendError = '';
          validateRecipients(false);
          updateSendInviteButton();
        });
      });
      list.querySelectorAll('[data-recipient-designation]').forEach((input) => {
        input.addEventListener('input', (event) => {
          const recipient = getRecipientFromElement(event.target);
          if (recipient) recipient.designation = event.target.value;
        });
      });
      list.querySelectorAll('[data-recipient-employee-id]').forEach((input) => {
        input.addEventListener('input', (event) => {
          const row = event.target.closest('[data-recipient-id]');
          const recipient = recipients.find(item => item.id === Number(row.dataset.recipientId));
          if (!recipient) return;
          recipient.employeeId = event.target.value.trim();
          recipient.sendError = '';
          validateRecipients(false);
          updateSendInviteButton();
        });
      });
      list.querySelectorAll('[data-recipient-role]').forEach((select) => {
        select.addEventListener('change', (event) => {
          const recipient = getRecipientFromElement(event.target);
          if (!recipient) return;
          recipient.role = event.target.value;
          renderRecipientReview();
        });
      });
      list.querySelectorAll('[data-recipient-department]').forEach((select) => {
        select.addEventListener('change', (event) => {
          const recipient = getRecipientFromElement(event.target);
          if (!recipient) return;
          recipient.departmentId = event.target.value;
          recipient.teamId = '';
          recipient.expanded = true;
          renderRecipientReview();
        });
      });
      list.querySelectorAll('[data-recipient-team]').forEach((select) => {
        select.addEventListener('change', (event) => {
          const recipient = getRecipientFromElement(event.target);
          if (!recipient) return;
          recipient.teamId = event.target.value;
          const team = teams.find(candidate => candidate.id === recipient.teamId);
          if (team) recipient.departmentId = team.departmentId;
          recipient.expanded = true;
          renderRecipientReview();
        });
      });
      list.querySelectorAll('[data-recipient-app-mode]').forEach((input) => {
        input.addEventListener('change', (event) => {
          const recipient = getRecipientFromElement(event.target);
          if (!recipient) return;
          recipient.appAccess.mode = event.target.value;
          if (event.target.value === 'all') recipient.appAccess.appIds = [];
          recipient.expanded = true;
          renderRecipientReview();
        });
      });
      list.querySelectorAll('[data-recipient-app]').forEach((input) => {
        input.addEventListener('change', (event) => {
          const recipient = getRecipientFromElement(event.target);
          if (!recipient) return;
          recipient.appAccess.appIds = Array.from(
            event.target.closest('.recipient-row').querySelectorAll('[data-recipient-app]:checked')
          ).map(checkbox => checkbox.value);
          validateRecipients(false);
          updateSendInviteButton();
        });
      });
      list.querySelectorAll('[data-create-department]').forEach(button => {
        button.addEventListener('click', () => openCreateDepartmentPanel(Number(button.closest('.recipient-row').dataset.recipientId)));
      });
      list.querySelectorAll('[data-create-team]').forEach(button => {
        button.addEventListener('click', () => openCreateTeamPanel(Number(button.closest('.recipient-row').dataset.recipientId)));
      });
      list.querySelectorAll('[data-apply-recipient-details]').forEach(button => {
        button.addEventListener('click', () => applyRecipientDetailsToAll(Number(button.closest('.recipient-row').dataset.recipientId)));
      });
      list.querySelectorAll('[data-recipient-action]').forEach((button) => {
        button.addEventListener('click', () => {
          const row = button.closest('[data-recipient-id]');
          changeRecipientOrder(Number(row.dataset.recipientId), button.dataset.recipientAction);
        });
      });

      validateRecipients(false);
      updateSendInviteButton();
    }

    function getRecipientFromElement(element) {
      const row = element.closest('[data-recipient-id]');
      return recipients.find(item => item.id === Number(row?.dataset.recipientId));
    }

    function validateRecipients(focusFirstInvalid = false) {
      if (recipients.length === 0) return false;
      const emailKeys = new Set();
      const employeeIdKeys = new Set();
      let firstInvalidInput = null;
      let isValid = true;

      recipients.forEach((recipient) => {
        const row = document.querySelector(`[data-recipient-id="${recipient.id}"]`);
        if (!row) return;
        const emailInput = row.querySelector('[data-recipient-email]');
        const employeeIdInput = row.querySelector('[data-recipient-employee-id]');
        const emailError = row.querySelector('[data-recipient-error]');
        const employeeIdError = row.querySelector('[data-employee-id-error]');
        const configError = row.querySelector('[data-recipient-config-error]');
        const normalizedEmail = recipient.email.trim().toLowerCase();
        const employeeIdKey = recipient.employeeId.trim().toLowerCase();
        let emailMessage = '';
        let employeeIdMessage = '';
        const configurationMessages = [];

        if (!recipientParser.isValidEmail(normalizedEmail)) {
          emailMessage = 'Enter a complete, valid email address.';
        } else if (emailKeys.has(normalizedEmail)) {
          emailMessage = 'This address is already in the batch.';
        } else {
          emailKeys.add(normalizedEmail);
          recipient.email = normalizedEmail;
        }

        if (employeeIdKey && employeeIdKeys.has(employeeIdKey)) {
          employeeIdMessage = 'Employee IDs must be unique in this batch.';
        } else if (employeeIdKey) {
          employeeIdKeys.add(employeeIdKey);
        }

        const team = teams.find(candidate => candidate.id === recipient.teamId);
        if (!team) {
          configurationMessages.push('Select a team for this person.');
        } else if (team.departmentId !== recipient.departmentId) {
          configurationMessages.push('The selected team does not belong to this department.');
        }
        if (canAssignAppsClient && recipient.appAccess.mode === 'selected' && recipient.appAccess.appIds.length === 0) {
          configurationMessages.push('Select at least one app or choose All apps.');
        }

        emailError.textContent = emailMessage;
        emailError.classList.toggle('active', Boolean(emailMessage));
        employeeIdError.textContent = employeeIdMessage;
        employeeIdError.classList.toggle('active', Boolean(employeeIdMessage));
        configError.textContent = configurationMessages.join(' ');
        configError.classList.toggle('active', configurationMessages.length > 0);
        recipient.isValid = !emailMessage && !employeeIdMessage && configurationMessages.length === 0;
        row.classList.toggle('invalid', !recipient.isValid);
        emailInput.setAttribute('aria-invalid', String(Boolean(emailMessage)));
        employeeIdInput.setAttribute('aria-invalid', String(Boolean(employeeIdMessage)));

        if (!recipient.isValid) {
          isValid = false;
          firstInvalidInput ||= emailMessage ? emailInput : employeeIdMessage ? employeeIdInput : row.querySelector('[data-recipient-team]');
        }
      });

      if (focusFirstInvalid && firstInvalidInput) {
        firstInvalidInput.closest('.recipient-row').open = true;
        firstInvalidInput.focus();
      }
      return isValid;
    }

    function reviewRecipientText() {
      const source = document.getElementById('recipientSource');
      importedFromFile = false;
      clearImportSkipped();
      const result = recipientParser.extractEmailAddresses(source.value);
      if (result.emails.length === 0) {
        recipients = [];
        reviewedRecipientSource = '';
        renderRecipientReview();
        setRecipientFeedback('No email addresses were found. Paste the original message or list and try again.', 'error');
        source.focus();
        return;
      }

      recipients = result.emails.map(email => ({
        id: nextRecipientId++,
        email,
        role: canAssignRolesClient ? 'recruiter' : 'staff',
        designation: '',
        employeeId: '',
        departmentId: getDefaultDepartmentId(),
        teamId: '',
        appAccess: { mode: canAssignAppsClient ? 'all' : 'selected', appIds: [] },
        expanded: false,
        isValid: false,
        sendError: ''
      }));
      if (recipients[0]) recipients[0].expanded = true;
      reviewedRecipientSource = source.value;
      renderRecipientReview();

      const notes = [`Found ${recipients.length} unique email address${recipients.length === 1 ? '' : 'es'}. Check the list and order before sending.`];
      if (result.duplicateCount > 0) {
        notes.push(`${result.duplicateCount} duplicate${result.duplicateCount === 1 ? ' was' : 's were'} removed.`);
      }
      if (result.truncatedCount > 0) {
        notes.push(`This batch is limited to ${result.limit}; ${result.truncatedCount} additional address${result.truncatedCount === 1 ? ' was' : 'es were'} not added.`);
      }
      setRecipientFeedback(notes.join(' '), result.truncatedCount > 0 ? '' : 'success');
      document.getElementById('recipientReviewTitle').focus?.();
    }

    function changeRecipientOrder(recipientId, action) {
      const index = recipients.findIndex(recipient => recipient.id === recipientId);
      if (index < 0) return;
      if (action === 'remove') {
        recipients.splice(index, 1);
      } else {
        const targetIndex = action === 'up' ? index - 1 : index + 1;
        if (targetIndex < 0 || targetIndex >= recipients.length) return;
        [recipients[index], recipients[targetIndex]] = [recipients[targetIndex], recipients[index]];
      }
      renderRecipientReview();
      if (recipients.length === 0) {
        reviewedRecipientSource = '';
        importedFromFile = false;
        setRecipientFeedback('Every recipient was removed. Upload a file or paste addresses to start again.', 'error');
      }
    }

    function sortRecipientsAlphabetically() {
      recipients.sort((left, right) => left.email.localeCompare(right.email));
      renderRecipientReview();
      setRecipientFeedback('Recipients sorted alphabetically. Check the order before sending.', 'success');
    }

    function applyRecipientDetailsToAll(recipientId) {
      const sourceRecipient = recipients.find(recipient => recipient.id === recipientId);
      if (!sourceRecipient) return;
      recipients.forEach(recipient => {
        recipient.role = sourceRecipient.role;
        recipient.departmentId = sourceRecipient.departmentId;
        recipient.teamId = sourceRecipient.teamId;
        recipient.appAccess = {
          mode: sourceRecipient.appAccess.mode,
          appIds: [...sourceRecipient.appAccess.appIds]
        };
      });
      renderRecipientReview();
      setRecipientFeedback('Role, department, team, and app access applied to every recipient. Designations and employee IDs remain individual.', 'success');
    }

    function invalidateRecipientReview() {
      const source = document.getElementById('recipientSource');
      if (importedFromFile || recipients.length === 0 || source.value === reviewedRecipientSource) return;
      recipients = [];
      reviewedRecipientSource = '';
      renderRecipientReview();
      setRecipientFeedback('The pasted text changed. Review it again before sending.', '');
    }

    function setRecipientSendStatus(recipientId, message, kind = '') {
      const recipient = recipients.find(item => item.id === recipientId);
      if (recipient) recipient.sendError = kind === 'error' ? message : '';
      const status = document.querySelector(`[data-recipient-id="${recipientId}"] [data-recipient-status]`);
      if (!status) return;
      status.textContent = message;
      status.className = `recipient-send-status${kind ? ` ${kind}` : ''}`;
    }

    function sortDepartments(list) {
      return [...list].sort((left, right) => left.name.localeCompare(right.name));
    }

    function getDefaultDepartmentId() {
      return departments[0]?.id || '';
    }

    function renderDepartmentParentOptions(selectedParentId = '') {
      if (!canCreateDepartments) return;
      const parentSelect = document.getElementById('newDepartmentParent');
      if (!parentSelect) return;
      parentSelect.innerHTML = '<option value="">No parent department</option>' + departments.map((department) => (
        `<option value="${department.id}"${department.id === selectedParentId ? ' selected' : ''}>${escapeHtml(department.name)}</option>`
      )).join('');
    }

    function showInviteModal() {
      inviteDialogTrigger = document.activeElement;
      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      document.getElementById('inviteModal').classList.add('active');
      closeInlineCreatePanels();
      setTimeout(() => document.getElementById('importFile').focus(), 0);
    }

    function hideInviteModal() {
      if (isSendingInvitations) return;
      document.getElementById('inviteModal').classList.remove('active');
      document.body.style.overflow = previousBodyOverflow;
      document.getElementById('inviteForm').reset();
      recipients = [];
      reviewedRecipientSource = '';
      importedFromFile = false;
      resetImportPanel();
      clearImportSkipped();
      switchInviteSource('file');
      setRecipientFeedback();
      renderRecipientReview();
      closeInlineCreatePanels();
      inviteDialogTrigger?.focus?.();
    }

    function closeInlineCreatePanels() {
      document.getElementById('createDepartmentPanel')?.classList.remove('active');
      document.getElementById('createTeamPanel')?.classList.remove('active');
      if (document.getElementById('newDepartmentName')) document.getElementById('newDepartmentName').value = '';
      if (document.getElementById('newTeamName')) document.getElementById('newTeamName').value = '';
      if (document.getElementById('newTeamDescription')) document.getElementById('newTeamDescription').value = '';
      inlineCreateRecipientId = null;
    }

    function openCreateDepartmentPanel(recipientId) {
      if (!canCreateDepartments) return;
      closeInlineCreatePanels();
      const recipient = recipients.find(item => item.id === recipientId);
      if (!recipient) return;
      inlineCreateRecipientId = recipientId;
      document.getElementById('createDepartmentRecipientLabel').textContent = recipient.email;
      renderDepartmentParentOptions(recipient.departmentId);
      const panel = document.getElementById('createDepartmentPanel');
      panel.classList.add('active');
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      document.getElementById('newDepartmentName').focus();
    }

    function openCreateTeamPanel(recipientId) {
      if (!canCreateTeams) return;
      closeInlineCreatePanels();
      const recipient = recipients.find(item => item.id === recipientId);
      if (!recipient) return;
      inlineCreateRecipientId = recipientId;
      document.getElementById('createTeamRecipientLabel').textContent = recipient.email;
      const departmentSelect = document.getElementById('newTeamDepartment');
      departmentSelect.innerHTML = departmentOptionsMarkup(recipient.departmentId);
      if (!departmentSelect.value && getDefaultDepartmentId()) departmentSelect.value = getDefaultDepartmentId();
      renderNewTeamParentOptions();
      const panel = document.getElementById('createTeamPanel');
      panel.classList.add('active');
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      document.getElementById('newTeamName').focus();
    }

    function renderNewTeamParentOptions() {
      if (!canCreateTeams) return;
      const departmentId = document.getElementById('newTeamDepartment')?.value || '';
      const parentSelect = document.getElementById('newTeamParent');
      if (!parentSelect) return;
      parentSelect.innerHTML = '<option value="">No parent team</option>' + teams
        .filter(team => team.departmentId === departmentId)
        .sort((left, right) => left.name.localeCompare(right.name))
        .map(team => `<option value="${team.id}">${escapeHtml(team.name)}</option>`)
        .join('');
    }


    function switchInviteSource(mode) {
      document.querySelectorAll('[data-invite-source]').forEach((tab) => {
        tab.setAttribute('aria-selected', String(tab.dataset.inviteSource === mode));
      });
      document.querySelectorAll('[data-invite-source-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.inviteSourcePanel !== mode;
      });
    }

    function clearImportSkipped() {
      const skipped = document.getElementById('importSkipped');
      skipped.hidden = true;
      skipped.innerHTML = '';
    }

    function resetImportPanel() {
      importState = null;
      document.getElementById('importMappingPanel').hidden = true;
      document.getElementById('importMappingGrid').innerHTML = '';
      document.getElementById('importPreviewScroll').innerHTML = '';
      document.getElementById('importSheetGroup').hidden = true;
    }

    function resetImport() {
      document.getElementById('importFile').value = '';
      resetImportPanel();
      clearImportSkipped();
      setRecipientFeedback();
    }

    async function loadImportPreview(file, sheetName = '') {
      const body = new FormData();
      body.append('file', file);
      body.append('type', 'creation');
      if (sheetName) body.append('sheetName', sheetName);

      setRecipientFeedback(`Reading ${file.name}…`);
      try {
        const response = await fetch(`/api/organizations/${orgId}/member-imports/preview`, { method: 'POST', body });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'That file could not be read.');

        importState = {
          file,
          preview: data.preview,
          fields: data.fields || [],
          columnMap: { ...(data.preview.columnMap || {}) }
        };
        renderImportMapping();
        const matched = Object.keys(importState.columnMap).length;
        setRecipientFeedback(
          `${data.preview.totalRows} row${data.preview.totalRows === 1 ? '' : 's'} found. ${matched} column${matched === 1 ? '' : 's'} matched automatically — confirm them below.`,
          'success'
        );
      } catch (error) {
        resetImportPanel();
        setRecipientFeedback(error.message || 'That file could not be read.', 'error');
      }
    }

    function renderImportMapping() {
      const panel = document.getElementById('importMappingPanel');
      if (!importState) {
        panel.hidden = true;
        return;
      }

      const { preview, fields, columnMap } = importState;
      panel.hidden = false;

      const sheetGroup = document.getElementById('importSheetGroup');
      const sheetSelect = document.getElementById('importSheet');
      if ((preview.sheetNames || []).length > 1) {
        sheetGroup.hidden = false;
        sheetSelect.innerHTML = preview.sheetNames.map((name) => (
          `<option value="${escapeHtml(name)}"${name === preview.selectedSheetName ? ' selected' : ''}>${escapeHtml(name)}</option>`
        )).join('');
      } else {
        sheetGroup.hidden = true;
      }

      document.getElementById('importMappingSummary').textContent =
        `${preview.totalRows} row${preview.totalRows === 1 ? '' : 's'} in ${preview.sourceFileName || 'your file'}${preview.selectedSheetName ? ` · sheet “${preview.selectedSheetName}”` : ''}. Tell us which column holds each detail.`;

      const columnOptions = (selected) => '<option value="">Not in this file</option>' + (preview.headers || []).map((header) => (
        `<option value="${escapeHtml(header)}"${header === selected ? ' selected' : ''}>${escapeHtml(header)}</option>`
      )).join('');

      document.getElementById('importMappingGrid').innerHTML = fields.map((field) => `
        <div class="import-mapping-field">
          <label for="import-map-${field.key}">${escapeHtml(field.label)}${field.required ? ' *' : ''}</label>
          <select id="import-map-${field.key}" data-import-field="${field.key}">${columnOptions(columnMap[field.key] || '')}</select>
          <div class="field-help">${escapeHtml(field.description || '')}</div>
        </div>`).join('');

      const sampleRows = preview.sampleRows || [];
      document.getElementById('importPreviewScroll').innerHTML = sampleRows.length === 0
        ? ''
        : `<table class="import-preview-table">
            <thead><tr>${(preview.headers || []).map((header) => `<th>${escapeHtml(header)}</th>`).join('')}</tr></thead>
            <tbody>${sampleRows.map((row) => `<tr>${row.map((cell) => `<td>${escapeHtml(cell)}</td>`).join('')}</tr>`).join('')}</tbody>
          </table>`;
    }

    function readImportColumnMap() {
      const columnMap = {};
      document.querySelectorAll('[data-import-field]').forEach((select) => {
        if (select.value) columnMap[select.dataset.importField] = select.value;
      });
      return columnMap;
    }

    async function applyImportMapping() {
      if (!importState) return;
      const applyBtn = document.getElementById('importApplyBtn');
      const columnMap = readImportColumnMap();

      if (!columnMap.email) {
        setRecipientFeedback('Match a column to the email address before continuing.', 'error');
        document.getElementById('import-map-email')?.focus();
        return;
      }

      importState.columnMap = columnMap;
      const body = new FormData();
      body.append('file', importState.file);
      body.append('type', 'creation');
      body.append('columnMap', JSON.stringify(columnMap));
      if (importState.preview.selectedSheetName) body.append('sheetName', importState.preview.selectedSheetName);

      try {
        applyBtn.disabled = true;
        applyBtn.textContent = 'Matching…';
        const response = await fetch(`/api/organizations/${orgId}/member-imports/rows`, { method: 'POST', body });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'Those rows could not be matched.');
        applyImportedRows(data);
      } catch (error) {
        setRecipientFeedback(error.message || 'Those rows could not be matched.', 'error');
      } finally {
        applyBtn.disabled = false;
        applyBtn.textContent = 'Match rows';
      }
    }

    function applyImportedRows(result) {
      const rows = result.rows || [];
      const importable = rows.filter((row) => row.status !== 'blocked');
      const skipped = rows.filter((row) => row.status === 'blocked');

      recipients = importable.map((row) => ({
        id: nextRecipientId++,
        email: row.email,
        fullName: row.fullName || '',
        role: canAssignRolesClient ? row.role : 'staff',
        designation: row.designation || '',
        employeeId: row.employeeId || '',
        departmentId: row.departmentId || getDefaultDepartmentId(),
        teamId: row.teamId || '',
        appAccess: {
          mode: canAssignAppsClient ? (row.appAccess?.mode || 'all') : 'selected',
          appIds: [...(row.appAccess?.appIds || [])]
        },
        expanded: false,
        isValid: false,
        sendError: '',
        importIssues: (row.issues || []).map((entry) => `Row ${row.rowNumber}: ${entry.message}`)
      }));

      renderImportSkipped(skipped);

      if (recipients.length === 0) {
        importedFromFile = false;
        renderRecipientReview();
        setRecipientFeedback('None of the rows in that file can be invited. Fix the reasons listed above and upload it again.', 'error');
        return;
      }

      const firstToCheck = recipients.find((recipient) => recipient.importIssues.length > 0) || recipients[0];
      firstToCheck.expanded = true;
      importedFromFile = true;
      reviewedRecipientSource = document.getElementById('recipientSource').value;
      renderRecipientReview();

      const notes = [`${recipients.length} ${recipients.length === 1 ? 'person is' : 'people are'} ready to check. Open each one to confirm their details before sending.`];
      const needsAttention = recipients.filter((recipient) => recipient.importIssues.length > 0).length;
      if (needsAttention > 0) {
        notes.push(`${needsAttention} still ${needsAttention === 1 ? 'needs' : 'need'} a detail we could not match from the file.`);
      }
      if (skipped.length > 0) {
        notes.push(`${skipped.length} row${skipped.length === 1 ? ' was' : 's were'} left out.`);
      }
      if (result.summary?.truncated > 0) {
        notes.push(`Only the first ${result.summary.limit} rows were read; ${result.summary.truncated} more were not.`);
      }
      setRecipientFeedback(notes.join(' '), needsAttention > 0 || skipped.length > 0 ? '' : 'success');
      document.getElementById('recipientReviewTitle').focus?.();
    }

    function renderImportSkipped(skipped = []) {
      const container = document.getElementById('importSkipped');
      if (skipped.length === 0) {
        clearImportSkipped();
        return;
      }

      container.hidden = false;
      container.innerHTML = `
        <strong>${skipped.length} row${skipped.length === 1 ? '' : 's'} could not be invited.</strong>
        Correct them in your file and upload it again if these people should be invited.
        <ul>${skipped.map((row) => {
          const reasons = (row.issues || []).filter((entry) => entry.severity === 'error').map((entry) => entry.message).join(' ');
          const label = row.email || row.employeeId || 'no identifier';
          return `<li>Row ${row.rowNumber} · ${escapeHtml(label)} — ${escapeHtml(reasons)}</li>`;
        }).join('')}</ul>`;
    }

    async function createDepartmentFromInvite() {
      if (!canCreateDepartments) return;
      const nameInput = document.getElementById('newDepartmentName');
      const parentInput = document.getElementById('newDepartmentParent');
      const createBtn = document.getElementById('createDepartmentBtn');
      const name = nameInput.value.trim();
      const parentDepartment = parentInput.value || null;
      const targetRecipientId = inlineCreateRecipientId;

      if (!name) {
        alert('Department name is required.');
        nameInput.focus();
        return;
      }

      try {
        createBtn.disabled = true;
        createBtn.textContent = 'Creating...';
        const response = await fetch(`/api/organizations/${orgId}/departments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            parentDepartment
          })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || 'Failed to create department');
        }

        departments = sortDepartments([
          ...departments.filter((department) => department.id !== data.id),
          {
            id: data.id,
            name: data.name,
            parentDepartment: data.parentDepartment || ''
          }
        ]);
        const recipient = recipients.find(item => item.id === targetRecipientId);
        if (recipient) {
          recipient.departmentId = String(data.id);
          recipient.teamId = '';
          recipient.expanded = true;
        }
        closeInlineCreatePanels();
        renderRecipientReview();
        setRecipientFeedback(`Department “${data.name}” created. Create or select a team for this person.`, 'success');
        if (canCreateTeams && recipient) openCreateTeamPanel(recipient.id);
      } catch (error) {
        setRecipientFeedback(error.message || 'Failed to create department.', 'error');
      } finally {
        createBtn.disabled = false;
        createBtn.textContent = 'Create department';
      }
    }

    async function createTeamFromInvite() {
      if (!canCreateTeams) return;
      const nameInput = document.getElementById('newTeamName');
      const departmentInput = document.getElementById('newTeamDepartment');
      const descriptionInput = document.getElementById('newTeamDescription');
      const parentInput = document.getElementById('newTeamParent');
      const createBtn = document.getElementById('createTeamBtn');
      const name = nameInput.value.trim();
      const departmentId = departmentInput.value;
      const targetRecipientId = inlineCreateRecipientId;

      if (!name) {
        setRecipientFeedback('Enter a team name to continue.', 'error');
        nameInput.focus();
        return;
      }
      if (!departmentId) {
        setRecipientFeedback('Select a department for the new team.', 'error');
        departmentInput.focus();
        return;
      }

      try {
        createBtn.disabled = true;
        createBtn.textContent = 'Creating…';
        const response = await fetch(`/api/organizations/${orgId}/teams`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            description: descriptionInput.value.trim(),
            departmentId,
            parentTeamId: parentInput.value || null
          })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'Failed to create team');

        const createdTeam = {
          id: String(data.id),
          name: data.name,
          departmentId: String(data.departmentId)
        };
        teams = [
          ...teams.filter(team => team.id !== createdTeam.id),
          createdTeam
        ];
        const recipient = recipients.find(item => item.id === targetRecipientId);
        if (recipient) {
          recipient.departmentId = createdTeam.departmentId;
          recipient.teamId = createdTeam.id;
          recipient.expanded = true;
        }
        closeInlineCreatePanels();
        renderRecipientReview();
        setRecipientFeedback(`Team “${createdTeam.name}” created and selected for ${recipient?.email || 'this recipient'}.`, 'success');
      } catch (error) {
        setRecipientFeedback(error.message || 'Failed to create team.', 'error');
      } finally {
        createBtn.disabled = false;
        createBtn.textContent = 'Create team';
      }
    }

    document.getElementById('inviteForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget;
      const source = document.getElementById('recipientSource');
      if (recipients.length === 0 || (!importedFromFile && source.value !== reviewedRecipientSource)) {
        reviewRecipientText();
        return;
      }
      if (!validateRecipients(true) || !form.reportValidity()) return;

      const sendInviteBtn = document.getElementById('sendInviteBtn');

      isSendingInvitations = true;
      sendInviteBtn.disabled = true;
      const batch = recipients.map(recipient => ({
        ...recipient,
        appAccess: { ...recipient.appAccess, appIds: [...recipient.appAccess.appIds] }
      }));
      const failures = [];
      let sentCount = 0;

      for (let index = 0; index < batch.length; index += 1) {
        const recipient = batch[index];
        sendInviteBtn.textContent = `Sending ${index + 1} of ${batch.length}…`;
        setRecipientSendStatus(recipient.id, 'Sending…');
        try {
          const response = await fetch(`/api/organizations/${orgId}/invitations`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: recipient.email,
              role: recipient.role,
              designation: recipient.designation.trim(),
              employeeId: recipient.employeeId,
              department: recipient.departmentId,
              team: recipient.teamId,
              appAccess: recipient.appAccess
            })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) {
            const message = data.error || 'Invitation could not be sent.';
            failures.push({ ...recipient, sendError: message });
            setRecipientSendStatus(recipient.id, message, 'error');
            continue;
          }
          sentCount += 1;
          setRecipientSendStatus(recipient.id, 'Invitation sent', 'success');
        } catch (error) {
          const message = 'Network error. Check your connection and try again.';
          failures.push({ ...recipient, sendError: message });
          setRecipientSendStatus(recipient.id, message, 'error');
        }
      }

      if (failures.length === 0) {
        sendInviteBtn.textContent = `${sentCount} invitation${sentCount === 1 ? '' : 's'} sent`;
        setRecipientFeedback(`${sentCount} invitation${sentCount === 1 ? '' : 's'} sent successfully.`, 'success');
        window.location.reload();
        return;
      }

      recipients = failures;
      source.value = failures.map(recipient => recipient.email).join('\n');
      reviewedRecipientSource = source.value;
      isSendingInvitations = false;
      renderRecipientReview();
      setRecipientFeedback(
        `${sentCount} invitation${sentCount === 1 ? '' : 's'} sent. ${failures.length} recipient${failures.length === 1 ? '' : 's'} still need attention. Fix the listed issue${failures.length === 1 ? '' : 's'} and send again.`,
        'error'
      );
      updateSendInviteButton();
    });

    async function resendInvite(inviteId) {
      if (!confirm('Resend invitation?')) return;
      const response = await fetch(`/api/invitations/${inviteId}/resend`, { method: 'POST' });
      if (response.ok) {
        alert('Invitation resent successfully');
      } else {
        const data = await response.json();
        alert(data.error || 'Failed to resend invitation');
      }
    }

    async function cancelInvite(inviteId, email) {
      if (!confirm(`Cancel invitation for ${email}?`)) return;
      const response = await fetch(`/api/invitations/${inviteId}`, { method: 'DELETE' });
      if (response.ok) {
        window.location.reload();
      } else {
        const data = await response.json();
        alert(data.error || 'Failed to cancel invitation');
      }
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    document.getElementById('inviteModal').addEventListener('click', (e) => {
      if (e.target.classList.contains('modal')) hideInviteModal();
    });
    document.querySelectorAll('[data-invite-source]').forEach((tab) => {
      tab.addEventListener('click', () => switchInviteSource(tab.dataset.inviteSource));
    });
    document.getElementById('importFile').addEventListener('change', (event) => {
      resetImportPanel();
      clearImportSkipped();
      const file = event.target.files?.[0];
      if (file) loadImportPreview(file);
    });
    document.getElementById('importSheet').addEventListener('change', (event) => {
      if (importState) loadImportPreview(importState.file, event.target.value);
    });
    document.getElementById('importApplyBtn').addEventListener('click', applyImportMapping);
    document.getElementById('importResetBtn').addEventListener('click', resetImport);
    document.getElementById('recipientSource').addEventListener('input', invalidateRecipientReview);
    document.getElementById('recipientSource').addEventListener('paste', () => {
      setTimeout(reviewRecipientText, 0);
    });
    document.addEventListener('keydown', (event) => {
      const modal = document.getElementById('inviteModal');
      if (!modal.classList.contains('active')) return;
      if (event.key === 'Escape') {
        hideInviteModal();
        return;
      }
      if (event.key !== 'Tab') return;
      const focusable = Array.from(modal.querySelectorAll(
        'button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [href], [tabindex]:not([tabindex="-1"])'
      )).filter(element => element.offsetParent !== null);
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    renderRecipientReview();
    closeInlineCreatePanels();
</script>
</body>
</html>










