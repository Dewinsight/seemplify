<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Seemplify - Your Apps</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    /* Hub-specific tune-ups: reduce noise + keep clean backdrop */
    body { padding: 28px 18px 48px; }
    body::before { opacity: var(--halo-opacity); }
    body::after { display: none; }
    .hub-content { margin-top: 8px; }
    .hub-hero {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 14px;
      margin: 14px 0 20px;
    }
    .hub-card { position: relative; }
    .hub-card h1 { margin: 0 0 6px; font-size: 26px; letter-spacing: -0.02em; color: var(--text); }
    .hub-card p { margin: 0; color: var(--muted); font-size: 15px; }
    .hub-card .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .hub-card .chip { background: var(--panel-strong); border: 1px solid var(--border); }
    .hub-card .chip.secondary { color: var(--brand-2); }
    .stat { display: flex; align-items: center; gap: 8px; margin-top: 12px; color: var(--text); font-weight: 600; }
    .dot { width: 10px; height: 10px; border-radius: 999px; background: var(--success, #8b5cf6); box-shadow: 0 0 0 6px rgba(139,92,246,0.14); }

    .apps { width: 100%; display: block; margin-top: 18px; }
    .section-title {
      margin: 22px 0 10px;
      color: var(--text);
      font-weight: 700;
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .ghost-btn {
      padding: 8px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--panel-strong);
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      font-size: 13px;
    }
    .ghost-btn:hover { background: var(--hover-bg); }

    .app-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
    .app-card {
      text-decoration: none;
      color: inherit;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 12px;
      padding: 16px;
      cursor: pointer;
      transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }
    .app-card:hover { box-shadow: 0 18px 36px rgba(0,0,0,0.35); transform: translateY(-3px); }
    .app-card--primary { border-color: rgba(99,102,241,0.65); box-shadow: 0 18px 42px rgba(99,102,241,0.22); }
    .app-card--primary:hover { border-color: rgba(99,102,241,0.8); box-shadow: 0 22px 46px rgba(99,102,241,0.32); }
    .app-card__icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--app-color, var(--brand, #6366f1)), #ffffff);
      display: grid;
      place-items: center;
      color: var(--text, #ffffff);
      border: 1px solid rgba(255,255,255,0.18);
    }
    .app-card__icon svg { width: 24px; height: 24px; }
    .app-card__body { display: grid; gap: 6px; }
    .app-card__title { font-weight: 700; font-size: 16px; letter-spacing: -0.01em; color: var(--text); display: flex; align-items: center; gap: 8px; }
    .app-card__badge {
      font-size: 10px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 10px;
      background: linear-gradient(135deg, #f59e0b, #ef4444);
      color: white;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 2px 4px rgba(245, 158, 11, 0.3);
    }
    .app-card--coming-soon {
      opacity: 0.85;
      cursor: default;
      pointer-events: none;
      border-style: dashed;
    }
    .app-card--coming-soon:hover { transform: none; box-shadow: none; }
    .coming-soon-badge {
      font-size: 10px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 10px;
      background: var(--panel-strong);
      border: 1px solid var(--border);
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .app-card__desc { color: var(--muted); font-size: 13px; }
    .app-card__meta { display: flex; gap: 6px; flex-wrap: wrap; }
    .pill { background: var(--panel-strong); border: 1px solid var(--border); color: var(--text-secondary); }
    .pill--soft { background: var(--hover-bg); color: var(--muted); border-color: var(--border); }
    .app-card__arrow { color: var(--muted); }

    .empty {
      margin-top: 12px;
      padding: 48px 16px;
      text-align: center;
      color: var(--muted);
      border: 1px dashed var(--border);
      border-radius: 14px;
      background: var(--hover-bg);
    }
    .org-setup-card {
      padding: 28px;
      border-color: rgba(99, 102, 241, 0.32);
      background:
        radial-gradient(circle at top right, rgba(34, 211, 238, 0.14), transparent 34%),
        linear-gradient(160deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.88));
    }
    .org-setup-card__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(99, 102, 241, 0.14);
      color: #c7d2fe;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .org-setup-card__title {
      margin: 18px 0 10px;
      font-size: 32px;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--text);
    }
    .org-setup-card__copy {
      max-width: 760px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.7;
    }
    .org-setup-options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 14px;
      margin-top: 22px;
    }
    .org-setup-option {
      padding: 18px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: rgba(15, 23, 42, 0.48);
    }
    .org-setup-option__title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }
    .org-setup-option__copy {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }
    .org-setup-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 20px;
    }
    .org-setup-invites {
      margin-top: 24px;
      display: grid;
      gap: 12px;
    }
    .org-setup-invite {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      padding: 18px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: rgba(15, 23, 42, 0.42);
    }
    .org-setup-invite__title {
      font-size: 17px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
    }
    .org-setup-invite__desc {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }
    .org-setup-invite__meta {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 10px;
      color: var(--muted);
      font-size: 13px;
    }
    .org-setup-empty {
      margin-top: 24px;
      padding: 18px;
      border-radius: 16px;
      border: 1px dashed var(--border);
      background: rgba(15, 23, 42, 0.24);
      color: var(--muted);
      text-align: center;
    }
    .subscription-reminder-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 24px;
      border-color: rgba(245, 158, 11, 0.35);
    }
    .subscription-lock-card {
      border-color: rgba(239, 68, 68, 0.28);
      background:
        radial-gradient(circle at top right, rgba(239, 68, 68, 0.16), transparent 34%),
        linear-gradient(160deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.9));
    }
    .subscription-lock-kicker {
      background: rgba(239, 68, 68, 0.14);
      color: #fecaca;
    }
    .subscription-lock-note {
      margin-top: 18px;
      padding: 16px 18px;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(15, 23, 42, 0.42);
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }
    .celebration-modal {
      position: fixed;
      inset: 0;
      z-index: 10050;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(2, 6, 23, 0.78);
      backdrop-filter: blur(10px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.28s ease, visibility 0.28s ease;
    }
    .celebration-modal.active {
      opacity: 1;
      visibility: visible;
    }
    .celebration-panel {
      position: relative;
      width: min(760px, 100%);
      border-radius: 28px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background:
        radial-gradient(circle at top left, rgba(16, 185, 129, 0.18), transparent 28%),
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.18), transparent 34%),
        linear-gradient(160deg, rgba(15, 23, 42, 0.98), rgba(15, 23, 42, 0.92));
      box-shadow: 0 28px 80px rgba(2, 6, 23, 0.54);
      transform: translateY(18px) scale(0.96);
      transition: transform 0.28s ease;
    }
    .celebration-modal.active .celebration-panel {
      transform: translateY(0) scale(1);
    }
    .celebration-confetti {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }
    .celebration-confetti-piece {
      position: absolute;
      top: -14%;
      left: calc((var(--piece) * 7%) + 4%);
      width: 12px;
      height: 22px;
      border-radius: 999px;
      opacity: 0.9;
      background: var(--piece-color, #b980ff);
      transform: rotate(calc((var(--piece) * 17deg) - 18deg));
      animation: confettiFall 3.6s ease-in infinite;
      animation-delay: calc(var(--piece) * 0.12s);
    }
    .celebration-shell {
      position: relative;
      padding: 34px 32px 30px;
    }
    .celebration-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(139, 92, 246, 0.14);
      color: #ddd6fe;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .celebration-icon {
      width: 72px;
      height: 72px;
      margin-top: 18px;
      border-radius: 24px;
      display: grid;
      place-items: center;
      font-size: 34px;
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(99, 102, 241, 0.22));
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 18px 40px rgba(139, 92, 246, 0.18);
      animation: celebrationPulse 2.8s ease-in-out infinite;
    }
    .celebration-title {
      margin: 18px 0 10px;
      font-size: 34px;
      line-height: 1.05;
      letter-spacing: -0.04em;
      color: var(--text);
    }
    .celebration-copy {
      margin: 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.75;
      max-width: 640px;
    }
    .celebration-summary {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 12px;
      margin-top: 22px;
    }
    .celebration-summary-card {
      padding: 16px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: rgba(15, 23, 42, 0.48);
    }
    .celebration-summary-label {
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .celebration-summary-value {
      margin-top: 8px;
      color: var(--text);
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .celebration-apps-title {
      margin-top: 24px;
      color: var(--text);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .celebration-apps-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 14px;
    }
    .celebration-app-chip {
      padding: 10px 14px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.06);
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
    }
    .celebration-footnote {
      margin-top: 18px;
      color: #bbf7d0;
      font-size: 15px;
      font-weight: 600;
    }
    .celebration-actions {
      margin-top: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
    }
    .celebration-dismiss {
      min-width: 180px;
    }
    @keyframes confettiFall {
      0% {
        transform: translate3d(0, -30px, 0) rotate(0deg);
        opacity: 0;
      }
      10% {
        opacity: 0.95;
      }
      100% {
        transform: translate3d(calc((var(--piece) - 6) * 7px), 420px, 0) rotate(420deg);
        opacity: 0;
      }
    }
    @keyframes celebrationPulse {
      0%, 100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.05);
      }
    }

    [data-theme="light"] .hub-content {
      position: relative;
    }
    [data-theme="light"] .hub-content::before {
      content: '';
      position: absolute;
      inset: 120px -28px auto -28px;
      height: 420px;
      background:
        radial-gradient(circle at 10% 12%, rgba(56, 189, 248, 0.14), transparent 34%),
        radial-gradient(circle at 82% 6%, rgba(99, 102, 241, 0.14), transparent 36%),
        radial-gradient(circle at 46% 62%, rgba(16, 185, 129, 0.1), transparent 32%);
      filter: blur(48px);
      opacity: 0.9;
      pointer-events: none;
      z-index: 0;
    }
    [data-theme="light"] .hub-content > * {
      position: relative;
      z-index: 1;
    }
    [data-theme="light"] .section-title::after {
      background: linear-gradient(90deg, rgba(99, 102, 241, 0.18), rgba(34, 211, 238, 0.08), transparent 72%);
    }
    [data-theme="light"] .ghost-btn {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(243, 246, 253, 0.94));
      border-color: rgba(99, 102, 241, 0.14);
      box-shadow: 0 16px 28px -24px rgba(15, 23, 42, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.84);
    }
    [data-theme="light"] .ghost-btn:hover {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(245, 248, 255, 0.98));
      border-color: rgba(99, 102, 241, 0.28);
      box-shadow: 0 20px 36px -24px rgba(79, 70, 229, 0.24);
    }
    [data-theme="light"] .hub-card {
      border-color: rgba(99, 102, 241, 0.14);
      box-shadow: 0 36px 74px -40px rgba(79, 70, 229, 0.24), 0 18px 34px -24px rgba(15, 23, 42, 0.18);
    }
    [data-theme="light"] .hub-card::after {
      background:
        radial-gradient(circle at 12% 16%, rgba(56, 189, 248, 0.1), transparent 32%),
        radial-gradient(circle at 86% 2%, rgba(99, 102, 241, 0.12), transparent 34%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0));
      opacity: 1;
    }
    [data-theme="light"] .org-top-strip {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.82) 0%, rgba(241, 246, 255, 0.94) 56%, rgba(236, 250, 247, 0.82) 100%) !important;
      border-bottom-color: rgba(99, 102, 241, 0.14) !important;
    }
    [data-theme="light"] .org-bottom-strip {
      background: linear-gradient(180deg, rgba(251, 253, 255, 0.94), rgba(244, 247, 253, 0.94)) !important;
    }
    [data-theme="light"] .org-icon {
      box-shadow: 0 24px 44px -26px rgba(99, 102, 241, 0.54);
    }
    [data-theme="light"] .settings-icon {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(34, 211, 238, 0.12)) !important;
      border: 1px solid rgba(99, 102, 241, 0.1);
      box-shadow: 0 18px 30px -24px rgba(79, 70, 229, 0.28);
    }
    [data-theme="light"] .org-switch-btn,
    [data-theme="light"] .org-count-badge {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(243, 246, 253, 0.94)) !important;
      border-color: rgba(99, 102, 241, 0.14) !important;
      box-shadow: 0 16px 28px -24px rgba(15, 23, 42, 0.2);
    }
    [data-theme="light"] .org-switch-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(99, 102, 241, 0.28) !important;
      box-shadow: 0 20px 36px -24px rgba(79, 70, 229, 0.24);
    }
    [data-theme="light"] .org-divider {
      background: linear-gradient(180deg, transparent, rgba(99, 102, 241, 0.18), transparent) !important;
    }
    [data-theme="light"] .app-card {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(245, 247, 255, 0.94));
      border-color: rgba(99, 102, 241, 0.14);
      box-shadow: 0 24px 44px -34px rgba(15, 23, 42, 0.22), 0 12px 24px -18px rgba(99, 102, 241, 0.16);
    }
    [data-theme="light"] .app-card:hover {
      box-shadow: 0 30px 56px -30px rgba(79, 70, 229, 0.28), 0 16px 28px -22px rgba(15, 23, 42, 0.18);
      border-color: rgba(99, 102, 241, 0.28);
      background: linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(242, 246, 255, 0.98));
    }
    [data-theme="light"] .app-card--primary {
      border-color: rgba(99, 102, 241, 0.34);
      box-shadow: 0 30px 58px -32px rgba(99, 102, 241, 0.24), 0 14px 24px -18px rgba(34, 211, 238, 0.18);
    }
    [data-theme="light"] .app-card--primary:hover {
      box-shadow: 0 34px 64px -28px rgba(99, 102, 241, 0.3), 0 18px 32px -22px rgba(34, 211, 238, 0.2);
    }
    [data-theme="light"] .app-card__icon {
      border-color: rgba(255, 255, 255, 0.76);
      box-shadow: 0 18px 30px -22px rgba(15, 23, 42, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.44);
    }
    [data-theme="light"] .app-card__desc {
      color: #667085;
    }
    [data-theme="light"] .pill--soft {
      background: rgba(255, 255, 255, 0.78);
      border-color: rgba(99, 102, 241, 0.12);
      color: #5b6475;
    }
    [data-theme="light"] .org-setup-card {
      background:
        radial-gradient(circle at top right, rgba(34, 211, 238, 0.18), transparent 32%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(243, 246, 255, 0.96));
      box-shadow: 0 36px 74px -40px rgba(79, 70, 229, 0.24), 0 18px 34px -24px rgba(15, 23, 42, 0.18);
    }
    [data-theme="light"] .org-setup-card__eyebrow {
      background: rgba(99, 102, 241, 0.1);
      color: #4338ca;
    }
    [data-theme="light"] .org-setup-option,
    [data-theme="light"] .org-setup-invite,
    [data-theme="light"] .org-setup-empty {
      background: rgba(255, 255, 255, 0.74);
      border-color: rgba(99, 102, 241, 0.12);
      box-shadow: 0 18px 32px -28px rgba(15, 23, 42, 0.18);
    }
    [data-theme="light"] .celebration-panel {
      border-color: rgba(99, 102, 241, 0.12);
      background:
        radial-gradient(circle at top left, rgba(16, 185, 129, 0.16), transparent 28%),
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.16), transparent 34%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(243, 246, 255, 0.96));
      box-shadow: 0 32px 88px rgba(15, 23, 42, 0.22);
    }
    [data-theme="light"] .celebration-kicker {
      background: rgba(139, 92, 246, 0.12);
      color: #6d28d9;
    }
    [data-theme="light"] .celebration-summary-card,
    [data-theme="light"] .celebration-app-chip {
      background: rgba(255, 255, 255, 0.78);
      border-color: rgba(99, 102, 241, 0.12);
      box-shadow: 0 18px 32px -28px rgba(15, 23, 42, 0.14);
    }
    [data-theme="light"] .celebration-footnote {
      color: #15803d;
    }
    @media (max-width: 720px) {
      body { padding: 16px 12px 32px; }
      .hub-hero { grid-template-columns: 1fr; }
      .hub-content { margin-top: 4px; }
      .section-title { font-size: 15px; margin: 16px 0 8px; }
      .org-setup-card {
        padding: 20px;
      }
      .org-setup-card__title {
        font-size: 26px;
      }
      .org-setup-actions {
        flex-direction: column;
        align-items: stretch;
      }
      .org-setup-actions .btn,
      .org-setup-actions .ghost-btn {
        width: 100%;
        text-align: center;
      }
      .org-setup-invite {
        align-items: stretch;
      }
      .celebration-shell {
        padding: 26px 20px 24px;
      }
      .celebration-title {
        font-size: 28px;
      }
      .celebration-actions {
        flex-direction: column;
        align-items: stretch;
      }
      .celebration-dismiss {
        width: 100%;
      }

      /* Organization card mobile layout */
      .org-top-strip {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 12px !important;
        padding: 16px !important;
      }
      .org-top-strip > div:first-child {
        gap: 12px !important;
      }
      .org-top-strip .org-icon {
        width: 40px !important;
        height: 40px !important;
      }
      .org-top-strip .org-name {
        font-size: 16px !important;
      }
      .org-actions-row {
        flex-wrap: wrap !important;
        gap: 8px !important;
      }
      .org-actions-row .ghost-btn {
        flex: 1;
        min-width: calc(33% - 6px);
        text-align: center;
        padding: 10px 8px !important;
        font-size: 12px !important;
      }
      .org-switch-btn {
        width: 100% !important;
        justify-content: center !important;
        margin-top: 4px;
      }
      .org-count-badge {
        display: none !important;
      }
      .org-divider {
        display: none !important;
      }

      /* Bottom strip mobile */
      .org-bottom-strip {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 12px !important;
        padding: 14px 16px !important;
      }
      .org-bottom-strip > div:first-child {
        gap: 10px !important;
      }
      .org-bottom-strip .settings-icon {
        width: 36px !important;
        height: 36px !important;
      }
      .org-bottom-strip .settings-title {
        font-size: 14px !important;
      }
      .org-bottom-strip .settings-desc {
        font-size: 12px !important;
      }
      .org-bottom-actions {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 8px !important;
      }
      .org-bottom-actions .ghost-btn {
        text-align: center;
        padding: 10px 8px !important;
        font-size: 12px !important;
      }

      /* App cards mobile */
      .app-grid {
        grid-template-columns: 1fr;
        gap: 10px;
      }
      .app-card {
        grid-template-columns: auto 1fr auto;
        padding: 14px;
        gap: 10px;
      }
      .app-card__icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
      }
      .app-card__icon svg { width: 20px; height: 20px; }
      .app-card__title { font-size: 15px; }
      .app-card__desc { font-size: 12px; }
      .app-card__meta { display: none; }
      .app-card__arrow { display: none; }
      .app-card:hover { transform: none; box-shadow: none; }

      /* Hide pill text on mobile, show shorter version */
      .pill--soft {
        font-size: 10px !important;
        padding: 4px 8px !important;
      }
    }

    @media (max-width: 400px) {
      body { padding: 12px 10px 24px; }
      .section-title { font-size: 14px; }
      .org-top-strip { padding: 14px !important; }
      .org-bottom-strip { padding: 12px 14px !important; }
      .ghost-btn {
        padding: 8px 6px !important;
        font-size: 11px !important;
      }
      .app-card { padding: 12px; }
      .app-card__title { font-size: 14px; }
      .app-card__desc { font-size: 11px; }
    }

    /* Modal Styles */
    .custom-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .custom-modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }
    .custom-modal {
      background: var(--panel-solid);
      border: 1px solid var(--border);
      border-radius: 24px;
      width: 90%;
      max-width: 440px;
      box-shadow: var(--card-shadow);
      transform: scale(0.92) translateY(8px);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      opacity: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .custom-modal-overlay.active .custom-modal {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
    .custom-modal-header {
      padding: 24px 24px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .custom-modal-title {
      font-size: 18px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.01em;
    }
    .custom-modal-close {
      background: transparent;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 8px;
      margin: -8px -8px -8px 0;
      border-radius: 99px;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .custom-modal-close:hover {
      background: var(--hover-bg);
      color: var(--text);
    }
    .custom-modal-body {
      padding: 8px 16px 24px;
      max-height: 60vh;
      overflow-y: auto;
    }
    .org-option-item {
      display: flex;
      align-items: center;
      width: 100%;
      padding: 12px 16px;
      margin-bottom: 4px;
      gap: 14px;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.15s ease;
      text-align: left;
      position: relative;
    }
    .org-option-item:hover {
      background: var(--hover-bg);
    }
    .org-option-item.active {
      background: rgba(99, 102, 241, 0.1);
      border-color: rgba(99, 102, 241, 0.2);
    }
    .org-option-avatar {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--panel-strong);
      display: grid;
      place-items: center;
      font-weight: 700;
      color: var(--text-secondary);
      font-size: 14px;
      flex-shrink: 0;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    .org-option-item.active .org-option-avatar {
      background: linear-gradient(135deg, #b980ff, #8b5cf6, #4c1d95);
      color: #fff;
      box-shadow: 0 4px 6px -1px rgba(99, 102, 241, 0.3);
    }
    .org-option-info { flex: 1; min-width: 0; }
    .org-option-name { font-weight: 600; color: var(--text); font-size: 15px; margin-bottom: 2px; }
    .org-option-role { font-size: 13px; color: var(--muted); text-transform: capitalize; }
  </style>
  <script src="/js/theme.js?v=2"></script>
  <% if (hasOrganizations) { %>
    <script src="/js/invitation-gatekeeper.js"></script>
  <% } %>
</head>

<body>
  <%- include('partials/nav', { activePage: 'home' }) %>
  <% const pendingSignatureCount = notificationSummary?.pendingSignatureCount || 0; %>
  <% const pendingSignatureDocuments = Array.isArray(notificationSummary?.pendingSignatureDocuments) ? notificationSummary.pendingSignatureDocuments : []; %>
  <% const pendingInviteRows = Array.isArray(pendingInvitations) ? pendingInvitations : []; %>

  <div class="container hub-content">
    <% if (accessError) { %>
      <div class="alert alert-error"><%= accessError %></div>
    <% } %>

    <% if (!hasOrganizations) { %>
      <section class="apps">
        <div class="section-title">Organization required</div>
        <div class="card org-setup-card">
          <div class="org-setup-card__eyebrow">Complete setup to continue</div>
          <h1 class="org-setup-card__title">Create an organization or accept an invite before you can use any apps.</h1>
          <p class="org-setup-card__copy">
            Your dashboard stays locked until your account belongs to an organization. Once you create one or join one, app access will appear here automatically.
          </p>

          <div class="org-setup-options">
            <div class="org-setup-option">
              <div class="org-setup-option__title">Create your own organization</div>
              <div class="org-setup-option__copy">
                Start a new workspace, become the owner, and unlock the IDP apps for that organization.
              </div>
            </div>
            <div class="org-setup-option">
              <div class="org-setup-option__title">Accept an invitation</div>
              <div class="org-setup-option__copy">
                <% if (pendingInvitationsCount > 0) { %>
                  You have <%= pendingInvitationsCount %> pending invitation<%= pendingInvitationsCount === 1 ? '' : 's' %> ready to accept.
                <% } else { %>
                  If another admin has invited you already, accept it here and your apps will unlock immediately.
                <% } %>
              </div>
            </div>
          </div>

          <div class="org-setup-actions">
            <button type="button" class="btn btn-primary" onclick="showCreateModal()">Create Organization</button>
            <a href="/invitations/pending" class="ghost-btn">
              <%= pendingInvitationsCount > 0 ? `View Invitations (${pendingInvitationsCount})` : 'Check Invitations' %>
            </a>
          </div>

          <% if (pendingInviteRows.length > 0) { %>
            <div class="org-setup-invites">
              <% pendingInviteRows.forEach(invite => { %>
                <div class="org-setup-invite" data-home-invite-id="<%= invite.id %>">
                  <div>
                    <div class="org-setup-invite__title"><%= invite.organization.name %></div>
                    <% if (invite.organization.description) { %>
                      <div class="org-setup-invite__desc"><%= invite.organization.description %></div>
                    <% } %>
                    <div class="org-setup-invite__meta">
                      <span class="role-badge role-<%= invite.role %>"><%= invite.role %></span>
                      <span class="pill pill--soft"><%= invite.appAccessLabel || 'All apps' %></span>
                      <span>Invited by <%= invite.invitedBy?.name || invite.invitedBy?.email || 'Unknown' %></span>
                      <span>Expires <%= new Date(invite.expiresAt).toLocaleDateString() %></span>
                      <% if (invite.appAccess && invite.appAccess.mode === 'selected' && invite.appAccessAppNames && invite.appAccessAppNames.length > 0) { %>
                        <span>Apps: <%= invite.appAccessAppNames.join(', ') %></span>
                      <% } %>
                    </div>
                  </div>
                  <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                    <button
                      type="button"
                      class="btn btn-primary"
                      data-invite-id="<%= invite.id %>"
                      data-org-name="<%= invite.organization.name %>"
                      onclick="acceptDashboardInvite(this)">
                      Accept Invite
                    </button>
                    <a href="/invitations/pending" class="ghost-btn">View Details</a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="org-setup-empty">
              No invitations are waiting right now. Create an organization to unlock the dashboard.
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <% if (currentSubscriptionAccess && currentSubscriptionAccess.showExpiryReminder) { %>
      <div class="card subscription-reminder-card">
        <div>
          <div style="font-weight: 700; font-size: 16px;">Plan expiry reminder</div>
          <div style="color: var(--muted); font-size: 14px; margin-top: 4px;">
            <%= currentSubscriptionAccess.planName || 'Your current plan' %> for <%= currentSubscriptionAccess.organizationName %> expires
            <strong style="color: var(--text);"><%= currentSubscriptionAccess.daysUntilExpiry === 0 ? 'today' : `in ${currentSubscriptionAccess.daysUntilExpiry} day${currentSubscriptionAccess.daysUntilExpiry === 1 ? '' : 's'}` %></strong>.
            Request another plan now to avoid access being locked.
          </div>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a href="/plans" class="btn btn-primary">Request a Plan</a>
          <a href="/subscription" class="ghost-btn">Open Subscription</a>
        </div>
      </div>
    <% } %>

    <% if (hasOrganizations && currentSubscriptionAccess && currentSubscriptionAccess.isLocked) { %>
      <section class="apps">
        <div class="section-title">Plan action required</div>
        <div class="card org-setup-card subscription-lock-card">
          <div class="org-setup-card__eyebrow subscription-lock-kicker">Access locked</div>
          <h1 class="org-setup-card__title">You need an active plan before this organization can use the IDP apps.</h1>
          <p class="org-setup-card__copy">
            <strong style="color: var(--text);"><%= currentSubscriptionAccess.organizationName %></strong>
            <% if (currentSubscriptionAccess.status === 'grace_period' || currentSubscriptionAccess.status === 'expired') { %>
              no longer has an active plan. Access is restricted immediately after expiry.
            <% } else if (currentSubscriptionAccess.status === 'suspended') { %>
              has a suspended subscription. Access is restricted until a new active plan is in place.
            <% } else { %>
              does not currently have an active plan. Request another plan to restore access.
            <% } %>
          </p>

          <div class="celebration-summary">
            <div class="celebration-summary-card">
              <div class="celebration-summary-label">Organization</div>
              <div class="celebration-summary-value"><%= currentSubscriptionAccess.organizationName %></div>
            </div>
            <div class="celebration-summary-card">
              <div class="celebration-summary-label">Previous Plan</div>
              <div class="celebration-summary-value"><%= currentSubscriptionAccess.planName || 'No active plan' %></div>
            </div>
            <div class="celebration-summary-card">
              <div class="celebration-summary-label">Access Status</div>
              <div class="celebration-summary-value"><%= currentSubscriptionAccess.status === 'grace_period' ? 'Expired' : (currentSubscriptionAccess.status || 'none').replace('_', ' ') %></div>
            </div>
          </div>

          <% if (currentSubscriptionAccess.pendingRequest) { %>
            <div class="subscription-lock-note">
              A request for <strong style="color: var(--text);"><%= currentSubscriptionAccess.pendingRequest.planName %></strong> is already pending approval.
              Access stays locked until that request is approved.
            </div>
          <% } else { %>
            <div class="subscription-lock-note">
              Request another plan to restore access. If you belong to more than one organization, you can switch to another active organization from here.
            </div>
          <% } %>

          <div class="org-setup-actions">
            <% if (currentSubscriptionAccess.pendingRequest) { %>
              <a href="/subscription" class="btn btn-primary">Review Request Status</a>
            <% } else { %>
              <a href="/plans" class="btn btn-primary">Request Another Plan</a>
            <% } %>
            <a href="/subscription" class="ghost-btn">Open Subscription</a>
            <a href="/organizations" class="ghost-btn">Organizations</a>
            <% if (organizations && organizations.length > 1) { %>
              <button type="button" class="ghost-btn" onclick="openOrgModal()">Switch Organization</button>
            <% } %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (hasOrganizations && !(currentSubscriptionAccess && currentSubscriptionAccess.isLocked)) { %>
    <% if (notificationSummary && notificationSummary.totalUnread > 0) { %>
      <div class="card" style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom: 24px; border-color: rgba(99, 102, 241, 0.35);">
        <div>
          <div style="font-weight: 700; font-size: 16px;">You have pending notifications</div>
          <div style="color: var(--muted); font-size: 14px; margin-top: 4px;">
            <%= notificationSummary.totalUnread %> task<%= notificationSummary.totalUnread === 1 ? '' : 's' %> need your attention.
          </div>
          <div style="margin-top: 8px; display:flex; align-items:center; gap: 8px; flex-wrap: wrap;">
            <span class="pill pill--soft">Documents: <%= notificationSummary.counts?.documents || 0 %></span>
            <span class="pill pill--soft">Simple Evaluation: <%= notificationSummary.counts?.simplePerformance || 0 %></span>
          </div>
        </div>
        <a href="/notifications" class="btn btn-primary">Open Notifications</a>
      </div>
    <% } %>

    <% if (pendingSignatureCount > 0) { %>
      <div class="card" style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom: 24px;">
        <div>
          <div style="font-weight: 700; font-size: 16px;">Documents waiting for your signature</div>
          <div style="color: var(--muted); font-size: 14px; margin-top: 4px;">
            You have <%= pendingSignatureCount %> pending document<%= pendingSignatureCount === 1 ? '' : 's' %> to sign.
          </div>
          <% if (pendingSignatureDocuments.length > 0) { %>
            <div style="margin-top: 8px; font-size: 13px; color: var(--muted);">
              <% pendingSignatureDocuments.slice(0, 3).forEach(doc => { %>
                <span style="display:inline-flex; align-items:center; gap:6px; margin-right: 12px;">
                  <span class="dot" style="width:8px;height:8px;box-shadow:none;background:#f59e0b;"></span>
                  <%= doc.title %> • <%= doc.organizationName || 'Organization' %>
                </span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <a href="/profile/documents?status=needs_action" class="btn btn-primary">Review &amp; Sign</a>
      </div>
    <% } else if (pendingOnboardingCount && pendingOnboardingCount > 0) { %>
      <div class="card" style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom: 24px;">
        <div>
          <div style="font-weight: 700; font-size: 16px;">Documents need your attention</div>
          <div style="color: var(--muted); font-size: 14px; margin-top: 4px;">
            You have <%= pendingOnboardingCount %> pending document step<%= pendingOnboardingCount === 1 ? '' : 's' %> waiting.
          </div>
          <% if (pendingOnboardingAssignments && pendingOnboardingAssignments.length > 0) { %>
            <div style="margin-top: 8px; font-size: 13px; color: var(--muted);">
              <% pendingOnboardingAssignments.slice(0, 3).forEach(assignment => { %>
                <span style="display:inline-flex; align-items:center; gap:6px; margin-right: 12px;">
                  <span class="dot" style="width:8px;height:8px;box-shadow:none;background:#f59e0b;"></span>
                  <%= assignment.organization?.name || 'Organization' %>
                </span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <a href="/documents" class="btn btn-primary">Open Documents Workspace</a>
      </div>
    <% } %>

    <% if (receivedEvaluationCount && receivedEvaluationCount > 0) { %>
      <div class="card" style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom: 24px;">
        <div>
          <div style="font-weight: 700; font-size: 16px;">New performance feedback available</div>
          <div style="color: var(--muted); font-size: 14px; margin-top: 4px;">
            You have <%= receivedEvaluationCount %> performance evaluation<%= receivedEvaluationCount === 1 ? '' : 's' %> available for review.
          </div>
          <% if (latestReceivedEvaluations && latestReceivedEvaluations.length > 0) { %>
            <div style="margin-top: 8px; font-size: 13px; color: var(--muted);">
              <% latestReceivedEvaluations.forEach(entry => { %>
                <span style="display:inline-flex; align-items:center; gap:6px; margin-right: 12px; margin-bottom: 6px;">
                  <span class="dot" style="width:8px;height:8px;box-shadow:none;background:#7c3aed;"></span>
                  <strong style="color: var(--text);"><%= entry.evaluatorName || entry.evaluatorEmail || 'Manager' %></strong>
                  <span><%= new Date(entry.evaluationDate || entry.createdAt).toLocaleDateString() %></span>
                  <span>Avg <%= Number(entry.averageRating || 0).toFixed(2) %>/5</span>
                </span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <a href="/performance-evaluations?view=overview&reviewed=me" class="btn btn-primary">View My Evaluations</a>
      </div>
    <% } %>

    <section class="apps">
      <div class="section-title">Manage identity & access</div>

      <% if (organizations && organizations.length > 0) { %>
      <% const currentOrg = organizations.find(o => o.isCurrent) %>
      <div class="card hub-card" style="padding: 0; margin-bottom: 24px; overflow: hidden; display: flex; flex-direction: column; gap: 0;">
        <!-- Top Strip: Current Org & Switcher -->
        <div class="org-top-strip" style="padding: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; border-bottom: 1px solid var(--border); background: var(--hover-bg);">
          <div style="display: flex; align-items: center; gap: 16px;">
            <div class="org-icon" style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #b980ff, #8b5cf6, #4c1d95); display: grid; place-items: center;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M3 21h18M5 21V7l8-4 8 4v14M8 21v-4h8v4" />
              </svg>
            </div>
            <div>
              <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 4px;">Current Organization</div>
              <div class="org-name" style="font-size: 18px; font-weight: 700; color: var(--text);"><%= currentOrg ? currentOrg.name : 'Select Organization' %></div>
            </div>
          </div>

          <div class="org-actions-row" style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <% if (currentOrg) { %>
              <a href="/organizations/<%= currentOrg.id %>/members" class="ghost-btn">Members</a>
              <a href="/organizations/<%= currentOrg.id %>/teams" class="ghost-btn">Teams</a>
              <% if (['owner', 'admin'].includes(currentOrg.role)) { %>
                <a href="/organizations/<%= currentOrg.id %>/invitations" class="ghost-btn">Invites</a>
              <% } %>
              <div class="org-divider" style="width: 1px; height: 24px; background: var(--border); margin: 0 4px;"></div>
            <% } %>
            <button onclick="openOrgModal()" style="
              display: flex; align-items: center; gap: 10px; padding: 10px 16px;
              background: var(--panel-strong); border: 1px solid var(--border);
              border-radius: 8px; color: var(--text); font-weight: 500; font-size: 14px; cursor: pointer;
              transition: all 0.2s;
            " class="org-switch-btn">
              <span>Switch...</span>
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="org-count-badge" style="padding: 10px 14px; background: var(--panel-strong); border-radius: 8px; border: 1px solid var(--border); display: flex; align-items: center; gap: 8px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
              <span style="font-size: 13px; font-weight: 600; color: var(--text);"><%= organizations.length %> Org<%= organizations.length === 1 ? '' : 's' %></span>
            </div>
          </div>
        </div>

        <!-- Bottom Strip: Settings & Actions -->
        <div class="org-bottom-strip" style="padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; background: var(--panel);">
          <div style="display: flex; align-items: center; gap: 14px;">
            <div class="settings-icon" style="width: 40px; height: 40px; border-radius: 10px; background: rgba(99, 102, 241, 0.1); display: grid; place-items: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2.5">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <div>
              <div class="settings-title" style="font-weight: 600; color: var(--text); font-size: 15px;">Organization Settings</div>
              <div class="settings-desc" style="font-size: 13px; color: var(--muted);">Manage your organization structure and team access</div>
            </div>
          </div>

          <div class="org-bottom-actions" style="display: flex; gap: 8px; flex-wrap: wrap;">
            <a href="/profile" class="ghost-btn">Profile</a>
            <a href="/organizations" class="ghost-btn">Orgs</a>
            <a href="/invitations/pending" class="ghost-btn">Invites</a>
          </div>
        </div>
      </div>
      <% } %>
    </section>

    <section class="apps">
      <div class="section-title">Choose an app to launch with single sign-on</div>
      <% if (apps && apps.length > 0) { %>
        <div class="app-grid">
          <a href="/documents" class="card app-card app-card--primary" style="--app-color: #0ea5e9;">
            <div class="app-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="8" y1="13" x2="16" y2="13"></line>
                <line x1="8" y1="17" x2="13" y2="17"></line>
              </svg>
            </div>
            <div class="app-card__body">
              <div class="app-card__title">
                Document Workspace
                <span class="app-card__badge" style="background: linear-gradient(135deg, #6366f1, #8b5cf6);">Core</span>
              </div>
              <div class="app-card__desc">Onboarding, agreements, policy acknowledgements, and document signing in one flow.</div>
              <div class="app-card__meta">
                <span class="pill pill--soft">Inside IDP</span>
              </div>
            </div>
            <div class="app-card__arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
          <a href="/performance-evaluations" class="card app-card" style="--app-color: #8b5cf6;">
            <div class="app-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 3v18h18"></path>
                <path d="M7 15l4-4 3 3 4-5"></path>
                <circle cx="7" cy="15" r="1.2"></circle>
                <circle cx="11" cy="11" r="1.2"></circle>
                <circle cx="14" cy="14" r="1.2"></circle>
                <circle cx="18" cy="9" r="1.2"></circle>
              </svg>
            </div>
            <div class="app-card__body">
              <div class="app-card__title">
                Simple Evaluation
                <span class="app-card__badge" style="background: linear-gradient(135deg, #8b5cf6, #6366f1);">Core</span>
              </div>
              <div class="app-card__desc">Quick hierarchy-aware review forms and history inside IDP.</div>
              <div class="app-card__meta">
                <span class="pill pill--soft">Inside IDP</span>
              </div>
            </div>
            <div class="app-card__arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
          <a href="<%= simpleLmsExternalWorkspaceUrl %>" target="_blank" rel="noopener noreferrer" class="card app-card" style="--app-color: #06b6d4;">
            <div class="app-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14l-8-4-8 4z"></path>
                <path d="M8 9h8"></path>
                <path d="M8 12h6"></path>
              </svg>
            </div>
            <div class="app-card__body">
              <div class="app-card__title">
                Simple LMS
                <span class="app-card__badge" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">Core</span>
              </div>
              <div class="app-card__desc">Course creation, assignment, programs, and team-aware learning progress in the external Seemplify Learning app.</div>
              <div class="app-card__meta">
                <span class="pill pill--soft">External app</span>
              </div>
            </div>
            <div class="app-card__arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
          <% apps.forEach(app => { %>
            <% if (app.isBeta) { %>
              <div onclick="showBetaWarning('<%= app.appId %>', '<%= app.name %>')" class="card app-card <%= app.appId === 'smarthr' ? 'app-card--primary' : '' %>" style="--app-color: <%= app.color || '#6366f1' %>; cursor: pointer;">
                <div class="app-card__icon"><%- app.iconSvg %></div>
                <div class="app-card__body">
                  <div class="app-card__title">
                    <%= app.name %>
                    <% if (app.badge) { %><span class="app-card__badge"><%= app.badge %></span><% } %>
                  </div>
                  <div class="app-card__desc"><%= app.description || 'Secure single sign-on' %></div>
                  <div class="app-card__meta">
                    <span class="pill pill--soft">Instant launch</span>
                  </div>
                </div>
                <div class="app-card__arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            <% } else { %>
              <a href="/launch/<%= app.appId %>" class="card app-card <%= app.appId === 'smarthr' ? 'app-card--primary' : '' %>" style="--app-color: <%= app.color || '#6366f1' %>">
                <div class="app-card__icon"><%- app.iconSvg %></div>
                <div class="app-card__body">
                  <div class="app-card__title">
                    <%= app.name %>
                    <% if (app.badge) { %><span class="app-card__badge"><%= app.badge %></span><% } %>
                  </div>
                  <div class="app-card__desc"><%= app.description || 'Secure single sign-on' %></div>
                  <div class="app-card__meta">
                    <span class="pill pill--soft">Instant launch</span>
                  </div>
                </div>
                <div class="app-card__arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </a>
            <% } %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty">
          <div style="margin-bottom:8px;font-weight:700;">No apps available yet</div>
          Add an app to launch it from the hub.
        </div>
      <% } %>

      <% if (comingSoonCards && comingSoonCards.length > 0) { %>
        <div class="section-title" style="margin-top: 32px;">Coming soon</div>
        <div class="app-grid">
          <% comingSoonCards.forEach(card => { %>
            <div class="card app-card app-card--coming-soon" style="--app-color: <%= card.color || '#94a3b8' %>">
              <div class="app-card__icon"><%- card.iconSvg %></div>
              <div class="app-card__body">
                <div class="app-card__title">
                  <%= card.name %>
                  <span class="coming-soon-badge">Coming soon</span>
                </div>
                <div class="app-card__desc"><%= card.description || 'Secure single sign-on' %></div>
              </div>
              <div class="app-card__arrow" style="opacity: 0.5;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
    <% } %>
  </div>

  <!-- Create Organization Modal -->
  <div class="modal" id="createModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Create Organization</h2>
        <button class="modal-close" onclick="hideCreateModal()">&times;</button>
      </div>
      <form action="/api/organizations" method="POST" id="createForm">
        <div class="form-group">
          <label for="name">Organization Name *</label>
          <input type="text" id="name" name="name" required maxlength="100" placeholder="Enter organization name">
        </div>
        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" maxlength="500" placeholder="Brief description (optional)"></textarea>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-secondary" onclick="hideCreateModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Create</button>
        </div>
      </form>
    </div>
  </div>

  <div id="trialWelcomeModal" class="celebration-modal" hidden></div>

  <% if (hasOrganizations) { %>
  <!-- Organization Switch Modal -->
  <div id="customOrgModal" class="custom-modal-overlay">
    <div class="custom-modal" onclick="event.stopPropagation()">
      <div class="custom-modal-header">
        <div class="custom-modal-title">Switch Organization</div>
        <button class="custom-modal-close" onclick="closeCustomOrgModal()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="custom-modal-body">
        <% if (organizations) { organizations.forEach(org => { %>
          <button onclick="switchOrganization('<%= org.id %>')" class="org-option-item <%= org.isCurrent ? 'active' : '' %>">
            <div class="org-option-avatar"><%= org.name.substring(0, 2).toUpperCase() %></div>
            <div class="org-option-info">
              <div class="org-option-name"><%= org.name %></div>
              <div class="org-option-role"><%= org.role %></div>
            </div>
            <% if (org.isCurrent) { %>
              <div style="color: var(--brand);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
            <% } %>
          </button>
        <% }) } %>
      </div>
    </div>
  </div>
  <form id="org-switch-form" method="POST" style="display: none;"></form>

  <!-- Beta Warning Modal -->
  <div id="betaWarningModal" class="custom-modal-overlay">
    <div class="custom-modal" onclick="event.stopPropagation()">
      <div class="custom-modal-header">
        <div class="custom-modal-title" style="display: flex; align-items: center; gap: 10px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2">
            <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          Beta Product Warning
        </div>
        <button class="custom-modal-close" onclick="closeBetaWarningModal()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="custom-modal-body">
        <div style="text-align: center; padding: 8px 0;">
          <p style="color: var(--text); font-size: 15px; line-height: 1.6; margin-bottom: 16px;">
            <strong><span id="betaAppName"></span></strong> is currently in <span style="color: #f59e0b; font-weight: 600;">Beta</span> and testing.
          </p>
          <p style="color: var(--muted); font-size: 14px; line-height: 1.6; margin-bottom: 20px;">
            You may encounter bugs, experience slow performance, or see features that are still under development. Your feedback is valuable to us!
          </p>
          <div style="display: flex; gap: 12px; justify-content: center;">
            <button onclick="closeBetaWarningModal()" class="ghost-btn" style="min-width: 100px;">
              Cancel
            </button>
            <button onclick="proceedToBetaApp()" class="btn btn-primary" style="min-width: 100px;">
              Proceed Anyway
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <script>
    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function persistTrialWelcome(payload) {
      if (!payload) return;

      try {
        sessionStorage.setItem('trialWelcome', JSON.stringify(payload));
      } catch (error) {
        console.warn('Could not persist trial welcome payload:', error);
      }
    }

    function consumeTrialWelcome() {
      try {
        const raw = sessionStorage.getItem('trialWelcome');
        if (!raw) return null;
        sessionStorage.removeItem('trialWelcome');
        return JSON.parse(raw);
      } catch (error) {
        sessionStorage.removeItem('trialWelcome');
        return null;
      }
    }

    function formatTrialDate(value) {
      if (!value) return '';

      try {
        return new Date(value).toLocaleDateString(undefined, {
          day: 'numeric',
          month: 'short',
          year: 'numeric'
        });
      } catch (error) {
        return '';
      }
    }

    function closeTrialWelcome() {
      const modal = document.getElementById('trialWelcomeModal');
      if (!modal) return;

      modal.classList.remove('active');
      document.body.style.overflow = '';
      window.removeEventListener('keydown', handleTrialWelcomeEscape);
      if (modal.__trialWelcomeClickHandler) {
        modal.removeEventListener('click', modal.__trialWelcomeClickHandler);
        modal.__trialWelcomeClickHandler = null;
      }

      setTimeout(() => {
        modal.hidden = true;
        modal.innerHTML = '';
      }, 280);
    }

    function handleTrialWelcomeEscape(event) {
      if (event.key === 'Escape') {
        closeTrialWelcome();
      }
    }

    function showTrialWelcome(payload) {
      const modal = document.getElementById('trialWelcomeModal');
      if (!modal || !payload) return;

      const appChips = Array.isArray(payload.accessibleApps)
        ? payload.accessibleApps.map((appName) => `<span class="celebration-app-chip">${escapeHtml(appName)}</span>`).join('')
        : '';
      const trialDays = Number(payload.trialDays || 7);
      const expiresLabel = formatTrialDate(payload.expiresAt);
      const confettiColors = ['#b980ff', '#a855f7', '#7c3aed', '#6366f1', '#ec4899', '#4c1d95'];
      const confettiMarkup = Array.from({ length: 18 }, (_, index) => {
        const color = confettiColors[index % confettiColors.length];
        return `<span class="celebration-confetti-piece" style="--piece:${index};--piece-color:${color};"></span>`;
      }).join('');

      modal.innerHTML = `
        <div class="celebration-panel" role="dialog" aria-modal="true" aria-labelledby="trialWelcomeTitle">
          <div class="celebration-confetti">${confettiMarkup}</div>
          <div class="celebration-shell">
            <div class="celebration-kicker">Congratulations</div>
            <div class="celebration-icon">✨</div>
            <h2 class="celebration-title" id="trialWelcomeTitle">${escapeHtml(payload.headline || 'Your organization is ready.')}</h2>
            <p class="celebration-copy">${escapeHtml(payload.subheadline || `We've assigned your organization the default Free Trial for ${trialDays} days.`)}</p>
            <div class="celebration-summary">
              <div class="celebration-summary-card">
                <div class="celebration-summary-label">Assigned Plan</div>
                <div class="celebration-summary-value">${escapeHtml(payload.planName || 'Free Trial')}</div>
              </div>
              <div class="celebration-summary-card">
                <div class="celebration-summary-label">Access Window</div>
                <div class="celebration-summary-value">${trialDays} day${trialDays === 1 ? '' : 's'}</div>
              </div>
              <div class="celebration-summary-card">
                <div class="celebration-summary-label">Expires</div>
                <div class="celebration-summary-value">${escapeHtml(expiresLabel || 'Soon')}</div>
              </div>
            </div>
            <div class="celebration-apps-title">${escapeHtml(payload.accessSummary || 'You can now explore every app in the workspace during your trial.')}</div>
            <div class="celebration-apps-grid">${appChips}</div>
            <div class="celebration-footnote">${escapeHtml(payload.closingMessage || 'Happy exploring.')}</div>
            <div class="celebration-actions">
              <div style="color: var(--muted); font-size: 13px;">Your new organization is ready to use immediately.</div>
              <button type="button" class="btn btn-primary celebration-dismiss" data-trial-welcome-close>Start Exploring</button>
            </div>
          </div>
        </div>
      `;

      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => modal.classList.add('active'));

      if (modal.__trialWelcomeClickHandler) {
        modal.removeEventListener('click', modal.__trialWelcomeClickHandler);
      }
      modal.__trialWelcomeClickHandler = (event) => {
        if (event.target === modal || event.target.closest('[data-trial-welcome-close]')) {
          closeTrialWelcome();
        }
      };
      modal.addEventListener('click', modal.__trialWelcomeClickHandler);

      window.addEventListener('keydown', handleTrialWelcomeEscape);
    }

    function showCreateModal() {
      const modal = document.getElementById('createModal');
      if (modal) {
        modal.classList.add('active');
      }
    }

    function hideCreateModal() {
      const modal = document.getElementById('createModal');
      if (modal) {
        modal.classList.remove('active');
      }
    }

    async function acceptDashboardInvite(button) {
      const inviteId = button?.dataset?.inviteId;
      const orgName = button?.dataset?.orgName || 'this organization';
      if (!inviteId) return;

      if (!confirm(`Accept invitation to join ${orgName}?`)) return;

      button.disabled = true;
      button.textContent = 'Accepting...';

      try {
        const response = await fetch(`/api/invitations/accept/${inviteId}`, {
          method: 'POST',
          credentials: 'same-origin'
        });
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Failed to accept invitation');
        }

        window.location.href = '/';
      } catch (error) {
        alert(error.message || 'Failed to accept invitation');
        button.disabled = false;
        button.textContent = 'Accept Invite';
      }
    }

    const createForm = document.getElementById('createForm');
    if (createForm) {
      createForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(createForm);

        try {
          const response = await fetch('/api/organizations', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              name: formData.get('name'),
              description: formData.get('description')
            })
          });
          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || 'Failed to create organization');
          }

          persistTrialWelcome(data.trialWelcome);
          window.location.href = '/';
        } catch (error) {
          alert(error.message || 'Failed to create organization');
        }
      });
    }

    const createModal = document.getElementById('createModal');
    if (createModal) {
      createModal.addEventListener('click', (e) => {
        if (e.target.classList.contains('modal')) {
          hideCreateModal();
        }
      });
    }

    const pendingTrialWelcome = consumeTrialWelcome();
    if (pendingTrialWelcome) {
      showTrialWelcome(pendingTrialWelcome);
    }

    function openOrgModal() {
      const modal = document.getElementById('customOrgModal');
      modal.classList.add('active');

      modal.onclick = (e) => {
        if (e.target === modal) closeCustomOrgModal();
      };

      document.onkeydown = (e) => {
        if (e.key === 'Escape') closeCustomOrgModal();
      };
    }

    function closeCustomOrgModal() {
      const modal = document.getElementById('customOrgModal');
      modal.classList.remove('active');
      document.onkeydown = null;
    }

    function switchOrganization(orgId) {
      const form = document.getElementById('org-switch-form');
      form.action = '/organizations/' + orgId + '/switch';
      form.submit();
    }

    let pendingBetaAppId = null;

    function showBetaWarning(appId, appName) {
      pendingBetaAppId = appId;
      document.getElementById('betaAppName').textContent = appName;
      const modal = document.getElementById('betaWarningModal');
      modal.classList.add('active');

      modal.onclick = (e) => {
        if (e.target === modal) closeBetaWarningModal();
      };

      document.onkeydown = (e) => {
        if (e.key === 'Escape') closeBetaWarningModal();
      };
    }

    function closeBetaWarningModal() {
      const modal = document.getElementById('betaWarningModal');
      modal.classList.remove('active');
      document.onkeydown = null;
      pendingBetaAppId = null;
    }

    function proceedToBetaApp() {
      if (pendingBetaAppId) {
        window.location.href = '/launch/' + pendingBetaAppId;
      }
    }
  </script>
</body>

</html>
