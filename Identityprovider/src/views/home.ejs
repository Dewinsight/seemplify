<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title><%= brand.name %> - Your Apps</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&amp;family=Instrument+Serif:ital@0;1&amp;display=swap" rel="stylesheet">
  <style>
    <%- include('../public/css/idp-theme.css') %>
  </style>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    /* Hub-specific tune-ups: reduce noise + keep clean backdrop */
    body { padding: 28px 18px 48px; }
    body::before { opacity: var(--halo-opacity); }
    body::after { display: none; }
    .hub-content { margin-top: 8px; }
    .hub-hero {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 14px;
      margin: 14px 0 20px;
    }
    .hub-card { position: relative; }
    .hub-card h1 { margin: 0 0 6px; font-size: 26px; letter-spacing: -0.02em; color: var(--text); }
    .hub-card p { margin: 0; color: var(--muted); font-size: 15px; }
    .hub-card .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .hub-card .chip { background: var(--panel-strong); border: 1px solid var(--border); }
    .hub-card .chip.secondary { color: var(--brand-2); }
    .stat { display: flex; align-items: center; gap: 8px; margin-top: 12px; color: var(--text); font-weight: 600; }
    .dot { width: 10px; height: 10px; border-radius: 999px; background: var(--success, #8b5cf6); box-shadow: 0 0 0 6px rgba(139,92,246,0.14); }

    .apps { width: 100%; display: block; margin-top: 18px; }
    .section-title {
      margin: 22px 0 10px;
      color: var(--text);
      font-weight: 700;
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .ghost-btn {
      padding: 8px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--panel-strong);
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      font-size: 13px;
    }
    .ghost-btn:hover { background: var(--hover-bg); }

    .app-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
    .app-card {
      text-decoration: none;
      color: inherit;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 12px;
      padding: 16px;
      cursor: pointer;
      transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }
    .app-card:hover { box-shadow: 0 18px 36px rgba(0,0,0,0.35); transform: translateY(-3px); }
    .app-card--primary { border-color: rgba(99,102,241,0.65); box-shadow: 0 18px 42px rgba(99,102,241,0.22); }
    .app-card--primary:hover { border-color: rgba(99,102,241,0.8); box-shadow: 0 22px 46px rgba(99,102,241,0.32); }
    .app-card__icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: color-mix(in srgb, var(--app-color, var(--brand, #6366f1)) 18%, transparent);
      display: grid;
      place-items: center;
      color: var(--app-color, var(--brand, #6366f1));
      border: 1px solid color-mix(in srgb, var(--app-color, var(--brand, #6366f1)) 32%, transparent);
      transition: transform 0.25s ease, background-color 0.25s ease;
    }
    .app-card:hover .app-card__icon {
      transform: scale(1.06);
      background: color-mix(in srgb, var(--app-color, var(--brand, #6366f1)) 26%, transparent);
    }
    .app-card__icon svg { width: 22px; height: 22px; }
    .app-card__body { display: grid; gap: 6px; }
    .app-card__title { font-weight: 700; font-size: 16px; letter-spacing: -0.01em; color: var(--text); display: flex; align-items: center; gap: 8px; }
    .app-card__badge {
      font-size: 10px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 10px;
      background: linear-gradient(135deg, #f59e0b, #ef4444);
      color: white;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 2px 4px rgba(245, 158, 11, 0.3);
    }
    .app-card--coming-soon {
      opacity: 0.85;
      cursor: default;
      pointer-events: none;
      border-style: dashed;
    }
    .app-card--coming-soon:hover { transform: none; box-shadow: none; }
    .coming-soon-badge {
      font-size: 10px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 10px;
      background: var(--panel-strong);
      border: 1px solid var(--border);
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .app-card__desc { color: var(--muted); font-size: 13px; line-height: 1.55; }
    .app-card__meta { display: flex; gap: 6px; flex-wrap: wrap; }
    .pill { background: var(--panel-strong); border: 1px solid var(--border); color: var(--text-secondary); }
    .pill--soft { background: var(--hover-bg); color: var(--muted); border-color: var(--border); }
    .app-card__arrow {
      color: var(--muted);
      opacity: 0.6;
      transition: transform 0.2s ease, opacity 0.2s ease, color 0.2s ease;
    }
    .app-card:hover .app-card__arrow {
      transform: translateX(4px);
      opacity: 1;
      color: var(--text);
    }

    /* === Unified Org Hero Card === */
    .org-hero {
      padding: 24px 26px;
      margin-bottom: 24px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .org-hero__main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .org-hero__identity {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }
    .org-hero__icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: linear-gradient(135deg, #b980ff, #8b5cf6, #4c1d95);
      display: grid;
      place-items: center;
      flex-shrink: 0;
      box-shadow: 0 10px 24px -10px rgba(139, 92, 246, 0.5);
    }
    .org-hero__identity-text { min-width: 0; }
    .org-hero__eyebrow {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .org-hero__name {
      font-size: 19px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      line-height: 1.2;
    }
    .org-hero__role {
      text-transform: capitalize;
      font-size: 11px;
      font-weight: 600;
      padding: 3px 9px;
      letter-spacing: 0.01em;
    }
    .org-hero__switch {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .org-hero__count {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      padding: 6px 10px;
      border-radius: 999px;
      background: var(--panel-strong);
      border: 1px solid var(--border);
    }
    .org-hero__switch-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 16px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--panel-strong);
      color: var(--text);
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .org-hero__switch-btn:hover {
      background: var(--hover-bg);
      border-color: rgba(99, 102, 241, 0.32);
      transform: translateY(-1px);
    }
    .org-hero__actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }
    .org-hero__chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 13px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--panel-strong);
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      font-size: 12.5px;
      letter-spacing: -0.005em;
      transition: all 0.18s ease;
    }
    .org-hero__chip:hover {
      background: var(--hover-bg);
      border-color: rgba(99, 102, 241, 0.32);
      color: var(--text);
      transform: translateY(-1px);
    }
    .org-hero__chip svg { color: var(--muted); flex-shrink: 0; transition: color 0.18s ease; }
    .org-hero__chip:hover svg { color: var(--brand); }
    .org-hero__chip--ghost {
      background: transparent;
      border-color: transparent;
      color: var(--muted);
      padding-left: 10px;
      padding-right: 10px;
    }
    .org-hero__chip--ghost:hover {
      background: var(--hover-bg);
      color: var(--text);
    }
    .org-hero__sep {
      width: 1px;
      height: 18px;
      background: var(--border);
      margin: 0 4px;
    }
    @media (max-width: 720px) {
      .org-hero { padding: 18px; }
      .org-hero__main { gap: 12px; }
      .org-hero__icon { width: 40px; height: 40px; border-radius: 10px; }
      .org-hero__name { font-size: 17px; }
      .org-hero__switch { width: 100%; justify-content: flex-end; }
      .org-hero__actions { padding-top: 14px; }
      .org-hero__sep { display: none; }
    }

    /* === Action Banner (replaces inline notification cards) === */
    .action-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 16px;
      padding: 18px 22px 18px 26px;
      position: relative;
    }
    .action-banner::before {
      content: '';
      position: absolute;
      left: 12px;
      top: 18px;
      bottom: 18px;
      width: 3px;
      border-radius: 999px;
      background: var(--brand);
    }
    .action-banner--warn::before { background: #f59e0b; }
    .action-banner--review::before { background: #7c3aed; }
    .action-banner--lock::before { background: #ef4444; }
    .action-banner__title { font-weight: 700; font-size: 15.5px; color: var(--text); letter-spacing: -0.01em; }
    .action-banner__desc { font-size: 13.5px; color: var(--muted); margin-top: 4px; line-height: 1.55; }
    .action-banner__meta { margin-top: 10px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .action-banner__meta-row { font-size: 13px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 12px; row-gap: 4px; margin-top: 8px; }
    .action-banner__cta { display: flex; gap: 10px; flex-wrap: wrap; }

    .empty {
      margin-top: 12px;
      padding: 48px 16px;
      text-align: center;
      color: var(--muted);
      border: 1px dashed var(--border);
      border-radius: 14px;
      background: var(--hover-bg);
    }
    .org-setup-card {
      padding: 28px;
      border-color: rgba(99, 102, 241, 0.32);
      background:
        radial-gradient(circle at top right, rgba(34, 211, 238, 0.14), transparent 34%),
        linear-gradient(160deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.88));
    }
    .org-setup-card__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(99, 102, 241, 0.14);
      color: #c7d2fe;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .org-setup-card__title {
      margin: 18px 0 10px;
      font-size: 32px;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--text);
    }
    .org-setup-card__copy {
      max-width: 760px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.7;
    }
    .org-setup-options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 14px;
      margin-top: 22px;
    }
    .org-setup-option {
      padding: 18px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: rgba(15, 23, 42, 0.48);
    }
    .org-setup-option__title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }
    .org-setup-option__copy {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }
    .org-setup-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 20px;
    }
    .org-setup-invites {
      margin-top: 24px;
      display: grid;
      gap: 12px;
    }
    .org-setup-invite {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      padding: 18px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: rgba(15, 23, 42, 0.42);
    }
    .org-setup-invite__title {
      font-size: 17px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
    }
    .org-setup-invite__desc {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }
    .org-setup-invite__meta {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 10px;
      color: var(--muted);
      font-size: 13px;
    }
    .org-setup-empty {
      margin-top: 24px;
      padding: 18px;
      border-radius: 16px;
      border: 1px dashed var(--border);
      background: rgba(15, 23, 42, 0.24);
      color: var(--muted);
      text-align: center;
    }
    .subscription-reminder-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 24px;
      border-color: rgba(245, 158, 11, 0.35);
    }
    .subscription-lock-card {
      border-color: rgba(239, 68, 68, 0.28);
      background:
        radial-gradient(circle at top right, rgba(239, 68, 68, 0.16), transparent 34%),
        linear-gradient(160deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.9));
    }
    .subscription-lock-kicker {
      background: rgba(239, 68, 68, 0.14);
      color: #fecaca;
    }
    .subscription-lock-note {
      margin-top: 18px;
      padding: 16px 18px;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(15, 23, 42, 0.42);
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }
    .celebration-modal {
      position: fixed;
      inset: 0;
      z-index: 10050;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(2, 6, 23, 0.78);
      backdrop-filter: blur(10px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.28s ease, visibility 0.28s ease;
    }
    .celebration-modal.active {
      opacity: 1;
      visibility: visible;
    }
    .celebration-panel {
      position: relative;
      width: min(760px, 100%);
      border-radius: 28px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background:
        radial-gradient(circle at top left, rgba(16, 185, 129, 0.18), transparent 28%),
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.18), transparent 34%),
        linear-gradient(160deg, rgba(15, 23, 42, 0.98), rgba(15, 23, 42, 0.92));
      box-shadow: 0 28px 80px rgba(2, 6, 23, 0.54);
      transform: translateY(18px) scale(0.96);
      transition: transform 0.28s ease;
    }
    .celebration-modal.active .celebration-panel {
      transform: translateY(0) scale(1);
    }
    .celebration-confetti {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }
    .celebration-confetti-piece {
      position: absolute;
      top: -14%;
      left: calc((var(--piece) * 7%) + 4%);
      width: 12px;
      height: 22px;
      border-radius: 999px;
      opacity: 0.9;
      background: var(--piece-color, #b980ff);
      transform: rotate(calc((var(--piece) * 17deg) - 18deg));
      animation: confettiFall 3.6s ease-in infinite;
      animation-delay: calc(var(--piece) * 0.12s);
    }
    .celebration-shell {
      position: relative;
      padding: 34px 32px 30px;
    }
    .celebration-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(139, 92, 246, 0.14);
      color: #ddd6fe;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .celebration-icon {
      width: 72px;
      height: 72px;
      margin-top: 18px;
      border-radius: 24px;
      display: grid;
      place-items: center;
      font-size: 34px;
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(99, 102, 241, 0.22));
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 18px 40px rgba(139, 92, 246, 0.18);
      animation: celebrationPulse 2.8s ease-in-out infinite;
    }
    .celebration-title {
      margin: 18px 0 10px;
      font-size: 34px;
      line-height: 1.05;
      letter-spacing: -0.04em;
      color: var(--text);
    }
    .celebration-copy {
      margin: 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.75;
      max-width: 640px;
    }
    .celebration-summary {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 12px;
      margin-top: 22px;
    }
    .celebration-summary-card {
      padding: 16px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: rgba(15, 23, 42, 0.48);
    }
    .celebration-summary-label {
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .celebration-summary-value {
      margin-top: 8px;
      color: var(--text);
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .celebration-apps-title {
      margin-top: 24px;
      color: var(--text);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .celebration-apps-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 14px;
    }
    .celebration-app-chip {
      padding: 10px 14px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.06);
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
    }
    .celebration-footnote {
      margin-top: 18px;
      color: #bbf7d0;
      font-size: 15px;
      font-weight: 600;
    }
    .celebration-actions {
      margin-top: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
    }
    .celebration-dismiss {
      min-width: 180px;
    }
    @keyframes confettiFall {
      0% {
        transform: translate3d(0, -30px, 0) rotate(0deg);
        opacity: 0;
      }
      10% {
        opacity: 0.95;
      }
      100% {
        transform: translate3d(calc((var(--piece) - 6) * 7px), 420px, 0) rotate(420deg);
        opacity: 0;
      }
    }
    @keyframes celebrationPulse {
      0%, 100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.05);
      }
    }

    [data-theme="light"] .hub-content {
      position: relative;
    }
    [data-theme="light"] .hub-content::before {
      content: '';
      position: absolute;
      inset: 120px -28px auto -28px;
      height: 420px;
      background:
        radial-gradient(circle at 10% 12%, rgba(56, 189, 248, 0.14), transparent 34%),
        radial-gradient(circle at 82% 6%, rgba(99, 102, 241, 0.14), transparent 36%),
        radial-gradient(circle at 46% 62%, rgba(16, 185, 129, 0.1), transparent 32%);
      filter: blur(48px);
      opacity: 0.9;
      pointer-events: none;
      z-index: 0;
    }
    [data-theme="light"] .hub-content > * {
      position: relative;
      z-index: 1;
    }
    [data-theme="light"] .section-title::after {
      background: linear-gradient(90deg, rgba(99, 102, 241, 0.18), rgba(34, 211, 238, 0.08), transparent 72%);
    }
    [data-theme="light"] .ghost-btn {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(243, 246, 253, 0.94));
      border-color: rgba(99, 102, 241, 0.14);
      box-shadow: 0 16px 28px -24px rgba(15, 23, 42, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.84);
    }
    [data-theme="light"] .ghost-btn:hover {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(245, 248, 255, 0.98));
      border-color: rgba(99, 102, 241, 0.28);
      box-shadow: 0 20px 36px -24px rgba(79, 70, 229, 0.24);
    }
    [data-theme="light"] .hub-card {
      border-color: rgba(99, 102, 241, 0.14);
      box-shadow: 0 36px 74px -40px rgba(79, 70, 229, 0.24), 0 18px 34px -24px rgba(15, 23, 42, 0.18);
    }
    [data-theme="light"] .hub-card::after {
      background:
        radial-gradient(circle at 12% 16%, rgba(56, 189, 248, 0.1), transparent 32%),
        radial-gradient(circle at 86% 2%, rgba(99, 102, 241, 0.12), transparent 34%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0));
      opacity: 1;
    }
    [data-theme="light"] .org-top-strip {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.82) 0%, rgba(241, 246, 255, 0.94) 56%, rgba(236, 250, 247, 0.82) 100%) !important;
      border-bottom-color: rgba(99, 102, 241, 0.14) !important;
    }
    [data-theme="light"] .org-bottom-strip {
      background: linear-gradient(180deg, rgba(251, 253, 255, 0.94), rgba(244, 247, 253, 0.94)) !important;
    }
    [data-theme="light"] .org-icon {
      box-shadow: 0 24px 44px -26px rgba(99, 102, 241, 0.54);
    }
    [data-theme="light"] .settings-icon {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(34, 211, 238, 0.12)) !important;
      border: 1px solid rgba(99, 102, 241, 0.1);
      box-shadow: 0 18px 30px -24px rgba(79, 70, 229, 0.28);
    }
    [data-theme="light"] .org-switch-btn,
    [data-theme="light"] .org-count-badge {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(243, 246, 253, 0.94)) !important;
      border-color: rgba(99, 102, 241, 0.14) !important;
      box-shadow: 0 16px 28px -24px rgba(15, 23, 42, 0.2);
    }
    [data-theme="light"] .org-switch-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(99, 102, 241, 0.28) !important;
      box-shadow: 0 20px 36px -24px rgba(79, 70, 229, 0.24);
    }
    [data-theme="light"] .org-divider {
      background: linear-gradient(180deg, transparent, rgba(99, 102, 241, 0.18), transparent) !important;
    }
    [data-theme="light"] .app-card {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(245, 247, 255, 0.94));
      border-color: rgba(99, 102, 241, 0.14);
      box-shadow: 0 24px 44px -34px rgba(15, 23, 42, 0.22), 0 12px 24px -18px rgba(99, 102, 241, 0.16);
    }
    [data-theme="light"] .app-card:hover {
      box-shadow: 0 30px 56px -30px rgba(79, 70, 229, 0.28), 0 16px 28px -22px rgba(15, 23, 42, 0.18);
      border-color: rgba(99, 102, 241, 0.28);
      background: linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(242, 246, 255, 0.98));
    }
    [data-theme="light"] .app-card--primary {
      border-color: rgba(99, 102, 241, 0.34);
      box-shadow: 0 30px 58px -32px rgba(99, 102, 241, 0.24), 0 14px 24px -18px rgba(34, 211, 238, 0.18);
    }
    [data-theme="light"] .app-card--primary:hover {
      box-shadow: 0 34px 64px -28px rgba(99, 102, 241, 0.3), 0 18px 32px -22px rgba(34, 211, 238, 0.2);
    }
    [data-theme="light"] .app-card__icon {
      border-color: rgba(255, 255, 255, 0.76);
      box-shadow: 0 18px 30px -22px rgba(15, 23, 42, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.44);
    }
    [data-theme="light"] .app-card__desc {
      color: #667085;
    }
    [data-theme="light"] .pill--soft {
      background: rgba(255, 255, 255, 0.78);
      border-color: rgba(99, 102, 241, 0.12);
      color: #5b6475;
    }
    [data-theme="light"] .org-setup-card {
      background:
        radial-gradient(circle at top right, rgba(34, 211, 238, 0.18), transparent 32%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(243, 246, 255, 0.96));
      box-shadow: 0 36px 74px -40px rgba(79, 70, 229, 0.24), 0 18px 34px -24px rgba(15, 23, 42, 0.18);
    }
    [data-theme="light"] .org-setup-card__eyebrow {
      background: rgba(99, 102, 241, 0.1);
      color: #4338ca;
    }
    [data-theme="light"] .org-setup-option,
    [data-theme="light"] .org-setup-invite,
    [data-theme="light"] .org-setup-empty {
      background: rgba(255, 255, 255, 0.74);
      border-color: rgba(99, 102, 241, 0.12);
      box-shadow: 0 18px 32px -28px rgba(15, 23, 42, 0.18);
    }
    [data-theme="light"] .celebration-panel {
      border-color: rgba(99, 102, 241, 0.12);
      background:
        radial-gradient(circle at top left, rgba(16, 185, 129, 0.16), transparent 28%),
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.16), transparent 34%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(243, 246, 255, 0.96));
      box-shadow: 0 32px 88px rgba(15, 23, 42, 0.22);
    }
    [data-theme="light"] .celebration-kicker {
      background: rgba(139, 92, 246, 0.12);
      color: #6d28d9;
    }
    [data-theme="light"] .celebration-summary-card,
    [data-theme="light"] .celebration-app-chip {
      background: rgba(255, 255, 255, 0.78);
      border-color: rgba(99, 102, 241, 0.12);
      box-shadow: 0 18px 32px -28px rgba(15, 23, 42, 0.14);
    }
    [data-theme="light"] .celebration-footnote {
      color: #15803d;
    }

    /* Light mode needs material contrast, not more decoration. */
    [data-theme="light"] body {
      --bg: #e9e7e2;
      --panel: #f7f6f2;
      --panel-solid: #fbfaf7;
      --panel-strong: #eceae5;
      --border: #d4d0c8;
      --text: #1d1c1a;
      --text-secondary: #56534d;
      --muted: #706c64;
      --input-bg: #f4f2ed;
      --hover-bg: #efede8;
      --card-bg: #fbfaf7;
      --card-shadow: 0 2px 8px rgba(43, 39, 33, 0.08);
      background: #e9e7e2;
    }
    [data-theme="light"] body::before {
      display: none;
    }
    [data-theme="light"] .hub-content::before {
      display: none;
    }
    [data-theme="light"] .top-nav {
      background: #f1efe9;
      border-color: #cbc6bc;
      box-shadow: none;
      backdrop-filter: none;
    }
    [data-theme="light"] .section-title::after {
      background: #cfcbc3;
    }
    [data-theme="light"] .ghost-btn {
      background: #f2f0eb;
      border-color: #cfcbc3;
      box-shadow: none;
    }
    [data-theme="light"] .ghost-btn:hover {
      background: #e9e6df;
      border-color: #aaa59c;
      box-shadow: none;
    }
    [data-theme="light"] .hub-card {
      background: #f7f6f2;
      border-color: #d2cec6;
      box-shadow: 0 2px 8px rgba(43, 39, 33, 0.08);
    }
    [data-theme="light"] .hub-card::after {
      display: none;
    }
    [data-theme="light"] .org-top-strip {
      background: #f8f7f4 !important;
      border-bottom-color: #d2cec6 !important;
    }
    [data-theme="light"] .org-bottom-strip {
      background: #efede8 !important;
    }
    [data-theme="light"] .settings-icon,
    [data-theme="light"] .org-switch-btn,
    [data-theme="light"] .org-count-badge {
      background: #f8f7f4 !important;
      border-color: #d2cec6 !important;
      box-shadow: none;
    }
    [data-theme="light"] .org-switch-btn:hover {
      transform: none;
      border-color: #aaa59c !important;
      box-shadow: none;
    }
    [data-theme="light"] .org-divider {
      background: #cfcbc3 !important;
    }
    [data-theme="light"] .app-card {
      background: #fbfaf7;
      border-color: #d2cec6;
      box-shadow: 0 1px 2px rgba(43, 39, 33, 0.06), 0 2px 8px rgba(43, 39, 33, 0.05);
    }
    [data-theme="light"] .app-card:hover {
      transform: none;
      background: #ffffff;
      border-color: #aaa59c;
      box-shadow: 0 2px 8px rgba(43, 39, 33, 0.1);
    }
    [data-theme="light"] .app-card--primary {
      border-color: rgba(99, 102, 241, 0.5);
      box-shadow: 0 1px 2px rgba(43, 39, 33, 0.06), inset 3px 0 rgba(99, 102, 241, 0.72);
    }
    [data-theme="light"] .app-card--primary:hover {
      border-color: rgba(99, 102, 241, 0.68);
      box-shadow: 0 2px 8px rgba(43, 39, 33, 0.1), inset 3px 0 rgba(99, 102, 241, 0.82);
    }
    [data-theme="light"] .app-card__icon {
      border-color: color-mix(in srgb, var(--app-color, var(--brand)) 28%, #d2cec6);
      box-shadow: none;
    }
    [data-theme="light"] .app-card__desc {
      color: #625f58;
    }
    [data-theme="light"] .pill,
    [data-theme="light"] .pill--soft {
      background: #f0eee9;
      border-color: #d6d2ca;
      color: #5f5b54;
    }
    [data-theme="light"] .app-card--coming-soon {
      background: #eeece7;
      border-color: #cbc7bf;
    }
    [data-theme="light"] .empty {
      background: #f1efea;
      border-color: #c9c5bc;
    }
    @media (max-width: 720px) {
      body { padding: 16px 12px 32px; }
      .hub-hero { grid-template-columns: 1fr; }
      .hub-content { margin-top: 4px; }
      .section-title { font-size: 15px; margin: 16px 0 8px; }
      .org-setup-card {
        padding: 20px;
      }
      .org-setup-card__title {
        font-size: 26px;
      }
      .org-setup-actions {
        flex-direction: column;
        align-items: stretch;
      }
      .org-setup-actions .btn,
      .org-setup-actions .ghost-btn {
        width: 100%;
        text-align: center;
      }
      .org-setup-invite {
        align-items: stretch;
      }
      .celebration-shell {
        padding: 26px 20px 24px;
      }
      .celebration-title {
        font-size: 28px;
      }
      .celebration-actions {
        flex-direction: column;
        align-items: stretch;
      }
      .celebration-dismiss {
        width: 100%;
      }

      /* Organization card mobile layout */
      .org-top-strip {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 12px !important;
        padding: 16px !important;
      }
      .org-top-strip > div:first-child {
        gap: 12px !important;
      }
      .org-top-strip .org-icon {
        width: 40px !important;
        height: 40px !important;
      }
      .org-top-strip .org-name {
        font-size: 16px !important;
      }
      .org-actions-row {
        flex-wrap: wrap !important;
        gap: 8px !important;
      }
      .org-actions-row .ghost-btn {
        flex: 1;
        min-width: calc(33% - 6px);
        text-align: center;
        padding: 10px 8px !important;
        font-size: 12px !important;
      }
      .org-switch-btn {
        width: 100% !important;
        justify-content: center !important;
        margin-top: 4px;
      }
      .org-count-badge {
        display: none !important;
      }
      .org-divider {
        display: none !important;
      }

      /* Bottom strip mobile */
      .org-bottom-strip {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 12px !important;
        padding: 14px 16px !important;
      }
      .org-bottom-strip > div:first-child {
        gap: 10px !important;
      }
      .org-bottom-strip .settings-icon {
        width: 36px !important;
        height: 36px !important;
      }
      .org-bottom-strip .settings-title {
        font-size: 14px !important;
      }
      .org-bottom-strip .settings-desc {
        font-size: 12px !important;
      }
      .org-bottom-actions {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 8px !important;
      }
      .org-bottom-actions .ghost-btn {
        text-align: center;
        padding: 10px 8px !important;
        font-size: 12px !important;
      }

      /* App cards mobile */
      .app-grid {
        grid-template-columns: 1fr;
        gap: 10px;
      }
      .app-card {
        grid-template-columns: auto 1fr auto;
        padding: 14px;
        gap: 10px;
      }
      .app-card__icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
      }
      .app-card__icon svg { width: 20px; height: 20px; }
      .app-card__title { font-size: 15px; }
      .app-card__desc { font-size: 12px; }
      .app-card__meta { display: none; }
      .app-card__arrow { display: none; }
      .app-card:hover { transform: none; box-shadow: none; }

      /* Hide pill text on mobile, show shorter version */
      .pill--soft {
        font-size: 10px !important;
        padding: 4px 8px !important;
      }
    }

    @media (max-width: 400px) {
      body { padding: 12px 10px 24px; }
      .section-title { font-size: 14px; }
      .org-top-strip { padding: 14px !important; }
      .org-bottom-strip { padding: 12px 14px !important; }
      .ghost-btn {
        padding: 8px 6px !important;
        font-size: 11px !important;
      }
      .app-card { padding: 12px; }
      .app-card__title { font-size: 14px; }
      .app-card__desc { font-size: 11px; }
    }

    /* Modal Styles */
    .custom-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .custom-modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }
    .custom-modal {
      background: var(--panel-solid);
      border: 1px solid var(--border);
      border-radius: 24px;
      width: 90%;
      max-width: 440px;
      box-shadow: var(--card-shadow);
      transform: scale(0.92) translateY(8px);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      opacity: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .custom-modal-overlay.active .custom-modal {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
    .custom-modal-header {
      padding: 24px 24px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .custom-modal-title {
      font-size: 18px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.01em;
    }
    .custom-modal-close {
      background: transparent;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 8px;
      margin: -8px -8px -8px 0;
      border-radius: 99px;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .custom-modal-close:hover {
      background: var(--hover-bg);
      color: var(--text);
    }
    .custom-modal-body {
      padding: 8px 16px 24px;
      max-height: 60vh;
      overflow-y: auto;
    }
    .org-option-item {
      display: flex;
      align-items: center;
      width: 100%;
      padding: 12px 16px;
      margin-bottom: 4px;
      gap: 14px;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.15s ease;
      text-align: left;
      position: relative;
    }
    .org-option-item:hover {
      background: var(--hover-bg);
    }
    .org-option-item.active {
      background: rgba(99, 102, 241, 0.1);
      border-color: rgba(99, 102, 241, 0.2);
    }
    .org-option-avatar {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--panel-strong);
      display: grid;
      place-items: center;
      font-weight: 700;
      color: var(--text-secondary);
      font-size: 14px;
      flex-shrink: 0;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    .org-option-item.active .org-option-avatar {
      background: linear-gradient(135deg, #b980ff, #8b5cf6, #4c1d95);
      color: #fff;
      box-shadow: 0 4px 6px -1px rgba(99, 102, 241, 0.3);
    }
    .org-option-info { flex: 1; min-width: 0; }
    .org-option-name { font-weight: 600; color: var(--text); font-size: 15px; margin-bottom: 2px; }
    .org-option-role { font-size: 13px; color: var(--muted); text-transform: capitalize; }

    /* Workspace layout */
    body {
      padding: 0 0 64px;
      background: var(--bg);
    }
    body::before,
    body::after { display: none; }
    .top-nav {
      max-width: none;
      min-height: 64px;
      margin: 0;
      padding: 0 max(24px, calc((100vw - 1200px) / 2));
      gap: 24px;
      position: sticky;
      top: 0;
      z-index: 1000;
      border: 0;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
      background: var(--bg);
      box-shadow: none;
      backdrop-filter: none;
    }
    .top-nav-brand img,
    .top-nav-brand svg { height: 28px; }
    .top-nav-links {
      align-self: stretch;
      gap: 2px;
      flex-wrap: nowrap;
    }
    .top-nav-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      height: 64px;
      padding: 0 14px;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      font-size: 13px;
    }
    .top-nav-link:hover {
      border: 0;
      background: transparent;
    }
    .top-nav-link.active {
      border: 0;
      background: transparent;
      box-shadow: none;
    }
    .top-nav-link.active::after {
      content: '';
      position: absolute;
      right: 14px;
      bottom: 0;
      left: 14px;
      height: 2px;
      background: var(--brand);
    }
    .top-nav-user { gap: 8px; }
    .top-nav .theme-toggle,
    .top-nav .notification-icon {
      width: 34px;
      height: 34px;
      border-radius: 8px;
    }
    .user-toggle {
      padding: 5px 8px;
      border-radius: 8px;
    }
    [data-theme="light"] .top-nav,
    [data-theme="light"] .top-nav-link.active,
    [data-theme="light"] .top-nav-link:hover {
      background: var(--bg);
      border-color: var(--border);
      box-shadow: none;
    }

    .hub-content {
      width: min(1200px, calc(100% - 48px));
      margin: 36px auto 0;
      padding: 0;
    }
    [data-theme="light"] .hub-content::before { display: none; }
    .hub-page-header {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(280px, .7fr);
      align-items: center;
      gap: clamp(36px, 7vw, 96px);
      margin-bottom: 34px;
      padding: 28px 0 32px;
      border-bottom: 1px solid var(--border);
    }
    .hub-page-header__eyebrow {
      margin-bottom: 12px;
      color: var(--brand);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .hub-page-header h1 {
      margin: 0;
      color: var(--text);
      font-size: clamp(36px, 4.2vw, 52px);
      font-weight: 600;
      line-height: 1.05;
      letter-spacing: -0.045em;
    }
    .hub-page-header p {
      max-width: 650px;
      margin: 16px 0 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.65;
    }
    .hub-notification-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 36px;
      padding: 0 11px;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
    }
    .hub-notification-link:hover {
      background: var(--hover-bg);
      color: var(--text);
    }
    .hub-notification-count {
      min-width: 20px;
      padding: 2px 5px;
      border-radius: 6px;
      background: var(--brand);
      color: #fff;
      text-align: center;
      font-size: 11px;
      line-height: 16px;
    }
    .hub-page-header__actions {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-left: auto;
    }
    .hub-organization {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;
      width: 100%;
      min-width: 280px;
      max-width: 390px;
      min-height: 112px;
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--panel-solid);
      text-align: left;
    }
    .hub-organization__mark {
      display: grid;
      width: 36px;
      height: 36px;
      place-items: center;
      border: 1px solid color-mix(in srgb, var(--brand) 28%, var(--border));
      border-radius: 8px;
      background: color-mix(in srgb, var(--brand) 10%, var(--panel-solid));
      color: var(--brand);
    }
    .hub-organization__mark svg {
      width: 18px;
      height: 18px;
    }
    .hub-organization__identity {
      min-width: 0;
    }
    .hub-organization__label {
      margin-bottom: 1px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 650;
      letter-spacing: 0.045em;
      line-height: 1.35;
      text-transform: uppercase;
    }
    .hub-organization__name {
      overflow: hidden;
      max-width: 190px;
      color: var(--text);
      font-size: 14px;
      font-weight: 650;
      line-height: 1.4;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .hub-organization__switch {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      min-height: 32px;
      padding: 0 8px;
      border: 0;
      border-radius: 7px;
      background: var(--hover-bg);
      color: var(--text-secondary);
      cursor: pointer;
      font: inherit;
      font-size: 12px;
      font-weight: 600;
      line-height: 1.4;
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .hub-organization__switch svg {
      width: 13px;
      height: 13px;
      color: var(--muted);
    }
    .hub-organization__switch:hover {
      background: color-mix(in srgb, var(--brand) 11%, var(--hover-bg));
      color: var(--text);
    }
    .hub-organization__switch:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--brand) 65%, transparent);
      outline-offset: 2px;
    }
    .workspace-layout {
      display: block;
    }
    .workspace-primary { min-width: 0; }
    .workspace-section + .workspace-section { margin-top: 30px; }
    .section-title {
      margin: 0 0 14px;
      color: var(--text);
      font-size: 17px;
      line-height: 1.3;
      font-weight: 650;
      letter-spacing: -0.015em;
    }
    .section-title::after { display: none; }
    .section-description {
      margin: -7px 0 16px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.5;
    }
    .apps { margin-top: 0; }
    .app-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    .app-card,
    [data-theme="light"] .app-card {
      position: relative;
      grid-template-columns: 40px minmax(0, 1fr);
      min-height: 154px;
      padding: 18px 18px 16px;
      gap: 14px;
      align-items: start;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--panel-solid);
      box-shadow: none;
      overflow: hidden;
      transition: border-color 0.16s ease, background-color 0.16s ease;
    }
    .app-card::after { display: none; }
    .app-card:hover,
    [data-theme="light"] .app-card:hover,
    .app-card--primary,
    [data-theme="light"] .app-card--primary,
    .app-card--primary:hover,
    [data-theme="light"] .app-card--primary:hover {
      border-color: color-mix(in srgb, var(--app-color, var(--brand)) 48%, var(--border));
      background: color-mix(in srgb, var(--app-color, var(--brand)) 4%, var(--panel-solid));
      box-shadow: none;
      transform: none;
    }
    .app-card:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--app-color, var(--brand)) 72%, transparent);
      outline-offset: 2px;
    }
    .app-card__icon,
    [data-theme="light"] .app-card__icon {
      width: 40px;
      height: 40px;
      border: 1px solid color-mix(in srgb, var(--app-color, var(--brand)) 30%, var(--border));
      border-radius: 8px;
      background: color-mix(in srgb, var(--app-color, var(--brand)) 11%, var(--panel-strong));
      box-shadow: none;
    }
    .app-card:hover .app-card__icon {
      background: color-mix(in srgb, var(--app-color, var(--brand)) 15%, var(--panel-strong));
      transform: none;
    }
    .app-card__icon svg { width: 20px; height: 20px; }
    .app-card__body {
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 118px;
      gap: 6px;
    }
    .app-card__title {
      min-height: 22px;
      align-items: center;
      color: var(--text);
      font-size: 15.5px;
      line-height: 1.35;
      font-weight: 680;
    }
    .app-card__badge,
    .coming-soon-badge {
      padding: 2px 6px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--panel-strong);
      box-shadow: none;
      color: var(--muted);
      font-size: 10px;
      line-height: 14px;
      letter-spacing: 0;
      text-transform: none;
    }
    .app-card__desc,
    [data-theme="light"] .app-card__desc {
      color: var(--muted);
      font-size: 12.75px;
      line-height: 1.5;
    }
    .app-card__meta {
      margin-top: auto;
      padding-top: 11px;
      padding-right: 30px;
      border-top: 1px solid color-mix(in srgb, var(--border) 76%, transparent);
    }
    .app-card .pill,
    .app-card .pill--soft,
    [data-theme="light"] .app-card .pill--soft {
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--muted);
      font-size: 11px;
      font-weight: 550;
      line-height: 1.4;
      letter-spacing: 0;
      text-transform: none;
    }
    .app-card__arrow {
      position: absolute;
      right: 17px;
      bottom: 15px;
      display: grid;
      width: 22px;
      height: 22px;
      place-items: center;
      color: color-mix(in srgb, var(--app-color, var(--brand)) 70%, var(--muted));
      opacity: 0.78;
    }
    .app-card__arrow svg { width: 17px; height: 17px; }
    .app-card:hover .app-card__arrow {
      color: var(--app-color, var(--brand));
      opacity: 1;
      transform: none;
    }
    .app-card--coming-soon {
      min-height: 132px;
      opacity: 0.58;
      border-style: solid;
    }
    .app-card--coming-soon .app-card__body { min-height: 96px; }

    .action-banner,
    .subscription-reminder-card {
      border-radius: 10px;
      box-shadow: none;
    }

    /* Final light-theme hierarchy for the compact workspace layout. */
    [data-theme="light"] .top-nav {
      background: #f8f7f4;
      border-color: #d2cec6;
      box-shadow: 0 2px 8px rgba(43, 39, 33, 0.08);
    }
    [data-theme="light"] .top-nav-link.active,
    [data-theme="light"] .top-nav-link:hover {
      background: transparent;
    }
    [data-theme="light"] .hub-page-header {
      border-bottom-color: #cbc6bc;
    }
    [data-theme="light"] .hub-organization {
      background: #fffdfa;
      border-color: #cbc6bc;
      box-shadow: 0 1px 2px rgba(43, 39, 33, 0.06);
    }
    [data-theme="light"] .hub-notification-link {
      background: #fffdfa;
      border-color: #cbc6bc;
    }
    [data-theme="light"] .app-card {
      background: #fffdfa;
      border-color: #cbc6bc;
      box-shadow: 0 1px 2px rgba(43, 39, 33, 0.07), 0 4px 8px rgba(43, 39, 33, 0.05);
    }
    [data-theme="light"] .app-card:hover {
      background: #fffdfa;
      border-color: #aaa399;
      box-shadow: 0 2px 6px rgba(43, 39, 33, 0.09);
    }
    [data-theme="light"] .app-card--primary,
    [data-theme="light"] .app-card--primary:hover {
      background: #fffdfa;
      border-color: color-mix(in srgb, var(--app-color, var(--brand)) 48%, #cbc6bc);
      box-shadow: inset 3px 0 color-mix(in srgb, var(--app-color, var(--brand)) 78%, transparent), 0 2px 6px rgba(43, 39, 33, 0.06);
    }
    [data-theme="light"] .app-card--coming-soon {
      background: #e9e5de;
      border-color: #c9c3b8;
    }
    [data-theme="light"] .app-card__meta {
      border-top-color: #dedad2;
    }
    [data-theme="light"] .action-banner,
    [data-theme="light"] .subscription-reminder-card {
      background: #fbfaf7;
      border-color: #d2cec6;
      box-shadow: 0 2px 8px rgba(43, 39, 33, 0.06);
    }

    .attendance-strip {
      display: grid;
      grid-template-columns: minmax(210px, 1fr) auto auto;
      align-items: center;
      gap: 18px;
      margin: -4px 0 26px;
      padding: 13px 15px;
      background: var(--panel, #111114);
      border: 1px solid var(--border);
      border-left: 3px solid #14b8a6;
      border-radius: 10px;
      transition: padding 160ms ease, gap 160ms ease;
    }
    .attendance-strip[hidden] { display: none; }
    .attendance-strip__state { display: flex; align-items: center; gap: 11px; min-width: 0; }
    .attendance-strip__dot { width: 9px; height: 9px; border-radius: 50%; background: #71717a; flex: none; }
    .attendance-strip[data-state="working"] .attendance-strip__dot { background: #14b8a6; }
    .attendance-strip[data-state="break"] .attendance-strip__dot { background: #f59e0b; }
    .attendance-strip__label { color: var(--text); font-size: 14px; font-weight: 700; }
    .attendance-strip__hint { margin-top: 2px; color: var(--muted); font-size: 12px; }
    .attendance-strip__time { font: 650 18px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--text); letter-spacing: .02em; }
    .attendance-strip__actions { display: flex; align-items: center; gap: 7px; }
    .attendance-strip__toggle { width: 34px; height: 34px; display: inline-grid; place-items: center; flex: none; padding: 0; border: 1px solid var(--border); border-radius: 7px; background: transparent; color: var(--muted); cursor: pointer; }
    .attendance-strip__toggle:hover { color: var(--text); background: var(--hover-bg); }
    .attendance-strip__toggle svg { width: 16px; height: 16px; transition: transform 160ms ease; }
    .attendance-strip[data-collapsed="true"] { grid-template-columns: minmax(130px, 1fr) auto auto; max-width: 620px; margin-left: auto; padding: 9px 10px 9px 12px; }
    .attendance-strip[data-collapsed="true"] .attendance-strip__hint,
    .attendance-strip[data-collapsed="true"] .attendance-detail { display: none; }
    .attendance-strip[data-collapsed="true"] .attendance-strip__actions { flex-wrap: nowrap; }
    .attendance-strip[data-collapsed="true"] .attendance-strip__toggle svg { transform: rotate(180deg); }
    .attendance-strip[data-reminder="true"] { border-left-color: #d97706; }
    .attendance-strip[data-reminder="true"] .attendance-strip__hint { color: #d97706; }
    .attendance-action {
      min-height: 34px;
      padding: 0 12px;
      border: 1px solid var(--border);
      border-radius: 7px;
      background: transparent;
      color: var(--text);
      font: inherit;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }
    .attendance-action:hover { background: var(--hover-bg); border-color: var(--muted); }
    .attendance-action--primary { background: #0f766e; border-color: #0f766e; color: white; }
    .attendance-action--danger { color: #fca5a5; }
    .attendance-action:disabled { opacity: .5; cursor: wait; }
    .attendance-detail { color: var(--muted); text-decoration: none; font-size: 12px; font-weight: 650; white-space: nowrap; }
    .attendance-detail:hover { color: var(--text); }
    [data-theme="light"] .attendance-strip { background: #fffdfa; border-color: #cbc6bc; border-left-color: #0f766e; }
    [data-theme="light"] .attendance-strip[data-reminder="true"] { border-left-color: #b45309; }
    .app-card-shell { position: relative; min-width: 0; }
    .app-card-shell > .app-card { height: 100%; }
    .attendance-card-toggle { position: absolute; right: 18px; bottom: 15px; z-index: 2; padding: 0; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: 11px; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
    .attendance-card-toggle:hover { color: var(--text); }
    .attendance-card-toggle[hidden] { display: none; }

    @media (max-width: 980px) {
      .app-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 768px) {
      body { padding: 0 0 32px; }
      .top-nav {
        min-height: 56px;
        margin: 0;
        padding: 0 14px;
        border-radius: 0;
      }
      .hub-content {
        width: calc(100% - 24px);
        margin-top: 24px;
      }
      .hub-page-header {
        grid-template-columns: 1fr;
        gap: 22px;
        align-items: stretch;
        margin-bottom: 22px;
        padding-top: 16px;
      }
      .hub-page-header h1 { font-size: 34px; }
      .hub-page-header p { font-size: 13px; }
      .hub-notification-link { flex: 0 0 auto; }
      .hub-page-header__actions { gap: 12px; }
      .hub-organization { min-width: 0; max-width: none; }
      .app-grid { grid-template-columns: 1fr; }
      .app-card {
        min-height: 0;
        padding: 15px;
      }
      .app-card__meta { display: flex; }
      .app-card__arrow { display: block; }
      .attendance-strip { grid-template-columns: 1fr auto; gap: 12px; }
      .attendance-strip__time { text-align: right; }
      .attendance-strip__actions { grid-column: 1 / -1; flex-wrap: wrap; }
      .attendance-strip[data-collapsed="true"] { grid-template-columns: 1fr auto; max-width: none; }
      .attendance-strip[data-collapsed="true"] .attendance-strip__actions { grid-column: 1 / -1; }
    }
    @media (max-width: 480px) {
      .hub-page-header { display: block; }
      .hub-page-header__actions {
        align-items: center;
        justify-content: space-between;
        margin: 18px 0 0;
      }
      .hub-organization {
        width: 100%;
        min-width: 0;
        max-width: none;
      }
      .hub-notification-link { margin: 0; }
      .app-card__desc { font-size: 12px; }
    }

    /* Magic Patterns workspace system — final canonical dashboard layer. */
    :root {
      --hub-canvas: #111014;
      --hub-canvas-raised: #191820;
      --hub-canvas-sunken: #0d0c10;
      --hub-ink: #ffffff;
      --hub-ink-soft: rgba(255, 255, 255, .65);
      --hub-ink-faint: rgba(255, 255, 255, .42);
      --hub-line: rgba(255, 255, 255, .08);
      --hub-line-strong: rgba(255, 255, 255, .15);
      --hub-card-shadow: none;
      --hub-brand: #8f71f3;
      --hub-brand-soft: rgba(112, 72, 232, .15);
      --hub-action: #ffffff;
      --hub-action-ink: #111014;
    }
    [data-theme="light"] {
      --hub-canvas: #efede7;
      --hub-canvas-raised: #fbfaf7;
      --hub-canvas-sunken: #e4e1d9;
      --hub-ink: #171512;
      --hub-ink-soft: #524e46;
      --hub-ink-faint: #8b857a;
      --hub-line: rgba(23, 21, 18, .08);
      --hub-line-strong: rgba(23, 21, 18, .18);
      --hub-card-shadow: 0 1px 2px rgba(23, 21, 18, .04), 0 8px 24px -12px rgba(23, 21, 18, .12);
      --hub-brand: #7048e8;
      --hub-brand-soft: #f3f0ff;
      --hub-action: #171512;
      --hub-action-ink: #fbfaf7;
    }
    html, body { min-height: 100%; }
    body {
      padding: 0 0 48px;
      background: var(--hub-canvas);
      color: var(--hub-ink);
      font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
      text-rendering: optimizeLegibility;
    }
    body::before, body::after { display: none; }
    body .top-nav.idp-global-nav {
      min-height: 64px;
      padding-right: max(24px, calc((100vw - 1280px) / 2));
      padding-left: max(24px, calc((100vw - 1280px) / 2));
      background: color-mix(in srgb, var(--hub-canvas) 92%, transparent);
      border-color: var(--hub-line);
      color: var(--hub-ink);
      backdrop-filter: blur(4px);
    }
    [data-theme="light"] body .top-nav.idp-global-nav {
      background: color-mix(in srgb, var(--hub-canvas) 92%, transparent);
      border-color: var(--hub-line);
      box-shadow: none;
    }
    body .idp-global-nav .top-nav-link {
      min-height: 64px;
      color: var(--hub-ink-soft);
      font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
      font-size: 14px;
      font-weight: 500;
    }
    body .idp-global-nav .top-nav-link.active {
      min-height: 38px;
      margin-block: auto;
      padding-inline: 16px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--hub-ink) 8%, transparent);
      color: var(--hub-ink);
    }
    body .idp-global-nav .top-nav-link.active::after { display: none; }
    body .idp-global-nav .top-nav-link:hover { color: var(--hub-ink); }
    body .idp-global-nav .top-nav-user-name { color: var(--hub-ink); }
    body .idp-global-nav .top-nav-user-email { color: var(--hub-ink-faint); }

    .hub-content {
      width: min(1280px, calc(100% - 48px));
      margin: 0 auto;
      padding: 0;
    }
    .hub-page-header {
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(380px, 1fr);
      align-items: center;
      gap: clamp(56px, 9vw, 144px);
      margin: 0 0 0;
      padding: 64px 0 56px;
      border-bottom: 0;
    }
    .hub-page-header::before {
      position: absolute;
      z-index: -1;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 100vw;
      transform: translateX(-50%);
      border-bottom: 1px solid var(--hub-line);
      background-color: var(--hub-canvas);
      background-image: radial-gradient(color-mix(in srgb, var(--hub-ink) 5%, transparent) 1px, transparent 1px);
      background-size: 4px 4px;
      content: "";
    }
    .hub-page-header__copy { max-width: 680px; }
    .hub-page-header__eyebrow {
      margin-bottom: 14px;
      color: var(--hub-brand);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .hub-page-header h1 {
      margin: 0;
      color: var(--hub-ink);
      font-family: "Instrument Serif", ui-serif, Georgia, serif;
      font-size: clamp(42px, 4.45vw, 58px);
      font-weight: 400;
      line-height: 1.05;
      letter-spacing: -.02em;
    }
    .hub-page-header p {
      max-width: 630px;
      margin: 18px 0 0;
      color: var(--hub-ink-soft);
      font-size: 15px;
      line-height: 1.62;
    }
    .hub-page-header p strong { color: var(--hub-ink); font-weight: 650; }
    .hub-page-header__actions { width: 100%; margin: 0; }
    .hub-organization {
      display: block;
      width: 100%;
      min-width: 0;
      max-width: none;
      min-height: 200px;
      padding: 22px;
      border: 1px solid var(--hub-line);
      border-radius: 24px;
      background: var(--hub-canvas-raised);
      color: var(--hub-ink);
      box-shadow: var(--hub-card-shadow);
    }
    .hub-organization__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .hub-organization__label {
      margin: 0 0 12px;
      color: var(--hub-ink-faint);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .12em;
      line-height: 1;
      text-transform: uppercase;
    }
    .hub-organization__profile { display: flex; min-width: 0; align-items: center; gap: 12px; }
    .hub-organization__mark {
      display: grid;
      width: 44px;
      height: 44px;
      flex: none;
      place-items: center;
      border: 0;
      border-radius: 14px;
      background: var(--hub-brand);
      color: #fff;
      font-size: 14px;
      font-weight: 650;
    }
    .hub-organization__identity { min-width: 0; }
    .hub-organization__name {
      max-width: 220px;
      color: var(--hub-ink);
      font-size: 19px;
      font-weight: 650;
      line-height: 1.2;
    }
    .hub-organization__plan { margin-top: 3px; color: var(--hub-ink-faint); font-size: 12px; text-transform: capitalize; }
    .hub-organization__switch {
      display: inline-flex;
      min-height: 36px;
      align-items: center;
      gap: 7px;
      padding: 0 14px;
      border: 1px solid var(--hub-line-strong);
      border-radius: 999px;
      background: transparent;
      color: var(--hub-ink);
      font-size: 13px;
      font-weight: 500;
    }
    .hub-organization__switch svg { width: 15px; height: 15px; color: currentColor; }
    .hub-organization__switch:hover { background: color-mix(in srgb, var(--hub-ink) 5%, transparent); }
    .hub-organization__stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 22px 0 0;
      padding: 18px 0 0;
      border-top: 1px solid var(--hub-line);
    }
    .hub-organization__stats dt { color: var(--hub-ink-faint); font-size: 10px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
    .hub-organization__stats dd { margin: 4px 0 0; color: var(--hub-ink); font-size: 17px; font-weight: 650; }
    .hub-organization__stats dd.is-positive { color: #34d399; }
    [data-theme="light"] .hub-organization__stats dd.is-positive { color: #059669; }

    .attendance-strip {
      margin: 34px 0 0;
      border-color: var(--hub-line);
      border-left-color: var(--hub-brand);
      border-radius: 12px;
      background: var(--hub-canvas-raised);
      color: var(--hub-ink);
      box-shadow: var(--hub-card-shadow);
    }
    [data-theme="light"] .attendance-strip { border-color: var(--hub-line); border-left-color: var(--hub-brand); background: var(--hub-canvas-raised); }
    .attendance-strip__label, .attendance-strip__time { color: var(--hub-ink); }
    .attendance-strip__hint, .attendance-detail { color: var(--hub-ink-faint); }

    .workspace-layout { padding-top: 56px; }
    .workspace-section + .workspace-section { margin-top: 56px; }
    .apps-heading-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
    .section-title {
      margin: 0;
      color: var(--hub-ink);
      font-size: 22px;
      font-weight: 650;
      line-height: 1.25;
      letter-spacing: -.02em;
    }
    .section-description { margin: 6px 0 0; color: var(--hub-ink-soft); font-size: 14px; line-height: 1.5; }
    .apps-result-count { margin: 6px 0 0; color: var(--hub-ink-faint); font-size: 12px; }
    .apps-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      margin: 28px 0 26px;
    }
    .app-filters { display: flex; min-width: 0; align-items: center; gap: 8px; flex-wrap: wrap; }
    .app-filter {
      min-height: 34px;
      padding: 0 12px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--hub-ink-soft);
      font: inherit;
      font-size: 13px;
      font-weight: 500;
    }
    .app-filter:hover { color: var(--hub-ink); }
    .app-filter.is-active { background: var(--hub-action); color: var(--hub-action-ink); }
    .app-filter--pinned { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--hub-line); }
    .app-filter--pinned svg { width: 14px; height: 14px; }
    .app-search {
      display: flex;
      width: min(288px, 100%);
      height: 40px;
      flex: none;
      align-items: center;
      gap: 9px;
      padding: 0 14px;
      border: 1px solid var(--hub-line-strong);
      border-radius: 999px;
      background: color-mix(in srgb, var(--hub-canvas-raised) 75%, transparent);
      color: var(--hub-ink-faint);
    }
    .app-search:focus-within { border-color: var(--hub-brand); box-shadow: 0 0 0 2px color-mix(in srgb, var(--hub-brand) 20%, transparent); }
    .app-search svg { width: 16px; height: 16px; flex: none; }
    .app-search input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--hub-ink); font: inherit; font-size: 13px; box-shadow: none; }
    .app-search input:focus { border: 0; background: transparent; box-shadow: none; }
    .app-search input::placeholder { color: var(--hub-ink-faint); }

    .app-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    body .app-card,
    body [data-theme="light"] .app-card {
      position: relative;
      display: flex;
      min-height: 220px;
      flex-direction: column;
      padding: 20px;
      border: 1px solid var(--hub-line);
      border-radius: 16px;
      background: var(--hub-canvas-raised);
      color: var(--hub-ink);
      box-shadow: var(--hub-card-shadow);
      overflow: hidden;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    body .app-card:hover,
    body [data-theme="light"] .app-card:hover {
      border-color: var(--hub-line-strong);
      background: var(--hub-canvas-raised);
      box-shadow: 0 2px 4px rgba(23, 21, 18, .05), 0 18px 40px -16px rgba(23, 21, 18, .22);
    }
    [data-theme="dark"] body .app-card:hover { box-shadow: none; }
    .app-card[hidden] { display: none !important; }
    .app-card__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
    .app-card__identity { display: flex; min-width: 0; align-items: flex-start; gap: 12px; }
    body .app-card__icon,
    body [data-theme="light"] .app-card__icon {
      display: grid;
      width: 44px;
      height: 44px;
      flex: none;
      place-items: center;
      border: 1px solid color-mix(in srgb, var(--app-color) 28%, var(--hub-line));
      border-radius: 14px;
      background: color-mix(in srgb, var(--app-color) 10%, var(--hub-canvas-raised));
      color: var(--app-color);
    }
    .app-card__icon svg { width: 21px; height: 21px; }
    .app-card__title-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .app-card__title { min-height: 0; color: var(--hub-ink); font-size: 16px; font-weight: 650; line-height: 1.3; letter-spacing: -.015em; }
    .app-card__subtitle { margin-top: 2px; color: var(--hub-brand); font-size: 12px; line-height: 1.35; }
    body .app-card__badge {
      padding: 2px 7px;
      border: 1px solid color-mix(in srgb, #f59e0b 42%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, #f59e0b 10%, transparent);
      color: #fcd34d;
      font-size: 10px;
      font-weight: 600;
      line-height: 16px;
      text-transform: uppercase;
    }
    [data-theme="light"] body .app-card__badge { color: #b45309; }
    .app-card__pin { width: 28px; height: 28px; display: grid; flex: none; place-items: center; border: 0; background: transparent; color: var(--hub-ink-faint); }
    .app-card__pin svg { width: 17px; height: 17px; fill: transparent; stroke: currentColor; stroke-width: 1.35; stroke-linejoin: round; }
    .app-card__pin[aria-pressed="true"] { color: var(--hub-brand); }
    .app-card__pin[aria-pressed="true"] svg { fill: currentColor; stroke: currentColor; }
    .app-card__desc { margin: 18px 0 0; color: var(--hub-ink-soft); font-size: 13px; line-height: 1.6; }
    .app-card__footer { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-top: auto; padding-top: 17px; border-top: 1px solid var(--hub-line); }
    .app-card__metric { display: grid; gap: 2px; }
    .app-card__metric span { color: var(--hub-ink-faint); font-size: 10px; font-weight: 500; letter-spacing: .09em; text-transform: uppercase; }
    .app-card__metric strong { color: var(--hub-ink); font-size: 14px; font-weight: 650; }
    .app-card__open {
      display: inline-flex;
      min-height: 36px;
      align-items: center;
      gap: 6px;
      padding: 0 14px;
      border: 0;
      border-radius: 999px;
      background: var(--hub-action);
      color: var(--hub-action-ink);
      font: inherit;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
    }
    .app-card__open:hover { opacity: .88; }
    .app-card__open svg { width: 15px; height: 15px; }
    .attendance-card-toggle { right: auto; bottom: 24px; left: 112px; color: var(--hub-ink-faint); }

    .roadmap-section { padding-bottom: 56px; }
    .roadmap-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 26px; }
    .roadmap-card { display: flex; min-height: 104px; align-items: center; justify-content: space-between; gap: 20px; padding: 20px; border: 1px dashed var(--hub-line-strong); border-radius: 16px; color: var(--hub-ink); }
    .roadmap-card__icon { display: grid; width: 40px; height: 40px; flex: none; place-items: center; border: 1px solid var(--hub-line); border-radius: 12px; color: var(--hub-ink-faint); }
    .roadmap-card__icon svg { width: 18px; height: 18px; }
    .roadmap-card__title { color: var(--hub-ink); font-size: 14px; font-weight: 650; }
    .roadmap-card__desc { margin-top: 3px; color: var(--hub-ink-faint); font-size: 12px; line-height: 1.45; }
    .roadmap-card__action { min-height: 34px; flex: none; padding: 0 13px; border: 1px solid var(--hub-line-strong); border-radius: 999px; background: transparent; color: var(--hub-ink-soft); font: inherit; font-size: 12px; }

    .hub-footer {
      display: flex;
      width: min(1280px, calc(100% - 48px));
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      margin: 0 auto;
      padding: 30px 0 0;
      border-top: 1px solid var(--hub-line);
      color: var(--hub-ink-faint);
      font-size: 12px;
    }
    .hub-footer nav { display: flex; gap: 24px; }
    .hub-footer a { color: inherit; text-decoration: none; }
    .hub-footer a:hover { color: var(--hub-ink); }

    @media (max-width: 980px) {
      .hub-page-header { grid-template-columns: 1fr; gap: 36px; }
      .hub-organization { max-width: 560px; }
      .app-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .apps-toolbar { align-items: flex-start; flex-direction: column; }
      .app-search { width: 100%; max-width: 420px; }
    }
    @media (max-width: 700px) {
      .hub-content, .hub-footer { width: min(100% - 28px, 1280px); }
      .hub-page-header { padding: 42px 0; }
      .hub-page-header h1 { font-size: 42px; }
      .hub-page-header__actions { margin: 0; }
      .hub-organization { border-radius: 18px; }
      .workspace-layout { padding-top: 40px; }
      .apps-heading-row { display: block; }
      .apps-result-count { margin-top: 12px; }
      .app-grid, .roadmap-grid { grid-template-columns: 1fr; }
      .app-card { min-height: 205px; }
      .hub-footer { align-items: flex-start; flex-direction: column; }
      .hub-footer nav { gap: 18px; flex-wrap: wrap; }
    }
    @media (max-width: 480px) {
      .hub-page-header { display: grid; }
      .hub-page-header h1 { font-size: 38px; }
      .hub-organization__top { align-items: flex-start; }
      .hub-organization__switch { padding: 0 10px; }
      .hub-organization__switch span { display: none; }
      .hub-organization__stats { gap: 8px; }
      .apps-toolbar { margin-top: 22px; }
      .app-filters { gap: 4px; }
      .app-filter { padding-inline: 10px; }
      body .app-card { padding: 18px; }
    }
  </style>
  <script src="/js/theme.js?v=3"></script>
  <% if (hasOrganizations) { %>
    <script src="/js/invitation-gatekeeper.js"></script>
  <% } %>
</head>

<body>
  <%- include('partials/nav', { activePage: 'home' }) %>
  <% const pendingSignatureCount = notificationSummary?.pendingSignatureCount || 0; %>
  <% const pendingSignatureDocuments = Array.isArray(notificationSummary?.pendingSignatureDocuments) ? notificationSummary.pendingSignatureDocuments : []; %>
  <% const firstDocumentNotificationActionUrl = Array.isArray(notificationSummary?.tasks)
    ? (notificationSummary.tasks.find(task => task?.category === 'documents' && task?.actionUrl)?.actionUrl || '/notifications?category=documents')
    : '/notifications?category=documents'; %>
  <% const pendingInviteRows = Array.isArray(pendingInvitations) ? pendingInvitations : []; %>

  <div class="container hub-content">
    <% if (accessError) { %>
      <div class="alert alert-error"><%= accessError %></div>
    <% } %>

    <% if (!hasOrganizations) { %>
      <section class="apps">
        <div class="section-title">Organization required</div>
        <div class="card org-setup-card">
          <div class="org-setup-card__eyebrow">Complete setup to continue</div>
          <h1 class="org-setup-card__title">Create an organization or accept an invite before you can use any apps.</h1>
          <p class="org-setup-card__copy">
            Your dashboard stays locked until your account belongs to an organization. Once you create one or join one, app access will appear here automatically.
          </p>

          <div class="org-setup-options">
            <div class="org-setup-option">
              <div class="org-setup-option__title">Create your own organization</div>
              <div class="org-setup-option__copy">
                Start a new workspace, become the owner, and unlock the IDP apps for that organization.
              </div>
            </div>
            <div class="org-setup-option">
              <div class="org-setup-option__title">Accept an invitation</div>
              <div class="org-setup-option__copy">
                <% if (pendingInvitationsCount > 0) { %>
                  You have <%= pendingInvitationsCount %> pending invitation<%= pendingInvitationsCount === 1 ? '' : 's' %> ready to accept.
                <% } else { %>
                  If another admin has invited you already, accept it here and your apps will unlock immediately.
                <% } %>
              </div>
            </div>
          </div>

          <div class="org-setup-actions">
            <button type="button" class="btn btn-primary" onclick="showCreateModal()">Create Organization</button>
            <a href="/invitations/pending" class="ghost-btn">
              <%= pendingInvitationsCount > 0 ? `View Invitations (${pendingInvitationsCount})` : 'Check Invitations' %>
            </a>
          </div>

          <% if (pendingInviteRows.length > 0) { %>
            <div class="org-setup-invites">
              <% pendingInviteRows.forEach(invite => { %>
                <div class="org-setup-invite" data-home-invite-id="<%= invite.id %>">
                  <div>
                    <div class="org-setup-invite__title"><%= invite.organization.name %></div>
                    <% if (invite.organization.description) { %>
                      <div class="org-setup-invite__desc"><%= invite.organization.description %></div>
                    <% } %>
                    <div class="org-setup-invite__meta">
                      <span class="role-badge role-<%= invite.role %>"><%= invite.role %></span>
                      <span class="pill pill--soft"><%= invite.appAccessLabel || 'All apps' %></span>
                      <span>Invited by <%= invite.invitedBy?.name || invite.invitedBy?.email || 'Unknown' %></span>
                      <span>Expires <%= new Date(invite.expiresAt).toLocaleDateString() %></span>
                      <% if (invite.appAccess && invite.appAccess.mode === 'selected' && invite.appAccessAppNames && invite.appAccessAppNames.length > 0) { %>
                        <span>Apps: <%= invite.appAccessAppNames.join(', ') %></span>
                      <% } %>
                    </div>
                  </div>
                  <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                    <button
                      type="button"
                      class="btn btn-primary"
                      data-invite-id="<%= invite.id %>"
                      data-org-name="<%= invite.organization.name %>"
                      onclick="acceptDashboardInvite(this)">
                      Accept Invite
                    </button>
                    <a href="/invitations/pending" class="ghost-btn">View Details</a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="org-setup-empty">
              No invitations are waiting right now. Create an organization to unlock the dashboard.
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <% if (currentSubscriptionAccess && currentSubscriptionAccess.showExpiryReminder) { %>
      <div class="card action-banner action-banner--warn subscription-reminder-card">
        <div>
          <div class="action-banner__title">Plan expiry reminder</div>
          <div class="action-banner__desc">
            <%= currentSubscriptionAccess.planName || 'Your current plan' %> for <%= currentSubscriptionAccess.organizationName %> expires
            <strong style="color: var(--text);"><%= currentSubscriptionAccess.daysUntilExpiry === 0 ? 'today' : `in ${currentSubscriptionAccess.daysUntilExpiry} day${currentSubscriptionAccess.daysUntilExpiry === 1 ? '' : 's'}` %></strong>.
            Request another plan now to avoid access being locked.
          </div>
        </div>
        <div class="action-banner__cta">
          <a href="/plans" class="btn btn-primary">Request a Plan</a>
          <a href="/subscription" class="ghost-btn">Open Subscription</a>
        </div>
      </div>
    <% } %>

    <% if (hasOrganizations && currentSubscriptionAccess && currentSubscriptionAccess.isLocked) { %>
      <section class="apps">
        <div class="section-title">Plan action required</div>
        <div class="card org-setup-card subscription-lock-card">
          <div class="org-setup-card__eyebrow subscription-lock-kicker">Access locked</div>
          <h1 class="org-setup-card__title">You need an active plan before this organization can use the IDP apps.</h1>
          <p class="org-setup-card__copy">
            <strong style="color: var(--text);"><%= currentSubscriptionAccess.organizationName %></strong>
            <% if (currentSubscriptionAccess.status === 'grace_period' || currentSubscriptionAccess.status === 'expired') { %>
              no longer has an active plan. Access is restricted immediately after expiry.
            <% } else if (currentSubscriptionAccess.status === 'suspended') { %>
              has a suspended subscription. Access is restricted until a new active plan is in place.
            <% } else { %>
              does not currently have an active plan. Request another plan to restore access.
            <% } %>
          </p>

          <div class="celebration-summary">
            <div class="celebration-summary-card">
              <div class="celebration-summary-label">Organization</div>
              <div class="celebration-summary-value"><%= currentSubscriptionAccess.organizationName %></div>
            </div>
            <div class="celebration-summary-card">
              <div class="celebration-summary-label">Previous Plan</div>
              <div class="celebration-summary-value"><%= currentSubscriptionAccess.planName || 'No active plan' %></div>
            </div>
            <div class="celebration-summary-card">
              <div class="celebration-summary-label">Access Status</div>
              <div class="celebration-summary-value"><%= currentSubscriptionAccess.status === 'grace_period' ? 'Expired' : (currentSubscriptionAccess.status || 'none').replace('_', ' ') %></div>
            </div>
          </div>

          <% if (currentSubscriptionAccess.pendingRequest) { %>
            <div class="subscription-lock-note">
              A request for <strong style="color: var(--text);"><%= currentSubscriptionAccess.pendingRequest.planName %></strong> is already pending approval.
              Access stays locked until that request is approved.
            </div>
          <% } else { %>
            <div class="subscription-lock-note">
              Request another plan to restore access. If you belong to more than one organization, you can switch to another active organization from here.
            </div>
          <% } %>

          <div class="org-setup-actions">
            <% if (currentSubscriptionAccess.pendingRequest) { %>
              <a href="/subscription" class="btn btn-primary">Review Request Status</a>
            <% } else { %>
              <a href="/plans" class="btn btn-primary">Request Another Plan</a>
            <% } %>
            <a href="/subscription" class="ghost-btn">Open Subscription</a>
            <a href="/organizations" class="ghost-btn">Organizations</a>
            <% if (organizations && organizations.length > 1) { %>
              <button type="button" class="ghost-btn" onclick="openOrgModal()">Switch Organization</button>
            <% } %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (hasOrganizations && !(currentSubscriptionAccess && currentSubscriptionAccess.isLocked)) { %>
    <% if (notificationSummary && notificationSummary.totalUnread > 0) { %>
      <div class="card action-banner">
        <div>
          <div class="action-banner__title">You have pending notifications</div>
          <div class="action-banner__desc">
            <%= notificationSummary.totalUnread %> task<%= notificationSummary.totalUnread === 1 ? '' : 's' %> need your attention.
          </div>
          <div class="action-banner__meta">
            <span class="pill pill--soft">Documents: <%= notificationSummary.counts?.documents || 0 %></span>
            <span class="pill pill--soft">Simple Evaluation: <%= notificationSummary.counts?.simplePerformance || 0 %></span>
          </div>
        </div>
        <div class="action-banner__cta">
          <a href="/notifications" class="btn btn-primary">Open Notifications</a>
        </div>
      </div>
    <% } %>

    <% if (pendingSignatureCount > 0) { %>
      <div class="card action-banner action-banner--warn">
        <div>
          <div class="action-banner__title">Documents waiting for your signature</div>
          <div class="action-banner__desc">
            You have <%= pendingSignatureCount %> pending document<%= pendingSignatureCount === 1 ? '' : 's' %> to sign.
          </div>
          <% if (pendingSignatureDocuments.length > 0) { %>
            <div class="action-banner__meta-row">
              <% pendingSignatureDocuments.slice(0, 3).forEach(doc => { %>
                <span style="display:inline-flex; align-items:center; gap:6px;">
                  <span class="dot" style="width:8px;height:8px;box-shadow:none;background:#f59e0b;"></span>
                  <%= doc.title %> • <%= doc.organizationName || 'Organization' %>
                </span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <div class="action-banner__cta">
          <a href="<%= firstDocumentNotificationActionUrl %>" class="btn btn-primary">Review &amp; Sign</a>
        </div>
      </div>
    <% } else if (pendingOnboardingCount && pendingOnboardingCount > 0) { %>
      <div class="card action-banner action-banner--warn">
        <div>
          <div class="action-banner__title">Documents need your attention</div>
          <div class="action-banner__desc">
            You have <%= pendingOnboardingCount %> pending document step<%= pendingOnboardingCount === 1 ? '' : 's' %> waiting.
          </div>
          <% if (pendingOnboardingAssignments && pendingOnboardingAssignments.length > 0) { %>
            <div class="action-banner__meta-row">
              <% pendingOnboardingAssignments.slice(0, 3).forEach(assignment => { %>
                <span style="display:inline-flex; align-items:center; gap:6px;">
                  <span class="dot" style="width:8px;height:8px;box-shadow:none;background:#f59e0b;"></span>
                  <%= assignment.organization?.name || 'Organization' %>
                </span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <div class="action-banner__cta">
          <a href="/documents" class="btn btn-primary">Open Documents Workspace</a>
        </div>
      </div>
    <% } %>

    <% if (receivedEvaluationCount && receivedEvaluationCount > 0) { %>
      <div class="card action-banner action-banner--review">
        <div>
          <div class="action-banner__title">New performance feedback available</div>
          <div class="action-banner__desc">
            You have <%= receivedEvaluationCount %> performance evaluation<%= receivedEvaluationCount === 1 ? '' : 's' %> available for review.
          </div>
          <% if (latestReceivedEvaluations && latestReceivedEvaluations.length > 0) { %>
            <div class="action-banner__meta-row">
              <% latestReceivedEvaluations.forEach(entry => { %>
                <span style="display:inline-flex; align-items:center; gap:6px;">
                  <span class="dot" style="width:8px;height:8px;box-shadow:none;background:#7c3aed;"></span>
                  <strong style="color: var(--text);"><%= entry.evaluatorName || entry.evaluatorEmail || 'Manager' %></strong>
                  <span><%= new Date(entry.evaluationDate || entry.createdAt).toLocaleDateString() %></span>
                  <span>Avg <%= Number(entry.averageRating || 0).toFixed(2) %>/5</span>
                </span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <div class="action-banner__cta">
          <a href="/performance-evaluations?view=overview&reviewed=me" class="btn btn-primary">View My Evaluations</a>
        </div>
      </div>
    <% } %>

    <% const currentOrg = organizations && organizations.find(o => o.isCurrent) %>
    <% const visibleAppCount = (apps || []).length + 1; %>
    <% const pendingHubItems = Number(notificationSummary?.totalUnread || 0); %>
    <header class="hub-page-header">
      <div class="hub-page-header__copy">
        <div class="hub-page-header__eyebrow"><%= new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' }) %></div>
        <h1>Good <%= new Date().getHours() < 12 ? 'morning' : (new Date().getHours() < 18 ? 'afternoon' : 'evening') %>, <%= user.profile?.firstName || user.profile?.name?.split(' ')?.[0] || user.email.split('@')[0] %>.</h1>
        <p>
          Everything <%= currentOrg ? currentOrg.name : 'your organization' %> runs on lives here. Jump into an app, or manage who gets access<% if (pendingHubItems > 0) { %> — you have <strong><%= pendingHubItems %> item<%= pendingHubItems === 1 ? '' : 's' %></strong> waiting on your attention today<% } %>.
        </p>
      </div>
      <div class="hub-page-header__actions">
        <% if (currentOrg) { %>
          <div class="hub-organization" aria-label="Current organization">
            <div class="hub-organization__top">
              <div>
                <div class="hub-organization__label">Working in</div>
                <div class="hub-organization__profile">
                  <span class="hub-organization__mark" aria-hidden="true"><%= currentOrg.name.slice(0, 2).toUpperCase() %></span>
                  <div class="hub-organization__identity">
                    <div class="hub-organization__name"><%= currentOrg.name %></div>
                    <div class="hub-organization__plan"><%= currentSubscriptionAccess?.planName || 'Workspace' %> · <%= currentOrg.role %></div>
                  </div>
                </div>
              </div>
              <% if (organizations.length > 1) { %>
                <button type="button" class="hub-organization__switch" onclick="openOrgModal()" aria-label="Switch from <%= currentOrg.name %> to another organization">
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 7h11m0 0-3-3m3 3-3 3M16 13H5m0 0 3-3m-3 3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>Switch</span>
                </button>
              <% } %>
            </div>
            <dl class="hub-organization__stats">
              <div><dt>People</dt><dd><%= currentOrg.memberCount || 1 %></dd></div>
              <div><dt>Apps</dt><dd><%= visibleAppCount %></dd></div>
              <div><dt>SSO</dt><dd class="is-positive">On</dd></div>
            </dl>
          </div>
        <% } %>
      </div>
    </header>

    <% if (attendanceHubEnabled) { %>
      <section id="attendanceStrip" class="attendance-strip" data-state="idle" aria-label="Today's attendance" aria-live="polite">
        <div class="attendance-strip__state">
          <span class="attendance-strip__dot" aria-hidden="true"></span>
          <div>
            <div id="attendanceLabel" class="attendance-strip__label">Attendance</div>
            <div id="attendanceHint" class="attendance-strip__hint">Checking your status…</div>
          </div>
        </div>
        <div id="attendanceTime" class="attendance-strip__time">00:00:00</div>
        <div class="attendance-strip__actions">
          <button id="attendanceClockIn" class="attendance-action attendance-action--primary" type="button" hidden>Clock in</button>
          <button id="attendanceBreak" class="attendance-action" type="button" hidden>Take break</button>
          <button id="attendanceClockOut" class="attendance-action attendance-action--danger" type="button" hidden>Clock out</button>
          <a class="attendance-detail" href="/launch/time-attendance">View details →</a>
          <button id="attendanceToggle" class="attendance-strip__toggle" type="button" aria-expanded="true" aria-label="Collapse attendance controls" title="Collapse attendance controls">
