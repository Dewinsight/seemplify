  <script>
    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function persistTrialWelcome(payload) {
      if (!payload) return;

      try {
        sessionStorage.setItem('trialWelcome', JSON.stringify(payload));
      } catch (error) {
        console.warn('Could not persist trial welcome payload:', error);
      }
    }

    function consumeTrialWelcome() {
      try {
        const raw = sessionStorage.getItem('trialWelcome');
        if (!raw) return null;
        sessionStorage.removeItem('trialWelcome');
        return JSON.parse(raw);
      } catch (error) {
        sessionStorage.removeItem('trialWelcome');
        return null;
      }
    }

    function formatTrialDate(value) {
      if (!value) return '';

      try {
        return new Date(value).toLocaleDateString(undefined, {
          day: 'numeric',
          month: 'short',
          year: 'numeric'
        });
      } catch (error) {
        return '';
      }
    }

    function closeTrialWelcome() {
      const modal = document.getElementById('trialWelcomeModal');
      if (!modal) return;

      modal.classList.remove('active');
      document.body.style.overflow = '';
      window.removeEventListener('keydown', handleTrialWelcomeEscape);
      if (modal.__trialWelcomeClickHandler) {
        modal.removeEventListener('click', modal.__trialWelcomeClickHandler);
        modal.__trialWelcomeClickHandler = null;
      }

      setTimeout(() => {
        modal.hidden = true;
        modal.innerHTML = '';
      }, 280);
    }

    function handleTrialWelcomeEscape(event) {
      if (event.key === 'Escape') {
        closeTrialWelcome();
      }
    }

    function showTrialWelcome(payload) {
      const modal = document.getElementById('trialWelcomeModal');
      if (!modal || !payload) return;

      const appChips = Array.isArray(payload.accessibleApps)
        ? payload.accessibleApps.map((appName) => `<span class="celebration-app-chip">${escapeHtml(appName)}</span>`).join('')
        : '';
      const trialDays = Number(payload.trialDays || 7);
      const expiresLabel = formatTrialDate(payload.expiresAt);
      const confettiColors = ['#b980ff', '#a855f7', '#7c3aed', '#6366f1', '#ec4899', '#4c1d95'];
      const confettiMarkup = Array.from({ length: 18 }, (_, index) => {
        const color = confettiColors[index % confettiColors.length];
        return `<span class="celebration-confetti-piece" style="--piece:${index};--piece-color:${color};"></span>`;
      }).join('');

      modal.innerHTML = `
        <div class="celebration-panel" role="dialog" aria-modal="true" aria-labelledby="trialWelcomeTitle">
          <div class="celebration-confetti">${confettiMarkup}</div>
          <div class="celebration-shell">
            <div class="celebration-kicker">Congratulations</div>
            <div class="celebration-icon">✨</div>
            <h2 class="celebration-title" id="trialWelcomeTitle">${escapeHtml(payload.headline || 'Your organization is ready.')}</h2>
            <p class="celebration-copy">${escapeHtml(payload.subheadline || `We've assigned your organization the default Free Trial for ${trialDays} days.`)}</p>
            <div class="celebration-summary">
              <div class="celebration-summary-card">
                <div class="celebration-summary-label">Assigned Plan</div>
                <div class="celebration-summary-value">${escapeHtml(payload.planName || 'Free Trial')}</div>
              </div>
              <div class="celebration-summary-card">
                <div class="celebration-summary-label">Access Window</div>
                <div class="celebration-summary-value">${trialDays} day${trialDays === 1 ? '' : 's'}</div>
              </div>
              <div class="celebration-summary-card">
                <div class="celebration-summary-label">Expires</div>
                <div class="celebration-summary-value">${escapeHtml(expiresLabel || 'Soon')}</div>
              </div>
            </div>
            <div class="celebration-apps-title">${escapeHtml(payload.accessSummary || 'You can now explore every app in the workspace during your trial.')}</div>
            <div class="celebration-apps-grid">${appChips}</div>
            <div class="celebration-footnote">${escapeHtml(payload.closingMessage || 'Happy exploring.')}</div>
            <div class="celebration-actions">
              <div style="color: var(--muted); font-size: 13px;">Your new organization is ready to use immediately.</div>
              <button type="button" class="btn btn-primary celebration-dismiss" data-trial-welcome-close>Start Exploring</button>
            </div>
          </div>
        </div>
      `;

      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => modal.classList.add('active'));

      if (modal.__trialWelcomeClickHandler) {
        modal.removeEventListener('click', modal.__trialWelcomeClickHandler);
      }
      modal.__trialWelcomeClickHandler = (event) => {
        if (event.target === modal || event.target.closest('[data-trial-welcome-close]')) {
          closeTrialWelcome();
        }
      };
      modal.addEventListener('click', modal.__trialWelcomeClickHandler);

      window.addEventListener('keydown', handleTrialWelcomeEscape);
    }

    function showCreateModal() {
      const modal = document.getElementById('createModal');
      if (modal) {
        modal.classList.add('active');
      }
    }

    function hideCreateModal() {
      const modal = document.getElementById('createModal');
      if (modal) {
        modal.classList.remove('active');
      }
    }

    async function acceptDashboardInvite(button) {
      const inviteId = button?.dataset?.inviteId;
      const orgName = button?.dataset?.orgName || 'this organization';
      if (!inviteId) return;

      if (!confirm(`Accept invitation to join ${orgName}?`)) return;

      button.disabled = true;
      button.textContent = 'Accepting...';

      try {
        const response = await fetch(`/api/invitations/accept/${inviteId}`, {
          method: 'POST',
          credentials: 'same-origin'
        });
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Failed to accept invitation');
        }

        window.location.href = '/';
      } catch (error) {
        alert(error.message || 'Failed to accept invitation');
        button.disabled = false;
        button.textContent = 'Accept Invite';
      }
    }

    const createForm = document.getElementById('createForm');
    if (createForm) {
      createForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(createForm);

        try {
          const response = await fetch('/api/organizations', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              name: formData.get('name'),
              description: formData.get('description')
            })
          });
          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || 'Failed to create organization');
          }

          persistTrialWelcome(data.trialWelcome);
          window.location.href = '/';
        } catch (error) {
          alert(error.message || 'Failed to create organization');
        }
      });
    }

    const createModal = document.getElementById('createModal');
    if (createModal) {
      createModal.addEventListener('click', (e) => {
        if (e.target.classList.contains('modal')) {
          hideCreateModal();
        }
      });
    }

    const pendingTrialWelcome = consumeTrialWelcome();
    if (pendingTrialWelcome) {
      showTrialWelcome(pendingTrialWelcome);
    }

    function openOrgModal() {
      const modal = document.getElementById('customOrgModal');
      modal.classList.add('active');

      modal.onclick = (e) => {
        if (e.target === modal) closeCustomOrgModal();
      };

      document.onkeydown = (e) => {
        if (e.key === 'Escape') closeCustomOrgModal();
      };
    }

    function closeCustomOrgModal() {
      const modal = document.getElementById('customOrgModal');
      modal.classList.remove('active');
      document.onkeydown = null;
    }

    function switchOrganization(orgId) {
      const form = document.getElementById('org-switch-form');
      form.action = '/organizations/' + orgId + '/switch';
      form.submit();
    }

    let pendingBetaAppId = null;

    function showBetaWarning(appId, appName) {
      pendingBetaAppId = appId;
      document.getElementById('betaAppName').textContent = appName;
      const modal = document.getElementById('betaWarningModal');
      modal.classList.add('active');

      modal.onclick = (e) => {
        if (e.target === modal) closeBetaWarningModal();
      };

      document.onkeydown = (e) => {
        if (e.key === 'Escape') closeBetaWarningModal();
      };
    }

    function closeBetaWarningModal() {
      const modal = document.getElementById('betaWarningModal');
      modal.classList.remove('active');
      document.onkeydown = null;
      pendingBetaAppId = null;
    }

    function proceedToBetaApp() {
      if (pendingBetaAppId) {
        window.location.href = '/launch/' + pendingBetaAppId;
      }
    }
  </script>
  <script>
    (() => {
      const grid = document.getElementById('hubAppGrid');
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll('[data-app-card]'));
      const filters = Array.from(document.querySelectorAll('[data-app-filter]'));
      const search = document.getElementById('appSearchInput');
      const resultCount = document.getElementById('appsResultCount');
      const pinnedCount = document.getElementById('pinnedAppCount');
      const storageKey = 'seemplify-hub-pinned-apps-v1';
      let activeFilter = 'all';
      let pinned = new Set(['smarthr', 'leave-management']);

      try {
        const stored = JSON.parse(localStorage.getItem(storageKey) || 'null');
        if (Array.isArray(stored)) pinned = new Set(stored.map(String));
      } catch (_) {}

      function persistPins() {
        localStorage.setItem(storageKey, JSON.stringify(Array.from(pinned)));
      }

      function updatePins() {
        cards.forEach((card) => {
          const appId = card.dataset.appId;
          const isPinned = pinned.has(appId);
          card.dataset.pinned = String(isPinned);
          const button = card.querySelector('[data-pin-app]');
          if (button) {
            button.setAttribute('aria-pressed', String(isPinned));
            const title = card.querySelector('.app-card__title')?.textContent?.trim() || 'application';
            button.setAttribute('aria-label', `${isPinned ? 'Unpin' : 'Pin'} ${title}`);
          }
        });
        if (pinnedCount) pinnedCount.textContent = String(pinned.size);
      }

      function applyFilters() {
        const query = String(search?.value || '').trim().toLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const matchesText = !query || card.dataset.appTitle.includes(query) || card.textContent.toLowerCase().includes(query);
          const matchesCategory = activeFilter === 'all'
            || (activeFilter === 'pinned' ? pinned.has(card.dataset.appId) : card.dataset.appCategory === activeFilter);
          const show = matchesText && matchesCategory;
          card.hidden = !show;
          if (show) visible += 1;
        });
        if (resultCount) resultCount.textContent = `${visible} of ${cards.length} shown`;
      }

      filters.forEach((button) => button.addEventListener('click', () => {
        activeFilter = button.dataset.appFilter || 'all';
        filters.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        applyFilters();
      }));

      cards.forEach((card) => card.querySelector('[data-pin-app]')?.addEventListener('click', () => {
        const appId = card.dataset.appId;
        pinned.has(appId) ? pinned.delete(appId) : pinned.add(appId);
        persistPins();
        updatePins();
        applyFilters();
      }));
      search?.addEventListener('input', applyFilters);
      updatePins();
      applyFilters();
    })();
  </script>
  <% if (attendanceHubEnabled) { %>
  <script>
    (() => {
      const strip = document.getElementById('attendanceStrip');
      const label = document.getElementById('attendanceLabel');
      const hint = document.getElementById('attendanceHint');
      const time = document.getElementById('attendanceTime');
      const clockIn = document.getElementById('attendanceClockIn');
      const breakButton = document.getElementById('attendanceBreak');
      const clockOut = document.getElementById('attendanceClockOut');
      const toggle = document.getElementById('attendanceToggle');
      const cardToggle = document.getElementById('attendanceCardToggle');
      if (!strip) return;

      const COLLAPSE_KEY = 'seemplify:attendance-widget:collapsed';
      let credentials = null;
      let currentStatus = null;
      let statusReceivedAt = Date.now();
      let streamController = null;
      let reconnectTimer = null;

      function setCollapsed(collapsed, persist = true) {
        strip.dataset.collapsed = String(Boolean(collapsed));
        toggle?.setAttribute('aria-expanded', String(!collapsed));
        if (toggle) {
          const instruction = collapsed ? 'Expand attendance controls' : 'Collapse attendance controls';
          toggle.setAttribute('aria-label', instruction);
          toggle.title = instruction;
        }
        if (cardToggle) cardToggle.hidden = !collapsed;
        if (persist) localStorage.setItem(COLLAPSE_KEY, collapsed ? '1' : '0');
      }

      function timeParts(timeZone) {
        const parts = new Intl.DateTimeFormat('en-GB', {
          timeZone: timeZone || 'UTC', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
        }).formatToParts(new Date());
        return Object.fromEntries(parts.map(part => [part.type, part.value]));
      }

      function scheduledReminder() {
        const policy = currentStatus?.policy;
        if (!policy?.shiftStart || !policy?.shiftEnd) return null;
        const now = timeParts(policy.timezone);
        const dayMap = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
        if (!policy.workDays?.includes(dayMap[now.weekday])) return null;
        const minute = Number(now.hour) * 60 + Number(now.minute);
        const parse = value => Number(value.slice(0, 2)) * 60 + Number(value.slice(3, 5));
        if (policy.clockInReminder !== false && !currentStatus.isClockedIn && minute >= parse(policy.shiftStart) + Number(policy.clockInReminderMinutesAfter ?? 15) && minute < parse(policy.shiftEnd)) {
          return `Your workday started at ${policy.shiftStart}. Remember to clock in.`;
        }
        if (policy.clockOutReminder !== false && currentStatus.isClockedIn && !currentStatus.isOnBreak && minute >= parse(policy.shiftEnd) + Number(policy.clockOutReminderMinutesAfter ?? 0)) {
          return `Your scheduled day ended at ${policy.shiftEnd}. Clock out when you finish.`;
        }
        return null;
      }

      const formatSeconds = (total) => {
        const safe = Math.max(0, Math.floor(total));
        const hours = Math.floor(safe / 3600);
        const minutes = Math.floor((safe % 3600) / 60);
        const seconds = safe % 60;
        return [hours, minutes, seconds].map(value => String(value).padStart(2, '0')).join(':');
      };

      function render() {
        if (!currentStatus) return;
        const working = currentStatus.isClockedIn && !currentStatus.isOnBreak;
        strip.dataset.state = currentStatus.isOnBreak ? 'break' : working ? 'working' : 'idle';
        label.textContent = currentStatus.isOnBreak ? 'On break' : working ? 'Clocked in' : 'Not clocked in';
        const reminder = scheduledReminder();
        strip.dataset.reminder = String(Boolean(reminder));
        hint.textContent = reminder || (currentStatus.isOnBreak
          ? 'Resume when you are ready.'
          : working
            ? 'Live from Time & Attendance.'
            : 'Clock-in is explicit; signing in does not start time.');
        clockIn.hidden = currentStatus.isClockedIn;
        breakButton.hidden = !currentStatus.isClockedIn;
        clockOut.hidden = !currentStatus.isClockedIn;
        breakButton.textContent = currentStatus.isOnBreak ? 'Resume' : 'Take break';
      }

      function tick() {
        if (!currentStatus) return;
        let seconds = Number(currentStatus.timeWorked?.seconds ?? (Number(currentStatus.timeWorked?.minutes || 0) * 60));
        if (currentStatus.isClockedIn && !currentStatus.isOnBreak) {
          seconds += Math.floor((Date.now() - statusReceivedAt) / 1000);
        }
        time.textContent = formatSeconds(seconds);
      }

      async function getCredentials(force = false) {
        if (credentials && !force) return credentials;
        const response = await fetch('/api/hub/attendance-token', { credentials: 'same-origin', cache: 'no-store' });
        if (!response.ok) throw new Error((await response.json().catch(() => ({}))).error || 'Attendance unavailable');
        credentials = await response.json();
        return credentials;
      }

      async function attendanceFetch(path, options = {}, canRetry = true) {
        const access = await getCredentials();
        const response = await fetch(`${access.apiUrl}/api${path}`, {
          ...options,
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${access.token}`, ...(options.headers || {}) }
        });
        if (response.status === 401 && canRetry) {
          credentials = null;
          return attendanceFetch(path, options, false);
        }
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || 'Attendance action failed');
        return payload;
      }

      async function refreshStatus() {
        currentStatus = await attendanceFetch('/clock/status');
        statusReceivedAt = Date.now();
        render();
        tick();
      }

      function getLocation() {
        if (!navigator.geolocation) return Promise.resolve(null);
        return new Promise(resolve => navigator.geolocation.getCurrentPosition(
          position => resolve({ latitude: position.coords.latitude, longitude: position.coords.longitude, accuracy: position.coords.accuracy }),
          () => resolve(null),
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
        ));
      }

      async function act(path, needsLocation = false) {
        [clockIn, breakButton, clockOut].forEach(button => { button.disabled = true; });
        try {
          const location = needsLocation ? await getLocation() : null;
          if (needsLocation && currentStatus?.policy?.locationRequired && !location) {
            throw new Error('Location is required by your attendance policy. Allow location access and try again.');
          }
          await attendanceFetch(path, { method: 'POST', body: JSON.stringify({ location, timezone: Intl.DateTimeFormat().resolvedOptions().timeZone }) });
          await refreshStatus();
        } catch (error) {
          hint.textContent = error.message;
        } finally {
          [clockIn, breakButton, clockOut].forEach(button => { button.disabled = false; });
        }
      }

      async function connectStream() {
        clearTimeout(reconnectTimer);
        streamController?.abort();
        streamController = new AbortController();
        try {
          const access = await getCredentials();
          const response = await fetch(`${access.apiUrl}/api/clock/events`, {
            headers: { Authorization: `Bearer ${access.token}` },
            signal: streamController.signal
          });
          if (!response.ok || !response.body) throw new Error('Live attendance connection failed');
          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          while (true) {
            const result = await reader.read();
            if (result.done) break;
            buffer += decoder.decode(result.value, { stream: true });
            const messages = buffer.split('\n\n');
            buffer = messages.pop() || '';
            for (const message of messages) {
              if (message.includes('event: attendance')) await refreshStatus();
            }
          }
        } catch (error) {
          if (error.name !== 'AbortError') reconnectTimer = setTimeout(connectStream, 4000);
        }
      }

      clockIn.addEventListener('click', () => act('/clock/in', true));
      breakButton.addEventListener('click', () => act(currentStatus?.isOnBreak ? '/clock/break/end' : '/clock/break/start'));
      clockOut.addEventListener('click', () => act('/clock/out', true));
      toggle?.addEventListener('click', () => setCollapsed(strip.dataset.collapsed !== 'true'));
      cardToggle?.addEventListener('click', () => {
        setCollapsed(false);
        strip.scrollIntoView({ behavior: 'smooth', block: 'center' });
        toggle?.focus({ preventScroll: true });
      });
      setCollapsed(localStorage.getItem(COLLAPSE_KEY) === '1', false);
      setInterval(tick, 1000);
      setInterval(async () => { credentials = null; await connectStream(); }, 90000);
      refreshStatus().then(connectStream).catch(error => {
        label.textContent = 'Attendance unavailable';
        hint.textContent = error.message;
        time.textContent = '—';
      });
    })();
  </script>
  <% } %>
</body>

</html>
