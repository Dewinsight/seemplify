{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@seemplify/journey-browser-sdk": [
        "./src/index.ts"
      ],
      "@seemplify/journey-event-protocol": [
        "../journey-event-protocol/src/index.ts"
      ],
      "@seemplify/journey-event-protocol/mock": [
        "../journey-event-protocol/src/mockIngestServer.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "examples/**/*.ts"
  ]
}
