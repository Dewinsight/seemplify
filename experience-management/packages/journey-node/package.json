{
    "name":  "@seemplify/journey-node",
    "version":  "0.1.0",
    "private":  false,
    "type":  "module",
    "description":  "Failure-isolated Node.js client for the Seemplify Journey Event Protocol.",
    "author":  {
                   "name":  "Seemplify"
               },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/michaelegbo/seemplify.git",
                       "directory":  "experience-management/packages/journey-node"
                   },
    "homepage":  "https://github.com/michaelegbo/seemplify/tree/main/experience-management/packages/journey-node",
    "bugs":  {
                 "url":  "https://github.com/michaelegbo/seemplify/issues"
             },
    "keywords":  [
                     "analytics",
                     "customer-journey",
                     "nodejs",
                     "typescript"
                 ],
    "sideEffects":  false,
    "browser":  false,
    "main":  "./dist/cjs/index.js",
    "module":  "./dist/index.js",
    "types":  "./dist/cjs/index.d.ts",
    "exports":  {
                    ".":  {
                              "node":  {
                                           "require":  {
                                                           "types":  "./dist/cjs/index.d.ts",
                                                           "default":  "./dist/cjs/index.js"
                                                       },
                                           "import":  {
                                                          "types":  "./dist/index.d.ts",
                                                          "default":  "./dist/index.js"
                                                      }
                                       }
                          }
                },
    "files":  [
                  "dist",
                  "CHANGELOG.md",
                  "README.md",
                  "examples",
                  "LICENSE"
              ],
    "engines":  {
                    "node":  "\u003e=20.0.0"
                },
    "publishConfig":  {
                          "access":  "public",
                          "registry":  "https://registry.npmjs.org/"
                      },
    "scripts":  {
                    "clean":  "node ../../scripts/sdk-package-tools.mjs clean journey-node",
                    "build":  "npm run clean \u0026\u0026 tsc -p tsconfig.json \u0026\u0026 tsc -p tsconfig.cjs.json \u0026\u0026 node ../../scripts/sdk-package-tools.mjs mark-cjs journey-node \u0026\u0026 npm run verify:artifacts",
                    "typecheck":  "tsc --noEmit -p tsconfig.test.json",
                    "test":  "tsx --tsconfig tsconfig.test.json --test test/*.test.ts",
                    "verify:artifacts":  "node ../../scripts/sdk-package-tools.mjs verify journey-node",
                    "prepack":  "npm run build"
                },
    "dependencies":  {
                         "@seemplify/journey-event-protocol":  "0.1.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^24.1.0",
                            "tsx":  "^4.20.3",
                            "typescript":  "^5.8.3"
                        },
    "license":  "MIT"
}
