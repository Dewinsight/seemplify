HOST=127.0.0.1
PORT=5410
PUBLIC_URL=https://experience.aiinnigeria.com
# Production uses the dedicated database/role inside the installed local
# PostgreSQL 16 container. Tests may omit DATABASE_PROVIDER to retain isolated SQLite.
DATABASE_PROVIDER=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=seemplify_experience
POSTGRES_USER=seemplify_experience_app
POSTGRES_PASSWORD_FILE=../../.local-runtime/experience-management/postgres-password
POSTGRES_SSL=false
POSTGRES_SCHEMA_VERSION=1
POSTGRES_RUNTIME_SCHEMA_VERSION=4
SUBSCRIPTION_ENFORCEMENT_ENABLED=true
# Injected and verified automatically after the managed cutover. Do not guess it.
# POSTGRES_SOURCE_SHA256=
# Retained as the immutable migration/rollback source after PostgreSQL cutover.
DATABASE_PATH=../../.local-runtime/experience-management/experience.sqlite
UPLOAD_DIR=../../.local-runtime/experience-management/uploads
KNOWLEDGE_STORAGE_DIR=../../.local-runtime/experience-management/knowledge
KNOWLEDGE_RUNTIME_BASE_URL=http://127.0.0.1:11540
KNOWLEDGE_RUNTIME_SHARED_SECRET_FILE=../../.local-runtime/knowledge/service-secret
# Qwen remains the safe default. GTE is enabled only through an approved rollout.
EXPERIENCE_EMBEDDING_PROVIDER=qwen-tei
EXPERIENCE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EXPERIENCE_EMBEDDING_MODEL_REVISION=5cf2132abc99cad020ac570b19d031efec650f2b
EXPERIENCE_EMBEDDING_DTYPE=float16
EXPERIENCE_EMBEDDING_DIMENSIONS=2560
EXPERIENCE_EMBEDDING_CONCURRENCY=8
EXPERIENCE_VECTOR_INDEX_VERSION=qwen-v1
EXPERIENCE_EMBEDDING_DUAL_WRITE=false
EXPERIENCE_QWEN_ROLLBACK_RETAINED=true
EXPERIENCE_EMBEDDING_FORCE_QWEN=false
# KNOWLEDGE_EMBEDDING_MODEL and KNOWLEDGE_EMBEDDING_DIMENSION remain accepted for legacy Qwen deployments.
KNOWLEDGE_CHUNKER_VERSION=docling-hybrid-v1
KNOWLEDGE_MAX_DOCUMENT_BYTES=52428800
KNOWLEDGE_MAX_SPACE_BYTES=21474836480
KNOWLEDGE_WORKER_CONCURRENCY=1
KNOWLEDGE_WORKER_POLL_MS=750
KNOWLEDGE_WORKER_LEASE_MS=300000
KNOWLEDGE_WORKER_HEARTBEAT_MS=30000
KNOWLEDGE_BACKFILL_POLL_MS=2000
KNOWLEDGE_BACKFILL_LEASE_MS=120000
KNOWLEDGE_BACKFILL_HEARTBEAT_MS=30000
KNOWLEDGE_RETRIEVE_TOP_K=10
KNOWLEDGE_CONTEXT_MAX_BYTES=65536
ESIGN_STORAGE_DIR=../../.local-runtime/experience-management/esign
ESIGN_ENCRYPTION_KEY_FILE=../../.local-runtime/experience-management/esign-encryption-key
ESIGN_MAX_DOCUMENT_BYTES=52428800
ESIGN_MAX_DOCUMENT_PAGES=300
ESIGN_MAX_ENVELOPE_BYTES=209715200
ESIGN_MAX_ENVELOPE_DOCUMENTS=20
ESIGN_WORKER_POLL_MS=1000
ESIGN_SIGNING_SESSION_HOURS=12
LOCAL_LLM_BASE_URL=http://127.0.0.1:11435
LOCAL_LLM_SHARED_SECRET_FILE=../../.local-runtime/llm/service-secret
AI_WORKER_CONCURRENCY=4
NYLAS_ENV_FILE=../../recruiter/backend/.env
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_REDIRECT_URI=https://experience.aiinnigeria.com/api/integrations/nylas/callback
NYLAS_CONNECT_SCOPES=openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/calendar.readonly,offline_access,User.Read,Mail.Read,Mail.ReadWrite,Mail.Send,Calendars.Read
NYLAS_CREDENTIAL_ENCRYPTION_KEY_FILE=../../.local-runtime/experience-management/nylas-credential-encryption-key
NYLAS_OAUTH_STATE_MINUTES=10
NYLAS_REQUEST_TIMEOUT_MS=20000
NYLAS_MAX_THREAD_MESSAGES=100
NYLAS_MESSAGE_DETAIL_CONCURRENCY=6
NYLAS_MAX_MESSAGE_BODY_BYTES=131072
NYLAS_MAX_THREAD_BYTES=1048576
BREVO_ENV_FILE=../../../crm/Xplorer-Full-backend/.env
BREVO_FROM_EMAIL=no-reply@seemplifyai.com
BREVO_FROM_NAME=Seemplify Experience
EMAIL_MODE=send
BREVO_IDEMPOTENCY_TTL_MINUTES=29
BREVO_WEBHOOK_SECRET_FILE=../../.local-runtime/experience-management/brevo-webhook-secret
X_API_BASE_URL=https://api.x.com
X_OAUTH_BASE_URL=https://api.x.com
X_OAUTH2_AUTHORIZE_BASE_URL=https://x.com
X_CREDENTIAL_ENCRYPTION_KEY_FILE=../../.local-runtime/experience-management/x-credential-encryption-key
X_SEED_CONSUMER_KEY_FILE=../../.local-runtime/experience-management/x-consumer-key
X_SEED_CONSUMER_SECRET_FILE=../../.local-runtime/experience-management/x-consumer-secret
X_SEED_BEARER_TOKEN_FILE=../../.local-runtime/experience-management/x-bearer-token
X_SEED_ACCESS_TOKEN_FILE=../../.local-runtime/experience-management/x-access-token
X_SEED_ACCESS_TOKEN_SECRET_FILE=../../.local-runtime/experience-management/x-access-token-secret
X_SEED_CLIENT_ID_FILE=../../.local-runtime/experience-management/x-client-id
X_SEED_CLIENT_SECRET_FILE=../../.local-runtime/experience-management/x-client-secret
X_SYNC_POLL_SECONDS=60
ADMIN_EMAIL=admin@seemplify.local
ADMIN_PASSWORD_FILE=../../.local-runtime/experience-management/admin-password
SESSION_SECRET_FILE=../../.local-runtime/experience-management/session-secret
