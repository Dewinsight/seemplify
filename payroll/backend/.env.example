# Payroll Backend Environment Variables
# Copy this to .env and fill in the values

# Server
NODE_ENV=development
PORT=5006

# MongoDB
MONGODB_URI=mongodb://localhost:27017/payroll-management

# Session & Security
SESSION_SECRET=your-session-secret-here
JWT_SECRET=your-jwt-secret-here
HUB_TOKEN_SECRET=your-hub-token-secret-here

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5007

# OIDC / Identity Provider Configuration
IDP_ISSUER_URL=http://localhost:4000
OIDC_CLIENT_ID=payroll-management
OIDC_CLIENT_SECRET=your-client-secret-here
OIDC_REDIRECT_URI=http://localhost:5006/api/auth/oidc/callback

# Outbound transactional email — self-hosted Seemplify mail service.
# 127.0.0.1:5020 is the local development address only; deployed environments
# must set this explicitly. Missing URL, token or sender fails closed.
MAIL_API_BASE_URL=http://127.0.0.1:5020
# Format: <keyId>.<secret>. Inject from the secret store; never commit a value.
MAIL_API_TOKEN=
# Preferred for local/deployed secret mounts. MAIL_API_TOKEN wins when both exist.
MAIL_API_TOKEN_FILE=
MAIL_FROM_EMAIL=no-reply@seemplifyai.com
MAIL_FROM_NAME=Seemplify Payroll
MAIL_TIMEOUT_MS=15000

# Internal Service Communication
INTERNAL_API_SECRET=internal-secret-key
LEAVE_SERVICE_URL=http://localhost:5002
PERFORMANCE_SERVICE_URL=http://localhost:5004

# ===========================================
# PRODUCTION VALUES (Azure)
# ===========================================
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://...
# SESSION_SECRET=<strong-random-string>
# JWT_SECRET=<strong-random-string>
# HUB_TOKEN_SECRET=<strong-random-string>
# FRONTEND_URL=https://smarthr-payroll.netlify.app
# IDP_ISSUER_URL=https://smarthr-identity.azurewebsites.net
# OIDC_CLIENT_ID=payroll-management
# OIDC_CLIENT_SECRET=<from-identity-provider>
# OIDC_REDIRECT_URI=https://payroll-backend-smarthr.azurewebsites.net/api/auth/oidc/callback
# INTERNAL_API_SECRET=<shared-internal-secret>
# LEAVE_SERVICE_URL=https://leave-management.azurewebsites.net
# PERFORMANCE_SERVICE_URL=https://performance-backend.azurewebsites.net

# Webhook Secret (must match IDP_WEBHOOK_SECRET in Identity Provider)
IDP_WEBHOOK_SECRET=your-webhook-secret-key
