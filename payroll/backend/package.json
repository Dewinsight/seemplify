{
  "name": "payroll-backend",
  "version": "1.0.2",
  "description": "Payroll Management Service for SmartHR",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:tax": "jest --runInBand services/__tests__/taxJurisdictionService.test.js services/__tests__/TaxJurisdictionDynamicPacks.test.js services/__tests__/taxPreviewMatrix.test.js services/__tests__/StatutoryMoneyService.test.js services/__tests__/StatutoryLiabilityLedgerService.test.js services/__tests__/StatutoryYearToDateService.test.js services/__tests__/TaxAdapterCandidateRegistry.test.js services/__tests__/TaxJurisdictionRolloutInventory.test.js services/__tests__/UnitedKingdomPaye2026Service.test.js services/__tests__/GhanaPayroll2026Service.test.js services/__tests__/Kenya2026PayrollAdapter.test.js services/__tests__/Nigeria2026PayrollAdapter.test.js services/__tests__/USFederalPayrollAdapter2026.test.js services/__tests__/Canada2026OntarioPayrollAdapter.test.js services/__tests__/SouthAfrica2027PayrollAdapter.test.js",
    "report:tax-preview": "node scripts/runTaxPreviewMatrix.js && node scripts/renderTaxCertificationReport.js"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "bcrypt": "^5.1.0",
    "connect-mongo": "^5.1.0",
