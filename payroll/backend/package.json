    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "node-cron": "^3.0.2",
    "openid-client": "^5.0.0",
    "pdfkit": "^0.13.0"
  },
  "overrides": {
    "axios": "^1.14.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^2.0.22"
  }
}
