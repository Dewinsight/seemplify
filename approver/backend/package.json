{
    "name": "approver-backend",
    "version": "1.0.0",
    "description": "Backend for Approver application",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "seed:rules:system": "node scripts/uploadSystemRulesToAllOrgs.js",
        "seed:governance": "node scripts/seedGovernancePoliciesAndRoles.js",
        "seed:governance:clear-non-admin": "node scripts/seedGovernancePoliciesAndRoles.js --clear-non-admin-roles",
        "migrate:rule-effects": "node scripts/backfillRuleEffects.js",
        "sanitize:rules": "node scripts/sanitizeRules.js",
        "refine:rules:ai": "node scripts/refineRulesWithAI.js --scope=system --dry-run",
        "verify:ai-config": "node scripts/verifyAzureAiConfig.js",
        "audit:mosaic": "node scripts/auditMosaicState.js",
        "repair:mosaic": "node scripts/repairMosaicState.js --dry-run",
        "repair:mosaic:apply": "node scripts/repairMosaicState.js --apply",
        "test:approval-engine": "node --test tests/approvalEngine.test.js",
        "test:smoke:agentic": "node scripts/smokeTestAgenticAnalysis.js",
        "test:smoke:agentic:apply": "node scripts/smokeTestAgenticAnalysis.js --apply",
        "test:live:gpt41": "node scripts/liveGpt41GoldenHarness.js",
        "test:weaviate": "node scripts/testWeaviate.js",
        "embeddings:backfill": "node scripts/indexWeaviateEmbeddings.js",
        "test:ab:weaviate": "node scripts/abTestWeaviateGrounding.js",
        "migrate:logo-assets": "node scripts/backfillLogoAssets.js",
        "migrate:logo-assets:from-api": "node scripts/backfillLogoAssetsFromApi.js"
    },
    "dependencies": {
        "axios": "^1.14.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.0.3",
        "multer": "^2.0.2",
        "openai": "^4.24.1"
    },
    "overrides": {
        "axios": "^1.14.0"
    },
    "devDependencies": {
        "nodemon": "^3.0.2"
    }
}
