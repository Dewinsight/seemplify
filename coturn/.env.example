# Coturn + TURN API — copy to .env and set values (do not commit .env)

# Shared secret for TURN REST API (time-limited credentials). Generate: openssl rand -hex 32
TURN_AUTH_SECRET=

# Server public IP (required for TURN relay). Use the current Hostinger address.
COTURN_EXTERNAL_IP=

# Local routable address used by coturn relay sockets. On a directly addressed
# VPS this is the same value as COTURN_EXTERNAL_IP. Set it separately only when
# the public address is NAT-mapped to a different local interface address.
COTURN_RELAY_IP=

# TURN API (optional overrides)
TURN_HOST=turn.seemplifyai.com
TURN_PORT=3478
TURN_TTL=86400
