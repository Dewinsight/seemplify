NODE_ENV=production
PORT=5012
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
SESSION_SECRET=your-session-secret-here
APP_BASE_URL=https://learning.seemplifyai.com
# Seemplify Identity Provider (OIDC). Keep OIDC_CLIENT_SECRET in the deployment
# secret store and match the seemplify-learning client registered in the IdP.
IDP_ISSUER_URL=https://auth.seemplifyai.com
OIDC_CLIENT_ID=seemplify-learning
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://learning.seemplifyai.com/auth/seemplify/callback
# Signed Learning activity synchronization into Seemplify Performance.
# Use the same secret in the Performance deployment. Independent Learning
# accounts are never synchronized until they link a Seemplify identity.
PERFORMANCE_MANAGEMENT_URL=https://api-performance.seemplifyai.com
PERFORMANCE_MANAGEMENT_WEBHOOK_SECRET=
PERFORMANCE_MANAGEMENT_TIMEOUT_MS=8000
LEARNING_SYNC_INTERVAL_MS=15000
# Outbound transactional email — self-hosted Seemplify mail service.
# 127.0.0.1:5020 is the local development address only; deployed environments
# must set this explicitly. Missing URL, token or sender fails closed.
MAIL_API_BASE_URL=http://127.0.0.1:5020
# Format: <keyId>.<secret>. Inject from the secret store; never commit a value.
MAIL_API_TOKEN=
MAIL_FROM_EMAIL=no-reply@seemplifyai.com
MAIL_FROM_NAME=SEEMPLIFY
MAIL_TIMEOUT_MS=15000
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_WEBHOOK_HASH=your-flutterwave-webhook-hash
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key
CREDENTIALS_ENCRYPTION_KEY=64-char-hex-master-key
