<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
  <style>
    .auth-wrap {
      max-width: 460px;
      margin: 48px auto;
      padding: 20px;
    }
    .auth-card {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      padding: 20px;
      display: grid;
      gap: 12px;
    }
    .auth-title {
      margin: 0;
      color: var(--text);
      font-size: 28px;
      letter-spacing: -0.02em;
    }
    .auth-subtitle {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
    }
    .auth-card label {
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .auth-card .input {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--field-bg);
      color: var(--text);
      padding: 10px 12px;
      font-size: 14px;
    }
    .auth-card .input:focus {
      outline: none;
      border-color: rgba(56, 189, 248, .7);
      box-shadow: 0 0 0 2px rgba(56, 189, 248, .18);
    }
    .auth-footer {
      margin-top: 8px;
      color: var(--muted);
      font-size: 13px;
    }
  </style>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-card">
      <h1 class="auth-title">Reset Password</h1>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <% if (!tokenValid) { %>
        <p class="auth-subtitle">This reset link is invalid or expired.</p>
        <p class="auth-footer"><a href="/forgot-password">Request a new reset link</a></p>
      <% } else { %>
        <p class="auth-subtitle">Set a new password for <strong><%= email %></strong>.</p>

        <form method="post" action="/reset-password" style="display:grid; gap:10px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
          <input type="hidden" name="token" value="<%= token %>">
          <input type="hidden" name="email" value="<%= email %>">

          <label>New Password</label>
          <input class="input" type="password" name="password" required minlength="8" placeholder="Minimum 8 characters">

          <label>Confirm Password</label>
          <input class="input" type="password" name="confirm_password" required minlength="8" placeholder="Re-enter password">

          <button class="btn btn-primary" type="submit">Update password</button>
        </form>
      <% } %>

      <p class="auth-footer"><a href="/login">Back to sign in</a></p>
    </div>
  </div>
</body>
</html>
