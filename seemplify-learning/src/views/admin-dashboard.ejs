<body class="admin-page">
<%
  const sectionPath = (section) => section === 'overview' ? '/admin' : `/admin/${section}`
  const navItems = [
    { key: 'overview', label: 'Overview' },
    { key: 'courses', label: 'Course Management' },
    { key: 'approvals', label: 'Approval Queue' },
    { key: 'partners', label: 'Partners' },
    { key: 'super-users', label: 'Platform Admins' },
    { key: 'audit-log', label: 'Audit Log' },
    { key: 'creators', label: 'Creators' },
    { key: 'users', label: 'Users & Roles' },
    { key: 'commission', label: 'Commissions' },
    { key: 'payments', label: 'Payments' },
    { key: 'settings', label: 'Platform Settings' },
    { key: 'analytics', label: 'Analytics' }
  ]
  const navGroups = [
    { title: 'Course Ops', keys: ['overview', 'courses', 'approvals', 'creators'] },
    { title: 'Partner Ops', keys: ['partners'] },
    { title: 'Access Control', keys: ['super-users', 'audit-log', 'users'] },
    { title: 'Commerce', keys: ['commission', 'payments'] },
    { title: 'Control', keys: ['settings', 'analytics'] }
  ]
  const sectionLabel = {
    overview: 'Admin Overview',
    courses: 'Course Management',
    approvals: 'Course Approval Queue',
    partners: 'Partner Operations',
    'super-users': 'Platform Admins',
    'audit-log': 'Admin Activity Log',
    creators: 'Creator Management',
    users: 'Users & Roles',
    commission: 'Commission Management',
    payments: 'Payment Monitoring',
    settings: 'Platform Settings',
    analytics: 'Analytics'
  }
  const currentSection = navItems.some((item) => item.key === adminSection) ? adminSection : 'overview'
  const adminReturnToPath = adminReturnTo || sectionPath(currentSection)
  const roleLabel = String(role || 'admin').replace(/_/g, ' ')
  const currencyOptions = Array.isArray(supportedCurrencies) && supportedCurrencies.length > 0
    ? supportedCurrencies
    : [{ code: 'NGN', name: 'Nigerian Naira', symbol: 'NGN' }]
  const currencyCodes = currencyOptions.map((option) => String(option?.code || '').trim().toUpperCase()).filter(Boolean)
  const selectCurrency = (value, fallback = 'NGN') => {
    const normalized = String(value || '').trim().toUpperCase()
    if (currencyCodes.includes(normalized)) return normalized
    const fallbackCode = String(fallback || '').trim().toUpperCase()
    if (currencyCodes.includes(fallbackCode)) return fallbackCode
    return currencyCodes[0] || 'NGN'
  }
  const defaultCurrency = selectCurrency(defaultCurrencyCode || platformSettings?.defaultCurrency || 'NGN', 'NGN')
  const minorToMajorInput = (value) => {
    const minor = Number(value || 0)
    const safeMinor = Number.isFinite(minor) ? Math.max(0, minor) : 0
    const major = safeMinor / 100
    if (Number.isInteger(major)) return String(major)
    return major.toFixed(2).replace(/\.?0+$/, '')
  }
  const dateText = (value) => {
    if (!value) return '-'
    const date = new Date(value)
    return Number.isNaN(date.getTime()) ? '-' : date.toLocaleString()
  }
  const courses = ((adminCourses || managedCourses) || []).slice().sort((a, b) => new Date(b.updatedAt || 0) - new Date(a.updatedAt || 0))
  const isPaidCourse = (course) => {
    const pricingMode = String(course?.pricingMode || '').trim().toLowerCase()
    if (pricingMode === 'paid') return true
    const pricingAmount = Number(course?.pricing?.amount || course?.amountMinor || 0)
    return Number.isFinite(pricingAmount) && pricingAmount > 0
  }
  const courseMetrics = {
    total: courses.length,
    published: courses.filter((course) => String(course.status || '').trim().toLowerCase() === 'published').length,
    draft: courses.filter((course) => String(course.status || '').trim().toLowerCase() === 'draft').length,
    pending: courses.filter((course) => String(course.status || '').trim().toLowerCase() === 'pending_public_review').length,
    archived: courses.filter((course) => String(course.status || '').trim().toLowerCase() === 'archived').length
  }
  courseMetrics.paid = courses.filter((course) => isPaidCourse(course)).length
  courseMetrics.free = Math.max(0, courseMetrics.total - courseMetrics.paid)
  courseMetrics.ownerEditable = courses.filter((course) => course.canEdit).length
  courseMetrics.moderationOnly = courses.filter((course) => !course.canEdit).length
  const pendingOnly = pendingReviewCourses || []
  const approvalCourses = (approvalQueueCourses || pendingOnly || []).slice().sort((a, b) => new Date(b.submittedAt || 0) - new Date(a.submittedAt || 0))
  const recentReviewDecisions = (recentCourseReviewDecisions || []).slice()
  const approvalDecisionCounts = recentReviewDecisions.reduce((accumulator, course) => {
    const decision = String(course?.reviewDecision || '').trim().toLowerCase()
    if (decision && Object.prototype.hasOwnProperty.call(accumulator, decision)) accumulator[decision] += 1
    return accumulator
  }, {
    approved: 0,
    changes_requested: 0,
    denied: 0
  })
  const creatorRows = visibleCreatorAdminRows || creatorAdminRows || []
  const selectedCreatorId = String((adminCourseFilters && adminCourseFilters.creatorId) || (adminCreatorFilters && adminCreatorFilters.creatorId) || '')
  const selectedCreator = (creatorAdminRows || []).find((creator) => creator.creatorId === selectedCreatorId) || null
  const courseStatusFilter = String((adminCourseFilters && adminCourseFilters.status) || 'all')
  const courseVisibilityFilter = String((adminCourseFilters && adminCourseFilters.visibility) || 'all')
  const courseTypeFilter = String((adminCourseFilters && adminCourseFilters.type) || 'all')
  const coursePaymentFilter = String((adminCourseFilters && adminCourseFilters.paymentMode) || 'all')
  const courseSearchFilter = String((adminCourseFilters && adminCourseFilters.search) || '')
  const focusedCourseId = String((adminCourseFilters && adminCourseFilters.focusCourseId) || '')
  const focusedCourse = focusedAdminCourse || null
  const focusedCourseReviews = Array.isArray(focusedAdminCourseReviews) ? focusedAdminCourseReviews : []
  const focusedCourseReviewStats = focusedAdminCourseReviewStats || { total: 0, visible: 0, hidden: 0, withComments: 0, withReplies: 0 }
  const withAdminReturnTo = (path, returnTo = '') => {
    const normalizedReturnTo = String(returnTo || '').trim()
    return normalizedReturnTo
      ? `${path}${path.includes('?') ? '&' : '?'}returnTo=${encodeURIComponent(normalizedReturnTo)}`
      : path
  }
  const buildAdminCourseRecordPath = (courseId, returnTo = '') => withAdminReturnTo(
    `/admin/courses/${encodeURIComponent(String(courseId || '').trim())}`,
    returnTo
  )
  const buildAdminCourseEditPath = (courseId, returnTo = '') => withAdminReturnTo(
    `/admin/courses/${encodeURIComponent(String(courseId || '').trim())}/edit`,
    returnTo
  )
  const courseLifecycleChoices = ['draft', 'pending_public_review', 'published', 'archived']
  const showCreateCoursePanel = false
  const hasActiveCourseFilters = Boolean(
    selectedCreatorId
    || (courseStatusFilter && courseStatusFilter !== 'all')
    || (courseVisibilityFilter && courseVisibilityFilter !== 'all')
    || (courseTypeFilter && courseTypeFilter !== 'all')
    || (coursePaymentFilter && coursePaymentFilter !== 'all')
    || courseSearchFilter
  )
  const navItemByKey = new Map(navItems.map((item) => [item.key, item]))
  const navMeta = {
    overview: `${Number(stats?.publishedCourseCount || 0)} live`,
    courses: `${Number(courses.length)} courses`,
    approvals: `${Number(approvalCourses.length)} queued`,
    partners: `${Number((partnerOrganizations || []).length)} orgs`,
    'super-users': `${Array.isArray(adminAccounts) ? adminAccounts.filter((account) => ['admin', 'super_admin'].includes(String(account.platformRole || '').trim().toLowerCase())).length : 0} users`,
    'audit-log': `${Number((auditLogEntries || []).length)} events`,
    creators: `${Number((creatorAdminRows || []).length)} creators`,
    users: `${Number((adminAccounts || []).length)} users`,
    commission: `${Number((commissionSettings?.accountOverrides || []).length + (commissionSettings?.courseOverrides || []).length)} overrides`,
    payments: `${Number(paymentStats?.pendingCount || 0)} pending`,
    settings: 'platform',
    analytics: `${Number(analytics?.lookbackDays || 30)}d`
  }
  const coursesReturnTo = (adminCourseFilters && adminCourseFilters.returnTo) || '/admin/courses'
  const creatorsReturnTo = (adminCreatorFilters && adminCreatorFilters.returnTo) || '/admin/creators'
  const toNumber = (value) => Number.isFinite(Number(value)) ? Number(value) : 0
  const toLower = (value) => String(value || '').trim().toLowerCase()
  const calcBarWidth = (value, max) => {
    const safeValue = Math.max(0, toNumber(value))
    const safeMax = Math.max(0, toNumber(max))
    if (!safeValue || !safeMax) return '0%'
    return `${Math.max(12, Math.min(100, Math.round((safeValue / safeMax) * 100)))}%`
  }
  const moneyText = (value, currency = 'NGN') => {
    const amount = Number(value || 0)
    const safeAmount = Number.isFinite(amount) ? amount : 0
    try {
      return new Intl.NumberFormat('en-NG', {
        style: 'currency',
        currency: String(currency || 'NGN').trim().toUpperCase() || 'NGN',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(safeAmount / 100)
    } catch (error) {
      return `${String(currency || 'NGN').trim().toUpperCase() || 'NGN'} ${(safeAmount / 100).toFixed(2)}`
    }
  }
  const reviewDecisionClass = (course) => {
    const decision = String(course?.reviewDecision || '').trim().toLowerCase()
    if (decision === 'changes_requested') return 'review-changes_requested'
    if (decision === 'denied') return 'review-denied'
    if (decision === 'approved') return 'review-approved'
    if (decision === 'pending') return 'review-pending'
    return ''
  }
  const reviewFeedbackTone = (course) => {
    const decision = String(course?.reviewDecision || '').trim().toLowerCase()
    if (['pending', 'approved', 'changes_requested', 'denied'].includes(decision)) return decision
    return 'pending'
  }
  const reviewMessageForCourse = (course) => {
    const decision = String(course?.reviewDecision || '').trim().toLowerCase()
    if (decision === 'pending') return 'This course is waiting for admin review. You can keep editing, but any major changes should be followed by a fresh submission.'
    if (decision === 'approved') return 'This course was approved for publishing. The latest review note is kept here for audit visibility.'
    if (decision === 'changes_requested') return 'Admin requested specific updates. Make the changes below, then set the course back to published to resubmit it for review.'
    if (decision === 'denied') return 'This submission was denied. You can still revise the course, address the feedback, and submit it again when it is ready.'
    return ''
  }
  const websiteHref = '/'
  const partnerOrgRows = Array.isArray(partnerOrganizations) ? partnerOrganizations : []
  const partnerRequestRows = Array.isArray(roleApprovalRequests) ? roleApprovalRequests : []
  const partnerView = ['directory', 'cash', 'onboarding', 'agents'].includes(String(adminPartnerView || '').trim().toLowerCase())
    ? String(adminPartnerView || '').trim().toLowerCase()
    : 'overview'
  const partnerFocus = adminPartnerFocus || {}
  const partnerViewPath = (value = 'overview', focus = {}) => {
    const normalizedValue = String(value || '').trim().toLowerCase()
    const params = new URLSearchParams()
    if (normalizedValue && normalizedValue !== 'overview') {
      params.set('partnerView', normalizedValue)
    }
    const normalizedFocus = focus || {}
    if (normalizedValue === 'directory' && normalizedFocus.organizationId) {
      params.set('organizationId', String(normalizedFocus.organizationId).trim())
    }
    if (normalizedValue === 'cash' && normalizedFocus.withdrawalId) {
      params.set('withdrawalId', String(normalizedFocus.withdrawalId).trim())
    }
    if (normalizedValue === 'onboarding' && normalizedFocus.requestId) {
      params.set('requestId', String(normalizedFocus.requestId).trim())
    }
    if (normalizedValue === 'agents' && normalizedFocus.agentPayoutId) {
      params.set('agentPayoutId', String(normalizedFocus.agentPayoutId).trim())
    }
    const query = params.toString()
    return query ? `/admin/partners?${query}` : '/admin/partners'
  }
  const partnerSubviewMeta = {
    overview: {
      label: 'Overview',
      title: 'Partner hub',
      description: 'Start from a clean hub, then open the exact operating lane you need.'
    },
    directory: {
      label: 'Directory',
      title: 'Partner directory',
      description: 'Manage organizations, members, and partner-super assignments without mixing in payouts.'
    },
    cash: {
      label: 'Cash',
      title: 'Cash operations',
      description: 'Keep partner withdrawals in one controlled payout lane.'
    },
    onboarding: {
      label: 'Onboarding',
      title: 'Partner onboarding',
      description: 'Review partner and channel-partner requests in a dedicated queue.'
    },
    agents: {
      label: 'Agents',
      title: 'Agent commissions',
      description: 'Track agent payout approvals separately from partner withdrawals.'
    }
  }
  const activePartnerSubview = partnerSubviewMeta[partnerView] || partnerSubviewMeta.overview
  const selectedPartnerOrganization = partnerOrgRows.find((organization) => String(organization._id || '') === String(partnerFocus.organizationId || '')) || null
  const selectedPartnerWithdrawal = (partnerWithdrawalRequests || []).find((request) => String(request._id || '') === String(partnerFocus.withdrawalId || '')) || null
  const selectedPartnerRequest = partnerRequestRows.find((request) => String(request._id || '') === String(partnerFocus.requestId || '')) || null
  const selectedAgentPayout = (agentPayoutRows || []).find((entry) => String(entry._id || '') === String(partnerFocus.agentPayoutId || '')) || null
  const managedAccountRows = Array.isArray(adminAccounts)
    ? adminAccounts.filter((account) => account.agentDashboardRole !== 'channel_sales_agent')
    : []
  const platformAdminRows = managedAccountRows.filter((account) => ['admin', 'super_admin'].includes(toLower(account.platformRole)))
  const pendingPartnerRequestCount = partnerRequestRows.filter((request) => toLower(request.status) === 'pending').length
  const activePartnerOrgCount = partnerOrgRows.filter((organization) => toLower(organization.partnerStatus) === 'active').length
  const suspendedPartnerOrgCount = partnerOrgRows.filter((organization) => toLower(organization.partnerStatus) === 'suspended').length
  const pendingPartnerOrgCount = partnerOrgRows.filter((organization) => toLower(organization.partnerStatus) === 'pending').length
  const channelPartnerOrgCount = partnerOrgRows.filter((organization) => toLower(organization.partnerType) === 'channel_partner').length
  const standardPartnerOrgCount = partnerOrgRows.filter((organization) => toLower(organization.partnerType) === 'partner').length
  const platformAdminAccountCount = platformAdminRows.length
  const partnerManagedAccountCount = managedAccountRows.filter((account) => Boolean(account.partnerDashboardRole)).length
  const totalPartnerAgents = partnerOrgRows.reduce((sum, organization) => sum + toNumber(organization.agentCount), 0)
  const totalPartnerMembers = partnerOrgRows.reduce((sum, organization) => (
    sum + (Array.isArray(organization.members) ? organization.members.length : 0)
  ), 0)
  const partnerPublishedCourseCount = partnerOrgRows.reduce((sum, organization) => sum + toNumber(organization.publishedCourses), 0)
  const partnerDraftCourseCount = partnerOrgRows.reduce((sum, organization) => sum + toNumber(organization.draftCourses), 0)
  const partnerAvailableWalletMinor = partnerOrgRows.reduce((sum, organization) => sum + toNumber(organization.partnerWithdrawalAvailableMinor), 0)
  const partnerPendingCommissionMinor = partnerOrgRows.reduce((sum, organization) => (
    sum
    + toNumber(organization.pendingCommissionMinor)
    + toNumber(organization.recommendedCommissionMinor)
    + toNumber(organization.approvedCommissionMinor)
  ), 0)
  const openPartnerWithdrawalCount = (partnerWithdrawalRequests || []).filter((request) => ['pending', 'approved'].includes(toLower(request.status))).length
  const paidPartnerWithdrawalCount = (partnerWithdrawalRequests || []).filter((request) => toLower(request.status) === 'paid').length
  const pendingAgentPayoutCount = (agentPayoutRows || []).filter((entry) => ['pending', 'recommended', 'approved'].includes(toLower(entry.status))).length
  const paidAgentPayoutCount = (agentPayoutRows || []).filter((entry) => toLower(entry.status) === 'paid').length
  const reviewedPartnerRequestCount = partnerRequestRows.filter((request) => toLower(request.status) !== 'pending').length
  const channelPartnerRequestCount = partnerRequestRows.filter((request) => String(request.partnerType || request.requestedRole || '').toLowerCase().includes('channel')).length
  const standardPartnerRequestCount = partnerRequestRows.length - channelPartnerRequestCount
  const partnerSubviewCards = [
    {
      key: 'directory',
      eyebrow: 'Directory',
      title: 'Organizations and member control',
      description: 'Browse partner organizations, inspect status, and manage member roles inside each org.',
      primary: `${partnerOrgRows.length}`,
      primaryLabel: 'Organizations',
      metrics: [
        `${activePartnerOrgCount} active`,
        `${totalPartnerMembers} members`,
        `${totalPartnerAgents} linked agents`
      ]
    },
    {
      key: 'cash',
      eyebrow: 'Cash',
      title: 'Withdrawal review lane',
      description: 'Handle partner withdrawal requests without scrolling through onboarding or agent operations.',
      primary: moneyText(partnerPendingCommissionMinor, 'NGN'),
      primaryLabel: 'Commission due',
      metrics: [
        `${openPartnerWithdrawalCount} open withdrawals`,
        `${paidPartnerWithdrawalCount} paid`,
        `${moneyText(partnerAvailableWalletMinor, 'NGN')} available`
      ]
    },
    {
      key: 'onboarding',
      eyebrow: 'Onboarding',
      title: 'Application review queue',
      description: 'Approve or reject partner and channel-partner requests from one focused queue.',
      primary: `${pendingPartnerRequestCount}`,
      primaryLabel: 'Pending requests',
      metrics: [
        `${reviewedPartnerRequestCount} reviewed`,
        `${channelPartnerRequestCount} channel requests`,
        `${standardPartnerRequestCount} standard partner requests`
      ]
    },
    {
      key: 'agents',
      eyebrow: 'Agents',
      title: 'Commission payout lane',
      description: 'Keep agent commissions isolated so channel-partner operations stay readable.',
      primary: `${pendingAgentPayoutCount}`,
      primaryLabel: 'Open payouts',
      metrics: [
        `${paidAgentPayoutCount} paid`,
        `${channelPartnerOrgCount} channel orgs`,
        `${(agentPayoutRows || []).length} total entries`
      ]
    }
  ]
  const partnerLaneSummaryByView = {
    overview: {
      title: 'Partner hub',
      description: 'Start with one lane. The workspace below switches to that lane so lists and records stay separated.',
      metrics: [
        { label: 'Organizations', value: `${partnerOrgRows.length}` },
        { label: 'Pending requests', value: `${pendingPartnerRequestCount}` },
        { label: 'Commission due', value: moneyText(partnerPendingCommissionMinor, 'NGN') },
        { label: 'Wallet available', value: moneyText(partnerAvailableWalletMinor, 'NGN') }
      ]
    },
    directory: {
      title: 'Partner directory',
      description: 'Browse organizations first, then open one record to manage status, membership, and org-level access.',
      metrics: [
        { label: 'Active orgs', value: `${activePartnerOrgCount}` },
        { label: 'Members', value: `${totalPartnerMembers}` },
        { label: 'Linked agents', value: `${totalPartnerAgents}` },
        { label: 'Suspended', value: `${suspendedPartnerOrgCount}` }
      ]
    },
    cash: {
      title: 'Cash operations',
      description: 'Review withdrawals and partner wallet pressure without mixing in onboarding or directory work.',
      metrics: [
        { label: 'Open withdrawals', value: `${openPartnerWithdrawalCount}` },
        { label: 'Commission due', value: moneyText(partnerPendingCommissionMinor, 'NGN') },
        { label: 'Wallet available', value: moneyText(partnerAvailableWalletMinor, 'NGN') },
        { label: 'Paid withdrawals', value: `${paidPartnerWithdrawalCount}` }
      ]
    },
    onboarding: {
      title: 'Partner onboarding',
      description: 'Handle partner and channel-partner applications from one focused queue.',
      metrics: [
        { label: 'Pending', value: `${pendingPartnerRequestCount}` },
        { label: 'Reviewed', value: `${reviewedPartnerRequestCount}` },
        { label: 'Channel requests', value: `${channelPartnerRequestCount}` },
        { label: 'Partner requests', value: `${standardPartnerRequestCount}` }
      ]
    },
    agents: {
      title: 'Agent commissions',
      description: 'Keep agent payout reviews isolated so channel-partner operations remain readable.',
      metrics: [
        { label: 'Open payouts', value: `${pendingAgentPayoutCount}` },
        { label: 'Paid payouts', value: `${paidAgentPayoutCount}` },
        { label: 'Linked agents', value: `${totalPartnerAgents}` },
        { label: 'Channel orgs', value: `${channelPartnerOrgCount}` }
      ]
    }
  }
  const activePartnerLaneSummary = partnerLaneSummaryByView[partnerView] || partnerLaneSummaryByView.overview
  const topEnrollmentMax = Math.max(0, ...(Array.isArray(analytics?.topCoursesByEnrollments) ? analytics.topCoursesByEnrollments.map((item) => toNumber(item.enrollmentCount)) : [0]))
  const topRevenueMax = Math.max(0, ...(Array.isArray(analytics?.topCoursesByRevenue) ? analytics.topCoursesByRevenue.map((item) => toNumber(item.revenueMinor)) : [0]))
  const topCreatorRevenueMax = Math.max(0, ...(Array.isArray(analytics?.topCreatorsByRevenue) ? analytics.topCreatorsByRevenue.map((item) => toNumber(item.revenueMinor)) : [0]))
%>
  <div class="layout">
    <aside class="side">
      <div class="side-head">
        <p class="side-kicker"><%= brandLearningName || 'Seemplify Learning' %></p>
        <h1>Admin Console</h1>
        <p>Control courses, creators, approvals, and payouts from one admin rail.</p>
      </div>
      <div class="side-profile">
        <p class="side-profile-label">Signed In</p>
        <strong><%= user?.profile?.name || user?.email || 'Admin' %></strong>
        <span><%= user?.email || '' %></span>
        <span class="side-role"><%= roleLabel %></span>
      </div>
      <nav>
        <% navGroups.forEach((group) => { %>
          <section class="side-nav-group">
            <p class="side-nav-group-title"><%= group.title %></p>
            <% group.keys.forEach((key) => { %>
              <% const item = navItemByKey.get(key) %>
              <% if (item) { %>
                <a href="<%= sectionPath(item.key) %>" class="<%= currentSection === item.key ? 'active' : '' %>">
                  <span class="label"><%= item.label %></span>
                  <span class="meta"><%= navMeta[item.key] || '' %></span>
                </a>
              <% } %>
            <% }) %>
          </section>
        <% }) %>
      </nav>
      <div class="actions">
        <a class="btn btn-primary btn-sm" href="/admin/courses/new">Create Course</a>
        <a class="btn btn-secondary btn-sm" href="/simple-lms">Workspace</a>
        <a class="btn btn-secondary btn-sm" href="/logout">Sign Out</a>
      </div>
    </aside>

    <main class="main">
      <section class="card page-header">
        <div class="page-header-grid">
          <div class="page-header-copy">
            <div>
              <h2><%= sectionLabel[currentSection] || 'Admin' %></h2>
              <p class="mini">Dedicated admin pages for approvals, partner operations, payouts, and platform control.</p>
            </div>
            <div class="page-header-pulse">
              <article class="pulse-card">
                <span>Approval Queue</span>
                <strong><%= pendingOnly.length %></strong>
              </article>
              <article class="pulse-card">
                <span>Partner Requests</span>
                <strong><%= pendingPartnerRequestCount %></strong>
              </article>
              <article class="pulse-card">
                <span>Agent Payout Queue</span>
                <strong><%= (agentPayoutRows || []).length %></strong>
              </article>
              <article class="pulse-card">
                <span>Live Courses</span>
                <strong><%= stats?.publishedCourseCount || 0 %></strong>
              </article>
            </div>
          </div>
          <div class="page-header-actions">
            <a class="btn btn-secondary btn-sm" href="<%= websiteHref %>" target="_blank" rel="noreferrer">Visit Website</a>
            <a class="btn btn-secondary btn-sm" href="/simple-lms">Open Workspace</a>
            <a class="btn btn-primary btn-sm" href="/admin/courses/new">Create Course</a>
          </div>
        </div>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
        <% if (info) { %><div class="alert alert-info"><%= info %></div><% } %>
      </section>

      <% if (currentSection === 'overview') { %>
        <section class="admin-overview-dashboard">
          
          <!-- 1. The Zenith Strip (North Star Metrics) -->
          <div class="overview-zenith-strip" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 32px;">
            <article style="background: linear-gradient(135deg, #1e1b4b, #312e81); border-radius: 12px; padding: 24px; color: white; box-shadow: 0 4px 12px rgba(49, 46, 129, 0.2);">
              <span style="display: block; font-size: 13px; font-weight: 600; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Total Revenue</span>
              <strong style="display: block; font-size: 28px; font-weight: 700; line-height: 1;"><%= paymentStats.revenueDisplay %></strong>
            </article>
            <article style="background: linear-gradient(135deg, #4c1d95, #6d28d9); border-radius: 12px; padding: 24px; color: white; box-shadow: 0 4px 12px rgba(109, 40, 217, 0.2);">
              <span style="display: block; font-size: 13px; font-weight: 600; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Live Courses</span>
              <strong style="display: block; font-size: 28px; font-weight: 700; line-height: 1;"><%= stats?.publishedCourseCount || 0 %></strong>
            </article>
            <article style="background: linear-gradient(135deg, #5b21b6, #7c3aed); border-radius: 12px; padding: 24px; color: white; box-shadow: 0 4px 12px rgba(124, 58, 237, 0.2);">
              <span style="display: block; font-size: 13px; font-weight: 600; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Total Learners</span>
              <strong style="display: block; font-size: 28px; font-weight: 700; line-height: 1;"><%= stats.learnerCount %></strong>
            </article>
            <article style="background: linear-gradient(135deg, #6b21a8, #9333ea); border-radius: 12px; padding: 24px; color: white; box-shadow: 0 4px 12px rgba(147, 51, 234, 0.2);">
              <span style="display: block; font-size: 13px; font-weight: 600; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Partner Network</span>
              <strong style="display: block; font-size: 28px; font-weight: 700; line-height: 1;"><%= partnerOrgRows.length %> Orgs</strong>
            </article>
          </div>

          <!-- 2. The Operations Grid -->
          <div class="overview-ops-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-bottom: 32px;">
            
            <!-- Publishing Column -->
            <div class="ops-column" style="background: #fff; border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.02); display: flex; flex-direction: column;">
              <div style="margin-bottom: 24px;">
                <h3 style="margin: 0 0 4px 0; font-size: 18px; color: #1e293b;">Publishing Ops</h3>
                <p class="mini" style="margin: 0; color: #64748b;">Manage course submissions and creator catalogs.</p>
              </div>
              <div style="display: flex; flex-direction: column; gap: 16px; flex-grow: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(148,163,184,0.1);">
                  <span style="font-size: 14px; font-weight: 500; color: #334155;">Pending Review Queue</span>
                  <span class="pill" style="<%= pendingOnly.length > 0 ? 'background: #fee2e2; color: #b91c1c;' : '' %>"><strong><%= pendingOnly.length %></strong> pending</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(148,163,184,0.1);">
                  <span style="font-size: 14px; font-weight: 500; color: #334155;">Changes Requested</span>
                  <span class="pill"><strong><%= approvalDecisionCounts.changes_requested %></strong> returned</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(148,163,184,0.1);">
                  <span style="font-size: 14px; font-weight: 500; color: #334155;">Partner Drafts</span>
                  <span class="pill"><strong><%= partnerDraftCourseCount %></strong> drafts</span>
                </div>
              </div>
              <div style="margin-top: 24px;">
                <a class="btn btn-primary" href="/admin/approvals" style="width: 100%; justify-content: center; padding: 10px;">Clear Review Queue</a>
              </div>
            </div>

            <!-- Financial Column -->
            <div class="ops-column" style="background: #fff; border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.02); display: flex; flex-direction: column;">
              <div style="margin-bottom: 24px;">
                <h3 style="margin: 0 0 4px 0; font-size: 18px; color: #1e293b;">Financial Ops</h3>
                <p class="mini" style="margin: 0; color: #64748b;">Track payouts, commissions, and revenue flows.</p>
              </div>
              <div style="display: flex; flex-direction: column; gap: 16px; flex-grow: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(148,163,184,0.1);">
                  <span style="font-size: 14px; font-weight: 500; color: #334155;">Pending Transactions</span>
                  <span class="pill" style="<%= paymentStats.pendingCount > 0 ? 'background: #fef08a; color: #854d0e;' : '' %>"><strong><%= paymentStats.pendingCount %></strong> unprocessed</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(148,163,184,0.1);">
                  <span style="font-size: 14px; font-weight: 500; color: #334155;">Creator Payouts</span>
                  <span class="pill"><strong><%= paymentStats.creatorPayoutDisplay %></strong></span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(148,163,184,0.1);">
                  <span style="font-size: 14px; font-weight: 500; color: #334155;">Partner Wallets</span>
                  <span class="pill"><strong><%= moneyText(partnerAvailableWalletMinor, 'NGN') %></strong></span>
                </div>
              </div>
              <div style="margin-top: 24px;">
                <a class="btn btn-secondary" href="/admin/payments" style="width: 100%; justify-content: center; padding: 10px;">Review Payments</a>
              </div>
            </div>

            <!-- Network Column -->
            <div class="ops-column" style="background: #fff; border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.02); display: flex; flex-direction: column;">
              <div style="margin-bottom: 24px;">
                <h3 style="margin: 0 0 4px 0; font-size: 18px; color: #1e293b;">Network Ops</h3>
                <p class="mini" style="margin: 0; color: #64748b;">Manage partner organizations, agents, and access.</p>
              </div>
              <div style="display: flex; flex-direction: column; gap: 16px; flex-grow: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(148,163,184,0.1);">
                  <span style="font-size: 14px; font-weight: 500; color: #334155;">Pending Role Requests</span>
                  <span class="pill" style="<%= pendingPartnerRequestCount > 0 ? 'background: #e0e7ff; color: #3730a3;' : '' %>"><strong><%= pendingPartnerRequestCount %></strong> waiting</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(148,163,184,0.1);">
                  <span style="font-size: 14px; font-weight: 500; color: #334155;">Active Agents</span>
                  <span class="pill"><strong><%= totalPartnerAgents %></strong> linked</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(148,163,184,0.1);">
                  <span style="font-size: 14px; font-weight: 500; color: #334155;">Admins & Super Admins</span>
                  <span class="pill"><strong><%= roleBreakdown.super_admin + roleBreakdown.admin %></strong> personnel</span>
                </div>
              </div>
              <div style="margin-top: 24px;">
                <a class="btn btn-secondary" href="/admin/partners" style="width: 100%; justify-content: center; padding: 10px;">Manage Directory</a>
              </div>
            </div>
            
          </div>

          <!-- 3. Minimal Footer Nav -->
          <div class="overview-footer-nav" style="display: flex; gap: 24px; flex-wrap: wrap; justify-content: center; padding-top: 24px; border-top: 1px solid rgba(148,163,184,0.2);">
            <a href="/admin/courses" style="font-size: 13px; font-weight: 600; color: #64748b; text-decoration: none; transition: color 0.15s ease;">Manage Courses</a>
            <a href="/admin/creators" style="font-size: 13px; font-weight: 600; color: #64748b; text-decoration: none; transition: color 0.15s ease;">Manage Creators</a>
            <a href="/admin/users" style="font-size: 13px; font-weight: 600; color: #64748b; text-decoration: none; transition: color 0.15s ease;">User Roles</a>
            <a href="/admin/analytics" style="font-size: 13px; font-weight: 600; color: #64748b; text-decoration: none; transition: color 0.15s ease;">Platform Analytics</a>
            <a href="<%= websiteHref %>" target="_blank" rel="noreferrer" style="font-size: 13px; font-weight: 600; color: #4f46e5; text-decoration: none; display: flex; align-items: center; gap: 4px;">Visit Public Site ↗</a>
          </div>
          
        </section>
      <% } %>

      <% if (currentSection === 'courses') { %>
        <section class="card course-management-shell">
          <div class="head">
            <div><h2>Course Management</h2><p class="mini">Use the library to find a course, then open one record to moderate it. Owner-only editing stays separate from platform moderation.</p></div>
            <div class="actions course-page-actions">
              <a class="btn btn-secondary btn-sm" href="/admin/courses">Manage Courses</a>
              <a class="btn btn-primary btn-sm" href="/admin/courses/new">Create New Course</a>
            </div>
          </div>
          <div class="course-mode-grid">
            <a class="course-mode-card <%= showCreateCoursePanel ? '' : 'active' %>" href="/admin/courses">
              <small>Library View</small>
              <strong>Manage course library</strong>
              <span>Browse preview cards, filter by creator or status, and open a dedicated record for moderation.</span>
            </a>
            <a class="course-mode-card <%= showCreateCoursePanel ? 'active' : '' %>" href="/admin/courses/new">
              <small>Creation Flow</small>
              <strong>Create a new system course</strong>
              <span>Open a separate authoring page for new system content instead of dropping the form into the library page.</span>
            </a>
          </div>

          <div class="course-overview-grid">
            <article class="course-overview-card">
              <small>Total</small>
              <strong><%= courseMetrics.total %></strong>
              <span>Courses in the current filtered library.</span>
            </article>
            <article class="course-overview-card">
              <small>Owner Editable</small>
              <strong><%= courseMetrics.ownerEditable %></strong>
              <span>Courses this account can edit or duplicate.</span>
            </article>
            <article class="course-overview-card">
              <small>Moderation Only</small>
              <strong><%= courseMetrics.moderationOnly %></strong>
              <span>Courses that stay owner-locked but can still be moderated.</span>
            </article>
            <article class="course-overview-card">
              <small>Pending Review</small>
              <strong><%= courseMetrics.pending %></strong>
              <span>Submissions still waiting for a publishing decision.</span>
            </article>
          </div>

          <div class="course-filter-shell">
            <p class="mini">Filters apply to the course library only. Editing and duplication remain owner-only even when the course appears in the admin view.</p>
            <form method="get" action="/admin/courses" class="course-filter-grid">
              <select class="input" name="creatorId">
                <option value="">All creators</option>
                <% (creatorAdminRows || []).forEach((creator) => { %>
                  <option value="<%= creator.creatorId %>" <%= selectedCreatorId === String(creator.creatorId) ? 'selected' : '' %>>
                    <%= creator.creatorName %><%= creator.creatorEmail ? ` (${creator.creatorEmail})` : '' %>
                  </option>
                <% }) %>
              </select>
              <select class="input" name="courseStatus">
                <option value="all" <%= courseStatusFilter === 'all' ? 'selected' : '' %>>all statuses</option>
                <option value="draft" <%= courseStatusFilter === 'draft' ? 'selected' : '' %>>draft</option>
                <option value="pending_public_review" <%= courseStatusFilter === 'pending_public_review' ? 'selected' : '' %>>pending review</option>
                <option value="published" <%= courseStatusFilter === 'published' ? 'selected' : '' %>>published</option>
                <option value="archived" <%= courseStatusFilter === 'archived' ? 'selected' : '' %>>archived</option>
              </select>
              <select class="input" name="courseVisibility">
                <option value="all" <%= courseVisibilityFilter === 'all' ? 'selected' : '' %>>all visibility</option>
                <option value="organization_private" <%= courseVisibilityFilter === 'organization_private' ? 'selected' : '' %>>private</option>
                <option value="organization_public" <%= courseVisibilityFilter === 'organization_public' ? 'selected' : '' %>>public</option>
                <option value="system_public" <%= courseVisibilityFilter === 'system_public' ? 'selected' : '' %>>marketplace</option>
              </select>
              <select class="input" name="courseType">
                <option value="all" <%= courseTypeFilter === 'all' ? 'selected' : '' %>>all types</option>
                <option value="system" <%= courseTypeFilter === 'system' ? 'selected' : '' %>>system</option>
                <option value="creator" <%= courseTypeFilter === 'creator' ? 'selected' : '' %>>creator</option>
              </select>
              <select class="input" name="coursePayment">
                <option value="all" <%= coursePaymentFilter === 'all' ? 'selected' : '' %>>all pricing</option>
                <option value="free" <%= coursePaymentFilter === 'free' ? 'selected' : '' %>>free</option>
                <option value="paid" <%= coursePaymentFilter === 'paid' ? 'selected' : '' %>>paid</option>
              </select>
              <input class="input" type="text" name="courseSearch" value="<%= courseSearchFilter %>" placeholder="Search title, summary, creator...">
              <button class="btn btn-primary btn-sm" type="submit">Apply Filter</button>
              <% if (hasActiveCourseFilters) { %>
                <a class="btn btn-secondary btn-sm" href="/admin/courses">Clear</a>
              <% } %>
            </form>
            <% if (selectedCreator) { %>
              <p class="mini course-context-note">
                Showing <strong><%= courses.length %></strong> courses for
                <strong><%= selectedCreator.creatorName %></strong>.
                Commission rate: <strong><%= selectedCreator.commissionRatePercent %>%</strong>.
              </p>
            <% } %>
          </div>

          <% if (focusedCourse) { %>
            <section class="course-record-shell">
              <div class="course-record-head">
                <div class="course-record-copy">
                  <div class="course-manage-pill-row">
                    <span class="pill"><%= focusedCourse.isSystemCourse ? 'System' : 'Creator' %></span>
                    <span class="pill"><%= focusedCourse.status || 'draft' %></span>
                    <span class="pill"><%= focusedCourse.visibilityDisplay || focusedCourse.visibility || 'private' %></span>
                    <span class="pill"><%= focusedCourse.displayPrice %></span>
                    <% if (focusedCourse.isSellThroughEnabled) { %><span class="pill">Partner Sellable</span><% } %>
                    <% if (focusedCourse.assignedOrganizationCount) { %><span class="pill"><%= focusedCourse.assignedOrganizationCount %> assigned orgs</span><% } %>
                    <% if (focusedCourse.isOwnedByCurrentUser) { %><span class="pill">Owned by you</span><% } %>
                    <% if (focusedCourse.reviewHasFeedback) { %><span class="pill <%= reviewDecisionClass(focusedCourse) %>"><%= focusedCourse.reviewDecisionLabel %></span><% } %>
                  </div>
                  <div>
                    <h3><%= focusedCourse.title %></h3>
                    <p class="course-record-subtitle"><%= focusedCourse.summaryText %></p>
                  </div>
                </div>
                <div class="course-record-actions">
                  <a class="btn btn-secondary btn-sm" href="<%= coursesReturnTo %>">Back to Library</a>
                  <% if (focusedCourse.canEdit) { %>
                    <a class="btn btn-secondary btn-sm" href="<%= buildAdminCourseEditPath(focusedCourse._id, coursesReturnTo) %>">Edit Course</a>
                  <% } %>
                  <a class="btn btn-secondary btn-sm" href="<%= focusedCourse.courseUrl %>?returnTo=<%= encodeURIComponent(coursesReturnTo) %>" target="_blank" rel="noreferrer">Preview Course</a>
                </div>
              </div>

              <div class="course-record-grid">
                <div class="course-record-main">
                  <article class="course-record-panel">
                    <h4>Course Snapshot</h4>
                    <div class="course-record-meta-grid">
                      <article class="course-record-stat">
                        <small>Creator</small>
                        <strong><%= focusedCourse.createdByName || focusedCourse.authorName || 'Unknown' %></strong>
                        <span><%= focusedCourse.createdByEmail || '-' %></span>
                      </article>
                      <article class="course-record-stat">
                        <small>Status</small>
                        <strong><%= focusedCourse.status || 'draft' %></strong>
                        <span><%= focusedCourse.reviewDecisionLabel || 'No review history yet' %></span>
                      </article>
                      <article class="course-record-stat">
                        <small>Delivery</small>
                        <strong><%= focusedCourse.levelLabel || focusedCourse.level || 'mixed' %></strong>
                        <span><%= Number(focusedCourse.lessonCount || 0) %> lessons - <%= Number(focusedCourse.estimatedDurationMinutes || 0) %> mins</span>
                      </article>
                      <article class="course-record-stat">
                        <small>Learners</small>
                        <strong><%= Number(focusedCourse.enrollmentCount || 0) %> enrolled</strong>
                        <span><%= Number(focusedCourse.completionCount || 0) %> completed</span>
                      </article>
                      <article class="course-record-stat">
                        <small>Pricing</small>
                        <strong><%= focusedCourse.displayPrice %></strong>
                        <span><%= isPaidCourse(focusedCourse) ? 'Paid course' : 'Free course' %></span>
                      </article>
                      <article class="course-record-stat">
                        <small>Sell Through</small>
                        <strong><%= focusedCourse.partnerSellingSummary %></strong>
                        <span><%= focusedCourse.assignedOrganizationCount %> assigned organizations</span>
                      </article>
                      <article class="course-record-stat">
                        <small>Updated</small>
                        <strong><%= dateText(focusedCourse.updatedAt) %></strong>
                        <span>Created <%= dateText(focusedCourse.createdAt) %></span>
                      </article>
                    </div>
                    <% if (!focusedCourse.canEdit) { %>
                      <p class="course-lock-note">Editing stays with the owner. Admin moderation here does not transfer authorship or let you take over the course content.</p>
                    <% } %>
                    <% if (focusedCourse.deleteBlockedReason) { %>
                      <p class="course-delete-note"><%= focusedCourse.deleteBlockedReason %></p>
                    <% } %>
                  </article>

                  <% if (focusedCourse.reviewHasFeedback) { %>
                    <article class="course-review-feedback is-<%= reviewFeedbackTone(focusedCourse) %>">
                      <div class="course-review-feedback-head">
                        <div>
                          <h4>Review status: <%= focusedCourse.reviewDecisionLabel %></h4>
                          <p class="course-review-feedback-copy"><%= reviewMessageForCourse(focusedCourse) %></p>
                        </div>
                        <div class="course-review-feedback-meta">
                          <span class="pill <%= reviewDecisionClass(focusedCourse) %>"><%= focusedCourse.reviewDecisionLabel %></span>
                          <% if (focusedCourse.reviewedAt) { %><span class="pill">Reviewed <%= dateText(focusedCourse.reviewedAt) %></span><% } %>
                          <% if (focusedCourse.reviewedByName) { %><span class="pill">By <%= focusedCourse.reviewedByName %></span><% } %>
                        </div>
                      </div>
                      <% if (String(focusedCourse.reviewNotes || '').trim()) { %>
                        <p class="course-review-feedback-note"><%= focusedCourse.reviewNotes %></p>
                      <% } %>
                    </article>
                  <% } %>

                  <article class="course-record-panel">
                    <h4>Publishing Summary</h4>
                    <p class="course-record-summary"><%= focusedCourse.description || focusedCourse.summaryText %></p>
                    <ul class="course-record-list">
                      <li>Category: <strong><%= focusedCourse.category || 'Uncategorized' %></strong></li>
                      <li>Visibility: <strong><%= focusedCourse.visibilityDisplay || focusedCourse.visibility || 'private' %></strong></li>
                      <li>Course key: <strong><%= focusedCourse.slug || focusedCourse._id %></strong></li>
                      <li>Sell through: <strong><%= focusedCourse.partnerSellingSummary %></strong></li>
                      <li>Queue behavior: only courses in <strong>pending review</strong> appear in the approval queue.</li>
                    </ul>
                  </article>

                  <article class="course-record-panel">
                    <h4>Curriculum Preview</h4>
                    <% if (!focusedCourse.chapters || focusedCourse.chapters.length === 0) { %>
                      <p class="course-record-note">No chapters added yet.</p>
                    <% } else { %>
                      <div class="course-record-curriculum">
                        <% focusedCourse.chapters.forEach((chapter, chapterIndex) => { %>
                          <article class="course-record-chapter">
                            <div>
                              <h5>Chapter <%= chapterIndex + 1 %>: <%= chapter.title || `Chapter ${chapterIndex + 1}` %></h5>
                              <% if (chapter.description) { %><p><%= chapter.description %></p><% } %>
                            </div>
                            <div class="course-record-lessons">
                              <% (chapter.lessons || []).forEach((lesson, lessonIndex) => { %>
                                <div class="course-record-lesson">
                                  <span>Lesson <%= lessonIndex + 1 %>: <%= lesson.title || `Lesson ${lessonIndex + 1}` %></span>
                                  <span><%= Number(lesson.durationMinutes || 0) %> mins</span>
                                </div>
                              <% }) %>
                            </div>
                          </article>
                        <% }) %>
                      </div>
                    <% } %>
                  </article>
                </div>

                <aside class="course-record-side">
                  <div class="admin-tab-shell" data-tab-group>
                    <div class="admin-tab-bar" role="tablist" aria-label="Course record panels">
                      <button class="admin-tab is-active" type="button" data-tab-trigger="course-status">Status</button>
                      <button class="admin-tab" type="button" data-tab-trigger="course-selling">Selling</button>
                      <button class="admin-tab" type="button" data-tab-trigger="course-reviews">Reviews</button>
                      <button class="admin-tab" type="button" data-tab-trigger="course-tools">Tools</button>
                    </div>

                    <div class="admin-tab-panel is-active" data-tab-panel="course-status">
                      <p class="admin-tab-intro">Publishing and review actions live here so selling setup and moderation tools do not compete for attention.</p>
                      <% if (String(focusedCourse.status || '') === 'pending_public_review') { %>
                        <article class="course-record-panel">
                          <h4>Review This Submission</h4>
                          <p class="course-record-note">This course is already in the public review queue. Approve it here, or request changes or denial with a creator-facing note.</p>
                          <form method="post" action="/simple-lms/courses/<%= focusedCourse._id %>/review-public" class="course-record-review-form" data-course-review-form>
                            <input type="hidden" name="returnTo" value="<%= buildAdminCourseRecordPath(focusedCourse._id, coursesReturnTo) %>">
                            <input type="hidden" name="decision" value="changes_requested" data-review-decision-input>
                            <label>
                              <span>Feedback for the creator</span>
                              <textarea class="input" name="reviewNotes" rows="6" data-review-notes placeholder="Explain required changes or the denial reason."></textarea>
                            </label>
                            <div class="course-action-bar">
                              <button class="btn btn-primary btn-sm" type="submit" formaction="/simple-lms/courses/<%= focusedCourse._id %>/approve-public" data-review-submit="approved">Approve & Publish</button>
                              <button class="btn btn-secondary btn-sm" type="submit" data-review-submit="changes_requested">Request Changes</button>
                              <button class="btn btn-danger btn-sm" type="submit" data-review-submit="denied">Deny Submission</button>
                            </div>
                          </form>
                        </article>
                      <% } else { %>
                        <article class="course-record-panel">
                          <h4>Admin Status Control</h4>
                          <p class="course-record-note">Use this when the course is not already in the public review queue. Draft admin-created courses can be published directly from here.</p>
                          <form method="post" action="/simple-lms/courses/<%= focusedCourse._id %>/admin-status" class="course-record-status-form">
                            <input type="hidden" name="returnTo" value="<%= buildAdminCourseRecordPath(focusedCourse._id, coursesReturnTo) %>">
                            <div class="course-record-status-grid">
                              <label>
                                <span>Status</span>
                                <select class="input" name="status">
                                  <% courseLifecycleChoices.forEach((statusOption) => { %>
                                    <option value="<%= statusOption %>" <%= String(focusedCourse.status || '') === statusOption ? 'selected' : '' %>><%= statusOption %></option>
                                  <% }) %>
                                </select>
                              </label>
                              <label style="grid-column: 1 / -1;">
                                <span>Admin note (optional)</span>
                                <textarea class="input" name="statusNote" rows="4" placeholder="Internal context for this status change."></textarea>
                              </label>
                            </div>
                            <div class="course-action-bar">
                              <button class="btn btn-primary btn-sm" type="submit">Save Status</button>
                              <a class="btn btn-secondary btn-sm" href="/admin/approvals">Open Approval Queue</a>
                            </div>
                          </form>
                        </article>
                      <% } %>
                    </div>

                    <div class="admin-tab-panel" data-tab-panel="course-selling" hidden>
                      <p class="admin-tab-intro">Partner and channel-partner selling assignments are isolated here so they read as a selling workflow, not part of course editing.</p>
                      <article class="course-record-panel" id="course-selling-assignments">
                        <h4>Assign To Partner / Channel Partner</h4>
                        <p class="course-record-note">Use this panel to assign a course to a partner or channel partner organization for selling. Creator-owned courses must opt into partner selling before you can assign them. Assigned organizations can sell without taking over course ownership or editing rights.</p>
                        <% if (focusedCourse.activeSellingAssignments && focusedCourse.activeSellingAssignments.length > 0) { %>
                          <div class="table-wrap">
                            <table>
                              <thead>
                                <tr>
                                  <th>Organization</th>
                                  <th>Type</th>
                                  <th>Split</th>
                                  <th>Status</th>
                                  <th>Action</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% focusedCourse.activeSellingAssignments.forEach((assignment) => { %>
                                  <tr>
                                    <td><strong><%= assignment.organizationName || 'Organization' %></strong></td>
                                    <td><%= assignment.partnerType || 'partner' %></td>
                                    <td><%= assignment.creatorSharePercent %>% creator / <%= assignment.partnerSharePercent %>% partner / <%= assignment.platformSharePercent %>% platform</td>
                                    <td><%= assignment.status %></td>
                                    <td>
                                      <form method="post" action="/simple-lms/courses/<%= focusedCourse._id %>/unassign-organization" class="inline-form">
                                        <input type="hidden" name="returnTo" value="<%= buildAdminCourseRecordPath(focusedCourse._id, coursesReturnTo) %>">
                                        <input type="hidden" name="organizationId" value="<%= assignment.organization %>">
                                        <button class="btn btn-danger btn-sm" type="submit">Remove</button>
                                      </form>
                                    </td>
                                  </tr>
                                <% }) %>
                              </tbody>
                            </table>
                          </div>
                        <% } else { %>
                          <p class="course-record-note">No selling organizations assigned yet.</p>
                        <% } %>
                        <form method="post" action="/simple-lms/courses/<%= focusedCourse._id %>/assign-organization" class="course-record-status-form" style="margin-top:12px;">
                          <input type="hidden" name="returnTo" value="<%= buildAdminCourseRecordPath(focusedCourse._id, coursesReturnTo) %>">
                          <div class="course-record-status-grid">
                            <label>
                              <span>Organization</span>
                              <select class="input" name="organizationId" required>
                                <option value="">Select organization</option>
                                <% (partnerOrganizations || []).forEach((organization) => { %>
                                  <% if (String(organization._id || '') !== String(focusedCourse.organization || '')) { %>
                                    <option value="<%= organization._id %>"><%= organization.name || 'Partner Organization' %> (<%= organization.partnerType || 'partner' %>)</option>
                                  <% } %>
                                <% }) %>
                              </select>
                            </label>
                            <label>
                              <span>Creator Share (%)</span>
                              <input class="input" type="number" step="0.01" min="0" max="100" name="creatorSharePercent" value="<%= Number.isFinite(Number(focusedCourse.partnerSelling?.creatorSharePercent)) ? Number(focusedCourse.partnerSelling.creatorSharePercent) : 70 %>">
                            </label>
                            <label>
                              <span>Partner Share (%)</span>
                              <input class="input" type="number" step="0.01" min="0" max="100" name="partnerSharePercent" value="<%= Number.isFinite(Number(focusedCourse.partnerSelling?.partnerSharePercent)) ? Number(focusedCourse.partnerSelling.partnerSharePercent) : 20 %>">
                            </label>
                            <label>
                              <span>Status</span>
                              <select class="input" name="assignmentStatus">
                                <option value="active">active</option>
                                <option value="inactive">inactive</option>
                              </select>
                            </label>
                          </div>
                          <div class="course-action-bar">
                            <button class="btn btn-primary btn-sm" type="submit">Assign Organization</button>
                          </div>
                        </form>
                      </article>
                    </div>

                    <div class="admin-tab-panel" data-tab-panel="course-reviews" hidden>
                      <p class="admin-tab-intro">Ratings and comments are moderated here. Hidden reviews drop out of the public course rating until you restore them.</p>
                      <article class="course-record-panel">
                        <h4>Ratings & Comments Moderation</h4>
                        <div class="course-review-metrics">
                          <span class="pill"><%= focusedCourseReviewStats.total %> reviews</span>
                          <span class="pill"><%= focusedCourseReviewStats.visible %> visible</span>
                          <span class="pill"><%= focusedCourseReviewStats.hidden %> hidden</span>
                          <span class="pill"><%= focusedCourseReviewStats.withReplies %> creator replies</span>
                        </div>
                        <% if (focusedCourseReviews.length === 0) { %>
                          <p class="course-record-note">No learner ratings or comments have been submitted for this course yet.</p>
                        <% } else { %>
                          <div class="course-review-manage-list">
                            <% focusedCourseReviews.forEach((review) => { %>
                              <article class="course-review-manage-item <%= review.moderationStatus === 'hidden' ? 'is-hidden' : '' %>">
                                <div class="course-review-manage-head">
                                  <div>
                                    <strong><%= review.authorName %></strong>
                                    <span><%= review.authorEmail || '' %></span>
                                  </div>
                                  <div class="actions">
                                    <span class="pill"><%= `${Number(review.rating || 0)}/5` %></span>
                                    <span class="pill <%= review.moderationStatus === 'hidden' ? 'review-denied' : 'review-approved' %>"><%= review.moderationStatus === 'hidden' ? 'Hidden' : 'Visible' %></span>
                                    <span class="pill"><%= review.updatedAtLabel || review.createdAtLabel || '-' %></span>
                                  </div>
                                </div>
                                <p class="course-review-manage-copy"><%= review.comment || 'This learner left a rating without a written comment.' %></p>
                                <% if (review.hasCreatorReply) { %>
                                  <div class="course-review-manage-reply">
                                    <strong><%= review.creatorReplyByName || 'Course creator' %></strong>
                                    <span class="course-review-manage-note"><%= review.creatorReplyUpdatedAtLabel ? `Responded ${review.creatorReplyUpdatedAtLabel}` : 'Creator response' %></span>
                                    <p class="course-review-manage-reply-copy"><%= review.creatorReply %></p>
                                  </div>
                                <% } %>
                                <% if (review.moderatedAtLabel || review.hasModerationReason) { %>
                                  <p class="course-review-manage-note">
                                    <% if (review.moderatedAtLabel) { %>Last moderated <%= review.moderatedAtLabel %><% } %>
                                    <% if (review.moderatedByName) { %> by <%= review.moderatedByName %><% } %>
                                    <% if (review.hasModerationReason) { %><br><strong>Moderator note:</strong> <%= review.moderationReason %><% } %>
                                  </p>
                                <% } %>
                                <form method="post" action="/simple-lms/courses/<%= focusedCourse._id %>/reviews/<%= review._id %>/moderate" class="course-review-moderation-form">
                                  <input type="hidden" name="returnTo" value="<%= buildAdminCourseRecordPath(focusedCourse._id, coursesReturnTo) %>">
                                  <div class="course-record-status-grid">
                                    <label>
                                      <span>Moderation status</span>
                                      <select class="input" name="moderationStatus">
                                        <option value="visible" <%= review.moderationStatus !== 'hidden' ? 'selected' : '' %>>visible</option>
                                        <option value="hidden" <%= review.moderationStatus === 'hidden' ? 'selected' : '' %>>hidden</option>
                                      </select>
                                    </label>
                                    <label style="grid-column: 1 / -1;">
                                      <span>Moderator note</span>
                                      <textarea class="input" name="moderationReason" rows="4" maxlength="600" placeholder="Explain why the review is hidden or why it was restored."><%= review.moderationReason || '' %></textarea>
                                    </label>
                                  </div>
                                  <div class="course-action-bar">
                                    <button class="btn btn-primary btn-sm" type="submit">Save Moderation</button>
                                  </div>
                                </form>
                              </article>
                            <% }) %>
                          </div>
                        <% } %>
                      </article>
                    </div>

                    <div class="admin-tab-panel" data-tab-panel="course-tools" hidden>
                      <p class="admin-tab-intro">Everything here is moderation-only. It stays separate from publishing and selling so ownership boundaries stay obvious.</p>
                      <article class="course-record-panel">
                        <h4>Moderation Tools</h4>
                        <div class="course-action-bar">
                          <a class="btn btn-secondary btn-sm" href="<%= focusedCourse.courseUrl %>?returnTo=<%= encodeURIComponent(coursesReturnTo) %>" target="_blank" rel="noreferrer">View Course</a>
                          <% if (focusedCourse.createdById) { %>
                            <a class="btn btn-secondary btn-sm" href="/admin/creators?creatorId=<%= encodeURIComponent(focusedCourse.createdById) %>">Open Creator</a>
                          <% } %>
                          <% if (focusedCourse.canEdit) { %>
                            <a class="btn btn-secondary btn-sm" href="<%= buildAdminCourseEditPath(focusedCourse._id, coursesReturnTo) %>">Edit Content</a>
                          <% } %>
                          <% if (focusedCourse.canDuplicate) { %>
                            <form method="post" action="/simple-lms/courses/<%= focusedCourse._id %>/duplicate" class="inline-form">
                              <input type="hidden" name="returnTo" value="<%= coursesReturnTo %>">
                              <input type="hidden" name="studioPath" value="/admin/courses">
                              <input type="hidden" name="studioContext" value="admin">
                              <input type="hidden" name="isSystemCourse" value="on">
                              <button class="btn btn-secondary btn-sm" type="submit">Duplicate as New</button>
                            </form>
                          <% } %>
                          <% if (focusedCourse.canArchive) { %>
                            <form method="post" action="/simple-lms/courses/<%= focusedCourse._id %>/archive" class="inline-form">
                              <input type="hidden" name="returnTo" value="<%= buildAdminCourseRecordPath(focusedCourse._id, coursesReturnTo) %>">
                              <button class="btn btn-danger btn-sm" type="submit">Archive</button>
                            </form>
                          <% } %>
                          <% if (focusedCourse.canRestore) { %>
                            <form method="post" action="/simple-lms/courses/<%= focusedCourse._id %>/restore" class="inline-form">
                              <input type="hidden" name="returnTo" value="<%= buildAdminCourseRecordPath(focusedCourse._id, coursesReturnTo) %>">
                              <button class="btn btn-primary btn-sm" type="submit">Restore</button>
                            </form>
                          <% } %>
                          <% if (focusedCourse.canDelete) { %>
                            <form method="post" action="/simple-lms/courses/<%= focusedCourse._id %>/delete" class="inline-form" onsubmit="return confirm('Permanently delete this course? This cannot be undone.');">
                              <input type="hidden" name="returnTo" value="<%= coursesReturnTo %>">
                              <button class="btn btn-danger btn-sm" type="submit">Delete Permanently</button>
                            </form>
                          <% } %>
                        </div>
                      </article>
                    </div>
                  </div>
                </aside>
              </div>
            </section>
          <% } else if (!courses || courses.length === 0) { %>
            <div class="empty">No courses found for this filter.</div>
          <% } else { %>
            <div class="table-wrap">
              <table class="course-management-table">
                <thead>
                  <tr>
                    <th>Course</th>
                    <th>Creator</th>
                    <th>Delivery</th>
                    <th>Learners</th>
                    <th>Status & Pricing</th>
                    <th style="min-width: 140px; text-align: right;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% courses.forEach((course) => { %>
                    <tr>
                      <td>
                        <div class="course-manage-pill-row" style="margin-bottom: 8px;">
                          <span class="pill"><%= course.isSystemCourse ? 'System' : 'Creator' %></span>
                          <span class="pill"><%= course.visibilityDisplay || course.visibility || 'private' %></span>
                          <% if (course.isSellThroughEnabled) { %><span class="pill">Partner Sellable</span><% } %>
                          <% if (course.isOwnedByCurrentUser) { %><span class="pill">Owned by you</span><% } %>
                          <% if (course.reviewHasFeedback) { %><span class="pill <%= reviewDecisionClass(course) %>"><%= course.reviewDecisionLabel %></span><% } %>
                        </div>
                        <strong style="display:block; font-size:16px; color:var(--admin-text); line-height:1.2; margin-bottom:4px;"><%= course.title %></strong>
                        <p class="mini" style="margin: 0; max-width: 320px; white-space: normal;"><%= course.summaryText %></p>
                      </td>
                      <td>
                        <strong style="display:block; font-size:14px; color:var(--admin-text);"><%= course.createdByName || course.authorName || 'Unknown' %></strong>
                        <span class="mini"><%= course.createdByEmail || '-' %></span>
                      </td>
                      <td>
                        <strong style="display:block; font-size:14px; color:var(--admin-text);"><%= course.levelLabel || 'Mixed' %></strong>
                        <span class="mini"><%= Number(course.lessonCount || 0) %> lessons • <%= Number(course.estimatedDurationMinutes || 0) %> mins</span>
                      </td>
                      <td>
                        <strong style="display:block; font-size:14px; color:var(--admin-text);"><%= Number(course.enrollmentCount || 0) %> enrolled</strong>
                        <span class="mini"><%= Number(course.completionCount || 0) %> completed</span>
                      </td>
                      <td>
                        <div style="display:flex; flex-direction:column; gap:4px; align-items:flex-start;">
                          <span class="pill"><%= course.status || 'draft' %></span>
                          <span class="mini">Updated <%= dateText(course.updatedAt) %></span>
                          <strong style="font-size:13px; margin-top: 4px; color:var(--admin-text);"><%= course.displayPrice %> • <%= isPaidCourse(course) ? 'Paid' : 'Free' %></strong>
                          <span class="mini"><%= course.partnerSellingSummary %> (<%= course.assignedOrganizationCount %> orgs)</span>
                        </div>
                      </td>
                      <td style="text-align: right; vertical-align: top;">
                        <div class="actions" style="justify-content: flex-end; gap: 6px; flex-wrap: wrap; margin-bottom: 6px;">
                          <a class="btn btn-primary btn-sm" href="<%= buildAdminCourseRecordPath(course._id, coursesReturnTo) %>">Record</a>
                          <a class="btn btn-secondary btn-sm" href="<%= buildAdminCourseRecordPath(course._id, coursesReturnTo) %>#course-selling-assignments">Assign</a>
                          <% if (course.canEdit) { %>
                            <a class="btn btn-secondary btn-sm" href="<%= buildAdminCourseEditPath(course._id, coursesReturnTo) %>">Edit</a>
                          <% } %>
                          <% if (course.canDuplicate) { %>
                            <form method="post" action="/simple-lms/courses/<%= course._id %>/duplicate" class="inline-form">
                              <input type="hidden" name="returnTo" value="<%= coursesReturnTo %>">
                              <input type="hidden" name="studioPath" value="/admin/courses">
                              <input type="hidden" name="studioContext" value="admin">
                              <input type="hidden" name="isSystemCourse" value="on">
                              <button class="btn btn-secondary btn-sm" type="submit">Duplicate</button>
                            </form>
                          <% } %>
                          <a class="btn btn-secondary btn-sm" href="<%= course.courseUrl %>?returnTo=<%= encodeURIComponent(coursesReturnTo) %>" target="_blank" rel="noreferrer">View</a>
                        </div>
                        <% if (!course.canEdit) { %>
                          <p class="mini" style="margin:4px 0 0; text-align:right; font-size:10px; color:#6b5b8d;">Owner locked</p>
                        <% } %>
                        <% if (course.deleteBlockedReason) { %>
                          <p class="mini" style="margin:2px 0 0; text-align:right; font-size:10px; color:#991b1b;"><%= course.deleteBlockedReason %></p>
                        <% } %>
                      </td>
                    </tr>
                    <% if (course.reviewHasFeedback && course.reviewDecisionLabel) { %>
                      <tr class="course-mgmt-table-feedback-row">
                        <td colspan="6" style="padding-top:0; border-top:none; padding-bottom:12px;">
                          <div class="course-review-feedback is-<%= reviewFeedbackTone(course) %>" style="margin:0; border-radius: 8px; padding: 10px;">
                            <div class="course-review-feedback-head" style="margin:0;">
                              <p class="course-review-feedback-note" style="margin:0; flex:1;"><%= course.reviewNotes || reviewMessageForCourse(course) %></p>
                              <% if (course.reviewedByName) { %><span class="pill">By <%= course.reviewedByName %></span><% } %>
                            </div>
                          </div>
                        </td>
                      </tr>
                    <% } %>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

          <% if (false) { %>
          <p class="mini course-studio-note">The library stays separate from creation. Open the create panel when you want a new system course, and use moderation actions here without exposing owner-only editing controls.</p>

          <details class="course-compose-shell" id="create-course" <%= showCreateCoursePanel ? 'open' : '' %>>
            <summary>Create System Course</summary>
            <div class="course-compose-body">
              <form method="post" action="/simple-lms/courses/create" class="form-grid course-compose-form">
                <label>Title<input class="input" name="title" required maxlength="200" placeholder="Course title"></label>
                <label>Category<input class="input" name="category" maxlength="120" placeholder="Category"></label>
                <label>Level
                  <select class="input" name="level">
                    <% levels.forEach((level) => { %>
                      <option value="<%= level %>"><%= level %></option>
                    <% }) %>
                  </select>
                </label>
                <label>Status
                  <select class="input" name="status">
                    <option value="draft" selected>draft</option>
                    <option value="published">published</option>
                    <option value="archived">archived</option>
                  </select>
                </label>
                <label>Visibility
                  <select class="input" name="visibility">
                    <option value="private" selected>private</option>
                    <option value="public">public</option>
                    <option value="marketplace">marketplace</option>
                  </select>
                </label>
                <label>Payment Mode
                  <select class="input" name="paymentMode">
                    <option value="free" selected>free</option>
                    <option value="paid">paid</option>
                  </select>
                </label>
                <label>Price (major units)<input class="input" type="number" step="0.01" inputmode="decimal" name="amount" min="0" value="0"></label>
                <label>Currency
                  <select class="input" name="currency">
                    <% currencyOptions.forEach((currencyOption) => { %>
                      <% const optionCode = String(currencyOption?.code || '').trim().toUpperCase() %>
                      <% const optionName = String(currencyOption?.name || optionCode || 'Currency').trim() %>
                      <option value="<%= optionCode %>" <%= defaultCurrency === optionCode ? 'selected' : '' %>><%= optionCode %> - <%= optionName %></option>
                    <% }) %>
                  </select>
                </label>
                <label>Tags<input class="input" name="tags" placeholder="ai, leadership, design"></label>
                <label class="course-compose-full">Summary<input class="input" name="summary" maxlength="600" placeholder="Short summary"></label>
                <label class="course-compose-full">Description<textarea class="input" name="description" rows="4" placeholder="Course description"></textarea></label>
                <label class="course-compose-full">Banner URL (optional)<input class="input" name="bannerUrl" placeholder="https://..."></label>
                <label style="display:flex;align-items:center;gap:8px;">
                  <input type="checkbox" name="isSystemCourse" checked>
                  Save as system course
                </label>
                <input type="hidden" name="studioContext" value="admin">
                <input type="hidden" name="chaptersJson" value="[]">
                <input type="hidden" name="returnTo" value="/admin/courses">
                <button class="btn btn-primary btn-sm" type="submit">Create Course</button>
              </form>
            </div>
          </details>

          <% if (editingCourse) { %>
            <details class="course-compose-shell" id="edit-course" open>
              <summary>Edit Owned Course: <%= editingCourse.title %></summary>
              <div class="course-compose-body">
                <form method="post" action="/simple-lms/courses/<%= editingCourse._id %>/update" class="form-grid course-compose-form">
                  <label>Title<input class="input" name="title" required maxlength="200" value="<%= editingCourse.title || '' %>"></label>
                  <label>Category<input class="input" name="category" maxlength="120" value="<%= editingCourse.category || '' %>"></label>
                  <label>Level
                    <select class="input" name="level">
                      <% levels.forEach((level) => { %>
                        <option value="<%= level %>" <%= String(editingCourse.level || '') === String(level) ? 'selected' : '' %>><%= level %></option>
                      <% }) %>
                    </select>
                  </label>
                  <label>Status
                    <select class="input" name="status">
                      <option value="draft" <%= String(editingCourse.status || '') === 'draft' ? 'selected' : '' %>>draft</option>
                      <option value="pending_public_review" <%= String(editingCourse.status || '') === 'pending_public_review' ? 'selected' : '' %>>pending_public_review</option>
                      <option value="published" <%= String(editingCourse.status || '') === 'published' ? 'selected' : '' %>>published</option>
                      <option value="archived" <%= String(editingCourse.status || '') === 'archived' ? 'selected' : '' %>>archived</option>
                    </select>
                  </label>
                  <label>Visibility
                    <select class="input" name="visibility">
                      <option value="private" <%= ['organization_private', 'private'].includes(String(editingCourse.visibility || '')) ? 'selected' : '' %>>private</option>
                      <option value="public" <%= ['organization_public', 'public'].includes(String(editingCourse.visibility || '')) ? 'selected' : '' %>>public</option>
                      <option value="marketplace" <%= ['system_public', 'marketplace'].includes(String(editingCourse.visibility || '')) ? 'selected' : '' %>>marketplace</option>
                    </select>
                  </label>
                  <label>Payment Mode
                    <select class="input" name="paymentMode">
                      <option value="free" <%= String(editingCourse.pricing?.paymentMode || '') === 'paid' ? '' : 'selected' %>>free</option>
                      <option value="paid" <%= String(editingCourse.pricing?.paymentMode || '') === 'paid' ? 'selected' : '' %>>paid</option>
                    </select>
                  </label>
                  <label>Price (major units)<input class="input" type="number" step="0.01" inputmode="decimal" name="amount" min="0" value="<%= minorToMajorInput(editingCourse.pricing?.amount || 0) %>"></label>
                  <label>Currency
                    <select class="input" name="currency">
                      <% const editCurrencyCode = selectCurrency(editingCourse.pricing?.currency || defaultCurrency, defaultCurrency) %>
                      <% currencyOptions.forEach((currencyOption) => { %>
                        <% const optionCode = String(currencyOption?.code || '').trim().toUpperCase() %>
                        <% const optionName = String(currencyOption?.name || optionCode || 'Currency').trim() %>
                        <option value="<%= optionCode %>" <%= editCurrencyCode === optionCode ? 'selected' : '' %>><%= optionCode %> - <%= optionName %></option>
                      <% }) %>
                    </select>
                  </label>
                  <label>Tags<input class="input" name="tags" value="<%= Array.isArray(editingCourse.tags) ? editingCourse.tags.join(', ') : '' %>"></label>
                  <label class="course-compose-full">Summary<input class="input" name="summary" maxlength="600" value="<%= editingCourse.summary || '' %>"></label>
                  <label class="course-compose-full">Description<textarea class="input" name="description" rows="4"><%= editingCourse.description || '' %></textarea></label>
                  <label class="course-compose-full">Banner URL (optional)<input class="input" name="bannerUrl" value="<%= editingCourse.banner?.url || '' %>"></label>
                  <label style="display:flex;align-items:center;gap:8px;">
                    <input type="checkbox" name="isSystemCourse" <%= editingCourse.isSystemCourse ? 'checked' : '' %>>
                    Save as system course
                  </label>
                  <input type="hidden" name="studioContext" value="admin">
                  <input type="hidden" name="chaptersJson" value='<%= JSON.stringify(editingCourse.chapters || []) %>'>
                  <input type="hidden" name="bannerPayload" value='<%= JSON.stringify(editingCourse.banner || {}) %>'>
                  <input type="hidden" name="returnTo" value="/admin/courses?editCourse=<%= encodeURIComponent(editingCourse._id) %>#edit-course">
                  <div class="actions course-compose-full">
                    <button class="btn btn-primary btn-sm" type="submit">Save Course</button>
                    <a class="btn btn-secondary btn-sm" href="<%= editingCourse.courseUrl %>?returnTo=<%= encodeURIComponent('/admin/courses') %>" target="_blank" rel="noreferrer">Preview</a>
                    <a class="btn btn-secondary btn-sm" href="/admin/courses">Close Editor</a>
                  </div>
                </form>
              </div>
            </details>
          <% } %>
          <% } %>
        </section>
      <% } %>

      <% if (currentSection === 'approvals') { %>
        <section class="card approval-shell">
          <div class="approval-hero">
            <div class="approval-hero-top">
              <div>
                <p class="eyebrow">Course Review</p>
                <h3>Review submissions with explicit decisions instead of a generic draft bounce.</h3>
                <p class="mini">Approvals publish immediately. Change requests and denials both capture creator-facing feedback, drop the course back to draft, and send email notifications through the platform mailer.</p>
              </div>
              <div class="actions">
                <a class="btn btn-secondary btn-sm" href="/admin/courses">Open Course Management</a>
                <a class="btn btn-secondary btn-sm" href="/admin/analytics">View Analytics</a>
              </div>
            </div>
            <div class="approval-summary-grid">
              <article class="approval-summary-card">
                <span>Pending submissions</span>
                <strong><%= approvalCourses.length %></strong>
                <p>Courses waiting for a publish decision.</p>
              </article>
              <article class="approval-summary-card">
                <span>Approved recently</span>
                <strong><%= approvalDecisionCounts.approved %></strong>
                <p>Courses that cleared review and went live.</p>
              </article>
              <article class="approval-summary-card">
                <span>Changes requested</span>
                <strong><%= approvalDecisionCounts.changes_requested %></strong>
                <p>Courses sent back for creator updates.</p>
              </article>
              <article class="approval-summary-card">
                <span>Denied</span>
                <strong><%= approvalDecisionCounts.denied %></strong>
                <p>Submissions blocked with an explicit review reason.</p>
              </article>
            </div>
          </div>

          <nav class="partner-subnav" style="margin-bottom: 24px; display: flex; gap: 24px; border-bottom: 2px solid rgba(148,163,184,0.1); padding-bottom: 12px;" aria-label="Approval lanes">
            <button class="partner-subnav-link active" onclick="switchApprovalTab('pending')" id="tab-btn-pending" style="background:none; border:none; font-size: 15px; font-weight: 600; cursor:pointer; padding: 0 0 8px 0;">Pending queue (<%= approvalCourses.length %>)</button>
            <button class="partner-subnav-link" onclick="switchApprovalTab('recent')" id="tab-btn-recent" style="background:none; border:none; font-size: 15px; font-weight: 600; cursor:pointer; padding: 0 0 8px 0; color: #64748b;">Recent decisions (<%= recentReviewDecisions.length %>)</button>
          </nav>

          <script>
            function switchApprovalTab(tabId) {
              document.getElementById('approval-tab-pending').style.display = tabId === 'pending' ? 'block' : 'none';
              document.getElementById('approval-tab-recent').style.display = tabId === 'recent' ? 'block' : 'none';
              
              const btnPending = document.getElementById('tab-btn-pending');
              const btnRecent = document.getElementById('tab-btn-recent');
              
              if (tabId === 'pending') {
                btnPending.classList.add('active');
                btnPending.style.color = '';
                btnRecent.classList.remove('active');
                btnRecent.style.color = '#64748b';
              } else {
                btnRecent.classList.add('active');
                btnRecent.style.color = '';
                btnPending.classList.remove('active');
                btnPending.style.color = '#64748b';
              }
            }
          </script>

          <div style="display: block;">
            <div id="approval-tab-pending">
              <section class="approval-lane">
                <p class="mini" style="margin-bottom: 16px; max-width: 600px;">Each submission has one review form. Approve publishes instantly. Request changes and deny require a note so the creator knows exactly what to fix or why the course was rejected.</p>

              <% if (!approvalCourses || approvalCourses.length === 0) { %>
                <div class="approval-empty">
                  <strong>No creator submissions are waiting for review.</strong>
                  <p class="mini">New courses appear here after a creator submits them for public review.</p>
                </div>
              <% } else { %>
                <div class="table-wrap">
                  <table class="admin-data-table">
                    <thead>
                      <tr>
                        <th>Submission</th>
                        <th>Details</th>
                        <th>Review Status</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% approvalCourses.forEach((course) => { %>
                        <tr>
                          <td style="border-bottom: none; padding-bottom: 8px;">
                            <strong style="display:block; font-size:14px; color:var(--admin-text);"><%= course.title %></strong>
                            <p class="mini" style="margin-top: 4px; max-width: 300px;"><%= course.summaryText %></p>
                            <span class="mini" style="display: block; margin-top: 6px;"><strong><%= course.creatorName %></strong><%= course.creatorEmail ? ` • ${course.creatorEmail}` : '' %></span>
                          </td>
                          <td style="border-bottom: none; padding-bottom: 8px;">
                            <div style="display:flex; flex-direction:column; gap:4px; align-items:flex-start;">
                              <span class="pill"><%= course.levelLabel || course.level || 'Mixed' %></span>
                              <span class="pill"><%= course.displayPrice %></span>
                              <span class="mini"><%= Number(course.lessonCount || 0) %> lessons • <%= Number(course.estimatedDurationMinutes || 0) %> mins</span>
                            </div>
                          </td>
                          <td style="border-bottom: none; padding-bottom: 8px;">
                            <div style="display:flex; flex-direction:column; gap:4px; align-items:flex-start;">
                              <span class="pill status-<%= course.status %>"><%= course.status %></span>
                              <span class="pill"><%= course.visibilityDisplay %></span>
                              <span class="mini">Submitted <%= dateText(course.submittedAt) %></span>
                            </div>
                          </td>
                          <td style="border-bottom: none; padding-bottom: 8px; text-align: right; vertical-align: top;">
                            <div class="actions" style="justify-content: flex-end; gap: 6px; flex-wrap: wrap;">
                              <a class="btn btn-secondary btn-sm" href="<%= course.courseUrl %>?returnTo=<%= encodeURIComponent('/admin/approvals') %>" target="_blank" rel="noreferrer">Preview</a>
                              <a class="btn btn-primary btn-sm" href="<%= buildAdminCourseRecordPath(course._id, '/admin/approvals') %>">Open Record</a>
                            </div>
                          </td>
                        </tr>
                        <tr>
                          <td colspan="4" style="padding-top: 0; padding-bottom: 24px;">
                            <form method="post" action="/simple-lms/courses/<%= course._id %>/review-public" class="approval-review-form" data-course-review-form style="margin: 0; padding: 16px; border: 1px solid rgba(148,163,184,0.25); border-radius: 8px; background: rgba(248,250,252,0.8); text-align: left; display: flex; flex-direction: column; gap: 12px;">
                              <input type="hidden" name="returnTo" value="/admin/approvals">
                              <input type="hidden" name="decision" value="changes_requested" data-review-decision-input>
                              <div style="display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap;">
                                <label class="approval-review-note" style="flex: 1; min-width: 300px; display: grid; gap: 6px;">
                                  <span class="mini" style="font-weight: 600; color: #475569;">Fast Review Decision</span>
                                  <textarea class="input" style="font-size: 13px; min-height: 80px; padding: 10px; border-color: rgba(148,163,184,0.3);" name="reviewNotes" data-review-notes placeholder="Explain what changed, or why the submission is denied."></textarea>
                                </label>
                                <div class="approval-review-actions" style="display: flex; flex-direction: column; gap: 8px; min-width: 140px; margin-top: 24px;">
                                  <button class="btn btn-primary btn-sm" type="submit" formaction="/simple-lms/courses/<%= course._id %>/approve-public" data-review-submit="approved" style="width: 100%; justify-content: center;">Approve</button>
                                  <button class="btn btn-secondary btn-sm" type="submit" data-review-submit="changes_requested" style="width: 100%; justify-content: center;">Return</button>
                                  <button class="btn btn-danger btn-sm" type="submit" data-review-submit="denied" style="width: 100%; justify-content: center;">Deny</button>
                                </div>
                              </div>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
              </section>
            </div>

            <div id="approval-tab-recent" style="display: none;">
              <section class="approval-lane">
                <p class="mini" style="margin-bottom: 16px; max-width: 600px;">Quick visibility into the last completed review actions so approvals, requested changes, and denials are easy to audit without leaving this page.</p>

              <% if (!recentReviewDecisions || recentReviewDecisions.length === 0) { %>
                <div class="approval-empty">
                  <strong>No completed review decisions yet.</strong>
                  <p class="mini">Once an admin approves, requests changes, or denies a course, the latest decisions will show here.</p>
                </div>
              <% } else { %>
                <div class="approval-history-list">
                  <% recentReviewDecisions.forEach((course) => { %>
                    <article class="approval-history-card">
                      <div class="approval-history-head">
                        <div>
                          <p class="approval-card-kicker">Reviewed <%= dateText(course.reviewedAt) %></p>
                          <h4><%= course.title %></h4>
                          <p class="mini"><strong><%= course.creatorName %></strong><%= course.creatorEmail ? ` • ${course.creatorEmail}` : '' %></p>
                        </div>
                        <span class="pill review-decision-<%= course.reviewDecision %>"><%= course.reviewDecisionLabel %></span>
                      </div>
                      <div class="approval-history-meta">
                        <span><small>Reviewer</small><strong><%= course.reviewedByName || 'Admin reviewer' %></strong></span>
                        <span><small>Submitted</small><strong><%= dateText(course.submittedAt) %></strong></span>
                      </div>
                      <% if (String(course.reviewNotes || '').trim()) { %>
                        <p class="approval-history-note"><%= course.reviewNotes %></p>
                      <% } else { %>
                        <p class="approval-history-note">No written review note was stored for this decision.</p>
                      <% } %>
                      <div class="actions">
                        <a class="btn btn-secondary btn-sm" href="<%= course.courseUrl %>?returnTo=<%= encodeURIComponent('/admin/approvals') %>" target="_blank" rel="noreferrer">Preview</a>
                        <a class="btn btn-secondary btn-sm" href="<%= buildAdminCourseRecordPath(course._id, '/admin/approvals') %>">Open Record</a>
                      </div>
                    </article>
                  <% }) %>
                </div>
              <% } %>
              </section>
            </div>
          </div>
        </section>
      <% } %>

      <% if (currentSection === 'partners') { %>
        <section class="card partner-overview-shell">
          <div class="partner-lane-toolbar">
            <div class="partner-overview-copy">
              <p class="section-kicker">Partner Ops</p>
              <div>
                <h3>Partner Operations</h3>
                <p class="mini">Choose one operating lane, then work a single record at a time. The lane switcher stays here so the actual queue or directory starts immediately below it.</p>
              </div>
              <div class="partner-lane-meta-row">
                <span class="pill"><%= partnerOrgRows.length %> organizations</span>
                <span class="pill"><%= totalPartnerMembers %> partner members</span>
                <span class="pill"><%= totalPartnerAgents %> linked agents</span>
                <span class="pill"><%= pendingPartnerRequestCount %> requests pending</span>
              </div>
            </div>
            <div class="actions partner-lane-toolbar-actions">
              <% if (partnerView !== 'overview') { %>
                <a class="btn btn-secondary btn-sm" href="<%= partnerViewPath('overview') %>">Partner Hub</a>
              <% } %>
              <a class="btn btn-secondary btn-sm" href="/admin/users">Base User Roles</a>
              <a class="btn btn-secondary btn-sm" href="/admin/super-users">Platform Admins</a>
            </div>
          </div>
          <div class="partner-lane-context">
            <div class="partner-lane-context-main">
              <div class="partner-lane-context-head">
                <p class="section-kicker">Current lane</p>
                <div>
                  <h4><%= activePartnerLaneSummary.title %></h4>
                  <p class="mini"><%= activePartnerLaneSummary.description %></p>
                </div>
              </div>
              <nav class="partner-subnav" aria-label="Partner operations lanes">
                <% Object.entries(partnerSubviewMeta).forEach(([key, item]) => { %>
                  <a href="<%= partnerViewPath(key) %>" class="partner-subnav-link <%= partnerView === key ? 'active' : '' %>"><%= item.label %></a>
                <% }) %>
              </nav>
              <% if (partnerView === 'overview') { %>
                <p class="mini">Open a lane card below when you want the actual workspace. Once you are inside a lane, this top band stays compact instead of repeating the same information again.</p>
              <% } %>
            </div>
            <aside class="partner-overview-aside">
              <div class="partner-overview-aside-head">
                <div>
                  <strong><%= activePartnerSubview.label %> pulse</strong>
                  <p class="mini">Only the numbers relevant to the active lane stay here.</p>
                </div>
                <span class="pill hero-panel-live">Partner live</span>
              </div>
              <div class="partner-summary-grid">
                <% activePartnerLaneSummary.metrics.forEach((metric) => { %>
                  <article class="partner-summary-card">
                    <span><%= metric.label %></span>
                    <strong><%= metric.value %></strong>
                  </article>
                <% }) %>
              </div>
              <div class="actions">
                <% if (partnerView === 'overview') { %>
                  <a class="btn btn-primary btn-sm" href="<%= partnerViewPath('directory') %>">Open Directory</a>
                  <a class="btn btn-secondary btn-sm" href="<%= partnerViewPath('onboarding') %>">Review Onboarding</a>
                <% } else if (partnerView === 'directory') { %>
                  <a class="btn btn-primary btn-sm" href="<%= partnerViewPath('directory') %>">Stay in Directory</a>
                  <a class="btn btn-secondary btn-sm" href="<%= partnerViewPath('cash') %>">Switch to Cash</a>
                <% } else if (partnerView === 'cash') { %>
                  <a class="btn btn-primary btn-sm" href="<%= partnerViewPath('cash') %>">Stay in Cash</a>
                  <a class="btn btn-secondary btn-sm" href="<%= partnerViewPath('agents') %>">Switch to Agents</a>
                <% } else if (partnerView === 'onboarding') { %>
                  <a class="btn btn-primary btn-sm" href="<%= partnerViewPath('onboarding') %>">Stay in Onboarding</a>
                  <a class="btn btn-secondary btn-sm" href="<%= partnerViewPath('directory') %>">Open Directory</a>
                <% } else { %>
                  <a class="btn btn-primary btn-sm" href="<%= partnerViewPath('agents') %>">Stay in Agents</a>
                  <a class="btn btn-secondary btn-sm" href="<%= partnerViewPath('cash') %>">Review Cash</a>
                <% } %>
              </div>
            </aside>
          </div>
          <% if (partnerView === 'overview') { %>
          <div class="partner-hub-grid">
            <% partnerSubviewCards.forEach((card) => { %>
              <a href="<%= partnerViewPath(card.key) %>" class="partner-nav-card <%= partnerView === card.key ? 'active' : '' %>">
                <div class="partner-nav-card-head">
                  <span class="eyebrow"><%= card.eyebrow %></span>
                  <span class="partner-nav-open">Open lane</span>
                </div>
                <div class="partner-nav-card-copy">
                  <strong><%= card.title %></strong>
                  <p class="mini"><%= card.description %></p>
                </div>
                <div class="partner-nav-card-metric">
                  <span><%= card.primaryLabel %></span>
                  <strong><%= card.primary %></strong>
                </div>
                <ul class="partner-nav-card-list">
                  <% card.metrics.forEach((metric) => { %>
                    <li><%= metric %></li>
                  <% }) %>
                </ul>
              </a>
            <% }) %>
          </div>
          <% } %>
        </section>

        <% if (partnerView === 'directory') { %>
        <section class="card partner-section-shell">
          <div class="section-header-row">
            <div class="section-header-copy">
              <p class="section-kicker">Directory</p>
              <div>
                <h2>Partner organizations</h2>
                <p class="mini">Start with the org list, then open one record to work on status, membership, and org-level partner access.</p>
              </div>
            </div>
            <div class="section-header-meta">
              <span class="pill"><%= activePartnerOrgCount %> active</span>
              <span class="pill"><%= pendingPartnerOrgCount %> pending</span>
              <span class="pill"><%= suspendedPartnerOrgCount %> suspended</span>
            </div>
          </div>
          <div class="partner-workspace-grid">
            <div class="partner-preview-shell">
              <div class="partner-preview-head">
                <h3>Organization preview</h3>
                <p class="mini">Minimal list first. Open a row to manage the full organization record.</p>
              </div>
              <% if (!partnerOrganizations || partnerOrganizations.length === 0) { %>
                <div class="partner-preview-empty">
                  <strong>No partner organizations yet</strong>
                  <p class="mini">New partner and channel-partner applications will appear here once they are submitted and approved.</p>
                </div>
              <% } else { %>
                <div class="table-wrap partner-preview-table">
                  <table class="admin-data-table">
                    <thead>
                      <tr>
                        <th>Organization</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Members</th>
                        <th>Courses</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% partnerOrganizations.forEach((organization) => { %>
                        <% const isSelectedOrganization = selectedPartnerOrganization && String(selectedPartnerOrganization._id || '') === String(organization._id || '') %>
                        <tr class="<%= isSelectedOrganization ? 'is-selected' : '' %>">
                          <td>
                            <strong><%= organization.name || 'Partner Organization' %></strong>
                            <span class="mini"><%= organization.ownerName || 'No owner captured' %></span>
                          </td>
                          <td><%= String(organization.partnerType || 'partner').replace(/_/g, ' ') %></td>
                          <td><span class="pill"><%= organization.partnerStatus || 'pending' %></span></td>
                          <td><%= Array.isArray(organization.members) ? organization.members.length : 0 %></td>
                          <td><%= Number(organization.publishedCourses || 0) %> live / <%= Number(organization.draftCourses || 0) %> draft</td>
                          <td>
                            <a class="btn <%= isSelectedOrganization ? 'btn-secondary' : 'btn-primary' %> btn-sm" href="<%= partnerViewPath('directory', { organizationId: organization._id }) %>"><%= isSelectedOrganization ? 'Open' : 'View' %></a>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
            <% if (!selectedPartnerOrganization) { %>
              <aside class="partner-detail-shell">
                <div class="partner-empty-detail">
                  <strong>Select an organization record</strong>
                  <p class="mini">The left side stays at summary level. Open one organization to edit status, attach accounts, and manage partner-super roles without pushing the rest of the directory down the page.</p>
                </div>
              </aside>
            <% } else { %>
              <%
                const selectedMemberIds = new Set((selectedPartnerOrganization.members || []).map((member) => String(member.id || '')))
                const selectedOrganizationType = String(selectedPartnerOrganization.partnerType || 'partner').trim().toLowerCase()
                const selectedDefaultMemberRole = selectedOrganizationType === 'channel_partner' ? 'channel_partner_user' : 'partner_user'
                const selectedDefaultSuperRole = selectedOrganizationType === 'channel_partner' ? 'channel_partner_super' : 'partner_super'
                const selectedAddableAccounts = managedAccountRows.filter((account) => {
                  if (selectedMemberIds.has(String(account._id || ''))) return false
                  if (account.agentDashboardRole) return false
                  if (selectedOrganizationType === 'channel_partner' && String(account.partnerDashboardRole || '').startsWith('partner_')) return false
                  if (selectedOrganizationType === 'partner' && String(account.partnerDashboardRole || '').startsWith('channel_partner_')) return false
                  return true
                })
              %>
              <aside class="partner-detail-shell">
                <div class="partner-detail-head">
                  <div class="partner-detail-copy">
                    <p class="section-kicker">Directory record</p>
                    <h3><%= selectedPartnerOrganization.name || 'Partner Organization' %></h3>
                    <p class="mini"><%= selectedPartnerOrganization.description || 'No description provided yet.' %></p>
                  </div>
                  <div class="partner-detail-meta">
                    <span class="pill"><%= selectedPartnerOrganization.partnerType || 'partner' %></span>
                    <span class="pill"><%= selectedPartnerOrganization.partnerStatus || 'pending' %></span>
                    <a class="btn btn-secondary btn-sm" href="<%= partnerViewPath('directory') %>">Back to list</a>
                  </div>
                </div>
                <div class="partner-detail-stack">
                  <div class="admin-tab-shell" data-tab-group>
                    <div class="admin-tab-bar" role="tablist" aria-label="Partner organization panels">
                      <button class="admin-tab is-active" type="button" data-tab-trigger="partner-overview">Overview</button>
                      <button class="admin-tab" type="button" data-tab-trigger="partner-access">Access</button>
                      <button class="admin-tab" type="button" data-tab-trigger="partner-members">Members</button>
                    </div>

                    <div class="admin-tab-panel is-active" data-tab-panel="partner-overview">
                      <p class="admin-tab-intro">Keep the organization snapshot and status control together. Membership and access changes are moved to their own tabs.</p>
                      <section class="partner-detail-section">
                        <div class="partner-detail-section-head">
                          <div>
                            <h4>Operating snapshot</h4>
                            <p class="mini">The org summary stays read-only here so the actual write actions are isolated below.</p>
                          </div>
                        </div>
                        <div class="section-stat-strip">
                          <div class="stack-metric"><span>Members</span><strong><%= Array.isArray(selectedPartnerOrganization.members) ? selectedPartnerOrganization.members.length : 0 %></strong></div>
                          <div class="stack-metric"><span>Agents</span><strong><%= Number(selectedPartnerOrganization.agentCount || 0) %></strong></div>
                          <div class="stack-metric"><span>Published</span><strong><%= Number(selectedPartnerOrganization.publishedCourses || 0) %></strong></div>
                          <div class="stack-metric"><span>Drafts</span><strong><%= Number(selectedPartnerOrganization.draftCourses || 0) %></strong></div>
                        </div>
                        <div class="partner-detail-grid">
                          <div class="stack-metric"><span>Gross sales</span><strong><%= selectedPartnerOrganization.partnerSalesDisplay %></strong></div>
                          <div class="stack-metric"><span>Partner revenue</span><strong><%= selectedPartnerOrganization.partnerRevenueDisplay %></strong></div>
                          <div class="stack-metric"><span>Available wallet</span><strong><%= selectedPartnerOrganization.partnerWithdrawalAvailableDisplay %></strong></div>
                          <div class="stack-metric"><span>Pending withdrawal</span><strong><%= selectedPartnerOrganization.partnerWithdrawalPendingDisplay %></strong></div>
                        </div>
                        <div class="partner-detail-note">
                          <strong>Owner: <%= selectedPartnerOrganization.ownerName || 'Not captured' %></strong>
                          <p class="mini">Pending commission: <%= selectedPartnerOrganization.pendingCommissionDisplay %>. Recommended commission: <%= selectedPartnerOrganization.recommendedCommissionDisplay %>. Approved commission: <%= selectedPartnerOrganization.approvedCommissionDisplay %>.</p>
                        </div>
                      </section>
                      <section class="partner-detail-section">
                        <div class="partner-detail-section-head">
                          <div>
                            <h4>Status control</h4>
                            <p class="mini">Keep onboarding in pending, activate when operations can start, and suspend when access needs to pause.</p>
                          </div>
                        </div>
                        <form method="post" action="/simple-lms/admin/partners/<%= selectedPartnerOrganization._id %>/status" class="partner-detail-form-grid">
                          <label>
                            <span class="mini">Status</span>
                            <select class="input" name="partnerStatus">
                              <option value="pending" <%= String(selectedPartnerOrganization.partnerStatus || '') === 'pending' ? 'selected' : '' %>>pending</option>
                              <option value="active" <%= String(selectedPartnerOrganization.partnerStatus || '') === 'active' ? 'selected' : '' %>>active</option>
                              <option value="suspended" <%= String(selectedPartnerOrganization.partnerStatus || '') === 'suspended' ? 'selected' : '' %>>suspended</option>
                            </select>
                          </label>
                          <div class="actions">
                            <input type="hidden" name="returnTo" value="<%= partnerViewPath('directory', { organizationId: selectedPartnerOrganization._id }) %>">
                            <button class="btn btn-primary btn-sm" type="submit">Update status</button>
                          </div>
                        </form>
                      </section>
                    </div>

                    <div class="admin-tab-panel" data-tab-panel="partner-access" hidden>
                      <p class="admin-tab-intro">Attach accounts here without mixing the org roster with the role-management list below.</p>
                      <section class="partner-detail-section">
                        <div class="partner-detail-section-head">
                          <div>
                            <h4>Attach existing account</h4>
                            <p class="mini">Partner org membership is managed here. Platform admin access stays in Access Control.</p>
                          </div>
                        </div>
                        <% if (selectedAddableAccounts.length === 0) { %>
                          <div class="member-empty-state">
                            <p class="mini">No eligible accounts are available to attach to this organization right now.</p>
                          </div>
                        <% } else { %>
                          <form method="post" action="/simple-lms/admin/partners/<%= selectedPartnerOrganization._id %>/members" class="partner-detail-form-grid">
                            <label>
                              <span class="mini">Account</span>
                              <select class="input" name="accountId" required>
                                <option value="">Add existing account</option>
                                <% selectedAddableAccounts.forEach((account) => { %>
                                  <option value="<%= account._id %>"><%= account.displayName %> - <%= account.email %></option>
                                <% }) %>
                              </select>
                            </label>
                            <label>
                              <span class="mini">Partner role</span>
                              <select class="input" name="role">
                                <option value="<%= selectedDefaultMemberRole %>"><%= selectedDefaultMemberRole %></option>
                                <option value="<%= selectedDefaultSuperRole %>"><%= selectedDefaultSuperRole %></option>
                              </select>
                            </label>
                            <div class="actions">
                              <input type="hidden" name="returnTo" value="<%= partnerViewPath('directory', { organizationId: selectedPartnerOrganization._id }) %>">
                              <button class="btn btn-secondary btn-sm" type="submit">Add member</button>
                            </div>
                          </form>
                        <% } %>
                      </section>
                    </div>

                    <div class="admin-tab-panel" data-tab-panel="partner-members" hidden>
                      <p class="admin-tab-intro">Only the member roster is shown here so promotions, demotions, and removals read as one focused workflow.</p>
                      <section class="partner-detail-section">
                        <div class="partner-detail-section-head">
                          <div>
                            <h4>Current members</h4>
                            <p class="mini">Promote or demote partner-super access here without touching the platform admin model.</p>
                          </div>
                        </div>
                        <% if (!selectedPartnerOrganization.members || selectedPartnerOrganization.members.length === 0) { %>
                          <div class="member-empty-state">
                            <p class="mini">No partner members are linked to this organization yet.</p>
                          </div>
                        <% } else { %>
                          <div class="partner-member-grid">
                            <% selectedPartnerOrganization.members.forEach((member) => { %>
                              <article class="partner-member-card">
                                <div class="partner-org-head">
                                  <div>
                                    <h3 style="font-size:17px;"><%= member.displayName %></h3>
                                    <p class="mini"><%= member.email || '-' %></p>
                                  </div>
                                  <div class="partner-org-meta">
                                    <span class="pill"><%= String(member.memberRoleLabel || member.memberRole || '').replace(/_/g, ' ') %></span>
                                    <% if (member.platformRole) { %><span class="pill"><%= String(member.platformRole).replace(/_/g, ' ') %></span><% } %>
                                    <% if (member.baseLearningRole) { %><span class="pill">base: <%= String(member.baseLearningRole).replace(/_/g, ' ') %></span><% } %>
                                  </div>
                                </div>
                                <div class="partner-member-actions">
                                  <form method="post" action="/simple-lms/admin/partners/<%= selectedPartnerOrganization._id %>/members/<%= member.id %>/role" class="inline-form">
                                    <select class="input" name="role">
                                      <option value="<%= selectedDefaultMemberRole %>" <%= member.memberRoleLabel === selectedDefaultMemberRole ? 'selected' : '' %>><%= selectedDefaultMemberRole %></option>
                                      <option value="<%= selectedDefaultSuperRole %>" <%= member.memberRoleLabel === selectedDefaultSuperRole ? 'selected' : '' %>><%= selectedDefaultSuperRole %></option>
                                    </select>
                                    <input type="hidden" name="returnTo" value="<%= partnerViewPath('directory', { organizationId: selectedPartnerOrganization._id }) %>">
                                    <button class="btn btn-secondary btn-sm" type="submit">Update member</button>
                                  </form>
                                  <form method="post" action="/simple-lms/admin/partners/<%= selectedPartnerOrganization._id %>/members/<%= member.id %>/remove" class="inline-form">
                                    <input type="hidden" name="returnTo" value="<%= partnerViewPath('directory', { organizationId: selectedPartnerOrganization._id }) %>">
                                    <button class="btn btn-danger btn-sm" type="submit">Remove</button>
                                  </form>
                                </div>
                              </article>
                            <% }) %>
                          </div>
                        <% } %>
                      </section>
                    </div>
                  </div>
                </div>
              </aside>
            <% } %>
          </div>
        </section>
        <% } %>

        <% if (partnerView === 'cash') { %>
        <section class="card partner-section-shell">
          <div class="section-header-row">
            <div class="section-header-copy">
              <p class="section-kicker">Cash</p>
              <div>
                <h2>Partner withdrawal queue</h2>
                <p class="mini">Review one withdrawal at a time. The queue stays on the left, while the payout decision lives in a focused review panel.</p>
              </div>
            </div>
            <div class="section-header-meta">
              <span class="pill"><%= openPartnerWithdrawalCount %> open</span>
              <span class="pill"><%= paidPartnerWithdrawalCount %> paid</span>
              <span class="pill"><%= (partnerWithdrawalRequests || []).length %> total requests</span>
            </div>
          </div>
          <div class="queue-summary-strip">
            <div class="stack-metric"><span>Open queue</span><strong><%= openPartnerWithdrawalCount %></strong></div>
            <div class="stack-metric"><span>Paid out</span><strong><%= paidPartnerWithdrawalCount %></strong></div>
            <div class="stack-metric"><span>Available wallet</span><strong><%= moneyText(partnerAvailableWalletMinor, 'NGN') %></strong></div>
            <div class="stack-metric"><span>Commission due</span><strong><%= moneyText(partnerPendingCommissionMinor, 'NGN') %></strong></div>
          </div>
          <div class="partner-workspace-grid">
            <div class="partner-preview-shell">
              <div class="partner-preview-head">
                <h3>Withdrawal preview</h3>
                <p class="mini">Queue first. Open one withdrawal to review and apply a payout action.</p>
              </div>
              <% if (!partnerWithdrawalRequests || partnerWithdrawalRequests.length === 0) { %>
                <div class="partner-preview-empty">
                  <strong>No partner withdrawal requests found</strong>
                  <p class="mini">New partner payout requests will appear here when organizations submit withdrawals.</p>
                </div>
              <% } else { %>
                <div class="table partner-preview-table">
                  <table>
                    <thead>
                      <tr>
                        <th>Date</th>
                        <th>Organization</th>
                        <th>Requested By</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% partnerWithdrawalRequests.forEach((request) => { %>
                        <% const isSelectedWithdrawal = selectedPartnerWithdrawal && String(selectedPartnerWithdrawal._id || '') === String(request._id || '') %>
                        <tr class="<%= isSelectedWithdrawal ? 'is-selected' : '' %>">
                          <td><%= dateText(request.createdAt) %></td>
                          <td>
                            <strong><%= request.organizationName || 'Partner Organization' %></strong>
                            <span class="mini"><%= request.partnerType || 'partner' %></span>
                          </td>
                          <td>
                            <strong><%= request.requestedByName %></strong>
                            <span class="mini"><%= request.requestedByEmail || '-' %></span>
                          </td>
                          <td><%= request.amountDisplay %></td>
                          <td><span class="pill"><%= request.statusLabel %></span></td>
                          <td>
                            <a class="btn <%= isSelectedWithdrawal ? 'btn-secondary' : 'btn-primary' %> btn-sm" href="<%= partnerViewPath('cash', { withdrawalId: request._id }) %>"><%= isSelectedWithdrawal ? 'Open' : 'View' %></a>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
            <% if (!selectedPartnerWithdrawal) { %>
              <aside class="partner-detail-shell">
                <div class="partner-empty-detail">
                  <strong>Select a withdrawal request</strong>
                  <p class="mini">Leave the queue collapsed on the left. Open a single request to approve, reject, or mark it paid without turning the whole lane into one long form list.</p>
                </div>
              </aside>
            <% } else { %>
              <aside class="partner-detail-shell">
                <div class="partner-detail-head">
                  <div class="partner-detail-copy">
                    <p class="section-kicker">Withdrawal review</p>
                    <h3><%= selectedPartnerWithdrawal.amountDisplay %></h3>
                    <p class="mini"><strong><%= selectedPartnerWithdrawal.organizationName || 'Partner Organization' %></strong> requested by <%= selectedPartnerWithdrawal.requestedByName %> on <%= dateText(selectedPartnerWithdrawal.createdAt) %>.</p>
                  </div>
                  <div class="partner-detail-meta">
                    <span class="pill"><%= selectedPartnerWithdrawal.statusLabel %></span>
                    <a class="btn btn-secondary btn-sm" href="<%= partnerViewPath('cash') %>">Back to queue</a>
                  </div>
                </div>
                <div class="partner-detail-stack">
                  <section class="partner-detail-section">
                    <div class="partner-detail-section-head">
                      <div>
                        <h4>Request details</h4>
                        <p class="mini">Keep the request summary visible while you make a payout decision.</p>
                      </div>
                    </div>
                    <div class="partner-detail-grid">
                      <div class="stack-metric"><span>Organization</span><strong><%= selectedPartnerWithdrawal.organizationName || '-' %></strong></div>
                      <div class="stack-metric"><span>Partner type</span><strong><%= selectedPartnerWithdrawal.partnerType || 'partner' %></strong></div>
                      <div class="stack-metric"><span>Requested by</span><strong><%= selectedPartnerWithdrawal.requestedByName %></strong></div>
                      <div class="stack-metric"><span>Email</span><strong><%= selectedPartnerWithdrawal.requestedByEmail || '-' %></strong></div>
                    </div>
                    <div class="partner-detail-note">
                      <strong>Reviewer trail</strong>
                      <p class="mini">Reviewer: <%= selectedPartnerWithdrawal.reviewerName || '-' %>. Paid by: <%= selectedPartnerWithdrawal.paidByName || '-' %>. Transaction ref: <%= selectedPartnerWithdrawal.transactionRef || '-' %>.</p>
                    </div>
                  </section>
                  <section class="partner-detail-section">
                    <div class="partner-detail-section-head">
                      <div>
                        <h4>Payout action</h4>
                        <p class="mini">Choose the next payout state from one controlled form.</p>
                      </div>
                    </div>
                    <% if (selectedPartnerWithdrawal.canApprove || selectedPartnerWithdrawal.canMarkPaid || selectedPartnerWithdrawal.canReject) { %>
                      <form method="post" action="/simple-lms/admin/partner-withdrawals/<%= selectedPartnerWithdrawal._id %>/status" class="partner-detail-form-grid">
                        <label>
                          <span class="mini">Status</span>
                          <select class="input" name="status">
                            <% if (selectedPartnerWithdrawal.canApprove) { %><option value="approved">approved</option><% } %>
                            <% if (selectedPartnerWithdrawal.canMarkPaid) { %><option value="paid">paid</option><% } %>
                            <% if (selectedPartnerWithdrawal.canReject) { %><option value="rejected">rejected</option><% } %>
                          </select>
                        </label>
                        <label>
                          <span class="mini">Transaction ref</span>
                          <input class="input" type="text" name="transactionRef" placeholder="Required when marking paid">
                        </label>
                        <label>
                          <span class="mini">Admin note</span>
                          <textarea class="input" name="adminNotes" rows="4" placeholder="Explain the review or payout decision."></textarea>
                        </label>
                        <div class="actions">
                          <input type="hidden" name="returnTo" value="<%= partnerViewPath('cash', { withdrawalId: selectedPartnerWithdrawal._id }) %>">
                          <button class="btn btn-primary btn-sm" type="submit">Save payout action</button>
                        </div>
                      </form>
                    <% } else { %>
                      <div class="partner-empty-detail">
                        <strong>This payout is already resolved</strong>
                        <p class="mini">No more actions are available. Use the reviewer trail above for audit context.</p>
                      </div>
                    <% } %>
                  </section>
                </div>
              </aside>
            <% } %>
          </div>
        </section>
        <% } %>

        <% if (partnerView === 'onboarding') { %>
        <section class="card partner-section-shell">
          <div class="section-header-row">
            <div class="section-header-copy">
              <p class="section-kicker">Onboarding</p>
              <div>
                <h2>Partner role requests</h2>
                <p class="mini">Keep the approval queue compact. Open one application to review the org context and make the final decision.</p>
              </div>
            </div>
            <div class="section-header-meta">
              <span class="pill"><%= pendingPartnerRequestCount %> pending</span>
              <span class="pill"><%= reviewedPartnerRequestCount %> reviewed</span>
              <span class="pill"><%= partnerRequestRows.length %> total</span>
            </div>
          </div>
          <div class="queue-summary-strip">
            <div class="stack-metric"><span>Pending</span><strong><%= pendingPartnerRequestCount %></strong></div>
            <div class="stack-metric"><span>Reviewed</span><strong><%= reviewedPartnerRequestCount %></strong></div>
            <div class="stack-metric"><span>Channel requests</span><strong><%= partnerRequestRows.filter((request) => String(request.partnerType || request.requestedRole || '').includes('channel')).length %></strong></div>
            <div class="stack-metric"><span>Standard partner</span><strong><%= partnerRequestRows.filter((request) => !String(request.partnerType || request.requestedRole || '').includes('channel')).length %></strong></div>
          </div>
          <div class="partner-workspace-grid">
            <div class="partner-preview-shell">
              <div class="partner-preview-head">
                <h3>Request preview</h3>
                <p class="mini">Review the queue like a normal table. Open one request to approve or reject it.</p>
              </div>
              <% if (!roleApprovalRequests || roleApprovalRequests.length === 0) { %>
                <div class="partner-preview-empty">
                  <strong>No role requests yet</strong>
                  <p class="mini">Partner and channel-partner onboarding requests will appear here for review.</p>
                </div>
              <% } else { %>
                <div class="table partner-preview-table">
                  <table>
                    <thead>
                      <tr>
                        <th>Applicant</th>
                        <th>Requested Role</th>
                        <th>Organization</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% roleApprovalRequests.forEach((request) => { %>
                        <% const isSelectedRequest = selectedPartnerRequest && String(selectedPartnerRequest._id || '') === String(request._id || '') %>
                        <tr class="<%= isSelectedRequest ? 'is-selected' : '' %>">
                          <td>
                            <strong><%= request.accountName %></strong>
                            <span class="mini"><%= request.accountEmail || '-' %></span>
                          </td>
                          <td><%= request.requestedRole %></td>
                          <td><%= request.organizationName || '-' %></td>
                          <td><%= dateText(request.createdAt) %></td>
                          <td><span class="pill"><%= request.status %></span></td>
                          <td>
                            <a class="btn <%= isSelectedRequest ? 'btn-secondary' : 'btn-primary' %> btn-sm" href="<%= partnerViewPath('onboarding', { requestId: request._id }) %>"><%= isSelectedRequest ? 'Open' : 'View' %></a>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
            <% if (!selectedPartnerRequest) { %>
              <aside class="partner-detail-shell">
                <div class="partner-empty-detail">
                  <strong>Select an onboarding request</strong>
                  <p class="mini">The request list stays compact. Open one application to approve, reject, and document the outcome without stretching the whole page.</p>
                </div>
              </aside>
            <% } else { %>
              <% const selectedRequestIsChannelPartner = String(selectedPartnerRequest.partnerType || selectedPartnerRequest.requestedRole || '').includes('channel') %>
              <aside class="partner-detail-shell">
                <div class="partner-detail-head">
                  <div class="partner-detail-copy">
                    <p class="section-kicker">Onboarding review</p>
                    <h3><%= selectedPartnerRequest.accountName %></h3>
                    <p class="mini"><%= selectedPartnerRequest.accountEmail || '-' %> requested <strong><%= selectedPartnerRequest.requestedRole %></strong> for <strong><%= selectedPartnerRequest.organizationName || 'a new organization' %></strong>.</p>
                  </div>
                  <div class="partner-detail-meta">
                    <span class="pill"><%= selectedPartnerRequest.status %></span>
                    <a class="btn btn-secondary btn-sm" href="<%= partnerViewPath('onboarding') %>">Back to queue</a>
                  </div>
                </div>
                <div class="partner-detail-stack">
                  <section class="partner-detail-section">
                    <div class="partner-detail-section-head">
                      <div>
                        <h4>Request summary</h4>
                        <p class="mini">Review the applicant, organization, and partner family before making the approval decision.</p>
                      </div>
                    </div>
                    <div class="partner-detail-grid">
                      <div class="stack-metric"><span>Requested role</span><strong><%= selectedPartnerRequest.requestedRole %></strong></div>
                      <div class="stack-metric"><span>Partner type</span><strong><%= selectedPartnerRequest.partnerType || 'partner' %></strong></div>
                      <div class="stack-metric"><span>Requested on</span><strong><%= dateText(selectedPartnerRequest.createdAt) %></strong></div>
                      <div class="stack-metric"><span>Organization</span><strong><%= selectedPartnerRequest.organizationName || '-' %></strong></div>
                    </div>
                  </section>
                  <% if (String(selectedPartnerRequest.status || '').toLowerCase() === 'pending') { %>
                    <section class="partner-detail-section">
                      <div class="partner-detail-section-head">
                        <div>
                          <h4>Approve request</h4>
                          <p class="mini">Choose the exact org-scoped role to activate when this request is approved.</p>
                        </div>
                      </div>
                      <form method="post" action="/simple-lms/admin/role-requests/<%= selectedPartnerRequest._id %>/approve" class="partner-detail-form-grid">
                        <label>
                          <span class="mini">Approved role</span>
                          <select class="input" name="approvedRole">
                            <% if (selectedRequestIsChannelPartner) { %>
                              <option value="channel_partner_user" <%= selectedPartnerRequest.requestedRole === 'channel_partner_user' ? 'selected' : '' %>>channel_partner_user</option>
                              <option value="channel_partner_super" <%= selectedPartnerRequest.requestedRole === 'channel_partner_super' ? 'selected' : '' %>>channel_partner_super</option>
                            <% } else { %>
                              <option value="partner_user" <%= selectedPartnerRequest.requestedRole === 'partner_user' ? 'selected' : '' %>>partner_user</option>
                              <option value="partner_super" <%= selectedPartnerRequest.requestedRole === 'partner_super' ? 'selected' : '' %>>partner_super</option>
                            <% } %>
                          </select>
                        </label>
                        <label>
                          <span class="mini">Approval note</span>
                          <textarea class="input" name="notes" rows="4" placeholder="Optional note for the approved request."></textarea>
                        </label>
                        <div class="actions">
                          <input type="hidden" name="returnTo" value="<%= partnerViewPath('onboarding', { requestId: selectedPartnerRequest._id }) %>">
                          <button class="btn btn-primary btn-sm" type="submit">Approve request</button>
                        </div>
                      </form>
                    </section>
                    <section class="partner-detail-section">
                      <div class="partner-detail-section-head">
                        <div>
                          <h4>Reject request</h4>
                          <p class="mini">Rejections should capture a clear reason so the applicant knows why the request did not pass.</p>
                        </div>
                      </div>
                      <form method="post" action="/simple-lms/admin/role-requests/<%= selectedPartnerRequest._id %>/reject" class="partner-detail-form-grid">
                        <label>
                          <span class="mini">Reason for rejection</span>
                          <textarea class="input" name="notes" rows="4" placeholder="Explain why this request is being rejected."></textarea>
                        </label>
                        <div class="actions">
                          <input type="hidden" name="returnTo" value="<%= partnerViewPath('onboarding', { requestId: selectedPartnerRequest._id }) %>">
                          <button class="btn btn-danger btn-sm" type="submit">Reject request</button>
                        </div>
                      </form>
                    </section>
                  <% } else { %>
                    <section class="partner-detail-section">
                      <div class="partner-detail-note">
                        <strong>Reviewed by <%= selectedPartnerRequest.reviewedByName || '-' %></strong>
                        <p class="mini"><%= selectedPartnerRequest.reviewNotes || 'No review note added.' %></p>
                      </div>
                    </section>
                  <% } %>
                </div>
              </aside>
            <% } %>
          </div>
        </section>
        <% } %>

        <% if (partnerView === 'agents') { %>
        <section class="card partner-section-shell">
          <div class="section-header-row">
            <div class="section-header-copy">
              <p class="section-kicker">Agents</p>
              <div>
                <h2>Agent commission payout queue</h2>
                <p class="mini">Open one agent payout at a time. The left side stays as the queue, while the right side becomes the payout workspace.</p>
              </div>
            </div>
            <div class="section-header-meta">
              <span class="pill"><%= pendingAgentPayoutCount %> open</span>
              <span class="pill"><%= paidAgentPayoutCount %> paid</span>
              <span class="pill"><%= (agentPayoutRows || []).length %> total entries</span>
            </div>
          </div>
          <div class="queue-summary-strip">
            <div class="stack-metric"><span>Open queue</span><strong><%= pendingAgentPayoutCount %></strong></div>
            <div class="stack-metric"><span>Paid out</span><strong><%= paidAgentPayoutCount %></strong></div>
            <div class="stack-metric"><span>Linked agents</span><strong><%= totalPartnerAgents %></strong></div>
            <div class="stack-metric"><span>Channel orgs</span><strong><%= channelPartnerOrgCount %></strong></div>
          </div>
          <div class="partner-workspace-grid">
            <div class="partner-preview-shell">
              <div class="partner-preview-head">
                <h3>Agent payout preview</h3>
                <p class="mini">Keep the payout queue in table form. Open one commission to see the full payout workspace.</p>
              </div>
              <% if (!agentPayoutRows || agentPayoutRows.length === 0) { %>
                <div class="partner-preview-empty">
                  <strong>No agent commissions in the payout queue</strong>
                  <p class="mini">Recommended and approved agent commissions will appear here for payout review.</p>
                </div>
              <% } else { %>
                <div class="table partner-preview-table">
                  <table>
                    <thead>
                      <tr>
                        <th>Agent</th>
                        <th>Organization</th>
                        <th>Course</th>
                        <th>Commission</th>
                        <th>Status</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% agentPayoutRows.forEach((entry) => { %>
                        <% const isSelectedAgentPayout = selectedAgentPayout && String(selectedAgentPayout._id || '') === String(entry._id || '') %>
                        <tr class="<%= isSelectedAgentPayout ? 'is-selected' : '' %>">
                          <td>
                            <strong><%= entry.agentName %></strong>
                            <span class="mini"><%= entry.agentEmail || '-' %></span>
                          </td>
                          <td><%= entry.organizationName || '-' %></td>
                          <td><%= entry.courseTitle %></td>
                          <td><%= entry.amountDisplay %></td>
                          <td><span class="pill"><%= entry.statusLabel %></span></td>
                          <td>
                            <a class="btn <%= isSelectedAgentPayout ? 'btn-secondary' : 'btn-primary' %> btn-sm" href="<%= partnerViewPath('agents', { agentPayoutId: entry._id }) %>"><%= isSelectedAgentPayout ? 'Open' : 'View' %></a>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
            <% if (!selectedAgentPayout) { %>
              <aside class="partner-detail-shell">
                <div class="partner-empty-detail">
                  <strong>Select an agent payout</strong>
                  <p class="mini">Keep the queue readable. Open one commission record to approve, pay, or reject it without filling the whole page with action forms.</p>
                </div>
              </aside>
            <% } else { %>
              <aside class="partner-detail-shell">
                <div class="partner-detail-head">
                  <div class="partner-detail-copy">
                    <p class="section-kicker">Agent payout review</p>
                    <h3><%= selectedAgentPayout.agentName %></h3>
                    <p class="mini"><%= selectedAgentPayout.organizationName || '-' %> • <%= selectedAgentPayout.courseTitle %></p>
                  </div>
                  <div class="partner-detail-meta">
                    <span class="pill"><%= selectedAgentPayout.statusLabel %></span>
                    <a class="btn btn-secondary btn-sm" href="<%= partnerViewPath('agents') %>">Back to queue</a>
                  </div>
                </div>
                <div class="partner-detail-stack">
                  <section class="partner-detail-section">
                    <div class="partner-detail-section-head">
                      <div>
                        <h4>Payout summary</h4>
                        <p class="mini">This keeps the commercial details visible while you decide the next payout state.</p>
                      </div>
                    </div>
                    <div class="partner-detail-grid">
                      <div class="stack-metric"><span>Commission</span><strong><%= selectedAgentPayout.amountDisplay %></strong></div>
                      <div class="stack-metric"><span>Sale amount</span><strong><%= selectedAgentPayout.saleAmountDisplay %></strong></div>
                      <div class="stack-metric"><span>Rate</span><strong><%= Number(selectedAgentPayout.commissionRatePercent || 0) %>%</strong></div>
                      <div class="stack-metric"><span>Created</span><strong><%= dateText(selectedAgentPayout.createdAt) %></strong></div>
                    </div>
                    <div class="partner-detail-note">
                      <strong>Approval trail</strong>
                      <p class="mini">Recommended by <%= selectedAgentPayout.recommendedByName || '-' %>. Approved by <%= selectedAgentPayout.approvedByName || '-' %>. Transaction ref: <%= selectedAgentPayout.transactionRef || '-' %>.</p>
                    </div>
                  </section>
                  <section class="partner-detail-section">
                    <div class="partner-detail-section-head">
                      <div>
                        <h4>Payout action</h4>
                        <p class="mini">Handle the payout lifecycle from one action panel.</p>
                      </div>
                    </div>
                    <% if (selectedAgentPayout.canApprove || selectedAgentPayout.canMarkPaid || selectedAgentPayout.canReject) { %>
                      <form method="post" action="/simple-lms/admin/agent-commissions/<%= selectedAgentPayout._id %>/status" class="partner-detail-form-grid">
                        <label>
                          <span class="mini">Status</span>
                          <select class="input" name="status">
                            <% if (selectedAgentPayout.canApprove) { %><option value="approved">approved</option><% } %>
                            <% if (selectedAgentPayout.canMarkPaid) { %><option value="paid">paid</option><% } %>
                            <% if (selectedAgentPayout.canReject) { %><option value="rejected">rejected</option><% } %>
                          </select>
                        </label>
                        <label>
                          <span class="mini">Transaction ref</span>
                          <input class="input" type="text" name="transactionRef" placeholder="Required when marking paid">
                        </label>
                        <label>
                          <span class="mini">Admin note</span>
                          <textarea class="input" name="adminNotes" rows="4" placeholder="Explain the payout decision."></textarea>
                        </label>
                        <div class="actions">
                          <input type="hidden" name="returnTo" value="<%= partnerViewPath('agents', { agentPayoutId: selectedAgentPayout._id }) %>">
                          <button class="btn btn-primary btn-sm" type="submit">Save payout action</button>
                        </div>
                      </form>
                    <% } else { %>
                      <div class="partner-empty-detail">
                        <strong>This commission is already resolved</strong>
                        <p class="mini">No more actions are available. Use the approval trail above for audit context.</p>
                      </div>
                    <% } %>
                  </section>
                </div>
              </aside>
            <% } %>
          </div>
        </section>
        <% } %>
      <% } %>

      <% if (currentSection === 'super-users') { %>
        <section class="card">
          <div class="head">
            <div>
              <h2>Platform Admins</h2>
              <p class="mini">Manage platform-wide admin access here. Partner and channel-partner super-user promotions belong in Partner Operations.</p>
            </div>
          </div>

          <div class="platform-admin-grid">
            <% platformAdminRows.forEach((account) => { %>
              <article class="platform-admin-card">
                <div class="role-account-head">
                  <div>
                    <h3><%= account.displayName %></h3>
                    <p class="mini"><%= account.email %></p>
                  </div>
                  <div class="role-account-topline">
                    <% if (account.platformRole) { %><span class="pill"><%= String(account.platformRole).replace(/_/g, ' ') %></span><% } %>
                    <% if (account.partnerDashboardRole) { %><span class="pill"><%= String(account.partnerDashboardRole).replace(/_/g, ' ') %></span><% } %>
                  </div>
                </div>
                <div class="meta-list">
                  <span class="pill">Base: <%= String(account.roleSelectValue || 'learner').replace(/_/g, ' ') %></span>
                  <% if (account.partnerOrganizationName) { %><span class="pill">Org: <%= account.partnerOrganizationName %></span><% } %>
                </div>
                <p class="mini">This account can access the admin console<%= account.partnerDashboardRole ? ' and keeps separate partner dashboard access.' : '.' %></p>
              </article>
            <% }) %>
            <% if (platformAdminRows.length === 0) { %>
              <article class="platform-admin-card">
                <div>
                  <h3>No platform admins yet</h3>
                  <p class="mini">Admin and super admin accounts will appear here as soon as they are assigned.</p>
                </div>
              </article>
            <% } %>
          </div>

          <div class="admin-tab-shell" data-tab-group>
            <div class="admin-tab-bar" role="tablist" aria-label="Platform admin actions">
              <button class="admin-tab is-active" type="button" data-tab-trigger="platform-invite">Invite</button>
              <button class="admin-tab" type="button" data-tab-trigger="platform-promote">Promote</button>
              <button class="admin-tab" type="button" data-tab-trigger="platform-invites">Invite Log</button>
              <button class="admin-tab" type="button" data-tab-trigger="platform-super-admins">Super Admins</button>
            </div>

            <div class="admin-tab-panel is-active" data-tab-panel="platform-invite">
              <p class="admin-tab-intro">Invite creation is isolated here so the page does not stack forms and audit tables on first load.</p>
              <article class="card">
                <strong>Invite New Admin or Super Admin</strong>
                <form method="post" action="/simple-lms/admin/super-users/invite" class="inline-form">
                  <input class="input" type="email" name="email" placeholder="new-admin@company.com" required>
                  <select class="input" name="requestedRole">
                    <option value="admin">admin</option>
                    <option value="super_admin">super_admin</option>
                  </select>
                  <input class="input" type="text" name="notes" maxlength="1200" placeholder="Optional note for the invite">
                  <input class="input" type="password" name="currentPassword" placeholder="Your current password" required>
                  <input type="hidden" name="returnTo" value="/admin/super-users">
                  <button class="btn btn-primary btn-sm" type="submit">Send Invite</button>
                </form>
                <p class="mini">The invitee receives a transactional email from the <%= brandName || 'Seemplify' %> platform mailer, registers with the invite link, verifies a one-time code, and then lands in the admin dashboard.</p>
              </article>
            </div>

            <div class="admin-tab-panel" data-tab-panel="platform-promote" hidden>
              <p class="admin-tab-intro">Elevation actions are kept separate from invites so sensitive role changes are easier to scan and review.</p>
              <article class="card">
                <strong>Promote Existing Platform Admin to Super Admin</strong>
                <form method="post" action="/simple-lms/admin/super-users/promote" class="inline-form">
                  <select class="input" name="targetAccountId">
                    <option value="">Select account</option>
                    <% platformAdminRows.filter((account) => account.platformRole !== 'super_admin').forEach((account) => { %>
                      <option value="<%= account._id %>"><%= account.displayName %> (<%= account.email %>)</option>
                    <% }) %>
                  </select>
                  <input class="input" type="password" name="currentPassword" placeholder="Your current password" required>
                  <input type="hidden" name="returnTo" value="/admin/super-users">
                  <button class="btn btn-primary btn-sm" type="submit">Promote</button>
                </form>
                <p class="mini">Your password is required for every super-user elevation action.</p>
              </article>
            </div>

            <div class="admin-tab-panel" data-tab-panel="platform-invites" hidden>
              <p class="admin-tab-intro">Open the invite log only when you need to track pending onboarding, registration progress, or revocations.</p>
              <div class="table">
                <table>
                  <thead>
                    <tr>
                      <th>Email</th>
                      <th>Role</th>
                      <th>Status</th>
                      <th>Invited By</th>
                      <th>Registered Account</th>
                      <th>Expires</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!adminInviteRows || adminInviteRows.length === 0) { %>
                      <tr><td colspan="7" class="mini">No admin invites recorded yet.</td></tr>
                    <% } else { %>
                      <% adminInviteRows.forEach((invite) => { %>
                        <tr>
                          <td>
                            <strong><%= invite.email %></strong>
                            <% if (invite.notes) { %><br><span class="mini"><%= invite.notes %></span><% } %>
                          </td>
                          <td><span class="pill"><%= invite.requestedRole %></span></td>
                          <td><span class="pill"><%= invite.statusLabel %></span></td>
                          <td><%= invite.invitedByName || '-' %></td>
                          <td>
                            <% if (invite.registeredAccountName) { %>
                              <strong><%= invite.registeredAccountName %></strong><br>
                              <span class="mini"><%= invite.registeredAccount?.email || '' %></span><br>
                              <span class="mini"><%= invite.registeredAccount?.emailVerified ? 'verified' : 'waiting for OTP' %></span>
                            <% } else { %>
                              <span class="mini">Not registered yet</span>
                            <% } %>
                          </td>
                          <td><%= dateText(invite.expiresAt) %></td>
                          <td>
                            <% if (invite.canRevoke) { %>
                              <form method="post" action="/simple-lms/admin/super-users/invites/<%= invite._id %>/revoke" class="inline-form">
                                <input class="input" type="password" name="currentPassword" placeholder="Your current password" required>
                                <input type="hidden" name="returnTo" value="/admin/super-users">
                                <button class="btn btn-danger btn-sm" type="submit">Revoke</button>
                              </form>
                            <% } else { %>
                              <span class="mini">
                                <%= invite.acceptedByName ? `Accepted by ${invite.acceptedByName}` : 'No action available' %>
                              </span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="admin-tab-panel" data-tab-panel="platform-super-admins" hidden>
              <p class="admin-tab-intro">Only the current super-admin roster is shown here so demotion decisions are not mixed with the rest of the page.</p>
              <div class="table">
                <table>
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Email</th>
                      <th>Promoted At</th>
                      <th>Promoted By</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!superUserAccounts || superUserAccounts.length === 0) { %>
                      <tr><td colspan="5" class="mini">No super admins found.</td></tr>
                    <% } else { %>
                      <% superUserAccounts.forEach((superUser) => { %>
                        <tr>
                          <td><strong><%= superUser.displayName %></strong></td>
                          <td><%= superUser.email %></td>
                          <td><%= dateText(superUser.promotedAt) %></td>
                          <td><%= superUser.promotedByName || '-' %></td>
                          <td>
                            <% if (String(user?._id || '') !== String(superUser._id || '')) { %>
                              <form method="post" action="/simple-lms/admin/super-users/<%= superUser._id %>/demote" class="inline-form">
                                <input class="input" type="password" name="currentPassword" placeholder="Your current password" required>
                                <input type="hidden" name="returnTo" value="/admin/super-users">
                                <button class="btn btn-danger btn-sm" type="submit">Demote</button>
                              </form>
                            <% } else { %>
                              <span class="mini">Current account</span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      <% } %>

      <% if (currentSection === 'audit-log') { %>
        <% 
          const adminActorAuditCount = (auditLogEntries || []).filter((entry) => entry.performedByRole === 'admin').length
          const superAdminActorAuditCount = (auditLogEntries || []).filter((entry) => entry.performedByRole === 'super_admin').length
          const inviteAuditCount = (auditLogEntries || []).filter((entry) => String(entry.action || '').startsWith('admin.invite')).length
          const securityAuditCount = (auditLogEntries || []).filter((entry) => String(entry.action || '').startsWith('security.')).length
        %>
        <section class="card audit-log-card">
          <div class="audit-log-shell">
            <div class="audit-log-intro">
              <div>
                <span class="eyebrow">Platform Access Trail</span>
                <h3>Admin and super admin activity</h3>
                <p class="mini">This stream is limited to platform-admin actions and onboarding events. Open any record to inspect who performed it, the role of that user, the affected account or organization, and the full event metadata.</p>
              </div>
              <div class="audit-summary-strip">
                <article class="audit-summary-card">
                  <span>Total events</span>
                  <strong><%= (auditLogEntries || []).length %></strong>
                </article>
                <article class="audit-summary-card">
                  <span>Super admin actions</span>
                  <strong><%= superAdminActorAuditCount %></strong>
                </article>
                <article class="audit-summary-card">
                  <span>Admin actions</span>
                  <strong><%= adminActorAuditCount %></strong>
                </article>
                <article class="audit-summary-card">
                  <span>Invite and security</span>
                  <strong><%= inviteAuditCount + securityAuditCount %></strong>
                </article>
              </div>
            </div>

            <% if (!auditLogEntries || auditLogEntries.length === 0) { %>
              <div class="audit-log-empty">
                <p class="mini">No admin or super admin audit events have been recorded yet.</p>
              </div>
            <% } else { %>
              <div class="audit-stream">
                <% auditLogEntries.forEach((entry, index) => { %>
                  <details class="audit-entry" <%= index === 0 ? 'open' : '' %>>
                    <summary class="audit-entry-summary">
                      <div class="audit-entry-main">
                        <div class="audit-entry-topline">
                          <span class="pill"><%= entry.actionLabel %></span>
                          <span class="pill"><%= entry.performedByRoleLabel %></span>
                          <% if (entry.targetAccountRoleLabel) { %>
                            <span class="pill">Target: <%= entry.targetAccountRoleLabel %></span>
                          <% } %>
                        </div>
                        <h3><%= entry.headline %></h3>
                        <p class="mini"><%= entry.narrative %></p>
                      </div>
                      <div class="audit-entry-side">
                        <strong><%= dateText(entry.createdAt) %></strong>
                        <span><%= entry.performedByName %></span>
                        <span><%= entry.performedByEmail || 'email not captured' %></span>
                      </div>
                    </summary>
                    <div class="audit-entry-body">
                      <div class="audit-identity-grid">
                        <article class="audit-identity-card">
                          <span class="audit-card-label">Actor</span>
                          <strong><%= entry.performedByName %></strong>
                          <span><%= entry.performedByEmail || 'email not captured' %></span>
                          <span>Type: <%= entry.performedByRoleLabel %></span>
                          <% if (entry.performedById) { %><span>Account ID: <%= entry.performedById %></span><% } %>
                        </article>
                        <article class="audit-identity-card">
                          <span class="audit-card-label">Affected target</span>
                          <% if (entry.targetAccountName || entry.targetOrganizationName) { %>
                            <% if (entry.targetAccountName) { %><strong><%= entry.targetAccountName %></strong><% } %>
                            <% if (entry.targetAccountEmail) { %><span><%= entry.targetAccountEmail %></span><% } %>
                            <% if (entry.targetAccountRoleLabel) { %><span>Type: <%= entry.targetAccountRoleLabel %></span><% } %>
                            <% if (entry.targetOrganizationName) { %><span>Organization: <%= entry.targetOrganizationName %><%= entry.targetOrganizationType ? ` (${entry.targetOrganizationType})` : '' %></span><% } %>
                            <% if (entry.targetAccountId) { %><span>Account ID: <%= entry.targetAccountId %></span><% } %>
                          <% } else { %>
                            <span>No direct target account or organization was recorded for this event.</span>
                          <% } %>
                        </article>
                        <article class="audit-identity-card">
                          <span class="audit-card-label">Source context</span>
                          <strong><%= entry.ipAddress || 'IP not captured' %></strong>
                          <span><%= entry.userAgent || 'User agent not captured' %></span>
                          <span>Event ID: <%= entry.eventId || '-' %></span>
                        </article>
                      </div>
                      <div class="audit-detail-grid">
                        <article class="audit-detail-card">
                          <span class="audit-card-label">What happened</span>
                          <p><%= entry.narrative %></p>
                        </article>
                        <article class="audit-detail-card">
                          <span class="audit-card-label">Event metadata</span>
                          <% if (entry.metadataPairs && entry.metadataPairs.length > 0) { %>
                            <dl class="audit-meta-grid">
                              <% entry.metadataPairs.forEach((pair) => { %>
                                <div>
                                  <dt><%= pair.label %></dt>
                                  <dd><%= pair.value %></dd>
                                </div>
                              <% }) %>
                            </dl>
                          <% } else { %>
                            <p>No extra metadata was captured for this record.</p>
                          <% } %>
                        </article>
                      </div>
                    </div>
                  </details>
                <% }) %>
              </div>
            <% } %>
          </div>
        </section>
      <% } %>

      <% if (currentSection === 'creators') { %>
        <section class="card creator-management-card">
          <div class="head">
            <div>
              <h2>Creator Management</h2>
              <p class="mini">Manage creator sales, balances, withdrawal approvals, commissions, and payout details from one place.</p>
            </div>
          </div>

          <form method="get" action="/admin/creators" class="form-grid creator-filter-grid">
            <select class="input" name="creatorId">
              <option value="">All creators</option>
              <% (creatorAdminRows || []).forEach((creator) => { %>
                <option value="<%= creator.creatorId %>" <%= selectedCreatorId === String(creator.creatorId) ? 'selected' : '' %>>
                  <%= creator.creatorName %><%= creator.creatorEmail ? ` (${creator.creatorEmail})` : '' %>
                </option>
              <% }) %>
            </select>
            <button class="btn btn-primary btn-sm" type="submit">Open Creator</button>
            <% if (selectedCreatorId) { %>
              <a class="btn btn-secondary btn-sm" href="/admin/creators">Clear</a>
            <% } %>
          </form>

          <% if (selectedCreator) { %>
            <article id="creator-detail" class="card creator-detail-card">
              <div class="creator-detail-top">
                <div>
                  <h3 class="creator-detail-name"><%= selectedCreator.creatorName %></h3>
                  <p class="creator-detail-email"><%= selectedCreator.creatorEmail || '-' %> - Role: <%= selectedCreator.resolvedRole %></p>
                </div>
                <div class="actions">
                  <a class="btn btn-secondary btn-sm" href="<%= selectedCreator.coursesPath %>">Manage Creator Courses</a>
                  <a class="btn btn-secondary btn-sm" href="/admin/courses?creatorId=<%= encodeURIComponent(selectedCreator.creatorId) %>">Open Admin Course Studio</a>
                </div>
              </div>

              <div class="creator-kpi-grid">
                <article class="creator-kpi-tile"><span>Total Courses</span><strong><%= selectedCreator.totalCourses %></strong></article>
                <article class="creator-kpi-tile"><span>Published</span><strong><%= selectedCreator.publishedCourses %></strong></article>
                <article class="creator-kpi-tile"><span>Gross Sales</span><strong><%= selectedCreator.grossDisplay %></strong></article>
                <article class="creator-kpi-tile"><span>Creator Earnings</span><strong><%= selectedCreator.creatorCommissionDisplay %></strong></article>
                <article class="creator-kpi-tile"><span>Available Balance</span><strong><%= selectedCreator.availableBalanceDisplay %></strong></article>
                <article class="creator-kpi-tile"><span>Withdrawal Requests</span><strong><%= selectedCreator.withdrawalRequestCount %></strong></article>
              </div>

              <div class="creator-detail-grid">
                <article>
                  <h3>Payout Profile</h3>
                  <% if (selectedCreator.hasPayoutProfile) { %>
                    <p><strong>Bank:</strong> <%= selectedCreator.payoutBankName || '-' %></p>
                    <p><strong>Account:</strong> <%= selectedCreator.payoutAccountName || '-' %> <%= selectedCreator.payoutAccountNumber || selectedCreator.payoutAccountMasked || '' %></p>
                    <p><strong>Email:</strong> <%= selectedCreator.payoutPaymentEmail || '-' %></p>
                  <% } else { %>
                    <p>Payout details are not yet configured by this creator.</p>
                  <% } %>
                </article>
                <article>
                  <h3>Commission</h3>
                  <p><strong>Effective Rate:</strong> <%= selectedCreator.commissionRatePercent %>%</p>
                  <p><strong>Mode:</strong> <%= selectedCreator.hasCommissionOverride ? 'Account override is active' : `Using global rate (${commissionSettings.globalRatePercent}%)` %></p>
                  <form method="post" action="/simple-lms/commission/account" class="inline-form">
                    <input type="hidden" name="accountId" value="<%= selectedCreator.creatorId %>">
                    <input class="input" type="number" name="ratePercent" min="0" max="100" step="0.01" value="<%= selectedCreator.commissionRatePercent %>" style="width:110px;">
                    <input type="hidden" name="returnTo" value="<%= creatorsReturnTo %>">
                    <button class="btn btn-primary btn-sm" type="submit"><%= selectedCreator.hasCommissionOverride ? 'Update Rate' : 'Set Rate' %></button>
                  </form>
                </article>
                <article>
                  <h3>Course Snapshot</h3>
                  <p>Pending: <strong><%= selectedCreator.pendingCourses %></strong> | Draft: <strong><%= selectedCreator.draftCourses %></strong></p>
                  <p>Archived: <strong><%= selectedCreator.archivedCourses %></strong> | Learners: <strong><%= selectedCreator.enrollmentCount %></strong></p>
                  <% if (selectedCreator.topCourses && selectedCreator.topCourses.length > 0) { %>
                    <p><strong>Latest:</strong></p>
                    <% selectedCreator.topCourses.forEach((course) => { %>
                      <p><a href="<%= buildAdminCourseRecordPath(course.courseId, creatorsReturnTo) %>"><%= course.title %></a> (<%= course.status %>)</p>
                    <% }) %>
                  <% } else { %>
                    <p>No courses available for this creator yet.</p>
                  <% } %>
                </article>
              </div>
            </article>
          <% } %>

          <% if (!creatorRows || creatorRows.length === 0) { %>
            <p class="mini">No creators found.</p>
          <% } else { %>
            <div class="table">
              <table>
                <thead>
                  <tr>
                    <th>Creator</th>
                    <th>Portfolio</th>
                    <th>Sales</th>
                    <th>Wallet</th>
                    <th>Payout</th>
                    <th>Commission</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% creatorRows.forEach((creator) => { %>
                    <tr>
                      <td>
                        <a class="creator-name-link" href="<%= creator.creatorPath %>"><%= creator.creatorName %></a><br>
                        <span class="mini"><%= creator.creatorEmail || '-' %></span><br>
                        <span class="mini">Role: <%= creator.resolvedRole %></span>
                      </td>
                      <td>
                        <span class="mini">
                          Total: <strong><%= creator.totalCourses %></strong><br>
                          Published: <strong><%= creator.publishedCourses %></strong> | Pending: <strong><%= creator.pendingCourses %></strong><br>
                          Draft: <strong><%= creator.draftCourses %></strong> | Archived: <strong><%= creator.archivedCourses %></strong>
                        </span>
                      </td>
                      <td>
                        <span class="mini">
                          Sales: <strong><%= creator.saleCount %></strong><br>
                          Gross: <strong><%= creator.grossDisplay %></strong><br>
                          Earnings: <strong><%= creator.creatorCommissionDisplay %></strong>
                        </span>
                      </td>
                      <td>
                        <span class="mini">
                          Available: <strong><%= creator.availableBalanceDisplay %></strong><br>
                          Pending: <strong><%= creator.pendingWithdrawalDisplay %></strong><br>
                          Paid Out: <strong><%= creator.paidWithdrawalDisplay %></strong>
                        </span>
                      </td>
                      <td>
                        <span class="mini">
                          <% if (creator.hasPayoutProfile) { %>
                            <%= creator.payoutBankName || 'Bank details saved' %><br>
                            <%= creator.payoutAccountName || '-' %> <%= creator.payoutAccountNumber || creator.payoutAccountMasked || '' %><br>
                            <%= creator.payoutPaymentEmail || '-' %>
                          <% } else { %>
                            Payout details missing
                          <% } %>
                        </span>
                      </td>
                      <td>
                        <span class="mini">
                          Effective: <strong><%= creator.commissionRatePercent %>%</strong><br>
                          <%= creator.hasCommissionOverride ? 'Override active' : `Global rate (${commissionSettings.globalRatePercent}%)` %>
                        </span>
                      </td>
                      <td>
                        <div class="creator-actions">
                          <a class="btn btn-secondary btn-sm" href="<%= creator.creatorPath %>">View Creator</a>
                          <a class="btn btn-secondary btn-sm" href="<%= creator.coursesPath %>">Manage Courses</a>
                          <form method="post" action="/simple-lms/commission/account" class="inline-form">
                            <input type="hidden" name="accountId" value="<%= creator.creatorId %>">
                            <input class="input" type="number" name="ratePercent" min="0" max="100" step="0.01" value="<%= creator.commissionRatePercent %>" style="width:88px;">
                            <input type="hidden" name="returnTo" value="<%= creatorsReturnTo %>">
                            <button class="btn btn-primary btn-sm" type="submit"><%= creator.hasCommissionOverride ? 'Update' : 'Set' %></button>
                          </form>
                          <% if (creator.hasCommissionOverride) { %>
                            <form method="post" action="/simple-lms/commission/account/remove" class="inline-form">
                              <input type="hidden" name="accountId" value="<%= creator.creatorId %>">
                              <input type="hidden" name="returnTo" value="<%= creatorsReturnTo %>">
                              <button class="btn btn-danger btn-sm" type="submit">Remove Override</button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

          <article class="card">
            <div class="head">
              <div>
                <h2 style="font-size:24px;">Withdrawal Requests</h2>
                <p class="mini">Approve, reject, or mark payouts as paid directly from this queue.</p>
              </div>
            </div>

            <div class="withdrawal-summary">
              <% const pendingWithdrawalCount = (adminWithdrawalRequests || []).filter((request) => String(request.status || '').toLowerCase() === 'pending').length %>
              <% const approvedWithdrawalCount = (adminWithdrawalRequests || []).filter((request) => String(request.status || '').toLowerCase() === 'approved').length %>
              <% const paidWithdrawalCount = (adminWithdrawalRequests || []).filter((request) => String(request.status || '').toLowerCase() === 'paid').length %>
              <article class="kpi"><small>Pending</small><strong><%= pendingWithdrawalCount %></strong></article>
              <article class="kpi"><small>Approved</small><strong><%= approvedWithdrawalCount %></strong></article>
              <article class="kpi"><small>Paid</small><strong><%= paidWithdrawalCount %></strong></article>
            </div>

            <% if (!adminWithdrawalRequests || adminWithdrawalRequests.length === 0) { %>
              <p class="mini">No withdrawal requests found.</p>
            <% } else { %>
              <div class="table withdrawal-table">
                <table>
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Creator</th>
                      <th>Amount</th>
                      <th>Status</th>
                      <th>Payout Snapshot</th>
                      <th>Notes</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% adminWithdrawalRequests.forEach((request) => { %>
                      <tr class="withdrawal-row-main">
                        <td><%= dateText(request.requestedAt || request.createdAt) %></td>
                        <td>
                          <strong><%= request.creatorName %></strong><br>
                          <span class="mini"><%= request.creatorEmail || '-' %></span><br>
                          <% if (request.creatorId) { %>
                            <a class="btn btn-secondary btn-sm" href="/admin/creators/<%= encodeURIComponent(request.creatorId) %>">Open Creator</a>
                          <% } %>
                        </td>
                        <td><%= request.amountDisplay %></td>
                        <td><span class="pill"><%= request.statusLabel %></span></td>
                        <td>
                          <span class="mini">
                            <%= request.payoutProfileSnapshot?.bankName || '-' %><br>
                            <%= request.payoutProfileSnapshot?.accountName || '-' %><br>
                            <%= request.payoutProfileSnapshot?.paymentEmail || '-' %>
                          </span>
                        </td>
                        <td>
                          <span class="mini"><%= request.notes || '-' %></span>
                        </td>
                      </tr>
                      <tr class="withdrawal-row-actions">
                        <td colspan="6">
                          <div class="withdrawal-review-stack">
                            <% if (request.canApprove || request.canReject || request.canMarkPaid) { %>
                              <form method="post" action="/simple-lms/admin/withdrawals/<%= request._id %>/status" class="withdrawal-status-form">
                                <input class="input" type="text" name="transactionRef" placeholder="Transaction ref (for paid)">
                                <input class="input" type="text" name="adminNotes" placeholder="Admin note (optional)">
                                <div class="withdrawal-actions">
                                  <% if (request.canApprove) { %>
                                    <button class="btn btn-primary btn-sm" type="submit" name="status" value="approved">Approve</button>
                                  <% } %>
                                  <% if (request.canMarkPaid) { %>
                                    <button class="btn btn-secondary btn-sm" type="submit" name="status" value="paid">Mark Paid</button>
                                  <% } %>
                                  <% if (request.canReject) { %>
                                    <button class="btn btn-danger btn-sm" type="submit" name="status" value="rejected">Reject</button>
                                  <% } %>
                                </div>
                                <input type="hidden" name="returnTo" value="<%= creatorsReturnTo %>">
                              </form>
                            <% } else { %>
                              <div class="withdrawal-meta">
                                <span><strong>Finalized:</strong> <%= request.statusLabel %></span>
                                <span>Reviewer: <%= request.reviewerName || '-' %></span>
                                <span>Paid By: <%= request.paidByName || '-' %></span>
                                <span>Transaction Ref: <%= request.transactionRef || '-' %></span>
                                <span>Admin Note: <%= request.adminNotes || '-' %></span>
                              </div>
                            <% } %>

                            <details class="withdrawal-trace">
                              <summary>Earnings trace for review (<%= request.salesTraceCount || 0 %> sales)</summary>
                              <div class="withdrawal-trace-summary">
                                <span><strong>Total Sold:</strong> <%= request.creatorSoldDisplay || 'NGN 0.00' %></span>
                                <span><strong>Total Earnings:</strong> <%= request.creatorEarningsDisplay || 'NGN 0.00' %></span>
                                <span><strong>Pending Reserved:</strong> <%= request.creatorPendingWithdrawalDisplay || 'NGN 0.00' %></span>
                                <span><strong>Paid Out:</strong> <%= request.creatorPaidWithdrawalDisplay || 'NGN 0.00' %></span>
                                <span><strong>Available Before Request:</strong> <%= request.availableBeforeCurrentRequestDisplay || 'NGN 0.00' %></span>
                                <span><strong>Remaining After Request:</strong> <%= request.remainingAfterRequestDisplay || 'NGN 0.00' %></span>
                              </div>
                              <% if (request.salesTraceRows && request.salesTraceRows.length > 0) { %>
                                <div class="table withdrawal-trace-table">
                                  <table>
                                    <thead>
                                      <tr>
                                        <th>Date</th>
                                        <th>Course</th>
                                        <th>Buyer</th>
                                        <th>Sale</th>
                                        <th>Creator Rate</th>
                                        <th>Creator Share</th>
                                        <th>Platform Share</th>
                                        <th>Agent Share</th>
                                        <th>Net Platform</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      <% request.salesTraceRows.forEach((sale) => { %>
                                        <tr>
                                          <td><%= dateText(sale.paidAt) %></td>
                                          <td><%= sale.courseTitle %></td>
                                          <td>
                                            <%= sale.buyerName %>
                                            <% if (sale.agentName) { %><br><span class="mini">agent: <%= sale.agentName %></span><% } %>
                                          </td>
                                          <td><%= sale.amountDisplay %></td>
                                          <td><%= sale.creatorCommissionRateDisplay %></td>
                                          <td><%= sale.creatorCommissionDisplay %></td>
                                          <td><%= sale.platformShareDisplay %></td>
                                          <td><%= sale.agentCommissionDisplay %></td>
                                          <td><%= sale.netPlatformDisplay %></td>
                                        </tr>
                                      <% }) %>
                                    </tbody>
                                  </table>
                                </div>
                              <% } else { %>
                                <p class="mini" style="margin-top:10px;">No successful sales trace found for this creator yet.</p>
                              <% } %>
                            </details>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </article>
        </section>
      <% } %>

      <% if (currentSection === 'users') { %>
        <section class="card">
          <div class="head"><div><h2>Users & Roles</h2><p class="mini">Manage base LMS roles and additive platform-admin access. Partner and channel-partner memberships stay inside Partner Operations.</p></div></div>
          <div class="role-summary-grid">
            <article class="role-summary-card">
              <div>
                <h3>Role distribution</h3>
                <p class="mini">This page is limited to learner, creator, admin, and super admin access. Partner org roles are managed separately so org context is never lost.</p>
              </div>
              <div class="role-stat-strip">
                <div class="role-summary-metric"><span>Managed accounts</span><strong><%= managedAccountRows.length %></strong></div>
                <div class="role-summary-metric"><span>Platform admins</span><strong><%= platformAdminAccountCount %></strong></div>
                <div class="role-summary-metric"><span>Partner-linked users</span><strong><%= partnerManagedAccountCount %></strong></div>
                <div class="role-summary-metric"><span>Creators</span><strong><%= (creatorAdminRows || []).length %></strong></div>
              </div>
            </article>
            <article class="role-summary-card">
              <div>
                <h3>How this page works</h3>
                <p class="mini">Changing admin access here does not erase partner membership. Use Partner Operations for partner super-user promotion and org membership changes.</p>
              </div>
              <div class="actions">
                <a class="btn btn-secondary btn-sm" href="/admin/partners">Open Partner Operations</a>
                <a class="btn btn-secondary btn-sm" href="/admin/super-users">Manage Platform Admins</a>
              </div>
            </article>
          </div>
          <div class="role-directory">
            <% managedAccountRows.forEach((account) => { %>
              <form method="post" action="/simple-lms/accounts/<%= account._id %>/role" class="role-account-card">
                <div class="role-account-head">
                  <div>
                    <h3><%= account.displayName %></h3>
                    <p class="mini"><%= account.email %></p>
                  </div>
                  <div class="role-account-topline">
                    <span class="pill">base: <%= String(account.roleSelectValue || 'learner').replace(/_/g, ' ') %></span>
                    <% if (account.platformRole) { %><span class="pill"><%= String(account.platformRole).replace(/_/g, ' ') %></span><% } %>
                    <% if (account.partnerDashboardRole) { %><span class="pill"><%= String(account.partnerDashboardRole).replace(/_/g, ' ') %></span><% } %>
                    <% if (account.isSuperAdmin) { %><span class="pill">super flag</span><% } %>
                    <% if (account.isSystemAdmin && !account.isSuperAdmin) { %><span class="pill">admin flag</span><% } %>
                  </div>
                </div>
                <% if (account.partnerOrganizationName) { %>
                  <div class="meta-list">
                    <span class="pill">Org: <%= account.partnerOrganizationName %></span>
                    <% if (account.partnerOrganizationType) { %><span class="pill"><%= account.partnerOrganizationType %></span><% } %>
                    <% if (account.partnerOrganizationStatus) { %><span class="pill"><%= account.partnerOrganizationStatus %></span><% } %>
                  </div>
                <% } %>
                <div class="role-account-form">
                  <label>
                    <span class="mini">Base or platform role</span>
                    <select class="input" name="role">
                      <option value="learner" <%= account.roleSelectValue === 'learner' ? 'selected' : '' %>>learner</option>
                      <option value="creator" <%= account.roleSelectValue === 'creator' ? 'selected' : '' %>>creator</option>
                      <option value="admin" <%= account.roleSelectValue === 'admin' ? 'selected' : '' %>>admin</option>
                      <option value="super_admin" <%= account.roleSelectValue === 'super_admin' ? 'selected' : '' %>>super_admin</option>
                    </select>
                  </label>
                </div>
                <div class="role-account-foot">
                  <span class="mini">Partner and channel-partner roles are handled in Partner Operations. This action only changes base LMS role or platform-admin access.</span>
                  <input type="hidden" name="returnTo" value="<%= adminReturnToPath %>">
                  <button class="btn btn-primary btn-sm" type="submit">Save Role</button>
                </div>
              </form>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (currentSection === 'commission') { %>
        <section class="card">
          <div class="head"><div><h2>Commissions</h2><p class="mini">Global, account, and course-level overrides.</p></div></div>
          <div class="form-grid">
            <form method="post" action="/simple-lms/commission/global" class="card">
              <label>Global Rate (%)</label>
              <input class="input" type="number" name="globalRatePercent" min="0" max="100" step="0.01" value="<%= commissionSettings.globalRatePercent %>">
              <input type="hidden" name="returnTo" value="<%= adminReturnToPath %>">
              <button class="btn btn-primary btn-sm" type="submit">Save</button>
            </form>
            <form method="post" action="/simple-lms/commission/account" class="card">
              <label>Account Override</label>
              <select class="input" name="accountId">
                <option value="">Select account</option>
                <% (adminAccounts || []).forEach((account) => { %>
                  <option value="<%= account._id %>"><%= account.displayName %> - <%= account.email %></option>
                <% }) %>
              </select>
              <input class="input" type="number" name="ratePercent" min="0" max="100" step="0.01" placeholder="Rate %">
              <input type="hidden" name="returnTo" value="<%= adminReturnToPath %>">
              <button class="btn btn-primary btn-sm" type="submit">Save</button>
            </form>
            <form method="post" action="/simple-lms/commission/course" class="card">
              <label>Course Override</label>
              <select class="input" name="courseId">
                <option value="">Select course</option>
                <% courses.forEach((course) => { %>
                  <option value="<%= course._id %>"><%= course.title %></option>
                <% }) %>
              </select>
              <input class="input" type="number" name="ratePercent" min="0" max="100" step="0.01" placeholder="Rate %">
              <input type="hidden" name="returnTo" value="<%= adminReturnToPath %>">
              <button class="btn btn-primary btn-sm" type="submit">Save</button>
            </form>
          </div>
          <div class="grid">
            <article class="card">
              <strong>Account Overrides</strong>
              <% if (!commissionSettings.accountOverrides || commissionSettings.accountOverrides.length === 0) { %>
                <p class="mini">No account overrides.</p>
              <% } else { %>
                <% commissionSettings.accountOverrides.forEach((item) => { %>
                  <form method="post" action="/simple-lms/commission/account/remove" class="actions">
                    <span class="mini"><%= item.accountName %> (<%= item.ratePercent %>%)</span>
                    <input type="hidden" name="accountId" value="<%= item.accountId %>">
                    <input type="hidden" name="returnTo" value="<%= adminReturnToPath %>">
                    <button class="btn btn-danger btn-sm" type="submit">Remove</button>
                  </form>
                <% }) %>
              <% } %>
            </article>
            <article class="card">
              <strong>Course Overrides</strong>
              <% if (!commissionSettings.courseOverrides || commissionSettings.courseOverrides.length === 0) { %>
                <p class="mini">No course overrides.</p>
              <% } else { %>
                <% commissionSettings.courseOverrides.forEach((item) => { %>
                  <form method="post" action="/simple-lms/commission/course/remove" class="actions">
                    <span class="mini"><%= item.courseTitle %> (<%= item.ratePercent %>%)</span>
                    <input type="hidden" name="courseId" value="<%= item.courseId %>">
                    <input type="hidden" name="returnTo" value="<%= adminReturnToPath %>">
                    <button class="btn btn-danger btn-sm" type="submit">Remove</button>
                  </form>
                <% }) %>
              <% } %>
            </article>
          </div>
        </section>
      <% } %>

      <% if (currentSection === 'payments') { %>
        <section class="card">
          <div class="head"><div><h2>Payments</h2><p class="mini">Filter transactions and re-verify unresolved payments.</p></div></div>
          <form method="get" action="/admin/payments" class="form-grid">
            <select class="input" name="paymentStatus">
              <option value="all" <%= adminPaymentFilters.status === 'all' ? 'selected' : '' %>>all statuses</option>
              <% paymentStatuses.forEach((status) => { %>
                <option value="<%= status %>" <%= adminPaymentFilters.status === status ? 'selected' : '' %>><%= status %></option>
              <% }) %>
            </select>
            <select class="input" name="paymentCurrency">
              <option value="all" <%= adminPaymentFilters.currency === 'all' ? 'selected' : '' %>>all currencies</option>
              <% paymentCurrencies.forEach((currency) => { %>
                <option value="<%= currency %>" <%= adminPaymentFilters.currency === currency ? 'selected' : '' %>><%= currency %></option>
              <% }) %>
            </select>
            <input class="input" type="date" name="paymentFrom" value="<%= adminPaymentFilters.dateFrom || '' %>">
            <input class="input" type="date" name="paymentTo" value="<%= adminPaymentFilters.dateTo || '' %>">
            <input class="input" type="text" name="paymentSearch" value="<%= adminPaymentFilters.search || '' %>" placeholder="search">
            <button class="btn btn-primary btn-sm" type="submit">Apply</button>
          </form>
          <div class="table">
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Learner</th>
                  <th>Course</th>
                  <th>Provider</th>
                  <th>Amount</th>
                  <th>Status</th>
                  <th>Tx Ref</th>
                  <th>Provider Tx</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% (adminPayments || []).forEach((payment) => { %>
                  <tr>
                    <td><%= dateText(payment.createdAt) %></td>
                    <td><%= payment.learnerName %></td>
                    <td><%= payment.courseTitle %></td>
                    <td><%= payment.providerLabel || '-' %></td>
                    <td><%= payment.amountDisplay %></td>
                    <td><span class="pill"><%= payment.statusLabel %></span></td>
                    <td><%= payment.txRef %></td>
                    <td><%= payment.providerReference || '-' %></td>
                    <td>
                      <% if (['pending', 'initiated', 'failed', 'cancelled'].includes(payment.status)) { %>
                        <form method="post" action="/simple-lms/admin/payments/<%= payment._id %>/reverify" class="inline-form">
                          <input class="input" type="text" name="transactionId" value="<%= payment.providerReference || '' %>" placeholder="<%= payment.provider === 'paystack' ? 'paystack reference' : 'provider tx id' %>">
                          <input type="hidden" name="returnTo" value="<%= adminPaymentFilters.returnTo || '/admin/payments' %>">
                          <button class="btn btn-secondary btn-sm" type="submit">Re-verify</button>
                        </form>
                      <% } else { %>
                        <span class="mini">No action</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      <% } %>

      <% if (currentSection === 'settings') { %>
        <section class="card">
          <div class="head"><div><h2>Platform Settings</h2><p class="mini">Admin-level defaults and lifecycle controls.</p></div></div>
          <form method="post" action="/simple-lms/settings/platform" class="form-grid">
            <input type="hidden" name="platformFormComplete" value="1">
            <select class="input" name="defaultCurrency">
              <% const platformDefaultCurrency = selectCurrency(platformSettings.defaultCurrency || defaultCurrency, defaultCurrency) %>
              <% currencyOptions.forEach((currencyOption) => { %>
                <% const optionCode = String(currencyOption?.code || '').trim().toUpperCase() %>
                <% const optionName = String(currencyOption?.name || optionCode || 'Currency').trim() %>
                <option value="<%= optionCode %>" <%= platformDefaultCurrency === optionCode ? 'selected' : '' %>><%= optionCode %> - <%= optionName %></option>
              <% }) %>
            </select>
            <select class="input" name="defaultPaymentMode">
              <option value="free" <%= platformSettings.defaultPaymentMode === 'free' ? 'selected' : '' %>>free</option>
              <option value="paid" <%= platformSettings.defaultPaymentMode === 'paid' ? 'selected' : '' %>>paid</option>
            </select>
            <input class="input" type="number" name="minCoursePriceMinor" value="<%= platformSettings.minCoursePriceMinor || 0 %>" placeholder="Min price">
            <input class="input" type="number" name="maxCoursePriceMinor" value="<%= platformSettings.maxCoursePriceMinor || 50000000 %>" placeholder="Max price">
            <input type="hidden" name="requirePublicReviewForCreators" value="off">
            <label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="requirePublicReviewForCreators" <%= platformSettings.requirePublicReviewForCreators !== false ? 'checked' : '' %>> Require review before publish</label>
            <input type="hidden" name="maintenanceMode" value="off">
            <label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="maintenanceMode" <%= platformSettings.maintenanceMode ? 'checked' : '' %>> Maintenance mode</label>
            <textarea class="input" name="maintenanceMessage" rows="2" style="grid-column:1 / -1;" placeholder="Maintenance message"><%= platformSettings.maintenanceMessage || '' %></textarea>
            <input type="hidden" name="returnTo" value="<%= adminReturnToPath %>">
            <button class="btn btn-primary btn-sm" type="submit">Save Settings</button>
          </form>
        </section>

        <section class="card">
          <% const gatewaySettings = paymentGatewaySettings || {} %>
          <% const flutterwaveSettings = gatewaySettings.providers?.flutterwave || {} %>
          <% const paystackSettings = gatewaySettings.providers?.paystack || {} %>
          <% const gatewayDefaultProvider = gatewaySettings.defaultProvider || 'flutterwave' %>
          <div class="head"><div><h2>Payment Gateways</h2><p class="mini">Gateway toggles, default provider, and encrypted API key management.</p></div></div>
          <% if (!canManagePaymentGateways) { %>
            <p class="mini">Only <strong>super admin</strong> accounts can view and update gateway credentials.</p>
          <% } else { %>
            <% if (!credentialsEncryptionConfigured) { %>
              <div class="alert alert-error">CREDENTIALS_ENCRYPTION_KEY is not configured. Credential updates are blocked until encryption is configured.</div>
            <% } %>
            <form method="post" action="/simple-lms/settings/payment-gateways" class="form-grid">
              <input type="hidden" name="flutterwaveEnabled" value="off">
              <label style="display:flex;align-items:center;gap:8px;">
                <input type="checkbox" name="flutterwaveEnabled" value="on" <%= flutterwaveSettings.enabled ? 'checked' : '' %>>
                Enable Flutterwave
              </label>
              <input type="hidden" name="paystackEnabled" value="off">
              <label style="display:flex;align-items:center;gap:8px;">
                <input type="checkbox" name="paystackEnabled" value="on" <%= paystackSettings.enabled ? 'checked' : '' %>>
                Enable Paystack
              </label>
              <div>
                <label>Default Provider</label>
                <select class="input" name="defaultProvider">
                  <option value="flutterwave" <%= gatewayDefaultProvider === 'flutterwave' ? 'selected' : '' %>>Flutterwave</option>
                  <option value="paystack" <%= gatewayDefaultProvider === 'paystack' ? 'selected' : '' %>>Paystack</option>
                </select>
              </div>
              <div class="mini" style="display:flex;align-items:end;">At least one provider must remain enabled.</div>
              <input type="hidden" name="returnTo" value="<%= adminReturnToPath %>">
              <button class="btn btn-primary btn-sm" type="submit">Save Gateway Toggles</button>
            </form>

            <div class="grid">
              <article class="card">
                <strong>Flutterwave</strong>
                <div class="actions">
                  <span class="pill"><%= flutterwaveSettings.enabled ? 'Enabled' : 'Disabled' %></span>
                  <span class="pill"><%= flutterwaveSettings.statusLabel || (flutterwaveSettings.configured ? 'Configured' : 'Missing keys') %></span>
                </div>
                <p class="mini">Secret: <%= flutterwaveSettings.credentials?.secretKey?.masked || 'Not set' %></p>
                <p class="mini">Public: <%= flutterwaveSettings.credentials?.publicKey?.masked || 'Not set' %></p>
                <p class="mini">Webhook Hash: <%= flutterwaveSettings.credentials?.webhookHash?.masked || 'Not set' %></p>
                <form method="post" action="/simple-lms/settings/payment-gateways" class="stack">
                  <input class="input" type="password" name="password" placeholder="Confirm password to update keys">
                  <input class="input" type="text" name="flutterwaveSecretKey" placeholder="New Flutterwave secret key">
                  <input class="input" type="text" name="flutterwavePublicKey" placeholder="New Flutterwave public key">
                  <input class="input" type="text" name="flutterwaveWebhookHash" placeholder="New Flutterwave webhook hash">
                  <input type="hidden" name="returnTo" value="<%= adminReturnToPath %>">
                  <button class="btn btn-secondary btn-sm" type="submit">Update Flutterwave Keys</button>
                </form>
              </article>

              <article class="card">
                <strong>Paystack</strong>
                <div class="actions">
                  <span class="pill"><%= paystackSettings.enabled ? 'Enabled' : 'Disabled' %></span>
                  <span class="pill"><%= paystackSettings.statusLabel || (paystackSettings.configured ? 'Configured' : 'Missing keys') %></span>
                </div>
                <p class="mini">Secret: <%= paystackSettings.credentials?.secretKey?.masked || 'Not set' %></p>
                <p class="mini">Public: <%= paystackSettings.credentials?.publicKey?.masked || 'Not set' %></p>
                <p class="mini">Webhook URL: /api/simple-lms/payments/paystack/webhook</p>
                <form method="post" action="/simple-lms/settings/payment-gateways" class="stack">
                  <input class="input" type="password" name="password" placeholder="Confirm password to update keys">
                  <input class="input" type="text" name="paystackSecretKey" placeholder="New Paystack secret key">
                  <input class="input" type="text" name="paystackPublicKey" placeholder="New Paystack public key">
                  <input type="hidden" name="returnTo" value="<%= adminReturnToPath %>">
                  <button class="btn btn-secondary btn-sm" type="submit">Update Paystack Keys</button>
                </form>
              </article>
            </div>
          <% } %>
        </section>
      <% } %>

      <% if (currentSection === 'analytics') { %>
        <section class="card analytics-hero">
          <% const reportState = reportFilters || {} %>
          <% const reportQueryParts = [] %>
          <% if (reportState.from) reportQueryParts.push(`from=${encodeURIComponent(reportState.from)}`) %>
          <% if (reportState.to) reportQueryParts.push(`to=${encodeURIComponent(reportState.to)}`) %>
          <% if (reportState.lookbackDays) reportQueryParts.push(`lookbackDays=${encodeURIComponent(reportState.lookbackDays)}`) %>
          <% if (reportState.partnerOrganizationId) reportQueryParts.push(`partnerOrganization=${encodeURIComponent(reportState.partnerOrganizationId)}`) %>
          <% if (reportState.agentId) reportQueryParts.push(`agentId=${encodeURIComponent(reportState.agentId)}`) %>
          <% if (reportState.courseId) reportQueryParts.push(`courseId=${encodeURIComponent(reportState.courseId)}`) %>
          <% const reportQueryString = reportQueryParts.join('&') %>
          <% const salesExportHref = `/api/reports/sales/export${reportQueryString ? `?${reportQueryString}` : ''}` %>
          <% const commissionExportHref = `/api/reports/commissions/export${reportQueryString ? `?${reportQueryString}` : ''}` %>
          <div class="analytics-hero-top">
            <div>
              <h2>Analytics</h2>
              <p class="mini">Performance for the last <%= analytics.lookbackDays %> days, including revenue flow, partner impact, and churn signals.</p>
            </div>
            <div class="actions">
              <a class="btn btn-secondary btn-sm" href="<%= salesExportHref %>">Export Sales CSV</a>
              <a class="btn btn-secondary btn-sm" href="<%= commissionExportHref %>">Export Commissions CSV</a>
            </div>
          </div>
          <form method="get" action="/admin/analytics" class="analytics-filter-grid">
            <label>
              <span class="mini">From</span>
              <input class="input" type="date" name="reportFrom" value="<%= reportState.from || '' %>">
            </label>
            <label>
              <span class="mini">To</span>
              <input class="input" type="date" name="reportTo" value="<%= reportState.to || '' %>">
            </label>
            <label>
              <span class="mini">Lookback (days)</span>
              <input class="input" type="number" name="reportLookbackDays" min="1" max="365" value="<%= Number(reportState.lookbackDays || analytics.lookbackDays || 30) %>">
            </label>
            <label>
              <span class="mini">Partner scope</span>
              <select class="input" name="reportPartnerOrganization">
                <option value="">All partners</option>
                <% (partnerOrganizations || []).forEach((organization) => { %>
                  <option value="<%= organization._id %>" <%= String(reportState.partnerOrganizationId || '') === String(organization._id || '') ? 'selected' : '' %>><%= organization.name || 'Partner Organization' %></option>
                <% }) %>
              </select>
            </label>
            <label>
              <span class="mini">Agent ID</span>
              <input class="input" type="text" name="reportAgentId" value="<%= reportState.agentId || '' %>" placeholder="Optional">
            </label>
            <label>
              <span class="mini">Course ID</span>
              <input class="input" type="text" name="reportCourseId" value="<%= reportState.courseId || '' %>" placeholder="Optional">
            </label>
            <div class="actions">
              <button class="btn btn-primary btn-sm" type="submit">Apply Filters</button>
              <a class="btn btn-secondary btn-sm" href="/admin/analytics">Reset</a>
            </div>
          </form>
          <div class="analytics-summary-strip">
            <article class="analytics-stat"><span>Enrollments</span><strong><%= analytics.enrollmentTrend.current %></strong></article>
            <article class="analytics-stat"><span>Completions</span><strong><%= analytics.completionTrend.current %></strong></article>
            <article class="analytics-stat"><span>Payments</span><strong><%= analytics.paymentTrend.currentCount %></strong></article>
            <article class="analytics-stat"><span>Revenue</span><strong><%= analytics.paymentTrend.grossDisplay %></strong></article>
            <article class="analytics-stat"><span>Creator share</span><strong><%= moneyText(commissionReport?.summary?.creatorCommissionMinor || 0, 'NGN') %></strong></article>
            <article class="analytics-stat"><span>Agent share</span><strong><%= moneyText(commissionReport?.summary?.agentCommissionMinor || 0, 'NGN') %></strong></article>
          </div>
          <div class="analytics-top-grid">
            <article class="analytics-panel">
              <div class="analytics-panel-head">
                <div>
                  <h3>Top courses by enrollments</h3>
                  <p class="mini">Which catalog items are pulling the most learners.</p>
                </div>
              </div>
              <% if (!analytics.topCoursesByEnrollments || analytics.topCoursesByEnrollments.length === 0) { %>
                <p class="mini">No enrollment trend data.</p>
              <% } else { %>
                <div class="rank-list">
                  <% analytics.topCoursesByEnrollments.forEach((item) => { %>
                    <div class="rank-row">
                      <div class="rank-meta">
                        <strong><%= item.title %></strong>
                        <span><%= Number(item.enrollmentCount || 0) %> enrollments</span>
                      </div>
                      <div class="rank-bar"><span style="width:<%= calcBarWidth(item.enrollmentCount, topEnrollmentMax) %>;"></span></div>
                      <div class="rank-value"><%= Number(item.enrollmentCount || 0) %></div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </article>
            <article class="analytics-panel">
              <div class="analytics-panel-head">
                <div>
                  <h3>Top courses by revenue</h3>
                  <p class="mini">Revenue leaders inside the current reporting window.</p>
                </div>
              </div>
              <% if (!analytics.topCoursesByRevenue || analytics.topCoursesByRevenue.length === 0) { %>
                <p class="mini">No revenue trend data.</p>
              <% } else { %>
                <div class="rank-list">
                  <% analytics.topCoursesByRevenue.forEach((item) => { %>
                    <div class="rank-row">
                      <div class="rank-meta">
                        <strong><%= item.title %></strong>
                        <span><%= item.revenueDisplay %></span>
                      </div>
                      <div class="rank-bar"><span style="width:<%= calcBarWidth(item.revenueMinor, topRevenueMax) %>;"></span></div>
                      <div class="rank-value"><%= item.revenueDisplay %></div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </article>
            <article class="analytics-panel">
              <div class="analytics-panel-head">
                <div>
                  <h3>Top creators by revenue</h3>
                  <p class="mini">Who is generating the strongest creator-side performance.</p>
                </div>
              </div>
              <% if (!analytics.topCreatorsByRevenue || analytics.topCreatorsByRevenue.length === 0) { %>
                <p class="mini">No creator revenue data.</p>
              <% } else { %>
                <div class="rank-list">
                  <% analytics.topCreatorsByRevenue.forEach((item) => { %>
                    <div class="rank-row">
                      <div class="rank-meta">
                        <strong><%= item.creatorName %></strong>
                        <span><%= item.revenueDisplay %></span>
                      </div>
                      <div class="rank-bar"><span style="width:<%= calcBarWidth(item.revenueMinor, topCreatorRevenueMax) %>;"></span></div>
                      <div class="rank-value"><%= item.revenueDisplay %></div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </article>
          </div>
          <div class="analytics-focus-grid">
            <article class="analytics-panel">
              <div class="analytics-panel-head">
                <div>
                  <h3>Daily sales flow</h3>
                  <p class="mini">Date-indexed money flow across creator, platform, agent, and partner layers.</p>
                </div>
              </div>
              <div class="analytics-mini-grid">
                <div class="analytics-stat"><span>Sales</span><strong><%= Number(dailySalesReport?.summary?.saleCount || 0) %></strong></div>
                <div class="analytics-stat"><span>Gross</span><strong><%= dailySalesReport?.summary?.grossSalesDisplay || 'NGN 0.00' %></strong></div>
                <div class="analytics-stat"><span>Creator share</span><strong><%= dailySalesReport?.summary?.creatorCommissionDisplay || 'NGN 0.00' %></strong></div>
                <div class="analytics-stat"><span>Platform share</span><strong><%= dailySalesReport?.summary?.platformShareDisplay || 'NGN 0.00' %></strong></div>
                <div class="analytics-stat"><span>Agent share</span><strong><%= moneyText(dailySalesReport?.summary?.agentCommissionMinor || 0, 'NGN') %></strong></div>
                <div class="analytics-stat"><span>Partner earnings</span><strong><%= moneyText(dailySalesReport?.summary?.partnerEarningsMinor || 0, 'NGN') %></strong></div>
              </div>
              <% if (!dailySalesReport || !dailySalesReport.rows || dailySalesReport.rows.length === 0) { %>
                <p class="mini">No daily sales data for this filter window.</p>
              <% } else { %>
                <div class="analytics-table-shell">
                  <div class="table">
                    <table>
                      <thead>
                        <tr>
                          <th>Date</th>
                          <th>Sales</th>
                          <th>Gross</th>
                          <th>Creator</th>
                          <th>Platform</th>
                          <th>Agent</th>
                          <th>Partner</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% dailySalesReport.rows.forEach((entry) => { %>
                          <tr>
                            <td><%= entry.date %></td>
                            <td><%= Number(entry.saleCount || 0) %></td>
                            <td><%= entry.grossSalesDisplay || 'NGN 0.00' %></td>
                            <td><%= entry.creatorCommissionDisplay || 'NGN 0.00' %></td>
                            <td><%= entry.platformShareDisplay || 'NGN 0.00' %></td>
                            <td><%= entry.agentCommissionDisplay || 'NGN 0.00' %></td>
                            <td><%= entry.partnerEarningsDisplay || 'NGN 0.00' %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% } %>
            </article>
            <article class="analytics-panel">
              <div class="analytics-panel-head">
                <div>
                  <h3>Churn and payout signals</h3>
                  <p class="mini">Retention, agent performance, and commission exposure.</p>
                </div>
              </div>
              <div class="analytics-mini-grid">
                <div class="analytics-stat"><span>Active agents</span><strong><%= Number(churnMetrics?.activeAgents || 0) %></strong></div>
                <div class="analytics-stat"><span>Removed agents</span><strong><%= Number(churnMetrics?.removedAgents || 0) %></strong></div>
                <div class="analytics-stat"><span>Attrition</span><strong><%= Number(churnMetrics?.agentAttritionRatePercent || 0) %>%</strong></div>
                <div class="analytics-stat"><span>First sale</span><strong><%= Number(churnMetrics?.averageTimeToFirstSaleDays || 0) %>d</strong></div>
                <div class="analytics-stat"><span>At-risk learners</span><strong><%= Number(churnMetrics?.atRiskEnrollments || 0) %></strong></div>
                <div class="analytics-stat"><span>Drop-off</span><strong><%= Number(churnMetrics?.learnerDropOffRatePercent || 0) %>%</strong></div>
              </div>
              <ul class="analytics-note-list">
                <li>Commission report scope: <strong><%= commissionReport?.scope || 'platform' %></strong></li>
                <li>Total commission rows: <strong><%= Number(commissionReport?.summary?.saleCount || 0) %></strong></li>
                <li>Partner earnings in window: <strong><%= moneyText(commissionReport?.summary?.partnerEarningsMinor || 0, 'NGN') %></strong></li>
                <li>Agent commissions in window: <strong><%= moneyText(commissionReport?.summary?.agentCommissionMinor || 0, 'NGN') %></strong></li>
              </ul>
            </article>
          </div>
        </section>
    <% } %>
  </main>
  </div>
  <script>
    function initAdminBehaviors() {
      const tabGroups = document.querySelectorAll('[data-tab-group]')
      tabGroups.forEach((group) => {
        const triggers = Array.from(group.querySelectorAll('[data-tab-trigger]'))
        const panels = Array.from(group.querySelectorAll('[data-tab-panel]'))
        if (!triggers.length || !panels.length) return

        const activate = (name) => {
          triggers.forEach((trigger) => {
            const isActive = trigger.getAttribute('data-tab-trigger') === name
            trigger.classList.toggle('is-active', isActive)
            trigger.setAttribute('aria-selected', isActive ? 'true' : 'false')
          })
          panels.forEach((panel) => {
            const isActive = panel.getAttribute('data-tab-panel') === name
            panel.classList.toggle('is-active', isActive)
            panel.hidden = !isActive
          })
        }

        // Clean up old listeners by replacing the node (edge case for PJAX) if needed or just add
        triggers.forEach((trigger) => {
          trigger.onclick = () => activate(trigger.getAttribute('data-tab-trigger'))
        })

        const defaultTrigger = triggers.find((trigger) => trigger.classList.contains('is-active')) || triggers[0]
        activate(defaultTrigger.getAttribute('data-tab-trigger'))
      })

      const reviewForms = document.querySelectorAll('[data-course-review-form]')
      if (reviewForms.length) {
        reviewForms.forEach((form) => {
          const decisionInput = form.querySelector('[data-review-decision-input]')
          const notesInput = form.querySelector('[data-review-notes]')
          const buttons = form.querySelectorAll('[data-review-submit]')
          if (!buttons.length) return

          buttons.forEach((button) => {
            button.onclick = (event) => {
              const decision = String(button.getAttribute('data-review-submit') || '').trim().toLowerCase()
              if (decisionInput) decisionInput.value = decision
              if (!notesInput) return

              const requiresNotes = decision !== 'approved'
              notesInput.required = requiresNotes
              if (requiresNotes && !String(notesInput.value || '').trim()) {
                event.preventDefault()
                notesInput.reportValidity()
                notesInput.focus()
              }
            }
          })
        })
      }
    }

    // Initialize on first paint
    initAdminBehaviors();

    // The SPA Router (PJAX)
    document.addEventListener('click', async (e) => {
      const link = e.target.closest('a');
      if (!link) return;
      
      // Standard click validation
      if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
      
      const url = new URL(link.href, window.location.origin);
      
      // Only internal admin routes
      if (url.origin !== window.location.origin || !url.pathname.startsWith('/admin')) return;
      if (link.target === '_blank' || link.hasAttribute('download')) return;

      e.preventDefault();
      
      if (url.href === window.location.href) return;

      // Loading state (Top Progress Bar & Layout Fade)
      let loader = document.getElementById('spa-global-loader');
      if (!loader) {
        loader = document.createElement('div');
        loader.id = 'spa-global-loader';
        loader.style.cssText = 'position:fixed; top:0; left:0; height:3px; background:#a855f7; z-index:9999; width:0; transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s; opacity:0; pointer-events:none; box-shadow: 0 0 12px rgba(168, 85, 247, 0.8);';
        document.body.appendChild(loader);
      }
      
      loader.style.opacity = '1';
      loader.style.width = '20%';

      let progress = 20;
      const progressInterval = setInterval(() => {
        progress += (90 - progress) * 0.1;
        loader.style.width = progress + '%';
      }, 100);

      const layout = document.querySelector('.layout');
      if (layout) {
        layout.style.transition = 'opacity 0.2s ease';
        layout.style.opacity = '0.5';
        layout.style.pointerEvents = 'none';
      }

      try {
        const res = await fetch(url.href, { headers: { 'X-PJAX': 'true' } });
        if (!res.ok) {
          window.location.href = url.href;
          return;
        }

        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        
        clearInterval(progressInterval);
        loader.style.width = '100%';

        // Push State
        window.history.pushState({}, '', url.href);
        document.title = doc.title;

        // Replace layout contents seamlessly
        const newLayout = doc.querySelector('.layout');
        if (newLayout && layout) {
          layout.innerHTML = newLayout.innerHTML;
          layout.style.opacity = '1';
          layout.style.pointerEvents = 'auto';
          
          // Re-mount JS behaviors
          initAdminBehaviors();
          
          window.scrollTo(0, 0);
        } else {
          window.location.href = url.href;
        }

        // Hide loader gracefully
        setTimeout(() => {
          loader.style.opacity = '0';
          setTimeout(() => { loader.style.width = '0'; }, 200);
        }, 300);

      } catch (err) {
        console.error('SPA Navigation failed:', err);
        window.location.href = url.href;
      }
    });

    // Handle back/forward gracefully
    window.addEventListener('popstate', async () => {
      window.location.reload();
    });
  </script>
</body>
</html>

