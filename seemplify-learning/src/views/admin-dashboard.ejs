<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=3"></script>
  <style>
    :root {
      --admin-surface: rgba(255, 255, 255, 0.9);
      --admin-surface-strong: #ffffff;
      --admin-border: rgba(109, 40, 217, 0.12);
      --admin-border-strong: rgba(124, 58, 237, 0.18);
      --admin-text: #1c1235;
      --admin-muted: #665788;
      --admin-nav-bg: #2a1450;
      --admin-nav-border: rgba(196, 181, 253, 0.22);
      --admin-accent: #8b5cf6;
      --admin-accent-strong: #6d28d9;
    }
    html, body {
      width: 100%;
      min-height: 100%;
      margin: 0;
      padding: 0;
    }
    body.admin-page {
      margin: 0 !important;
      padding: 0 !important;
      max-width: none !important;
      min-height: 100vh;
      color: var(--admin-text);
      font-family: "IBM Plex Sans", "Segoe UI", Tahoma, sans-serif;
      background:
        radial-gradient(circle at 90% 8%, rgba(168, 85, 247, 0.12), transparent 34%),
        radial-gradient(circle at 8% 22%, rgba(124, 58, 237, 0.1), transparent 28%),
        #f4edff;
      overflow-x: hidden;
      letter-spacing: -0.01em;
    }
    body.admin-page::before,
    body.admin-page::after {
      content: none;
      display: none;
    }
    .layout {
      width: 100%;
      max-width: none;
      margin: 0;
      min-height: 100vh;
      display: grid;
      grid-template-columns: 320px minmax(0, 1fr);
      gap: 0;
    }
    .side {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: auto;
      display: grid;
      grid-template-rows: auto auto 1fr auto;
      gap: 14px;
      padding: 18px 16px 16px;
      color: #cbd5e1;
      background:
        radial-gradient(circle at 14% 8%, rgba(168, 85, 247, 0.24), transparent 34%),
        radial-gradient(circle at 94% 86%, rgba(76, 29, 149, 0.22), transparent 40%),
        linear-gradient(180deg, #241046 0%, #2f165b 52%, #1f123d 100%);
      border-right: 1px solid rgba(148, 163, 184, 0.18);
      box-shadow: 12px 0 28px -30px rgba(2, 6, 23, 0.96);
      z-index: 5;
    }
    .side::after {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      width: 1px;
      height: 100%;
      background: linear-gradient(to bottom, rgba(148, 163, 184, 0.02), rgba(148, 163, 184, 0.4), rgba(148, 163, 184, 0.02));
      pointer-events: none;
    }
    .side-head {
      border: 1px solid rgba(148, 163, 184, 0.28);
      border-radius: 16px;
      padding: 14px 13px;
      background: linear-gradient(150deg, rgba(30, 41, 59, 0.58), rgba(15, 23, 42, 0.32));
      display: grid;
      gap: 6px;
      box-shadow: inset 0 0 0 1px rgba(191, 219, 254, 0.05);
    }
    .side-kicker {
      margin: 0;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #d8b4fe;
    }
    .side h1 {
      margin: 0;
      font-size: 21px;
      letter-spacing: -0.02em;
      color: #f8fafc;
      line-height: 1.1;
    }
    .side-head p {
      margin: 0;
      font-size: 12px;
      color: #94a3b8;
      line-height: 1.45;
    }
    .side-profile {
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 14px;
      padding: 11px 12px;
      background: rgba(2, 6, 23, 0.26);
      display: grid;
      gap: 4px;
    }
    .side-profile-label {
      margin: 0;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #94a3b8;
      font-weight: 700;
    }
    .side-profile strong {
      font-size: 13px;
      color: #f8fafc;
      font-weight: 700;
      line-height: 1.2;
      word-break: break-word;
    }
    .side-profile span {
      color: #cbd5e1;
      font-size: 11px;
      line-height: 1.35;
      word-break: break-word;
    }
    .side-profile .side-role {
      width: fit-content;
      margin-top: 2px;
      border: 1px solid rgba(196, 181, 253, 0.4);
      border-radius: 999px;
      padding: 2px 8px;
      color: #f3e8ff;
      background: rgba(124, 58, 237, 0.24);
      text-transform: capitalize;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.05em;
    }
    .side nav {
      display: grid;
      gap: 10px;
      align-content: start;
    }
    .side-nav-group {
      display: grid;
      gap: 7px;
      padding: 8px;
      border: 1px solid var(--admin-nav-border);
      border-radius: 14px;
      background: rgba(15, 23, 42, 0.28);
    }
    .side-nav-group-title {
      margin: 0 0 2px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.11em;
      color: #64748b;
      font-weight: 700;
      padding: 0 4px;
    }
    .side nav a {
      color: #cbd5e1;
      text-decoration: none;
      padding: 11px 10px 11px 12px;
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 11px;
      font-size: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      background: rgba(15, 23, 42, 0.38);
      transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }
    .side nav a::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.5);
      box-shadow: 0 0 0 3px rgba(30, 41, 59, 0.8);
      flex: 0 0 auto;
      transition: background 0.18s ease, box-shadow 0.18s ease;
    }
    .side nav a:hover {
      border-color: rgba(196, 181, 253, 0.5);
      background: rgba(30, 41, 59, 0.56);
      transform: translateX(2px);
      color: #f8fafc;
      box-shadow: 0 10px 24px -20px rgba(124, 58, 237, 0.75);
    }
    .side nav a:hover::before {
      background: rgba(216, 180, 254, 0.95);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.34);
    }
    .side nav a .label {
      font-weight: 650;
      letter-spacing: 0.01em;
      margin-right: auto;
      line-height: 1.2;
    }
    .side nav a .meta {
      border: 1px solid rgba(148, 163, 184, 0.3);
      border-radius: 999px;
      padding: 2px 8px;
      font-size: 10px;
      color: #94a3b8;
      background: rgba(15, 23, 42, 0.58);
      white-space: nowrap;
      font-weight: 700;
      letter-spacing: 0.03em;
    }
    .side nav a.active {
      border-color: rgba(196, 181, 253, 0.58);
      color: #ffffff;
      background: linear-gradient(130deg, rgba(124, 58, 237, 0.36), rgba(36, 16, 70, 0.96));
      box-shadow: 0 14px 30px -24px rgba(124, 58, 237, 0.82);
    }
    .side nav a.active::before {
      background: rgba(243, 232, 255, 1);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.42);
    }
    .side nav a.active .meta {
      border-color: rgba(196, 181, 253, 0.52);
      color: #f3e8ff;
      background: rgba(124, 58, 237, 0.28);
    }
    .side .actions {
      border-top: 1px solid rgba(148, 163, 184, 0.24);
      padding-top: 12px;
      display: grid;
      gap: 8px;
    }
    .side .actions .btn {
      width: 100%;
      justify-content: center;
      border-radius: 11px;
      min-height: 38px;
      font-weight: 700;
      letter-spacing: 0.01em;
    }
    .main {
      min-width: 0;
      padding: 18px 20px 24px;
      display: grid;
      gap: 14px;
      align-content: start;
    }
    .card {
      background: var(--admin-surface);
      border: 1px solid var(--admin-border);
      border-radius: 16px;
      padding: 14px;
      display: grid;
      gap: 10px;
      box-shadow: 0 14px 32px -30px rgba(15, 23, 42, 0.45);
      backdrop-filter: blur(8px);
    }
    .admin-tab-shell {
      display: grid;
      gap: 12px;
    }
    .admin-tab-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 6px;
      border: 1px solid var(--admin-border);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.72);
    }
    .admin-tab {
      appearance: none;
      border: 1px solid rgba(139, 92, 246, 0.12);
      background: rgba(124, 58, 237, 0.04);
      color: var(--admin-muted);
      border-radius: 999px;
      padding: 10px 14px;
      font: inherit;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.01em;
      cursor: pointer;
      transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
    }
    .admin-tab:hover {
      border-color: rgba(139, 92, 246, 0.24);
      background: rgba(124, 58, 237, 0.08);
      color: var(--admin-text);
    }
    .admin-tab.is-active {
      border-color: rgba(124, 58, 237, 0.28);
      background: linear-gradient(135deg, rgba(124, 58, 237, 0.16), rgba(196, 181, 253, 0.14));
      color: var(--admin-accent-strong);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.6);
    }
    .admin-tab-panel[hidden] {
      display: none !important;
    }
    .admin-tab-panel {
      display: grid;
      gap: 12px;
      align-content: start;
    }
    .admin-tab-intro {
      margin: 0;
      color: var(--admin-muted);
      font-size: 12px;
      line-height: 1.5;
    }
    .page-header {
      background: linear-gradient(130deg, rgba(255, 255, 255, 0.95), rgba(244, 249, 255, 0.84));
      border-color: var(--admin-border-strong);
      position: relative;
    }
    .page-header::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      border-radius: 16px 16px 0 0;
      background: linear-gradient(90deg, var(--admin-accent-strong), #8b5cf6, #c084fc);
      opacity: 0.95;
    }
    .head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: end;
      flex-wrap: wrap;
    }
    h2 {
      margin: 0;
      font-size: 30px;
      line-height: 1.05;
      letter-spacing: -0.03em;
      color: var(--admin-text);
      font-family: "Space Grotesk", "IBM Plex Sans", sans-serif;
    }
    .mini {
      margin: 0;
      color: var(--admin-muted);
      font-size: 12px;
      line-height: 1.5;
    }
    .kpis {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
      gap: 9px;
    }
    .kpi {
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      padding: 10px;
      background: var(--admin-surface-strong);
      box-shadow: inset 0 0 0 1px rgba(203, 213, 225, 0.35);
    }
    .kpi small {
      display: block;
      color: var(--admin-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 10px;
      font-weight: 700;
    }
    .kpi strong {
      font-size: 22px;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 10px;
    }
    .table {
      overflow: auto;
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      background: #ffffff;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 900px;
      font-size: 12px;
    }
    th, td {
      border-bottom: 1px solid #e2e8f0;
      padding: 9px 10px;
      text-align: left;
      vertical-align: top;
      color: #0f172a;
    }
    th {
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 10px;
      background: #f5f9ff;
      font-weight: 700;
      position: sticky;
      top: 0;
      z-index: 1;
    }
    tbody tr:nth-child(2n) td {
      background: rgba(248, 250, 252, 0.52);
    }
    tbody tr:hover td {
      background: rgba(219, 234, 254, 0.22);
    }
    tbody tr:last-child td {
      border-bottom: 0;
    }
    .pill {
      border: 1px solid #cbd5e1;
      border-radius: 999px;
      padding: 2px 7px;
      font-size: 10px;
      text-transform: uppercase;
      background: #f8fafc;
      color: #334155;
      font-weight: 700;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }
    .inline-form {
      display: inline-flex;
      gap: 6px;
      align-items: center;
      margin: 0;
      flex-wrap: wrap;
    }
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 8px;
      align-items: end;
    }
    .admin-page .input {
      border: 1px solid #cfd9e8;
      border-radius: 10px;
      background: #ffffff;
      min-height: 38px;
      color: #0f172a;
      padding: 8px 10px;
    }
    .quick-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 8px;
    }
    .quick-link {
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      padding: 11px;
      text-decoration: none;
      color: #0f172a;
      background: #f8fbff;
      display: grid;
      gap: 4px;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .quick-link:hover {
      border-color: rgba(124, 58, 237, 0.22);
      transform: translateY(-1px);
      box-shadow: 0 12px 24px -24px rgba(2, 6, 23, 0.6);
      background: #ffffff;
    }
    .quick-link strong {
      font-size: 15px;
      letter-spacing: -0.01em;
    }
    .quick-link span {
      font-size: 12px;
      color: var(--admin-muted);
      line-height: 1.45;
    }
    .course-management-card {
      gap: 12px;
    }
    .course-mgmt-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 8px;
    }
    .course-mgmt-chip {
      border: 1px solid rgba(109, 40, 217, 0.12);
      border-radius: 12px;
      padding: 8px 10px;
      background: linear-gradient(180deg, #ffffff 0%, #faf5ff 100%);
      display: grid;
      gap: 2px;
    }
    .course-mgmt-chip span {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
      font-weight: 700;
    }
    .course-mgmt-chip strong {
      font-size: 18px;
      line-height: 1.2;
      color: #0f172a;
      letter-spacing: -0.02em;
    }
    .course-filter-grid {
      padding: 10px;
      border: 1px solid #dbe5f2;
      border-radius: 12px;
      background: rgba(248, 250, 252, 0.8);
    }
    .course-context-note {
      padding: 8px 10px;
      border: 1px dashed #c6d4ea;
      border-radius: 10px;
      background: rgba(239, 246, 255, 0.58);
      width: fit-content;
      max-width: 100%;
    }
    .course-table-wrap {
      border-color: #d4e1f1;
      border-radius: 14px;
      box-shadow: inset 0 0 0 1px rgba(219, 234, 254, 0.35);
    }
    .course-management-table {
      width: 100%;
      min-width: 780px;
      table-layout: auto;
    }
    .course-management-table th:nth-child(1) { min-width: 250px; }
    .course-management-table th:nth-child(2) { min-width: 170px; }
    .course-management-table th:nth-child(3),
    .course-management-table th:nth-child(4),
    .course-management-table th:nth-child(5),
    .course-management-table th:nth-child(6),
    .course-management-table th:nth-child(7) { min-width: 98px; }
    .course-title-cell strong {
      display: block;
      font-size: 13px;
      line-height: 1.28;
      margin-bottom: 2px;
    }
    .course-summary {
      display: block;
      color: #60748f;
      font-size: 12px;
      line-height: 1.42;
      max-width: 56ch;
      margin-bottom: 2px;
    }
    .course-cell-meta {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 6px;
    }
    .course-cell-meta .pill {
      font-size: 9px;
      padding: 2px 7px;
      text-transform: none;
      background: #f8fbff;
      border-color: #dbe7f5;
      color: #475569;
    }
    .course-creator-cell a {
      font-weight: 700;
      color: #1e3a8a;
      text-decoration: none;
    }
    .course-creator-cell a:hover {
      text-decoration: underline;
    }
    .course-management-table .course-row-main td {
      border-bottom: 0;
      background: #ffffff;
    }
    .course-management-table .course-action-row td {
      padding-top: 8px;
      padding-bottom: 11px;
      border-top: 1px dashed #dbe7f5;
      border-bottom: 1px solid #e2e8f0;
      background: #f8fbff;
    }
    .course-actions-wrap {
      display: grid;
      gap: 8px;
    }
    .course-actions-label {
      margin: 0;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
      font-weight: 700;
    }
    .course-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      width: 100%;
    }
    .course-actions > a,
    .course-actions > form {
      margin: 0;
    }
    .course-actions > a.btn {
      display: inline-flex;
    }
    .course-actions .inline-form {
      display: inline-flex;
      width: auto;
      margin: 0;
    }
    .course-actions .btn {
      width: auto;
      justify-content: center;
      min-height: 34px;
      border-radius: 10px;
      white-space: nowrap;
    }
    .course-page-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }
    .course-studio-note {
      padding: 9px 10px;
      border: 1px dashed #c8d7ea;
      border-radius: 10px;
      background: rgba(239, 246, 255, 0.64);
    }
    .course-compose-shell {
      border: 1px solid #d4e1f1;
      border-radius: 14px;
      background: #ffffff;
      box-shadow: inset 0 0 0 1px rgba(219, 234, 254, 0.28);
      overflow: hidden;
    }
    .course-compose-shell > summary {
      list-style: none;
      cursor: pointer;
      padding: 12px 14px;
      font-weight: 700;
      font-size: 14px;
      color: #0f172a;
      background: linear-gradient(180deg, #f8fbff 0%, #f0f6ff 100%);
      border-bottom: 1px solid transparent;
    }
    .course-compose-shell[open] > summary {
      border-bottom-color: #dbe7f5;
    }
    .course-compose-shell > summary::-webkit-details-marker {
      display: none;
    }
    .course-compose-body {
      padding: 12px;
      display: grid;
      gap: 10px;
    }
    .course-compose-form {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 8px;
      align-items: end;
    }
    .course-compose-full {
      grid-column: 1 / -1;
    }
    .course-management-shell {
      gap: 14px;
    }
    .course-mode-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .course-mode-card {
      text-decoration: none;
      color: var(--admin-text);
      border: 1px solid #ddd6fe;
      border-radius: 16px;
      padding: 16px;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(245, 243, 255, 0.92));
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.55);
      display: grid;
      gap: 8px;
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .course-mode-card:hover {
      transform: translateY(-1px);
      border-color: rgba(109, 40, 217, 0.28);
      box-shadow: 0 16px 28px -28px rgba(109, 40, 217, 0.58);
    }
    .course-mode-card.active {
      border-color: rgba(109, 40, 217, 0.34);
      background: linear-gradient(145deg, rgba(245, 243, 255, 0.98), rgba(237, 233, 254, 0.92));
      box-shadow: 0 18px 30px -30px rgba(109, 40, 217, 0.64);
    }
    .course-mode-card small {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #7c3aed;
    }
    .course-mode-card strong {
      font-size: 18px;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }
    .course-mode-card span {
      font-size: 13px;
      line-height: 1.5;
      color: #665788;
    }
    .course-overview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 10px;
    }
    .course-overview-card {
      border: 1px solid #e5ddff;
      border-radius: 14px;
      padding: 12px;
      background: rgba(255, 255, 255, 0.88);
      display: grid;
      gap: 4px;
    }
    .course-overview-card small {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #7c3aed;
    }
    .course-overview-card strong {
      font-size: 24px;
      line-height: 1;
