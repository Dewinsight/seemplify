<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/public-lms.css?v=20260304-2">
  <link rel="stylesheet" href="/css/public-lms-refresh.css?v=20260319-1">
  <script src="/js/theme.js?v=3"></script>
</head>
<body class="public-site">
  <%- include('./partials/nav', { user, activePage, activeLmsView: '' }) %>

  <% const takePath = `/simple-lms/take/${course._id}` %>
  <% const persistedReferralCode = typeof referralCode === 'string' ? referralCode : '' %>
  <% const persistedSellingOrganizationId = typeof sellingOrganizationId === 'string' ? sellingOrganizationId : '' %>
  <% const serverDetailPath = (typeof detailPath === 'string' && detailPath) ? detailPath : '' %>
  <% const fallbackDetailParams = [] %>
  <% if (persistedReferralCode) fallbackDetailParams.push(`ref=${encodeURIComponent(persistedReferralCode)}`) %>
  <% if (persistedSellingOrganizationId) fallbackDetailParams.push(`org=${encodeURIComponent(persistedSellingOrganizationId)}`) %>
  <% const resolvedDetailPath = serverDetailPath || `/courses/${course._id}${course.slug ? `/${course.slug}` : ''}${fallbackDetailParams.length ? `?${fallbackDetailParams.join('&')}` : ''}` %>
  <% const courseHref = (entry) => {
    const params = []
    if (persistedReferralCode) params.push(`ref=${encodeURIComponent(persistedReferralCode)}`)
    if (persistedSellingOrganizationId) params.push(`org=${encodeURIComponent(persistedSellingOrganizationId)}`)
    return `/courses/${entry._id}${entry.slug ? `/${entry.slug}` : ''}${params.length ? `?${params.join('&')}` : ''}`
  } %>
  <% const learnLoginHref = `/login?return_to=${encodeURIComponent(takePath)}` %>
  <% const registerToLearnHref = `/register?return_to=${encodeURIComponent(takePath)}&intent=learn&source=course_detail` %>
  <% const isPreviewMode = typeof previewMode !== 'undefined' && Boolean(previewMode) %>
  <% const resolvedPreviewReturnTo = typeof previewReturnTo === 'string' ? previewReturnTo : '' %>
  <% const resolvedPreviewStatusLabel = typeof previewStatusLabel === 'string' ? previewStatusLabel : '' %>
  <% const resolvedPreviewVisibilityLabel = typeof previewVisibilityLabel === 'string' ? previewVisibilityLabel : '' %>
  <% const resolvedPreviewEditUrl = typeof previewEditUrl === 'string' ? previewEditUrl : '' %>
  <% const backHref = isPreviewMode ? (resolvedPreviewReturnTo || '/simple-lms/studio/courses') : '/courses' %>
  <% const backLabel = isPreviewMode ? 'Back to Workspace' : 'Back to Catalog' %>
  <% const reviewSummary = courseReviewSummary || course.reviewSummary || { ratingAverage: 0, ratingAverageLabel: '0.0', ratingCount: 0, commentCount: 0, hasRatings: false, hasComments: false, roundedStarCount: 0 } %>
  <% const visibleCourseReviews = Array.isArray(recentCourseReviews) ? recentCourseReviews : [] %>
  <% const courseReviewAction = `/simple-lms/courses/${course._id}/reviews` %>
  <%
    const formatDuration = (minutes) => {
      const total = Number.isFinite(Number(minutes)) ? Number(minutes) : 0
      if (total >= 60) {
        const hours = Math.floor(total / 60)
        const remain = total % 60
        return remain > 0 ? `${hours}h ${remain}m` : `${hours}h`
      }
      return `${Math.max(0, Math.round(total))}m`
    }
    const fallbackCourseVisuals = [
      'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80'
    ]
    const categoryVisualHints = [
      { match: ['data', 'analytics', 'ai', 'machine', 'science'], image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=80' },
      { match: ['project', 'management', 'leadership', 'business'], image: 'https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80' },
      { match: ['communication', 'professional', 'soft'], image: 'https://images.unsplash.com/photo-1573497019236-61f323342eb1?auto=format&fit=crop&w=1200&q=80' },
      { match: ['engineering', 'dev', 'code', 'software'], image: 'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=1200&q=80' }
    ]
    const courseImageFor = (entry, index) => {
      if (entry?.banner?.url) return entry.banner.url
      const normalizedCategory = String(entry?.category || '').toLowerCase()
      const match = categoryVisualHints.find((e) => e.match.some((term) => normalizedCategory.includes(term)))
      if (match?.image) return match.image
      return fallbackCourseVisuals[index % fallbackCourseVisuals.length]
    }
  %>

  <main class="lmsv-shell">
    <section class="lmsv-surface-card" style="padding:10px 16px;">
      <a href="<%= backHref %>" class="btn btn-secondary btn-sm" style="width:fit-content;"><%= backLabel %></a>
    </section>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (info) { %><div class="alert"><%= info %></div><% } %>
    <% if (isPreviewMode) { %>
      <div class="alert">
        Preview mode: this course is not fully public yet.
        Status: <strong><%= resolvedPreviewStatusLabel || course.status || 'draft' %></strong>.
        Visibility: <strong><%= resolvedPreviewVisibilityLabel || course.visibilityDisplay || 'private' %></strong>.
      </div>
    <% } %>

    <section class="lmsv-detail-hero">
      <p class="lmsv-kicker">Course Detail</p>
      <h1><%= course.title %></h1>
      <div class="lmsv-pill-row">
        <span><%= course.levelLabel %></span>
        <% if (course.category) { %><span><%= course.category %></span><% } %>
        <span><%= course.lessonCount %> lessons</span>
        <span><%= formatDuration(course.estimatedDurationMinutes) %></span>
        <% if (reviewSummary.hasRatings) { %>
          <span><%= `${reviewSummary.ratingAverageLabel}/5 Â· ${reviewSummary.ratingCount} rating${reviewSummary.ratingCount === 1 ? '' : 's'}` %></span>
        <% } %>
      </div>
      <p><%= course.previewSummary %></p>
    </section>

    <section class="lmsv-detail-layout">
      <div class="lmsv-detail-main">
        <% if (course.banner?.url) { %>
          <article class="lmsv-detail-banner">
            <img src="<%= course.banner.url %>" alt="<%= course.title %> banner">
          </article>
        <% } %>

        <% if (course.description) { %>
          <article class="lmsv-detail-card">
            <h3>About This Course</h3>
            <p class="lmsv-detail-note"><%= course.description %></p>
          </article>
        <% } %>
        <article class="lmsv-detail-card">
          <h3>Course Outline</h3>
          <% if (!chapters || chapters.length === 0) { %>
            <p class="lmsv-detail-note">Curriculum details will appear here when chapters are published.</p>
          <% } else { %>
            <div class="lmsv-outline-list">
              <% chapters.forEach((chapter, index) => { %>
                <section class="lmsv-outline-item">
                  <h4><%= index + 1 %>. <%= chapter.title %></h4>
                  <% if (chapter.description) { %>
                    <p><%= chapter.description %></p>
                  <% } %>
                  <% if (chapter.lessons && chapter.lessons.length > 0) { %>
                    <ol class="lmsv-outline-lessons">
                      <% chapter.lessons.forEach((lesson) => { %>
                        <li>
                          <%= lesson.title %>
                          <% if (lesson.durationMinutes > 0) { %>
                            (<%= lesson.durationMinutes %> min)
                          <% } %>
                        </li>
                      <% }) %>
                    </ol>
                  <% } %>
                </section>
              <% }) %>
            </div>
          <% } %>
        </article>


        <% if (courseCommentsEnabled && !isPreviewMode) { %>
          <article class="lmsv-detail-card lmsv-review-panel">
            <div class="lmsv-review-panel-head">
              <div>
                <h3>Ratings & Comments</h3>
                <p class="lmsv-detail-note">Learners who have started this course can rate it and leave feedback. Creator responses appear below each published review.</p>
              </div>
              <div class="lmsv-review-score-card">
                <strong><%= reviewSummary.ratingAverageLabel %></strong>
                <div class="lmsv-review-stars" aria-label="<%= `${reviewSummary.ratingAverageLabel} out of 5` %>">
                  <% for (let star = 1; star <= 5; star += 1) { %>
                    <span class="<%= star <= (reviewSummary.roundedStarCount || 0) ? 'active' : '' %>">&#9733;</span>
                  <% } %>
                </div>
                <span><%= reviewSummary.ratingCount > 0 ? `${reviewSummary.ratingCount} rating${reviewSummary.ratingCount === 1 ? '' : 's'}` : 'No ratings yet' %></span>
              </div>
            </div>

            <div class="lmsv-review-grid">
              <div class="lmsv-review-form-wrap">
                <% if (canSubmitCourseReview) { %>
                  <form method="post" action="<%= courseReviewAction %>" class="lmsv-review-form">
                    <input type="hidden" name="returnTo" value="<%= resolvedDetailPath %>">
                    <div class="lmsv-review-rating-group">
                      <span class="lmsv-review-label">Your rating</span>
                      <div class="lmsv-review-rating-options">
                        <% for (let star = 5; star >= 1; star -= 1) { %>
                          <label class="lmsv-review-rating-option">
                            <input type="radio" name="rating" value="<%= star %>" <%= Number(existingCourseReview?.rating || 0) === star ? 'checked' : '' %>>
                            <span><%= `${star} star${star === 1 ? '' : 's'}` %></span>
                          </label>
                        <% } %>
                      </div>
                    </div>
                    <label class="lmsv-review-field">
                      <span class="lmsv-review-label">Comment</span>
                      <textarea class="input" name="comment" rows="5" maxlength="1200" placeholder="What stood out, what could be clearer, or what other learners should expect."><%= existingCourseReview?.comment || '' %></textarea>
                    </label>
                    <% if (existingCourseReview?.moderationStatus === 'hidden') { %>
                      <div class="lmsv-review-owner-note">
                        Your current review is hidden from public view by the admin team. You can still update it here.
                      </div>
                    <% } %>
                    <div class="lmsv-review-form-foot">
                      <span class="lmsv-detail-note"><%= existingCourseReview ? 'You can update your existing course review at any time.' : 'You can leave a rating after you start learning.' %></span>
                      <button type="submit" class="btn btn-primary btn-sm"><%= existingCourseReview ? 'Update Review' : 'Submit Review' %></button>
                    </div>
                  </form>
                <% } else if (user) { %>
                  <div class="lmsv-review-empty">
                    <strong>Start the course to review it</strong>
                    <p>Only learners with an active enrollment can leave ratings and comments.</p>
                  </div>
                <% } else { %>
                  <div class="lmsv-review-empty">
                    <strong>Login to join the conversation</strong>
                    <p>Create an account and start the course before leaving a review.</p>
                    <div class="lmsv-review-actions">
                      <a href="<%= learnLoginHref %>" class="btn btn-primary btn-sm">Login</a>
                      <a href="<%= registerToLearnHref %>" class="btn btn-secondary btn-sm">Create Account</a>
                    </div>
                  </div>
                <% } %>
              </div>

              <div class="lmsv-review-list-wrap">
                <% if (visibleCourseReviews.length > 0) { %>
                  <div class="lmsv-review-list">
                    <% visibleCourseReviews.forEach((review) => { %>
                      <article class="lmsv-review-item">
                        <div class="lmsv-review-item-head">
                          <div>
                            <strong><%= review.authorName %></strong>
                            <span><%= review.updatedAtLabel || review.createdAtLabel || '' %><%= review.isEdited ? ' · edited' : '' %></span>
                          </div>
                          <div class="lmsv-review-stars" aria-hidden="true">
                            <% for (let star = 1; star <= 5; star += 1) { %>
                              <span class="<%= star <= Number(review.rating || 0) ? 'active' : '' %>">&#9733;</span>
                            <% } %>
                          </div>
                        </div>
                        <p class="lmsv-review-text"><%= review.comment || 'Left a rating without a written comment.' %></p>
                        <% if (review.hasCreatorReply) { %>
                          <div class="lmsv-review-response">
                            <div class="lmsv-review-response-head">
                              <strong><%= review.creatorReplyByName || 'Course creator' %></strong>
                              <span><%= review.creatorReplyUpdatedAtLabel ? `Responded ${review.creatorReplyUpdatedAtLabel}` : 'Creator response' %></span>
                            </div>
                            <p class="lmsv-review-response-text"><%= review.creatorReply %></p>
                          </div>
                        <% } %>
                      </article>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="lmsv-review-empty">
                    <strong>No comments yet</strong>
                    <p>Be the first learner to leave feedback on this course.</p>
                  </div>
                <% } %>
              </div>
            </div>
          </article>
        <% } %>

        <% if (relatedCourses && relatedCourses.length > 0) { %>
          <section class="lmsv-section">
            <header class="lmsv-section-head">
              <div>
                <h2>Related Courses</h2>
                <p>Continue with similar topics after this course.</p>
              </div>
              <span class="lmsv-count-pill"><%= relatedCourses.length %> related</span>
            </header>
            <div class="lmsv-course-grid">
              <% relatedCourses.forEach((entry, idx) => { %>
                <article class="lmsv-course-card">
                  <a href="<%= courseHref(entry) %>" class="lmsv-course-media">
                    <img src="<%= courseImageFor(entry, idx) %>" alt="<%= entry.title %> banner">
                    <span class="lmsv-level-pill"><%= entry.levelLabel %></span>
                  </a>
                  <div class="lmsv-course-body">
                    <div class="lmsv-pill-row lmsv-pill-row-muted">
                      <% if (entry.category) { %><span><%= entry.category %></span><% } %>
                      <span><%= entry.lessonCount %> lessons</span>
                    </div>
                    <h3><a href="<%= courseHref(entry) %>"><%= entry.title %></a></h3>
                    <p><%= entry.previewSummary %></p>
                    <div class="lmsv-course-foot">
                      <span class="lmsv-price-tag"><%= entry.displayPrice %></span>
                      <a href="<%= courseHref(entry) %>" class="lmsv-inline-link">View Details &rarr;</a>
                    </div>
                  </div>
                </article>
              <% }) %>
            </div>
          </section>
        <% } %>
      </div>

      <aside class="lmsv-detail-side">
        <article class="lmsv-detail-card">
          <p class="lmsv-detail-cta-price"><%= course.displayPrice %></p>
          <p class="lmsv-detail-note">
            <strong>Instructor:</strong> <%= course.authorName %><br>
            <strong>Duration:</strong> <%= formatDuration(course.estimatedDurationMinutes) %>
          </p>
          <% if (courseCommentsEnabled && !isPreviewMode) { %>
            <div class="lmsv-side-rating">
              <div>
                <span class="lmsv-side-rating-label">Course rating</span>
                <strong><%= reviewSummary.ratingCount > 0 ? `${reviewSummary.ratingAverageLabel}/5` : 'New' %></strong>
              </div>
              <span><%= reviewSummary.ratingCount > 0 ? `${reviewSummary.ratingCount} rating${reviewSummary.ratingCount === 1 ? '' : 's'}` : 'No ratings yet' %></span>
            </div>
          <% } %>

          <% if (isPreviewMode) { %>
            <% if (resolvedPreviewEditUrl) { %>
              <a href="<%= resolvedPreviewEditUrl %>" class="btn btn-primary" style="width:100%;text-align:center;">Edit Course</a>
            <% } %>
            <a href="<%= backHref %>" class="btn btn-secondary" style="width:100%;text-align:center;margin-top:8px;">Return</a>
            <p class="lmsv-detail-note">Preview mode disables checkout/cart actions until the course is published.</p>
          <% } else if (user) { %>
            <% if (canStartNow) { %>
              <a href="<%= takePath %>" class="btn btn-primary" style="width:100%;text-align:center;">
                <%= isEnrolled ? 'Continue Learning' : 'Start Learning' %>
              </a>
              <% if (course.requiresPayment && hasSuccessfulPayment) { %>
                <p class="lmsv-detail-note">Payment confirmed. This paid course is unlocked for your account.</p>
              <% } %>
            <% } else { %>
              <form method="post" action="/simple-lms/courses/<%= course._id %>/pay">
                <input type="hidden" name="next" value="<%= takePath %>">
                <input type="hidden" name="fallback" value="<%= resolvedDetailPath %>">
                <% if (persistedReferralCode) { %><input type="hidden" name="ref" value="<%= persistedReferralCode %>"><% } %>
                <% if (persistedSellingOrganizationId) { %><input type="hidden" name="org" value="<%= persistedSellingOrganizationId %>"><% } %>
                <button type="submit" class="btn btn-primary" style="width:100%;">Purchase Now</button>
              </form>
              <% if (inCart) { %>
                <form method="post" action="/simple-lms/cart/remove/<%= course._id %>" style="margin-top:8px;">
                  <input type="hidden" name="returnTo" value="<%= resolvedDetailPath %>">
                  <button type="submit" class="btn btn-danger" style="width:100%;">Remove From Cart</button>
                </form>
              <% } else { %>
                <form method="post" action="/simple-lms/cart/add" style="margin-top:8px;">
                  <input type="hidden" name="courseId" value="<%= course._id %>">
                  <input type="hidden" name="returnTo" value="<%= resolvedDetailPath %>">
                  <% if (persistedReferralCode) { %><input type="hidden" name="ref" value="<%= persistedReferralCode %>"><% } %>
                  <% if (persistedSellingOrganizationId) { %><input type="hidden" name="org" value="<%= persistedSellingOrganizationId %>"><% } %>
                  <button type="submit" class="btn btn-secondary" style="width:100%;">Add To Cart</button>
                </form>
              <% } %>
              <a href="/simple-lms/cart" class="btn btn-secondary" style="width:100%;text-align:center;margin-top:8px;">
                View Cart (<%= Number(cartCount || 0) %>)
              </a>
              <p class="lmsv-detail-note">This is a paid course. Purchase now or save it to your cart first.</p>
            <% } %>
          <% } else { %>
            <a href="<%= learnLoginHref %>" class="btn btn-primary" style="width:100%;text-align:center;">Login to Start Learning</a>
            <a href="<%= registerToLearnHref %>" class="btn btn-secondary" style="width:100%;text-align:center;margin-top:8px;">Create Account</a>
            <p class="lmsv-detail-note">
              You can browse freely. Login is required when you want to start this course.
            </p>
          <% } %>
        </article>
      </aside>
    </section>
  </main>

  <%- include('./partials/public-footer') %>
</body>
</html>




