<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
  <style>
    .auth-wrap {
      max-width: 520px;
      margin: 48px auto;
      padding: 20px;
    }
    .auth-card {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      padding: 20px;
      display: grid;
      gap: 12px;
    }
    .auth-title {
      margin: 0;
      color: var(--text);
      font-size: 28px;
      letter-spacing: -0.02em;
    }
    .auth-subtitle {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
    }
    .auth-card label {
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .auth-card .input {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--field-bg);
      color: var(--text);
      padding: 10px 12px;
      font-size: 14px;
    }
    .auth-card .input:focus {
      outline: none;
      border-color: rgba(56, 189, 248, .7);
      box-shadow: 0 0 0 2px rgba(56, 189, 248, .18);
    }
    .auth-footer {
      margin-top: 8px;
      color: var(--muted);
      font-size: 13px;
    }
    .intent-banner {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
      background: var(--input-bg);
      display: grid;
      gap: 3px;
    }
    .intent-kicker {
      margin: 0;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      font-weight: 700;
    }
    .intent-text {
      margin: 0;
      font-size: 13px;
      color: var(--text);
    }
  </style>
</head>
<body>
  <% const isTeachIntent = intent === 'teach' %>
  <div class="auth-wrap">
    <div class="auth-card">
      <h1 class="auth-title"><%= `Create ${brandLearningName || 'Seemplify Learning'} Account` %></h1>
      <p class="auth-subtitle">
        <%= isTeachIntent
          ? 'Register once, then continue to the course publishing setup.'
          : 'Set up your learning workspace with your own login.' %>
      </p>

      <% if (isTeachIntent) { %>
        <div class="intent-banner">
          <p class="intent-kicker">Teach Intent</p>
          <p class="intent-text">You are joining to publish courses. After signup, we will open the course setup wizard.</p>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="post" action="/register" style="display:grid; gap:10px;">
        <input type="hidden" name="intent" value="<%= intent || 'learn' %>">
        <input type="hidden" name="source" value="<%= source || 'direct' %>">
        <input type="hidden" name="return_to" value="<%= returnTo || '/simple-lms' %>">

        <label>Full Name</label>
        <input class="input" type="text" name="name" required placeholder="Jane Doe">

        <label>Email</label>
        <input class="input" type="email" name="email" required placeholder="you@company.com">

        <label>Password</label>
        <input class="input" type="password" name="password" required minlength="8" placeholder="Minimum 8 characters">

        <button class="btn btn-primary" type="submit">Create account</button>
      </form>

      <p class="auth-footer">Already have an account? <a href="<%= loginUrl || '/login' %>">Sign in</a></p>
    </div>
  </div>
</body>
</html>
