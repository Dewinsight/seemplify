<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
  <style>
    .agent-shell {
      max-width: 1220px;
      margin: 24px auto 40px;
      padding: 0 16px;
      display: grid;
      grid-template-columns: 294px minmax(0, 1fr);
      gap: 22px;
    }
    .agent-side {
      --side-accent: #0f766e;
      --side-accent-soft: rgba(20, 184, 166, .14);
      --side-accent-line: rgba(20, 184, 166, .2);
      position: sticky;
      top: 84px;
      align-self: start;
      border: 1px solid rgba(148, 163, 184, .18);
      border-radius: 24px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, .95), rgba(248, 250, 252, .92));
      box-shadow: 0 28px 48px -40px rgba(15, 23, 42, .34);
      padding: 18px;
      display: grid;
      gap: 16px;
    }
    .agent-side-header {
      display: grid;
      gap: 8px;
    }
    .agent-side-kicker {
      margin: 0;
      color: var(--side-accent);
      font-size: 11px;
      letter-spacing: .12em;
      text-transform: uppercase;
      font-weight: 800;
    }
    .agent-side h2 {
      margin: 0;
      color: var(--text);
      font-size: 28px;
      line-height: 1;
      letter-spacing: -.04em;
    }
    .agent-side p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.55;
    }
    .agent-side-meta {
      border: 1px solid var(--side-accent-line);
      border-radius: 18px;
      background:
        linear-gradient(160deg, rgba(240, 253, 250, .92), rgba(255, 255, 255, .96));
      padding: 14px;
      display: grid;
      gap: 10px;
    }
    .agent-side-meta strong {
      color: var(--text);
    }
    .agent-side-code {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: fit-content;
      padding: 7px 12px;
      border-radius: 999px;
      border: 1px solid rgba(20, 184, 166, .24);
      background: rgba(255, 255, 255, .78);
      color: var(--side-accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .04em;
    }
    .agent-side-code span {
      color: var(--muted);
      font-weight: 600;
      letter-spacing: 0;
    }
    .agent-nav {
      display: grid;
      gap: 8px;
    }
    .agent-nav a {
      display: grid;
      grid-template-columns: 38px minmax(0, 1fr) 12px;
      align-items: center;
      gap: 12px;
      border: 1px solid transparent;
      border-radius: 18px;
      background: transparent;
      padding: 10px 12px;
      text-decoration: none;
      color: var(--text);
      font-size: 13px;
      transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
    }
    .agent-nav a:hover {
      border-color: rgba(15, 118, 110, .12);
      background: rgba(255, 255, 255, .78);
      transform: translateX(2px);
    }
    .dashboard-nav-icon {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--side-accent);
      background: var(--side-accent-soft);
      border: 1px solid rgba(20, 184, 166, .1);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .5);
      flex-shrink: 0;
    }
    .dashboard-nav-icon svg {
      width: 18px;
      height: 18px;
    }
    .dashboard-nav-copy {
      min-width: 0;
      display: grid;
      gap: 2px;
    }
    .dashboard-nav-label {
      color: var(--text);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: -.02em;
    }
    .dashboard-nav-note {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .dashboard-nav-arrow {
      width: 12px;
      height: 12px;
      color: var(--side-accent);
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity .18s ease, transform .18s ease;
    }
    .agent-nav a.active {
      border-color: rgba(20, 184, 166, .2);
      background:
        linear-gradient(135deg, rgba(236, 253, 245, .98), rgba(255, 255, 255, .98));
      box-shadow: 0 16px 28px -24px rgba(15, 118, 110, .35);
    }
    .agent-nav a.active .dashboard-nav-label {
      color: var(--side-accent);
    }
    .agent-nav a.active .dashboard-nav-note {
      color: #0f766e;
    }
    .agent-nav a.active .dashboard-nav-arrow {
      opacity: 1;
      transform: translateX(0);
    }
    .agent-main {
      display: grid;
      gap: 16px;
    }
    .panel {
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      padding: 16px;
      display: grid;
      gap: 12px;
    }
    .panel h1,
    .panel h2,
    .panel h3 {
      margin: 0;
      color: var(--text);
      letter-spacing: -.02em;
    }
    .panel p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.45;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
    .stat {
      border: 1px solid var(--border);
      border-radius: 12px;
      background: linear-gradient(160deg, rgba(255, 255, 255, .88), rgba(204, 251, 241, .55));
      padding: 12px;
      display: grid;
      gap: 4px;
    }
    .stat span {
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      font-weight: 700;
    }
    .stat strong {
      color: var(--text);
      font-size: 24px;
      line-height: 1;
    }
    .course-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .course-card {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      background: rgba(255, 255, 255, .9);
      display: grid;
      gap: 8px;
    }
    .course-card h3 {
      margin: 0;
      color: var(--text);
      font-size: 16px;
      letter-spacing: -.01em;
    }
    .course-card p {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;
    }
    .course-meta {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      font-size: 12px;
      color: var(--text);
    }
    .referral {
      border: 1px dashed rgba(20, 184, 166, .5);
      border-radius: 10px;
      background: rgba(20, 184, 166, .08);
      padding: 8px;
      font-size: 12px;
      color: #0f766e;
      word-break: break-all;
    }
    .table-wrap {
      overflow: auto;
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 700px;
      background: var(--card-bg);
    }
    th,
    td {
      text-align: left;
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
      color: var(--text);
      vertical-align: top;
    }
    th {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
      font-weight: 700;
      background: rgba(148, 163, 184, .08);
    }
    .field-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .field {
      display: grid;
      gap: 6px;
    }
    .field label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
      font-weight: 700;
    }
    .field input,
    .field textarea {
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--field-bg);
      color: var(--text);
      padding: 9px 10px;
      font-size: 13px;
    }
    .field textarea {
      min-height: 70px;
      resize: vertical;
      grid-column: 1 / -1;
    }
    @media (max-width: 1024px) {
      .agent-shell {
        grid-template-columns: 1fr;
      }
      .agent-side {
        position: static;
      }
      .agent-nav {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 720px) {
      .stats-grid,
      .field-grid,
      .course-grid {
        grid-template-columns: 1fr;
      }
      .agent-nav {
        grid-template-columns: 1fr;
      }
      .agent-nav a {
        grid-template-columns: 34px minmax(0, 1fr) 12px;
        gap: 10px;
      }
      .dashboard-nav-icon {
        width: 34px;
        height: 34px;
      }
    }
  </style>
</head>
<body>
  <%- include('./partials/nav', { user, activePage, activeLmsView: '' }) %>

  <% const section = activeSection || 'overview' %>
  <% const agentSections = [
    {
      key: 'overview',
      href: '/agent-dashboard?section=overview',
      label: 'Overview',
      note: 'Commission snapshot and payout readiness',
      icon: 'overview'
    },
    {
      key: 'courses',
      href: '/agent-dashboard?section=courses',
      label: 'Course Catalog',
      note: 'Referral-ready courses from your partner org',
      icon: 'courses'
    },
    {
      key: 'sales',
      href: '/agent-dashboard?section=sales',
      label: 'My Sales',
      note: 'Attributed purchases and order history',
      icon: 'sales'
    },
    {
      key: 'commissions',
      href: '/agent-dashboard?section=commissions',
      label: 'Commissions',
      note: 'Rates, statuses, and payout flow',
      icon: 'commissions'
    },
    {
      key: 'earnings',
      href: '/agent-dashboard?section=earnings',
      label: 'Earnings Trace',
      note: 'Breakdown of every tracked sale',
      icon: 'trace'
    },
    {
      key: 'settings',
      href: '/agent-dashboard?section=settings',
      label: 'Settings',
      note: 'Bank details and payout profile',
      icon: 'settings'
    }
  ] %>
  <% const renderAgentNavIcon = (icon) => {
    switch (icon) {
      case 'overview':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13h6V4H4z"></path><path d="M14 20h6v-9h-6z"></path><path d="M14 4h6v5h-6z"></path><path d="M4 20h6v-3H4z"></path></svg>'
      case 'courses':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5C4 5.12 5.12 4 6.5 4H20v14.5c0 .83-.67 1.5-1.5 1.5H6.5A2.5 2.5 0 0 1 4 17.5z"></path><path d="M8 4v16"></path><path d="M12 8h5"></path><path d="M12 12h5"></path></svg>'
      case 'sales':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16"></path><path d="M7 15l3-3 3 2 5-6"></path><path d="M18 8h2v2"></path></svg>'
      case 'commissions':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"></circle><path d="M12 7v10"></path><path d="M9 10.5c0-1.1 1.34-2 3-2s3 .9 3 2-1.34 2-3 2-3 .9-3 2 1.34 2 3 2 3-.9 3-2"></path></svg>'
      case 'trace':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18h16"></path><path d="M6 15V9"></path><path d="M12 15V5"></path><path d="M18 15v-3"></path></svg>'
      case 'settings':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15 1.65 1.65 0 0 0 3.09 14H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06A2 2 0 1 1 7.04 4.3l.06.06A1.65 1.65 0 0 0 8.92 4h.16A1.65 1.65 0 0 0 10 2.49V2a2 2 0 1 1 4 0v.49A1.65 1.65 0 0 0 14.92 4h.16a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c0 .66.39 1.26 1 1.51.18.07.37.1.56.1H21a2 2 0 1 1 0 4h-.04a1.65 1.65 0 0 0-1.56 1.39z"></path></svg>'
      default:
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>'
    }
  } %>

  <main class="agent-shell">
    <aside class="agent-side">
      <div class="agent-side-header">
        <p class="agent-side-kicker">Sales Agent Console</p>
        <h2>Agent Workspace</h2>
        <p>Track your attribution pipeline, manage referral-ready links, and keep payout details current.</p>
      </div>

      <article class="agent-side-meta">
        <p><strong><%= organization?.name || 'Partner Organization' %></strong></p>
        <div class="agent-side-code"><span>Referral code</span> <%= referralCode %></div>
      </article>

      <nav class="agent-nav">
        <% agentSections.forEach((item) => { %>
          <a href="<%= item.href %>" class="<%= section === item.key ? 'active' : '' %>">
            <span class="dashboard-nav-icon"><%- renderAgentNavIcon(item.icon) %></span>
            <span class="dashboard-nav-copy">
              <span class="dashboard-nav-label"><%= item.label %></span>
              <span class="dashboard-nav-note"><%= item.note %></span>
            </span>
            <svg class="dashboard-nav-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 6h8"></path>
              <path d="M6 2l4 4-4 4"></path>
            </svg>
          </a>
        <% }) %>
      </nav>
    </aside>

    <section class="agent-main">
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
      <% if (info) { %><div class="alert"><%= info %></div><% } %>

      <% if (section === 'overview') { %>
        <article class="panel">
          <h1>Agent Dashboard</h1>
          <p>Monitor your attributed sales, commissions, and payout readiness.</p>

          <div class="stats-grid">
            <div class="stat"><span>Total Earned</span><strong><%= formatCurrencyAmount(totals.totalCommissionMinor || 0, 'NGN') %></strong></div>
            <div class="stat"><span>Pending Payout</span><strong><%= formatCurrencyAmount(totals.pendingCommissionMinor || 0, 'NGN') %></strong></div>
            <div class="stat"><span>Paid Out</span><strong><%= formatCurrencyAmount(totals.paidCommissionMinor || 0, 'NGN') %></strong></div>
          </div>
        </article>

        <article class="panel">
          <h2>Recent Commissions</h2>
          <% if (!attributions || attributions.length === 0) { %>
            <p>No commissions have been attributed yet.</p>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Course</th>
                    <th>Sale</th>
                    <th>Rate</th>
                    <th>Commission</th>
                    <th>Status</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% attributions.slice(0, 10).forEach((entry) => { %>
                    <tr>
                      <td><%= entry.course?.title || 'Course' %></td>
                      <td><%= formatCurrencyAmount(entry.saleAmountMinor || 0, entry.currency || 'NGN') %></td>
                      <td><%= Number(entry.commissionRatePercent || 0) %>%</td>
                      <td><%= formatCurrencyAmount(entry.commissionAmountMinor || 0, entry.currency || 'NGN') %></td>
                      <td><%= entry.status %></td>
                      <td><%= new Date(entry.createdAt).toLocaleDateString() %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </article>
      <% } %>

      <% if (section === 'courses') { %>
        <article class="panel">
          <h2>Partner Course Catalog</h2>
          <p>Use referral links to attribute sales to your agent account.</p>

          <% if (!courses || courses.length === 0) { %>
            <p>No courses available in your organization catalog yet.</p>
          <% } else { %>
            <div class="course-grid">
              <% courses.forEach((course) => { %>
                <article class="course-card">
                  <h3><%= course.title %></h3>
                  <p><%= course.summary || 'No summary yet.' %></p>
                  <div class="course-meta">
                    <span><%= Number(course?.pricing?.amount || 0) > 0 ? formatCurrencyAmount(course.pricing.amount, course?.pricing?.currency || 'NGN') : 'Free' %></span>
                    <span><%= String(course.level || 'mixed') %></span>
                  </div>
                  <div class="referral"><%= course.referralUrl %></div>
                  <a class="btn btn-secondary btn-sm" href="<%= course.referralUrl %>" target="_blank" rel="noopener">Open Referral Link</a>
                </article>
              <% }) %>
            </div>
          <% } %>
        </article>
      <% } %>

      <% if (section === 'sales' || section === 'commissions' || section === 'earnings') { %>
        <article class="panel">
          <h2><%= section === 'sales' ? 'My Sales' : (section === 'commissions' ? 'My Commissions' : 'Earnings Trace') %></h2>
          <p>Detailed sale-by-sale trace including platform share and your commission split.</p>

          <% if (!attributions || attributions.length === 0) { %>
            <p>No attributed sales yet.</p>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Course</th>
                    <th>Sale</th>
                    <th>Platform Share</th>
                    <th>Rate</th>
                    <th>Your Commission</th>
                    <th>Status</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% attributions.forEach((entry) => { %>
                    <% const paymentPlatformShare = Number(entry.payment?.platformShareMinor || 0) %>
                    <tr>
                      <td><%= entry.course?.title || 'Course' %></td>
                      <td><%= formatCurrencyAmount(entry.saleAmountMinor || 0, entry.currency || 'NGN') %></td>
                      <td><%= formatCurrencyAmount(paymentPlatformShare, entry.currency || 'NGN') %></td>
                      <td><%= Number(entry.commissionRatePercent || 0) %>%</td>
                      <td><%= formatCurrencyAmount(entry.commissionAmountMinor || 0, entry.currency || 'NGN') %></td>
                      <td><%= entry.status %></td>
                      <td><%= new Date(entry.createdAt).toLocaleDateString() %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </article>
      <% } %>

      <% if (section === 'settings') { %>
        <article class="panel">
          <h2>Payout Profile</h2>
          <p>Set your bank details to receive approved commission payouts.</p>

          <form method="post" action="/agent-dashboard/settings/payout" style="display:grid; gap:12px;">
            <div class="field-grid">
              <div class="field">
                <label>Account Name</label>
                <input type="text" name="accountName" value="<%= user?.payoutProfile?.accountName || '' %>">
              </div>
              <div class="field">
                <label>Account Number</label>
                <input type="text" name="accountNumber" value="<%= user?.payoutProfile?.accountNumber || '' %>">
              </div>
              <div class="field">
                <label>Bank Name</label>
                <input type="text" name="bankName" value="<%= user?.payoutProfile?.bankName || '' %>">
              </div>
              <div class="field">
                <label>Bank Code</label>
                <input type="text" name="bankCode" value="<%= user?.payoutProfile?.bankCode || '' %>">
              </div>
              <div class="field">
                <label>SWIFT Code</label>
                <input type="text" name="swiftCode" value="<%= user?.payoutProfile?.swiftCode || '' %>">
              </div>
              <div class="field">
                <label>Currency</label>
                <input type="text" name="currency" maxlength="3" value="<%= user?.payoutProfile?.currency || 'NGN' %>">
              </div>
              <div class="field">
                <label>Payment Email</label>
                <input type="email" name="paymentEmail" value="<%= user?.payoutProfile?.paymentEmail || '' %>">
              </div>
              <div class="field">
                <label>Country</label>
                <input type="text" name="country" value="<%= user?.payoutProfile?.country || '' %>">
              </div>
              <div class="field">
                <label>Notes</label>
                <textarea name="notes"><%= user?.payoutProfile?.notes || '' %></textarea>
              </div>
            </div>

            <button class="btn btn-primary" type="submit" style="width:fit-content;">Save Payout Profile</button>
          </form>
        </article>
      <% } %>
    </section>
  </main>
</body>
</html>
