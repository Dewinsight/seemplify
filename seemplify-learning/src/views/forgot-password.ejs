<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=3"></script>
  <style>
    .auth-wrap {
      max-width: 460px;
      margin: 48px auto;
      padding: 20px;
    }
    .auth-card {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      padding: 20px;
      display: grid;
      gap: 12px;
    }
    .auth-title {
      margin: 0;
      color: var(--text);
      font-size: 28px;
      letter-spacing: -0.02em;
    }
    .auth-subtitle {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
    }
    .auth-card label {
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .auth-card .input {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--field-bg);
      color: var(--text);
      padding: 10px 12px;
      font-size: 14px;
    }
    .auth-card .input:focus {
      outline: none;
      border-color: rgba(56, 189, 248, .7);
      box-shadow: 0 0 0 2px rgba(56, 189, 248, .18);
    }
    .auth-footer {
      margin-top: 8px;
      color: var(--muted);
      font-size: 13px;
    }
  </style>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-card">
      <h1 class="auth-title">Forgot Password</h1>
      <p class="auth-subtitle">Enter your account email and we will send a password reset link.</p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form method="post" action="/forgot-password" style="display:grid; gap:10px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <label>Email</label>
        <input class="input" type="email" name="email" required placeholder="you@company.com">

        <button class="btn btn-primary" type="submit">Send reset link</button>
      </form>

      <p class="auth-footer"><a href="/login">Back to sign in</a></p>
    </div>
  </div>
</body>
</html>
