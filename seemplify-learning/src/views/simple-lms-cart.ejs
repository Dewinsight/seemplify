<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/public-lms.css?v=20260304-2">
  <link rel="stylesheet" href="/css/public-lms-refresh.css?v=20260304-11">
  <script src="/js/theme.js?v=3"></script>
  <style>
    body.public-site.lmsv-cart-page {
      background: #f6f6f7;
      color: #111827;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .cart-shell {
      width: min(1120px, 100%);
      margin: 0 auto;
      padding: 28px 20px 40px;
      display: grid;
      gap: 18px;
      flex: 1 0 auto;
    }
    .cart-panel {
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 14px 30px -24px rgba(15, 23, 42, 0.36);
      padding: 20px 24px;
    }
    .cart-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .cart-head h1 {
      margin: 0;
      font-size: clamp(28px, 4vw, 44px);
      line-height: 1.05;
      color: #0f172a;
      letter-spacing: -0.03em;
    }
    .cart-head p {
      margin: 6px 0 0;
      color: #64748b;
      font-size: 15px;
    }
    .cart-actions {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .cart-summary-grid {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 14px;
    }
    .cart-summary-card {
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 12px 14px;
      background: #fff;
      display: grid;
      gap: 8px;
    }
    .cart-summary-card small {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: #64748b;
    }
    .cart-summary-card strong {
      font-size: 36px;
      line-height: 1;
      letter-spacing: -0.03em;
      color: #0f172a;
    }
    .cart-total-chip {
      border: 1px solid #cbd5e1;
      border-radius: 999px;
      background: #fff;
      color: #0f172a;
      padding: 7px 12px;
      font-size: 14px;
      font-weight: 800;
      width: fit-content;
    }
    .cart-toolbar {
      margin-top: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .cart-toolbar p {
      margin: 0;
      color: #64748b;
      font-size: 14px;
    }
    .cart-list {
      display: grid;
      gap: 12px;
      margin-top: 14px;
    }
    .cart-item {
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      background: #fff;
      display: grid;
      grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
      overflow: hidden;
    }
    .cart-item-media {
      background: linear-gradient(135deg, #0f172a, #1e3a8a);
    }
    .cart-item-media img {
      width: 100%;
      height: 100%;
      min-height: 170px;
      object-fit: cover;
      display: block;
    }
    .cart-item-body {
      padding: 14px;
      display: grid;
      gap: 8px;
      align-content: start;
    }
    .cart-item-body h3 {
      margin: 0;
      font-size: 24px;
      line-height: 1.14;
      letter-spacing: -0.02em;
      color: #0f172a;
    }
    .cart-item-body p {
      margin: 0;
      color: #64748b;
      font-size: 14px;
      line-height: 1.5;
    }
    .pill-row {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .pill {
      border: 1px solid #cbd5e1;
      border-radius: 999px;
      padding: 4px 9px;
      background: #f8fafc;
      color: #334155;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }
    .cart-item-foot {
      margin-top: 4px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }
    .cart-item-price {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #0f172a;
    }
    .cart-item-actions {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .empty-cart {
      border: 1px dashed #cbd5e1;
      border-radius: 14px;
      background: #fff;
      padding: 20px;
      display: grid;
      gap: 10px;
      text-align: center;
      color: #64748b;
    }
    @media (max-width: 960px) {
      .cart-summary-grid {
        grid-template-columns: 1fr;
      }
      .cart-item {
        grid-template-columns: 1fr;
      }
      .cart-item-media img {
        min-height: 180px;
      }
    }
  </style>
  <link rel="icon" type="image/svg+xml" href="<%= typeof brandKey === 'string' && brandKey === 'aiin' ? '/images/aiin_logo.png' : '/images/seemplify-favicon.svg' %>">
  <link rel="stylesheet" href="/css/seemplify-brand.css?v=20260811-1">
</head>
<body class="public-site lmsv-cart-page">
  <%- include('./partials/nav', { user, activePage, activeLmsView: 'workspace' }) %>

  <main class="cart-shell">
    <% const availableProviderCount = Array.isArray(paymentCheckout?.availableProviders) ? paymentCheckout.availableProviders.length : 0 %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (info) { %><div class="alert"><%= info %></div><% } %>
    <% if (availableProviderCount === 0) { %>
      <div class="alert alert-error">No payment gateway is currently available. Please contact support.</div>
    <% } %>

    <section class="cart-panel">
      <header class="cart-head">
        <div>
          <h1>My Cart</h1>
          <p>Review selected paid courses and complete checkout without workspace clutter.</p>
        </div>
        <div class="cart-actions">
          <a class="btn btn-secondary btn-sm" href="/simple-lms?view=catalog">Continue Browsing</a>
          <a class="btn btn-secondary btn-sm" href="/simple-lms?view=overview">Back to Workspace</a>
        </div>
      </header>

      <div class="cart-summary-grid">
        <article class="cart-summary-card">
          <small>Items in Cart</small>
          <strong><%= cartSummary?.itemCount || 0 %></strong>
        </article>
        <article class="cart-summary-card">
          <small>Paid Courses</small>
          <strong><%= (cartCourses || []).filter((course) => course.requiresPayment).length %></strong>
        </article>
        <article class="cart-summary-card">
          <small>Checkout Totals</small>
          <% if (cartSummary && cartSummary.totalsByCurrency && cartSummary.totalsByCurrency.length > 0) { %>
            <div class="pill-row">
              <% cartSummary.totalsByCurrency.forEach((entry) => { %>
                <span class="cart-total-chip"><%= entry.amountDisplay %></span>
              <% }) %>
            </div>
          <% } else { %>
            <strong>0</strong>
          <% } %>
        </article>
      </div>

      <div class="cart-toolbar">
        <p>
          Checkout processes one payable item at a time and keeps remaining items in cart.
          <%= availableProviderCount > 1 ? 'You will choose between available gateways during checkout.' : '' %>
        </p>
        <% if (cartSummary && cartSummary.hasItems) { %>
          <div class="cart-actions">
            <form method="post" action="/simple-lms/cart/checkout" style="display:inline-flex;">
              <input type="hidden" name="returnTo" value="/simple-lms/cart">
              <button class="btn btn-primary btn-sm" type="submit" <%= availableProviderCount === 0 ? 'disabled' : '' %>>Checkout Now</button>
            </form>
            <form method="post" action="/simple-lms/cart/clear" style="display:inline-flex;">
              <input type="hidden" name="returnTo" value="/simple-lms/cart">
              <button class="btn btn-danger btn-sm" type="submit">Clear Cart</button>
            </form>
          </div>
        <% } %>
      </div>

      <% if (!cartSummary || !cartSummary.hasItems) { %>
        <div class="empty-cart">
          <strong>Your cart is empty.</strong>
          <span>Add paid courses from the catalog, then return here to complete checkout.</span>
          <div>
            <a class="btn btn-primary btn-sm" href="/simple-lms?view=catalog">Explore Catalog</a>
          </div>
        </div>
      <% } else { %>
        <div class="cart-list">
          <% cartCourses.forEach((course) => { %>
            <article class="cart-item">
              <a class="cart-item-media" href="<%= course.courseUrl %>">
                <% if (course.banner?.url) { %>
                  <img src="<%= course.banner.url %>" alt="<%= course.title %> banner">
                <% } else { %>
                  <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1200&q=80" alt="<%= course.title %> banner">
                <% } %>
              </a>
              <div class="cart-item-body">
                <h3><%= course.title %></h3>
                <p><%= course.summaryText %></p>
                <div class="pill-row">
                  <span class="pill"><%= course.levelLabel %></span>
                  <span class="pill"><%= course.lessonCount %> lessons</span>
                  <span class="pill">Paid</span>
                </div>
                <div class="cart-item-foot">
                  <span class="cart-item-price"><%= course.displayPrice %></span>
                  <div class="cart-item-actions">
                    <a class="btn btn-secondary btn-sm" href="<%= course.courseUrl %>">Preview</a>
                    <form method="post" action="/simple-lms/courses/<%= course._id %>/pay" style="display:inline-flex;">
                      <input type="hidden" name="next" value="/simple-lms/cart">
                      <input type="hidden" name="fallback" value="/simple-lms/cart">
                      <input type="hidden" name="checkoutContext" value="cart">
                      <button class="btn btn-primary btn-sm" type="submit">Purchase Now</button>
                    </form>
                    <form method="post" action="/simple-lms/cart/remove/<%= course._id %>" style="display:inline-flex;">
                      <input type="hidden" name="returnTo" value="/simple-lms/cart">
                      <button class="btn btn-danger btn-sm" type="submit">Remove</button>
                    </form>
                  </div>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('./partials/public-footer') %>
</body>
</html>
