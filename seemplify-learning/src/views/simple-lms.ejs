<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
  <style>
    :root {
      --lms-surface: rgba(15, 23, 42, 0.45);
      --lms-surface-soft: rgba(15, 23, 42, 0.3);
      --lms-media-start: rgba(14, 165, 233, 0.2);
      --lms-media-end: rgba(2, 6, 23, 0.84);
      --lms-tab-active: rgba(14, 165, 233, 0.18);
      --lms-tab-active-border: rgba(14, 165, 233, 0.7);
      --lms-price: #fbbf24;
    }
    [data-theme="light"] {
      --lms-surface: rgba(255, 255, 255, 0.74);
      --lms-surface-soft: rgba(255, 255, 255, 0.62);
      --lms-media-start: rgba(56, 189, 248, 0.2);
      --lms-media-end: rgba(226, 232, 240, 0.88);
      --lms-tab-active: rgba(99, 102, 241, 0.14);
      --lms-tab-active-border: rgba(99, 102, 241, 0.55);
      --lms-price: #b45309;
    }
    .shell { max-width: 1380px; margin: 0 auto 26px; display: grid; gap: 12px; }
    .hero, .panel { border: 1px solid var(--border); border-radius: 16px; background: var(--card-bg); box-shadow: var(--card-shadow); padding: 16px; }
    .hero { background: radial-gradient(120% 160% at 0 0, rgba(14,165,233,.18), transparent 46%), var(--card-bg); }
    .title { margin: 0; font-size: clamp(30px, 4vw, 54px); letter-spacing: -.04em; line-height: 1.02; }
    .subtitle { margin: 6px 0 0; color: var(--muted); }
    .chips, .tabs, .actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .chip, .tab { border: 1px solid var(--border); border-radius: 999px; padding: 6px 10px; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; background: var(--lms-surface); }
    .tab { text-decoration: none; color: var(--text); padding: 8px 12px; }
    .tab.active { border-color: var(--lms-tab-active-border); background: var(--lms-tab-active); }
    .head { display: flex; justify-content: space-between; align-items: end; gap: 8px; flex-wrap: wrap; }
    .head h2 { margin: 0; letter-spacing: -.02em; }
    .head p { margin: 4px 0 0; color: var(--muted); font-size: 13px; }
    .kpis { display: grid; grid-template-columns: repeat(auto-fit,minmax(160px,1fr)); gap: 8px; }
    .kpi { border: 1px solid var(--border); border-radius: 10px; padding: 10px; background: var(--lms-surface); }
    .kpi small { display: block; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .05em; }
    .kpi strong { font-size: 30px; line-height: 1; letter-spacing: -.03em; }
    .grid { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
    .card { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: var(--lms-surface); display: grid; align-content: start; }
    .media { height: 140px; border-bottom: 1px solid var(--border); background: linear-gradient(140deg, var(--lms-media-start), var(--lms-media-end)); display: flex; align-items: center; justify-content: center; }
    .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .body { padding: 10px; display: grid; gap: 8px; }
    .body h3 { margin: 0; font-size: 18px; letter-spacing: -.02em; line-height: 1.2; }
    .body p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
    .pill { border: 1px solid var(--border); border-radius: 999px; padding: 3px 8px; font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; background: var(--lms-surface); }
    .price { color: var(--lms-price); font-weight: 800; }
    .progress { height: 8px; border-radius: 999px; overflow: hidden; background: rgba(148,163,184,.25); }
    .progress span { display: block; height: 100%; width: var(--progress,0%); background: linear-gradient(90deg,#22d3ee,#14b8a6); }
    .empty { border: 1px dashed var(--border); border-radius: 10px; padding: 18px; text-align: center; color: var(--muted); background: var(--lms-surface-soft); }
    .form-grid { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit,minmax(180px,1fr)); }
    .studio { display: grid; gap: 10px; grid-template-columns: minmax(0,1.4fr) minmax(300px,1fr); align-items: start; }
    .stack { display: grid; gap: 8px; }
    .mini { font-size: 12px; color: var(--muted); margin: 0; }
    .table-wrap { overflow: auto; border: 1px solid var(--border); border-radius: 10px; }
    table { width: 100%; border-collapse: collapse; min-width: 740px; }
    th, td { padding: 10px; border-bottom: 1px solid var(--border); text-align: left; font-size: 13px; }
    th { color: var(--muted); text-transform: uppercase; font-size: 11px; letter-spacing: .06em; }
    .inline-form { display: inline-flex; gap: 6px; align-items: center; }
    .inline-form .input { min-width: 90px; }
    .trend {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 4px 8px;
      background: var(--lms-surface-soft);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .trend.up { color: #22c55e; }
    .trend.down { color: #ef4444; }
    .trend.flat { color: var(--muted); }
    .stack-tight { display: grid; gap: 6px; }
    .analytic-list {
      display: grid;
      gap: 8px;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
    .analytic-item {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px;
      background: var(--lms-surface);
      display: grid;
      gap: 6px;
    }
    .analytic-item h4 {
      margin: 0;
      font-size: 15px;
      letter-spacing: -.01em;
    }
    .analytic-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    @media (max-width: 1040px) { .studio { grid-template-columns: 1fr; } }
    @media (max-width: 760px) {
      .shell { gap: 10px; margin-bottom: 18px; }
      .hero, .panel { padding: 12px; border-radius: 14px; }
      .title { font-size: clamp(24px, 8vw, 34px); }
      .subtitle { font-size: 13px; }
      .tabs, .chips {
        flex-wrap: nowrap;
        overflow-x: auto;
        padding-bottom: 4px;
        -webkit-overflow-scrolling: touch;
      }
      .tab, .chip { white-space: nowrap; }
      .grid { grid-template-columns: 1fr; }
      .form-grid { grid-template-columns: 1fr; }
      .actions .btn { flex: 1; min-width: calc(50% - 4px); justify-content: center; }
      .body h3 { font-size: 17px; }
      table { min-width: 620px; }
    }
  </style>
</head>
<body>
  <%- include('./partials/nav', { user, activePage }) %>
  <% const tab = (mode) => `/simple-lms?view=${mode}` %>
  <% const learningName = brandLearningName || 'Seemplify Learning' %>
  <% const roleLabel = String(role || 'learner').replace(/_/g, ' ') %>
  <% const nice = (value) => String(value || '').replace(/_/g, ' ') %>
  <% const dateText = (value) => { try { return value ? new Date(value).toLocaleString('en-GB') : '-' } catch { return '-' } } %>
  <% const creatorDefaults = creatorSettings || {} %>
  <% const platformDefaults = platformSettings || {} %>

  <main class="shell">
    <section class="hero">
      <h1 class="title"><%= learningName %></h1>
      <p class="subtitle">Course delivery, pathways, and payment-enabled enrollments in one workspace.</p>
      <div class="chips">
        <span class="chip">Role: <%= roleLabel %></span>
        <span class="chip">Courses: <%= stats.publishedCourseCount %></span>
        <span class="chip">Programs: <%= stats.publishedProgramCount %></span>
        <span class="chip">Course Authors: <%= stats.creatorCount %></span>
        <span class="chip">My Enrollments: <%= stats.myEnrollmentCount %></span>
        <span class="chip">Paid Courses: <%= stats.myPaidCourseCount %></span>
      </div>
      <div class="tabs">
        <a class="tab <%= viewMode === 'overview' ? 'active' : '' %>" href="<%= tab('overview') %>">Overview</a>
        <a class="tab <%= viewMode === 'catalog' ? 'active' : '' %>" href="<%= tab('catalog') %>">Catalog</a>
        <a class="tab <%= viewMode === 'my-learning' ? 'active' : '' %>" href="<%= tab('my-learning') %>">My Learning</a>
        <% if (canCreateCourses) { %>
          <a class="tab <%= viewMode === 'course-studio' ? 'active' : '' %>" href="<%= tab('course-studio') %>">Course Studio</a>
          <a class="tab <%= viewMode === 'program-studio' ? 'active' : '' %>" href="<%= tab('program-studio') %>">Program Studio</a>
        <% } %>
        <% if (canManagePlatform) { %>
          <a class="tab <%= viewMode === 'admin' ? 'active' : '' %>" href="<%= tab('admin') %>">Admin</a>
        <% } %>
      </div>
    </section>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (info) { %><div class="alert"><%= info %></div><% } %>
    <% if (platformDefaults.maintenanceMode) { %>
      <div class="alert alert-error">Maintenance mode is active. <%= platformDefaults.maintenanceMessage || 'Learners may face limited actions while updates are in progress.' %></div>
    <% } %>

    <% if (viewMode === 'overview') { %>
      <section class="panel">
        <div class="head"><div><h2>Overview</h2><p>Workspace snapshot and core metrics.</p></div></div>
        <div class="kpis">
          <article class="kpi"><small>Published Courses</small><strong><%= stats.publishedCourseCount %></strong></article>
          <article class="kpi"><small>Published Programs</small><strong><%= stats.publishedProgramCount %></strong></article>
          <article class="kpi"><small>Total Learners</small><strong><%= stats.learnerCount %></strong></article>
          <article class="kpi"><small>Completed Enrollments</small><strong><%= stats.completionCount %></strong></article>
        </div>
      </section>

    <% } %>

    <% if (viewMode === 'catalog') { %>
      <section class="panel">
        <div class="head"><div><h2>Course Catalog</h2><p>Start free courses instantly. Paid courses use Flutterwave checkout.</p></div></div>
        <form method="get" action="/simple-lms">
          <input type="hidden" name="view" value="catalog">
          <div class="form-grid">
            <div><label>Search</label><input class="input" type="search" name="q" value="<%= filters.query || '' %>" placeholder="Course title or keyword"></div>
            <div><label>Category</label><select class="input" name="category"><option value="">All</option><% categories.forEach((c) => { %><option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option><% }) %></select></div>
            <div><label>Level</label><select class="input" name="level"><option value="">All</option><% levels.forEach((l) => { %><option value="<%= l %>" <%= filters.level === l ? 'selected' : '' %>><%= nice(l) %></option><% }) %></select></div>
            <div><label>Sort</label><select class="input" name="sort"><% sortOptions.forEach((s) => { %><option value="<%= s %>" <%= filters.sort === s ? 'selected' : '' %>><%= nice(s) %></option><% }) %></select></div>
          </div>
          <div class="actions" style="margin-top:8px;">
            <button class="btn btn-primary" type="submit">Apply</button>
            <a class="btn btn-secondary" href="/simple-lms?view=catalog">Reset</a>
          </div>
        </form>
      </section>

      <section class="panel">
        <% if (!catalogCourses || catalogCourses.length === 0) { %>
          <div class="empty">No courses available for this filter.</div>
        <% } else { %>
          <div class="grid">
            <% catalogCourses.forEach((course) => { %>
              <article class="card">
                <div class="media"><% if (course.banner?.url) { %><img src="<%= course.banner.url %>" alt="<%= course.title %> banner"><% } else { %><span class="pill"><%= course.levelLabel %></span><% } %></div>
                <div class="body">
                  <h3><%= course.title %></h3>
                  <p><%= course.summaryText %></p>
                  <div class="actions">
                    <span class="pill"><%= course.levelLabel %></span>
                    <span class="pill"><%= course.lessonCount %> lessons</span>
                    <% if (course.requiresPayment) { %><span class="pill">Paid</span><% } %>
                  </div>
                  <p><span class="price"><%= course.displayPrice %></span> &middot; <%= course.authorName %></p>
                  <div class="actions">
                    <a class="btn btn-secondary btn-sm" href="<%= course.courseUrl %>">Preview</a>
                    <% if (course.canStart) { %>
                      <a class="btn btn-primary btn-sm" href="/simple-lms/take/<%= course._id %>"><%= course.isEnrolled ? 'Continue' : 'Start' %></a>
                    <% } else { %>
                      <form method="post" action="/simple-lms/courses/<%= course._id %>/pay" style="display:inline-flex;">
                        <button class="btn btn-primary btn-sm" type="submit">Pay & Unlock</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="panel">
        <div class="head"><div><h2>Programs</h2><p>Structured pathways using multiple courses.</p></div></div>
        <% if (!catalogPrograms || catalogPrograms.length === 0) { %>
          <div class="empty">No programs published yet.</div>
        <% } else { %>
          <div class="grid">
            <% catalogPrograms.forEach((program) => { %>
              <article class="card">
                <div class="body">
                  <h3><%= program.name %></h3>
                  <p><%= program.objective || program.description || 'Program pathway' %></p>
                  <div class="actions"><span class="pill"><%= program.totalSteps %> courses</span><span class="pill"><%= program.requiredSteps %> required</span></div>
                  <form method="post" action="/simple-lms/programs/<%= program._id %>/enroll" class="actions">
                    <button class="btn btn-primary btn-sm" type="submit"><%= program.isEnrolled ? 'Refresh Enrollment' : 'Enroll Program' %></button>
                  </form>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    <% } %>

    <% if (viewMode === 'my-learning') { %>
      <section class="panel">
        <div class="head"><div><h2>My Learning</h2><p>Progress, payments, and active enrollments.</p></div></div>
        <% if (!myEnrollments || myEnrollments.length === 0) { %><div class="empty">No enrollments yet.</div><% } else { %>
          <div class="grid">
            <% myEnrollments.forEach((item) => { %>
              <article class="card">
                <div class="body">
                  <h3><%= item.course.title %></h3>
                  <div class="progress" style="--progress:<%= Math.max(0, Math.min(100, Number(item.progressPercent || 0))) %>%"><span></span></div>
                  <p><strong><%= item.progressPercent %>%</strong> complete &middot; <%= item.completedCount %>/<%= item.lessonCount %> lessons</p>
                  <div class="actions">
                    <a class="btn btn-primary btn-sm" href="/simple-lms/learn/<%= item._id %>/<%= encodeURIComponent(item.nextLessonKey || '') %>"><%= item.isCompleted ? 'Review' : 'Continue' %></a>
                    <a class="btn btn-secondary btn-sm" href="<%= item.course.courseUrl %>">Preview</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="panel">
        <div class="head"><div><h2>My Payments</h2><p>Successful payment history for paid courses.</p></div></div>
        <% if (!myPayments || myPayments.length === 0) { %>
          <div class="empty">No successful payments yet.</div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Date</th><th>Course</th><th>Amount</th><th>Tx Ref</th><th>Provider Tx ID</th></tr></thead>
              <tbody>
                <% myPayments.forEach((payment) => { %>
                  <tr>
                    <td><%= dateText(payment.paidAt || payment.createdAt) %></td>
                    <td><%= payment.courseTitle %></td>
                    <td><%= payment.amountDisplay %></td>
                    <td><%= payment.txRef %></td>
                    <td><%= payment.flutterwaveTxId || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>

    <% if (viewMode === 'course-studio' && canCreateCourses) { %>
      <section class="panel studio">
        <div class="stack">
          <div class="head"><div><h2>Create Course</h2><p class="mini">Create with your saved defaults. Public publishing follows current admin review policy.</p></div></div>
          <% if (platformDefaults.creatorSubmissionGuidelines) { %>
            <div class="alert"><%= platformDefaults.creatorSubmissionGuidelines %></div>
          <% } %>
          <form method="post" action="/simple-lms/courses/create" class="stack">
            <div class="form-grid">
              <div><label>Title</label><input class="input" name="title" required></div>
              <div><label>Category</label><input class="input" name="category" value="<%= creatorDefaults.defaultCategory || '' %>"></div>
              <div><label>Level</label><select class="input" name="level"><% levels.forEach((l) => { %><option value="<%= l %>" <%= (creatorDefaults.defaultLevel || 'mixed') === l ? 'selected' : '' %>><%= nice(l) %></option><% }) %></select></div>
              <div><label>Status</label><select class="input" name="status"><option value="draft" <%= (platformDefaults.defaultCourseStatus || 'draft') === 'draft' ? 'selected' : '' %>>draft</option><option value="published" <%= platformDefaults.defaultCourseStatus === 'published' ? 'selected' : '' %>>publish</option></select></div>
              <div><label>Visibility</label><select class="input" name="visibility"><option value="private" <%= (creatorDefaults.defaultVisibility || platformDefaults.defaultCourseVisibility || 'private') === 'private' ? 'selected' : '' %>>private</option><option value="public" <%= (creatorDefaults.defaultVisibility || platformDefaults.defaultCourseVisibility) === 'public' ? 'selected' : '' %>>public</option><% if (canManagePlatform) { %><option value="marketplace" <%= platformDefaults.defaultCourseVisibility === 'marketplace' ? 'selected' : '' %>>marketplace</option><% } %></select></div>
              <div><label>Tags</label><input class="input" name="tags" placeholder="tag1, tag2"></div>
              <div><label>Payment Mode</label><select class="input" name="paymentMode"><option value="free" <%= (creatorDefaults.defaultPaymentMode || platformDefaults.defaultPaymentMode || 'free') === 'free' ? 'selected' : '' %>>free</option><option value="paid" <%= (creatorDefaults.defaultPaymentMode || platformDefaults.defaultPaymentMode) === 'paid' ? 'selected' : '' %>>paid</option></select></div>
              <div><label>Amount (minor)</label><input class="input" type="number" name="amount" min="<%= platformDefaults.minCoursePriceMinor || 0 %>" max="<%= platformDefaults.maxCoursePriceMinor || 50000000 %>" value="<%= platformDefaults.minCoursePriceMinor || 0 %>"></div>
              <div><label>Currency</label><input class="input" name="currency" maxlength="3" value="<%= creatorDefaults.defaultCurrency || platformDefaults.defaultCurrency || 'NGN' %>"></div>
              <% if (canManagePlatform) { %>
                <div><label>System Course</label><input type="checkbox" name="isSystemCourse" value="on"></div>
              <% } %>
            </div>
            <div><label>Summary</label><textarea class="input" name="summary" rows="2"></textarea></div>
            <div><label>Description</label><textarea class="input" name="description" rows="4"></textarea></div>
            <div><label>Chapters JSON</label><textarea class="input" name="chaptersJson" rows="8" id="createChaptersJson">[]</textarea></div>
            <div class="actions"><button class="btn btn-secondary btn-sm" type="button" id="fillCourseTemplate">Load Sample Curriculum</button><button class="btn btn-primary" type="submit">Create Course</button></div>
          </form>
        </div>

        <aside class="stack">
          <div class="head"><div><h2>Managed Courses</h2><p class="mini">Edit, archive/restore, and assign learners.</p></div></div>
          <% if (!managedCourses || managedCourses.length === 0) { %><div class="empty">No managed courses.</div><% } else { %>
            <% managedCourses.forEach((course) => { %>
              <article class="card"><div class="body">
                <h3><%= course.title %></h3>
                <p><%= course.summaryText %></p>
                <div class="actions"><span class="pill"><%= course.status %></span><span class="pill"><%= course.visibilityDisplay %></span><span class="pill"><%= course.enrollmentCount || 0 %> enrollments</span></div>
                <div class="actions">
                  <a class="btn btn-secondary btn-sm" href="/simple-lms?view=course-studio&editCourse=<%= course._id %>">Edit</a>
                  <% if (course.isActive) { %><form method="post" action="/simple-lms/courses/<%= course._id %>/archive" style="display:inline-flex;"><button class="btn btn-danger btn-sm" type="submit">Archive</button></form><% } else { %><form method="post" action="/simple-lms/courses/<%= course._id %>/restore" style="display:inline-flex;"><button class="btn btn-primary btn-sm" type="submit">Restore</button></form><% } %>
                </div>
              </div></article>
            <% }) %>
          <% } %>
        </aside>
      </section>

      <section class="panel">
        <div class="head"><div><h2>Creator Studio Settings</h2><p class="mini">Personal defaults and workflow behavior for faster publishing.</p></div></div>
        <form method="post" action="/simple-lms/settings/creator" class="stack">
          <div class="form-grid">
            <div><label>Default Category</label><input class="input" name="defaultCategory" value="<%= creatorDefaults.defaultCategory || '' %>" placeholder="e.g. Data Analysis"></div>
            <div><label>Default Level</label><select class="input" name="defaultLevel"><% levels.forEach((l) => { %><option value="<%= l %>" <%= (creatorDefaults.defaultLevel || 'mixed') === l ? 'selected' : '' %>><%= nice(l) %></option><% }) %></select></div>
            <div><label>Default Visibility</label><select class="input" name="defaultVisibility"><option value="private" <%= (creatorDefaults.defaultVisibility || 'private') === 'private' ? 'selected' : '' %>>private</option><option value="public" <%= creatorDefaults.defaultVisibility === 'public' ? 'selected' : '' %>>public</option></select></div>
            <div><label>Default Payment Mode</label><select class="input" name="defaultPaymentMode"><option value="free" <%= (creatorDefaults.defaultPaymentMode || 'free') === 'free' ? 'selected' : '' %>>free</option><option value="paid" <%= creatorDefaults.defaultPaymentMode === 'paid' ? 'selected' : '' %>>paid</option></select></div>
            <div><label>Default Currency</label><input class="input" name="defaultCurrency" maxlength="3" value="<%= creatorDefaults.defaultCurrency || 'NGN' %>"></div>
            <div><label>Preferred Lesson Duration (mins)</label><input class="input" type="number" name="preferredLessonDurationMinutes" min="1" max="600" value="<%= creatorDefaults.preferredLessonDurationMinutes || 12 %>"></div>
            <label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="autoLoadSampleCurriculum" <%= creatorDefaults.autoLoadSampleCurriculum ? 'checked' : '' %>> Auto-load sample curriculum on new course form</label>
            <label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="showCreatorTips" <%= creatorDefaults.showCreatorTips !== false ? 'checked' : '' %>> Show creator tips and submission hints</label>
          </div>
          <div class="actions"><button class="btn btn-primary" type="submit">Save Creator Settings</button></div>
        </form>
      </section>

      <section class="panel">
        <div class="head"><div><h2>Earnings & Payout</h2><p class="mini">Track your course sales and set payout details for commission settlements.</p></div></div>
        <div class="kpis">
          <article class="kpi"><small>Sales</small><strong><%= creatorStats.saleCount %></strong></article>
          <article class="kpi"><small>Gross Revenue</small><strong><%= creatorStats.grossDisplay %></strong></article>
          <article class="kpi"><small>Your Commission</small><strong><%= creatorStats.commissionDisplay %></strong></article>
          <article class="kpi"><small>Active Learners</small><strong><%= creatorStats.enrollmentCount %></strong></article>
        </div>
        <div class="studio" style="margin-top:10px;">
          <div class="stack">
            <div class="head"><div><h2>Recent Sales</h2><p class="mini">Latest successful payments on your managed courses.</p></div></div>
            <% if (!myCreatorSales || myCreatorSales.length === 0) { %>
              <div class="empty">No sales recorded yet.</div>
            <% } else { %>
              <div class="table-wrap">
                <table>
                  <thead><tr><th>Date</th><th>Buyer</th><th>Course</th><th>Amount</th><th>Commission</th><th>Rate</th></tr></thead>
                  <tbody>
                    <% myCreatorSales.forEach((sale) => { %>
                      <tr>
                        <td><%= dateText(sale.paidAt || sale.createdAt) %></td>
                        <td><%= sale.buyerName %></td>
                        <td><%= sale.courseTitle %></td>
                        <td><%= sale.amountDisplay %></td>
                        <td><%= sale.creatorCommissionDisplay %></td>
                        <td><%= sale.creatorCommissionRateDisplay %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
          <aside class="stack">
            <div class="head"><div><h2>Payout Profile</h2><p class="mini">Used by admins for creator payout processing.</p></div></div>
            <form method="post" action="/simple-lms/profile/payout" class="stack">
              <div class="form-grid">
                <div><label>Account Name</label><input class="input" name="accountName" value="<%= payoutProfile.accountName || '' %>"></div>
                <div><label>Account Number</label><input class="input" name="accountNumber" value="<%= payoutProfile.accountNumber || '' %>"></div>
                <div><label>Bank Name</label><input class="input" name="bankName" value="<%= payoutProfile.bankName || '' %>"></div>
                <div><label>Bank Code</label><input class="input" name="bankCode" value="<%= payoutProfile.bankCode || '' %>"></div>
                <div><label>SWIFT Code</label><input class="input" name="swiftCode" value="<%= payoutProfile.swiftCode || '' %>"></div>
                <div><label>Currency</label><input class="input" name="currency" maxlength="3" value="<%= payoutProfile.currency || 'NGN' %>"></div>
                <div><label>Payment Email</label><input class="input" type="email" name="paymentEmail" value="<%= payoutProfile.paymentEmail || '' %>"></div>
                <div><label>Country</label><input class="input" name="country" value="<%= payoutProfile.country || '' %>"></div>
              </div>
              <div><label>Notes</label><textarea class="input" name="notes" rows="3"><%= payoutProfile.notes || '' %></textarea></div>
              <div class="actions"><button class="btn btn-primary" type="submit">Save Payout Profile</button></div>
            </form>
          </aside>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><h2>Creator Course Insights</h2><p class="mini">Per-course performance across enrollment, completion, and paid conversion.</p></div></div>
        <% if (!creatorCourseInsights || creatorCourseInsights.length === 0) { %>
          <div class="empty">No course analytics yet. Publish and enroll learners to populate this section.</div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Course</th><th>Enrollments</th><th>Completions</th><th>Completion Rate</th><th>Paid Sales</th><th>Gross</th><th>Your Commission</th></tr></thead>
              <tbody>
                <% creatorCourseInsights.forEach((item) => { %>
                  <tr>
                    <td><%= item.title %></td>
                    <td><%= item.enrollmentCount %></td>
                    <td><%= item.completionCount %></td>
                    <td><%= item.completionRate %>%</td>
                    <td><%= item.saleCount %></td>
                    <td><%= item.grossDisplay %></td>
                    <td><%= item.commissionDisplay %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>

    <% if (viewMode === 'program-studio' && canCreateCourses) { %>
      <section class="panel studio">
        <div class="stack">
          <div class="head"><div><h2>Create Program</h2><p class="mini">Build pathways using course IDs in steps JSON.</p></div></div>
          <form method="post" action="/simple-lms/programs/create" class="stack">
            <div class="form-grid">
              <div><label>Name</label><input class="input" name="name" required></div>
              <div><label>Status</label><select class="input" name="status"><option value="draft">draft</option><option value="published">published</option></select></div>
              <div><label>Visibility</label><select class="input" name="visibility"><option value="private">private</option><option value="public">public</option></select></div>
            </div>
            <div><label>Objective</label><textarea class="input" name="objective" rows="2"></textarea></div>
            <div><label>Description</label><textarea class="input" name="description" rows="4"></textarea></div>
            <div><label>Tags</label><input class="input" name="tags" placeholder="pathway, leadership"></div>
            <div><label>Steps JSON</label><textarea class="input" name="stepsJson" rows="8" id="createStepsJson">[]</textarea></div>
            <div class="actions"><button class="btn btn-secondary btn-sm" type="button" id="fillProgramTemplate">Load Sample Pathway</button><button class="btn btn-primary" type="submit">Create Program</button></div>
          </form>
        </div>
        <aside class="stack">
          <div class="head"><div><h2>Managed Programs</h2><p class="mini">Edit and assign programs to learners.</p></div></div>
          <% if (!managedPrograms || managedPrograms.length === 0) { %><div class="empty">No managed programs.</div><% } else { %>
            <% managedPrograms.forEach((program) => { %>
              <article class="card"><div class="body">
                <h3><%= program.name %></h3>
                <p><%= program.objective || program.description || 'Program pathway' %></p>
                <div class="actions"><span class="pill"><%= program.status %></span><span class="pill"><%= program.totalSteps %> steps</span></div>
                <div class="actions"><a class="btn btn-secondary btn-sm" href="/simple-lms?view=program-studio&editProgram=<%= program._id %>">Edit</a></div>
              </div></article>
            <% }) %>
          <% } %>
        </aside>
      </section>
    <% } %>

    <% if (viewMode === 'admin' && canManagePlatform) { %>
      <section class="panel">
        <div class="head"><div><h2>Admin Dashboard</h2><p>Users, approval workflow, commission controls, and payment operations.</p></div></div>
        <div class="kpis">
          <article class="kpi"><small>Super Admins</small><strong><%= roleBreakdown.super_admin %></strong></article>
          <article class="kpi"><small>Admins</small><strong><%= roleBreakdown.admin %></strong></article>
          <article class="kpi"><small>Pending Reviews</small><strong><%= pendingReviewCourses.length %></strong></article>
          <article class="kpi"><small>Successful Payments</small><strong><%= paymentStats.successfulCount %></strong></article>
          <article class="kpi"><small>Revenue (Tracked)</small><strong><%= paymentStats.revenueDisplay %></strong></article>
          <article class="kpi"><small>Creator Payouts</small><strong><%= paymentStats.creatorPayoutDisplay %></strong></article>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><h2>Platform Settings & Controls</h2><p>Central controls for creator defaults, moderation policy, and analytics windows.</p></div></div>
        <form method="post" action="/simple-lms/settings/platform" class="stack">
          <div class="form-grid">
            <div><label>Default Currency</label><input class="input" name="defaultCurrency" maxlength="3" value="<%= platformDefaults.defaultCurrency || 'NGN' %>"></div>
            <div><label>Default Payment Mode</label><select class="input" name="defaultPaymentMode"><option value="free" <%= (platformDefaults.defaultPaymentMode || 'free') === 'free' ? 'selected' : '' %>>free</option><option value="paid" <%= platformDefaults.defaultPaymentMode === 'paid' ? 'selected' : '' %>>paid</option></select></div>
            <div><label>Default Course Visibility</label><select class="input" name="defaultCourseVisibility"><option value="private" <%= (platformDefaults.defaultCourseVisibility || 'private') === 'private' ? 'selected' : '' %>>private</option><option value="public" <%= platformDefaults.defaultCourseVisibility === 'public' ? 'selected' : '' %>>public</option><option value="marketplace" <%= platformDefaults.defaultCourseVisibility === 'marketplace' ? 'selected' : '' %>>marketplace</option></select></div>
            <div><label>Default Course Status</label><select class="input" name="defaultCourseStatus"><option value="draft" <%= (platformDefaults.defaultCourseStatus || 'draft') === 'draft' ? 'selected' : '' %>>draft</option><option value="published" <%= platformDefaults.defaultCourseStatus === 'published' ? 'selected' : '' %>>published</option></select></div>
            <div><label>Minimum Course Price (minor)</label><input class="input" type="number" name="minCoursePriceMinor" min="0" value="<%= platformDefaults.minCoursePriceMinor || 0 %>"></div>
            <div><label>Maximum Course Price (minor)</label><input class="input" type="number" name="maxCoursePriceMinor" min="0" value="<%= platformDefaults.maxCoursePriceMinor || 50000000 %>"></div>
            <div><label>Analytics Lookback (days)</label><input class="input" type="number" name="analyticsLookbackDays" min="7" max="365" value="<%= platformDefaults.analyticsLookbackDays || 30 %>"></div>
            <div><label>Homepage Featured Limit</label><input class="input" type="number" name="homepageFeaturedCourseLimit" min="1" max="24" value="<%= platformDefaults.homepageFeaturedCourseLimit || 8 %>"></div>
            <label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="requirePublicReviewForCreators" <%= platformDefaults.requirePublicReviewForCreators !== false ? 'checked' : '' %>> Require admin review before creator public publish</label>
            <label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="allowExternalMediaEmbeds" <%= platformDefaults.allowExternalMediaEmbeds !== false ? 'checked' : '' %>> Allow external media embeds in lessons</label>
            <label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="allowAudioLessons" <%= platformDefaults.allowAudioLessons !== false ? 'checked' : '' %>> Allow audio lesson links</label>
            <label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="maintenanceMode" <%= platformDefaults.maintenanceMode ? 'checked' : '' %>> Enable maintenance mode banner</label>
          </div>
          <div><label>Maintenance Message</label><textarea class="input" name="maintenanceMessage" rows="2"><%= platformDefaults.maintenanceMessage || '' %></textarea></div>
          <div><label>Creator Submission Guidelines</label><textarea class="input" name="creatorSubmissionGuidelines" rows="4"><%= platformDefaults.creatorSubmissionGuidelines || '' %></textarea></div>
          <div class="actions"><button class="btn btn-primary" type="submit">Save Platform Settings</button></div>
        </form>
      </section>

      <section class="panel">
        <div class="head"><div><h2>Advanced Analytics</h2><p>Trend intelligence for the last <%= analytics.lookbackDays %> days versus the previous period.</p></div></div>
        <div class="kpis">
          <article class="kpi">
            <small>New Enrollments</small>
            <strong><%= analytics.enrollmentTrend.current %></strong>
            <span class="trend <%= analytics.enrollmentTrend.growthPercent > 0 ? 'up' : analytics.enrollmentTrend.growthPercent < 0 ? 'down' : 'flat' %>"><%= analytics.enrollmentTrend.growthPercent >= 0 ? '+' : '' %><%= analytics.enrollmentTrend.growthPercent %>%</span>
          </article>
          <article class="kpi">
            <small>Completions</small>
            <strong><%= analytics.completionTrend.current %></strong>
            <span class="trend <%= analytics.completionTrend.growthPercent > 0 ? 'up' : analytics.completionTrend.growthPercent < 0 ? 'down' : 'flat' %>"><%= analytics.completionTrend.growthPercent >= 0 ? '+' : '' %><%= analytics.completionTrend.growthPercent %>%</span>
          </article>
          <article class="kpi">
            <small>Payment Volume</small>
            <strong><%= analytics.paymentTrend.currentCount %></strong>
            <span class="trend <%= analytics.paymentTrend.growthPercent > 0 ? 'up' : analytics.paymentTrend.growthPercent < 0 ? 'down' : 'flat' %>"><%= analytics.paymentTrend.growthPercent >= 0 ? '+' : '' %><%= analytics.paymentTrend.growthPercent %>%</span>
          </article>
          <article class="kpi">
            <small>Revenue This Period</small>
            <strong><%= analytics.paymentTrend.grossDisplay %></strong>
            <small style="margin-top:6px;">Prev: <%= analytics.paymentTrend.previousGrossDisplay %></small>
          </article>
        </div>
        <div class="analytic-list" style="margin-top:10px;">
          <article class="analytic-item">
            <h4>Top Courses by Enrollments</h4>
            <% if (!analytics.topCoursesByEnrollments || analytics.topCoursesByEnrollments.length === 0) { %>
              <p class="mini">No enrollment data in this period.</p>
            <% } else { %>
              <div class="stack-tight">
                <% analytics.topCoursesByEnrollments.forEach((entry) => { %>
                  <div class="analytic-meta"><span class="pill"><%= entry.enrollmentCount %> enrollments</span><span class="pill"><%= entry.completionCount %> completions</span><strong><%= entry.title %></strong></div>
                <% }) %>
              </div>
            <% } %>
          </article>
          <article class="analytic-item">
            <h4>Top Courses by Revenue</h4>
            <% if (!analytics.topCoursesByRevenue || analytics.topCoursesByRevenue.length === 0) { %>
              <p class="mini">No payment data in this period.</p>
            <% } else { %>
              <div class="stack-tight">
                <% analytics.topCoursesByRevenue.forEach((entry) => { %>
                  <div class="analytic-meta"><span class="pill"><%= entry.saleCount %> sales</span><span class="pill"><%= entry.revenueDisplay %></span><strong><%= entry.title %></strong></div>
                <% }) %>
              </div>
            <% } %>
          </article>
          <article class="analytic-item">
            <h4>Top Creators by Revenue</h4>
            <% if (!analytics.topCreatorsByRevenue || analytics.topCreatorsByRevenue.length === 0) { %>
              <p class="mini">No creator revenue data in this period.</p>
            <% } else { %>
              <div class="stack-tight">
                <% analytics.topCreatorsByRevenue.forEach((entry) => { %>
                  <div class="analytic-meta"><span class="pill"><%= entry.saleCount %> sales</span><span class="pill"><%= entry.revenueDisplay %></span><strong><%= entry.creatorName %></strong></div>
                <% }) %>
              </div>
            <% } %>
          </article>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><h2>Manage Users & Roles</h2><p>All accounts can learn and publish courses. Use role only for admin privileges.</p></div></div>
        <% if (!adminAccounts || adminAccounts.length === 0) { %>
          <div class="empty">No accounts found.</div>
        <% } else { %>
          <div class="stack">
            <% adminAccounts.forEach((account) => { %>
              <form method="post" action="/simple-lms/accounts/<%= account._id %>/role" class="form-grid" style="border:1px solid var(--border);border-radius:10px;padding:10px;">
                <div><label>Name</label><input class="input" type="text" value="<%= account.displayName %>" readonly></div>
                <div><label>Email</label><input class="input" type="text" value="<%= account.email %>" readonly></div>
                <div><label>Role</label><select class="input" name="role"><option value="learner" <%= (account.resolvedRole === 'learner' || account.resolvedRole === 'creator') ? 'selected' : '' %>>learner</option><option value="admin" <%= account.resolvedRole === 'admin' ? 'selected' : '' %>>admin</option><option value="super_admin" <%= account.resolvedRole === 'super_admin' ? 'selected' : '' %>>super_admin</option></select></div>
                <div style="align-self:end;"><button class="btn btn-primary btn-sm" type="submit">Update Role</button></div>
              </form>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="panel">
        <div class="head"><div><h2>Course Approval Queue</h2><p>Public course submissions from members requiring admin approval.</p></div></div>
        <% if (!pendingReviewCourses || pendingReviewCourses.length === 0) { %>
          <div class="empty">No courses pending public approval.</div>
        <% } else { %>
          <div class="stack">
            <% pendingReviewCourses.forEach((course) => { %>
              <article class="card">
                <div class="body">
                  <h3><%= course.title %></h3>
                  <p><%= course.summaryText %></p>
                  <div class="actions">
                    <span class="pill">submitted: <%= dateText(course.submittedAt) %></span>
                    <span class="pill"><%= course.creatorName %></span>
                    <span class="pill"><%= course.displayPrice %></span>
                  </div>
                  <div class="actions">
                    <form method="post" action="/simple-lms/courses/<%= course._id %>/approve-public" class="inline-form">
                      <input class="input" type="text" name="reviewNotes" placeholder="Optional note">
                      <button class="btn btn-primary btn-sm" type="submit">Approve & Publish</button>
                    </form>
                    <form method="post" action="/simple-lms/courses/<%= course._id %>/reject-public" class="inline-form">
                      <input class="input" type="text" name="reviewNotes" placeholder="Reason for draft return">
                      <button class="btn btn-danger btn-sm" type="submit">Return to Draft</button>
                    </form>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="panel">
        <div class="head"><div><h2>Commission Management</h2><p>Set global commission plus per-account and per-course overrides.</p></div></div>
        <div class="studio">
          <div class="stack">
            <form method="post" action="/simple-lms/commission/global" class="form-grid" style="border:1px solid var(--border);border-radius:10px;padding:10px;">
              <div><label>Global Creator Commission (%)</label><input class="input" type="number" name="globalRatePercent" min="0" max="100" step="0.01" value="<%= commissionSettings.globalRatePercent %>" required></div>
              <div style="align-self:end;"><button class="btn btn-primary btn-sm" type="submit">Save Global Rate</button></div>
            </form>

            <form method="post" action="/simple-lms/commission/account" class="form-grid" style="border:1px solid var(--border);border-radius:10px;padding:10px;">
              <div>
                <label>Account Override</label>
                <select class="input" name="accountId" required>
                  <option value="">Select account</option>
                  <% adminAccounts.forEach((account) => { %>
                    <option value="<%= account._id %>"><%= account.displayName %> - <%= account.email %></option>
                  <% }) %>
                </select>
              </div>
              <div><label>Commission Rate (%)</label><input class="input" type="number" name="ratePercent" min="0" max="100" step="0.01" required></div>
              <div style="align-self:end;"><button class="btn btn-primary btn-sm" type="submit">Save Account Override</button></div>
            </form>

            <form method="post" action="/simple-lms/commission/course" class="form-grid" style="border:1px solid var(--border);border-radius:10px;padding:10px;">
              <div>
                <label>Course Override</label>
                <select class="input" name="courseId" required>
                  <option value="">Select course</option>
                  <% managedCourses.forEach((course) => { %>
                    <option value="<%= course._id %>"><%= course.title %></option>
                  <% }) %>
                </select>
              </div>
              <div><label>Commission Rate (%)</label><input class="input" type="number" name="ratePercent" min="0" max="100" step="0.01" required></div>
              <div style="align-self:end;"><button class="btn btn-primary btn-sm" type="submit">Save Course Override</button></div>
            </form>
          </div>
          <aside class="stack">
            <article class="panel" style="padding:10px;">
              <div class="head"><div><h2>Account Overrides</h2></div></div>
              <% if (!commissionSettings.accountOverrides || commissionSettings.accountOverrides.length === 0) { %>
                <div class="empty">No account overrides.</div>
              <% } else { %>
                <div class="stack">
                  <% commissionSettings.accountOverrides.forEach((item) => { %>
                    <form method="post" action="/simple-lms/commission/account/remove" class="form-grid" style="border:1px solid var(--border);border-radius:10px;padding:10px;">
                      <input type="hidden" name="accountId" value="<%= item.accountId %>">
                      <div><label>Account</label><input class="input" value="<%= item.accountName %>" readonly></div>
                      <div><label>Rate</label><input class="input" value="<%= item.ratePercent %>%" readonly></div>
                      <div style="align-self:end;"><button class="btn btn-danger btn-sm" type="submit">Remove</button></div>
                    </form>
                  <% }) %>
                </div>
              <% } %>
            </article>
            <article class="panel" style="padding:10px;">
              <div class="head"><div><h2>Course Overrides</h2></div></div>
              <% if (!commissionSettings.courseOverrides || commissionSettings.courseOverrides.length === 0) { %>
                <div class="empty">No course overrides.</div>
              <% } else { %>
                <div class="stack">
                  <% commissionSettings.courseOverrides.forEach((item) => { %>
                    <form method="post" action="/simple-lms/commission/course/remove" class="form-grid" style="border:1px solid var(--border);border-radius:10px;padding:10px;">
                      <input type="hidden" name="courseId" value="<%= item.courseId %>">
                      <div><label>Course</label><input class="input" value="<%= item.courseTitle %>" readonly></div>
                      <div><label>Rate</label><input class="input" value="<%= item.ratePercent %>%" readonly></div>
                      <div style="align-self:end;"><button class="btn btn-danger btn-sm" type="submit">Remove</button></div>
                    </form>
                  <% }) %>
                </div>
              <% } %>
            </article>
          </aside>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><h2>Payment Tracking</h2><p>Recent Flutterwave transactions across all learners.</p></div></div>
        <div class="kpis">
          <article class="kpi"><small>Total Records</small><strong><%= paymentStats.totalCount %></strong></article>
          <article class="kpi"><small>Pending</small><strong><%= paymentStats.pendingCount %></strong></article>
          <article class="kpi"><small>Failed/Cancelled</small><strong><%= paymentStats.failedCount %></strong></article>
          <article class="kpi"><small>Flutterwave</small><strong><%= flutterwave.enabled ? 'Configured' : 'Not Set' %></strong></article>
        </div>
        <% if (!adminPayments || adminPayments.length === 0) { %>
          <div class="empty">No payment records yet.</div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Date</th><th>Learner</th><th>Course</th><th>Amount</th><th>Creator Commission</th><th>Platform Share</th><th>Status</th><th>Tx Ref</th><th>Provider Tx</th></tr></thead>
              <tbody>
                <% adminPayments.forEach((payment) => { %>
                  <tr>
                    <td><%= dateText(payment.createdAt) %></td>
                    <td><%= payment.learnerName %><br><span style="color:var(--muted);font-size:12px;"><%= payment.learnerEmail %></span></td>
                    <td><%= payment.courseTitle %></td>
                    <td><%= payment.amountDisplay %></td>
                    <td><%= payment.creatorCommissionDisplay %></td>
                    <td><%= payment.platformShareDisplay %></td>
                    <td><span class="pill"><%= payment.statusLabel %></span></td>
                    <td><%= payment.txRef %></td>
                    <td><%= payment.flutterwaveTxId || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>
  </main>

  <script>
    (() => {
      const fillCourseTemplate = document.getElementById('fillCourseTemplate')
      const createChaptersJson = document.getElementById('createChaptersJson')
      const preferredLessonDuration = Number(<%- JSON.stringify(Number(creatorDefaults.preferredLessonDurationMinutes || 12)) %>) || 12
      const createTemplatePayload = () => JSON.stringify([
        {
          title: 'Introduction',
          description: 'Course orientation',
          lessons: [
            { title: 'Welcome', description: 'Overview', durationMinutes: preferredLessonDuration, videoUrl: '', content: 'Welcome to this course.' }
          ]
        }
      ], null, 2)
      if (fillCourseTemplate && createChaptersJson) {
        fillCourseTemplate.addEventListener('click', () => {
          createChaptersJson.value = createTemplatePayload()
        })
        const autoLoadSample = <%- JSON.stringify(Boolean(creatorDefaults.autoLoadSampleCurriculum)) %>
        const currentChaptersValue = String(createChaptersJson.value || '').trim()
        if (autoLoadSample && (!currentChaptersValue || currentChaptersValue === '[]')) {
          createChaptersJson.value = createTemplatePayload()
        }
      }

      const fillProgramTemplate = document.getElementById('fillProgramTemplate')
      const createStepsJson = document.getElementById('createStepsJson')
      if (fillProgramTemplate && createStepsJson) {
        fillProgramTemplate.addEventListener('click', () => {
          createStepsJson.value = JSON.stringify([
            { courseId: '', required: true }
          ], null, 2)
        })
      }
    })()
  </script>
</body>
</html>
