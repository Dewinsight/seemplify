<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
  <style>
    .partner-shell {
      max-width: 1220px;
      margin: 24px auto 40px;
      padding: 0 16px;
      display: grid;
      grid-template-columns: 308px minmax(0, 1fr);
      gap: 22px;
    }
    .partner-side {
      --side-accent: #6d28d9;
      --side-accent-soft: rgba(139, 92, 246, .14);
      --side-accent-line: rgba(124, 58, 237, .16);
      position: sticky;
      top: 84px;
      align-self: start;
      border: 1px solid rgba(109, 40, 217, .12);
      border-radius: 24px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, .97), rgba(248, 241, 255, .94));
      box-shadow: 0 28px 48px -40px rgba(91, 33, 182, .26);
      padding: 18px;
      display: grid;
      gap: 16px;
    }
    .partner-side-header {
      display: grid;
      gap: 8px;
    }
    .partner-side-kicker {
      margin: 0;
      color: var(--side-accent);
      font-size: 11px;
      letter-spacing: .12em;
      text-transform: uppercase;
      font-weight: 800;
    }
    .partner-org {
      border: 1px solid var(--side-accent-line);
      border-radius: 18px;
      background:
        linear-gradient(160deg, rgba(245, 243, 255, .97), rgba(255, 255, 255, .99));
      padding: 14px;
      display: grid;
      gap: 8px;
    }
    .partner-org h2 {
      margin: 0;
      font-size: 28px;
      line-height: 1;
      color: var(--text);
      letter-spacing: -.04em;
    }
    .partner-org p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.55;
    }
    .partner-pill {
      width: fit-content;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid rgba(124, 58, 237, .18);
      border-radius: 999px;
      background: rgba(255, 255, 255, .84);
      color: #6d28d9;
      padding: 7px 12px;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .06em;
      font-weight: 700;
    }
    .partner-nav {
      display: grid;
      gap: 8px;
    }
    .partner-nav a {
      display: grid;
      grid-template-columns: 38px minmax(0, 1fr) 12px;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
      border: 1px solid transparent;
      border-radius: 18px;
      padding: 10px 12px;
      font-size: 13px;
      background: transparent;
      transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
    }
    .partner-nav a:hover {
      border-color: rgba(124, 58, 237, .16);
      background: rgba(245, 243, 255, .88);
      transform: translateX(2px);
    }
    .dashboard-nav-icon {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--side-accent);
      background: var(--side-accent-soft);
      border: 1px solid rgba(124, 58, 237, .1);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .5);
      flex-shrink: 0;
    }
    .dashboard-nav-icon svg {
      width: 18px;
      height: 18px;
    }
    .dashboard-nav-copy {
      min-width: 0;
      display: grid;
      gap: 2px;
    }
    .dashboard-nav-label {
      color: var(--text);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: -.02em;
    }
    .dashboard-nav-note {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .dashboard-nav-arrow {
      width: 12px;
      height: 12px;
      color: var(--side-accent);
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity .18s ease, transform .18s ease;
    }
    .partner-nav a.active {
      border-color: rgba(124, 58, 237, .18);
      background:
        linear-gradient(135deg, rgba(245, 243, 255, .98), rgba(255, 255, 255, .98));
      box-shadow: 0 16px 28px -24px rgba(124, 58, 237, .28);
    }
    .partner-nav a.active .dashboard-nav-label {
      color: var(--side-accent);
    }
    .partner-nav a.active .dashboard-nav-note {
      color: #6d28d9;
    }
    .partner-nav a.active .dashboard-nav-arrow {
      opacity: 1;
      transform: translateX(0);
    }
    .partner-main {
      display: grid;
      gap: 16px;
    }
    .panel {
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      padding: 16px;
      display: grid;
      gap: 12px;
    }
    .panel h1,
    .panel h2,
    .panel h3 {
      margin: 0;
      color: var(--text);
      letter-spacing: -.02em;
    }
    .panel p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.5;
    }
    .dashboard-hero {
      position: relative;
      overflow: hidden;
      grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr);
      align-items: stretch;
      gap: 16px;
      background:
        linear-gradient(135deg, rgba(109, 40, 217, 0.08), rgba(255, 255, 255, 0.96)),
        linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(247, 240, 255, 0.94));
    }
    .dashboard-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top right, rgba(168, 85, 247, 0.18), transparent 34%);
      pointer-events: none;
    }
    .dashboard-hero-copy,
    .dashboard-hero-media {
      position: relative;
      z-index: 1;
    }
    .dashboard-hero-copy {
      display: grid;
      gap: 14px;
      align-content: start;
    }
    .dashboard-hero-copy h1 {
      font-size: clamp(2rem, 4vw, 3.4rem);
      letter-spacing: -0.05em;
      line-height: 0.96;
    }
    .dashboard-hero-copy p {
      font-size: 15px;
      max-width: 60ch;
    }
    .dashboard-hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .dashboard-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid rgba(124, 58, 237, 0.14);
      background: rgba(255, 255, 255, 0.86);
      color: #5b21b6;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .dashboard-hero-media {
      min-height: 280px;
      border-radius: 22px;
      overflow: hidden;
      border: 1px solid rgba(124, 58, 237, 0.12);
      box-shadow: 0 28px 44px -34px rgba(109, 40, 217, 0.4);
    }
    .dashboard-hero-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
    .stat {
      border: 1px solid var(--border);
      border-radius: 12px;
      background: linear-gradient(160deg, rgba(255, 255, 255, .9), rgba(237, 233, 254, .72));
      padding: 12px;
      display: grid;
      gap: 5px;
    }
    .stat strong {
      color: var(--text);
      font-size: 24px;
      letter-spacing: -.02em;
      line-height: 1;
    }
    .stat span {
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      font-weight: 700;
    }
    .table-wrap {
      overflow: auto;
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 700px;
      background: var(--card-bg);
    }
    th,
    td {
      text-align: left;
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
      color: var(--text);
      vertical-align: top;
    }
    th {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
      background: rgba(148, 163, 184, .08);
      font-weight: 700;
    }
    .actions {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .actions form {
      margin: 0;
    }
    .inline-form {
      display: grid;
      gap: 10px;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
    .grid-two {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .field {
      display: grid;
      gap: 6px;
    }
    .field label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
      font-weight: 700;
    }
    .field input,
    .field select,
    .field textarea {
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--field-bg);
      color: var(--text);
      padding: 9px 10px;
      font-size: 13px;
    }
    .field textarea {
      min-height: 70px;
      resize: vertical;
    }
    .tiny {
      font-size: 12px;
      color: var(--muted);
    }
    .trend {
      display: grid;
      gap: 4px;
      max-height: 220px;
      overflow: auto;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 8px;
    }
    .trend-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      border: 1px solid rgba(148, 163, 184, .3);
      border-radius: 10px;
      padding: 8px 10px;
      background: rgba(255, 255, 255, .85);
      font-size: 12px;
      color: var(--text);
    }
    @media (max-width: 1024px) {
      .partner-shell {
        grid-template-columns: 1fr;
      }
      .partner-side {
        position: static;
      }
      .partner-nav {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .dashboard-hero {
        grid-template-columns: 1fr;
      }
      .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 640px) {
      .partner-nav {
        grid-template-columns: 1fr;
      }
      .partner-nav a {
        grid-template-columns: 34px minmax(0, 1fr) 12px;
        gap: 10px;
      }
      .dashboard-nav-icon {
        width: 34px;
        height: 34px;
      }
      .stats-grid,
      .grid-two,
      .inline-form {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <%- include('./partials/nav', { user, activePage, activeLmsView: '' }) %>

  <% const section = activeSection || 'overview' %>
  <% const sectionList = Array.isArray(availableSections) && availableSections.length > 0 ? availableSections : ['overview'] %>
  <% const hasSection = (value) => sectionList.includes(value) %>
  <% const metrics = dashboardData?.metrics || {} %>
  <% const payout = organization?.partnerSettings?.payoutProfile || {} %>
  <% const currentUserId = String(user?._id || '') %>
  <% const reportState = reportFilters || {} %>
  <% const partnerSections = [
    {
      key: 'overview',
      href: '/partner-dashboard?section=overview',
      label: 'Overview',
      note: 'Performance, course health, and sales totals',
      icon: 'overview',
      available: hasSection('overview')
    },
    {
      key: 'agents',
      href: '/partner-dashboard?section=agents',
      label: 'Agents',
      note: 'Invite, update, and monitor your sales team',
      icon: 'agents',
      available: hasSection('agents')
    },
    {
      key: 'courses',
      href: '/partner-dashboard?section=courses',
      label: 'Courses',
      note: 'Review partner-owned courses and drafts',
      icon: 'courses',
      available: hasSection('courses')
    },
    {
      key: 'reports',
      href: '/partner-dashboard?section=reports',
      label: 'Reports',
      note: 'Sales exports, churn metrics, and daily rollups',
      icon: 'reports',
      available: hasSection('reports')
    },
    {
      key: 'commissions',
      href: '/partner-dashboard?section=commissions',
      label: 'Commissions',
      note: 'Approve or trace agent payout recommendations',
      icon: 'commissions',
      available: hasSection('commissions')
    },
    {
      key: 'withdrawals',
      href: '/partner-dashboard?section=withdrawals',
      label: 'Withdrawals',
      note: 'Wallet balance, requests, and payment status',
      icon: 'wallet',
      available: hasSection('withdrawals')
    },
    {
      key: 'settings',
      href: '/partner-dashboard?section=settings',
      label: 'Settings',
      note: 'Org limits, commission defaults, and payout profile',
      icon: 'settings',
      available: hasSection('settings') && canRecommendAgentPayout
    }
  ] %>
  <% const renderPartnerNavIcon = (icon) => {
    switch (icon) {
      case 'overview':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13h6V4H4z"></path><path d="M14 20h6v-9h-6z"></path><path d="M14 4h6v5h-6z"></path><path d="M4 20h6v-3H4z"></path></svg>'
      case 'agents':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>'
      case 'courses':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5C4 5.12 5.12 4 6.5 4H20v14.5c0 .83-.67 1.5-1.5 1.5H6.5A2.5 2.5 0 0 1 4 17.5z"></path><path d="M8 4v16"></path><path d="M12 8h5"></path><path d="M12 12h5"></path></svg>'
      case 'reports':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="M7 14l4-4 3 3 5-7"></path></svg>'
      case 'commissions':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"></circle><path d="M12 7v10"></path><path d="M9 10.5c0-1.1 1.34-2 3-2s3 .9 3 2-1.34 2-3 2-3 .9-3 2 1.34 2 3 2 3-.9 3-2"></path></svg>'
      case 'wallet':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7H4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"></path><path d="M16 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v2"></path><path d="M22 12h-4"></path></svg>'
      case 'settings':
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15 1.65 1.65 0 0 0 3.09 14H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06A2 2 0 1 1 7.04 4.3l.06.06A1.65 1.65 0 0 0 8.92 4h.16A1.65 1.65 0 0 0 10 2.49V2a2 2 0 1 1 4 0v.49A1.65 1.65 0 0 0 14.92 4h.16a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c0 .66.39 1.26 1 1.51.18.07.37.1.56.1H21a2 2 0 1 1 0 4h-.04a1.65 1.65 0 0 0-1.56 1.39z"></path></svg>'
      default:
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>'
    }
  } %>
  <% const reportQuery = [] %>
  <% if (reportState.from) reportQuery.push(`from=${encodeURIComponent(reportState.from)}`) %>
  <% if (reportState.to) reportQuery.push(`to=${encodeURIComponent(reportState.to)}`) %>
  <% if (reportState.lookbackDays) reportQuery.push(`lookbackDays=${encodeURIComponent(reportState.lookbackDays)}`) %>
  <% if (reportState.agentId) reportQuery.push(`agentId=${encodeURIComponent(reportState.agentId)}`) %>
  <% if (reportState.courseId) reportQuery.push(`courseId=${encodeURIComponent(reportState.courseId)}`) %>
  <% const reportQueryString = reportQuery.join('&') %>
  <% const partnerSalesExportHref = `/api/reports/sales/export${reportQueryString ? `?${reportQueryString}` : ''}` %>
  <% const partnerCommissionExportHref = `/api/reports/commissions/export${reportQueryString ? `?${reportQueryString}` : ''}` %>

  <main class="partner-shell">
    <aside class="partner-side">
      <div class="partner-side-header">
        <p class="partner-side-kicker">Partner Control</p>
      </div>
      <article class="partner-org">
        <h2><%= organization?.name || 'Partner Organization' %></h2>
        <p><%= organization?.description || 'Manage agents, partner courses, and commission operations.' %></p>
        <span class="partner-pill"><%= organization?.partnerType || 'partner' %></span>
      </article>

      <nav class="partner-nav">
        <% partnerSections.filter((item) => item.available).forEach((item) => { %>
          <a href="<%= item.href %>" class="<%= section === item.key ? 'active' : '' %>">
            <span class="dashboard-nav-icon"><%- renderPartnerNavIcon(item.icon) %></span>
            <span class="dashboard-nav-copy">
              <span class="dashboard-nav-label"><%= item.label %></span>
              <span class="dashboard-nav-note"><%= item.note %></span>
            </span>
            <svg class="dashboard-nav-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 6h8"></path>
              <path d="M6 2l4 4-4 4"></path>
            </svg>
          </a>
        <% }) %>
      </nav>
    </aside>

    <section class="partner-main">
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
      <% if (info) { %><div class="alert"><%= info %></div><% } %>

      <% if (section === 'overview') { %>
        <article class="panel dashboard-hero">
          <div class="dashboard-hero-copy">
            <div class="dashboard-hero-badges">
              <span class="dashboard-hero-badge"><%= String(organization?.partnerType || 'partner').replace(/_/g, ' ') %></span>
              <span class="dashboard-hero-badge"><%= metrics.publishedCourseCount || 0 %> live courses</span>
              <span class="dashboard-hero-badge"><%= metrics.agentCount || 0 %> active agents</span>
            </div>
            <div>
              <h1>Partner Dashboard</h1>
              <p>Track organization performance, agent productivity, payout readiness, and publishing pressure from one aligned purple workspace.</p>
            </div>

            <div class="stats-grid">
              <div class="stat"><span>Agents</span><strong><%= metrics.agentCount || 0 %></strong></div>
              <div class="stat"><span>Total Sales</span><strong><%= formatCurrencyAmount(metrics.totalSalesMinor || 0, 'NGN') %></strong></div>
              <div class="stat"><span>Commissions Due</span><strong><%= formatCurrencyAmount(metrics.pendingCommissionMinor || 0, 'NGN') %></strong></div>
              <div class="stat"><span>Total Courses</span><strong><%= metrics.courseCount || 0 %></strong></div>
              <div class="stat"><span>Published</span><strong><%= metrics.publishedCourseCount || 0 %></strong></div>
              <div class="stat"><span>Draft Queue</span><strong><%= metrics.pendingDraftCount || 0 %></strong></div>
            </div>
          </div>
          <div class="dashboard-hero-media">
            <img src="/images/aiin-learning-hero-graphic-new.png" alt="AIIN Learning partner workspace">
          </div>
        </article>

        <article class="panel">
          <h2>Top Agents</h2>
          <% if (!dashboardData?.topAgents || dashboardData.topAgents.length === 0) { %>
            <p>No agent sales attributed yet.</p>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Agent</th>
                    <th>Email</th>
                    <th>Deals</th>
                    <th>Sales</th>
                    <th>Commission</th>
                  </tr>
                </thead>
                <tbody>
                  <% dashboardData.topAgents.forEach((row) => { %>
                    <tr>
                      <td><%= row.agent?.profile?.name || 'Agent' %></td>
                      <td><%= row.agent?.email || '-' %></td>
                      <td><%= row.salesCount %></td>
                      <td><%= formatCurrencyAmount(row.totalSalesMinor, 'NGN') %></td>
                      <td><%= formatCurrencyAmount(row.totalCommissionMinor, 'NGN') %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </article>
      <% } %>

      <% if (section === 'agents') { %>
        <article class="panel">
          <h2>Agent Management</h2>
          <p>Invite agents or assign existing accounts to your partner organization.</p>

          <% if (canManageAgents) { %>
            <form method="post" action="/partner-dashboard/agents/invite" class="inline-form">
              <div class="field">
                <label>Agent Email</label>
                <input type="email" name="email" required placeholder="agent@example.com">
              </div>
              <button class="btn btn-primary" type="submit">Invite / Add Agent</button>
            </form>
          <% } else { %>
            <p class="tiny">Your role cannot invite agents.</p>
          <% } %>
        </article>

        <article class="panel">
          <h3>Current Agents</h3>
          <% if (!agents || agents.length === 0) { %>
            <p>No agents are linked to this organization yet.</p>
          <% } else { %>
            <div class="table-wrap">
	              <table>
	                <thead>
	                  <tr>
	                    <th>Name</th>
	                    <th>Email</th>
	                    <th>Joined</th>
	                    <th>Payout Profile</th>
	                    <th>Commission Override (%)</th>
	                    <th>Actions</th>
	                  </tr>
	                </thead>
	                <tbody>
	                  <% agents.forEach((agent) => { %>
                    <tr>
                      <td><%= agent.profile?.name || 'Agent' %></td>
	                      <td><%= agent.email %></td>
	                      <td><%= new Date(agent.createdAt).toLocaleDateString() %></td>
	                      <td><%= agent.payoutProfile?.bankName && agent.payoutProfile?.accountNumber ? `${agent.payoutProfile.bankName} - ${agent.payoutProfile.accountNumber}` : 'Incomplete' %></td>
	                      <td>
	                        <% if (canManageAgentCommissionRates) { %>
	                          <form method="post" action="/partner-dashboard/agents/<%= agent._id %>/commission-rate" class="inline-form">
	                            <input
	                              class="input"
	                              type="number"
	                              name="ratePercent"
	                              min="0"
	                              max="100"
	                              step="0.01"
	                              value="<%= Number.isFinite(Number(agent.agentCommissionRate)) ? Number(agent.agentCommissionRate) : '' %>"
	                              placeholder="default"
	                            >
	                            <button class="btn btn-secondary btn-sm" type="submit">Save</button>
	                          </form>
	                        <% } else { %>
	                          <span class="tiny"><%= Number.isFinite(Number(agent.agentCommissionRate)) ? Number(agent.agentCommissionRate) : 'default' %></span>
	                        <% } %>
	                      </td>
	                      <td>
	                        <div class="actions">
	                          <% if (canRemoveAgents) { %>
	                            <form method="post" action="/partner-dashboard/agents/<%= agent._id %>/remove">
	                              <button class="btn btn-danger btn-sm" type="submit">Remove</button>
                            </form>
                          <% } else { %>
                            <span class="tiny">Add-only role</span>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </article>
      <% } %>

      <% if (section === 'courses') { %>
        <article class="panel">
          <h2>Partner Courses</h2>
          <p>Courses are scoped to your organization. Drafts can be approved by partner super users.</p>
          <a href="/simple-lms/studio/courses" class="btn btn-primary" style="width:fit-content;">Open Course Studio</a>
        </article>

        <article class="panel">
          <% if (!courses || courses.length === 0) { %>
            <p>No partner courses yet.</p>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Course</th>
                    <th>Status</th>
                    <th>Visibility</th>
                    <th>Price</th>
                    <th>Updated</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% courses.forEach((course) => { %>
                    <tr>
                      <td>
                        <strong><%= course.title %></strong><br>
                        <span class="tiny"><%= course.summary || 'No summary provided yet.' %></span>
                      </td>
                      <td><%= course.status %></td>
                      <td><%= course.visibility %></td>
                      <td><%= Number(course?.pricing?.amount || 0) > 0 ? formatCurrencyAmount(course.pricing.amount, course?.pricing?.currency || 'NGN') : 'Free' %></td>
                      <td><%= new Date(course.updatedAt).toLocaleDateString() %></td>
                      <td>
                        <div class="actions">
                          <% if (canApprovePartnerCourses && ['draft', 'pending_public_review'].includes(String(course.status || '').toLowerCase())) { %>
                            <form method="post" action="/partner-dashboard/courses/<%= course._id %>/approve">
                              <button class="btn btn-primary btn-sm" type="submit">Approve & Publish</button>
                            </form>
                            <form method="post" action="/partner-dashboard/courses/<%= course._id %>/reject">
                              <input type="hidden" name="reviewNotes" value="Returned to draft by partner reviewer.">
                              <button class="btn btn-danger btn-sm" type="submit">Return Draft</button>
                            </form>
                          <% } else { %>
                            <span class="tiny">No approval action</span>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </article>
      <% } %>

      <% if (section === 'reports') { %>
        <article class="panel">
          <h2>Sales & Churn Reports</h2>
          <p>Daily sales tracking, commission flow, and churn analytics for your partner organization.</p>
          <form method="get" action="/partner-dashboard" class="inline-form">
            <input type="hidden" name="section" value="reports">
            <div class="grid-two">
              <div class="field">
                <label>From</label>
                <input type="date" name="reportFrom" value="<%= reportState.from || '' %>">
              </div>
              <div class="field">
                <label>To</label>
                <input type="date" name="reportTo" value="<%= reportState.to || '' %>">
              </div>
              <div class="field">
                <label>Lookback (days)</label>
                <input type="number" min="1" max="365" name="reportLookbackDays" value="<%= Number(reportState.lookbackDays || 30) %>">
              </div>
              <div class="field">
                <label>Agent ID</label>
                <input type="text" name="reportAgentId" value="<%= reportState.agentId || '' %>" placeholder="Optional">
              </div>
              <div class="field">
                <label>Course ID</label>
                <input type="text" name="reportCourseId" value="<%= reportState.courseId || '' %>" placeholder="Optional">
              </div>
            </div>
            <div class="actions">
              <button class="btn btn-primary btn-sm" type="submit">Apply</button>
              <a class="btn btn-secondary btn-sm" href="/partner-dashboard?section=reports">Reset</a>
              <a class="btn btn-secondary btn-sm" href="<%= partnerSalesExportHref %>">Export Sales CSV</a>
              <a class="btn btn-secondary btn-sm" href="<%= partnerCommissionExportHref %>">Export Commissions CSV</a>
            </div>
          </form>
          <div class="stats-grid">
            <div class="stat"><span>Sales</span><strong><%= Number(partnerSalesReport?.summary?.saleCount || 0) %></strong></div>
            <div class="stat"><span>Gross Sales</span><strong><%= partnerSalesReport?.summary?.grossSalesDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></strong></div>
            <div class="stat"><span>Agent Commission</span><strong><%= partnerSalesReport?.summary?.agentCommissionDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></strong></div>
            <div class="stat"><span>Partner Earnings</span><strong><%= partnerSalesReport?.summary?.partnerEarningsDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></strong></div>
          </div>
          <% if (!partnerSalesReport?.rows || partnerSalesReport.rows.length === 0) { %>
            <p class="tiny">No daily sales data for this report window.</p>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Sales</th>
                    <th>Gross</th>
                    <th>Agent Commission</th>
                    <th>Partner Earnings</th>
                  </tr>
                </thead>
                <tbody>
                  <% partnerSalesReport.rows.forEach((entry) => { %>
                    <tr>
                      <td><%= entry.date %></td>
                      <td><%= Number(entry.saleCount || 0) %></td>
                      <td><%= entry.grossSalesDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></td>
                      <td><%= entry.agentCommissionDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></td>
                      <td><%= entry.partnerEarningsDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </article>
        <article class="panel">
          <h3>Churn Metrics</h3>
          <p>Agent attrition, time-to-first-sale, and learner drop-off indicators.</p>
          <div class="stats-grid">
            <div class="stat"><span>Active Agents</span><strong><%= Number(partnerChurnMetrics?.activeAgents || 0) %></strong></div>
            <div class="stat"><span>Removed Agents</span><strong><%= Number(partnerChurnMetrics?.removedAgents || 0) %></strong></div>
            <div class="stat"><span>Attrition</span><strong><%= Number(partnerChurnMetrics?.agentAttritionRatePercent || 0) %>%</strong></div>
            <div class="stat"><span>Time to First Sale</span><strong><%= Number(partnerChurnMetrics?.averageTimeToFirstSaleDays || 0) %>d</strong></div>
            <div class="stat"><span>At-Risk Enrollments</span><strong><%= Number(partnerChurnMetrics?.atRiskEnrollments || 0) %></strong></div>
            <div class="stat"><span>Learner Drop-Off</span><strong><%= Number(partnerChurnMetrics?.learnerDropOffRatePercent || 0) %>%</strong></div>
          </div>
        </article>
      <% } %>

	      <% if (section === 'commissions') { %>
        <article class="panel">
          <h2>Agent Commissions</h2>
          <p>Trace every attributed sale, current payout status, and commission values.</p>

          <% if (!commissions || commissions.length === 0) { %>
            <p>No commission entries yet.</p>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Agent</th>
                    <th>Course</th>
                    <th>Sale</th>
                    <th>Rate</th>
                    <th>Commission</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% commissions.forEach((entry) => { %>
                    <tr>
                      <td><%= entry.agent?.profile?.name || entry.agent?.email || 'Agent' %></td>
                      <td><%= entry.course?.title || 'Course' %></td>
                      <td><%= formatCurrencyAmount(entry.saleAmountMinor || 0, entry.currency || 'NGN') %></td>
                      <td><%= Number(entry.commissionRatePercent || 0) %>%</td>
                      <td><%= formatCurrencyAmount(entry.commissionAmountMinor || 0, entry.currency || 'NGN') %></td>
                      <td><%= entry.status %></td>
                      <td><%= new Date(entry.createdAt).toLocaleDateString() %></td>
                      <td>
                        <% if (canRecommendAgentPayout && ['pending', 'rejected'].includes(String(entry.status || '').toLowerCase())) { %>
                          <form method="post" action="/partner-dashboard/commissions/<%= entry._id %>/recommend">
                            <button class="btn btn-primary btn-sm" type="submit">Recommend for Payout</button>
                          </form>
                        <% } else { %>
                          <span class="tiny">No action</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
	        </article>
	      <% } %>

	      <% if (section === 'withdrawals') { %>
	        <article class="panel">
	          <h2>Partner Wallet</h2>
	          <p>Withdraw organization earnings from platform share after agent commissions.</p>
	          <div class="stats-grid">
	            <div class="stat"><span>Total Sales</span><strong><%= partnerWallet?.totalSalesDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></strong></div>
	            <div class="stat"><span>Agent Commissions</span><strong><%= partnerWallet?.totalAgentCommissionDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></strong></div>
	            <div class="stat"><span>Partner Earnings</span><strong><%= partnerWallet?.partnerEarningsDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></strong></div>
	            <div class="stat"><span>Pending Withdrawals</span><strong><%= partnerWallet?.pendingWithdrawalDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></strong></div>
	            <div class="stat"><span>Paid Out</span><strong><%= partnerWallet?.paidOutDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></strong></div>
	            <div class="stat"><span>Available Balance</span><strong><%= partnerWallet?.availableBalanceDisplay || formatCurrencyAmount(0, payout.currency || 'NGN') %></strong></div>
	          </div>
	        </article>

	        <article class="panel">
	          <h3>Request Withdrawal</h3>
	          <% if (canRequestPartnerWithdrawals) { %>
	            <form method="post" action="/partner-dashboard/withdrawals/request" style="display:grid; gap:10px;">
	              <div class="grid-two">
	                <div class="field">
	                  <label>Amount (<%= payout.currency || 'NGN' %>)</label>
	                  <input type="number" name="amount" min="0" step="0.01" required placeholder="0.00">
	                </div>
	                <div class="field">
	                  <label>Currency</label>
	                  <input type="text" name="currency" maxlength="3" value="<%= payout.currency || 'NGN' %>">
	                </div>
	              </div>
	              <div class="field">
	                <label>Notes</label>
	                <textarea name="notes" maxlength="1200" placeholder="Optional withdrawal context"></textarea>
	              </div>
	              <button class="btn btn-primary" type="submit" style="width:fit-content;">Submit Withdrawal Request</button>
	            </form>
	          <% } else { %>
	            <p class="tiny">Your role cannot submit organization withdrawal requests.</p>
	          <% } %>
	        </article>

	        <article class="panel">
	          <h3>Withdrawal Requests</h3>
	          <% if (!partnerWithdrawals || partnerWithdrawals.length === 0) { %>
	            <p>No partner withdrawal requests yet.</p>
	          <% } else { %>
	            <div class="table-wrap">
	              <table>
	                <thead>
	                  <tr>
	                    <th>Date</th>
	                    <th>Requested By</th>
	                    <th>Amount</th>
	                    <th>Status</th>
	                    <th>Review</th>
	                    <th>Actions</th>
	                  </tr>
	                </thead>
	                <tbody>
	                  <% partnerWithdrawals.forEach((request) => { %>
	                    <% const requestOwnerId = String(request.requestedBy?._id || request.requestedBy || '') %>
	                    <% const canCancelRequest = request.canCancel && (canRequestPartnerWithdrawals || requestOwnerId === currentUserId) %>
	                    <tr>
	                      <td><%= new Date(request.createdAt).toLocaleString() %></td>
	                      <td>
	                        <strong><%= request.requestedByName %></strong><br>
	                        <span class="tiny"><%= request.requestedBy?.email || '' %></span>
	                      </td>
	                      <td><%= request.amountDisplay %></td>
	                      <td><%= request.statusLabel %></td>
	                      <td>
	                        <span class="tiny">Reviewer: <%= request.reviewedByName || '-' %></span><br>
	                        <span class="tiny">Paid By: <%= request.paidByName || '-' %></span>
	                      </td>
	                      <td>
	                        <% if (canCancelRequest) { %>
	                          <form method="post" action="/partner-dashboard/withdrawals/<%= request._id %>/cancel">
	                            <button class="btn btn-danger btn-sm" type="submit">Cancel</button>
	                          </form>
	                        <% } else { %>
	                          <span class="tiny">No action</span>
	                        <% } %>
	                      </td>
	                    </tr>
	                  <% }) %>
	                </tbody>
	              </table>
	            </div>
	          <% } %>
	        </article>
	      <% } %>

	      <% if (section === 'settings') { %>
        <article class="panel">
          <h2>Partner Settings</h2>
          <form method="post" action="/partner-dashboard/settings" style="display:grid; gap:12px;">
            <div class="grid-two">
              <div class="field">
                <label>Max Agents (blank for unlimited)</label>
                <input type="number" min="1" name="maxAgents" value="<%= organization?.partnerSettings?.maxAgents || '' %>">
              </div>
              <div class="field">
                <label>Default Agent Commission (%)</label>
                <input type="number" min="0" max="100" step="0.01" name="defaultAgentCommissionRate" value="<%= organization?.partnerSettings?.defaultAgentCommissionRate ?? 10 %>">
              </div>
            </div>

            <div class="grid-two">
              <div class="field">
                <label>Partner Status</label>
                <select name="partnerStatus">
                  <option value="pending" <%= organization?.partnerSettings?.partnerStatus === 'pending' ? 'selected' : '' %>>Pending</option>
                  <option value="active" <%= organization?.partnerSettings?.partnerStatus === 'active' ? 'selected' : '' %>>Active</option>
                  <option value="suspended" <%= organization?.partnerSettings?.partnerStatus === 'suspended' ? 'selected' : '' %>>Suspended</option>
                </select>
              </div>
              <div class="field">
                <label>Invite Approval</label>
                <select name="agentInviteApproval">
                  <option value="on" <%= organization?.partnerSettings?.agentInviteApproval ? 'selected' : '' %>>Enabled</option>
                  <option value="off" <%= organization?.partnerSettings?.agentInviteApproval ? '' : 'selected' %>>Disabled</option>
                </select>
              </div>
            </div>

            <h3>Organization Payout Profile</h3>
            <div class="grid-two">
              <div class="field">
                <label>Account Name</label>
                <input type="text" name="payoutAccountName" value="<%= payout.accountName || '' %>">
              </div>
              <div class="field">
                <label>Account Number</label>
                <input type="text" name="payoutAccountNumber" value="<%= payout.accountNumber || '' %>">
              </div>
              <div class="field">
                <label>Bank Name</label>
                <input type="text" name="payoutBankName" value="<%= payout.bankName || '' %>">
              </div>
              <div class="field">
                <label>Bank Code</label>
                <input type="text" name="payoutBankCode" value="<%= payout.bankCode || '' %>">
              </div>
              <div class="field">
                <label>SWIFT Code</label>
                <input type="text" name="payoutSwiftCode" value="<%= payout.swiftCode || '' %>">
              </div>
              <div class="field">
                <label>Currency</label>
                <input type="text" name="payoutCurrency" maxlength="3" value="<%= payout.currency || 'NGN' %>">
              </div>
              <div class="field">
                <label>Payment Email</label>
                <input type="email" name="payoutEmail" value="<%= payout.paymentEmail || '' %>">
              </div>
              <div class="field">
                <label>Country</label>
                <input type="text" name="payoutCountry" value="<%= payout.country || '' %>">
              </div>
            </div>

            <div class="field">
              <label>Notes</label>
              <textarea name="payoutNotes"><%= payout.notes || '' %></textarea>
            </div>

            <button class="btn btn-primary" type="submit" style="width:fit-content;">Save Settings</button>
          </form>
        </article>
      <% } %>
    </section>
  </main>
</body>
</html>

