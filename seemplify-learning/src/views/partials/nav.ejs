<%
  const safeUser = typeof user !== 'undefined' ? user : null
  const safeActivePage = typeof activePage === 'string' ? activePage : ''
  const safeActiveLmsView = typeof activeLmsView === 'string' ? activeLmsView : ''
  const safeUserRole = String(safeUser?.learningRole || safeUser?.role || '').trim().toLowerCase()
  const canAccessAdmin = Boolean(
    safeUser
    && (
      safeUser.isSuperAdmin
      || safeUser.isSystemAdmin
      || ['super_admin', 'admin'].includes(safeUserRole)
    )
  )
  const currentBrandKey = typeof brandKey === 'string' && brandKey.trim() ? brandKey.trim() : 'seemplify'
  const brandDisplayName = typeof brandLearningName === 'string' && brandLearningName.trim()
    ? brandLearningName.trim()
    : 'Seemplify Learning'
  const isAiinBrand = currentBrandKey === 'aiin'
  const defaultTeachBrand = isAiinBrand ? 'AIIN Nigeria' : 'Seemplify'
  const teachNavLabel = typeof teachLabel === 'string' && teachLabel.trim()
    ? teachLabel.trim()
    : `Teach on ${defaultTeachBrand}`
%>

<input type="checkbox" id="mobile-nav-toggle" class="mobile-nav-checkbox">
<label for="mobile-nav-toggle" class="mobile-nav-overlay" aria-label="Close menu"></label>

<aside class="mobile-drawer">
  <label for="mobile-nav-toggle" class="mobile-drawer-close" aria-label="Close menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 6L6 18M6 6l12 12" />
    </svg>
  </label>

  <div class="mobile-drawer-links">
    <a href="/courses" class="top-nav-link<%= ['home', 'courses'].includes(safeActivePage) ? ' active' : '' %>">Explore Courses</a>
    <a href="/teach" class="top-nav-link<%= safeActivePage === 'teach' ? ' active' : '' %>"><%= teachNavLabel %></a>
    <% if (safeUser) { %>
      <a href="/simple-lms" class="top-nav-link<%= safeActivePage === 'simple-lms' && safeActiveLmsView !== 'settings' ? ' active' : '' %>">Learning Workspace</a>
      <a href="/simple-lms?view=settings" class="top-nav-link<%= safeActiveLmsView === 'settings' ? ' active' : '' %>">Settings</a>
      <% if (canAccessAdmin) { %>
        <a href="/admin" class="top-nav-link<%= safeActivePage === 'admin' ? ' active' : '' %>">Admin</a>
      <% } %>
    <% } %>
  </div>

  <div class="mobile-drawer-user">
    <% if (safeUser) { %>
      <div class="top-nav-user-info">
        <div class="top-nav-user-name"><%= safeUser.profile?.name || safeUser.email %></div>
        <div class="top-nav-user-email"><%= safeUser.email %></div>
      </div>
      <a href="/logout" class="top-nav-logout">Sign out</a>
    <% } else { %>
      <a href="/login" class="btn btn-secondary">Sign in</a>
      <a href="/register" class="btn btn-primary">Create account</a>
    <% } %>
  </div>
</aside>

<nav class="top-nav">
  <div class="top-nav-inner">
    <a href="/" class="top-nav-brand">
      <% if (isAiinBrand) { %>
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <defs>
            <linearGradient id="aiinLearningGradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0ea5e9" />
              <stop offset="52%" stop-color="#14b8a6" />
              <stop offset="100%" stop-color="#6366f1" />
            </linearGradient>
          </defs>
          <rect x="14" y="14" width="72" height="72" rx="18" fill="rgba(15,23,42,.15)" stroke="url(#aiinLearningGradient)" stroke-width="6" />
          <path d="M31 70L45 31L59 70" stroke="url(#aiinLearningGradient)" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M36 56H54" stroke="url(#aiinLearningGradient)" stroke-width="6" fill="none" stroke-linecap="round" />
          <path d="M69 34V70" stroke="url(#aiinLearningGradient)" stroke-width="7" fill="none" stroke-linecap="round" />
          <circle cx="69" cy="24" r="4.5" fill="url(#aiinLearningGradient)" />
        </svg>
      <% } else { %>
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <defs>
            <linearGradient id="seemplifyLearningGradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#10b981" />
              <stop offset="50%" stop-color="#2dd4bf" />
              <stop offset="100%" stop-color="#6366f1" />
            </linearGradient>
          </defs>
          <path d="M 65 25 Q 75 25 75 35 Q 75 45 65 45 Q 50 50 35 55 Q 25 55 25 65 Q 25 75 35 75"
            stroke="url(#seemplifyLearningGradient)" stroke-width="8" fill="none" stroke-linecap="round"
            stroke-linejoin="round" />
          <circle cx="65" cy="25" r="6" class="logo-dot" />
          <circle cx="50" cy="50" r="6" class="logo-dot" />
          <circle cx="35" cy="75" r="6" class="logo-dot" />
        </svg>
      <% } %>
      <span><%= brandDisplayName %></span>
    </a>

    <div class="top-nav-center">
      <div class="top-nav-links">
        <a href="/courses" class="top-nav-link<%= ['home', 'courses'].includes(safeActivePage) ? ' active' : '' %>">Explore Courses</a>
        <a href="/teach" class="top-nav-link<%= safeActivePage === 'teach' ? ' active' : '' %>"><%= teachNavLabel %></a>
        <% if (safeUser) { %>
          <a href="/simple-lms" class="top-nav-link<%= safeActivePage === 'simple-lms' && safeActiveLmsView !== 'settings' ? ' active' : '' %>">Learning Workspace</a>
          <% if (canAccessAdmin) { %>
            <a href="/admin" class="top-nav-link<%= safeActivePage === 'admin' ? ' active' : '' %>">Admin</a>
          <% } %>
        <% } %>
      </div>
    </div>

    <div class="top-nav-actions">
      <% if (safeUser) { %>
        <a href="/simple-lms/cart" class="top-nav-icon-link<%= safeActiveLmsView === 'cart' ? ' active' : '' %>" aria-label="Shopping cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <% if (typeof simpleLmsCartCount === 'number' && simpleLmsCartCount > 0) { %>
            <span class="top-nav-badge"><%= simpleLmsCartCount %></span>
          <% } %>
        </a>
        <a href="/simple-lms?view=settings" class="top-nav-icon-link<%= safeActiveLmsView === 'settings' ? ' active' : '' %>" aria-label="Open settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </a>
      <% } %>

      <% if (safeUser) { %>
        <div class="top-nav-user">
          <div class="top-nav-user-info">
            <div class="top-nav-user-name"><%= safeUser.profile?.name || safeUser.email %></div>
            <div class="top-nav-user-email"><%= safeUser.email %></div>
          </div>
          <a href="/logout" class="btn btn-secondary btn-sm">Sign out</a>
        </div>
      <% } else { %>
        <div class="top-nav-user top-nav-user-guest">
          <a href="/login" class="top-nav-signin">Sign in</a>
          <a href="/register" class="btn btn-primary btn-sm">Create account</a>
        </div>
      <% } %>
    </div>

    <label for="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </label>
  </div>
</nav>
