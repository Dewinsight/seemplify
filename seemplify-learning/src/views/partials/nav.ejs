<%
  const safeUser = typeof user !== 'undefined' ? user : null
  const safeAccessProfile = typeof accessProfile !== 'undefined' ? accessProfile : null
  const safeActivePage = typeof activePage === 'string' ? activePage : ''
  const safeActiveLmsView = typeof activeLmsView === 'string' ? activeLmsView : ''
  const safeUserRole = String(safeUser?.learningRole || safeUser?.role || '').trim().toLowerCase()
  const canAccessAdmin = Boolean(
    safeUser && (
      safeAccessProfile?.platformRole
      || safeUser.isSuperAdmin
      || safeUser.isSystemAdmin
      || ['super_admin', 'admin'].includes(safeUserRole)
    )
  )
  const canAccessPartnerDashboard = Boolean(
    safeUser && (
      safeAccessProfile?.partnerAccess
      || ['channel_partner_super', 'channel_partner_user', 'partner_super', 'partner_user'].includes(safeUserRole)
    )
  )
  const canAccessAgentDashboard = Boolean(
    safeUser && (
      safeAccessProfile?.agentAccess
      || safeUserRole === 'channel_sales_agent'
    )
  )
  const canSwitchWorkspace = Boolean(safeUser && safeAccessProfile?.hasMultiplePrivilegedDashboards)
  const safeOrganizationLearningAccess = typeof organizationLearningAccess !== 'undefined'
    ? organizationLearningAccess
    : null
  const canAccessOrganizationLearning = Boolean(
    safeUser
    && safeOrganizationLearningAccess?.enabled
    && (
      safeOrganizationLearningAccess.canCreateCourses
      || safeOrganizationLearningAccess.canAssignCourses
      || safeOrganizationLearningAccess.canManageLearning
    )
  )
  const currentBrandKey = typeof brandKey === 'string' && brandKey.trim() ? brandKey.trim() : 'seemplify'
  const isAiinBrand = currentBrandKey === 'aiin'
  const brandDisplayName = isAiinBrand
    ? 'AIIN Learning'
    : (typeof brandLearningName === 'string' && brandLearningName.trim()
      ? brandLearningName.trim()
      : 'Seemplify Learning')
  const teachNavLabel = `Teach on ${isAiinBrand ? 'AIIN Nigeria' : 'Seemplify'}`
  const formatRoleLabel = (value, fallback = 'Learner') => {
    const normalized = String(value || '').trim()
    if (!normalized) return fallback
    return normalized
      .split('_')
      .filter(Boolean)
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(' ')
  }
  const safeUserDisplayName = safeUser?.profile?.name || safeUser?.email || ''
  const safeUserInitials = safeUserDisplayName
    ? safeUserDisplayName
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((part) => part.charAt(0).toUpperCase())
      .join('')
      .slice(0, 2)
    : 'U'
  const desktopRoleLabel = (() => {
    if (!safeUser) return ''
    if (safeActivePage === 'admin') {
      return formatRoleLabel(safeAccessProfile?.platformRole || (safeUser.isSuperAdmin ? 'super_admin' : 'admin'), 'Admin')
    }
    if (safeActivePage === 'partner-dashboard') {
      return formatRoleLabel(safeAccessProfile?.partnerAccess?.dashboardRole || safeUserRole, 'Partner')
    }
    if (safeActivePage === 'agent-dashboard') {
      return 'Agent'
    }
    if (safeUserRole === 'creator') {
      return 'Creator'
    }
    return 'Learner'
  })()
%>

<a class="ui-skip" href="#main-content">Skip to content</a>
<button class="ui-backdrop" type="button" data-ui-backdrop hidden aria-label="Close navigation"></button>
<aside class="ui-public-drawer" id="learning-navigation" data-ui-drawer aria-label="Learning navigation">
  <header><strong><%= brandDisplayName %></strong><button type="button" class="ui-button ui-button-ghost ui-button-icon ui-drawer-close" data-ui-close aria-label="Close navigation"><%- include('./ui-icon', { icon: 'close' }) %></button></header>
  <nav aria-label="Mobile navigation">
    <a href="/courses" <% if (safeActivePage === 'courses') { %>aria-current="page"<% } %>><%- include('./ui-icon', { icon: 'courses' }) %>Courses</a>
    <a href="/teach"><%- include('./ui-icon', { icon: 'plus' }) %>Teach on <%= isAiinBrand ? 'AIIN Nigeria' : 'Seemplify' %></a>
    <% if (safeUser) { %>
      <a href="/simple-lms"><%- include('./ui-icon', { icon: 'overview' }) %>My learning</a>
      <a href="/simple-lms?view=settings"><%- include('./ui-icon', { icon: 'settings' }) %>Settings</a>
      <% if (canAccessAdmin) { %><a href="/admin"><%- include('./ui-icon', { icon: 'shield' }) %>Administration</a><% } %>
      <% if (canAccessOrganizationLearning) { %><a href="/organization-learning"><%- include('./ui-icon', { icon: 'partners' }) %>Organisation learning</a><% } %>
      <% if (canAccessPartnerDashboard) { %><a href="/partner-dashboard"><%- include('./ui-icon', { icon: 'partners' }) %>Partner dashboard</a><% } %>
      <% if (canAccessAgentDashboard) { %><a href="/agent-dashboard"><%- include('./ui-icon', { icon: 'analytics' }) %>Agent dashboard</a><% } %>
      <% if (canSwitchWorkspace) { %><a href="/choose-workspace"><%- include('./ui-icon', { icon: 'overview' }) %>Switch workspace</a><% } %>
      <a href="/logout"><%- include('./ui-icon', { icon: 'logout' }) %>Sign out</a>
    <% } else { %>
      <a href="/login">Sign in</a><a href="/register">Create account</a>
    <% } %>
  </nav>
</aside>
<header class="ui-header">
  <div class="ui-header-inner">
    <button class="ui-button ui-button-ghost ui-button-icon ui-mobile-trigger" type="button" data-ui-menu aria-controls="learning-navigation" aria-expanded="false" aria-label="Open navigation"><%- include('./ui-icon', { icon: 'menu' }) %></button>
    <a href="/" class="ui-brand"><img src="<%= isAiinBrand ? '/images/aiin_logo.png' : '/images/seemplify-favicon.svg' %>" alt=""><span><strong><%= isAiinBrand ? 'AIIN' : 'Seemplify' %></strong><small>Learning</small></span></a>
    <nav class="ui-header-nav" aria-label="Main navigation">
      <a href="/courses" <% if (safeActivePage === 'courses') { %>aria-current="page"<% } %>>Courses</a>
      <a href="/teach" <% if (safeActivePage === 'teach') { %>aria-current="page"<% } %>>Teach on <%= isAiinBrand ? 'AIIN Nigeria' : 'Seemplify' %></a>
      <% if (safeUser) { %><a href="/simple-lms" <% if (safeActivePage === 'simple-lms') { %>aria-current="page"<% } %>>My learning</a><% } %>
    </nav>
    <div class="ui-header-actions">
      <%- include('./ui-theme') %>
      <% if (safeUser) { %>
        <a href="/simple-lms/cart" class="ui-button ui-button-ghost ui-button-icon" aria-label="Shopping cart<%= typeof simpleLmsCartCount === 'number' && simpleLmsCartCount > 0 ? `, ${simpleLmsCartCount} courses` : '' %>"><%- include('./ui-icon', { icon: 'cart' }) %></a>
        <details class="ui-account"><summary aria-label="Account menu for <%= safeUserDisplayName %>"><%= safeUserInitials %></summary><div class="ui-account-menu">
          <header><strong><%= safeUserDisplayName %></strong><span><%= safeUser.email %></span></header>
          <a href="/simple-lms?view=settings"><%- include('./ui-icon', { icon: 'settings' }) %>Settings</a>
          <% if (canAccessAdmin) { %><a href="/admin"><%- include('./ui-icon', { icon: 'shield' }) %>Administration</a><% } %>
          <% if (canAccessOrganizationLearning) { %><a href="/organization-learning"><%- include('./ui-icon', { icon: 'partners' }) %>Organisation learning</a><% } %>
          <% if (canAccessPartnerDashboard) { %><a href="/partner-dashboard"><%- include('./ui-icon', { icon: 'partners' }) %>Partner dashboard</a><% } %>
          <% if (canAccessAgentDashboard) { %><a href="/agent-dashboard"><%- include('./ui-icon', { icon: 'analytics' }) %>Agent dashboard</a><% } %>
          <% if (canSwitchWorkspace) { %><a href="/choose-workspace"><%- include('./ui-icon', { icon: 'overview' }) %>Switch workspace</a><% } %>
          <a href="/logout"><%- include('./ui-icon', { icon: 'logout' }) %>Sign out</a>
        </div></details>
      <% } else { %>
        <a href="/login" class="ui-button ui-button-ghost">Sign in</a>
        <a href="/register" class="ui-button ui-button-primary ui-header-register">Get started</a>
      <% } %>
    </div>
  </div>
</header>
