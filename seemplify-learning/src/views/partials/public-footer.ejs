<%
  const footerBrandKey = typeof brandKey === 'string' && brandKey.trim()
    ? brandKey.trim()
    : 'seemplify'
  const isAiinFooter = footerBrandKey === 'aiin'
  const footerBrandName = typeof brandName === 'string' && brandName.trim()
    ? brandName.trim()
    : (isAiinFooter ? 'AIIN' : 'Seemplify')
  const footerLearningName = typeof brandLearningName === 'string' && brandLearningName.trim()
    ? brandLearningName.trim()
    : `${footerBrandName} Learning`
  const footerTeachBrand = typeof teachBrand === 'string' && teachBrand.trim()
    ? teachBrand.trim()
    : (isAiinFooter ? 'AIIN Nigeria' : footerBrandName)
%>
<footer class="lmsv-footer"><div class="ui-footer-inner">
  <p>&copy; <%= new Date().getFullYear() %> <%= footerLearningName %></p>
  <nav aria-label="Footer navigation"><a href="/courses">Course catalogue</a><a href="/teach">Creator guide</a><a href="/simple-lms">My learning</a></nav>
</div></footer>
