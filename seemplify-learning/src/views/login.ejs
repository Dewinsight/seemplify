<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=3"></script>
  <style>
    .auth-wrap {
      max-width: 460px;
      margin: 48px auto;
      padding: 20px;
    }
    .auth-card {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      padding: 20px;
      display: grid;
      gap: 12px;
    }
    .auth-title {
      margin: 0;
      color: var(--text);
      font-size: 28px;
      letter-spacing: -0.02em;
    }
    .auth-subtitle {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
    }
    .auth-card label {
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .auth-card .input {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--field-bg);
      color: var(--text);
      padding: 10px 12px;
      font-size: 14px;
    }
    .auth-card .input:focus {
      outline: none;
      border-color: rgba(56, 189, 248, .7);
      box-shadow: 0 0 0 2px rgba(56, 189, 248, .18);
    }
    .auth-footer {
      margin-top: 8px;
      color: var(--muted);
      font-size: 13px;
    }
    .auth-sso {
      display: grid;
      gap: 10px;
    }
    .auth-sso-button {
      width: 100%;
      justify-content: center;
      gap: 9px;
    }
    .auth-sso-button svg {
      width: 17px;
      height: 17px;
    }
    .auth-divider {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 10px;
      align-items: center;
      color: var(--muted);
      font-size: 12px;
    }
    .auth-divider::before,
    .auth-divider::after {
      content: '';
      height: 1px;
      background: var(--border);
    }
  </style>
  <link rel="icon" type="image/svg+xml" href="<%= typeof brandKey === 'string' && brandKey === 'aiin' ? '/images/aiin_logo.png' : '/images/seemplify-favicon.svg' %>">
  <link rel="stylesheet" href="/css/seemplify-brand.css?v=20260811-1">
</head>
<body>
  <div class="auth-wrap">
    <a href="/" class="auth-brand"><%- include('./partials/brand-lockup', { brandKey, brandLearningName }) %></a>
    <div class="auth-card">
      <h1 class="auth-title"><%= brandLearningName || 'Seemplify Learning' %></h1>
      <p class="auth-subtitle">
        <%= loginMode === 'admin'
          ? 'Sign in to the LMS admin control center.'
          : (String(returnTo || '').startsWith('/teach')
            ? 'Sign in to continue your course setup.'
            : 'Sign in to your learning workspace.') %>
      </p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <% if (typeof idpLoginEnabled !== 'undefined' && idpLoginEnabled) { %>
        <div class="auth-sso">
          <a class="btn btn-secondary auth-sso-button" href="<%= idpLoginUrl || '/auth/seemplify' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 3a9 9 0 1 0 9 9"></path>
              <path d="M12 3v9h9"></path>
            </svg>
            Continue with Seemplify
          </a>
          <div class="auth-divider">or use your Learning account</div>
        </div>
      <% } %>

      <form method="post" action="/login" style="display:grid; gap:10px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <input type="hidden" name="return_to" value="<%= returnTo || '/simple-lms?view=my-learning' %>">
        <label>Email</label>
        <input class="input" type="email" name="email" required placeholder="you@company.com">

        <label>Password</label>
        <input class="input" type="password" name="password" required placeholder="Your password">

        <button class="btn btn-primary" type="submit">Sign in</button>
      </form>

      <p class="auth-footer">No account yet? <a href="<%= registerUrl || '/register' %>">Create one</a></p>
      <p class="auth-footer"><a href="<%= forgotPasswordUrl || '/forgot-password' %>">Forgot password?</a></p>
    </div>
  </div>
</body>
</html>
