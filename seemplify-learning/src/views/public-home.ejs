<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/public-lms.css?v=20260304-2">
  <link rel="stylesheet" href="/css/public-lms-refresh.css?v=20260304-11">
  <script src="/js/theme.js?v=2"></script>
</head>
<body class="public-site public-home-page">
  <%- include('./partials/nav', { user, activePage, activeLmsView: '', brandKey: 'aiin', brandLearningName: 'AIIN Learning', teachBrand: 'AIIN Nigeria' }) %>

  <%
    const courseHref = (course) => `/courses/${course._id}${course.slug ? `/${course.slug}` : ''}`
    const highlightCourses = Array.isArray(featuredCourses) ? featuredCourses.slice(0, 6) : []
    const leadCourse = highlightCourses[0] || null
    const heroGraphicImage = '/images/aiin-learning-hero-graphic-new.png?v=20260318'
    const showPartnerHeroImage = typeof partnerMode !== 'undefined' && partnerMode === true
    let learnerImage = '/images/aiin-learner-collab.jpg'
    let creatorImage = '/images/aiin-creator-collab.jpg'
    if (!showPartnerHeroImage) {
      learnerImage = 'https://images.unsplash.com/photo-1513258496099-48168024aec0?auto=format&fit=crop&w=1300&q=80'
      creatorImage = 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1300&q=80'
    }
    const fallbackCourseVisuals = [
      'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=80'
    ]
    const categoryVisualHints = [
      { match: ['data', 'analytics', 'ai', 'machine', 'science'], image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=80' },
      { match: ['project', 'management', 'leadership', 'business'], image: 'https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80' },
      { match: ['communication', 'professional', 'soft'], image: 'https://images.unsplash.com/photo-1573497019236-61f323342eb1?auto=format&fit=crop&w=1200&q=80' },
      { match: ['engineering', 'dev', 'code', 'software'], image: 'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=1200&q=80' }
    ]
    const courseImageFor = (course, index) => {
      if (course?.banner?.url) return course.banner.url
      const normalizedCategory = String(course?.category || '').toLowerCase()
      const match = categoryVisualHints.find((entry) => entry.match.some((term) => normalizedCategory.includes(term)))
      if (match?.image) return match.image
      return fallbackCourseVisuals[index % fallbackCourseVisuals.length]
    }
    const formatDuration = (minutes) => {
      const total = Number.isFinite(Number(minutes)) ? Number(minutes) : 0
      if (total >= 60) {
        const hours = Math.floor(total / 60)
        const remain = total % 60
        return remain > 0 ? `${hours}h ${remain}m` : `${hours}h`
      }
      return `${Math.max(0, Math.round(total))}m`
    }
  %>

  <div class="lmsv-home-hero-band" style="background:#090B19; overflow: hidden; position: relative; width: 100vw; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); min-height: 540px; display: flex; align-items: center; padding-bottom: 80px;">
  
    <!-- Right Side Img Full Height with Fade -->
    <div class="lmsv-home-hero-image-panel" style="position: absolute; top: 0; right: 0; bottom: 0; width: 60%; z-index: 1;">
      <!-- Gradient overlay to fade left side to #090B19 -->
      <div class="lmsv-home-hero-image-fade" style="position: absolute; inset: 0; background: linear-gradient(to right, #090B19 0%, rgba(9,11,25,0) 40%); z-index: 2;"></div>
      <!-- Mask image fading bottom to match dark overlapping bottom, but actually overlap card is just above -->
      <img src="<%= heroGraphicImage %>" alt="Learners collaborating" style="width: 100%; height: 100%; object-fit: cover; object-position: center;">
      
      <!-- Floating Widgets -->
      <div class="lmsv-home-hero-widget lmsv-home-hero-widget-growth" style="position: absolute; top: 80px; right: 12%; z-index: 3; border-radius: 12px; border: 1px solid rgba(255,255,255,0.15); background: rgba(30, 41, 59, 0.4); backdrop-filter: blur(12px); padding: 12px 16px; display: flex; align-items: center; gap: 12px; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);">
        <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(168, 85, 247, 0.2); color: #d8b4fe; display: flex; align-items: center; justify-content: center;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="4" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="20" y1="20" x2="20" y2="13"></line></svg>
        </div>
        <div>
          <div style="color: #ffffff; font-size: 14px; font-weight: 700; line-height: 1.2;">Progress +24%</div>
          <div style="color: #cbd5e1; font-size: 11px; line-height: 1.2; margin-top: 2px;">Learning growth this month</div>
        </div>
      </div>
  
      <div class="lmsv-home-hero-widget lmsv-home-hero-widget-cert" style="position: absolute; bottom: 140px; left: 15%; z-index: 3; border-radius: 12px; border: 1px solid rgba(255,255,255,0.15); background: rgba(30, 41, 59, 0.4); backdrop-filter: blur(12px); padding: 12px 16px; display: flex; align-items: center; gap: 12px; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);">
        <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(168, 85, 247, 0.2); color: #d8b4fe; display: flex; align-items: center; justify-content: center;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4-8 4-8-4 8-4z"></path><path d="M4 11l8 4 8-4"></path><path d="M10 15v4l2 2 2-2v-4"></path></svg>
        </div>
        <div>
          <div style="color: #ffffff; font-size: 14px; font-weight: 700; line-height: 1.2;">Certificate Ready</div>
          <div style="color: #cbd5e1; font-size: 11px; line-height: 1.2; margin-top: 2px;">Career credentials in view</div>
        </div>
      </div>
    </div>
  
    <main class="lmsv-home-hero-copy-shell" style="max-width: 1320px; margin: 0 auto; width: 100%; position: relative; z-index: 2; padding: 0 24px;">
      <div style="max-width: 600px; padding: 60px 0;">
        <div style="display: flex; gap: 10px; margin-bottom: 24px;">
          <span style="background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.3); color: #e9d5ff; padding: 4px 12px; border-radius: 999px; font-size: 10px; font-weight: 800; letter-spacing: 0.08em;">LAUNCH</span>
          <span style="background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.3); color: #e9d5ff; padding: 4px 12px; border-radius: 999px; font-size: 10px; font-weight: 800; letter-spacing: 0.08em;">CAREER</span>
          <span style="background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.3); color: #e9d5ff; padding: 4px 12px; border-radius: 999px; font-size: 10px; font-weight: 800; letter-spacing: 0.08em;">CREATOR</span>
        </div>
        <h1 style="color: #ffffff; font-size: clamp(40px, 5vw, 56px); line-height: 1.1; font-weight: 700; margin-bottom: 12px; letter-spacing: -0.02em;">
          Learn with clarity.<br>
          <span style="color: #a855f7;">Build with confidence.</span>
        </h1>
        <p style="font-size: 16px; color: #cbd5e1; line-height: 1.6; max-width: 46ch; margin-bottom: 32px;">
          Nigeria's premier platform for practical skill development.<br>
          Launch your career, grow your expertise, or create courses<br>
          that impact thousands.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 16px;">
          <a href="/courses" style="background: #a855f7; border: 1px solid #a855f7; color: #ffffff; padding: 12px 24px; border-radius: 10px; font-weight: 600; font-size: 15px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s;">Explore Courses <span aria-hidden="true">&rarr;</span></a>
          <a href="/teach" style="background: rgba(15, 23, 42, 0.5); color: #f8fafc; border: 1px solid rgba(255, 255, 255, 0.15); font-weight: 600; font-size: 15px; border-radius: 10px; padding: 12px 24px; text-decoration: none; display: inline-flex; align-items: center; transition: all 0.2s;">Start Teaching</a>
        </div>
      </div>
    </main>
  </div>

<main class="lmsv-shell">
  <div class="lmsv-hero-overlap-wrapper" style="margin-top: -100px; position: relative; z-index: 20;">
      <div class="lmsv-surface-card lmsv-hero-overlap-card lmsv-fade-up lmsv-delay-3">
        <div class="lmsv-overlap-stats">
          <div class="lmsv-pulse-row">
            <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#a855f7" stroke-width="1.5" style="margin-right:8px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg> PUBLISHED COURSES</span>
            <strong><%= totalCourses %></strong>
          </div>
          <div class="lmsv-overlap-divider"></div>
          <div class="lmsv-pulse-row">
            <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#a855f7" stroke-width="1.5" style="margin-right:8px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg> TOTAL LESSONS</span>
            <strong><%= totalLessons %></strong>
          </div>
          <div class="lmsv-overlap-divider"></div>
          <div class="lmsv-pulse-row">
            <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#a855f7" stroke-width="1.5" style="margin-right:8px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> LEARNING HOURS</span>
            <strong><%= totalDurationHours %></strong>
          </div>
        </div>
        
        <div class="lmsv-overlap-featured">
          <% if (leadCourse) { %>
            <div class="lmsv-featured-header">
              <span class="lmsv-kicker-pill lmsv-kicker-start">START HERE</span>
              <span class="lmsv-kicker-pill lmsv-kicker-hot">MOST POPULAR</span>
            </div>
            <h3 style="font-size: 18px; line-height: 1.3; margin: 12px 0 16px;"><%= leadCourse.title %></h3>
            <div class="lmsv-featured-footer">
              <div class="lmsv-pill-row lmsv-pill-row-muted" style="gap: 8px; margin-bottom: 24px;">
                <span style="font-size: 11px; padding: 4px 10px; border-radius: 99px; background: #f3e8ff; color: #7e22ce; border: 1px solid #d8b4fe; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;"><%= leadCourse.levelLabel %></span>
                <span style="font-size: 11px; padding: 4px 10px; border-radius: 99px; background: transparent; color: #475569; border: 1px solid #e2e8f0; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;"><%= leadCourse.lessonCount %> LESSONS</span>
                <span style="font-size: 11px; padding: 4px 10px; border-radius: 99px; background: transparent; color: #475569; border: 1px solid #e2e8f0; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;"><%= formatDuration(leadCourse.estimatedDurationMinutes) %></span>
              </div>
              <a href="<%= courseHref(leadCourse) %>" style="display: inline-block; border: 1px solid #cbd5e1; border-radius: 999px; padding: 6px 14px; color: #0f172a; font-weight: 600; font-size: 13px; text-decoration: none;">View Course &rarr;</a>
            </div>
          <% } else { %>
            <div class="lmsv-featured-header">
              <span class="lmsv-kicker-pill lmsv-kicker-start">START HERE</span>
            </div>
            <h3>New courses publishing soon</h3>
            <div class="lmsv-featured-footer">
              <a href="/courses" class="lmsv-btn-link">Browse Catalog &rarr;</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <section class="lmsv-section" style="padding-top: 64px;">
      <header class="lmsv-section-head lmsv-section-head-center" style="margin-bottom: 48px;">
        <h2 style="font-size: 32px; letter-spacing: -0.02em; color: #0f172a;">Built for every learning journey</h2>
        <div style="width: 40px; height: 3px; background: #8b5cf6; margin: 16px auto 0;"></div>
      </header>

      <div class="lmsv-persona-grid">
        <article class="lmsv-persona-card">
          <div class="lmsv-persona-media">
            <img src="<%= learnerImage %>" alt="Learner collaborating on a laptop">
          </div>
          <div class="lmsv-persona-body" style="padding: 32px 24px; border: 1px solid #e2e8f0; border-top: none; border-radius: 0 0 16px 16px;">
            <p class="lmsv-kicker" style="color: #a855f7; font-weight: 700; font-size: 13px; letter-spacing: 0.05em;">FOR LEARNERS</p>
            <h3 style="font-size: 28px; line-height: 1.2; margin: 8px 0 16px;">Find a course path and start at your own pace.</h3>
            <p style="color: #475569; font-size: 16px; line-height: 1.6;  margin-bottom: 24px;">Browse courses publicly, compare details, and enroll only when you are ready.</p>
            <div class="lmsv-actions">
              <a href="/courses" class="btn btn-primary" style="background:#8b5cf6; border:1px solid #8b5cf6; color:white; border-radius: 8px; padding: 12px 20px;">Browse Courses</a>
              <% if (!user) { %>
                <a href="<%= learnRegisterHref %>" class="btn btn-outline" style="border:1px solid #e2e8f0; color:#0f172a; border-radius: 8px; padding: 12px 20px;">My Learning</a>
              <% } else { %>
                <a href="/simple-lms?view=my-learning" class="btn btn-outline" style="border:1px solid #e2e8f0; color:#0f172a; border-radius: 8px; padding: 12px 20px;">My Learning</a>
              <% } %>
            </div>
          </div>
        </article>

        <article class="lmsv-persona-card">
          <div class="lmsv-persona-media">
            <img src="<%= creatorImage %>" alt="Course creators planning content together">
          </div>
          <div class="lmsv-persona-body" style="padding: 32px 24px; border: 1px solid #e2e8f0; border-top: none; border-radius: 0 0 16px 16px;">
            <p class="lmsv-kicker" style="color: #a855f7; font-weight: 700; font-size: 13px; letter-spacing: 0.05em;">FOR CREATORS</p>
            <h3 style="font-size: 28px; line-height: 1.2; margin: 8px 0 16px;">Publish polished courses and grow your audience.</h3>
            <p style="color: #475569; font-size: 16px; line-height: 1.6; margin-bottom: 24px;">Build chapters, lessons, and quizzes with guided onboarding from day one.</p>
            <div class="lmsv-actions">
              <a href="<%= teachCtaHref %>" class="btn btn-primary" style="background:#8b5cf6; border:1px solid #8b5cf6; color:white; border-radius: 8px; padding: 12px 20px;">Teach on AIIN Nigeria</a>
              <a href="/teach" class="btn btn-outline" style="border:1px solid #e2e8f0; color:#0f172a; border-radius: 8px; padding: 12px 20px;">Creator Guide</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="lmsv-section lmsv-catalog-strip">
      <header class="lmsv-section-head">
        <div>
          <h2>Available Courses</h2>
          <p>Explore our curated selection of high-impact learning paths.</p>
        </div>
        <span class="lmsv-count-pill"><%= `${highlightCourses.length} courses found` %></span>
      </header>

      <% if (!highlightCourses || highlightCourses.length === 0) { %>
        <div class="empty-state">No public courses are available yet.</div>
      <% } else { %>
        <div class="lmsv-course-grid-4">
          <% highlightCourses.forEach((course, index) => { %>
            <article class="lmsv-course-card">
              <a href="<%= courseHref(course) %>" class="lmsv-course-media">
                <img src="<%= courseImageFor(course, index) %>" alt="<%= course.title %> banner">
                <span class="lmsv-level-pill"><%= course.levelLabel %></span>
              </a>
              <div class="lmsv-course-body">
                <div class="lmsv-pill-row lmsv-pill-row-muted">
                  <% if (course.category) { %><span><%= course.category %></span><% } %>
                  <span><%= `${course.lessonCount} lessons` %></span>
                  <span><%= formatDuration(course.estimatedDurationMinutes) %></span>
                </div>
                <h3><a href="<%= courseHref(course) %>"><%= course.title %></a></h3>
                <p><%= course.previewSummary %></p>
                <div class="lmsv-course-foot">
                  <span class="lmsv-price-tag"><%= course.displayPrice %></span>
                  <a href="<%= courseHref(course) %>" class="lmsv-inline-link">View Details &rarr;</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('./partials/public-footer', { brandKey: 'aiin', brandLearningName: 'AIIN Learning', teachBrand: 'AIIN Nigeria' }) %>
</body>
</html>

