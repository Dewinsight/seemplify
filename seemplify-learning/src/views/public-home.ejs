<!DOCTYPE html>
<html lang="en" data-learning-ui>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/public-lms.css?v=20260304-2">
  <link rel="stylesheet" href="/css/public-lms-refresh.css?v=20260318-12">
  <script src="/js/theme.js?v=3"></script>
  <link rel="icon" type="image/svg+xml" href="<%= typeof brandKey === 'string' && brandKey === 'aiin' ? '/images/aiin_logo.png' : '/images/seemplify-favicon.svg' %>">
  <link rel="stylesheet" href="/css/seemplify-brand.css?v=20260812-2">
  <%- include('./partials/experience-ui-head') %>
</head>
<body class="learning-app public-site public-home-page">
  <%- include('./partials/nav', { user, activePage, activeLmsView: '', brandKey, brandLearningName, teachBrand }) %>

  <%
    const courseHref = (course) => `/courses/${course._id}${course.slug ? `/${course.slug}` : ''}`
    const highlightCourses = Array.isArray(featuredCourses) ? featuredCourses.slice(0, 6) : []
    const leadCourse = highlightCourses[0] || null
    const fallbackCourseVisuals = [
      'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=80'
    ]
    const categoryVisualHints = [
      { match: ['data', 'analytics', 'ai', 'machine', 'science'], image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=80' },
      { match: ['project', 'management', 'leadership', 'business'], image: 'https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80' },
      { match: ['communication', 'professional', 'soft'], image: 'https://images.unsplash.com/photo-1573497019236-61f323342eb1?auto=format&fit=crop&w=1200&q=80' },
      { match: ['engineering', 'dev', 'code', 'software'], image: 'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=1200&q=80' }
    ]
    const courseImageFor = (course, index) => {
      if (course?.banner?.url) return course.banner.url
      const normalizedCategory = String(course?.category || '').toLowerCase()
      const match = categoryVisualHints.find((entry) => entry.match.some((term) => normalizedCategory.includes(term)))
      if (match?.image) return match.image
      return fallbackCourseVisuals[index % fallbackCourseVisuals.length]
    }
    const formatDuration = (minutes) => {
      const total = Number.isFinite(Number(minutes)) ? Number(minutes) : 0
      if (total >= 60) {
        const hours = Math.floor(total / 60)
        const remain = total % 60
        return remain > 0 ? `${hours}h ${remain}m` : `${hours}h`
      }
      return `${Math.max(0, Math.round(total))}m`
    }
  %>

  <section class="ui-home-intro" aria-labelledby="learning-title">
    <div>
      <h1 id="learning-title">Make room for your next skill.</h1>
      <p>Practical courses for work and life. Find a topic, learn at your own pace, and keep your progress in one place.</p>
      <form class="ui-home-search" action="/courses" method="get"><label class="sr-only" for="home-course-search">Search courses</label><input id="home-course-search" type="search" name="q" placeholder="What would you like to learn?"><button class="ui-button ui-button-primary" type="submit"><%- include('./partials/ui-icon', { icon: 'search' }) %>Find courses</button></form>
      <div class="ui-home-topics"><a href="/courses">Browse all courses →</a><% if (user) { %><a href="/simple-lms">Continue my learning →</a><% } %></div>
    </div>
    <aside class="ui-home-aside" aria-label="Get started with Learning">
      <section><h2>Your learning, in one place</h2><p>Pick up a lesson, follow a course path, and see what you have completed.</p><a href="<%= user ? '/simple-lms' : '/login' %>" class="ui-button ui-button-outline">Open my learning</a></section>
      <section><h2>Have something to teach?</h2><p>Turn your expertise into courses with lessons, quizzes, and a clear publishing workflow.</p><a href="/teach" class="ui-button ui-button-ghost">Explore the creator guide →</a></section>
    </aside>
  </section>

<main id="main-content" class="lmsv-shell">
  <section class="lmsv-learning-summary" aria-label="Learning catalogue summary">
    <p><strong><%= totalCourses %></strong> published courses</p>
    <p><strong><%= totalLessons %></strong> practical lessons</p>
    <p><strong><%= totalDurationHours %></strong> learning hours</p>
    <% if (leadCourse) { %>
      <a href="<%= courseHref(leadCourse) %>">Start with <strong><%= leadCourse.title %></strong> <span aria-hidden="true">&rarr;</span></a>
    <% } else { %>
      <a href="/courses">Browse the catalogue <span aria-hidden="true">&rarr;</span></a>
    <% } %>
  </section>

    <section class="lmsv-section lmsv-catalog-strip">
      <header class="lmsv-section-head">
        <div>
          <h2>Available courses</h2>
          <p>Find a course to start your next learning goal.</p>
        </div>
        <span class="lmsv-course-count"><%= `${highlightCourses.length} courses` %></span>
      </header>

      <% if (!highlightCourses || highlightCourses.length === 0) { %>
        <div class="ui-panel"><div class="ui-empty"><h3>The catalogue is getting started</h3><p>Published courses will appear here. You can explore the catalogue or learn how to create a course.</p><a href="/courses" class="ui-button ui-button-outline">Explore catalogue</a></div></div>
      <% } else { %>
        <div class="lmsv-course-grid-4">
          <% highlightCourses.forEach((course, index) => { %>
            <article class="lmsv-course-card">
              <a href="<%= courseHref(course) %>" class="lmsv-course-media">
                <img src="<%= courseImageFor(course, index) %>" alt="<%= course.title %> banner">
                <span class="lmsv-level-pill"><%= course.levelLabel %></span>
              </a>
              <div class="lmsv-course-body">
                <div class="lmsv-course-meta">
                  <% if (course.category) { %><span><%= course.category %></span><% } %>
                  <span><%= `${course.lessonCount} lessons` %></span>
                  <span><%= formatDuration(course.estimatedDurationMinutes) %></span>
                </div>
                <h3><a href="<%= courseHref(course) %>"><%= course.title %></a></h3>
                <p><%= course.previewSummary %></p>
                <div class="lmsv-course-foot">
                  <span class="lmsv-price-tag"><%= course.displayPrice %></span>
                  <a href="<%= courseHref(course) %>" class="lmsv-inline-link">View details &rarr;</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('./partials/public-footer', { brandKey, brandLearningName, teachBrand }) %>
</body>
</html>

