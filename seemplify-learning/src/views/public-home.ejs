<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/public-lms.css?v=20260304-2">
  <link rel="stylesheet" href="/css/public-lms-refresh.css?v=20260304-11">
  <script src="/js/theme.js?v=2"></script>
</head>
<body class="public-site public-home-page">
  <%- include('./partials/nav', { user, activePage, activeLmsView: '' }) %>

  <%
    const courseHref = (course) => `/courses/${course._id}${course.slug ? `/${course.slug}` : ''}`
    const highlightCourses = Array.isArray(featuredCourses) ? featuredCourses.slice(0, 6) : []
    const leadCourse = highlightCourses[0] || null
    const learnerImage = 'https://images.unsplash.com/photo-1513258496099-48168024aec0?auto=format&fit=crop&w=1300&q=80'
    const creatorImage = 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1300&q=80'
    const heroGraphicImage = '/images/aiin-learning-hero-graphic.jpg?v=20260306'
    const fallbackCourseVisuals = [
      'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=80'
    ]
    const categoryVisualHints = [
      { match: ['data', 'analytics', 'ai', 'machine', 'science'], image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=80' },
      { match: ['project', 'management', 'leadership', 'business'], image: 'https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80' },
      { match: ['communication', 'professional', 'soft'], image: 'https://images.unsplash.com/photo-1573497019236-61f323342eb1?auto=format&fit=crop&w=1200&q=80' },
      { match: ['engineering', 'dev', 'code', 'software'], image: 'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=1200&q=80' }
    ]
    const courseImageFor = (course, index) => {
      if (course?.banner?.url) return course.banner.url
      const normalizedCategory = String(course?.category || '').toLowerCase()
      const match = categoryVisualHints.find((entry) => entry.match.some((term) => normalizedCategory.includes(term)))
      if (match?.image) return match.image
      return fallbackCourseVisuals[index % fallbackCourseVisuals.length]
    }
    const formatDuration = (minutes) => {
      const total = Number.isFinite(Number(minutes)) ? Number(minutes) : 0
      if (total >= 60) {
        const hours = Math.floor(total / 60)
        const remain = total % 60
        return remain > 0 ? `${hours}h ${remain}m` : `${hours}h`
      }
      return `${Math.max(0, Math.round(total))}m`
    }
  %>

  <main class="lmsv-shell">
    <section class="lmsv-home-hero">
      <article class="lmsv-surface-card lmsv-home-hero-main">
        <div class="lmsv-home-hero-visual-frame">
          <img src="<%= heroGraphicImage %>" alt="African learners collaborating with a laptop and digital learning overlays" class="lmsv-home-hero-visual-image">
          <div class="lmsv-home-hero-overlay lmsv-home-hero-overlay-growth">
            <span class="lmsv-home-hero-overlay-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="20" x2="4" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="20" y1="20" x2="20" y2="13"></line>
              </svg>
            </span>
            <strong>Progress +24%</strong>
            <small>Learning growth this month</small>
          </div>
          <div class="lmsv-home-hero-overlay lmsv-home-hero-overlay-cert">
            <span class="lmsv-home-hero-overlay-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l8 4-8 4-8-4 8-4z"></path>
                <path d="M4 11l8 4 8-4"></path>
                <path d="M10 15v4l2 2 2-2v-4"></path>
              </svg>
            </span>
            <strong>Certificates Ready</strong>
            <small>Career credentials in view</small>
          </div>
          <div class="lmsv-home-hero-overlay lmsv-home-hero-overlay-focus">
            <span class="lmsv-home-hero-overlay-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"></circle>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </span>
            <strong>AIIN Skill Paths</strong>
            <small>Focused practical outcomes</small>
          </div>
          <div class="lmsv-home-hero-badge-row" aria-hidden="true">
            <span>Launch</span>
            <span>Career</span>
            <span>Creator</span>
          </div>
        </div>
      </article>

      <aside class="lmsv-home-hero-side">
        <article class="lmsv-surface-card lmsv-pulse-card">
          <p class="lmsv-kicker">Platform Pulse</p>
          <div class="lmsv-pulse-list">
            <div class="lmsv-pulse-row">
              <span>Published Courses</span>
              <strong><%= totalCourses %></strong>
            </div>
            <div class="lmsv-pulse-row">
              <span>Total Lessons</span>
              <strong><%= totalLessons %></strong>
            </div>
            <div class="lmsv-pulse-row">
              <span>Learning Hours</span>
              <strong><%= totalDurationHours %></strong>
            </div>
          </div>
        </article>

        <article class="lmsv-surface-card lmsv-highlight-card">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
            <p class="lmsv-kicker">Start Here</p>
            <% if (leadCourse) { %><span style="font-size:11px;font-weight:700;color:#ef4444;letter-spacing:0.04em;">Most Popular</span><% } %>
          </div>
          <% if (leadCourse) { %>
            <h2><%= leadCourse.title %></h2>
            <p><%= leadCourse.previewSummary %></p>
            <div class="lmsv-pill-row">
              <span><%= leadCourse.levelLabel %></span>
              <span><%= `${leadCourse.lessonCount} lessons` %></span>
              <span><%= formatDuration(leadCourse.estimatedDurationMinutes) %></span>
            </div>
            <a href="<%= courseHref(leadCourse) %>" class="btn btn-secondary">View Highlighted Course &rarr;</a>
          <% } else { %>
            <h2>New public courses are publishing soon.</h2>
            <p>Create an account when you are ready to enroll or publish your own course.</p>
            <a href="/courses" class="btn btn-secondary">Browse Catalog</a>
          <% } %>
        </article>
      </aside>
    </section>

    <section class="lmsv-section">
      <header class="lmsv-section-head lmsv-section-head-center">
        <h2>Built for every learning journey</h2>
      </header>

      <div class="lmsv-persona-grid">
        <article class="lmsv-persona-card">
          <div class="lmsv-persona-media">
            <img src="<%= learnerImage %>" alt="Learner collaborating on a laptop">
          </div>
          <div class="lmsv-persona-body">
            <p class="lmsv-kicker">For Learners</p>
            <h3>Find a course path and start at your own pace.</h3>
            <p>Browse courses publicly, compare details, and enroll only when you are ready.</p>
            <div class="lmsv-actions">
              <a href="/courses" class="btn btn-primary btn-sm">Browse Courses</a>
              <% if (!user) { %>
                <a href="<%= learnRegisterHref %>" class="btn btn-secondary btn-sm">Create Account</a>
              <% } else { %>
                <a href="/simple-lms?view=my-learning" class="btn btn-secondary btn-sm">My Learning</a>
              <% } %>
            </div>
          </div>
        </article>

        <article class="lmsv-persona-card">
          <div class="lmsv-persona-media">
            <img src="<%= creatorImage %>" alt="Course creators planning content together">
          </div>
          <div class="lmsv-persona-body">
            <p class="lmsv-kicker">For Creators</p>
            <h3>Publish polished courses and grow your audience.</h3>
            <p>Build chapters, lessons, and quizzes with guided onboarding from day one.</p>
            <div class="lmsv-actions">
              <a href="<%= teachCtaHref %>" class="btn btn-primary btn-sm"><%= `Teach on ${teachBrand}` %></a>
              <a href="/teach" class="btn btn-secondary btn-sm">Creator Guide</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="lmsv-section lmsv-catalog-strip">
      <header class="lmsv-section-head">
        <div>
          <h2>Available Courses</h2>
          <p>Explore our curated selection of high-impact learning paths.</p>
        </div>
        <span class="lmsv-count-pill"><%= `${highlightCourses.length} courses found` %></span>
      </header>

      <% if (!highlightCourses || highlightCourses.length === 0) { %>
        <div class="empty-state">No public courses are available yet.</div>
      <% } else { %>
        <div class="lmsv-course-grid">
          <% highlightCourses.forEach((course, index) => { %>
            <article class="lmsv-course-card">
              <a href="<%= courseHref(course) %>" class="lmsv-course-media">
                <img src="<%= courseImageFor(course, index) %>" alt="<%= course.title %> banner">
                <span class="lmsv-level-pill"><%= course.levelLabel %></span>
              </a>
              <div class="lmsv-course-body">
                <div class="lmsv-pill-row lmsv-pill-row-muted">
                  <% if (course.category) { %><span><%= course.category %></span><% } %>
                  <span><%= `${course.lessonCount} lessons` %></span>
                  <span><%= formatDuration(course.estimatedDurationMinutes) %></span>
                </div>
                <h3><a href="<%= courseHref(course) %>"><%= course.title %></a></h3>
                <p><%= course.previewSummary %></p>
                <div class="lmsv-course-foot">
                  <span class="lmsv-price-tag"><%= course.displayPrice %></span>
                  <a href="<%= courseHref(course) %>" class="lmsv-inline-link">View Details &rarr;</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('./partials/public-footer') %>
</body>
</html>

