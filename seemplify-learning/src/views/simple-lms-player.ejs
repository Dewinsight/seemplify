<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/public-lms.css?v=20260304-2">
  <link rel="stylesheet" href="/css/public-lms-refresh.css?v=20260304-11">
  <script src="/js/theme.js?v=2"></script>
  <style>
    :root {
      --player-hero-start: rgba(56, 189, 248, 0.16);
      --player-hero-end: rgba(255, 255, 255, 0.92);
      --player-surface: #ffffff;
      --player-surface-strong: #f8fafc;
      --player-pill-bg: #f8fafc;
      --player-link: #0c4a6e;
      --border: #e5e7eb;
      --text: #0f172a;
      --muted: #64748b;
      --panel-solid: #ffffff;
      --card-bg: #ffffff;
      --input-bg: #ffffff;
    }
    [data-theme="dark"] {
      --player-hero-start: rgba(56, 189, 248, 0.16);
      --player-hero-end: rgba(255, 255, 255, 0.92);
      --player-surface: #ffffff;
      --player-surface-strong: #f8fafc;
      --player-pill-bg: #f8fafc;
      --player-link: #0c4a6e;
      --border: #e5e7eb;
      --text: #0f172a;
      --muted: #64748b;
      --panel-solid: #ffffff;
      --card-bg: #ffffff;
      --input-bg: #ffffff;
    }
    body.public-site.lmsv-player-page {
      background: #ffffff;
    }
    .player-shell {
      width: min(1320px, 100%);
      margin: 0 auto;
      padding: 0 24px 56px;
      display: grid;
      gap: 0;
    }
    .player-head {
      border: none;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
      padding: clamp(28px, 3.4vw, 40px) 0 24px;
      background: transparent;
      box-shadow: none;
    }
    .player-title {
      margin: 0;
      font-size: clamp(24px, 3vw, 38px);
      letter-spacing: -0.03em;
      line-height: 1.08;
      color: var(--text);
    }
    .player-subtitle {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }
    .player-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) minmax(300px, 1fr);
      gap: 12px;
      align-items: start;
      padding-top: 24px;
    }
    .player-main,
    .player-side {
      display: grid;
      gap: 12px;
    }
    .player-curriculum-checkbox {
      display: none;
    }
    .player-curriculum-toggle {
      display: none;
    }
    .player-curriculum-overlay {
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 23, 0.58);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 1200;
    }
    .player-side-close {
      display: none;
    }
    .player-card {
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 14px;
      background: var(--card-bg);
      box-shadow: 0 1px 4px rgba(15, 23, 42, 0.08);
      display: grid;
      gap: 10px;
    }
    .player-media {
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      background: linear-gradient(145deg, var(--player-hero-start), var(--player-hero-end));
      min-height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .player-media iframe {
      width: 100%;
      height: 430px;
      border: 0;
      display: block;
    }
    .player-media video {
      width: 100%;
      height: 430px;
      border: 0;
      display: block;
      background: #0f172a;
    }
    .player-media-audio {
      width: min(760px, 100%);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 18px;
      background: var(--player-surface-strong);
      display: grid;
      gap: 10px;
    }
    .player-media-audio h4 {
      margin: 0;
      font-size: 16px;
      letter-spacing: -0.02em;
      color: var(--text);
    }
    .player-media-audio audio {
      width: 100%;
    }
    .player-media-source {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
    }
    .player-fallback {
      text-align: center;
      color: var(--muted);
      font-size: 14px;
      padding: 24px;
      line-height: 1.6;
    }
    .player-pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }
    .player-pill {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 4px 9px;
      background: var(--player-pill-bg);
      color: var(--text);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 700;
    }
    .player-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .player-progress {
      height: 9px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.22);
      overflow: hidden;
    }
    .player-progress > span {
      display: block;
      height: 100%;
      width: var(--progress, 0%);
      background: linear-gradient(90deg, #22d3ee, #14b8a6);
    }
    .curriculum {
      display: grid;
      gap: 10px;
      max-height: calc(100vh - 230px);
      overflow: auto;
      padding-right: 4px;
    }
    .curriculum-chapter {
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--player-surface);
      padding: 9px;
      display: grid;
      gap: 7px;
    }
    .curriculum-chapter h3 {
      margin: 0;
      font-size: 14px;
      letter-spacing: -0.01em;
      color: var(--text);
    }
    .curriculum-chapter-title {
      display: flex;
      gap: 6px;
      align-items: baseline;
      flex-wrap: wrap;
    }
    .curriculum-chapter-number {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      font-weight: 700;
    }
    .curriculum-lesson {
      border: 1px solid rgba(148, 163, 184, 0.28);
      border-radius: 8px;
      padding: 7px 8px;
      background: var(--player-surface-strong);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 12px;
      text-decoration: none;
    }
    .curriculum-lesson.active {
      border-color: rgba(8, 145, 178, 0.5);
      background: rgba(8, 145, 178, 0.12);
      color: #0c4a6e;
    }
    .curriculum-lesson-label {
      display: inline-flex;
      align-items: baseline;
      gap: 6px;
      min-width: 0;
    }
    .curriculum-lesson-label span:last-child {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .curriculum-lesson-number {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
      font-weight: 700;
      flex-shrink: 0;
    }
    .curriculum-status {
      color: #22c55e;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 700;
    }
    .curriculum-quiz-trigger {
      width: 100%;
      justify-content: center;
    }
    .quiz-modal {
      position: fixed;
      inset: 0;
      z-index: 1600;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
    }
    .quiz-modal.open {
      display: flex;
    }
    .quiz-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(2, 6, 23, 0.62);
    }
    .quiz-modal-dialog {
      position: relative;
      width: min(860px, 100%);
      max-height: calc(100dvh - 36px);
      overflow: auto;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--player-surface);
      padding: 14px;
      display: grid;
      gap: 10px;
      box-shadow: 0 18px 44px rgba(2, 6, 23, 0.28);
    }
    .quiz-modal-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }
    .quiz-modal-close {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--input-bg);
      color: var(--text);
      cursor: pointer;
    }
    .quiz-modal-meta {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
    }
    .quiz-section-head {
      margin: 0;
      font-size: 13px;
      color: var(--text);
      font-weight: 700;
    }
    .quiz-modal-status {
      margin: 0;
      font-size: 12px;
      color: var(--muted);
    }
    .resource-list {
      margin: 0;
      padding: 0 0 0 18px;
      display: grid;
      gap: 5px;
    }
    .resource-list a { color: var(--player-link); }
    .quiz-wrap {
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--player-surface);
      padding: 10px;
      display: grid;
      gap: 10px;
    }
    .quiz-q {
      border: 1px solid rgba(148, 163, 184, 0.24);
      border-radius: 8px;
      padding: 8px;
      display: grid;
      gap: 6px;
      background: var(--player-surface-strong);
    }
    .quiz-q p {
      margin: 0;
      color: var(--text);
      font-size: 13px;
      line-height: 1.45;
    }
    .quiz-option {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 12px;
      color: var(--muted);
    }
    @media (max-width: 1080px) {
      .player-layout { grid-template-columns: 1fr; }
      .player-curriculum-toggle { display: inline-flex; width: fit-content; margin-top: 10px; }
      .player-curriculum-checkbox:checked ~ .player-curriculum-overlay { opacity: 1; pointer-events: auto; }
      .player-side {
        position: fixed;
        top: 0;
        right: 0;
        width: min(92vw, 380px);
        height: 100dvh;
        padding: 14px;
        border-left: 1px solid var(--border);
        background: var(--panel-solid);
        transform: translateX(100%);
        transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
        z-index: 1201;
        overflow-y: auto;
        box-shadow: -12px 0 30px rgba(0, 0, 0, 0.32);
        backdrop-filter: blur(18px);
      }
      .player-curriculum-checkbox:checked ~ .player-layout .player-side {
        transform: translateX(0);
      }
      .player-side .player-card {
        min-height: calc(100dvh - 28px);
        box-shadow: none;
      }
      .player-side-close {
        display: flex;
        margin-left: auto;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        border: 1px solid var(--border);
        align-items: center;
        justify-content: center;
        color: var(--text);
        background: var(--input-bg);
        cursor: pointer;
      }
      .player-side-close svg {
        width: 18px;
        height: 18px;
      }
      .curriculum { max-height: unset; }
      .player-media iframe,
      .player-media video { height: 320px; }
    }
    @media (max-width: 760px) {
      .player-shell { margin-bottom: 20px; }
      .player-shell { padding: 0 14px 28px; }
      .player-head { padding: 22px 0 16px; }
      .player-card { padding: 11px; }
      .player-media { min-height: 220px; }
      .player-media iframe,
      .player-media video { height: 240px; }
    }
  </style>
</head>
<body class="public-site lmsv-player-page">
  <%- include('./partials/nav', { user, activePage, activeLmsView: '' }) %>

  <main class="player-shell">
    <section class="player-head">
      <h1 class="player-title"><%= course.title %></h1>
      <p class="player-subtitle">Lesson player for focused learning. Work through the curriculum on the right and track completion in real-time.</p>
      <label for="player-curriculum-toggle" class="btn btn-secondary btn-sm player-curriculum-toggle">Open Curriculum</label>
      <div class="player-pill-row">
        <span class="player-pill"><%= course.levelLabel %></span>
        <span class="player-pill"><%= progress.completedCount %>/<%= progress.lessonCount %> lessons completed</span>
        <span class="player-pill">Progress <%= progress.progressPercent %>%</span>
      </div>
      <div class="player-progress" style="--progress:<%= Math.max(0, Math.min(100, Number(progress.progressPercent || 0))) %>%"><span></span></div>
    </section>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <input type="checkbox" id="player-curriculum-toggle" class="player-curriculum-checkbox">
    <label for="player-curriculum-toggle" class="player-curriculum-overlay" aria-label="Close curriculum"></label>

    <section class="player-layout">
      <div class="player-main">
        <article class="player-card">
          <h2 style="margin:0;font-size:22px;letter-spacing:-0.02em;">
            <%= `Lesson ${currentLesson.chapterOrder}.${currentLesson.lessonOrder}: ${currentLesson.title}` %>
          </h2>
          <div class="player-pill-row">
            <span class="player-pill"><%= `Chapter ${currentLesson.chapterOrder}: ${currentLesson.chapterTitle}` %></span>
            <span class="player-pill"><%= currentLesson.durationMinutes %> mins</span>
            <% if (completedSet.has(currentLesson.lessonKey)) { %><span class="player-pill">Completed</span><% } %>
          </div>
          <div class="player-media">
            <% if (lessonMedia && lessonMedia.kind === 'embed' && lessonMedia.embedUrl) { %>
              <iframe src="<%= lessonMedia.embedUrl %>" allowfullscreen></iframe>
            <% } else if (lessonMedia && lessonMedia.kind === 'video' && lessonMedia.directUrl) { %>
              <video controls preload="metadata" src="<%= lessonMedia.directUrl %>"></video>
            <% } else if (lessonMedia && lessonMedia.kind === 'audio' && lessonMedia.directUrl) { %>
              <div class="player-media-audio">
                <h4>Audio Lesson</h4>
                <audio controls preload="metadata" src="<%= lessonMedia.directUrl %>"></audio>
                <p class="player-media-source">Source: <%= lessonMedia.sourceLabel || 'Audio stream' %></p>
              </div>
            <% } else if (lessonMedia && lessonMedia.directUrl) { %>
              <div class="player-fallback">Media link is available but cannot be embedded directly.<br><a href="<%= lessonMedia.directUrl %>" target="_blank" rel="noreferrer" class="btn btn-secondary btn-sm" style="margin-top:10px;">Open Media Link</a></div>
            <% } else { %>
              <div class="player-fallback">No video for this lesson yet. Continue with notes and resources below.</div>
            <% } %>
          </div>
          <% if (lessonMedia && lessonMedia.rawUrl) { %>
            <p class="player-media-source">Media source: <a href="<%= lessonMedia.rawUrl %>" target="_blank" rel="noreferrer"><%= lessonMedia.sourceLabel || 'External Link' %></a></p>
          <% } %>
          <% if (currentLesson.description) { %><p class="soft-note"><%= currentLesson.description %></p><% } %>
          <% if (currentLesson.content) { %><div style="font-size:14px;line-height:1.7;color:var(--text);white-space:pre-wrap;"><%= currentLesson.content %></div><% } %>
          <% if (currentLesson.resources && currentLesson.resources.length > 0) { %>
            <div>
              <h3 style="margin:0 0 6px;font-size:15px;">Resources</h3>
              <ul class="resource-list">
                <% currentLesson.resources.forEach((resource) => { %>
                  <li><a href="<%= resource.url %>" target="_blank" rel="noreferrer"><%= resource.label %></a></li>
                <% }) %>
              </ul>
            </div>
          <% } %>
          <div class="player-actions">
            <form method="post" action="/simple-lms/enrollments/<%= enrollment._id %>/lessons/<%= encodeURIComponent(currentLesson.lessonKey) %>/complete" style="display:inline-flex;">
              <button class="btn btn-primary" type="submit">Mark Lesson Complete</button>
            </form>
            <% if (nextLesson) { %>
              <form method="post" action="/simple-lms/enrollments/<%= enrollment._id %>/lessons/<%= encodeURIComponent(currentLesson.lessonKey) %>/complete" style="display:inline-flex;">
                <input type="hidden" name="next" value="1">
                <button class="btn btn-secondary" type="submit">Complete & Next</button>
              </form>
            <% } %>
            <% if (previousLesson) { %><a class="btn btn-secondary" href="/simple-lms/learn/<%= enrollment._id %>/<%= encodeURIComponent(previousLesson.lessonKey) %>">Previous Lesson</a><% } %>
            <% if (nextLesson) { %><a class="btn btn-secondary" href="/simple-lms/learn/<%= enrollment._id %>/<%= encodeURIComponent(nextLesson.lessonKey) %>">Next Lesson</a><% } %>
          </div>
        </article>

      </div>

      <aside class="player-side">
        <article class="player-card">
          <label for="player-curriculum-toggle" class="player-side-close" aria-label="Close curriculum">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
          </label>
          <div class="player-headline">
            <h2 style="margin:0;font-size:22px;letter-spacing:-0.02em;">Curriculum</h2>
            <p class="soft-note">Select any lesson to navigate. Completed lessons are flagged.</p>
          </div>
          <div class="curriculum">
            <% chapterSections.forEach((chapter) => { %>
              <section class="curriculum-chapter">
                <div class="curriculum-chapter-title">
                  <span class="curriculum-chapter-number"><%= `Chapter ${chapter.chapterNumber}` %></span>
                  <h3><%= chapter.title %></h3>
                </div>
                <% chapter.lessons.forEach((lesson) => { %>
                  <a class="curriculum-lesson <%= currentLesson.lessonKey === lesson.key ? 'active' : '' %>" href="/simple-lms/learn/<%= enrollment._id %>/<%= encodeURIComponent(lesson.key) %>">
                    <span class="curriculum-lesson-label">
                      <span class="curriculum-lesson-number"><%= `${chapter.chapterNumber}.${lesson.lessonNumber}` %></span>
                      <span><%= lesson.title %></span>
                    </span>
                    <span style="display:flex;align-items:center;gap:6px;">
                      <% if (completedSet.has(lesson.key)) { %><span class="curriculum-status">Done</span><% } %>
                      <span><%= lesson.durationMinutes %>m</span>
                    </span>
                  </a>
                <% }) %>
                <% if (chapter.quizLessons && chapter.quizLessons.length > 0) { %>
                  <button
                    type="button"
                    class="btn btn-secondary btn-sm curriculum-quiz-trigger"
                    data-action="open-chapter-quiz"
                    data-chapter-key="<%= chapter.key %>">
                    Take Chapter Quiz
                  </button>
                <% } %>
              </section>
            <% }) %>
          </div>
        </article>
      </aside>
    </section>
  </main>

  <div class="quiz-modal" id="chapterQuizModal" aria-hidden="true">
    <div class="quiz-modal-backdrop" data-action="close-chapter-quiz"></div>
    <div class="quiz-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="chapterQuizTitle">
      <div class="quiz-modal-top">
        <h2 id="chapterQuizTitle" style="margin:0;font-size:20px;letter-spacing:-0.02em;">Chapter Quiz</h2>
        <button type="button" class="quiz-modal-close" data-action="close-chapter-quiz" aria-label="Close chapter quiz">&times;</button>
      </div>
      <p id="chapterQuizMeta" class="quiz-modal-meta"></p>
      <form id="chapterQuizForm" class="quiz-wrap"></form>
      <p id="chapterQuizStatus" class="quiz-modal-status"></p>
      <div class="player-actions">
        <button type="submit" class="btn btn-primary" id="chapterQuizSubmit" form="chapterQuizForm">Submit Quiz</button>
      </div>
    </div>
  </div>

  <%- include('./partials/public-footer') %>
  <script>
    (() => {
      const chapterQuizData = <%- JSON.stringify((chapterSections || []).map((chapter) => ({
        key: chapter.key,
        chapterNumber: chapter.chapterNumber,
        title: chapter.title,
        quizLessons: (chapter.quizLessons || []).map((lesson) => ({
          key: lesson.key,
          lessonNumber: lesson.lessonNumber,
          title: lesson.title,
          quizQuestions: (lesson.quizQuestions || []).map((question) => ({
            prompt: question.prompt,
            choices: (question.choices || []).map((choice) => ({ text: choice.text }))
          }))
        }))
      }))) %>

      const enrollmentId = <%- JSON.stringify(String((enrollment && enrollment._id) || '')) %>
      const modal = document.getElementById('chapterQuizModal')
      const form = document.getElementById('chapterQuizForm')
      const titleNode = document.getElementById('chapterQuizTitle')
      const metaNode = document.getElementById('chapterQuizMeta')
      const statusNode = document.getElementById('chapterQuizStatus')
      let activeChapter = null
      let submitting = false

      const escapeHtml = (value) => String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;')

      const setModalOpen = (isOpen) => {
        if (!modal) return
        modal.classList.toggle('open', Boolean(isOpen))
        modal.setAttribute('aria-hidden', isOpen ? 'false' : 'true')
        document.body.style.overflow = isOpen ? 'hidden' : ''
      }

      const closeModal = () => {
        if (submitting) return
        activeChapter = null
        if (form) form.innerHTML = ''
        if (statusNode) statusNode.textContent = ''
        setModalOpen(false)
      }

      const openChapterQuiz = (chapterKey) => {
        const chapter = chapterQuizData.find((entry) => String(entry.key) === String(chapterKey))
        if (!chapter || !Array.isArray(chapter.quizLessons) || chapter.quizLessons.length === 0) return
        activeChapter = chapter
        titleNode.textContent = `Chapter ${chapter.chapterNumber} Quiz`
        const questionTotal = chapter.quizLessons.reduce((count, lesson) => count + ((lesson.quizQuestions || []).length), 0)
        metaNode.textContent = `${chapter.title} • ${questionTotal} question${questionTotal === 1 ? '' : 's'}`
        statusNode.textContent = ''
        form.innerHTML = chapter.quizLessons.map((lesson) => `
          <section>
            <h3 class="quiz-section-head">Lesson ${chapter.chapterNumber}.${lesson.lessonNumber}: ${escapeHtml(lesson.title)}</h3>
            ${(lesson.quizQuestions || []).map((question, questionIndex) => `
              <section class="quiz-q">
                <p>${questionIndex + 1}. ${escapeHtml(question.prompt)}</p>
                ${(question.choices || []).map((choice, choiceIndex) => `
                  <label class="quiz-option">
                    <input type="radio" name="${escapeHtml(lesson.key)}_answer_${questionIndex}" value="${choiceIndex}">
                    <span>${escapeHtml(choice.text)}</span>
                  </label>
                `).join('')}
              </section>
            `).join('')}
          </section>
        `).join('')
        setModalOpen(true)
      }

      const submitChapterQuiz = async (event) => {
        event.preventDefault()
        if (!activeChapter || submitting || !enrollmentId) return
        submitting = true
        statusNode.textContent = 'Submitting quiz...'
        const submitButton = document.getElementById('chapterQuizSubmit')
        if (submitButton) submitButton.disabled = true

        try {
          for (const lesson of activeChapter.quizLessons || []) {
            const body = new URLSearchParams()
            ;(lesson.quizQuestions || []).forEach((_, questionIndex) => {
              const input = form.querySelector(`input[name="${lesson.key}_answer_${questionIndex}"]:checked`)
              if (input) body.append(`answer_${questionIndex}`, input.value)
            })
            await fetch(`/simple-lms/enrollments/${encodeURIComponent(enrollmentId)}/lessons/${encodeURIComponent(lesson.key)}/quiz`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
              body: body.toString(),
              credentials: 'same-origin'
            })
          }
          window.location.reload()
        } catch (error) {
          statusNode.textContent = 'Quiz submission failed. Please try again.'
          submitting = false
          if (submitButton) submitButton.disabled = false
        }
      }

      document.addEventListener('click', (event) => {
        const trigger = event.target.closest('[data-action="open-chapter-quiz"]')
        if (trigger) {
          openChapterQuiz(trigger.getAttribute('data-chapter-key'))
          return
        }

        const close = event.target.closest('[data-action="close-chapter-quiz"]')
        if (close) {
          closeModal()
        }
      })

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeModal()
      })

      if (form) {
        form.addEventListener('submit', submitChapterQuiz)
      }
    })()
  </script>
</body>
</html>

