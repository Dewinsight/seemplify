<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=2"></script>
  <style>
    .player-shell {
      width: min(1440px, 100%);
      margin: 0 auto 32px;
      padding: 0 12px;
      display: grid;
      gap: 14px;
    }
    .player-head {
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px;
      background:
        radial-gradient(130% 150% at 0% 0%, rgba(56, 189, 248, 0.18), rgba(56, 189, 248, 0) 42%),
        linear-gradient(160deg, rgba(2, 6, 23, 0.88), rgba(2, 6, 23, 0.65));
      box-shadow: var(--card-shadow);
    }
    .player-title {
      margin: 0;
      font-size: clamp(24px, 3vw, 38px);
      letter-spacing: -0.03em;
      line-height: 1.08;
      color: var(--text);
    }
    .player-subtitle {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }
    .player-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) minmax(300px, 1fr);
      gap: 12px;
      align-items: start;
    }
    .player-main,
    .player-side {
      display: grid;
      gap: 12px;
    }
    .player-card {
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      display: grid;
      gap: 10px;
    }
    .player-media {
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      background: linear-gradient(145deg, rgba(56, 189, 248, 0.2), rgba(2, 6, 23, 0.9));
      min-height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .player-media iframe {
      width: 100%;
      height: 430px;
      border: 0;
      display: block;
    }
    .player-fallback {
      text-align: center;
      color: var(--muted);
      font-size: 14px;
      padding: 24px;
      line-height: 1.6;
    }
    .player-pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }
    .player-pill {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 4px 9px;
      background: rgba(15, 23, 42, 0.5);
      color: var(--text);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 700;
    }
    .player-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .player-progress {
      height: 9px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.22);
      overflow: hidden;
    }
    .player-progress > span {
      display: block;
      height: 100%;
      width: var(--progress, 0%);
      background: linear-gradient(90deg, #22d3ee, #14b8a6);
    }
    .curriculum {
      display: grid;
      gap: 10px;
      max-height: calc(100vh - 230px);
      overflow: auto;
      padding-right: 4px;
    }
    .curriculum-chapter {
      border: 1px solid var(--border);
      border-radius: 10px;
      background: rgba(15, 23, 42, 0.42);
      padding: 9px;
      display: grid;
      gap: 7px;
    }
    .curriculum-chapter h3 {
      margin: 0;
      font-size: 14px;
      letter-spacing: -0.01em;
      color: var(--text);
    }
    .curriculum-lesson {
      border: 1px solid rgba(148, 163, 184, 0.28);
      border-radius: 8px;
      padding: 7px 8px;
      background: rgba(2, 6, 23, 0.45);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 12px;
      text-decoration: none;
    }
    .curriculum-lesson.active {
      border-color: rgba(56, 189, 248, 0.7);
      background: rgba(56, 189, 248, 0.16);
      color: var(--text);
    }
    .curriculum-status {
      color: #22c55e;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 700;
    }
    .resource-list {
      margin: 0;
      padding: 0 0 0 18px;
      display: grid;
      gap: 5px;
    }
    .resource-list a { color: #67e8f9; }
    .quiz-wrap {
      border: 1px solid var(--border);
      border-radius: 10px;
      background: rgba(15, 23, 42, 0.4);
      padding: 10px;
      display: grid;
      gap: 10px;
    }
    .quiz-q {
      border: 1px solid rgba(148, 163, 184, 0.24);
      border-radius: 8px;
      padding: 8px;
      display: grid;
      gap: 6px;
      background: rgba(2, 6, 23, 0.4);
    }
    .quiz-q p {
      margin: 0;
      color: var(--text);
      font-size: 13px;
      line-height: 1.45;
    }
    .quiz-option {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 12px;
      color: var(--muted);
    }
    @media (max-width: 1080px) {
      .player-layout { grid-template-columns: 1fr; }
      .curriculum { max-height: unset; }
      .player-media iframe { height: 320px; }
    }
    @media (max-width: 760px) {
      .player-shell { margin-bottom: 20px; }
      .player-head { padding: 14px; }
      .player-card { padding: 11px; }
      .player-media { min-height: 220px; }
      .player-media iframe { height: 240px; }
    }
  </style>
</head>
<body>
  <%- include('./partials/nav', { user, activePage }) %>

  <main class="player-shell">
    <section class="player-head">
      <h1 class="player-title"><%= course.title %></h1>
      <p class="player-subtitle">Lesson player for focused learning. Work through the curriculum on the right and track completion in real-time.</p>
      <div class="player-pill-row">
        <span class="player-pill"><%= course.levelLabel %></span>
        <span class="player-pill"><%= progress.completedCount %>/<%= progress.lessonCount %> lessons completed</span>
        <span class="player-pill">Progress <%= progress.progressPercent %>%</span>
      </div>
      <div class="player-progress" style="--progress:<%= Math.max(0, Math.min(100, Number(progress.progressPercent || 0))) %>%"><span></span></div>
    </section>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <section class="player-layout">
      <div class="player-main">
        <article class="player-card">
          <h2 style="margin:0;font-size:22px;letter-spacing:-0.02em;"><%= currentLesson.title %></h2>
          <div class="player-pill-row">
            <span class="player-pill"><%= currentLesson.chapterTitle %></span>
            <span class="player-pill"><%= currentLesson.durationMinutes %> mins</span>
            <% if (completedSet.has(currentLesson.lessonKey)) { %><span class="player-pill">Completed</span><% } %>
          </div>
          <div class="player-media">
            <% if (embedUrl) { %>
              <iframe src="<%= embedUrl %>" allowfullscreen></iframe>
            <% } else if (currentLesson.videoUrl) { %>
              <div class="player-fallback">Video link is available but not embeddable directly.<br><a href="<%= currentLesson.videoUrl %>" target="_blank" rel="noreferrer" class="btn btn-secondary btn-sm" style="margin-top:10px;">Open Video Link</a></div>
            <% } else { %>
              <div class="player-fallback">No video for this lesson yet. Continue with notes and resources below.</div>
            <% } %>
          </div>
          <% if (currentLesson.description) { %><p class="soft-note"><%= currentLesson.description %></p><% } %>
          <% if (currentLesson.content) { %><div style="font-size:14px;line-height:1.7;color:var(--text);white-space:pre-wrap;"><%= currentLesson.content %></div><% } %>
          <% if (currentLesson.resources && currentLesson.resources.length > 0) { %>
            <div>
              <h3 style="margin:0 0 6px;font-size:15px;">Resources</h3>
              <ul class="resource-list">
                <% currentLesson.resources.forEach((resource) => { %>
                  <li><a href="<%= resource.url %>" target="_blank" rel="noreferrer"><%= resource.label %></a></li>
                <% }) %>
              </ul>
            </div>
          <% } %>
          <div class="player-actions">
            <form method="post" action="/simple-lms/enrollments/<%= enrollment._id %>/lessons/<%= encodeURIComponent(currentLesson.lessonKey) %>/complete" style="display:inline-flex;">
              <button class="btn btn-primary" type="submit">Mark Lesson Complete</button>
            </form>
            <% if (nextLesson) { %>
              <form method="post" action="/simple-lms/enrollments/<%= enrollment._id %>/lessons/<%= encodeURIComponent(currentLesson.lessonKey) %>/complete" style="display:inline-flex;">
                <input type="hidden" name="next" value="1">
                <button class="btn btn-secondary" type="submit">Complete & Next</button>
              </form>
            <% } %>
            <% if (previousLesson) { %><a class="btn btn-secondary" href="/simple-lms/learn/<%= enrollment._id %>/<%= encodeURIComponent(previousLesson.lessonKey) %>">Previous Lesson</a><% } %>
            <% if (nextLesson) { %><a class="btn btn-secondary" href="/simple-lms/learn/<%= enrollment._id %>/<%= encodeURIComponent(nextLesson.lessonKey) %>">Next Lesson</a><% } %>
          </div>
        </article>

        <% if (currentLesson.quizQuestions && currentLesson.quizQuestions.length > 0) { %>
          <article class="player-card">
            <h2 style="margin:0;font-size:22px;letter-spacing:-0.02em;">Lesson Quiz</h2>
            <% if (latestAttempt) { %><p class="soft-note">Latest attempt: <strong><%= latestAttempt.score %>/<%= latestAttempt.maxScore %></strong> (<%= latestAttempt.maxScore > 0 ? Math.round((latestAttempt.score / latestAttempt.maxScore) * 100) : 0 %>%).</p><% } %>
            <form method="post" action="/simple-lms/enrollments/<%= enrollment._id %>/lessons/<%= encodeURIComponent(currentLesson.lessonKey) %>/quiz" class="quiz-wrap">
              <% currentLesson.quizQuestions.forEach((question, questionIndex) => { %>
                <section class="quiz-q">
                  <p><%= questionIndex + 1 %>. <%= question.prompt %></p>
                  <% (question.choices || []).forEach((choice, choiceIndex) => { %>
                    <label class="quiz-option"><input type="radio" name="answer_<%= questionIndex %>" value="<%= choiceIndex %>"> <span><%= choice.text %></span></label>
                  <% }) %>
                </section>
              <% }) %>
              <div class="player-actions"><button class="btn btn-primary" type="submit">Submit Quiz</button></div>
            </form>
          </article>
        <% } %>
      </div>

      <aside class="player-side">
        <article class="player-card">
          <div class="player-headline">
            <h2 style="margin:0;font-size:22px;letter-spacing:-0.02em;">Curriculum</h2>
            <p class="soft-note">Select any lesson to navigate. Completed lessons are flagged.</p>
          </div>
          <div class="curriculum">
            <% chapterSections.forEach((chapter) => { %>
              <section class="curriculum-chapter">
                <h3><%= chapter.title %></h3>
                <% chapter.lessons.forEach((lesson) => { %>
                  <a class="curriculum-lesson <%= currentLesson.lessonKey === lesson.key ? 'active' : '' %>" href="/simple-lms/learn/<%= enrollment._id %>/<%= encodeURIComponent(lesson.key) %>">
                    <span><%= lesson.title %></span>
                    <span style="display:flex;align-items:center;gap:6px;">
                      <% if (completedSet.has(lesson.key)) { %><span class="curriculum-status">Done</span><% } %>
                      <span><%= lesson.durationMinutes %>m</span>
                    </span>
                  </a>
                <% }) %>
              </section>
            <% }) %>
          </div>
        </article>
      </aside>
    </section>
  </main>
</body>
</html>
