<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style><%- include('../public/css/idp-theme.css') %></style>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js?v=3"></script>
  <style>
    body.workspace-chooser-page {
      margin: 0;
      min-height: 100vh;
      font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 12% 15%, rgba(56, 189, 248, 0.16), transparent 28%),
        radial-gradient(circle at 88% 10%, rgba(99, 102, 241, 0.14), transparent 30%),
        linear-gradient(180deg, #f5f8fd 0%, #eef4fb 100%);
      color: #0f172a;
    }
    .chooser-shell {
      width: min(1160px, calc(100vw - 48px));
      margin: 0 auto;
      padding: 28px 0 64px;
      display: grid;
      gap: 20px;
    }
    .chooser-hero {
      display: grid;
      gap: 12px;
      padding: 34px;
      border: 1px solid rgba(203, 213, 225, 0.88);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.9);
      box-shadow: 0 24px 72px -48px rgba(15, 23, 42, 0.4);
    }
    .chooser-hero p {
      margin: 0;
      color: #60748f;
      max-width: 720px;
      font-size: 16px;
      line-height: 1.65;
    }
    .chooser-kicker {
      margin: 0;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #0284c7;
    }
    .chooser-hero h1 {
      margin: 0;
      font-family: "Space Grotesk", "IBM Plex Sans", sans-serif;
      font-size: clamp(38px, 5vw, 64px);
      line-height: 0.95;
      letter-spacing: -0.05em;
    }
    .chooser-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
    }
    .chooser-card {
      display: grid;
      gap: 18px;
      padding: 24px;
      border-radius: 24px;
      border: 1px solid rgba(203, 213, 225, 0.9);
      background:
        linear-gradient(160deg, rgba(255, 255, 255, 0.95), rgba(247, 250, 255, 0.88));
      box-shadow: 0 22px 54px -42px rgba(15, 23, 42, 0.45);
      text-decoration: none;
      color: inherit;
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .chooser-card:hover {
      transform: translateY(-2px);
      border-color: rgba(14, 165, 233, 0.38);
      box-shadow: 0 26px 64px -44px rgba(14, 165, 233, 0.34);
    }
    .chooser-card-top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
    }
    .chooser-card-top span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(14, 165, 233, 0.16), rgba(99, 102, 241, 0.18));
      color: #0f172a;
      font-weight: 700;
      font-size: 15px;
    }
    .chooser-card h2 {
      margin: 0;
      font-size: 26px;
      letter-spacing: -0.03em;
      line-height: 1.02;
      font-family: "Space Grotesk", "IBM Plex Sans", sans-serif;
    }
    .chooser-card p {
      margin: 0;
      color: #60748f;
      font-size: 14px;
      line-height: 1.62;
    }
    .chooser-card-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: #0369a1;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .chooser-note {
      margin: 0;
      color: #64748b;
      font-size: 13px;
      line-height: 1.6;
    }
    @media (max-width: 780px) {
      .chooser-shell {
        width: min(100vw - 28px, 100%);
        padding: 16px 0 42px;
      }
      .chooser-hero,
      .chooser-card {
        border-radius: 20px;
        padding: 20px;
      }
    }
  </style>
  <link rel="icon" type="image/svg+xml" href="<%= typeof brandKey === 'string' && brandKey === 'aiin' ? '/images/aiin_logo.png' : '/images/seemplify-favicon.svg' %>">
  <link rel="stylesheet" href="/css/seemplify-brand.css?v=20260811-1">
</head>
<body class="workspace-chooser-page">
  <%- include('partials/nav', { activePage }) %>

  <main class="chooser-shell">
    <section class="chooser-hero">
      <p class="chooser-kicker">Workspace Access</p>
      <h1>Choose where to work.</h1>
      <p>You have access to more than one privileged dashboard. Pick the workspace you want to enter for this session.</p>
      <% if (success) { %><p class="chooser-note"><strong><%= success %></strong></p><% } %>
      <% if (error) { %><p class="chooser-note"><strong><%= error %></strong></p><% } %>
    </section>

    <section class="chooser-grid">
      <% workspaceCards.forEach((card, index) => { %>
        <a href="<%= card.href %>" class="chooser-card">
          <div class="chooser-card-top">
            <span><%= index + 1 %></span>
            <div>
              <h2><%= card.title %></h2>
            </div>
          </div>
          <p><%= card.body %></p>
          <div class="chooser-card-foot">
            <span>Open Workspace</span>
            <span><%= card.href %></span>
          </div>
        </a>
      <% }) %>
    </section>

    <p class="chooser-note">You can switch again anytime from the navigation bar.</p>
  </main>
</body>
</html>
