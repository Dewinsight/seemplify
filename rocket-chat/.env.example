# Seemplify Chat Configuration
# Copy to .env and set values. Do not commit .env.

# Version (see https://github.com/RocketChat/Rocket.Chat/releases)
RELEASE=8.0.1

# Local development
# ROOT_URL=http://localhost:3000
# HOST_PORT=3000

# Production (Dokploy / chat.seemplifyai.com)
ROOT_URL=https://chat.seemplifyai.com
HOST_PORT=3000

# Optional: workspace registration token from Rocket.Chat Cloud
# REG_TOKEN=

# MongoDB (defaults in compose; override if using external MongoDB)
# MONGODB_VERSION=8.2

# ---------------------------------------------------------------------------
# Seemplify Chat Branding
# ---------------------------------------------------------------------------
SITE_NAME=Seemplify Chat
ORGANIZATION_NAME=Seemplify
ORGANIZATION_EMAIL=support@seemplifyai.com
SHOW_SETUP_WIZARD=completed

# ---------------------------------------------------------------------------
# Brevo SMTP (same as Identity Provider) – from IDP env + access/BREVO-CONFIGURATION.md
# Use same BREVO_FROM_* as Identityprovider/.env; SMTP server from access doc.
# ---------------------------------------------------------------------------
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
# SMTP login from access/BREVO-CONFIGURATION.md (SMTP Key section)
BREVO_SMTP_USER=93ea9d001@smtp-brevo.com
BREVO_SMTP_PASS=
# From address/name
BREVO_FROM_EMAIL=no-reply@seemplifyai.com
BREVO_FROM_NAME=Seemplify Chat

# ---------------------------------------------------------------------------
# Jitsi Video Conferencing (using public meet.jit.si)
# For self-hosted Jitsi, change JITSI_DOMAIN to your Jitsi server
# ---------------------------------------------------------------------------
JITSI_ENABLED=true
JITSI_DOMAIN=meet.jit.si
JITSI_ROOM_PREFIX=SeemplifyChat
JITSI_NEW_WINDOW=false

# ---------------------------------------------------------------------------
# Custom CSS for branding (hides Rocket.Chat footer logo)
# This is applied automatically via docker-compose.yml
# No need to set this manually - it's handled in the compose file
# ---------------------------------------------------------------------------
