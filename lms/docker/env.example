# ======================
# LMS / Dokploy settings
# ======================

# Domain used by Traefik and host_name in site config.
LMS_HOSTNAME=lms.seemplifyai.com

# Frappe site name (defaults to LMS_HOSTNAME when empty).
LMS_SITE_NAME=lms.seemplifyai.com

# Branding shown in Website/System Settings.
LMS_APP_NAME=Simplify LMS

# Frappe admin password for initial site bootstrap.
LMS_ADMIN_PASSWORD=change-me

# 1 for development mode, 0 for production-like mode.
LMS_DEVELOPER_MODE=0

# MariaDB root password used during site creation.
MYSQL_ROOT_PASSWORD=change-me

# Optional app source path mounted inside container.
LMS_APP_SOURCE_PATH=/lms-app

# ======================
# Email (Brevo SMTP)
# ======================

# Preferred: SMTP key from Brevo (Settings > SMTP & API).
BREVO_SMTP_KEY=your-brevo-smtp-key

# Optional explicit SMTP login username (if different from sender email).
BREVO_SMTP_LOGIN=login@example.com

# Fallback if SMTP key is not set.
BREVO_API_KEY=optional-api-key

# Sender identity.
BREVO_FROM_EMAIL=noreply@example.com
SENDER_EMAIL=noreply@example.com
SENDER_NAME=Simplify LMS
