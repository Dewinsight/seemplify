# Seemplify Chat (Zulip) Environment Variables
# Copy this to .env and fill in the values
# These are set in Dokploy environment variables

# ===========================================
# Site Configuration
# ===========================================
EXTERNAL_HOST=chat.seemplifyai.com
ADMIN_EMAIL=your-admin-email@example.com
ORG_NAME=Seemplify

# ===========================================
# Database & Service Passwords
# Generate strong passwords for production!
# ===========================================
POSTGRES_PASSWORD=change-this-strong-password
MEMCACHED_PASSWORD=change-this-strong-password
RABBITMQ_PASSWORD=change-this-strong-password
REDIS_PASSWORD=change-this-strong-password
SECRET_KEY=change-this-long-random-secret-key

# ===========================================
# OIDC Configuration (Seemplify Identity Provider)
# ===========================================
OIDC_CLIENT_SECRET=your-oidc-client-secret

# ===========================================
# Brevo SMTP Configuration
# ===========================================
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-user
BREVO_SMTP_PASSWORD=your-brevo-smtp-password
NOREPLY_EMAIL=noreply@yourdomain.com
