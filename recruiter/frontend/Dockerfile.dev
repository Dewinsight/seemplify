FROM node:20-alpine AS builder

WORKDIR /app

# Build-time arguments for Next.js public env vars - DEV ENVIRONMENT
ARG NEXT_PUBLIC_API_BASE_URL=https://api-dev.seemplifyai.com
ARG NEXT_PUBLIC_WS_BASE_URL=wss://api-dev.seemplifyai.com
ARG NEXT_PUBLIC_IDP_URL=https://auth-dev.seemplifyai.com
ARG NEXT_PUBLIC_APP_URL=https://app-dev.seemplifyai.com

# Set them as environment variables for the build
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_WS_BASE_URL=$NEXT_PUBLIC_WS_BASE_URL
ENV NEXT_PUBLIC_IDP_URL=$NEXT_PUBLIC_IDP_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Remove any .env files that might have been copied
RUN rm -f .env .env.local .env.production .env.development 2>/dev/null || true

# Build the application with dev env vars
RUN npm run build

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copy necessary files from builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 5000

CMD ["npm", "start"]
