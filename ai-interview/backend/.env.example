AI_INTERVIEW_BACKEND_PORT=5101
AI_INTERVIEW_FRONTEND_URL=http://localhost:5200
CORS_ORIGIN=http://localhost:5200
AI_INTERVIEW_MONGO_URI=mongodb://127.0.0.1:27017
AI_INTERVIEW_MONGO_DB=ai_recruiter
AI_INTERVIEW_SESSION_SECRET=replace-with-long-random-secret

# Seeded local users. Change these before production.
AI_INTERVIEW_ADMIN_EMAIL=admin@aiinterview.local
AI_INTERVIEW_ADMIN_PASSWORD=AdminPass123!
AI_INTERVIEW_RECRUITER_EMAIL=recruiter@aiinterview.local
AI_INTERVIEW_RECRUITER_PASSWORD=RecruiterPass123!

# Brevo transactional email for candidate invitations.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@seemplifyai.com
BREVO_FROM_NAME=Seemplify AI Interview
AI_INTERVIEW_EMAIL_MODE=send

# Azure Speech. AZURE_VOICELIVE_API_KEY can be used as fallback when it is the same Azure AI resource key.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_VOICE=en-US-JennyMultilingualNeural

# LLM runtime copied from recruiter when available.
LLAMA_AZURE_ENDPOINT=
LLAMA_AZURE_DEPLOYMENT=
LLAMA_AZURE_API_KEY=
LLAMA_AZURE_API_VERSION=2024-02-15-preview
