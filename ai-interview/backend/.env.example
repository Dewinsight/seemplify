AI_INTERVIEW_BACKEND_PORT=5101
AI_INTERVIEW_FRONTEND_URL=http://localhost:5200
CORS_ORIGIN=http://localhost:5200
AI_INTERVIEW_MONGO_URI=mongodb://127.0.0.1:27017
AI_INTERVIEW_MONGO_DB=ai_recruiter
AI_INTERVIEW_SESSION_SECRET=replace-with-long-random-secret

# Central Seemplify admin feature settings. Production defaults to https://api.seemplifyai.com.
SEEMPLIFY_PLATFORM_API_URL=http://localhost:5001
PLATFORM_FEATURE_CACHE_MS=15000

# Signed access to the central Seemplify AI runtime. Use the same HMAC secret on both services.
SEEMPLIFY_AI_GATEWAY_URL=http://localhost:5001
AI_GATEWAY_SERVICE_ID=ai-interview
AI_GATEWAY_HMAC_SECRET=replace-with-a-separate-long-random-secret
AI_GATEWAY_TIMEOUT_MS=30000
AI_INTERVIEW_CV_INFERENCE_TIMEOUT_MS=240000

# Durable CV parsing queue. Keep Redis enabled so offline local-LLM requests wait instead of failing.
AI_INTERVIEW_CV_QUEUE_ENABLED=true
AI_INTERVIEW_REDIS_HOST=127.0.0.1
AI_INTERVIEW_REDIS_PORT=6379
AI_INTERVIEW_CV_QUEUE_CONCURRENCY=1
AI_INTERVIEW_CV_QUEUE_APPROVED_CONCURRENCY=1
AI_INTERVIEW_CV_STATUS_TOKEN_SECRET=replace-with-a-separate-long-random-secret

# These values must match the central recruiter worker exactly so both queues
# share one persisted GPU concurrency limit and fair dispatch order.
CV_GLOBAL_DISPATCH_REDIS_URL=redis://127.0.0.1:6379/0
CV_GLOBAL_DISPATCH_IDENTITY=seemplify-cv-inference
CV_GLOBAL_DISPATCH_KEY_PREFIX=seemplify:cv:dispatch:v2
CV_GLOBAL_DISPATCH_APPROVED_LIMIT=1
CV_GLOBAL_DISPATCH_LEASE_MS=120000
CV_GLOBAL_DISPATCH_FAIRNESS_WINDOW_MS=10000

# Seeded local users. Change these before production.
AI_INTERVIEW_ADMIN_EMAIL=admin@aiinterview.local
AI_INTERVIEW_ADMIN_PASSWORD=AdminPass123!
AI_INTERVIEW_RECRUITER_EMAIL=recruiter@aiinterview.local
AI_INTERVIEW_RECRUITER_PASSWORD=RecruiterPass123!

# Brevo transactional email for candidate invitations.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@seemplifyai.com
BREVO_FROM_NAME=Seemplify AI Interview
AI_INTERVIEW_EMAIL_MODE=send

# Azure Speech. AZURE_VOICELIVE_API_KEY can be used as fallback when it is the same Azure AI resource key.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_VOICE=en-US-JennyMultilingualNeural
