NODE_ENV=development
PORT=5001

# Required for auth (set a strong secret in real environments)
SECRET_KEY=replace-with-a-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# MongoDB (auto-mailer variant, preferred)
AUTO_MAILER_MONGO_URI=mongodb://localhost:27017
AUTO_MAILER_MONGODB_DB_NAME=auto_mailer

# MongoDB (compatibility with recruiter-style / legacy keys)
# MONGO_URI=mongodb://localhost:27017
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB_NAME=auto_mailer

# Nylas (auto-mailer variant, preferred)
AUTO_MAILER_NYLAS_API_KEY=replace-with-nylas-api-key
AUTO_MAILER_NYLAS_API_URI=https://api.us.nylas.com
AUTO_MAILER_NYLAS_CLIENT_ID=replace-with-nylas-client-id
AUTO_MAILER_NYLAS_CLIENT_SECRET=replace-with-nylas-client-secret
AUTO_MAILER_NYLAS_REDIRECT_URI=http://localhost:5001/api/nylas/callback

# Nylas (compatibility with recruiter-style / legacy keys)
# NYLAS_API_KEY=replace-with-nylas-api-key
# NYLAS_API_URI=https://api.us.nylas.com
# NYLAS_CLIENT_ID=replace-with-nylas-client-id
# NYLAS_CLIENT_SECRET=replace-with-nylas-client-secret
# NYLAS_REDIRECT_URI=http://localhost:5001/api/nylas/callback
