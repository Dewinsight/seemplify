NODE_ENV=development
PORT=5420
PUBLIC_URL=http://127.0.0.1:5421
DATABASE_PATH=../.local-runtime/automation-hub/automation.sqlite

# Production requires Seemplify Identity. Local test auth is rejected in production.
OIDC_ISSUER_URL=https://auth.seemplifyai.com
OIDC_CLIENT_ID=automation-hub
OIDC_CLIENT_SECRET_FILE=/run/secrets/automation-hub/oidc-client-secret
OIDC_REDIRECT_URI=https://automations.seemplifyai.com/auth/callback
SESSION_SECRET_FILE=/run/secrets/automation-hub/session-secret
WEBHOOK_ENCRYPTION_KEY_FILE=/run/secrets/automation-hub/webhook-encryption-key

# Free self-hosted Nango is used for Auth + Proxy. The Hub owns workflows/webhooks.
NANGO_BASE_URL=http://nango-server:3003
NANGO_SECRET_KEY_FILE=/run/secrets/automation-hub/nango-secret-key
NANGO_WEBHOOK_SECRET_FILE=/run/secrets/automation-hub/nango-webhook-secret

# Product adapters use per-service HMAC keys from mounted secret files.
WORKSPACE_API_URL=http://workspace-backend:5009
WORKSPACE_HMAC_SECRET_FILE=/run/secrets/automation-hub/workspace-hmac-secret
PAYROLL_API_URL=http://payroll-backend:5006
PAYROLL_HMAC_SECRET_FILE=/run/secrets/automation-hub/payroll-hmac-secret
LEAVE_API_URL=http://leave-backend:5002
LEAVE_HMAC_SECRET_FILE=/run/secrets/automation-hub/leave-hmac-secret
TIME_API_URL=http://time-backend:5010
TIME_HMAC_SECRET_FILE=/run/secrets/automation-hub/time-hmac-secret
IDENTITY_API_URL=http://identity-provider:5008
IDENTITY_HMAC_SECRET_FILE=/run/secrets/automation-hub/identity-hmac-secret
LEARNING_API_URL=http://learning:5012
LEARNING_HMAC_SECRET_FILE=/run/secrets/automation-hub/learning-hmac-secret
