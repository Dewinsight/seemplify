{
  "name": "@seemplify/automation-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "e2e:server": "tsx test/e2e-runtime.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.31.0",
    "openid-client": "^5.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.0.11"
  }
}
